{"type":"assistant","message":{"model":"claude-sonnet-4-6","id":"msg_01TstENPhftyrTrV5TX13JPJ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Pb8d4BMSespiuV8gn6U1Js","name":"Bash","input":{"command":"cd \"C:/Users/Jyue/Documents/1-projects/Software Projects/pelangi-website/site\" && cat src/app/api/tiktok-events/route.ts","description":"Read existing tiktok-events route"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1032,"cache_read_input_tokens":33576,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1032},"output_tokens":59,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"7d904885-7413-494e-8511-9a02e1f067dc","uuid":"a8b452fd-5a74-4e6c-873d-3a4ddf68ece4"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Pb8d4BMSespiuV8gn6U1Js","type":"tool_result","content":"import { NextRequest, NextResponse } from \"next/server\";\r\nimport crypto from \"crypto\";\r\nimport { deferAfterResponse, logServerEvent } from \"@/lib/server-analytics\";\r\n\r\n// ---------------------------------------------------------------------------\r\n// Types\r\n// ---------------------------------------------------------------------------\r\n\r\ninterface TikTokEventPayload {\r\n  event: string;\r\n  event_id: string;\r\n  url: string;\r\n  user_data?: {\r\n    em?: string; // pre-hashed email (SHA-256 hex)\r\n    ph?: string; // pre-hashed phone (SHA-256 hex)\r\n  };\r\n}\r\n\r\n// ---------------------------------------------------------------------------\r\n// Config\r\n// ---------------------------------------------------------------------------\r\n\r\nconst PIXEL_CODE = process.env.TIKTOK_PIXEL_ID ?? \"\";\r\nconst ACCESS_TOKEN = process.env.TIKTOK_ACCESS_TOKEN ?? \"\";\r\nconst ALLOWED_EVENTS = [\"ViewContent\", \"Contact\", \"Search\"] as const;\r\n\r\n// ---------------------------------------------------------------------------\r\n// Helpers\r\n// ---------------------------------------------------------------------------\r\n\r\nfunction sha256(value: string): string {\r\n  return crypto\r\n    .createHash(\"sha256\")\r\n    .update(value.trim().toLowerCase())\r\n    .digest(\"hex\");\r\n}\r\n\r\nfunction buildPayload(\r\n  body: TikTokEventPayload,\r\n  ip: string,\r\n  userAgent: string\r\n) {\r\n  const context: Record<string, unknown> = {\r\n    user_agent: userAgent,\r\n    ip: ip,\r\n    page: {\r\n      url: body.url,\r\n    },\r\n  };\r\n\r\n  // User data — values are already SHA-256 hashed from the client\r\n  const user: Record<string, string> = {};\r\n  if (body.user_data?.em) {\r\n    // Re-hash server-side to ensure consistency (client already hashed, but\r\n    // if the value was somehow sent unhashed, this normalises it)\r\n    user.email = body.user_data.em.length === 64 ? body.user_data.em : sha256(body.user_data.em);\r\n  }\r\n  if (body.user_data?.ph) {\r\n    user.phone_number = body.user_data.ph.length === 64 ? body.user_data.ph : sha256(body.user_data.ph);\r\n  }\r\n\r\n  return {\r\n    pixel_code: PIXEL_CODE,\r\n    event: body.event,\r\n    event_id: body.event_id,\r\n    timestamp: new Date().toISOString(),\r\n    context,\r\n    ...(Object.keys(user).length > 0 ? { user } : {}),\r\n  };\r\n}\r\n\r\n// ---------------------------------------------------------------------------\r\n// Route Handler\r\n// ---------------------------------------------------------------------------\r\n\r\nexport async function POST(request: NextRequest) {\r\n  if (!PIXEL_CODE || !ACCESS_TOKEN) {\r\n    // Silently succeed — TikTok Events API is not configured\r\n    return NextResponse.json({ success: true, skipped: true });\r\n  }\r\n\r\n  let body: TikTokEventPayload;\r\n  try {\r\n    body = await request.json();\r\n  } catch {\r\n    return NextResponse.json(\r\n      { error: \"Invalid JSON body\" },\r\n      { status: 400 }\r\n    );\r\n  }\r\n\r\n  // Validate required fields\r\n  if (!body.event || !body.event_id || !body.url) {\r\n    return NextResponse.json(\r\n      { error: \"Missing required fields: event, event_id, url\" },\r\n      { status: 400 }\r\n    );\r\n  }\r\n\r\n  // Only allow known event types\r\n  if (!ALLOWED_EVENTS.includes(body.event as typeof ALLOWED_EVENTS[number])) {\r\n    return NextResponse.json(\r\n      { error: `Event must be one of: ${ALLOWED_EVENTS.join(\", \")}` },\r\n      { status: 400 }\r\n    );\r\n  }\r\n\r\n  // Read headers BEFORE calling after() — dynamic APIs must not be used inside after()\r\n  const ip =\r\n    request.headers.get(\"x-forwarded-for\")?.split(\",\")[0].trim() ||\r\n    request.headers.get(\"x-real-ip\") ||\r\n    \"0.0.0.0\";\r\n  const userAgent = request.headers.get(\"user-agent\") || \"\";\r\n\r\n  const payload = buildPayload(body, ip, userAgent);\r\n\r\n  // Defer the TikTok API call — runs after the response is sent to the client\r\n  deferAfterResponse(async () => {\r\n    try {\r\n      const response = await fetch(\r\n        \"https://business-api.tiktok.com/open_api/v1.3/event/track/\",\r\n        {\r\n          method: \"POST\",\r\n          headers: {\r\n            \"Content-Type\": \"application/json\",\r\n            \"Access-Token\": ACCESS_TOKEN,\r\n          },\r\n          body: JSON.stringify({ data: [payload] }),\r\n        }\r\n      );\r\n\r\n      if (!response.ok) {\r\n        const errorText = await response.text();\r\n        console.error(\"[tiktok-events] API error:\", response.status, errorText);\r\n      }\r\n    } catch (err) {\r\n      console.error(\"[tiktok-events] Network error:\", err);\r\n    }\r\n  });\r\n\r\n  // Log the event for server-side analytics\r\n  logServerEvent({\r\n    event: `tiktok:${body.event}`,\r\n    path: body.url,\r\n    payload: { event_id: body.event_id },\r\n    timestamp: new Date().toISOString(),\r\n  });\r\n\r\n  // Respond immediately — TikTok API call happens after response is sent\r\n  return NextResponse.json({ success: true, deferred: true });\r\n}\n[rerun: b5]","is_error":false}]},"parent_tool_use_id":null,"session_id":"7d904885-7413-494e-8511-9a02e1f067dc","uuid":"80624a51-47f5-4e2b-a1dc-6628f3a41ad5","timestamp":"2026-04-13T22:08:10.752Z","tool_use_result":{"stdout":"import { NextRequest, NextResponse } from \"next/server\";\r\nimport crypto from \"crypto\";\r\nimport { deferAfterResponse, logServerEvent } from \"@/lib/server-analytics\";\r\n\r\n// ---------------------------------------------------------------------------\r\n// Types\r\n// ---------------------------------------------------------------------------\r\n\r\ninterface TikTokEventPayload {\r\n  event: string;\r\n  event_id: string;\r\n  url: string;\r\n  user_data?: {\r\n    em?: string; // pre-hashed email (SHA-256 hex)\r\n    ph?: string; // pre-hashed phone (SHA-256 hex)\r\n  };\r\n}\r\n\r\n// ---------------------------------------------------------------------------\r\n// Config\r\n// ---------------------------------------------------------------------------\r\n\r\nconst PIXEL_CODE = process.env.TIKTOK_PIXEL_ID ?? \"\";\r\nconst ACCESS_TOKEN = process.env.TIKTOK_ACCESS_TOKEN ?? \"\";\r\nconst ALLOWED_EVENTS = [\"ViewContent\", \"Contact\", \"Search\"] as const;\r\n\r\n// ---------------------------------------------------------------------------\r\n// Helpers\r\n// ---------------------------------------------------------------------------\r\n\r\nfunction sha256(value: string): string {\r\n  return crypto\r\n    .createHash(\"sha256\")\r\n    .update(value.trim().toLowerCase())\r\n    .digest(\"hex\");\r\n}\r\n\r\nfunction buildPayload(\r\n  body: TikTokEventPayload,\r\n  ip: string,\r\n  userAgent: string\r\n) {\r\n  const context: Record<string, unknown> = {\r\n    user_agent: userAgent,\r\n    ip: ip,\r\n    page: {\r\n      url: body.url,\r\n    },\r\n  };\r\n\r\n  // User data — values are already SHA-256 hashed from the client\r\n  const user: Record<string, string> = {};\r\n  if (body.user_data?.em) {\r\n    // Re-hash server-side to ensure consistency (client already hashed, but\r\n    // if the value was somehow sent unhashed, this normalises it)\r\n    user.email = body.user_data.em.length === 64 ? body.user_data.em : sha256(body.user_data.em);\r\n  }\r\n  if (body.user_data?.ph) {\r\n    user.phone_number = body.user_data.ph.length === 64 ? body.user_data.ph : sha256(body.user_data.ph);\r\n  }\r\n\r\n  return {\r\n    pixel_code: PIXEL_CODE,\r\n    event: body.event,\r\n    event_id: body.event_id,\r\n    timestamp: new Date().toISOString(),\r\n    context,\r\n    ...(Object.keys(user).length > 0 ? { user } : {}),\r\n  };\r\n}\r\n\r\n// ---------------------------------------------------------------------------\r\n// Route Handler\r\n// ---------------------------------------------------------------------------\r\n\r\nexport async function POST(request: NextRequest) {\r\n  if (!PIXEL_CODE || !ACCESS_TOKEN) {\r\n    // Silently succeed — TikTok Events API is not configured\r\n    return NextResponse.json({ success: true, skipped: true });\r\n  }\r\n\r\n  let body: TikTokEventPayload;\r\n  try {\r\n    body = await request.json();\r\n  } catch {\r\n    return NextResponse.json(\r\n      { error: \"Invalid JSON body\" },\r\n      { status: 400 }\r\n    );\r\n  }\r\n\r\n  // Validate required fields\r\n  if (!body.event || !body.event_id || !body.url) {\r\n    return NextResponse.json(\r\n      { error: \"Missing required fields: event, event_id, url\" },\r\n      { status: 400 }\r\n    );\r\n  }\r\n\r\n  // Only allow known event types\r\n  if (!ALLOWED_EVENTS.includes(body.event as typeof ALLOWED_EVENTS[number])) {\r\n    return NextResponse.json(\r\n      { error: `Event must be one of: ${ALLOWED_EVENTS.join(\", \")}` },\r\n      { status: 400 }\r\n    );\r\n  }\r\n\r\n  // Read headers BEFORE calling after() — dynamic APIs must not be used inside after()\r\n  const ip =\r\n    request.headers.get(\"x-forwarded-for\")?.split(\",\")[0].trim() ||\r\n    request.headers.get(\"x-real-ip\") ||\r\n    \"0.0.0.0\";\r\n  const userAgent = request.headers.get(\"user-agent\") || \"\";\r\n\r\n  const payload = buildPayload(body, ip, userAgent);\r\n\r\n  // Defer the TikTok API call — runs after the response is sent to the client\r\n  deferAfterResponse(async () => {\r\n    try {\r\n      const response = await fetch(\r\n        \"https://business-api.tiktok.com/open_api/v1.3/event/track/\",\r\n        {\r\n          method: \"POST\",\r\n          headers: {\r\n            \"Content-Type\": \"application/json\",\r\n            \"Access-Token\": ACCESS_TOKEN,\r\n          },\r\n          body: JSON.stringify({ data: [payload] }),\r\n        }\r\n      );\r\n\r\n      if (!response.ok) {\r\n        const errorText = await response.text();\r\n        console.error(\"[tiktok-events] API error:\", response.status, errorText);\r\n      }\r\n    } catch (err) {\r\n      console.error(\"[tiktok-events] Network error:\", err);\r\n    }\r\n  });\r\n\r\n  // Log the event for server-side analytics\r\n  logServerEvent({\r\n    event: `tiktok:${body.event}`,\r\n    path: body.url,\r\n    payload: { event_id: body.event_id },\r\n    timestamp: new Date().toISOString(),\r\n  });\r\n\r\n  // Respond immediately — TikTok API call happens after response is sent\r\n  return NextResponse.json({ success: true, deferred: true });\r\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
