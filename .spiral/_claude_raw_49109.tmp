{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014tAYiZtE4sj4LVjKQ7C8qo","type":"tool_result","content":"1\timport { NextRequest, NextResponse } from \"next/server\";\n2\timport { logPageView } from \"@/lib/server-analytics\";\n3\t\n4\t// ---------------------------------------------------------------------------\n5\t// In-memory sliding window rate limiter\n6\t// Works for single-instance deployments (e.g., Lightsail with `next start`).\n7\t// For multi-instance / edge deployments, replace with @upstash/ratelimit.\n8\t// ---------------------------------------------------------------------------\n9\t\n10\tinterface WindowEntry {\n11\t  timestamps: number[];\n12\t}\n13\t\n14\t// Module-level Map persists across requests within the same process.\n15\tconst store = new Map<string, WindowEntry>();\n16\t\n17\tfunction getIp(req: NextRequest): string {\n18\t  return (\n19\t    req.headers.get(\"x-forwarded-for\")?.split(\",\")[0].trim() ||\n20\t    req.headers.get(\"x-real-ip\") ||\n21\t    \"unknown\"\n22\t  );\n23\t}\n24\t\n25\t/**\n26\t * Sliding window check.\n27\t * @returns allowed, remaining count, and reset time (Unix seconds).\n28\t */\n29\tfunction slidingWindow(\n30\t  key: string,\n31\t  limit: number,\n32\t  windowMs: number\n33\t): { allowed: boolean; remaining: number; reset: number } {\n34\t  const now = Date.now();\n35\t  const windowStart = now - windowMs;\n36\t\n37\t  let entry = store.get(key);\n38\t  if (!entry) {\n39\t    entry = { timestamps: [] };\n40\t    store.set(key, entry);\n41\t  }\n42\t\n43\t  // Evict timestamps outside the current window\n44\t  entry.timestamps = entry.timestamps.filter((ts) => ts > windowStart);\n45\t\n46\t  // Reset is the moment the oldest request in this window expires\n47\t  const oldestTs = entry.timestamps[0];\n48\t  const reset = oldestTs\n49\t    ? Math.ceil((oldestTs + windowMs) / 1000)\n50\t    : Math.ceil((now + windowMs) / 1000);\n51\t\n52\t  if (entry.timestamps.length >= limit) {\n53\t    return { allowed: false, remaining: 0, reset };\n54\t  }\n55\t\n56\t  entry.timestamps.push(now);\n57\t  const remaining = limit - entry.timestamps.length;\n58\t  return { allowed: true, remaining, reset };\n59\t}\n60\t\n61\t// ---------------------------------------------------------------------------\n62\t// Rate-limit configuration\n63\t// ---------------------------------------------------------------------------\n64\t\n65\tconst RATE_LIMIT_ROUTES: Array<{ prefix: string; limit: number }> = [\n66\t  { prefix: \"/api/public/\", limit: 30 },\n67\t  { prefix: \"/api/chat/\", limit: 20 },\n68\t];\n69\t\n70\tconst WINDOW_MS = 60 * 1000; // 1 minute\n71\t\n72\t// ---------------------------------------------------------------------------\n73\t// Proxy (renamed from middleware in Next.js 16)\n74\t// ---------------------------------------------------------------------------\n75\t\n76\texport function proxy(req: NextRequest): NextResponse {\n77\t  const { pathname } = req.nextUrl;\n78\t\n79\t  // --- Deferred page view logging (read headers before deferring) ---\n80\t  const userAgent = req.headers.get(\"user-agent\") ?? \"\";\n81\t  const ip =\n82\t    req.headers.get(\"x-forwarded-for\")?.split(\",\")[0].trim() ??\n83\t    req.headers.get(\"x-real-ip\") ??\n84\t    \"0.0.0.0\";\n85\t  const referrer = req.headers.get(\"referer\") ?? \"\";\n86\t  logPageView({ path: pathname, userAgent, ip, referrer, timestamp: new Date().toISOString() });\n87\t\n88\t  // --- Rate limiting (API routes only) ---\n89\t  const route = RATE_LIMIT_ROUTES.find((r) => pathname.startsWith(r.prefix));\n90\t\n91\t  if (route) {\n92\t    const ip = getIp(req);\n93\t    const key = `${route.prefix}${ip}`;\n94\t    const { allowed, remaining, reset } = slidingWindow(key, route.limit, WINDOW_MS);\n95\t\n96\t    const rateLimitHeaders: Record<string, string> = {\n97\t      \"X-RateLimit-Limit\": route.limit.toString(),\n98\t      \"X-RateLimit-Remaining\": remaining.toString(),\n99\t      \"X-RateLimit-Reset\": reset.toString(),\n100\t    };\n101\t\n102\t    if (!allowed) {\n103\t      const retryAfter = (reset - Math.floor(Date.now() / 1000)).toString();\n104\t      return new NextResponse(\"Too Many Requests\", {\n105\t        status: 429,\n106\t        headers: {\n107\t          \"Content-Type\": \"text/plain\",\n108\t          \"X-Content-Type-Options\": \"nosniff\",\n109\t          \"Retry-After\": retryAfter,\n110\t          ...rateLimitHeaders,\n111\t          \"X-RateLimit-Remaining\": \"0\",\n112\t        },\n113\t      });\n114\t    }\n115\t\n116\t    const res = NextResponse.next();\n117\t    for (const [k, v] of Object.entries(rateLimitHeaders)) {\n118\t      res.headers.set(k, v);\n119\t    }\n120\t    return res;\n121\t  }\n122\t\n123\t  return NextResponse.next();\n124\t}\n125\t\n126\texport const config = {\n127\t  matcher: [\n128\t    // Match all routes except static files, images, and Next.js internals\n129\t    {\n130\t      source: \"/((?!_next/static|_next/image|favicon\\\\.ico).*)\",\n131\t      missing: [\n132\t        { type: \"header\", key: \"next-router-prefetch\" },\n133\t        { type: \"header\", key: \"purpose\", value: \"prefetch\" },\n134\t      ],\n135\t    },\n136\t  ],\n137\t};\n138\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"bbfb22f1-8001-4265-ba1a-7ef245a7d994","uuid":"820ab96c-0af9-418c-adea-e02ec0a724e2","timestamp":"2026-04-14T06:37:51.635Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\proxy.ts","content":"import { NextRequest, NextResponse } from \"next/server\";\nimport { logPageView } from \"@/lib/server-analytics\";\n\n// ---------------------------------------------------------------------------\n// In-memory sliding window rate limiter\n// Works for single-instance deployments (e.g., Lightsail with `next start`).\n// For multi-instance / edge deployments, replace with @upstash/ratelimit.\n// ---------------------------------------------------------------------------\n\ninterface WindowEntry {\n  timestamps: number[];\n}\n\n// Module-level Map persists across requests within the same process.\nconst store = new Map<string, WindowEntry>();\n\nfunction getIp(req: NextRequest): string {\n  return (\n    req.headers.get(\"x-forwarded-for\")?.split(\",\")[0].trim() ||\n    req.headers.get(\"x-real-ip\") ||\n    \"unknown\"\n  );\n}\n\n/**\n * Sliding window check.\n * @returns allowed, remaining count, and reset time (Unix seconds).\n */\nfunction slidingWindow(\n  key: string,\n  limit: number,\n  windowMs: number\n): { allowed: boolean; remaining: number; reset: number } {\n  const now = Date.now();\n  const windowStart = now - windowMs;\n\n  let entry = store.get(key);\n  if (!entry) {\n    entry = { timestamps: [] };\n    store.set(key, entry);\n  }\n\n  // Evict timestamps outside the current window\n  entry.timestamps = entry.timestamps.filter((ts) => ts > windowStart);\n\n  // Reset is the moment the oldest request in this window expires\n  const oldestTs = entry.timestamps[0];\n  const reset = oldestTs\n    ? Math.ceil((oldestTs + windowMs) / 1000)\n    : Math.ceil((now + windowMs) / 1000);\n\n  if (entry.timestamps.length >= limit) {\n    return { allowed: false, remaining: 0, reset };\n  }\n\n  entry.timestamps.push(now);\n  const remaining = limit - entry.timestamps.length;\n  return { allowed: true, remaining, reset };\n}\n\n// ---------------------------------------------------------------------------\n// Rate-limit configuration\n// ---------------------------------------------------------------------------\n\nconst RATE_LIMIT_ROUTES: Array<{ prefix: string; limit: number }> = [\n  { prefix: \"/api/public/\", limit: 30 },\n  { prefix: \"/api/chat/\", limit: 20 },\n];\n\nconst WINDOW_MS = 60 * 1000; // 1 minute\n\n// ---------------------------------------------------------------------------\n// Proxy (renamed from middleware in Next.js 16)\n// ---------------------------------------------------------------------------\n\nexport function proxy(req: NextRequest): NextResponse {\n  const { pathname } = req.nextUrl;\n\n  // --- Deferred page view logging (read headers before deferring) ---\n  const userAgent = req.headers.get(\"user-agent\") ?? \"\";\n  const ip =\n    req.headers.get(\"x-forwarded-for\")?.split(\",\")[0].trim() ??\n    req.headers.get(\"x-real-ip\") ??\n    \"0.0.0.0\";\n  const referrer = req.headers.get(\"referer\") ?? \"\";\n  logPageView({ path: pathname, userAgent, ip, referrer, timestamp: new Date().toISOString() });\n\n  // --- Rate limiting (API routes only) ---\n  const route = RATE_LIMIT_ROUTES.find((r) => pathname.startsWith(r.prefix));\n\n  if (route) {\n    const ip = getIp(req);\n    const key = `${route.prefix}${ip}`;\n    const { allowed, remaining, reset } = slidingWindow(key, route.limit, WINDOW_MS);\n\n    const rateLimitHeaders: Record<string, string> = {\n      \"X-RateLimit-Limit\": route.limit.toString(),\n      \"X-RateLimit-Remaining\": remaining.toString(),\n      \"X-RateLimit-Reset\": reset.toString(),\n    };\n\n    if (!allowed) {\n      const retryAfter = (reset - Math.floor(Date.now() / 1000)).toString();\n      return new NextResponse(\"Too Many Requests\", {\n        status: 429,\n        headers: {\n          \"Content-Type\": \"text/plain\",\n          \"X-Content-Type-Options\": \"nosniff\",\n          \"Retry-After\": retryAfter,\n          ...rateLimitHeaders,\n          \"X-RateLimit-Remaining\": \"0\",\n        },\n      });\n    }\n\n    const res = NextResponse.next();\n    for (const [k, v] of Object.entries(rateLimitHeaders)) {\n      res.headers.set(k, v);\n    }\n    return res;\n  }\n\n  return NextResponse.next();\n}\n\nexport const config = {\n  matcher: [\n    // Match all routes except static files, images, and Next.js internals\n    {\n      source: \"/((?!_next/static|_next/image|favicon\\\\.ico).*)\",\n      missing: [\n        { type: \"header\", key: \"next-router-prefetch\" },\n        { type: \"header\", key: \"purpose\", value: \"prefetch\" },\n      ],\n    },\n  ],\n};\n","numLines":138,"startLine":1,"totalLines":138}}}
