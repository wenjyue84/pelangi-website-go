{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014knsLXL2gPUfAcLcKTzTS8","type":"tool_result","content":"site/src/app/layout.tsx:              function gtag(){window.dataLayer.push(arguments);}\nsite/src/app/layout.tsx:              gtag('consent', 'default', {\nsite/src/app/privacy-policy/page.tsx:                    <strong>Analytics data (Google Analytics):</strong> 14 months (GA4 setting)\nsite/src/components/AnalyticsProvider.tsx:            function gtag(){window.dataLayer.push(arguments);}\nsite/src/components/AnalyticsProvider.tsx:            gtag('js', new Date());\nsite/src/components/AnalyticsProvider.tsx:            gtag('config', '${GA_ID}');`,\nsite/src/components/AnalyticsProvider.tsx:        src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}\nsite/src/components/BookEcommerceTracker.tsx:  // Initialize GA4 custom dimension for A/B test variant on mount\nsite/src/components/BookEcommerceTracker.tsx:    // Set custom dimension for variant tracking in GA4\nsite/src/components/BookEcommerceTracker.tsx:      \"dimension_1\": variant, // dimension_1 = CTA variant (configure in GA4)\nsite/src/components/CookieConsent.tsx:  if (typeof window !== \"undefined\" && typeof window.gtag === \"function\") {\nsite/src/components/CookieConsent.tsx:    window.gtag(\"consent\", \"update\", {\nsite/src/components/WebVitalsReporter.tsx: * Sends a web-vitals event to GA4 via gtag.\nsite/src/components/WebVitalsReporter.tsx: * If gtag hasn't loaded yet (lazyOnload), the event is queued in dataLayer\nsite/src/components/WebVitalsReporter.tsx:  const w = window as unknown as { dataLayer: unknown[]; gtag?: (...args: unknown[]) => void };\nsite/src/components/WebVitalsReporter.tsx:  // Ensure the dataLayer queue exists even before gtag script loads\nsite/src/components/WebVitalsReporter.tsx:  // gtag() pushes into dataLayer — define it if not yet available\nsite/src/components/WebVitalsReporter.tsx:  if (typeof w.gtag !== \"function\") {\nsi