n118\t};\n119\t\n120\texport default async function BookPage() {\n121\t  // Read variant from middleware (set in response header)\n122\t  const headersList = await headers();\n123\t  const variant = (headersList.get(\"x-variant\") ?? \"book-now\") as any;\n124\t  const ctaText = getCTAText(variant);\n125\t\n126\t  return (\n127\t    <main id=\"main-content\" className=\"min-h-screen bg-stone-50 dark:bg-stone-950\">\n128\t      <script\n129\t        type=\"application/ld+json\"\n130\t        dangerouslySetInnerHTML={{ __html: JSON.stringify(lodgingReservationSchema) }}\n131\t      />\n132\t      <Header />\n133\t\n134\t      {/* Hero */}\n135\t      <section className=\"pt-28 pb-16 bg-linear-to-b from-amber-800 to-amber-900 text-white relative overflow-hidden\">\n136\t        <div className=\"absolute inset-0\">\n137\t          <div className=\"absolute top-0 left-0 w-96 h-96 bg-amber-700/50 rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2\" />\n138\t          <div className=\"absolute bottom-0 right-0 w-96 h-96 bg-orange-600/20 rounded-full blur-3xl translate-x-1/2 translate-y-1/2\" />\n139\t        </div>\n140\t\n141\t        <div className=\"container-custom relative text-center\">\n142\t          <p className=\"text-xs font-medium tracking-[0.3em] uppercase text-amber-300 mb-4\">\n143\t            Book Your Stay\n144\t          </p>\n145\t          <h1 className=\"font-display text-4xl md:text-5xl lg:text-6xl font-medium mb-6\">\n146\t            Reserve Your Pod\n147\t          </h1>\n148\t          <p className=\"text-amber-200 text-lg max-w-2xl mx-auto mb-10 leading-relaxed\">\n149\t            Book direct via WhatsApp for the best rate — no platform fees, instant\n150\t            confirmation, and pay at arrival.\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"bbfb22f1-8001-4265-ba1a-7ef245a7d994","uuid":"e3336dab-b35c-4188-bcb1-9adef5d15509","timestamp":"2026-04-14T06:27:09.067Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\app\\book\\page.tsx","content":"import Link from \"next/link\";\nimport { headers } from \"next/headers\";\nimport Header from \"@/components/Header\";\nimport Footer from \"@/components/Footer\";\nimport BookingForm from \"@/components/BookingForm\";\nimport TrustSignals from \"@/components/TrustSignals\";\nimport BookEcommerceTracker from \"@/components/BookEcommerceTracker\";\nimport DuitNowPayment from \"@/components/DuitNowPayment\";\nimport FpxPaymentForm from \"@/components/FpxPaymentForm\";\nimport HeroTrustBadges from \"@/components/HeroTrustBadges\";\nimport ExitIntentOverlay from \"@/components/ExitIntentOverlay\";\nimport { getCTAText } from \"@/lib/flags\";\nimport type { Metadata } from \"next\";\nexport const metadata: Metadata = {\n  title: \"Book a Pod | Pelangi Capsule Hostel JB — From RM35/night\",\n  description:\n    \"Book your capsule pod at Pelangi Capsule Hostel in Johor Bahru. Direct WhatsApp booking from RM35/night or RM594/month. No platform fees, instant confirmation.\",\n  keywords: [\n    \"book capsule hostel JB\",\n    \"Johor Bahru hostel booking\",\n    \"budget accommodation JB\",\n    \"Pelangi Capsule Hostel\",\n    \"capsule pod JB\",\n  ],\n  alternates: {\n    canonical: \"https://pelangicapsulehostel.com/book\",\n  },\n  openGraph: {\n    title: \"Book a Pod | Pelangi Capsule Hostel JB\",\n    description:\n      \"Book direct from RM35/night. WhatsApp booking, no platform fees, instant confirmation at Pelangi Capsule Hostel Johor Bahru.\",\n    url: \"https://pelangicapsulehostel.com/book\",\n    siteName: \"Pelangi Capsule Hostel\",\n    type: \"website\",\n  },\n};\n\nconst WHATSAPP_URL =\n  \"https://wa.me/60127088789?text=Hi%20Pelangi%20Capsule%20Hostel!%20I'd%20like%20to%20book%20a%20pod.%20Please%20confirm%20availability%20for%20%5Bdates%5D.\";\n\nconst directBenefits = [\n  {\n    icon: \"M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z\",\n    title: \"No Platform Fees\",\n    description: \"Save on OTA commissions — get the best rate guaranteed\",\n  },\n  {\n    icon: \"M13 10V3L4 14h7v7l9-11h-7z\",\n    title: \"Instant Confirmation\",\n    description: \"Get confirmed within minutes via WhatsApp reply\",\n  },\n  {\n    icon: \"M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z\",\n    title: \"Pay at Arrival\",\n    description: \"No credit card needed — pay cash or card when you check in\",\n  },\n  {\n    icon: \"M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z\",\n    title: \"Personal Service\",\n    description: \"Chat directly with Jay or Alston — real people, real answers\",\n  },\n];\n\nconst houseRules = [\n  { rule: \"Check-in from 2:00 PM\", icon: \"M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z\" },\n  { rule: \"Check-out by 12:00 PM\", icon: \"M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1\" },\n  { rule: \"No smoking indoors\", icon: \"M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636\" },\n  { rule: \"Quiet hours: 11 PM – 7 AM\", icon: \"M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z\" },\n  { rule: \"Valid ID required at check-in\", icon: \"M10 6H5a2 2 0 00-2 2v9a2 2 0 0