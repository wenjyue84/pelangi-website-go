{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015mC5oQNEtWV7Z7dvqsTmfR","type":"tool_result","content":"100\t  \"reservationStatus\": \"https://schema.org/ReservationPending\",\n101\t  \"reservationFor\": {\n102\t    \"@type\": \"LodgingBusiness\",\n103\t    \"@id\": \"https://pelangicapsulehostel.com/#hostel\",\n104\t    \"name\": \"Pelangi Capsule Hostel\",\n105\t    \"address\": {\n106\t      \"@type\": \"PostalAddress\",\n107\t      \"streetAddress\": \"26A Jalan Perang, Taman Pelangi\",\n108\t      \"addressLocality\": \"Johor Bahru\",\n109\t      \"addressRegion\": \"Johor\",\n110\t      \"postalCode\": \"80400\",\n111\t      \"addressCountry\": \"MY\",\n112\t    },\n113\t  },\n114\t  \"checkinTime\": \"T14:00:00\",\n115\t  \"checkoutTime\": \"T12:00:00\",\n116\t  \"totalPrice\": \"37.80\",\n117\t  \"priceCurrency\": \"MYR\",\n118\t};\n119\t\n120\texport default async function BookPage() {\n121\t  // Read variant from middleware (set in response header)\n122\t  const headersList = await headers();\n123\t  const variant = (headersList.get(\"x-variant\") ?? \"book-now\") as any;\n124\t  const ctaText = getCTAText(variant);\n125\t\n126\t  return (\n127\t    <main id=\"main-content\" className=\"min-h-screen bg-stone-50 dark:bg-stone-950\">\n128\t      <script\n129\t        type=\"application/ld+json\"\n130\t        dangerouslySetInnerHTML={{ __html: JSON.stringify(lodgingReservationSchema) }}\n131\t      />\n132\t      <Header />\n133\t\n134\t      {/* Hero */}\n135\t      <section className=\"pt-28 pb-16 bg-linear-to-b from-amber-800 to-amber-900 text-white relative overflow-hidden\">\n136\t        <div className=\"absolute inset-0\">\n137\t          <div className=\"absolute top-0 left-0 w-96 h-96 bg-amber-700/50 rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2\" />\n138\t          <div className=\"absolute bottom-0 right-0 w-96 h-96 bg-orange-600/20 rounded-full blur-3xl translate-x-1/2 translate-y-1/2\" />\n139\t        </div>\n140\t\n141\t        <div className=\"container-custom relative text-center\">\n142\t          <p className=\"text-xs font-medium tracking-[0.3em] uppercase text-amber-300 mb-4\">\n143\t            Book Your Stay\n144\t          </p>\n145\t          <h1 className=\"font-display text-4xl md:text-5xl lg:text-6xl font-medium mb-6\">\n146\t            Reserve Your Pod\n147\t          </h1>\n148\t          <p className=\"text-amber-200 text-lg max-w-2xl mx-auto mb-10 leading-relaxed\">\n149\t            Book direct via WhatsApp for the best rate — no platform fees, instant\n150\t            confirmation, and pay at arrival.\n151\t          </p>\n152\t\n153\t          {/* Primary WhatsApp CTA — variant: {variant} */}\n154\t          <a\n155\t            href={WHATSAPP_URL}\n156\t            target=\"_blank\"\n157\t            rel=\"noopener noreferrer\"\n158\t            className=\"inline-flex items-center gap-3 bg-green-500 text-white rounded-2xl\n159\t                       py-5 px-10 font-semibold text-lg hover:bg-green-600 transition-all\n160\t                       duration-300 hover:-translate-y-1 hover:shadow-xl\"\n161\t            aria-label=\"Book via WhatsApp\"\n162\t            data-variant={variant}\n163\t          >\n164\t            <svg className=\"w-6 h-6\" fill=\"currentColor\" viewBox=\"0 0 24 24\">\n165\t              <path d=\"M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-