      </li>\n275\t                <li className=\"flex items-center gap-2\">\n276\t                  <svg className=\"w-5 h-5 text-green-500 shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M5 13l4 4L19 7\" /></svg>\n277\t                  Ideal for remote workers & digital nomads\n278\t                </li>\n279\t                <li className=\"flex items-center gap-2\">\n280\t                  <svg className=\"w-5 h-5 text-green-500 shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M5 13l4 4L19 7\" /></svg>\n281\t                  Flexible start date\n282\t                </li>\n283\t              </ul>\n284\t            </div>\n285\t          </div>\n286\t\n287\t          {/* Trust Signals */}\n288\t          <TrustSignals />\n289\t\n290\t          {/* Booking Form */}\n291\t          <div className=\"mt-12 max-w-md mx-auto\">\n292\t            <BookingForm />\n293\t          </div>\n294\t\n295\t          {/* Or divider */}\n296\t          <div className=\"mt-10 flex items-center gap-4 max-w-md mx-auto\">\n297\t            <div className=\"flex-1 border-t border-stone-200 dark:border-stone-700\" />\n298\t            <span className=\"text-xs font-medium text-stone-400 dark:text-stone-500 uppercase tracking-wider\">\n299\t              or pay deposit online\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"5db64454-1df5-4c1c-9e81-ebba85b5ca40","uuid":"45eda6f8-cfd9-426a-89f2-3f0763db2a23","timestamp":"2026-04-14T06:20:22.212Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\app\\book\\page.tsx","content":"  \"reservationStatus\": \"https://schema.org/ReservationPending\",\n  \"reservationFor\": {\n    \"@type\": \"LodgingBusiness\",\n    \"@id\": \"https://pelangicapsulehostel.com/#hostel\",\n    \"name\": \"Pelangi Capsule Hostel\",\n    \"address\": {\n      \"@type\": \"PostalAddress\",\n      \"streetAddress\": \"26A Jalan Perang, Taman Pelangi\",\n      \"addressLocality\": \"Johor Bahru\",\n      \"addressRegion\": \"Johor\",\n      \"postalCode\": \"80400\",\n      \"addressCountry\": \"MY\",\n    },\n  },\n  \"checkinTime\": \"T14:00:00\",\n  \"checkoutTime\": \"T12:00:00\",\n  \"totalPrice\": \"37.80\",\n  \"priceCurrency\": \"MYR\",\n};\n\nexport default async function BookPage() {\n  // Read variant from middleware (set in response header)\n  const headersList = await headers();\n  const variant = (headersList.get(\"x-variant\") ?? \"book-now\") as any;\n  const ctaText = getCTAText(variant);\n\n  return (\n    <main id=\"main-content\" className=\"min-h-screen bg-stone-50 dark:bg-stone-950\">\n      <script\n        type=\"application/ld+json\"\n        dangerouslySetInnerHTML={{ __html: JSON.stringify(lodgingReservationSchema) }}\n      />\n      <Header />\n\n      {/* Hero */}\n      <section className=\"pt-28 pb-16 bg-linear-to-b from-amber-800 to-amber-900 text-white relative overflow-hidden\">\n        <div className=\"absolute inset-0\">\n          <div className=\"absolute top-0 left-0 w-96 h-96 bg-amber-700/50 rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2\" />\n          <div className=\"absolute bottom-0 right-0 w-96 h-96 bg-orange-600/20 rounded-full blur-3xl translate-x-1/2 translate-y-1/2\" />\n        </div>\n\n        <div className=\"container-custom relative text-center\">\n          <p className=\"text-xs font-medium tracking-[0.3em] uppercase text-amber-300 mb-4\">\n            Book Your Stay\n          </p>\n          <h1 className=\"font-display text-4xl md:text-5xl lg:text-6xl font-medium mb-6\">\n            Reserve Your Pod\n          </h1>\n          <p className=\"text-amber-200 text-lg max-w-2xl mx-auto mb-10 leading-relaxed\">\n            Book direct via WhatsApp for the best rate — no platform fees, instant\n            confirmation, and pay at arrival.\n          </p>\n\n          {/* Primary WhatsApp CTA — variant: {variant} */}\n          <a\n            href={WHATSAPP_URL}\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            className=\"inline-flex items-center gap-3 bg-green-500 text-white rounded-2xl\n                       py-5 px-10 font-semibold text-lg hover:bg-green-600 transition-all\n                       duration-300 hover:-translate-y-1 hover:shadow-xl\"\n            aria-label=\"Book via WhatsApp\"\n            data-variant={variant}\n          >\n            <svg className=\"w-6 h-6\" fill=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path d=\"M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 