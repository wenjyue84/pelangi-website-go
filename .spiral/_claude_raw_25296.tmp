{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AMRn4wCRE3hASe9DAGr7Qf","type":"tool_result","content":"1\timport Link from \"next/link\";\n2\timport { headers } from \"next/headers\";\n3\timport Header from \"@/components/Header\";\n4\timport Footer from \"@/components/Footer\";\n5\timport BookingForm from \"@/components/BookingForm\";\n6\timport TrustSignals from \"@/components/TrustSignals\";\n7\timport BookEcommerceTracker from \"@/components/BookEcommerceTracker\";\n8\timport DuitNowPayment from \"@/components/DuitNowPayment\";\n9\timport FpxPaymentForm from \"@/components/FpxPaymentForm\";\n10\timport HeroTrustBadges from \"@/components/HeroTrustBadges\";\n11\timport ExitIntentOverlay from \"@/components/ExitIntentOverlay\";\n12\timport { getCTAText } from \"@/lib/flags\";\n13\timport type { Metadata } from \"next\";\n14\texport const metadata: Metadata = {\n15\t  title: \"Book a Pod | Pelangi Capsule Hostel JB — From RM35/night\",\n16\t  description:\n17\t    \"Book your capsule pod at Pelangi Capsule Hostel in Johor Bahru. Direct WhatsApp booking from RM35/night or RM594/month. No platform fees, instant confirmation.\",\n18\t  keywords: [\n19\t    \"book capsule hostel JB\",\n20\t    \"Johor Bahru hostel booking\",\n21\t    \"budget accommodation JB\",\n22\t    \"Pelangi Capsule Hostel\",\n23\t    \"capsule pod JB\",\n24\t  ],\n25\t  alternates: {\n26\t    canonical: \"https://pelangicapsulehostel.com/book\",\n27\t  },\n28\t  openGraph: {\n29\t    title: \"Book a Pod | Pelangi Capsule Hostel JB\",\n30\t    description:\n31\t      \"Book direct from RM35/night. WhatsApp booking, no platform fees, instant confirmation at Pelangi Capsule Hostel Johor Bahru.\",\n32\t    url: \"https://pelangicapsulehostel.com/book\",\n33\t    siteName: \"Pelangi Capsule Hostel\",\n34\t    type: \"website\",\n35\t  },\n36\t};\n37\t\n38\tconst WHATSAPP_URL =\n39\t  \"https://wa.me/60127088789?text=Hi%20Pelangi%20Capsule%20Hostel!%20I'd%20like%20to%20book