imestamps = entry.timestamps.filter((ts) => ts > windowStart);\n\n  // Reset is the moment the oldest request in this window expires\n  const oldestTs = entry.timestamps[0];\n  const reset = oldestTs\n    ? Math.ceil((oldestTs + windowMs) / 1000)","numLines":50,"startLine":1,"totalLines":152}}}
