sName=\"text-amber-700 dark:text-amber-400 hover:underline\">Local guide</Link>\n              {\" · \"}\n              <Link href=\"/check-in\" className=\"text-amber-700 dark:text-amber-400 hover:underline\">Check-in info</Link>\n            </p>\n          </div>\n        </div>\n      </section>\n\n      <Footer />\n      <BookEcommerceTracker />\n      <ExitIntentOverlay />\n    </main>\n  );\n}\n","structuredPatch":[{"oldStart":150,"oldLines":7,"newStart":150,"newLines":7,"lines":["             confirmation, and pay at arrival.","           </p>"," ","-          {/* Primary WhatsApp CTA */}","+          {/* Primary WhatsApp CTA — variant: {variant} */}","           <a","             href={WHATSAPP_URL}","             target=\"_blank\""]},{"oldStart":159,"oldLines":11,"newStart":159,"newLines":12,"lines":["                        py-5 px-10 font-semibold text-lg hover:bg-green-600 transition-all","                        duration-300 hover:-translate-y-1 hover:shadow-xl\"","             aria-label=\"Book via WhatsApp\"","+            data-variant={variant}","           >","             <svg className=\"w-6 h-6\" fill=\"currentColor\" viewBox=\"0 0 24 24\">","               <path d=\"M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884