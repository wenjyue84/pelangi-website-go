{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Pc52VaCHhBUqGezd53Dp1E","type":"tool_result","content":"1\t/**\n2\t * GA4 Enhanced Ecommerce event helpers.\n3\t * Pushes structured ecommerce events to the GTM dataLayer.\n4\t * Reference: https://developers.google.com/analytics/devguides/collection/ga4/ecommerce\n5\t */\n6\t\n7\tinterface EcommerceItem {\n8\t  item_id: string;\n9\t  item_name: string;\n10\t  item_category: string;\n11\t  price: number;\n12\t  currency: string;\n13\t  quantity?: number;\n14\t  index?: number;\n15\t}\n16\t\n17\tfunction pushEcommerceEvent(event: string, ecommerce: Record<string, unknown>) {\n18\t  if (typeof window === \"undefined\") return;\n19\t  const w = window as unknown as { dataLayer: Record<string, unknown>[] };\n20\t  w.dataLayer = w.dataLayer || [];\n21\t  // Clear previous ecommerce data to prevent carryover\n22\t  w.dataLayer.push({ ecommerce: null });\n23\t  w.dataLayer.push({ event, ecommerce });\n24\t}\n25\t\n26\t/** Fire when a room detail is viewed (e.g. on /rooms page load). */\n27\texport function trackViewItem(item: EcommerceItem) {\n28\t  pushEcommerceEvent(\"view_item\", {\n29\t    items: [{ ...item, quantity: item.quantity ?? 1 }],\n30\t  });\n31\t}\n32\t\n33\t/** Fire when a specific room type card is clicked from the /rooms listing. */\n34\texport function trackSelectItem(item: EcommerceItem, listName: string) {\n35\t  pushEcommerceEvent(\"select_item\", {\n36\t    item_list_name: listName,\n37\t    items: [{ ...item, quantity: item.quantity ?? 1 }],\n38\t  });\n39\t}\n40\t\n41\t/** Fire when guest initiates booking (clicks Book Now / expands booking section on /book). */\n42\texport function trackBeginCheckout(items: EcommerceItem[]) {\n43\t  pushEcommerceEvent(\"begin_checkout\", {\n44\t    items: items.map((i) => ({ ...i, quantity: i.quantity ?? 1 })),\n45\t  });\n46\t}\n47\t\n48\t/** Fire on contact form submission. */\n49\texport function trackGenerateLead(leadSource: string) {\n50\t  pushEcommerceEvent(\"generate_lead\", {\n51\t    lead_source: leadSource,\n52\t  });\n53\t}\n54\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"1403a882-28e6-402c-9776-2c404c6ba860","uuid":"c294d2c4-c8a9-4a18-8666-8fed425152fe","timestamp":"2026-04-14T06:08:43.128Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\lib\\gtm-ecommerce.ts","content":"/**\n * GA4 Enhanced Ecommerce event helpers.\n * Pushes structured ecommerce events to the GTM dataLayer.\n * Reference: https://developers.google.com/analytics/devguides/collection/ga4/ecommerce\n */\n\ninterface EcommerceItem {\n  item_id: string;\n  item_name: string;\n  item_category: string;\n  price: number;\n  currency: string;\n  quantity?: number;\n  index?: number;\n}\n\nfunction pushEcommerceEvent(event: string, ecommerce: Record<string, unknown>) {\n  if (typeof window === \"undefined\") return;\n  const w = window as unknown as { dataLayer: Record<string, unknown>[] };\n  w.dataLayer = w.dataLayer || [];\n  // Clear previous ecommerce data to prevent carryover\n  w.dataLayer.push({ ecommerce: null });\n  w.dataLayer.push({ event, ecommerce });\n}\n\n/** Fire when a room detail is viewed (e.g. on /rooms page load). */\nexport function trackViewItem(item: EcommerceItem) {\n  pushEcommerceEvent(\"view_item\", {\n    items: [{ ...item, quantity: item.quantity ?? 1 }],\n  });\n}\n\n/** Fire when a specific room type card is clicked from the /rooms listing. */\nexport function trackSelectItem(item: EcommerceItem, listName: string) {\n  pushEcommerceEvent(\"select_item\", {\n    item_list_name: listName,\n    items: [{ ...item, quantity: item.quantity ?? 1 }],\n  });\n}\n\n/** Fire when guest initiates booking (clicks Book Now / expands booking section on /book). */\nexport function trackBeginCheckout(items: EcommerceItem[]) {\n  pushEcommerceEvent(\"begin_checkout\", {\n    items: items.map((i) => ({ ...i, quantity: i.quantity ?? 1 })),\n  });\n}\n\n/** Fire on contact form submission. */\nexport function trackGenerateLead(leadSource: string) {\n  pushEcommerceEvent(\"generate_lead\", {\n    lead_source: leadSource,\n  });\n}\n","numLines":54,"startLine":1,"totalLines":54}}}
