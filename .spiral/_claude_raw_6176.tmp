{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FjN2sqzKW9VXMXVq89He2p","type":"tool_result","content":"1\t\"use client\";\n2\t\n3\timport { useId } from \"react\";\n4\t\n5\tinterface InfoPopoverProps {\n6\t  /** The trigger element (usually a button or badge) */\n7\t  children: React.ReactNode;\n8\t  /** Content shown inside the popover */\n9\t  content: React.ReactNode;\n10\t  /** Additional className for the trigger wrapper */\n11\t  className?: string;\n12\t  /** aria-label for the trigger button */\n13\t  ariaLabel?: string;\n14\t}\n15\t\n16\t/**\n17\t * Native HTML Popover API component with CSS Anchor Positioning.\n18\t * Provides keyboard navigation, Escape dismissal, and focus management\n19\t * via the platform — zero JavaScript positioning logic.\n20\t *\n21\t * - popover=\"auto\" → light-dismiss (click outside closes)\n22\t * - popovertarget → declarative trigger binding\n23\t * - CSS anchor-name / position-anchor → tethering without JS\n24\t * - @supports fallback for browsers without anchor positioning\n25\t */\n26\texport default function InfoPopover({\n27\t  children,\n28\t  content,\n29\t  className = \"\",\n30\t  ariaLabel,\n31\t}: InfoPopoverProps) {\n32\t  const id = useId();\n33\t  // Sanitize React's useId output (e.g. \":r0:\") into a valid CSS ident\n34\t  const safeId = id.replace(/[^a-zA-Z0-9-]/g, \"\");\n35\t  const popoverId = `popover-${safeId}`;\n36\t  const anchorName = `--anchor-${safeId}`;\n37\t\n38\t  return (\n39\t    <span className={`info-popover-anchor ${className}`}>\n40\t      <button\n41\t        type=\"button\"\n42\t        popoverTarget={popoverId}\n43\t        className=\"info-popover-trigger\"\n44\t        aria-label={ariaLabel}\n45\t        style={{ anchorName } as React.CSSProperties}\n46\t      >\n47\t        {children}\n48\t      </button>\n49\t      <div\n50\t        id={popoverId}\n51\t        popover=\"auto\"\n52\t        className=\"info-popover\"\n53\t        role=\"status\"\n54\t        style={{ positionAnchor: anchorName } as React.CSSProperties}\n55\t      >\n56\t        {content}\n57\t      </div>\n58\t    </span>\n59\t  );\n60\t}\n61\t"}]},"parent_tool_use_id":null,"session_id":"a6a2d14e-7283-489b-bbc5-9e98631480bf","uuid":"964a6ef4-3494-4990-a84c-07373300e34d","timestamp":"2026-04-14T00:19:19.825Z","tool_use_result":{"type":"text","file":{"filePath":"/c/Users/Jyue/Documents/1-projects/Software Projects/pelangi-website/site/src/components/InfoPopover.tsx","content":"\"use client\";\n\nimport { useId } from \"react\";\n\ninterface InfoPopoverProps {\n  /** The trigger element (usually a button or badge) */\n  children: React.ReactNode;\n  /** Content shown inside the popover */\n  content: React.ReactNode;\n  /** Additional className for the trigger wrapper */\n  className?: string;\n  /** aria-label for the trigger button */\n  ariaLabel?: string;\n}\n\n/**\n * Native HTML Popover API component with CSS Anchor Positioning.\n * Provides keyboard navigation, Escape dismissal, and focus management\n * via the platform — zero JavaScript positioning logic.\n *\n * - popover=\"auto\" → light-dismiss (click outside closes)\n * - popovertarget → declarative trigger binding\n * - CSS anchor-name / position-anchor → tethering without JS\n * - @supports fallback for browsers without anchor positioning\n */\nexport default function InfoPopover({\n  children,\n  content,\n  className = \"\",\n  ariaLabel,\n}: InfoPopoverProps) {\n  const id = useId();\n  // Sanitize React's useId output (e.g. \":r0:\") into a valid CSS ident\n  const safeId = id.replace(/[^a-zA-Z0-9-]/g, \"\");\n  const popoverId = `popover-${safeId}`;\n  const anchorName = `--anchor-${safeId}`;\n\n  return (\n    <span className={`info-popover-anchor ${className}`}>\n      <button\n        type=\"button\"\n        popoverTarget={popoverId}\n        className=\"info-popover-trigger\"\n        aria-label={ariaLabel}\n        style={{ anchorName } as React.CSSProperties}\n      >\n        {children}\n      </button>\n      <div\n        id={popoverId}\n        popover=\"auto\"\n        className=\"info-popover\"\n        role=\"status\"\n        style={{ positionAnchor: anchorName } as React.CSSProperties}\n      >\n        {content}\n      </div>\n    </span>\n  );\n}\n","numLines":61,"startLine":1,"totalLines":61}}}
