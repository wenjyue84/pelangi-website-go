{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WVrqafrwzfii6AiTYoZRsD","type":"tool_result","content":"1\t\"use client\";\n2\t\n3\timport type { Route } from \"next\";\n4\timport { useState, useEffect, useCallback } from \"react\";\n5\timport Link from \"next/link\";\n6\timport Image from \"next/image\";\n7\timport dynamic from \"next/dynamic\";\n8\timport LanguageSwitcher from \"./LanguageSwitcher\";\n9\timport BookNowCTA from \"./BookNowCTA\";\n10\timport InfoPopover from \"./InfoPopover\";\n11\timport {\n12\t  SEARCH_ARIA,\n13\t  SEARCH_ARIA_DESKTOP,\n14\t} from \"@/lib/ui-labels\";\n15\t\n16\tfunction pushNavEvent(href: string) {\n17\t  if (typeof window === \"undefined\") return;\n18\t  const w = window as unknown as { dataLayer: Record<string, unknown>[] };\n19\t  w.dataLayer = w.dataLayer || [];\n20\t  w.dataLayer.push({ event: \"nav_click\", nav_href: href });\n21\t}\n22\t\n23\tconst SearchDialog = dynamic(() => import(\"./SearchDialog\"), { ssr: false });\n24\t\n25\texport default function Header() {\n26\t  const [isMenuOpen, setIsMenuOpen] = useState(false);\n27\t  const [isSearchOpen, setIsSearchOpen] = useState(false);\n28\t\n29\t  const closeSearch = useCallback(() => setIsSearchOpen(false), []);\n30\t\n31\t  // Cmd/Ctrl+K keyboard shortcut + Escape to close mobile nav\n32\t  useEffect(() => {\n33\t    function handleKeyDown(e: KeyboardEvent) {\n34\t      if ((e.metaKey || e.ctrlKey) && e.key === \"k\") {\n35\t        e.preventDefault();\n36\t        setIsSearchOpen((prev) => !prev);\n37\t      }\n38\t      if (e.key === \"Escape\" && isMenuOpen) {\n39\t        setIsMenuOpen(false);\n40\t      }"}]},"parent_tool_use_id":null,"session_id":"a6a2d14e-7283-489b-bbc5-9e98631480bf","uuid":"bb07aef5-1d61-4b14-9e38-19c6294fd853","timestamp":"2026-04-14T00:19:26.321Z","tool_use_result":{"type":"text","file":{"filePath":"/c/Users/Jyue/Documents/1-projects/Software Projects/pelangi-website/site/src/components/Header.tsx","content":"\"use client\";\n\nimport type { Route } from \"next\";\nimport { useState, useEffect, useCallback } from \"react\";\nimport Link from \"next/link\";\nimport Image from \"next/image\";\nimport dynamic from \"next/dynamic\";\nimport LanguageSwitcher from \"./LanguageSwitcher\";\nimport BookNowCTA from \"./BookNowCTA\";\nimport InfoPopover from \"./InfoPopover\";\nimport {\n  SEARCH_ARIA,\n  SEARCH_ARIA_DESKTOP,\n} from \"@/lib/ui-labels\";\n\nfunction pushNavEvent(href: string) {\n  if (typeof window === \"undefined\") return;\n  const w = window as unknown as { dataLayer: Record<string, unknown>[] };\n  w.dataLayer = w.dataLayer || [];\n  w.dataLayer.push({ event: \"nav_click\", nav_href: href });\n}\n\nconst SearchDialog = dynamic(() => import(\"./SearchDialog\"), { ssr: false });\n\nexport default function Header() {\n  const [isMenuOpen, setIsMenuOpen] = useState(false);\n  const [isSearchOpen, setIsSearchOpen] = useState(false);\n\n  const closeSearch = useCallback(() => setIsSearchOpen(false), []);\n\n  // Cmd/Ctrl+K keyboard shortcut + Escape to close mobile nav\n  useEffect(() => {\n    function handleKeyDown(e: KeyboardEvent) {\n      if ((e.metaKey || e.ctrlKey) && e.key === \"k\") {\n        e.preventDefault();\n        setIsSearchOpen((prev) => !prev);\n      }\n      if (e.key === \"Escape\" && isMenuOpen) {\n        setIsMenuOpen(false);\n      }","numLines":40,"startLine":1,"totalLines":173}}}
