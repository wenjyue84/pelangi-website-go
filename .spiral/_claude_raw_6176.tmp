{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PLvB85Ry84qde1vM7esRtz","type":"tool_result","content":"1\t\"use client\";\n2\t\n3\timport { useEffect, useRef } from \"react\";\n4\timport InfoPopover from \"./InfoPopover\";\n5\t\n6\tfunction pushEvent(eventName: string, params: Record<string, string>) {\n7\t  if (typeof window === \"undefined\") return;\n8\t  const w = window as unknown as { dataLayer: Record<string, unknown>[] };\n9\t  w.dataLayer = w.dataLayer || [];\n10\t  w.dataLayer.push({ event: eventName, ...params });\n11\t}\n12\t\n13\texport default function HeroTrustBadges() {\n14\t  const ref = useRef<HTMLDivElement>(null);\n15\t  const tracked = useRef(false);\n16\t\n17\t  // Track impression when badges enter viewport\n18\t  useEffect(() => {\n19\t    const el = ref.current;\n20\t    if (!el || tracked.current) return;\n21\t    const observer = new IntersectionObserver(\n22\t      ([entry]) => {\n23\t        if (entry.isIntersecting && !tracked.current) {\n24\t          tracked.current = true;\n25\t          pushEvent(\"trust_badges_impression\", {\n26\t            badge_location: \"book_hero\",\n27\t          });\n28\t          observer.disconnect();\n29\t        }\n30\t      },\n31\t      { threshold: 0.5 }\n32\t    );\n33\t    observer.observe(el);\n34\t    return () => observer.disconnect();\n35\t  }, []);\n36\t\n37\t  function handleBadgeClick(badgeName: string) {\n38\t    pushEvent(\"trust_badge_click\", {\n39\t      badge_name: badgeName,\n40\t      badge_location: \"book_hero\",\n41\t    });\n42\t  }\n43\t\n44\t  return (\n45\t    <div ref={ref} className=\"mt-6 space-y-4\">\n46\t      {/* Trust badges row */}\n47\t      <div className=\"flex flex-wrap justify-center gap-2\">\n48\t        <InfoPopover\n49\t          content=\"Based on 100+ verified guest reviews on Booking.com\"\n50\t          ariaLabel=\"Rated 8.4 out of 10 on Booking.com\"\n51\t        >\n52\t          <span\n53\t            role=\"button\"\n54\t            onClick={() => handleBadgeClick(\"booking_rating\")}\n55\t            className=\"inline-flex items-center gap-1.5 bg-white/15 backdrop-blur-sm rounded-full px-3 py-1.5 text-xs text-white/90 border border-white/20 hover:bg-white/25 transition-colors cursor-default\"\n56\t          >\n57\t            <svg className=\"w-3.5 h-3.5 text-yellow-300\" fill=\"currentColor\" viewBox=\"0 0 20 20\" aria-hidden=\"true\">\n58\t              <path d=\"M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z\" />\n59\t            </svg>\n60\t            <span><strong>8.4</strong>/10 Booking.com</span>\n61\t          </span>\n62\t        </InfoPopover>\n63\t\n64\t        <InfoPopover\n65\t          content=\"Welcoming travellers from 30+ countries since 2013\"\n66\t          ariaLabel=\"Over 500 guests hosted since 2013\"\n67\t        >\n68\t          <span\n69\t            role=\"button\"\n70\t            onClick={() => handleBadgeClick(\"guests_hosted\")}\n71\t            className=\"inline-flex items-center gap-1.5 bg-white/15 backdrop-blur-sm rounded-full px-3 py-1.5 text-xs text-white/90 border border-white/20 hover:bg-white/25 transition-colors cursor-default\"\n72\t          >\n73\t            <svg className=\"w-3.5 h-3.5 text-green-300\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n74\t              <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z\" />\n75\t            </svg>\n76\t            <span><strong>500+</strong> guests hosted</span>\n77\t          </span>\n78\t        </InfoPopover>\n79\t\n80\t        <InfoPopover\n81\t          content=\"Book direct and save up to RM13/night vs OTA prices\"\n82\t          ariaLabel=\"Best price guaranteed when booking direct\"\n83\t        >\n84\t          <span\n85\t            role=\"button\"\n86\t            onClick={() => handleBadgeClick(\"best_price\")}\n87\t            className=\"inline-flex items-center gap-1.5 bg-white/15 backdrop-blur-sm rounded-full px-3 py-1.5 text-xs text-white/90 border border-white/20 hover:bg-white/25 transition-colors cursor-default\"\n88\t          >\n89\t            <svg className=\"w-3.5 h-3.5 text-amber-300\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n90\t              <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z\" />\n91\t            </svg>\n92\t            <span><strong>Best Price</strong> Guarantee</span>\n93\t          </span>\n94\t        </InfoPopover>\n95\t      </div>\n96\t\n97\t      {/* Compact price comparison */}\n98\t      <div className=\"flex items-center justify-center gap-3 text-xs text-white/80\">\n99\t        <span className=\"flex items-center gap-1\">\n100\t          <span className=\"font-semibold text-white\">From RM35</span>/night direct\n101\t        </span>\n102\t        <span className=\"text-white/40\">|</span>\n103\t        <span className=\"flex items-center gap-1\">\n104\t          <span className=\"line-through text-white/50\">RM56+</span>\n105\t          <span>on OTAs</span>\n106\t        </span>\n107\t        <span className=\"text-white/40\">|</span>\n108\t        <span className=\"text-green-300 font-semibold\">Save up to RM13</span>\n109\t      </div>\n110\t    </div>\n111\t  );\n112\t}\n113\t"}]},"parent_tool