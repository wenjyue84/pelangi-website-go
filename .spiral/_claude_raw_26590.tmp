0\">\n72\t            Everything You Need, Nothing You Don&apos;t\n73\t          </h3>\n74\t          {/* Grid uses viewport breakpoints for column count; each cell is a container\n75\t              so internal card layout adapts to its own available width (container queries) */}\n76\t          <div className=\"grid sm:grid-cols-2 lg:grid-cols-3 gap-6\">\n77\t            {hostelHighlights.map((highlight, index) => (\n78\t              <div key={index} className=\"@container\">\n79\t                <div className=\"bg-stone-50 dark:bg-stone-800 rounded-2xl p-4 @[240px]:p-6 hover:bg-stone-100 dark:hover:bg-stone-700 transition-colors group\">\n80\t                  <div className=\"w-10 h-10 @[240px]:w-12 @[240px]:h-12 rounded-xl bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center mb-3 @[240px]:mb-4 group-hover:bg-amber-200 transition-colors\">\n81\t                    <svg className=\"w-5 h-5 @[240px]:w-6 @[240px]:h-6 text-amber-700 dark:text-amber-400\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n82\t                      <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={1.5} d={highlight.icon} />\n83\t                    </svg>\n84\t                  </div>\n85\t                  <h4 className=\"font-semibold text-stone-900 dark:text-stone-100 mb-2 text-sm @[240px]:text-base\">{highlight.title}</h4>\n86\t                  <p className=\"text-stone-500 dark:text-stone-400 text-xs @[240px]:text-sm\">{highlight.description}</p>\n87\t                </div>\n88\t              </div>\n89\t            ))}\n90\t          </div>\n91\t        </div>\n92\t\n93\t        {/* Night Market Feature - Unique Selling Point */}\n94\t        <div className=\"bg-linear-to-br from-amber-50 to-orange-50 dark:from-amber-900/20 dark:to-orange-900/20 rounded-3xl p-8 md:p-12 relative overflow-hidden\">\n95\t          <div className=\"absolute top-0 right-0 w-64 h-64 bg-amber-100 dark:bg-amber-900/30 rounded-full -translate-y-1/2 translate-x-1/2 opacity-50\" />\n96\t          <div className=\"absolute bottom-0 left-0 w-48 h-48 bg-orange-100 dark:bg-orange-900/30 rounded-full translate-y-1/2 -translate-x-1/2 opacity-50\" />\n97\t\n98\t          <div className=\"relative grid md:grid-cols-2 gap-8 items-center\">\n99\t            <div>\n100\t              <div className=\"inline-flex items-center gap-2 px-4 py-2 bg-amber-100 dark:bg-amber-900/30 rounded-full text-amber-800 dark:text-amber-300 text-sm font-medium mb-6\">\n101\t                <svg className=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n102\t                  <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2}\n103\t                    d=\"M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z\" />\n104\t                </svg>\n105\t                Local Experience\n106\t              </div>\n107\t              <h3 className=\"font-display text-3xl md:text-4xl font-medium text-stone-900 dark:text-stone-100 mb-4\">\n108\t                Night Market at Your Doorstep\n109\t              </h3>\n110\t              <p className=\"text-lg text-stone-600 dark:text-stone-400 mb-6\">\n111\t                Every <span className=\"font-semibold text-amber-700 dark:text-amber-400\">Tuesday from 4:30 PM</span>,\n112\t                step outside and you&apos;re in the heart of <LangMs>Taman Pelangi</LangMs>&apos;s famous <LangMs>pasar malam</LangMs>.\n113\t              </p>\n114\t              <div className=\"space-y-3 text-stone-600 dark:text-stone-400\">\n115\t                <div className=\"flex items-start gap-3\">\n116\t                  <svg className=\"w-5 h-5 text-amber-600 dark:text-amber-400 shrink-0 mt-0.5\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n117\t                    <path fillRule=\"evenodd\" d=\"M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z\" clipRule=\"evenodd\" />\n118\t                  </svg>\n119\t                  <span><strong>500+ meters</strong> of food stalls right in front of hostel</span>\n120\t                </div>\n121\t                <div className=\"flex items-start gap-3\">\n122\t                  <svg className=\"w-5 h-5 text-amber-600 dark:text-amber-400 shrink-0 mt-0.5\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n123\t                    <path fillRule=\"evenodd\" d=\"M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z\" clipRule=\"evenodd\" />\n124\t                  </svg>\n125\t                  <span><strong>Authentic Malaysian street food</strong> — <LangMs>satay</LangMs>, oyster omelette, claypot rice</span>\n126\t                </div>\n127\t                <div className=\"flex items-start gap-3\">\n128\t                  <svg className=\"w-5 h-5 text-amber-600 dark:text-amber-400 shrink-0 mt-0.5\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n129\t                    <path fillRule=\"evenodd\" d=\"M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z\" clipRule=\"evenodd\" />\n130\t                  </svg>\n131\t                  <span><strong>Local prices</strong> — eat like a local, pay like a local</span>\n132\t                </div>\n133\t              </div>\n134\t              <p className=\"text-sm text-amber-700 dark:text-amber-400 mt-6 font-medium\">\n135\t                Pro tip: Arrive by 4 PM to catch the best selection before the crowds!\n136\t              </p>\n137\t            </div>\n138\t            <div className=\"relative h-64 md:h-80 rounded-2xl overflow-hidden shadow-xl\">\n139\t              <Image\n140\t                src={pasarMalamImage}\n141\t                alt=\"Taman Pelangi Pasar Malam night market with street food stalls near Pelangi Capsule Hostel\"\n142\t                fill\n143\t                sizes=\"(max-width: 768px) 100vw, 50vw\"\n144\t                className=\"object-cover\"\n145\t                placeholder=\"blur\"\n146\t                fetchPriority=\"low\"\n147\t              />\n148\t              <div className=\"absolute inset-0 bg-linear-to-t from-stone-900/60 via-transparent to-transparent\" />\n149\t              <div className=\"absolute bottom-4 left-4 text-white\">\n150\t                <div className=\"text-sm font-medium\"><LangMs>Pasar Malam Taman Pelangi</LangMs></div>\n151\t                <div className=\"text-xs opacity-80\">Every Tuesday, 4:30 PM - 9 PM</div>\n152\t              </div>\n153\t            </div>\n154\t          </div>\n155\t        </div>\n156\t\n157\t        {/* Why Choose Capsule */}\n158\t        <div className=\"mt-16 text-center max-w-3xl mx-auto\">\n159\t          <h3 className=\"font-display text-2xl font-medium text-stone-900 dark:text-stone-100 mb-6\">\n160\t            Why Choose a Capsule Hostel?\n161\t          </h3>\n162\t          <div className=\"grid sm:grid-cols-2 gap-6 text-left\">\n163\t            <div className=\"flex gap-4\">\n164\t              <div className=\"w-10 h-10 rounded-full bg-green-100 dark:bg-green-900/30 flex items-center justify-center shrink-0\">\n165\t                <svg className=\"w-5 h-5 text-green-600 dark:text-green-400\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n166\t                  <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z\" />\n167\t                </svg>\n168\t              </div>\n169\t              <div>\n170\t                <h4 className=\"font-semibold text-stone-900 dark:text-stone-100\">More Privacy Than Dorms</h4>\n171\t                <p className=\"text-sm text-stone-500 dark:text-stone-400\">Your own enclosed space with a door that locks — not just a curtain</p>\n172\t              </div>\n173\t            </div>\n174\t            <div className=\"flex gap-4\">\n175\t              <div className=\"w-10 h-10 rounded-full bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center shrink-0\">\n176\t                <svg className=\"w-5 h-5 text-blue-600 dark:text-blue-400\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n177\t                  <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z\" />\n178\t                </svg>\n179\t              </div>\n180\t              <div>\n181\t                <h4 className=\"font-semibold text-stone-900 dark:text-stone-100\">Better Value Than Hotels</h4>\n182\t                <p className=\"text-sm text-stone-500 dark:text-stone-400\">All the essentials for a fraction of the price — spend savings exploring JB</p>\n183\t              </div>\n184\t            </div>\n185\t            <div className=\"flex gap-4\">\n186\t              <div className=\"w-10 h-10 rounded-full bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center shrink-0\">\n187\t                <svg className=\"w-5 h-5 text-purple-600 dark:text-purple-400\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n188\t                  <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z\" />\n189\t                </svg>\n190\t              </div>\n191\t              <div>\n192\t                <h4 className=\"font-semibold text-stone-900 dark:text-stone-100\">Tech-Forward Comfort</h4>\n193\