{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Xuov3XjzbhjwL3BfNUpxyW","type":"tool_result","content":"1\timport { NextResponse } from \"next/server\";\n2\timport type { NextRequest } from \"next/server\";\n3\timport { ROOM_TYPES, PROPERTY } from \"@/data/rooms\";\n4\timport { beds24Client } from \"@/lib/beds24-client\";\n5\t\n6\t/**\n7\t * ARI (Availability, Rates, Inventory) endpoint for connectivity partners.\n8\t *\n9\t * Google Free Booking Links require a connectivity partner (e.g., Beds24,\n10\t * Cloudbeds, RoomRaccoon) to pull live rates and availability. This endpoint\n11\t * exposes the hostel's ARI data in a standard JSON format that partners can\n12\t * consume via their pull-based integration.\n13\t *\n14\t * Pulls real-time data from the configured channel manager (Beds24).\n15\t * Falls back to local room data if channel manager is not configured.\n16\t *\n17\t * Query params:\n18\t *   - checkin  (YYYY-MM-DD, required)\n19\t *   - checkout (YYYY-MM-DD, required)\n20\t *   - currency (default: MYR)\n21\t *\n22\t * Authentication: API key via x-api-key header (set ARI_API_KEY env var).\n23\t */\n24\texport async function GET(request: NextRequest) {\n25\t  const apiKey = process.env.ARI_API_KEY;\n26\t  if (apiKey) {\n27\t    const provided = request.headers.get(\"x-api-key\");\n28\t    if (provided !== apiKey) {\n29\t      return NextResponse.json(\n30\t        { error: \"Unauthorized\" },\n31\t        { status: 401 },\n32\t      );\n33\t    }\n34\t  }\n35\t\n36\t  const params = request.nextUrl.searchParams;\n37\t  const checkin = params.get(\"checkin\");\n38\t  const checkout = params.get(\"checkout\");\n39\t  const currency = params.get(\"currency\") || \"MYR\";\n40\t\n41\t  if (!checkin || !checkout) {\n42\t    return NextResponse.json(\n43\t      { error: \"checkin and checkout query parameters are required (YYYY-MM-DD)\" },\n44\t      { status: 400 },\n45\t    );\n46\t  }\n47\t\n48\t  const checkinDate = new Date(checkin);\n49\t  const checkoutDate = new Date(checkout);\n50\t\n51\t  if (isNaN(checkinDate.getTime()) || isNaN(checkoutDate.getTime())) {\n52\t    return NextResponse.json(\n53\t      { error: \"Invalid date format. Use YYYY-MM-DD.\" },\n54\t      { status: 400 },\n55\t    );\n56\t  }\n57\t\n58\t  if (checkoutDate <= checkinDate) {\n59\t    return NextResponse.json(\n60\t      { error: \"checkout must be after checkin\" },\n61\t      { status: 400 },\n62\t    );\n63\t  }\n64\t\n65\t  const nights = Math.ceil(\n66\t    (checkoutDate.getTime() - checkinDate.getTime()) / (1000 * 60 * 60 * 24),\n67\t  );\n68\t\n69\t  // Fetch live availability from channel manager\n70\t  const channelAvailability = await beds24Client.getAvailability(checkin, checkout);\n71\t\n72\t  // Map to ARI response format\n73\t  const rooms = ROOM_TYPES.map((room) => {\n74\t    const channelRoom = channelAvailability.find((r) => r.roomId === room.id);\n75\t    const availableUnits = channelRoom?.available ?? room.totalUnits;\n76\t    const totalInventory = channelRoom?.total ?? room.totalUnits;\n77\t\n78\t    return {\n79\t      room_id: room.id,\n80\t      room_name: room.name,\n81\t      description: room.description,\n82\t      max_occupancy: room.maxOccupancy,\n83\t      total_inventory: totalInventory,\n84\t      available_units: Math.max(0, availableUnits),\n85\t      rate: {\n86\t        nightly: room.nightlyRate,\n87\t        total: room.nightlyRate * nights,\n88\t        currency,\n89\t      },\n90\t      amenities: room.amenities,\n91\t    };\n92\t  });\n93\t\n94\t  const response = {\n95\t    property_id: PROPERTY.id,\n96\t    property_name: PROPERTY.name,\n97\t    checkin,\n98\t    checkout,\n99\t    nights,\n100\t    currency,\n101\t    timezone: PROPERTY.timezone,\n102\t    checkin_time: PROPERTY.checkinTime,\n103\t    checkout_time: PROPERTY.checkoutTime,\n104\t    rooms,\n105\t    booking_url: `https://pelangicapsulehostel.com/book?checkin=${checkin}&checkout=${checkout}`,\n106\t    updated_at: new Date().toISOString(),\n107\t  };\n108\t\n109\t  return NextResponse.json(response, {\n110\t    headers: {\n111\t      \"Cache-Control\": \"public, max-age=300, s-maxage=300\",\n112\t    },\n113\t  });\n114\t}\n115\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"a16f91ac-2e27-4e8a-bf46-dfd84cbb51f9","uuid":"12a44e1e-018b-4543-8723-c41525c7e194","timestamp":"2026-04-14T01:45:00.329Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\app\\api\\ari\\route.ts","content":"import { NextResponse } from \"next/server\";\nimport type { NextRequest } from \"next/server\";\nimport { ROOM_TYPES, PROPERTY } from \"@/data/rooms\";\nimport { beds24Client } from \"@/lib/beds24-client\";\n\n/**\n * ARI (Availability, Rates, Inventory) endpoint for connectivity partners.\n *\n * Google Free Booking Links require a connectivity partner (e.g., Beds24,\n * Cloudbeds, RoomRaccoon) to pull live rates and availability. This endpoint\n * exposes the hostel's ARI data in a standard JSON format that partners can\n * consume via their pull-based integration.\n *\n * Pulls real-time data from the configured channel manager (Beds24).\n * Falls back to local room data if channel manager is not configured.\n *\n * Query params:\n *   - checkin  (YYYY-MM-DD, required)\n *   - checkout (YYYY-MM-DD, required)\n *   - currency (default: MYR)\n *\n * Authentication: API key via x-api-key header (set ARI_API_KEY env var).\n */\nexport async function GET(request: NextRequest) {\n  const apiKey = process.env.ARI_API_KEY;\n  if (apiKey) {\n    const provided = request.headers.get(\"x-api-key\");\n    if (provided !== apiKey) {\n      return NextResponse.json(\n        { error: \"Unauthorized\" },\n        { status: 401 },\n      );\n    }\n  }\n\n  const params = request.nextUrl.searchParams;\n  const checkin = params.get(\"checkin\");\n  const checkout = params.get(\"checkout\");\n  const currency = params.get(\"currency\") || \"MYR\";\n\n  if (!checkin || !checkout) {\n    return NextResponse.json(\n      { error: \"checkin and checkout query parameters are required (YYYY-MM-DD)\" },\n      { status: 400 },\n    );\n  }\n\n  const checkinDate = new Date(checkin);\n  const checkoutDate = new Date(checkout);\n\n  if (isNaN(checkinDate.getTime()) || isNaN(checkoutDate.getTime())) {\n    return NextResponse.json(\n      { error: \"Invalid date format. Use YYYY-MM-DD.\" },\n      { status: 400 },\n    );\n  }\n\n  if (checkoutDate <= checkinDate) {\n    return NextResponse.json(\n      { error: \"checkout must be after checkin\" },\n      { status: 400 },\n    );\n  }\n\n  const nights = Math.ceil(\n    (checkoutDate.getTime() - checkinDate.getTime()) / (1000 * 60 * 60 * 24),\n  );\n\n  // Fetch live availability from channel manager\n  const channelAvailability = await beds24Client.getAvailability(checkin, checkout);\n\n  // Map to ARI response format\n  const rooms = ROOM_TYPES.map((room) => {\n    const channelRoom = channelAvailability.find((r) => r.roomId === room.id);\n    const availableUnits = channelRoom?.available ?? room.totalUnits;\n    const totalInventory = channelRoom?.total ?? room.totalUnits;\n\n    return {\n      room_id: room.id,\n      room_name: room.name,\n      description: room.description,\n      max_occupancy: room.maxOccupancy,\n      total_inventory: totalInventory,\n      available_units: Math.max(0, availableUnits),\n      rate: {\n        nightly: room.nightlyRate,\n        total: room.nightlyRate * nights,\n        currency,\n      },\n      amenities: room.amenities,\n    };\n  });\n\n  const response = {\n    property_id: PROPERTY.id,\n    property_name: PROPERTY.name,\n    checkin,\n    checkout,\n    nights,\n    currency,\n    timezone: PROPERTY.timezone,\n    checkin_time: PROPERTY.checkinTime,\n    checkout_time: PROPERTY.checkoutTime,\n    rooms,\n    booking_url: `https://pelangicapsulehostel.com/book?checkin=${checkin}&checkout=${checkout}`,\n    updated_at: new Date().toISOString(),\n  };\n\n  return NextResponse.json(response, {\n    headers: {\n      \"Cache-Control\": \"public, max-age=300, s-maxage=300\",\n    },\n  });\n}\n","numLines":115,"startLine":1,"totalLines":115}}}
