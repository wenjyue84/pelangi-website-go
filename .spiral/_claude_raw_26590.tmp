s\\1-projects\\Software Projects\\pelangi-website\\site\\src\\components\\Rooms.tsx","content":"import Image from \"next/image\";\nimport LangMs from \"@/components/LangMs\";\nimport pasarMalamImage from \"../../public/images/destinations/pasar-malam.jpg\";\nimport { cacheLife, cacheTag } from \"next/cache\";\nimport RoomsTabsClient from \"@/components/RoomsTabsClient\";\n\nexport default async function Rooms() {\n  \"use cache\";\n  cacheLife(\"days\");\n  cacheTag(\"rooms-static\");\n  cacheTag(\"rooms\");\n\n  const hostelHighlights = [\n    {\n      icon: \"M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0\",\n      title: \"Free High-Speed WiFi\",\n      description: \"Stay connected for work or streaming — fast, reliable internet throughout\"\n    },\n    {\n      icon: \"M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z\",\n      title: \"Air-Conditioned\",\n      description: \"Beat Malaysia's tropical heat — powerful AC in all sleeping areas\"\n    },\n    {\n      icon: \"M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z\",\n      title: \"24/7 Access\",\n      description: \"No curfews, no lockouts — your schedule, your freedom\"\n    },\n    {\n      icon: \"M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z\",\n      title: \"24-Hour Laundry\",\n      description: \"In-house RM5 laundry service for guests — cheaper than outside dobi, wash anytime\"\n    },\n    {\n      icon: \"M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z\",\n      title: \"Secure & Safe\",\n      description: \"24/7 CCTV, personal lockers, and secure premises\"\n    },\n    {\n      icon: \"M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4\",\n      title: \"Shared Kitchen\",\n      description: \"Fully equipped kitchen — cook your meals and save money\"\n    },\n  ];\n\n  return (\n    <section id=\"rooms\" className=\"section-padding bg-white dark:bg-stone-900\">\n      <div className=\"container-custom\">\n        {/* Header */}\n        <div className=\"text-center max-w-3xl mx-auto mb-16\">\n          <p className=\"section-label\">Accommodation</p>\n          <h2 className=\"section-heading mb-6\">\n            Your Private Pod Awaits\n          </h2>\n          <p className=\"text-stone-600 dark:text-stone-400 text-lg leading-relaxed\">\n            Experience the perfect blend of privacy and affordability in our Japanese-inspired capsule pods.\n            Each pod is your personal retreat — complete with climate control, adjustable lighting,\n            and everything you need for a restful stay in Johor Bahru.\n          </p>\n        </div>\n\n        {/* Room type tabs — Standard, Premium, Long Stay\n            Uses React 19.2 <Activity> (in RoomsTabsClient) to preserve tab state\n            on the client while SSR-rendering all panels for SEO. */}\n        <div className=\"mb-16\">\n          <RoomsTabsClient />\n        </div>\n\n        {/* Hostel Highlights Grid */}\n        <div className=\"mb-16\">\n          <h3 className=\"font-display text-2xl font-medium text-stone-900 dark:text-stone-100 text-center mb-10\">\n            Everything You Need, Nothing You Don&apos;t\n          </h3>\n          {/* Grid uses viewport breakpoints for column count; each cell is a container\n              so internal card layout adapts to its own available width (container queries) */}\n          <div className=\"grid sm:grid-cols-2 lg:grid-cols-3 gap-6\">\n            {hostelHighlights.map((highlight, index) => (\n              <div key={index} className=\"@container\">\n                <div className=\"bg-stone-50 dark:bg-stone-800 rounded-2xl p-4 @[240px]:p-6 hover:bg-stone-100 dark:hover:bg-stone-700 transition-colors group\">\n                  <div className=\"w-10 h-10 @[240px]:w-12 @[240px]:h-12 rounded-xl bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center mb-3 @[240px]:mb-4 group-hover:bg-amber-200 transition-colors\">\n                    <svg className=\"w-5 h-5 @[240px]:w-6 @[240px]:h-6 text-amber-700 dark:text-amber-400\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                      <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={1.5} d={highlight.icon} />\n                    </svg>\n                  </div>\n                  <h4 className=\"font-semibold text-stone-900 dark:text-stone-100 mb-2 text-sm @[240px]:text-base\">{highlight.title}</h4>\n                  <p className=\"text-stone-500 dark:text-stone-400 text-xs @[240px]:text-sm\">{highlight.description}</p>\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n\n        {/* Night Market Feature - Unique Selling Point */}\n        <div className=\"bg-linear-to-br from-amber-50 to-orange-50 dark:from-amber-900/20 dark:to-orange-900/20 rounded-3xl p-8 md:p-12 relative overflow-hidden\">\n          <div className=\"absolute top-0 right-0 w-64 h-64 bg-amber-100 dark:bg-amber-900/30 rounded-full -translate-y-1/2 translate-x-1/2 opacity-50\" />\n          <div className=\"absolute bottom-0 left-0 w-48 h-48 bg-orange-100 dark:bg-orange-900/30 rounded-full translate-y-1/2 -translate-x-1/2 opacity-50\" />\n\n          <div className=\"relative grid md:grid-cols-2 gap-8 items-center\">\n            <div>\n              <div className=\"inline-flex items-center gap-2 px-4 py-2 bg-amber-100 dark:bg-amber-900/30 rounded-full text-amber-800 dark:text-amber-300 text-sm font-medium mb-6\">\n                <svg className=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                  <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2}\n                    d=\"M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z\" />\n                </svg>\n                Local Experience\n              </div>\n              <h3 className=\"font-display text-3xl md:text-4xl font-medium text-stone-900 dark:text-stone-100 mb-4\">\n                Night Market at Your Doorstep\n              </h3>\n              <p className=\"text-lg text-stone-600 dark:text-stone-400 mb-6\">\n                Every <span className=\"font-semibold text-amber-700 dark:text-amber-400\">Tuesday from 4:30 PM</span>,\n                step outside and you&apos;re in the heart of <LangMs>Taman Pelangi</LangMs>&apos;s famous <LangMs>pasar malam</LangMs>.\n              </p>\n              <div className=\"space-y-3 text-stone-600 dark:text-stone-400\">\n                <div className=\"flex items-start gap-3\">\n                  <svg className=\"w-5 h-5 text-amber-600 dark:text-amber-400 shrink-0 mt-0.5\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n                    <path fillRule=\"evenodd\" d=\"M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z\" clipRule=\"evenodd\" />\n                  </svg>\n                  <span><strong>500+ meters</strong> of food stalls right in front of hostel</span>\n                </div>\n                <div className=\"flex items-start gap-3\">\n                  <svg className=\"w-5 h-5 text-amber-600 dark:text-amber-400 shrink-0 mt-0.5\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n                    <path fillRule=\"evenodd\" d=\"M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z\" clipRule=\"evenodd\" />\n                  </svg>\n                  <span><strong>Authentic Malaysian street food</strong> — <LangMs>satay</LangMs>, oyster omelette, claypot rice</span>\n                </div>\n                <div className=\"flex items-start gap-3\">\n                  <svg className=\"w-5 h-5 text-amber-600 dark:text-amber-400 shrink-0 mt-0.5\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n                    <path fillRule=\"evenodd\" d=\"M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z\" clipRule=\"evenodd\" />\n                  </svg>\n                  <span><strong>Local prices</strong> — eat like a local, pay like a local</span>\n                </div>\n              </div>\n              <p className=\"text-sm text-amber-700 dark:text-amber-400 mt-6 font-medium\">\n                Pro tip: Arrive by 4 PM to catch the best selection before the crowds!\n              </p>\n            </div>\n            <div className=\"relative h-64 md:h-80 rounded-2xl overflow-hidden shadow-xl\">\n              <Image\n                src={pasarMalamImage}\n                alt=\"Taman Pelangi Pasar Malam night market with street food stalls near Pelangi Capsule Hostel\"\n                fill\n                sizes=\"(max-width: 768px) 100vw, 50vw\"\n                className=\"object-cover\"\n                placeholder=\"blur\"\n                fetchPriority=\"low\"\n              />\n              <div className=\"absolute inset-0 bg-linear-to-t from-stone-900/60 via-transparent to-transparent\" />\n              <div className=\"absolute bottom-4 left-4 text-white\">\n                <div className=\"text-sm font-medium\"><LangMs>Pasar Malam Taman Pelangi</LangMs></div>\n                <div className=\"text-xs opacity-80\">Every Tuesday, 4:30 PM - 9 PM</div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Why Choose Capsule */}\n        <div className=\"mt-16 text-center max-w-3xl mx-auto\">\n          <h3 className=\"font-display text-2xl font-medium text-stone-900 dark:text-stone-100 mb-6\">\n            Why Choose a Capsule Hostel?\n          </h3>\n          <div className=\"grid sm:grid-cols-2 gap-6 text-left\">\n            <div className=\"flex gap-4\">\n              <div className=\"w-10 h-10 rounded-full bg-green-100 dark:bg-green-900/30 flex items-center justify-center shrink-0\">\n                <svg className=\"w-5 h-5 text-green-600 dark:text-green-400\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                  <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z\" />\n                </svg>\n              </div>\n              <div>\n                <h4 className=\"font-semibold text-stone-900 dark:text-stone-100\">More Privacy Than Dorms</h4>\n                <p className=\"text-sm text-stone-500 dark:text-stone-400\">Your own enclosed space with a door that locks — not just a curtain</p>\n              </div>\n            </div>\n            <div className=\"flex gap-4\">\n              <div className=\"w-10 h-10 rounded-full bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center shrink-0\">\n                <svg className=\"w-5 h-5 text-blue-600 dark:text-blue-400\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                  <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z\" />\n                </svg>\n              </div>\n              <div>\n                <h4 className=\"font-semibold text-stone-900 dark:text-stone-100\">Better Value Than Hotels</h4>\n                <p className=\"text-sm text-stone-500 dark:text-stone-400\">All the essentials for a fraction of the price — spend savings exploring JB</p>\n              </div>\n            </div>\n            <div className=\"flex gap-4\">\n              <div className=\"w-10 h-10 rounded-full bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center shrink-0\">\n                <svg className=\"w-5 h-5 text-purple-600 dark:text-purple-400\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                  <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z\" />\n                </svg>\n              </div>\n              <div>\n                <h4 className=\"font-semibold text-stone-900 dark:text-stone-100\">Tech-Forward Comfort</h4>\n                <p className=\"text-sm text-stone-500 dark:text-stone-400\">Personal lighting, ventilation, and charging ports built-in</p>\n              </div>\n            </div>\n            <div className=\"flex gap-4\">\n              <div className=\"w-10 h-10 rounded-full bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center shrink-0\">\n                <svg className=\"w-5 h-5 text-amber-600 dark:text-amber-400\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                  <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z\" />\n                </svg>\n              </div>\n              <div>\n                <h4 className=\"font-semibold text-stone-900 dark:text-stone-100\">Meet Fellow Travelers</h4>\n                <p className=\"text-sm text-stone-500 dark:text-stone-400\">Shared spaces for socializing, private pods for resting — best of both</p>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n}\n","numLines":213,"startLine":1,"totalLines":213}}}
{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01Vq5FPWtY6SX9tG46wzY4d3","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"Good! I found it. The Rooms component uses `\"use cache\"` directive and has cache tags. However, it doesn't make external API fetches. The comment mentions React 19.2 Activity feature being used in RoomsTabsClient, so this is a React 19.2 aware codebase.\n\nNow let me look at pages that might fetch from external APIs. Let me check the API routes and other parts that might have server-side fetches from external sources.","signature":""}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":5960,"cache_read_input_tokens":81662,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5960},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"a16f91ac-2e27-4e8a-bf46-dfd84cbb51f9","uuid":"5bec9f35-fc55-4c76-9070-90107a5485f8"}
