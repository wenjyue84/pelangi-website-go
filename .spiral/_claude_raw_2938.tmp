{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CuGTpC5UxsRBiHqKdcrYVq","type":"tool_result","content":"site/src:\ndiff --git a/site/src/app/globals.css b/site/src/app/globals.css\nindex 373249e..def5587 100644\n--- a/site/src/app/globals.css\n+++ b/site/src/app/globals.css\n@@ -657,6 +657,79 @@ html.animations-paused *::after {\n   }\n }\n \n+/* ============================================================\n+   Native Popover + CSS Anchor Positioning (US-144)\n+   Uses HTML popover attribute for keyboard/focus management\n+   and CSS anchor-name / position-anchor for tethering.\n+   @supports fallback for browsers without anchor positioning.\n+   Chrome 125+, Edge 125+. Safari/Firefox: absolute fallback.\n+   ============================================================ */\n+.info-popover-anchor {\n+  position: relative;\n+  display: inline-flex;\n+}\n+\n+.info-popover-trigger {\n+  all: unset;\n+  display: inline-flex;\n+  cursor: pointer;\n+}\n+\n+.info-popover {\n+  margin: 0;\n+  border: 1px solid var(--color-stone-200, #e7e5e4);\n+  border-radius: 0.75rem;\n+  padding: 0.5rem 0.75rem;\n+  background: white;\n+  color: var(--color-stone-700, #44403c);\n+  font-size: 0.8125rem;\n+  line-height: 1.4;\n+  max-width: 15rem;\n+  box-shadow: 0 4px 12px rgb(0 0 0 / 0.08);\n+  /* Entry animation */\n+  opacity: 1;\n+  transition: opacity 0.15s ease-out, transform 0.15s ease-out;\n+}\n+\n+.info-popover:not(:popover-open) {\n+  display: none;\n+}\n+\n+/* Anchor positioning (Chrome 125+) */\n+@supports (position-anchor: --x) {\n+  .info-popover {\n+    position: fixed;\n+    position-area: block-end span-inline-end;\n+    margin-top: 0.375rem;\n+  }\n+}\n+\n+/* Fallback for browsers without anchor positioning */\n+@supports not (position-anchor: --x) {\n+  .info-popover {\n+    position: absolute;\n+    top: calc(100% + 0.375rem);\n+    left: 50%;\n+    transform: translateX(-50%);\n+  }\n+}\n+\n+@media (prefers-color-scheme: dark) {\n+  .info-popover {\n+    background: var(--color-stone-800, #292524);\n+    color: var(--color-stone-200, #e7e5e4);\n+    border-color: var(--color-stone-700, #44403c);\n+    box-shadow: 0 4px 12px rgb(0 0 0 / 0.3);\n+  }\n+}\n+\n+/* Forced colors: ensure popover border is visible */\n+@media (forced-colors: active) {\n+  .info-popover {\n+    border: 2px solid CanvasText;\n+  }\n+}\n+\n /* Custom scrollbar */\n ::-webkit-scrollbar {\n   width: 8px;\ndiff --git a/site/src/components/Header.tsx b/site/src/components/Header.tsx\nindex b8c4e0a..daefb2d 100644\n--- a/site/src/components/Header.tsx\n+++ b/site/src/components/Header.tsx\n@@ -7,6 +7,7 @@ import Image from \"next/image\";\n import dynamic from \"next/dynamic\";\n import LanguageSwitcher from \"./LanguageSwitcher\";\n import BookNowCTA from \"./BookNowCTA\";\n+import InfoPopover from \"./InfoPopover\";\n import {\n   SEARCH_ARIA,\n   SEARCH_ARIA_DESKTOP,\n@@ -88,16 +89,22 @@ export default function Header() {\n               {link.label}\n             </Link>\n           ))}\n-          <button\n-            onClick={() => setIsSearchOpen(true)}\n-            className=\"p-2 text-stone-500 hover:text-stone-900 hover:bg-stone-100 rounded-full transition-colors dark:text-stone-400 dark:hover:text-stone-100 dark:hover:bg-stone-800\"\n-            aria-label={SEARCH_ARIA_DESKTOP}\n-            title=\"Search (Ctrl+K)\"\n+          <InfoPopover\n+            content=\"Search (Ctrl+K)\"\n+            ariaLabel={SEARCH_ARIA_DESKTOP}\n           >\n-            <svg className=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n-              <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={1.5} d=\"M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z\" />\n-            </svg>\n-          </button>\n+            <span\n+              role=\"button\"\n+              tabIndex={0}\n+              onClick={() => setIsSearchOpen(true)}\n+              onKeyDown={(e) => { if (e.key === \"Enter\" || e.ke