{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LkXGjyZXa5uVU6TnPrrqea","type":"tool_result","content":"1\t\"use client\";\n2\t\n3\timport type { Route } from \"next\";\n4\timport { useState, useEffect, useCallback } from \"react\";\n5\timport Link from \"next/link\";\n6\timport Image from \"next/image\";\n7\timport dynamic from \"next/dynamic\";\n8\timport LanguageSwitcher from \"./LanguageSwitcher\";\n9\timport BookNowCTA from \"./BookNowCTA\";\n10\timport {\n11\t  SEARCH_ARIA,\n12\t  SEARCH_ARIA_DESKTOP,\n13\t} from \"@/lib/ui-labels\";\n14\t\n15\tfunction pushNavEvent(href: string) {\n16\t  if (typeof window === \"undefined\") return;\n17\t  const w = window as unknown as { dataLayer: Record<string, unknown>[] };\n18\t  w.dataLayer = w.dataLayer || [];\n19\t  w.dataLayer.push({ event: \"nav_click\", nav_href: href });\n20\t}\n21\t\n22\tconst SearchDialog = dynamic(() => import(\"./SearchDialog\"), { ssr: false });\n23\t\n24\texport default function Header() {\n25\t  const [isMenuOpen, setIsMenuOpen] = useState(false);\n26\t  const [isSearchOpen, setIsSearchOpen] = useState(false);\n27\t\n28\t  const closeSearch = useCallback(() => setIsSearchOpen(false), []);\n29\t\n30\t  // Cmd/Ctrl+K keyboard shortcut + Escape to close mobile nav\n31\t  useEffect(() => {\n32\t    function handleKeyDown(e: KeyboardEvent) {\n33\t      if ((e.metaKey || e.ctrlKey) && e.key === \"k\") {\n34\t        e.preventDefault();\n35\t        setIsSearchOpen((prev) => !prev);\n36\t      }\n37\t      if (e.key === \"Escape\" && isMenuOpen) {\n38\t        setIsMenuOpen(false);\n39\t      }\n40\t    }\n41\t    document.addEventListener(\"keydown\", handleKeyDown);\n42\t    return () => document.removeEventListener(\"keydown\", handleKeyDown);\n43\t  }, [isMenuOpen]);\n44\t\n45\t  const navLinks = [\n46\t    { href: \"/about\", label: \"About\" },\n47\t    { href: \"/rooms\", label: \"Rooms\" },\n48\t    { href: \"/#destinations\", label: \"Destinations\" },\n49\t    { href: \"/gallery\", label: \"Gallery\" },\n50\t    { href: \"/#community\", label: \"Community\" },\n51\t    { href: \"/contact\", label: \"Location\" },\n52\t    { href: \"/check-in\", label: \"Check-in Guide\" },\n53\t  ];\n54\t\n55\t  return (\n56\t    <header className=\"fixed top-0 left-0 right-0 z-50 transition-all duration-500 bg-white/95 backdrop-blur-md shadow-xs py-3 dark:bg-stone-900/95 dark:shadow-stone-950/50\">\n57\t      <nav className=\"container-custom flex items-center justify-between px-6 md:px-8\">\n58\t        {/* Logo */}\n59\t        <Link href=\"/\" className=\"flex items-center gap-3 group\">\n60\t          <div className=\"relative w-10 h-10\">\n61\t            <Image\n62\t              src=\"/images/logo.png\"\n63\t              alt=\"Pelangi Capsule Hostel Logo - Budget accommodation in Johor Bahru\"\n64\t              fill\n65\t              sizes=\"40px\"\n66\t              className=\"object-contain\"\n67\t            />\n68\t          </div>\n69\t          <div className=\"flex flex-col\">\n70\t            <span className=\"font-display text-xl font-medium tracking-tight transition-colors duration-300 text-stone-900 dark:text-stone-100\">\n71\t              Pelangi\n72\t            </span>\n73\t            <span className=\"text-[10px] font-medium tracking-widest uppercase transition-colors duration-300 text-stone-500 dark:text-stone-400\">\n74\t              Capsule Hostel\n75\t            </span>\n76\t          </div>\n77\t        </Link>\n78\t\n79\t        {/* Desktop Navigation */}\n80\t        <div className=\"hidden md:flex items-center gap-1\">\n81\t          {navLinks.map((link) => (\n82\t            <Link\n83\t              key={link.href}\n84\t              href={link.href as Route}\n85\t              className=\"px-4 py-2 text-sm font-medium transition-all duration-300 rounded-full text-stone-600 hover:text-stone-900 hover:bg-stone-100 dark:text-stone-400 dark:hover:text-stone-100 dark:hover:bg-stone-800\"\n86\t              onNavigate={() => pushNavEvent(link.href)}\n87\t            >\n88\t              {link.label}\n89\t            </Link>\n90\t          ))}\n91\t          <button\n92\t            onClick={() => setIsSearchOpen(true)}\n93\t            className=\"p-2 text-stone-500 hover:text-stone-900 hover:bg-stone-100 rounded-full transition-colors dark:text-stone-400 dark:hover:text-stone-100 dark:hover:bg-stone-800\"\n94\t            aria-label={SEARCH_ARIA_DESKTOP}\n95\t          >\n96\t            <svg className=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n97\t              <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={1.5} d=\"M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z\" />\n98\t            </svg>\n99\t          </button>\n100\t          <LanguageSwitcher />\n101\t          <BookNowCTA className=\"ml-4 px-6 py-2.5 text-sm font-medium rounded-full transition-all duration-300 bg-amber-700 text-white hover:bg-amber-800\" />\n102\t        </div>\n103\t\n104\t        {/* Mobile Search + Menu Buttons */}\n105\t        <div className=\"flex items-center gap-1 md:hidden\">\n106\t          <button\n107\t            className=\"p-2 rounded-full transition-colors duration-300 text-stone-700 hover:bg-stone-100 dark:text-stone-300 dark:hover:bg-stone-800\"\n108\t            onClick={() => setIsSearchOpen(true)}\n109\t            aria-label={SEARCH_ARIA}\n110\t>\n111\t            <svg className=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n112\t              <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={1.5} d=\"M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z\" />\n113\t            </svg>\n114\t          </button>\n115\t          <button\n116\t            className=\"p-2 rounded-full transition-colors duration-300 text-stone-700 hover:bg-stone-100 dark:text-stone-300 dark:hover:bg-stone-800\"\n117\t            onClick={() => setIsMenuOpen(!isMenuOpen)}\n118\t            aria-label={isMenuOpen ? \"Close menu\" : \"Open menu\"}\n119\t            aria-expanded={isMenuOpen}\n120\t          >\n121\t            <svg className=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n122\t              {isMenuOpen ? (\n123\t                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={1.5} d=\"M6 18L18 6M6 6l12 12\" />\n124\t              ) : (\n125\t                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={1.5} d=\"M4 6h16M4 12h16M4 18h16\" />\n126\t              )}\n127\t            </svg>\n128\t          </button>\n129\t        </div>\n130\t\n131\t        {/* Mobile Navigation */}\n132\t        <div\n133\t          className={`absolute top-full left-4 right-4 mt-2 bg-white rounded-2xl shadow-xl md:hidden dark:bg-stone-800 dark:shadow-stone-950/50\n134\t                     overflow-hidden transition-all duration-300 ${isMenuOpen ? \"opacity-100 translate-y-0\" : \"opacity-0 -translate-y-4 pointer-events-none\"\n135\t            }`}\n136\t        >\n137\t          <div className=\"py-4\">\n138\t            {navLinks.map((link) => (\n139\t              <Link\n140\t                key={link.href}\n141\t                href={link.href as Route}\n142\t                className=\"block px-6 py-3 text-stone-700 hover:bg-stone-50 hover:text-stone-900 transition-colors dark:text-stone-300 dark:hover:bg-stone-700 dark:hover:text-stone-100\"\n143\t                onClick={() => setIsMenuOpen(false)}\n144\t                onNavigate={() => pushNavEvent(link.href)}\n145\t              >\n146\t                {link.label}\n147\t              </Link>\n148\t            ))}\n149\t            <div className=\"px-6 py-3 border-t border-stone-100 mt-2 dark:border-stone-700\">\n150\t              <div className=\"flex items-center justify-center mb-4\">\n151\t                <LanguageSwitcher />\n152\t              </div>\n153\t              <BookNowCTA\n154\t                className=\"block w-full text-center bg-amber-700 text-white py-3 rounded-xl font-medium hover:bg-amber-800 transition-colors\"\n155\t                onClick={() => setIsMenuOpen(false)}\n156\t              />\n157\t            </div>\n158\t          </div>\n159\t        </div>\n160\t      </nav>\n161\t      <SearchDialog open={isSearchOpen} onClose={closeSearch} />\n162\t    </header>\n163\t  );\n164\t}\n165\t"}]},"parent_tool_use_id":null,"session_id":"db47caa7-f1dd-496e-b0bd-79b00484628d","uuid":"15f7ba60-53d7-46a1-890c-dc71881a0994","timestamp":"2026-04-14T00:21:38.024Z","tool_use_result":{"type":"text","file":{"filePath":"/c/Users/Jyue/Documents/1-projects/Software Projects/pelangi-website/site/src/components/Header.tsx","content":"\"use client\";\n\nimport type { Route } from \"next\";\nimport { useState, useEffect, useCallback } from \"react\";\nimport Link from \"next/link\";\nimport Image from \"next/image\";\nimport dynamic from \"next/dynamic\";\nimport LanguageSwitcher from \"./LanguageSwitcher\";\nimport BookNowCTA from \"./BookNowCTA\";\nimport {\n  SEARCH_ARIA,\n  SEARCH_ARIA_DESKTOP,\n} from \"@/lib/ui-labels\";\n\nfunction pushNavEvent(href: string) {\n  if (typeof window === \"undefined\") return;\n  const w = window as unknown as { dataLayer: Record<string, unknown>[] };\n  w.dataLayer = w.dataLayer || [];\n  w.dataLayer.push({ event: \"nav_click\", nav_href: href });\n}\n\nconst SearchDialog = dynamic(() => import(\"./SearchDialog\"), { ssr: false });\n\nexport default function Header() {\n  const [isMenuOpen, setIsMenuOpen] = useState(false);\n  const [isSearchOpen, setIsSearchOpen] = useState(false);\n\n  const closeSearch = useCallback(() => setIsSearchOpen(false), []);\n\n  // Cmd/Ctrl+K keyboard shortcut + Escape to close mobile nav\n  useEffect(() => {\n    function handleKeyDown(e: KeyboardEvent) {\n      if ((e.metaKey || e.ctrlKey) && e.key === \"k\") {\n        e.preventDefault();\n        setIsSearchOpen((prev) => !prev);\n      }\n      if (e.key === \"Escape\" && isMenuOpen) {\n        setIsMenuOpen(false);\n      }\n    }\n    document.addEventListener(\"keydown\", handleKeyDown);\n    return () => document.removeEventListener(\"keydown\", handleKeyDown);\n  }, [isMenuOpen]);\n\n  const navLinks = [\n    { href: \"/about\", label: \"About\" },\n    { href: \"/rooms\", label: \"Rooms\" },\n    { href: \"/#destinations\", label: \"Destinations\" },\n    { href: \"/gallery\", label: \"Gallery\" },\n    { href: \"/#community\", label: \"Community\" },\n    { href: \"/contact\", label: \"Location\" },\n    { href: \"/check-in\", label: \"Check-in Guide\" },\n  ];\n\n  return (\n    <header className=\"fixed top-0 left-0 right-0 z-50 transition-all duration-500 bg-white/95 backdrop-blur-md shadow-xs py-3 dark:bg-stone-900/95 dark:shadow-stone-950/50\">\n      <nav className=\"container-custom flex items-center justify-between px-6 md:px-8\">\n        {/* Logo */}\n        <Link href=\"/\" className=\"flex items-center gap-3 group\">\n          <div className=\"relative w-10 h-10\">\n            <Image\n              src=\"/images/logo.png\"\n              alt=\"Pelangi Capsule Hostel Logo - Budget accommodation in Johor Bahru\"\n              fill\n              sizes=\"40px\"\n              className=\"object-contain\"\n            />\n          </div>\n          <div className=\"flex flex-col\">\n            <span className=\"font-display text-xl font-medium tracking-tight transition-colors duration-300 text-stone-900 dark:text-stone-100\">\n              Pelangi\n            </span>\n            <span className=\"text-[10px] font-medium tracking-widest uppercase transition-colors duration-300 text-stone-500 dark:text-stone-400\">\n              Capsule Hostel\n            </span>\n          </div>\n        </Link>\n\n        {/* Desktop Navigation */}\n        <div className=\"hidden md:flex items-center gap-1\">\n          {navLinks.map((link) => (\n            <Link\n              key={link.href}\n              href={link.href as Route}\n              className=\"px-4 py-2 text-sm font-medium transition-all duration-300 rounded-full text-stone-600 hover:text-stone-900 hover:bg-stone-100 dark:text-stone-400 dark:hover:text-stone-100 dark:hover:bg-stone-800\"\n              onNavigate={() => pushNavEvent(link.href)}\n            >\n              {link.label}\n            </Link>\n          ))}\n          <button\n            onClick={() => setIsSearchOpen(true)}\n            className=\"p-2 text-stone-500 hover:text-stone-900 hover:bg-stone-100 rounded-full transition-colors dark:text-stone-400 dark:hover:text-stone-100 dark:hover:bg-stone-800\"\n            aria-label={SEARCH_ARIA_DESKTOP}\n          >\n            <svg className=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={1.5} d=\"M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z\" />\n            </svg>\n          </button>\n          <LanguageSwitcher />\n          <BookNowCTA className=\"ml-4 px-6 py-2.5 text-sm font-medium rounded-full transition-all duration-300 bg-amber-700 text-white hover:bg-amber-800\" />\n        </div>\n\n        {/* Mobile Search + Menu Buttons */}\n        <div className=\"flex items-center gap-1 md:hidden\">\n          <button\n            className=\"p-2 rounded-full transition-colors duration-300 text-stone-700 hover:bg-stone-100 dark:text-stone-300 dark:hover:bg-stone-800\"\n            onClick={() => setIsSearchOpen(true)}\n            aria-label={SEARCH_ARIA}\n>\n            <svg className=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={1.5} d=\"M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z\" />\n            </svg>\n          </button>\n          <button\n            className=\"p-2 rounded-full transition-colors duration-300 text-stone-700 hover:bg-stone-100 dark:text-stone-300 dark:hover:bg-stone-800\"\n            onClick={() => setIsMenuOpen(!isMenuOpen)}\n            aria-label={isMenuOpen ? \"Close menu\" : \"Open menu\"}\n            aria-expanded={isMenuOpen}\n          >\n            <svg className=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              {isMenuOpen ? (\n                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={1.5} d=\"M6 18L18 6M6 6l12 12\" />\n              ) : (\n                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={1.5} d=\"M4 6h16M4 12h16M4 18h16\" />\n              )}\n            </svg>\n          </button>\n        </div>\n\n        {/* Mobile Navigation */}\n        <div\n          className={`absolute top-full left-4 right-4 mt-2 bg-white rounded-2xl shadow-xl md:hidden dark:bg-stone-800 dark:shadow-stone-950/50\n                     overflow-hidden transition-all duration-300 ${isMenuOpen ? \"opacity-100 translate-y-0\" : \"opacity-0 -translate-y-4 pointer-events-none\"\n            }`}\n        >\n          <div className=\"py-4\">\n            {navLinks.map((link) => (\n              <Link\n                key={link.href}\n                href={link.href as Route}\n                className=\"block px-6 py-3 text-stone-700 hover:bg-stone-50 hover:text-stone-900 transition-colors dark:text-stone-300 dark:hover:bg-stone-700 dark:hover:text-stone-100\"\n                onClick={() => setIsMenuOpen(false)}\n                onNavigate={() => pushNavEvent(link.href)}\n              >\n                {link.label}\n              </Link>\n            ))}\n            <div className=\"px-6 py-3 border-t border-stone-100 mt-2 dark:border-stone-700\">\n              <div className=\"flex items-center justify-center mb-4\">\n                <LanguageSwitcher />\n              </div>\n              <BookNowCTA\n                className=\"block w-full text-center bg-amber-700 text-white py-3 rounded-xl font-medium hover:bg-amber-800 transition-colors\"\n                onClick={() => setIsMenuOpen(false)}\n              />\n            </div>\n          </div>\n        </div>\n      </nav>\n      <SearchDialog open={isSearchOpen} onClose={closeSearch} />\n    </header>\n  );\n}\n","numLines":165,"startLine":1,"totalLines":165}}}
