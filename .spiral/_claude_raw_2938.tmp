{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012MuaeWsDVHDs7uyy1ja4J1","type":"tool_result","content":"1\t\"use client\";\n2\t\n3\timport { useEffect, useRef } from \"react\";\n4\t\n5\tfunction pushEvent(eventName: string, params: Record<string, string>) {\n6\t  if (typeof window === \"undefined\") return;\n7\t  const w = window as unknown as { dataLayer: Record<string, unknown>[] };\n8\t  w.dataLayer = w.dataLayer || [];\n9\t  w.dataLayer.push({ event: eventName, ...params });\n10\t}\n11\t\n12\texport default function HeroTrustBadges() {\n13\t  const ref = useRef<HTMLDivElement>(null);\n14\t  const tracked = useRef(false);\n15\t\n16\t  // Track impression when badges enter viewport\n17\t  useEffect(() => {\n18\t    const el = ref.current;\n19\t    if (!el || tracked.current) return;\n20\t    const observer = new IntersectionObserver(\n21\t      ([entry]) => {\n22\t        if (entry.isIntersecting && !tracked.current) {\n23\t          tracked.current = true;\n24\t          pushEvent(\"trust_badges_impression\", {\n25\t            badge_location: \"book_hero\",\n26\t          });\n27\t          observer.disconnect();\n28\t        }\n29\t      },\n30\t      { threshold: 0.5 }\n31\t    );\n32\t    observer.observe(el);\n33\t    return () => observer.disconnect();\n34\t  }, []);\n35\t\n36\t  function handleBadgeClick(badgeName: string) {\n37\t    pushEvent(\"trust_badge_click\", {\n38\t      badge_name: badgeName,\n39\t      badge_location: \"book_hero\",\n40\t    });\n41\t  }\n42\t\n43\t  return (\n44\t    <div ref={ref} className=\"mt-6 space-y-4\">\n45\t      {/* Trust badges row */}\n46\t      <div className=\"flex flex-wrap justify-center gap-2\">\n47\t        <button\n48\t          type=\"button\"\n49\t          onClick={() => handleBadgeClick(\"booking_rating\")}\n50\t          className=\"inline-flex items-center gap-1.5 bg-white/15 backdrop-blur-sm rounded-full px-3 py-1.5 text-xs text-white/90 border border-white/20 hover:bg-white/25 transition-colors cursor-default\"\n51\t          aria-label=\"Rated 8.4 out of 10 on Booking.com\"\n52\t        >\n53\t          <svg className=\"w-3.5 h-3.5 text-yellow-300\" fill=\"currentColor\" viewBox=\"0 0 20 20\" aria-hidden=\"true\">\n54\t            <path d=\"M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z\" />\n55\t          </svg>\n56\t          <span><strong>8.4</strong>/10 Booking.com</span>\n57\t        </button>\n58\t\n59\t        <button\n60\t          type=\"button\"\n61\t          onClick={() => handleBadgeClick(\"guests_hosted\")}\n62\t          className=\"inline-flex items-center gap-1.5 bg-white/15 backdrop-blur-sm rounded-full px-3 py-1.5 text-xs text-white/90 border border-white/20 hover:bg-white/25 transition-colors cursor-default\"\n63\t          aria-label=\"Over 500 guests hosted since 2013\"\n64\t        >\n65\t          <svg className=\"w-3.5 h-3.5 text-green-300\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n66\t            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z\" />\n67\t          </svg>\n68\t          <span><strong>500+</strong> guests hosted</span>\n69\t        </button>\n70\t\n71\t        <button\n72\t          type=\"button\"\n73\t          onClick={() => handleBadgeClick(\"best_price\")}\n74\t          className=\"inline-flex items-center gap-1.5 bg-white/15 backdrop-blur-sm rounded-full px-3 py-1.5 text-xs text-white/90 border border-white/20 hover:bg-white/25 transition-colors cursor-default\"\n75\t          aria-label=\"Best price guaranteed when booking direct\"\n76\t        >\n77\t          <svg className=\"w-3.5 h-3.5 text-amber-300\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n78\t            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z\" />\n79\t          </svg>\n80\t          <span><strong>Best Price</strong> Guarantee</span>\n81\t        </button>\n82\t      </div>\n83\t\n84\t      {/* Compact price comparison */}\n85\t      <div className=\"flex items-center justify-center gap-3 text-xs text-white/80\">\n86\t        <span className=\"flex items-center gap-1\">\n87\t          <span className=\"font-semibold text-white\">From RM35</span>/night direct\n88\t        </span>\n89\t        <span className=\"text-white/40\">|</span>\n90\t        <span className=\"flex items-center gap-1\">\n91\t          <span className=\"line-through text-white/50\">RM56+</span>\n92\t          <span>on OTAs</span>\n93\t        </span>\n94\t        <span className=\"text-white/40\">|</span>\n95\t        <span className=\"text-green-300 font-semibold\">Save up to RM13</span>\n96\t      </div>\n97\t    </div>\n98\t  );\n99\t}\n100\t"}]},"parent_tool_use_id":null,"session_id":"db47caa7-f1dd-496e-b0bd-79b00484628d","uuid":"2955e0e4-92a7-40b4-a733-6197811ad7b4","timestamp":"2026-04-14T00:12:06.247Z","tool_use_result":{"type":"text","file":{"filePath":"/c/Users/Jyue/Documents/1-projects/Software Projects/pelangi-website/site/src/components/HeroTrustBadges.tsx","content":"\"use client\";\n\nimport { useEffect, useRef } from \"react\";\n\nfunction pushEvent(eventName: string, params: Record<string, string>) {\n  if (typeof window === \"undefined\") return;\n  const w = window as unknown as { dataLayer: Record<string, unknown>[] };\n  w.dataLayer = w.dataLayer || [];\n  w.dataLayer.push({ event: eventName, ...params });\n}\n\nexport default function HeroTrustBadges() {\n  const ref = useRef<HTMLDivElement>(null);\n  const tracked = useRef(false);\n\n  // Track impression when badges enter viewport\n  useEffect(() => {\n    const el = ref.current;\n    if (!el || tracked.current) return;\n    const observer = new IntersectionObserver(\n      ([entry]) => {\n        if (entry.isIntersecting && !tracked.current) {\n          tracked.current = true;\n          pushEvent(\"trust_badges_impression\", {\n            badge_location: \"book_hero\",\n          });\n          observer.disconnect();\n        }\n      },\n      { threshold: 0.5 }\n    );\n    observer.observe(el);\n    return () => observer.disconnect();\n  }, []);\n\n  function handleBadgeClick(badgeName: string) {\n    pushEvent(\"trust_badge_click\", {\n      badge_name: badgeName,\n      badge_location: \"book_hero\",\n    });\n  }\n\n  return (\n    <div ref={ref} className=\"mt-6 space-y-4\">\n      {/* Trust badges row */}\n      <div className=\"flex flex-wrap justify-center gap-2\">\n        <button\n          type=\"button\"\n          onClick={() => handleBadgeClick(\"booking_rating\")}\n          className=\"inline-flex items-center gap-1.5 bg-white/15 backdrop-blur-sm rounded-full px-3 py-1.5 text-xs text-white/90 border border-white/20 hover:bg-white/25 transition-colors cursor-default\"\n          aria-label=\"Rated 8.4 out of 10 on Booking.com\"\n        >\n          <svg className=\"w-3.5 h-3.5 text-yellow-300\" fill=\"currentColor\" viewBox=\"0 0 20 20\" aria-hidden=\"true\">\n            <path d=\"M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z\" />\n          </svg>\n          <span><strong>8.4</strong>/10 Booking.com</span>\n        </button>\n\n        <button\n          type=\"button\"\n          onClick={() => handleBadgeClick(\"guests_hosted\")}\n          className=\"inline-flex items-center gap-1.5 bg-white/15 backdrop-blur-sm rounded-full px-3 py-1.5 text-xs text-white/90 border border-white/20 hover:bg-white/25 transition-colors cursor-default\"\n          aria-label=\"Over 500 guests hosted since 2013\"\n        >\n          <svg className=\"w-3.5 h-3.5 text-green-300\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z\" />\n          </svg>\n          <span><strong>500+</strong> guests hosted</span>\n        </button>\n\n        <button\n          type=\"button\"\n          onClick={() => handleBadgeClick(\"best_price\")}\n          className=\"inline-flex items-center gap-1.5 bg-white/15 backdrop-blur-sm rounded-full px-3 py-1.5 text-xs text-white/90 border border-white/20 hover:bg-white/25 transition-colors cursor-default\"\n          aria-label=\"Best price guaranteed when booking direct\"\n        >\n          <svg className=\"w-3.5 h-3.5 text-amber-300\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z\" />\n          </svg>\n          <span><strong>Best Price</strong> Guarantee</span>\n        </button>\n      </div>\n\n      {/* Compact price comparison */}\n      <div className=\"flex items-center justify-center gap-3 text-xs text-white/80\">\n        <span className=\"flex items-center gap-1\">\n          <span className=\"font-semibold text-white\">From RM35</span>/night direct\n        </span>\n        <span className=\"text-white/40\">|</span>\n        <span className=\"flex items-center gap-1\">\n          <span className=\"line-through text-white/50\">RM56+</span>\n          <span>on OTAs</span>\n        </span>\n        <span className=\"text-white/40\">|</span>\n        <span className=\"text-green-300 font-semibold\">Save up to RM13</span>\n      </div>\n    </div>\n  );\n}\n","numLines":100,"startLine":1,"totalLines":100}}}
{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01JsbLTS6HAHaLNnQkncHqPh","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01FDDZYekvyNt9sveaZ5c2SA","name":"Read","input":{"file_path":"/c/Users/Jyue/Documents/1-projects/Software Projects/pelangi-website/site/src/app/globals.css"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":3056,"cache_read_input_tokens":47082,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3056},"output_tokens":38,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"db47caa7-f1dd-496e-b0bd-79b00484628d","uuid":"2d5d6db4-d11d-409c-9036-4deab2ba2095"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FDDZYekvyNt9sveaZ5c2SA","type":"tool_result","content":"1\t@import 'tailwindcss';\n2\t\n3\t@plugin \"@tailwindcss/typography\";\n4\t\n5\t/* ============================================================\n6\t   CSS @property — Type-safe, animatable design tokens (US-233)\n7\t   Registered custom properties can be interpolated by the browser\n8\t   because their syntax is known (angle, percentage, etc.).\n9\t   Browsers without @property support treat these as untyped\n10\t   custom properties — static fallback values still render correctly,\n11\t   only the animation is lost (progressive enhancement).\n12\t   Chrome 85+, Firefox 128+, Safari 17.2+.\n13\t   ============================================================ */\n14\t@property --gradient-angle {\n15\t  syntax: \"<angle>\";\n16\t  inherits: false;\n17\t  initial-value: 135deg;\n18\t}\n19\t\n20\t@property --divider-progress {\n21\t  syntax: \"<percentage>\";\n22\t  inherits: false;\n23\t  initial-value: 50%;\n24\t}\n25\t\n26\t@theme {\n27\t  --color-primary-50: #faf8f5;\n28\t  --color-primary-100: #f5f0e8;\n29\t  --color-primary-200: #e8ddd0;\n30\t  --color-primary-300: #d4c4ad;\n31\t  --color-primary-400: #bda685;\n32\t  --color-primary-500: #a68b64;\n33\t  --color-primary-600: #8b7355;\n34\t  --color-primary-700: #715d47;\n35\t  --color-primary-800: #5c4c3c;\n36\t  --color-primary-900: #4a3f33;\n37\t\n38\t  --color-accent-50: #fdf8f6;\n39\t  --color-accent-100: #f9ede8;\n40\t  --color-accent-200: #f4dcd3;\n41\t  --color-accent-300: #ecc4b5;\n42\t  --color-accent-400: #e0a48d;\n43\t  --color-accent-500: #d4846a;\n44\t  --color-accent-600: #c26a4f;\n45\t  --color-accent-700: #a25540;\n46\t  --color-accent-800: #864738;\n47\t  --color-accent-900: #6e3d31;\n48\t\n49\t  --color-sand-50: #fafaf9;\n50\t  --color-sand-100: #f5f5f4;\n51\t  --color-sand-200: #e7e5e4;\n52\t  --color-sand-300: #d6d3d1;\n53\t  --color-sand-400: #a8a29e;\n54\t  --color-sand-500: #78716c;\n55\t  --color-sand-600: #57534e;\n56\t  --color-sand-700: #44403c;\n57\t  --color-sand-800: #292524;\n58\t  --color-sand-900: #1c1917;\n59\t\n60\t  --font-sans: var(--font-inter), system-ui, sans-serif;\n61\t  --font-display: var(--font-playfair), Georgia, serif;\n62\t\n63\t  --text-2xs: 0.65rem;\n64\t  --text-2xs--line-height: 1rem;\n65\t\n66\t  --tracking-widest: 0.2em;\n67\t\n68\t  --animate-fade-in: fadeIn 0.6s ease-out forwards;\n69\t  --animate-slide-up: slideUp 0.6s ease-out forwards;\n70\t  --animate-scale-in: scaleIn 0.4s ease-out forwards;\n71\t\n72\t  --background-image-gradient-radial: radial-gradient(var(--tw-gradient-stops));\n73\t  --background-image-noise: url('/images/noise.png');\n74\t\n75\t  @keyframes fadeIn {\n76\t    0% {\n77\t      opacity: 0;\n78\t    }\n79\t    100% {\n80\t      opacity: 1;\n81\t    }\n82\t  }\n83\t  @keyframes slideUp {\n84\t    0% {\n85\t      opacity: 0;\n86\t      transform: translateY(20px);\n87\t    }\n88\t    100% {\n89\t      opacity: 1;\n90\t      transform: translateY(0);\n91\t    }\n92\t  }\n93\t  @keyframes scaleIn {\n94\t    0% {\n95\t      opacity: 0;\n96\t      transform: scale(0.95);\n97\t    }\n98\t    100% {\n99\t      opacity: 1;\n100\t      transform: scale(1);\n101\t    }\n102\t  }\n103\t}\n104\t\n105\t/*\n106\t  The default border color has changed to `currentcolor` in Tailwind CSS v4,\n107\t  so we've added these compatibility styles to make sure everything still\n108\t  looks the same as it did with Tailwind CSS v3.\n109\t\n110\t  If we ever want to remove these styles, we need to add an explicit border\n111\t  color utility to any element that depends on these defaults.\n112\t*/\n113\t@layer base {\n114\t  *,\n115\t  ::after,\n116\t  ::before,\n117\t  ::backdrop,\n118\t  ::file-selector-button {\n119\t    border-color: var(--color-gray-200, currentcolor);\n120\t  }\n121\t}\n122\t\n123\t@utility btn-primary {\n124\t  /* Primary Button - Warm, sophisticated */\n125\t  @apply bg-stone-700 hover:bg-stone-800 text-white font-medium\n126\t           py-3.5 px-8 rounded-full transition-all duration-300\n127\t           shadow-xs hover:shadow-md cursor-pointer\n128\t           tracking-wide text-sm uppercase\n129\t           focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700\n130\t           dark:bg-stone-200 dark:text-stone-900 dark:hover:bg-stone-100\n131\t           dark:focus-visible:outline-amber-400;\n132\t}\n133\t\n134\t@utility btn-secondary {\n135\t  /* Secondary Button - Minimal outline */\n136\t  @apply bg-transparent hover:bg-stone-100 text-stone-700\n137\t           font-medium py-3.5 px-8 rounded-full\n138\t           border border-stone-500 hover:border-stone-600\n139\t           transition-all duration-300 cursor-pointer\n140\t           tracking-wide text-sm uppercase\n141\t           focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700\n142\t           dark:text-stone-300 dark:border-stone-600 dark:hover:bg-stone-800 dark:hover:border-stone-500\n143\t           dark:focus-visible:outline-amber-400;\n144\t}\n145\t\n146\t@utility section-padding {\n147\t  /* Section spacing - More breathing room */\n148\t  @apply py-20 md:py-28 lg:py-32 px-6 md:px-8;\n149\t}\n150\t\n151\t@utility container-custom {\n152\t  /* Container */\n153\t  @apply max-w-6xl mx-auto;\n154\t}\n155\t\n156\t@utility section-label {\n157\t  /* Section label - Elegant uppercase */\n158\t  @apply text-xs font-medium tracking-widest uppercase text-amber-700 mb-4 dark:text-amber-400;\n159\t}\n160\t\n161\t@utility section-heading {\n162\t  /* Section heading - Serif display font (uses theme --font-display for next/font metric-adjusted fallback) */\n163\t  @apply text-3xl md:text-4xl lg:text-5xl font-medium text-stone-900\n164\t           leading-tight tracking-tight dark:text-stone-100;\n165\t  font-family: var(--font-display);\n166\t}\n167\t\n168\t@utility body-text {\n169\t  /* Body text */\n170\t  @apply text-stone-600 leading-relaxed dark:text-stone-400;\n171\t}\n172\t\n173\t@utility card {\n174\t  /* Card with subtle hover */\n175\t  @apply bg-white rounded-2xl p-6 md:p-8\n176\t           shadow-xs hover:shadow-md transition-shadow duration-300\n177\t           border border-stone-100\n178\t           dark:bg-stone-800 dark:border-stone-700;\n179\t}\n180\t\n181\t@utility image-frame {\n182\t  /* Image container with elegant corners */\n183\t  @apply rounded-2xl overflow-hidden shadow-lg;\n184\t}\n185\t\n186\t@utility divider {\n187\t  /* Divider — uses @property --divider-progress for animatable gradient midpoint */\n188\t  height: 1px;\n189\t  background: linear-gradient(\n190\t    to right,\n191\t    transparent,\n192\t    var(--color-stone-200, #e7e5e4) var(--divider-progress, 50%),\n193\t    transparent\n194\t  );\n195\t}\n196\t\n197\t@media (prefers-color-scheme: dark) {\n198\t  .divider {\n199\t    background: linear-gradient(\n200\t      to right,\n201\t      transparent,\n202\t      var(--color-stone-700, #44403c) var(--divider-progress, 50%),\n203\t      transparent\n204\t    );\n205\t  }\n206\t}\n207\t\n208\t@utility icon-box {\n209\t  /* Feature icon container */\n210\t  @apply w-12 h-12 rounded-xl bg-amber-50 flex items-center justify-center\n211\t           text-amber-700 dark:bg-amber-900/30 dark:text-amber-400;\n212\t}\n213\t\n214\t@utility font-display {\n215\t  /* Display font utility — uses theme variable for next/font metric-adjusted fallback */\n216\t  font-family: var(--font-display);\n217\t}\n218\t\n219\t@utility text-gradient {\n220\t  /* Text gradient — uses @property --gradient-angle for animatable direction */\n221\t  background: linear-gradient(var(--gradient-angle, 135deg), #b45309, #ea580c);\n222\t  -webkit-background-clip: text;\n223\t  -webkit-text-fill-color: transparent;\n224\t  background-clip: text;\n225\t  color: transparent;\n226\t}\n227\t\n228\t@utility text-gradient-shimmer {\n229\t  /* Animated shimmer variant — rotates gradient angle via @property token */\n230\t  background: linear-gradient(var(--gradient-angle, 135deg), #b45309, #ea580c, #b45309);\n231\t  -webkit-background-clip: text;\n232\t  -webkit-text-fill-color: transparent;\n233\t  background-clip: text;\n234\t  color: transparent;\n235\t  animation: gradient-shimmer 4s ease-in-out infinite;\n236\t}\n237\t\n238\t@utility image-zoom {\n239\t  /* Smooth image zoom on hover and focus (WCAG 2.1 SC 1.4.13 parity) */\n240\t  @apply transition-transform duration-700 ease-out;\n241\t\n242\t  .group:hover &,\n243\t  .group:focus-within & {\n244\t    @apply scale-105;\n245\t  }\n246\t}\n247\t\n248\t@utility delay-100 {\n249\t  /* Fade in animation delays */\n250\t  animation-delay: 100ms;\n251\t}\n252\t\n253\t@utility delay-200 {\n254\t  animation-delay: 200ms;\n255\t}\n256\t\n257\t@utility delay-300 {\n258\t  animation-delay: 300ms;\n259\t}\n260\t\n261\t@utility delay-400 {\n262\t  animation-delay: 400ms;\n263\t}\n264\t\n265\t@utility scrollbar-hide {\n266\t  /* Hide scrollbar for horizontal scroll sections */\n267\t  -ms-overflow-style: none;\n268\t  scrollbar-width: none;\n269\t\n270\t  &::-webkit-scrollbar {\n271\t    display: none;\n272\t  }\n273\t}\n274\t\n275\t/* CSS Container Query utilities — US-219\n276\t   @supports guard ensures older browsers without CQ support silently ignore\n277\t   container-type and fall back to Tailwind viewport breakpoints (sm:, md:, lg:).\n278\t   Container query units (cqi, cqw) are used here for adaptive label sizing. */\n279\t@supports (container-type: inline-size) {\n280\t  .card-label-cq {\n281\t    /* cqi = 1% of container inline (width) — scales label relative to card width */\n282\t    font-size: clamp(0.75rem, 4.5cqi, 0.875rem);\n283\t    line-height: 1.4;\n284\t  }\n285\t}\n286\t\n287\t@layer base {\n288\t  html {\n289\t    scroll-behavior: smooth;\n290\t    overflow-x: hidden; /* WCAG 2.2 SC 1.4.4 — prevent horizontal scrollbar at 200% zoom */\n291\t  }\n292\t\n293\t  /* Offset sticky header (64px) when scrolling to heading anchors */\n294\t  h2,\n295\t  h3,\n296\t  section[id] {\n297\t    scroll-margin-top: 5rem; /* 80px = 64px header + 16px breathing room */\n298\t  }\n299\t\n300\t  /* US-204: text-wrap: balance prevents awkward single-word orphans on headings.\n301\t     Progressive enhancement — unsupported browsers silently fall back to default wrap.\n302\t     Chrome 114+, Edge 114+, Firefox 121+, Safari 17.4+ */\n303\t  h1,\n304\t  h2,\n305\t  h3 {\n306\t    text-wrap: balance;\n307\t  }\n308\t\n309\t  /* US-204: text-wrap: pretty reduces orphan words in body paragraphs.\n310\t     Uses a lookahead algorithm to avoid lonely single words on the final line.\n311\t     Progressive enhancement — no visual change in unsupported browsers.\n312\t     Chrome 117+, Edge 117+ */\n313\t  p {\n314\t    text-wrap: pretty;\n315\t  }\n316\t\n317\t  /* WCAG 2.2 SC 2.4.11 — prevent MobileBookingBar from obscuring focused elements */\n318\t  @media (max-width: 767px) {\n319\t    html {\n320\t      scroll-padding-bottom: 4rem; /* matches ~64px MobileBookingBar height */\n321\t    }\n322\t  }\n323\t\n324\t  /* WCAG 2.2 SC 2.5.8 — Target Size Minimum: 24×24 CSS px for all interactive elements */\n325\t  /* Inline text links inside .prose are exempt per the inline-text exception */\n326\t  button,\n327\t  [role=\"button\"] {\n328\t    min-height: 1.5rem; /* 24px */\n329\t    min-width: 1.5rem; /* 24px */\n330\t  }\n331\t\n332\t  /* WCAG 2.2 SC 2.4.13 — Focus Appearance: 2px outline, ≥ 3:1 contrast */\n333\t  /* Uses CSS outline (not box-shadow) for Windows High Contrast Mode visibility */\n334\t  :focus-visible {\n335\t    outline: 2px solid var(--color-amber-700, #b45309);\n336\t    outline-offset: 2px;\n337\t  }\n338\t\n339\t  @media (prefers-color-scheme: dark) {\n340\t    :focus-visible {\n341\t      outline-color: var(--color-amber-400, #fbbf24);\n342\t    }\n343\t  }\n344\t\n345\t  body {\n346\t    @apply antialiased bg-stone-50 text-stone-800 dark:bg-stone-950 dark:text-stone-200;\n347\t    font-feature-settings: \"kern\" 1, \"liga\" 1;\n348\t  }\n349\t\n350\t  /* Elegant selection color */\n351\t  ::selection {\n352\t    background-color: #e8ddd0;\n353\t    color: #4a3f33;\n354\t  }\n355\t\n356\t  @media (prefers-color-scheme: dark) {\n357\t    ::selection {\n358\t      background-color: #5c4c3c;\n359\t      color: #f5f0e8;\n360\t    }\n361\t  }\n362\t}\n363\t\n364\t/* WCAG 2.1 SC 1.4.10 — Reflow: prose tables scroll horizontally instead of breaking page layout */\n365\t.prose table {\n366\t  display: block;\n367\t  overflow-x: auto;\n368\t  -webkit-overflow-scrolling: touch;\n369\t}\n370\t\n371\t/* WCAG 2.3.3 / WCAG 2.2.2 — Respect prefers-reduced-motion OS preference */\n372\t/* Technique C39: https://www.w3.org/WAI/WCAG22/Techniques/css/C39 */\n373\t@media (prefers-reduced-motion: reduce) {\n374\t  *, *::before, *::after {\n375\t    animation-duration: 0.01ms !important;\n376\t    animation-iteration-count: 1 !important;\n377\t    transition-duration: 0.01ms !important;\n378\t    scroll-behavior: auto !important;\n379\t  }\n380\t}\n381\t\n382\t/* ============================================================\n383\t   WCAG 2.1 SC 2.2.2 — In-page pause control\n384\t   Pauses all continuous animations when the user activates the\n385\t   PauseAnimationsButton. This is separate from prefers-reduced-motion\n386\t   which only responds to the OS-level preference.\n387\t   ============================================================ */\n388\thtml.animations-paused *,\n389\thtml.animations-paused *::before,\n390\thtml.animations-paused *::after {\n391\t  animation-play-state: paused !important;\n392\t}\n393\t\n394\t/* ============================================================\n395\t   Forced Colors (Windows High Contrast Mode)\n396\t   Ensures all custom-styled interactive elements remain visible\n397\t   when the OS overrides author colors.\n398\t   ============================================================ */\n399\t@media (forced-colors: active) {\n400\t  /* Primary buttons: add explicit border so they remain distinguishable */\n401\t  .btn-primary {\n402\t    border: 2px solid ButtonText;\n403\t    background: ButtonFace;\n404\t    color: ButtonText;\n405\t    forced-color-adjust: none;\n406\t  }\n407\t\n408\t  .btn-primary:hover {\n409\t    background: Highlight;\n410\t    color: HighlightText;\n411\t    border-color: Highlight;\n412\t  }\n413\t\n414\t  /* Secondary buttons: ensure border stays visible */\n415\t  .btn-secondary {\n416\t    border: 2px solid ButtonText;\n417\t    color: ButtonText;\n418\t  }\n419\t\n420\t  .btn-secondary:hover {\n421\t    background: Highlight;\n422\t    color: HighlightText;\n423\t    border-color: Highlight;\n424\t  }\n425\t\n426\t  /* Cards: ensure visible boundary */\n427\t  .card {\n428\t    border: 1px solid CanvasText;\n429\t  }\n430\t\n431\t  /* Icon boxes: add border for visibility without background */\n432\t  .icon-box {\n433\t    border: 1px solid CanvasText;\n434\t  }\n435\t\n436\t  /* Badges (category pills, status indicators): add border so they don't disappear */\n437\t  [class*=\"rounded-full\"][class*=\"bg-amber\"] {\n438\t    border: 1px solid CanvasText;\n439\t    forced-color-adjust: none;\n440\t  }\n441\t\n442\t  /* Focus indicators: ensure outline uses system highlight color */\n443\t  :focus-visible {\n444\t    outline-color: Highlight;\n445\t  }\n446\t\n447\t  /* Icon-only buttons (close, nav arrows): add border for visibility */\n448\t  button:has(> svg:only-child),\n449\t  [role=\"button\"]:has(> svg:only-child) {\n450\t    border: 1px solid ButtonText;\n451\t  }\n452\t\n453\t  /* Dividers: ensure visible in forced-colors */\n454\t  .divider {\n455\t    background: CanvasText;\n456\t  }\n457\t\n458\t  /* Form inputs and textareas: explicit border */\n459\t  input,\n460\t  textarea,\n461\t  select {\n462\t    border: 1px solid ButtonText;\n463\t  }\n464\t\n465\t  /* Links: use system link color */\n466\t  a {\n467\t    color: LinkText;\n468\t  }\n469\t}\n470\t\n471\t/* ============================================================\n472\t   Increased Contrast (macOS \"Increase contrast\" / Windows)\n473\t   Strengthens borders and text contrast for users who opted in.\n474\t   ============================================================ */\n475\t@media (prefers-contrast: more) {\n476\t  /* Form inputs: thicker, darker borders */\n477\t  input,\n478\t  textarea,\n479\t  select {\n480\t    border-width: 2px;\n481\t    border-color: var(--color-stone-700, #44403c);\n482\t  }\n483\t\n484\t  /* Cards: stronger border for visual separation */\n485\t  .card {\n486\t    border-width: 2px;\n487\t    border-color: var(--color-stone-400, #a8a29e);\n488\t  }\n489\t\n490\t  @media (prefers-color-scheme: dark) {\n491\t    .card {\n492\t      border-color: var(--color-stone-500, #78716c);\n493\t    }\n494\t  }\n495\t\n496\t  /* Dividers: more visible */\n497\t  .divider {\n498\t    height: 2px;\n499\t    opacity: 1;\n500\t  }\n501\t\n502\t  /* Badges: stronger borders */\n503\t  [class*=\"rounded-full\"][class*=\"bg-amber\"] {\n504\t    border: 1px solid var(--color-amber-700, #b45309);\n505\t  }\n506\t\n507\t  /* Icon boxes: add border */\n508\t  .icon-box {\n509\t    border: 1px solid var(--color-amber-600, #d97706);\n510\t  }\n511\t\n512\t  /* Section labels and small text: slightly bolder */\n513\t  .section-label {\n514\t    font-weight: 600;\n515\t  }\n516\t\n517\t  /* Body text: increase contrast */\n518\t  .body-text {\n519\t    color: var(--color-stone-700, #44403c);\n520\t  }\n521\t\n522\t  @media (prefers-color-scheme: dark) {\n523\t    .body-text {\n524\t      color: var(--color-stone-300, #d6d3d1);\n525\t    }\n526\t  }\n527\t}\n528\t\n529\t/* ============================================================\n530\t   @property-powered keyframe animations (US-233)\n531\t   These animations target @property-registered custom properties,\n532\t   enabling smooth interpolation that would otherwise be impossible\n533\t   with untyped CSS variables.\n534\t   ============================================================ */\n535\t\n536\t/* Rotates gradient angle 135° → 225° → 135° for a subtle shimmer */\n537\t@keyframes gradient-shimmer {\n538\t  0%   { --gradient-angle: 135deg; }\n539\t  50%  { --gradient-angle: 225deg; }\n540\t  100% { --gradient-angle: 135deg; }\n541\t}\n542\t\n543\t/* Sweeps divider gradient midpoint from left to center to right */\n544\t@keyframes divider-sweep {\n545\t  0%   { --divider-progress: 20%; }\n546\t  50%  { --divider-progress: 80%; }\n547\t  100% { --divider-progress: 50%; }\n548\t}\n549\t\n550\t/* Utility class to apply the sweep animation to a divider */\n551\t.divider-animated {\n552\t  animation: divider-sweep 2s ease-in-out forwards;\n553\t}\n554\t\n555\t/* Respect reduced motion */\n556\t@media (prefers-reduced-motion: reduce) {\n557\t  .text-gradient-shimmer {\n558\t    animation: none;\n559\t  }\n560\t  .divider-animated {\n561\t    animation: none;\n562\t  }\n563\t}\n564\t\n565\t/* ============================================================\n566\t   CSS @starting-style entry animations (US-143)\n567\t   Declarative fade/slide-in for elements entering the DOM.\n568\t   Baseline August 2024: Chrome 117+, Firefox 129+, Safari 17.4+.\n569\t   Uses only opacity + transform (GPU compositor thread, no layout).\n570\t   ============================================================ */\n571\t.entry-fade {\n572\t  opacity: 1;\n573\t  transition: opacity 0.3s ease-out;\n574\t  @starting-style { opacity: 0; }\n575\t}\n576\t\n577\t.entry-zoom-in {\n578\t  opacity: 1;\n579\t  transform: scale(1);\n580\t  transition: opacity 0.25s ease-out, transform 0.25s ease-out;\n581\t  @starting-style { opacity: 0; transform: scale(0.95); }\n582\t}\n583\t\n584\t.entry-fade-up {\n585\t  opacity: 1;\n586\t  transform: translateY(0);\n587\t  transition: opacity 0.3s ease-out, transform 0.3s ease-out;\n588\t  @starting-style { opacity: 0; transform: translateY(1rem); }\n589\t}\n590\t\n591\t@media (prefers-reduced-motion: reduce) {\n592\t  .entry-fade, .entry-zoom-in, .entry-fade-up { transition: none; }\n593\t}\n594\t\n595\t/* ============================================================\n596\t   Scroll-driven section reveal animations (US-217)\n597\t   Uses animation-timeline: view() for compositor-thread reveals.\n598\t   Only opacity + transform — no layout shifts, no main-thread paint.\n599\t   Gated behind @supports so unsupporting browsers show content normally.\n600\t   ============================================================ */\n601\t@supports (animation-timeline: view()) {\n602\t  @media (prefers-reduced-motion: no-preference) {\n603\t    @keyframes scroll-fade-in-up {\n604\t      from {\n605\t        opacity: 0;\n606\t        transform: translateY(1.5rem);\n607\t      }\n608\t      to {\n609\t        opacity: 1;\n610\t        transform: translateY(0);\n611\t      }\n612\t    }\n613\t\n614\t    .scroll-reveal {\n615\t      animation: scroll-fade-in-up linear both;\n616\t      animation-timeline: view();\n617\t      animation-range: entry 0% entry 30%;\n618\t    }\n619\t  }\n620\t}\n621\t\n622\t/* ============================================================\n623\t   Cross-document View Transitions (US-197)\n624\t   Opts same-origin hard navigations into a smooth cross-fade\n625\t   via CSS View Transitions Level 2 (@view-transition at-rule).\n626\t   Chrome 126+, Edge 126+, Firefox 144+.\n627\t   Safari degrades gracefully — no transition, no error.\n628\t   Soft navigations (Next.js <Link>) use the JS API separately;\n629\t   this covers direct URL entry, back/forward, and external links.\n630\t   ============================================================ */\n631\t@view-transition {\n632\t  navigation: auto;\n633\t}\n634\t\n635\t::view-transition-old(root) {\n636\t  animation: 200ms ease-out both vt-fade-out;\n637\t}\n638\t\n639\t::view-transition-new(root) {\n640\t  animation: 200ms ease-out both vt-fade-in;\n641\t}\n642\t\n643\t@keyframes vt-fade-out {\n644\t  from { opacity: 1; }\n645\t  to { opacity: 0; }\n646\t}\n647\t\n648\t@keyframes vt-fade-in {\n649\t  from { opacity: 0; }\n650\t  to { opacity: 1; }\n651\t}\n652\t\n653\t/* Disable view transitions when user prefers reduced motion */\n654\t@media (prefers-reduced-motion: reduce) {\n655\t  @view-transition {\n656\t    navigation: none;\n657\t  }\n658\t}\n659\t\n660\t/* Custom scrollbar */\n661\t::-webkit-scrollbar {\n662\t  width: 8px;\n663\t}\n664\t\n665\t::-webkit-scrollbar-track {\n666\t  @apply bg-stone-100;\n667\t}\n668\t\n669\t::-webkit-scrollbar-thumb {\n670\t  @apply bg-stone-300 rounded-full;\n671\t}\n672\t\n673\t::-webkit-scrollbar-thumb:hover {\n674\t  @apply bg-stone-400;\n675\t}\n676\t\n677\t@media (prefers-color-scheme: dark) {\n678\t  ::-webkit-scrollbar-track {\n679\t    background-color: #1c1917;\n680\t  }\n681\t  ::-webkit-scrollbar-thumb {\n682\t    background-color: #57534e;\n683\t  }\n684\t  ::-webkit-scrollbar-thumb:hover {\n685\t    background-color: #78716c;\n686\t  }\n687\t}\n688\t"}]},"parent_tool_use_id":null,"session_id":"db47caa7-f1dd-496e-b0bd-79b00484628d","uuid":"9efd0a58-5ac0-4fca-814c-a1d489e90d82","timestamp":"2026-04-14T00:12:09.957Z","tool_use_result":{"type":"text","file":{"filePath":"/c/Users/Jyue/Documents/1-projects/Software Projects/pelangi-website/site/src/app/globals.css","content":"@import 'tailwindcss';\n\n@plugin \"@tailwindcss/typography\";\n\n/* ============================================================\n   CSS @property — Type-safe, animatable design tokens (US-233)\n   Registered custom properties can be interpolated by the browser\n   because their syntax is known (angle, percentage, etc.).\n   Browsers without @property support treat these as untyped\n   custom properties — static fallback values still render correctly,\n   only the animation is lost (progressive enhancement).\n   Chrome 85+, Firefox 128+, Safari 17.2+.\n   ============================================================ */\n@property --gradient-angle {\n  syntax: \"<angle>\";\n  inherits: false;\n  initial-value: 135deg;\n}\n\n@property --divider-progress {\n  syntax: \"<percentage>\";\n  inherits: false;\n  initial-value: 50%;\n}\n\n@theme {\n  --color-primary-50: #faf8f5;\n  --color-primary-100: #f5f0e8;\n  --color-primary-200: #e8ddd0;\n  --color-primary-300: #d4c4ad;\n  --color-primary-400: #bda685;\n  --color-primary-500: #a68b64;\n  --color-primary-600: #8b7355;\n  --color-primary-700: #715d47;\n  --color-primary-800: #5c4c3c;\n  --color-primary-900: #4a3f33;\n\n  --color-accent-50: #fdf8f6;\n  --color-accent-100: #f9ede8;\n  --color-accent-200: #f4dcd3;\n  --color-accent-300: #ecc4b5;\n  --color-accent-400: #e0a48d;\n  --color-accent-500: #d4846a;\n  --color-accent-600: #c26a4f;\n  --color-accent-700: #a25540;\n  --color-accent-800: #864738;\n  --color-accent-900: #6e3d31;\n\n  --color-sand-50: #fafaf9;\n  --color-sand-100: #f5f5f4;\n  --color-sand-200: #e7e5e4;\n  --color-sand-300: #d6d3d1;\n  --color-sand-400: #a8a29e;\n  --color-sand-500: #78716c;\n  --color-sand-600: #57534e;\n  --color-sand-700: #44403c;\n  --color-sand-800: #292524;\n  --color-sand-900: #1c1917;\n\n  --font-sans: var(--font-inter), system-ui, sans-serif;\n  --font-display: var(--font-playfair), Georgia, serif;\n\n  --text-2xs: 0.65rem;\n  --text-2xs--line-height: 1rem;\n\n  --tracking-widest: 0.2em;\n\n  --animate-fade-in: fadeIn 0.6s ease-out forwards;\n  --animate-slide-up: slideUp 0.6s ease-out forwards;\n  --animate-scale-in: scaleIn 0.4s ease-out forwards;\n\n  --background-image-gradient-radial: radial-gradient(var(--tw-gradient-stops));\n  --background-image-noise: url('/images/noise.png');\n\n  @keyframes fadeIn {\n    0% {\n      opacity: 0;\n    }\n    100% {\n      opacity: 1;\n    }\n  }\n  @keyframes slideUp {\n    0% {\n      opacity: 0;\n      transform: translateY(20px);\n    }\n    100% {\n      opacity: 1;\n      transform: translateY(0);\n    }\n  }\n  @keyframes scaleIn {\n    0% {\n      opacity: 0;\n      transform: scale(0.95);\n    }\n    100% {\n      opacity: 1;\n      transform: scale(1);\n    }\n  }\n}\n\n/*\n  The default border color has changed to `currentcolor` in Tailwind CSS v4,\n  so we've added these compatibility styles to make sure everything still\n  looks the same as it did with Tailwind CSS v3.\n\n  If we ever want to remove these styles, we need to add an explicit border\n  color utility to any element that depends on these defaults.\n*/\n@layer base {\n  *,\n  ::after,\n  ::before,\n  ::backdrop,\n  ::file-selector-button {\n    border-color: var(--color-gray-200, currentcolor);\n  }\n}\n\n@utility btn-primary {\n  /* Primary Button - Warm, sophisticated */\n  @apply bg-stone-700 hover:bg-stone-800 text-white font-medium\n           py-3.5 px-8 rounded-full transition-all duration-300\n           shadow-xs hover:shadow-md cursor-pointer\n           tracking-wide text-sm uppercase\n           focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700\n           dark:bg-stone-200 dark:text-stone-900 dark:hover:bg-stone-100\n           dark:focus-visible:outline-amber-400;\n}\n\n@utility btn-secondary {\n  /* Secondary Button - Minimal outline */\n  @apply bg-transparent hover:bg-stone-100 text-stone-700\n           font-medium py-3.5 px-8 rounded-full\n           border border-stone-500 hover:border-stone-600\n           transition-all duration-300 cursor-pointer\n           tracking-wide text-sm uppercase\n           focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700\n           dark:text-stone-300 dark:border-stone-600 dark:hover:bg-stone-800 dark:hover:border-stone-500\n           dark:focus-visible:outline-amber-400;\n}\n\n@utility section-padding {\n  /* Section spacing - More breathing room */\n  @apply py-20 md:py-28 lg:py-32 px-6 md:px-8;\n}\n\n@utility container-custom {\n  /* Container */\n  @apply max-w-6xl mx-auto;\n}\n\n@utility section-label {\n  /* Section label - Elegant uppercase */\n  @apply text-xs font-medium tracking-widest uppercase text-amber-700 mb-4 dark:text-amber-400;\n}\n\n@utility section-heading {\n  /* Section heading - Serif display font (uses theme --font-display for next/font metric-adjusted fallback) */\n  @apply text-3xl md:text-4xl lg:text-5xl font-medium text-stone-900\n           leading-tight tracking-tight dark:text-stone-100;\n  font-family: var(--font-display);\n}\n\n@utility body-text {\n  /* Body text */\n  @apply text-stone-600 leading-relaxed dark:text-stone-400;\n}\n\n@utility card {\n  /* Card with subtle hover */\n  @apply bg-white rounded-2xl p-6 md:p-8\n           shadow-xs hover:shadow-md transition-shadow duration-300\n           border border-stone-100\n           dark:bg-stone-800 dark:border-stone-700;\n}\n\n@utility image-frame {\n  /* Image container with elegant corners */\n  @apply rounded-2xl overflow-hidden shadow-lg;\n}\n\n@utility divider {\n  /* Divider — uses @property --divider-progress for animatable gradient midpoint */\n  height: 1px;\n  background: linear-gradient(\n    to right,\n    transparent,\n    var(--color-stone-200, #e7e5e4) var(--divider-progress, 50%),\n    transparent\n  );\n}\n\n@media (prefers-color-scheme: dark) {\n  .divider {\n    background: linear-gradient(\n      to right,\n      transparent,\n      var(--color-stone-700, #44403c) var(--divider-progress, 50%),\n      transparent\n    );\n  }\n}\n\n@utility icon-box {\n  /* Feature icon container */\n  @apply w-12 h-12 rounded-xl bg-amber-50 flex items-center justify-center\n           text-amber-700 dark:bg-amber-900/30 dark:text-amber-400;\n}\n\n@utility font-display {\n  /* Display font utility — uses theme variable for next/font metric-adjusted fallback */\n  font-family: var(--font-display);\n}\n\n@utility text-gradient {\n  /* Text gradient — uses @property --gradient-angle for animatable direction */\n  background: linear-gradient(var(--gradient-angle, 135deg), #b45309, #ea580c);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n  color: transparent;\n}\n\n@utility text-gradient-shimmer {\n  /* Animated shimmer variant — rotates gradient angle via @property token */\n  background: linear-gradient(var(--gradient-angle, 135deg), #b45309, #ea580c, #b45309);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n  color: transparent;\n  animation: gradient-shimmer 4s ease-in-out infinite;\n}\n\n@utility image-zoom {\n  /* Smooth image zoom on hover and focus (WCAG 2.1 SC 1.4.13 parity) */\n  @apply transition-transform duration-700 ease-out;\n\n  .group:hover &,\n  .group:focus-within & {\n    @apply scale-105;\n  }\n}\n\n@utility delay-100 {\n  /* Fade in animation delays */\n  animation-delay: 100ms;\n}\n\n@utility delay-200 {\n  animation-delay: 200ms;\n}\n\n@utility delay-300 {\n  animation-delay: 300ms;\n}\n\n@utility delay-400 {\n  animation-delay: 400ms;\n}\n\n@utility scrollbar-hide {\n  /* Hide scrollbar for horizontal scroll sections */\n  -ms-overflow-style: none;\n  scrollbar-width: none;\n\n  &::-webkit-scrollbar {\n    display: none;\n  }\n}\n\n/* CSS Container Query utilities — US-219\n   @supports guard ensures older browsers without CQ support silently ignore\n   container-type and fall back to Tailwind viewport breakpoints (sm:, md:, lg:).\n   Container query units (cqi, cqw) are used here for adaptive label sizing. */\n@supports (container-type: inline-size) {\n  .card-label-cq {\n    /* cqi = 1% of container inline (width) — scales label relative to card width */\n    font-size: clamp(0.75rem, 4.5cqi, 0.875rem);\n    line-height: 1.4;\n  }\n}\n\n@layer base {\n  html {\n    scroll-behavior: smooth;\n    overflow-x: hidden; /* WCAG 2.2 SC 1.4.4 — prevent horizontal scrollbar at 200% zoom */\n  }\n\n  /* Offset sticky header (64px) when scrolling to heading anchors */\n  h2,\n  h3,\n  section[id] {\n    scroll-margin-top: 5rem; /* 80px = 64px header + 16px breathing room */\n  }\n\n  /* US-204: text-wrap: balance prevents awkward single-word orphans on headings.\n     Progressive enhancement — unsupported browsers silently fall back to default wrap.\n     Chrome 114+, Edge 114+, Firefox 121+, Safari 17.4+ */\n  h1,\n  h2,\n  h3 {\n    text-wrap: balance;\n  }\n\n  /* US-204: text-wrap: pretty reduces orphan words in body paragraphs.\n     Uses a lookahead algorithm to avoid lonely single words on the final line.\n     Progressive enhancement — no visual change in unsupported browsers.\n     Chrome 117+, Edge 117+ */\n  p {\n    text-wrap: pretty;\n  }\n\n  /* WCAG 2.2 SC 2.4.11 — prevent MobileBookingBar from obscuring focused elements */\n  @media (max-width: 767px) {\n    html {\n      scroll-padding-bottom: 4rem; /* matches ~64px MobileBookingBar height */\n    }\n  }\n\n  /* WCAG 2.2 SC 2.5.8 — Target Size Minimum: 24×24 CSS px for all interactive elements */\n  /* Inline text links inside .prose are exempt per the inline-text exception */\n  button,\n  [role=\"button\"] {\n    min-height: 1.5rem; /* 24px */\n    min-width: 1.5rem; /* 24px */\n  }\n\n  /* WCAG 2.2 SC 2.4.13 — Focus Appearance: 2px outline, ≥ 3:1 contrast */\n  /* Uses CSS outline (not box-shadow) for Windows High Contrast Mode visibility */\n  :focus-visible {\n    outline: 2px solid var(--color-amber-700, #b45309);\n    outline-offset: 2px;\n  }\n\n  @media (prefers-color-scheme: dark) {\n    :focus-visible {\n      outline-color: var(--color-amber-400, #fbbf24);\n    }\n  }\n\n  body {\n    @apply antialiased bg-stone-50 text-stone-800 dark:bg-stone-950 dark:text-stone-200;\n    font-feature-settings: \"kern\" 1, \"liga\" 1;\n  }\n\n  /* Elegant selection color */\n  ::selection {\n    background-color: #e8ddd0;\n    color: #4a3f33;\n  }\n\n  @media (prefers-color-scheme: dark) {\n    ::selection {\n      background-color: #5c4c3c;\n      color: #f5f0e8;\n    }\n  }\n}\n\n/* WCAG 2.1 SC 1.4.10 — Reflow: prose tables scroll horizontally instead of breaking page layout */\n.prose table {\n  display: block;\n  overflow-x: auto;\n  -webkit-overflow-scrolling: touch;\n}\n\n/* WCAG 2.3.3 / WCAG 2.2.2 — Respect prefers-reduced-motion OS preference */\n/* Technique C39: https://www.w3.org/WAI/WCAG22/Techniques/css/C39 */\n@media (prefers-reduced-motion: reduce) {\n  *, *::before, *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n    scroll-behavior: auto !important;\n  }\n}\n\n/* ============================================================\n   WCAG 2.1 SC 2.2.2 — In-page pause control\n   Pauses all continuous animations when the user activates the\n   PauseAnimationsButton. This is separate from prefers-reduced-motion\n   which only responds to the OS-level preference.\n   ============================================================ */\nhtml.animations-paused *,\nhtml.animations-paused *::before,\nhtml.animations-paused *::after {\n  animation-play-state: paused !important;\n}\n\n/* ============================================================\n   Forced Colors (Windows High Contrast Mode)\n   Ensures all custom-styled interactive elements remain visible\n   when the OS overrides author colors.\n   ============================================================ */\n@media (forced-colors: active) {\n  /* Primary buttons: add explicit border so they remain distinguishable */\n  .btn-primary {\n    border: 2px solid ButtonText;\n    background: ButtonFace;\n    color: ButtonText;\n    forced-color-adjust: none;\n  }\n\n  .btn-primary:hover {\n    background: Highlight;\n    color: HighlightText;\n    border-color: Highlight;\n  }\n\n  /* Secondary buttons: ensure border stays visible */\n  .btn-secondary {\n    border: 2px solid ButtonText;\n    color: ButtonText;\n  }\n\n  .btn-secondary:hover {\n    background: Highlight;\n    color: HighlightText;\n    border-color: Highlight;\n  }\n\n  /* Cards: ensure visible boundary */\n  .card {\n    border: 1px solid CanvasText;\n  }\n\n  /* Icon boxes: add border for visibility without background */\n  .icon-box {\n    border: 1px solid CanvasText;\n  }\n\n  /* Badges (category pills, status indicators): add border so they don't disappear */\n  [class*=\"rounded-full\"][class*=\"bg-amber\"] {\n    border: 1px solid CanvasText;\n    forced-color-adjust: none;\n  }\n\n  /* Focus indicators: ensure outline uses system highlight color */\n  :focus-visible {\n    outline-color: Highlight;\n  }\n\n  /* Icon-only buttons (close, nav arrows): add border for visibility */\n  button:has(> svg:only-child),\n  [role=\"button\"]:has(> svg:only-child) {\n    border: 1px solid ButtonText;\n  }\n\n  /* Dividers: ensure visible in forced-colors */\n  .divider {\n    background: CanvasText;\n  }\n\n  /* Form inputs and textareas: explicit border */\n  input,\n  textarea,\n  select {\n    border: 1px solid ButtonText;\n  }\n\n  /* Links: use system link color */\n  a {\n    color: LinkText;\n  }\n}\n\n/* ============================================================\n   Increased Contrast (macOS \"Increase contrast\" / Windows)\n   Strengthens borders and text contrast for users who opted in.\n   ============================================================ */\n@media (prefers-contrast: more) {\n  /* Form inputs: thicker, darker borders */\n  input,\n  textarea,\n  select {\n    border-width: 2px;\n    border-color: var(--color-stone-700, #44403c);\n  }\n\n  /* Cards: stronger border for visual separation */\n  .card {\n    border-width: 2px;\n    border-color: var(--color-stone-400, #a8a29e);\n  }\n\n  @media (prefers-color-scheme: dark) {\n    .card {\n      border-color: var(--color-stone-500, #78716c);\n    }\n  }\n\n  /* Dividers: more visible */\n  .divider {\n    height: 2px;\n    opacity: 1;\n  }\n\n  /* Badges: stronger borders */\n  [class*=\"rounded-full\"][class*=\"bg-amber\"] {\n    border: 1px solid var(--color-amber-700, #b45309);\n  }\n\n  /* Icon boxes: add border */\n  .icon-box {\n    border: 1px solid var(--color-amber-600, #d97706);\n  }\n\n  /* Section labels and small text: slightly bolder */\n  .section-label {\n    font-weight: 600;\n  }\n\n  /* Body text: increase contrast */\n  .body-text {\n    color: var(--color-stone-700, #44403c);\n  }\n\n  @media (prefers-color-scheme: dark) {\n    .body-text {\n      color: var(--color-stone-300, #d6d3d1);\n    }\n  }\n}\n\n/* ============================================================\n   @property-powered keyframe animations (US-233)\n   These animations target @property-registered custom properties,\n   enabling smooth interpolation that would otherwise be impossible\n   with untyped CSS variables.\n   ============================================================ */\n\n/* Rotates gradient angle 135° → 225° → 135° for a subtle shimmer */\n@keyframes gradient-shimmer {\n  0%   { --gradient-angle: 135deg; }\n  50%  { --gradient-angle: 225deg; }\n  100% { --gradient-angle: 135deg; }\n}\n\n/* Sweeps divider gradient midpoint from left to center to right */\n@keyframes divider-sweep {\n  0%   { --divider-progress: 20%; }\n  50%  { --divider-progress: 80%; }\n  100% { --divider-progress: 50%; }\n}\n\n/* Utility class to apply the sweep animation to a divider */\n.divider-animated {\n  animation: divider-sweep 2s ease-in-out forwards;\n}\n\n/* Respect reduced motion */\n@media (prefers-reduced-motion: reduce) {\n  .text-gradient-shimmer {\n    animation: none;\n  }\n  .divider-animated {\n    animation: none;\n  }\n}\n\n/* ============================================================\n   CSS @starting-style entry animations (US-143)\n   Declarative fade/slide-in for elements entering the DOM.\n   Baseline August 2024: Chrome 117+, Firefox 129+, Safari 17.4+.\n   Uses only opacity + transform (GPU compositor thread, no layout).\n   ============================================================ */\n.entry-fade {\n  opacity: 1;\n  transition: opacity 0.3s ease-out;\n  @starting-style { opacity: 0; }\n}\n\n.entry-zoom-in {\n  opacity: 1;\n  transform: scale(1);\n  transition: opacity 0.25s ease-out, transform 0.25s ease-out;\n  @starting-style { opacity: 0; transform: scale(0.95); }\n}\n\n.entry-fade-up {\n  opacity: 1;\n  transform: translateY(0);\n  transition: opacity 0.3s ease-out, transform 0.3s ease-out;\n  @starting-style { opacity: 0; transform: translateY(1rem); }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .entry-fade, .entry-zoom-in, .entry-fade-up { transition: none; }\n}\n\n/* ============================================================\n   Scroll-driven section reveal animations (US-217)\n   Uses animation-timeline: view() for compositor-thread reveals.\n   Only opacity + transform — no layout shifts, no main-thread paint.\n   Gated behind @supports so unsupporting browsers show content normally.\n   ============================================================ */\n@supports (animation-timeline: view()) {\n  @media (prefers-reduced-motion: no-preference) {\n    @keyframes scroll-fade-in-up {\n      from {\n        opacity: 0;\n        transform: translateY(1.5rem);\n      }\n      to {\n        opacity: 1;\n        transform: translateY(0);\n      }\n    }\n\n    .scroll-reveal {\n      animation: scroll-fade-in-up linear both;\n      animation-timeline: view();\n      animation-range: entry 0% entry 30%;\n    }\n  }\n}\n\n/* ============================================================\n   Cross-document View Transitions (US-197)\n   Opts same-origin hard navigations into a smooth cross-fade\n   via CSS View Transitions Level 2 (@view-transition at-rule).\n   Chrome 126+, Edge 126+, Firefox 144+.\n   Safari degrades gracefully — no transition, no error.\n   Soft navigations (Next.js <Link>) use the JS API separately;\n   this covers direct URL entry, back/forward, and external links.\n   ============================================================ */\n@view-transition {\n  navigation: auto;\n}\n\n::view-transition-old(root) {\n  animation: 200ms ease-out both vt-fade-out;\n}\n\n::view-transition-new(root) {\n  animation: 200ms ease-out both vt-fade-in;\n}\n\n@keyframes vt-fade-out {\n  from { opacity: 1; }\n  to { opacity: 0; }\n}\n\n@keyframes vt-fade-in {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n/* Disable view transitions when user prefers reduced motion */\n@media (prefers-reduced-motion: reduce) {\n  @view-transition {\n    navigation: none;\n  }\n}\n\n/* Custom scrollbar */\n::-webkit-scrollbar {\n  width: 8px;\n}\n\n::-webkit-scrollbar-track {\n  @apply bg-stone-100;\n}\n\n::-webkit-scrollbar-thumb {\n  @apply bg-stone-300 rounded-full;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  @apply bg-stone-400;\n}\n\n@media (prefers-color-scheme: dark) {\n  ::-webkit-scrollbar-track {\n    background-color: #1c1917;\n  }\n  ::-webkit-scrollbar-thumb {\n    background-color: #57534e;\n  }\n  ::-webkit-scrollbar-thumb:hover {\n    background-color: #78716c;\n  }\n}\n","numLines":688,"startLine":1,"totalLines":688}}}
{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01U5HB63NYPdSymLJGVsvxnT","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"Now I have a full picture of the codebase. Let me plan a MINIMAL implementation.\n\nThe key constraints:\n1. Total diff must be under 500 lines (insertions + deletions combined)\n2. Previous attempt was 17,788 lines (likely touched package-lock.json)\n3. There are NO existing tooltip/popover libraries to replace\n4. The codebase uses native `title` attributes and `useState` for show/hide\n\nMy approach:\n1. Create a small `InfoPopover.tsx` component (~50-60 lines) that uses the native Popover API + CSS anchor positioning\n\n\n2. Add minimal CSS for popover styling in globals.css (~25 lines)\n3. Apply the component in `HeroTrustBadges.tsx` - convert the trust badge buttons to use InfoPopover to show more details on click (instead of the current `cursor-default` buttons with just analytics tracking)\n4. Apply to Header.tsx - convert `title=\"Search (Ctrl+K)\"` to an InfoPopover\n\nWait, I'm realizing the HeroTrustBadges buttons are currently just buttons with `cursor-default` that track analytics without showing any tooltip content. Converting them would ADD content, not replace existing functionality. Let me reconsider the approach based on the actual acceptance criteria.\n\nSince there are no existing tooltip or popover components in the codebase—no library, no custom implementations—I need to create the InfoPopover component using native APIs and apply it to replace the browser's native `title` attributes. The bundle size decrease criterion makes sense here because we're not adding any new dependencies, just using native popover and anchor positioning APIs. So the plan is to create a lightweight InfoPopover component, add minimal CSS styling, and use it to replace `title` attributes throughout the codebase.\n\nI'm going to keep this implementation tight: a reusable InfoPopover component, some popover and anchor positioning styles in the global CSS, then swap out the `title` attribute in Header.tsx for the search tooltip and add info popovers to the trust badges in HeroTrustBadges.tsx. The whole thing should come in around 95 lines, well under the 500-line limit.\n\nNow I'm writing the component code...","signature":""}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":7820,"cache_read_input_tokens":50138,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":7820},"output_tokens":10,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"db47caa7-f1dd-496e-b0bd-79b00484628d","uuid":"3ca6de78-3e5d-4fa5-8582-507f28d1dc56"}
{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01U5HB63NYPdSymLJGVsvxnT","type":"message","role":"assistant","content":[{"type":"text","text":"## Current State\nThe codebase has no tooltip/popover JavaScript libraries (no Popper.js, Floating UI, or tippy.js). Tooltips are implemented via native HTML `title` attributes (Header search button). Trust badges in HeroTrustBadges use click handlers for analytics only, with no info popover content.\n\n## Problem Identified\nThe story asks to create accessible tooltip/popover components using the native HTML Popover API and CSS Anchor Positioning, replacing `title` attribute tooltips and adding info popovers that provide keyboard navigation, Escape dismissal, and focus management for free via the platform.\n\n## Planned Changes\n- **Create** `site/src/components/InfoPopover.tsx` — Reusable popover component using `popover` attribute, `popovertarget`, CSS anchor-name/position-anchor\n- **Modify** `site/src/app/globals.css` — Add popover and anchor positioning styles with `@supports` fallback\n- **Modify** `site/src/components/Header.tsx` — Replace `title=\"Search (Ctrl+K)\"` with InfoPopover component\n- **Modify** `site/src/components/HeroTrustBadges.tsx` — Add info popovers to trust badge buttons\n- **Modify** `prd.json` — Mark US-144 passes: true\n\n<plan>\n{\n  \"files_to_create\": [\"site/src/components/InfoPopover.tsx\"],\n  \"files_to_modify\": [\"site/src/app/globals.css\", \"site/src/components/Header.tsx\", \"site/src/components/HeroTrustBadges.tsx\", \"prd.json\"],\n  \"functions_to_add\": [\"InfoPopover\"],\n  \"estimated_loc\": 100\n}\n</plan>\n\nNow let me implement."}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":7820,"cache_read_input_tokens":50138,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":7820},"output_tokens":10,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"db47caa7-f1dd-496e-b0bd-79b00484628d","uuid":"305bd21d-c6fe-4687-bb18-3f98b122dc38"}
{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01U5HB63NYPdSymLJGVsvxnT","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_017YWXPAg2N1oyQeJc8hY2tH","name":"Write","input":{"file_path":"/c/Users/Jyue/Documents/1-projects/Software Projects/pelangi-website/site/src/components/InfoPopover.tsx","content":"\"use client\";\n\nimport { useId } from \"react\";\n\ninterface InfoPopoverProps {\n  /** The trigger element (usually a button or badge) */\n  children: React.ReactNode;\n  /** Content shown inside the popover */\n  content: React.ReactNode;\n  /** Additional className for the trigger wrapper */\n  className?: string;\n  /** aria-label for the trigger button */\n  ariaLabel?: string;\n}\n\n/**\n * Native HTML Popover API component with CSS Anchor Positioning.\n * Provides keyboard navigation, Escape dismissal, and focus management\n * via the platform — zero JavaScript positioning logic.\n *\n * - popover=\"auto\" → light-dismiss (click outside closes)\n * - popovertarget → declarative trigger binding\n * - CSS anchor-name / position-anchor → tethering without JS\n * - @supports fallback for browsers without anchor positioning\n */\nexport default function InfoPopover({\n  children,\n  content,\n  className = \"\",\n  ariaLabel,\n}: InfoPopoverProps) {\n  const id = useId();\n  const popoverId = `popover-${id}`;\n\n  return (\n    <span className={`info-popover-anchor ${className}`}>\n      <button\n        type=\"button\"\n        /* @ts-expect-error — popovertarget is valid HTML but not yet in React's types */\n        popovertarget={popoverId}\n        className=\"info-popover-trigger\"\n        aria-label={ariaLabel}\n        style={{ anchorName: `--anchor-${CSS.escape(id)}` } as React.CSSProperties}\n      >\n        {children}\n      </button>\n      <div\n        id={popoverId}\n        /* @ts-expect-error — popover attribute is valid HTML but not yet in React's types */\n        popover=\"auto\"\n        className=\"info-popover\"\n        role=\"status\"\n        style={{ positionAnchor: `--anchor-${CSS.escape(id)}` } as React.CSSProperties}\n      >\n        {content}\n      </div>\n    </span>\n  );\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":7820,"cache_read_input_tokens":50138,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":7820},"output_tokens":10,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"db47caa7-f1dd-496e-b0bd-79b00484628d","uuid":"6dd2ac05-4d59-4328-8b82-02fb3dd192fa"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017YWXPAg2N1oyQeJc8hY2tH","type":"tool_result","content":"File created successfully at: /c/Users/Jyue/Documents/1-projects/Software Projects/pelangi-website/site/src/components/InfoPopover.tsx"}]},"parent_tool_use_id":null,"session_id":"db47caa7-f1dd-496e-b0bd-79b00484628d","uuid":"0b14fec4-f78a-4035-b912-55d75f98c804","timestamp":"2026-04-14T00:12:50.273Z","tool_use_result":{"type":"create","filePath":"/c/Users/Jyue/Documents/1-projects/Software Projects/pelangi-website/site/src/components/InfoPopover.tsx","content":"\"use client\";\n\nimport { useId } from \"react\";\n\ninterface InfoPopoverProps {\n  /** The trigger element (usually a button or badge) */\n  children: React.ReactNode;\n  /** Content shown inside the popover */\n  content: React.ReactNode;\n  /** Additional className for the trigger wrapper */\n  className?: string;\n  /** aria-label for the trigger button */\n  ariaLabel?: string;\n}\n\n/**\n * Native HTML Popover API component with CSS Anchor Positioning.\n * Provides keyboard navigation, Escape dismissal, and focus management\n * via the platform — zero JavaScript positioning logic.\n *\n * - popover=\"auto\" → light-dismiss (click outside closes)\n * - popovertarget → declarative trigger binding\n * - CSS anchor-name / position-anchor → tethering without JS\n * - @supports fallback for browsers without anchor positioning\n */\nexport default function InfoPopover({\n  children,\n  content,\n  className = \"\",\n  ariaLabel,\n}: InfoPopoverProps) {\n  const id = useId();\n  const popoverId = `popover-${id}`;\n\n  return (\n    <span className={`info-popover-anchor ${className}`}>\n      <button\n        type=\"button\"\n        /* @ts-expect-error — popovertarget is valid HTML but not yet in React's types */\n        popovertarget={popoverId}\n        className=\"info-popover-trigger\"\n        aria-label={ariaLabel}\n        style={{ anchorName: `--anchor-${CSS.escape(id)}` } as React.CSSProperties}\n      >\n        {children}\n      </button>\n      <div\n        id={popoverId}\n        /* @ts-expect-error — popover attribute is valid HTML but not yet in React's types */\n        popover=\"auto\"\n        className=\"info-popover\"\n        role=\"status\"\n        style={{ positionAnchor: `--anchor-${CSS.escape(id)}` } as React.CSSProperties}\n      >\n        {content}\n      </div>\n    </span>\n  );\n}\n","structuredPatch":[],"originalFile":null}}
{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01VYDY3K7mAvgu2esDYhi7Cn","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_015LibnHie6t8vcQ923JmXB8","name":"Edit","input":{"replace_all":false,"file_path":"/c/Users/Jyue/Documents/1-projects/Software Projects/pelangi-website/site/src/app/globals.css","old_string":"/* Custom scrollbar */","new_string":"/* ============================================================\n   Native Popover + CSS Anchor Positioning (US-144)\n   Uses HTML popover attribute for keyboard/focus management\n   and CSS anchor-name / position-anchor for tethering.\n   @supports fallback for browsers without anchor positioning.\n   Chrome 125+, Edge 125+. Safari/Firefox: absolute fallback.\n   ============================================================ */\n.info-popover-anchor {\n  position: relative;\n  display: inline-flex;\n}\n\n.info-popover-trigger {\n  all: unset;\n  display: inline-flex;\n  cursor: pointer;\n}\n\n.info-popover {\n  margin: 0;\n  border: 1px solid var(--color-stone-200, #e7e5e4);\n  border-radius: 0.75rem;\n  padding: 0.5rem 0.75rem;\n  background: white;\n  color: var(--color-stone-700, #44403c);\n  font-size: 0.8125rem;\n  line-height: 1.4;\n  max-width: 15rem;\n  box-shadow: 0 4px 12px rgb(0 0 0 / 0.08);\n  /* Entry animation */\n  opacity: 1;\n  transition: opacity 0.15s ease-out, transform 0.15s ease-out;\n}\n\n.info-popover:not(:popover-open) {\n  display: none;\n}\n\n/* Anchor positioning (Chrome 125+) */\n@supports (position-anchor: --x) {\n  .info-popover {\n    position: fixed;\n    position-area: block-end span-inline-end;\n    margin-top: 0.375rem;\n  }\n}\n\n/* Fallback for browsers without anchor positioning */\n@supports not (position-anchor: --x) {\n  .info-popover {\n    position: absolute;\n    top: calc(100% + 0.375rem);\n    left: 50%;\n    transform: translateX(-50%);\n  }\n}\n\n@media (prefers-color-scheme: dark) {\n  .info-popover {\n    background: var(--color-stone-800, #292524);\n    color: var(--color-stone-200, #e7e5e4);\n    border-color: var(--color-stone-700, #44403c);\n    box-shadow: 0 4px 12px rgb(0 0 0 / 0.3);\n  }\n}\n\n/* Forced colors: ensure popover border is visible */\n@media (forced-colors: active) {\n  .info-popover {\n    border: 2px solid CanvasText;\n  }\n}\n\n/* Custom scrollbar */"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1843,"cache_read_input_tokens":57958,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1843},"output_tokens":68,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"db47caa7-f1dd-496e-b0bd-79b00484628d","uuid":"dfedd1f1-900a-4d97-9060-a41a14334a68"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015LibnHie6t8vcQ923JmXB8","type":"tool_result","content":"The file /c/Users/Jyue/Documents/1-projects/Software Projects/pelangi-website/site/src/app/globals.css has been updated successfully."}]},"parent_tool_use_id":null,"session_id":"db47caa7-f1dd-496e-b0bd-79b00484628d","uuid":"e955d440-63af-438c-a9c4-183d52224e78","timestamp":"2026-04-14T00:13:04.749Z","tool_use_result":{"filePath":"/c/Users/Jyue/Documents/1-projects/Software Projects/pelangi-website/site/src/app/globals.css","oldString":"/* Custom scrollbar */","newString":"/* ============================================================\n   Native Popover + CSS Anchor Positioning (US-144)\n   Uses HTML popover attribute for keyboard/focus management\n   and CSS anchor-name / position-anchor for tethering.\n   @supports fallback for browsers without anchor positioning.\n   Chrome 125+, Edge 125+. Safari/Firefox: absolute fallback.\n   ============================================================ */\n.info-popover-anchor {\n  position: relative;\n  display: inline-flex;\n}\n\n.info-popover-trigger {\n  all: unset;\n  display: inline-flex;\n  cursor: pointer;\n}\n\n.info-popover {\n  margin: 0;\n  border: 1px solid var(--color-stone-200, #e7e5e4);\n  border-radius: 0.75rem;\n  padding: 0.5rem 0.75rem;\n  background: white;\n  color: var(--color-stone-700, #44403c);\n  font-size: 0.8125rem;\n  line-height: 1.4;\n  max-width: 15rem;\n  box-shadow: 0 4px 12px rgb(0 0 0 / 0.08);\n  /* Entry animation */\n  opacity: 1;\n  transition: opacity 0.15s ease-out, transform 0.15s ease-out;\n}\n\n.info-popover:not(:popover-open) {\n  display: none;\n}\n\n/* Anchor positioning (Chrome 125+) */\n@supports (position-anchor: --x) {\n  .info-popover {\n    position: fixed;\n    position-area: block-end span-inline-end;\n    margin-top: 0.375rem;\n  }\n}\n\n/* Fallback for browsers without anchor positioning */\n@supports not (position-anchor: --x) {\n  .info-popover {\n    position: absolute;\n    top: calc(100% + 0.375rem);\n    left: 50%;\n    transform: translateX(-50%);\n  }\n}\n\n@media (prefers-color-scheme: dark) {\n  .info-popover {\n    background: var(--color-stone-800, #292524);\n    color: var(--color-stone-200, #e7e5e4);\n    border-color: var(--color-stone-700, #44403c);\n    box-shadow: 0 4px 12px rgb(0 0 0 / 0.3);\n  }\n}\n\n/* Forced colors: ensure popover border is visible */\n@media (forced-colors: active) {\n  .info-popover {\n    border: 2px solid CanvasText;\n  }\n}\n\n/* Custom scrollbar */","originalFile":"@import 'tailwindcss';\n\n@plugin \"@tailwindcss/typography\";\n\n/* ============================================================\n   CSS @property — Type-safe, animatable design tokens (US-233)\n   Registered custom properties can be interpolated by the browser\n   because their syntax is known (angle, percentage, etc.).\n   Browsers without @property support treat these as untyped\n   custom properties — static fallback values still render correctly,\n   only the animation is lost (progressive enhancement).\n   Chrome 85+, Firefox 128+, Safari 17.2+.\n   ============================================================ */\n@property --gradient-angle {\n  syntax: \"<angle>\";\n  inherits: false;\n  initial-value: 135deg;\n}\n\n@property --divider-progress {\n  syntax: \"<percentage>\";\n  inherits: false;\n  initial-value: 50%;\n}\n\n@theme {\n  --color-primary-50: #faf8f5;\n  --color-primary-100: #f5f0e8;\n  --color-primary-200: #e8ddd0;\n  --color-primary-300: #d4c4ad;\n  --color-primary-400: #bda685;\n  --color-primary-500: #a68b64;\n  --color-primary-600: #8b7355;\n  --color-primary-700: #715d47;\n  --color-primary-800: #5c4c3c;\n  --color-primary-900: #4a3f33;\n\n  --color-accent-50: #fdf8f6;\n  --color-accent-100: #f9ede8;\n  --color-accent-200: #f4dcd3;\n  --color-accent-300: #ecc4b5;\n  --color-accent-400: #e0a48d;\n  --color-accent-500: #d4846a;\n  --color-accent-600: #c26a4f;\n  --color-accent-700: #a25540;\n  --color-accent-800: #864738;\n  --color-accent-900: #6e3d31;\n\n  --color-sand-50: #fafaf9;\n  --color-sand-100: #f5f5f4;\n  --color-sand-200: #e7e5e4;\n  --color-sand-300: #d6d3d1;\n  --color-sand-400: #a8a29e;\n  --color-sand-500: #78716c;\n  --color-sand-600: #57534e;\n  --color-sand-700: #44403c;\n  --color-sand-800: #292524;\n  --color-sand-900: #1c1917;\n\n  --font-sans: var(--font-inter), system-ui, sans-serif;\n  --font-display: var(--font-playfair), Georgia, serif;\n\n  --text-2xs: 0.65rem;\n  --text-2xs--line-height: 1rem;\n\n  --tracking-widest: 0.2em;\n\n  --animate-fade-in: fadeIn 0.6s ease-out forwards;\n  --animate-slide-up: slideUp 0.6s ease-out forwards;\n  --animate-scale-in: scaleIn 0.4s ease-out forwards;\n\n  --background-image-gradient-radial: radial-gradient(var(--tw-gradient-stops));\n  --background-image-noise: url('/images/noise.png');\n\n  @keyframes fadeIn {\n    0% {\n      opacity: 0;\n    }\n    100% {\n      opacity: 1;\n    }\n  }\n  @keyframes slideUp {\n    0% {\n      opacity: 0;\n      transform: translateY(20px);\n    }\n    100% {\n      opacity: 1;\n      transform: translateY(0);\n    }\n  }\n  @keyframes scaleIn {\n    0% {\n      opacity: 0;\n      transform: scale(0.95);\n    }\n    100% {\n      opacity: 1;\n      transform: scale(1);\n    }\n  }\n}\n\n/*\n  The default border color has changed to `currentcolor` in Tailwind CSS v4,\n  so we've added these compatibility styles to make sure everything still\n  looks the same as it did with Tailwind CSS v3.\n\n  If we ever want to remove these styles, we need to add an explicit border\n  color utility to any element that depends on these defaults.\n*/\n@layer base {\n  *,\n  ::after,\n  ::before,\n  ::backdrop,\n  ::file-selector-button {\n    border-color: var(--color-gray-200, currentcolor);\n  }\n}\n\n@utility btn-primary {\n  /* Primary Button - Warm, sophisticated */\n  @apply bg-stone-700 hover:bg-stone-800 text-white font-medium\n           py-3.5 px-8 rounded-full transition-all duration-300\n           shadow-xs hover:shadow-md cursor-pointer\n           tracking-wide text-sm uppercase\n           focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700\n           dark:bg-stone-200 dark:text-stone-900 dark:hover:bg-stone-100\n           dark:focus-visible:outline-amber-400;\n}\n\n@utility btn-secondary {\n  /* Secondary Button - Minimal outline */\n  @apply bg-transparent hover:bg-stone-100 text-stone-700\n           font-medium py-3.5 px-8 rounded-full\n           border border-stone-500 hover:border-stone-600\n           transition-all duration-300 cursor-pointer\n           tracking-wide text-sm uppercase\n           focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700\n           dark:text-stone-300 dark:border-stone-600 dark:hover:bg-stone-800 dark:hover:border-stone-500\n           dark:focus-visible:outline-amber-400;\n}\n\n@utility section-padding {\n  /* Section spacing - More breathing room */\n  @apply py-20 md:py-28 lg:py-32 px-6 md:px-8;\n}\n\n@utility container-custom {\n  /* Container */\n  @apply max-w-6xl mx-auto;\n}\n\n@utility section-label {\n  /* Section label - Elegant uppercase */\n  @apply text-xs font-medium tracking-widest uppercase text-amber-700 mb-4 dark:text-amber-400;\n}\n\n@utility section-heading {\n  /* Section heading - Serif display font (uses theme --font-display for next/font metric-adjusted fallback) */\n  @apply text-3xl md:text-4xl lg:text-5xl font-medium text-stone-900\n           leading-tight tracking-tight dark:text-stone-100;\n  font-family: var(--font-display);\n}\n\n@utility body-text {\n  /* Body text */\n  @apply text-stone-600 leading-relaxed dark:text-stone-400;\n}\n\n@utility card {\n  /* Card with subtle hover */\n  @apply bg-white rounded-2xl p-6 md:p-8\n           shadow-xs hover:shadow-md transition-shadow duration-300\n           border border-stone-100\n           dark:bg-stone-800 dark:border-stone-700;\n}\n\n@utility image-frame {\n  /* Image container with elegant corners */\n  @apply rounded-2xl overflow-hidden shadow-lg;\n}\n\n@utility divider {\n  /* Divider — uses @property --divider-progress for animatable gradient midpoint */\n  height: 1px;\n  background: linear-gradient(\n    to right,\n    transparent,\n    var(--color-stone-200, #e7e5e4) var(--divider-progress, 50%),\n    transparent\n  );\n}\n\n@media (prefers-color-scheme: dark) {\n  .divider {\n    background: linear-gradient(\n      to right,\n      transparent,\n      var(--color-stone-700, #44403c) var(--divider-progress, 50%),\n      transparent\n    );\n  }\n}\n\n@utility icon-box {\n  /* Feature icon container */\n  @apply w-12 h-12 rounded-xl bg-amber-50 flex items-center justify-center\n           text-amber-700 dark:bg-amber-900/30 dark:text-amber-400;\n}\n\n@utility font-display {\n  /* Display font utility — uses theme variable for next/font metric-adjusted fallback */\n  font-family: var(--font-display);\n}\n\n@utility text-gradient {\n  /* Text gradient — uses @property --gradient-angle for animatable direction */\n  background: linear-gradient(var(--gradient-angle, 135deg), #b45309, #ea580c);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n  color: transparent;\n}\n\n@utility text-gradient-shimmer {\n  /* Animated shimmer variant — rotates gradient angle via @property token */\n  background: linear-gradient(var(--gradient-angle, 135deg), #b45309, #ea580c, #b45309);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n  color: transparent;\n  animation: gradient-shimmer 4s ease-in-out infinite;\n}\n\n@utility image-zoom {\n  /* Smooth image zoom on hover and focus (WCAG 2.1 SC 1.4.13 parity) */\n  @apply transition-transform duration-700 ease-out;\n\n  .group:hover &,\n  .group:focus-within & {\n    @apply scale-105;\n  }\n}\n\n@utility delay-100 {\n  /* Fade in animation delays */\n  animation-delay: 100ms;\n}\n\n@utility delay-200 {\n  animation-delay: 200ms;\n}\n\n@utility delay-300 {\n  animation-delay: 300ms;\n}\n\n@utility delay-400 {\n  animation-delay: 400ms;\n}\n\n@utility scrollbar-hide {\n  /* Hide scrollbar for horizontal scroll sections */\n  -ms-overflow-style: none;\n  scrollbar-width: none;\n\n  &::-webkit-scrollbar {\n    display: none;\n  }\n}\n\n/* CSS Container Query utilities — US-219\n   @supports guard ensures older browsers without CQ support silently ignore\n   container-type and fall back to Tailwind viewport breakpoints (sm:, md:, lg:).\n   Container query units (cqi, cqw) are used here for adaptive label sizing. */\n@supports (container-type: inline-size) {\n  .card-label-cq {\n    /* cqi = 1% of container inline (width) — scales label relative to card width */\n    font-size: clamp(0.75rem, 4.5cqi, 0.875rem);\n    line-height: 1.4;\n  }\n}\n\n@layer base {\n  html {\n    scroll-behavior: smooth;\n    overflow-x: hidden; /* WCAG 2.2 SC 1.4.4 — prevent horizontal scrollbar at 200% zoom */\n  }\n\n  /* Offset sticky header (64px) when scrolling to heading anchors */\n  h2,\n  h3,\n  section[id] {\n    scroll-margin-top: 5rem; /* 80px = 64px header + 16px breathing room */\n  }\n\n  /* US-204: text-wrap: balance prevents awkward single-word orphans on headings.\n     Progressive enhancement — unsupported browsers silently fall back to default wrap.\n     Chrome 114+, Edge 114+, Firefox 121+, Safari 17.4+ */\n  h1,\n  h2,\n  h3 {\n    text-wrap: balance;\n  }\n\n  /* US-204: text-wrap: pretty reduces orphan words in body paragraphs.\n     Uses a lookahead algorithm to avoid lonely single words on the final line.\n     Progressive enhancement — no visual change in unsupported browsers.\n     Chrome 117+, Edge 117+ */\n  p {\n    text-wrap: pretty;\n  }\n\n  /* WCAG 2.2 SC 2.4.11 — prevent MobileBookingBar from obscuring focused elements */\n  @media (max-width: 767px) {\n    html {\n      scroll-padding-bottom: 4rem; /* matches ~64px MobileBookingBar height */\n    }\n  }\n\n  /* WCAG 2.2 SC 2.5.8 — Target Size Minimum: 24×24 CSS px for all interactive elements */\n  /* Inline text links inside .prose are exempt per the inline-text exception */\n  button,\n  [role=\"button\"] {\n    min-height: 1.5rem; /* 24px */\n    min-width: 1.5rem; /* 24px */\n  }\n\n  /* WCAG 2.2 SC 2.4.13 — Focus Appearance: 2px outline, ≥ 3:1 contrast */\n  /* Uses CSS outline (not box-shadow) for Windows High Contrast Mode visibility */\n  :focus-visible {\n    outline: 2px solid var(--color-amber-700, #b45309);\n    outline-offset: 2px;\n  }\n\n  @media (prefers-color-scheme: dark) {\n    :focus-visible {\n      outline-color: var(--color-amber-400, #fbbf24);\n    }\n  }\n\n  body {\n    @apply antialiased bg-stone-50 text-stone-800 dark:bg-stone-950 dark:text-stone-200;\n    font-feature-settings: \"kern\" 1, \"liga\" 1;\n  }\n\n  /* Elegant selection color */\n  ::selection {\n    background-color: #e8ddd0;\n    color: #4a3f33;\n  }\n\n  @media (prefers-color-scheme: dark) {\n    ::selection {\n      background-color: #5c4c3c;\n      color: #f5f0e8;\n    }\n  }\n}\n\n/* WCAG 2.1 SC 1.4.10 — Reflow: prose tables scroll horizontally instead of breaking page layout */\n.prose table {\n  display: block;\n  overflow-x: auto;\n  -webkit-overflow-scrolling: touch;\n}\n\n/* WCAG 2.3.3 / WCAG 2.2.2 — Respect prefers-reduced-motion OS preference */\n/* Technique C39: https://www.w3.org/WAI/WCAG22/Techniques/css/C39 */\n@media (prefers-reduced-motion: reduce) {\n  *, *::before, *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n    scroll-behavior: auto !important;\n  }\n}\n\n/* ============================================================\n   WCAG 2.1 SC 2.2.2 — In-page pause control\n   Pauses all continuous animations when the user activates the\n   PauseAnimationsButton. This is separate from prefers-reduced-motion\n   which only responds to the OS-level preference.\n   ============================================================ */\nhtml.animations-paused *,\nhtml.animations-paused *::before,\nhtml.animations-paused *::after {\n  animation-play-state: paused !important;\n}\n\n/* ============================================================\n   Forced Colors (Windows High Contrast Mode)\n   Ensures all custom-styled interactive elements remain visible\n   when the OS overrides author colors.\n   ============================================================ */\n@media (forced-colors: active) {\n  /* Primary buttons: add explicit border so they remain distinguishable */\n  .btn-primary {\n    border: 2px solid ButtonText;\n    background: ButtonFace;\n    color: ButtonText;\n    forced-color-adjust: none;\n  }\n\n  .btn-primary:hover {\n    background: Highlight;\n    color: HighlightText;\n    border-color: Highlight;\n  }\n\n  /* Secondary buttons: ensure border stays visible */\n  .btn-secondary {\n    border: 2px solid ButtonText;\n    color: ButtonText;\n  }\n\n  .btn-secondary:hover {\n    background: Highlight;\n    color: HighlightText;\n    border-color: Highlight;\n  }\n\n  /* Cards: ensure visible boundary */\n  .card {\n    border: 1px solid CanvasText;\n  }\n\n  /* Icon boxes: add border for visibility without background */\n  .icon-box {\n    border: 1px solid CanvasText;\n  }\n\n  /* Badges (category pills, status indicators): add border so they don't disappear */\n  [class*=\"rounded-full\"][class*=\"bg-amber\"] {\n    border: 1px solid CanvasText;\n    forced-color-adjust: none;\n  }\n\n  /* Focus indicators: ensure outline uses system highlight color */\n  :focus-visible {\n    outline-color: Highlight;\n  }\n\n  /* Icon-only buttons (close, nav arrows): add border for visibility */\n  button:has(> svg:only-child),\n  [role=\"button\"]:has(> svg:only-child) {\n    border: 1px solid ButtonText;\n  }\n\n  /* Dividers: ensure visible in forced-colors */\n  .divider {\n    background: CanvasText;\n  }\n\n  /* Form inputs and textareas: explicit border */\n  input,\n  textarea,\n  select {\n    border: 1px solid ButtonText;\n  }\n\n  /* Links: use system link color */\n  a {\n    color: LinkText;\n  }\n}\n\n/* ============================================================\n   Increased Contrast (macOS \"Increase contrast\" / Windows)\n   Strengthens borders and text contrast for users who opted in.\n   ============================================================ */\n@media (prefers-contrast: more) {\n  /* Form inputs: thicker, darker borders */\n  input,\n  textarea,\n  select {\n    border-width: 2px;\n    border-color: var(--color-stone-700, #44403c);\n  }\n\n  /* Cards: stronger border for visual separation */\n  .card {\n    border-width: 2px;\n    border-color: var(--color-stone-400, #a8a29e);\n  }\n\n  @media (prefers-color-scheme: dark) {\n    .card {\n      border-color: var(--color-stone-500, #78716c);\n    }\n  }\n\n  /* Dividers: more visible */\n  .divider {\n    height: 2px;\n    opacity: 1;\n  }\n\n  /* Badges: stronger borders */\n  [class*=\"rounded-full\"][class*=\"bg-amber\"] {\n    border: 1px solid var(--color-amber-700, #b45309);\n  }\n\n  /* Icon boxes: add border */\n  .icon-box {\n    border: 1px solid var(--color-amber-600, #d97706);\n  }\n\n  /* Section labels and small text: slightly bolder */\n  .section-label {\n    font-weight: 600;\n  }\n\n  /* Body text: increase contrast */\n  .body-text {\n    color: var(--color-stone-700, #44403c);\n  }\n\n  @media (prefers-color-scheme: dark) {\n    .body-text {\n      color: var(--color-stone-300, #d6d3d1);\n    }\n  }\n}\n\n/* ============================================================\n   @property-powered keyframe animations (US-233)\n   These animations target @property-registered custom properties,\n   enabling smooth interpolation that would otherwise be impossible\n   with untyped CSS variables.\n   ============================================================ */\n\n/* Rotates gradient angle 135° → 225° → 135° for a subtle shimmer */\n@keyframes gradient-shimmer {\n  0%   { --gradient-angle: 135deg; }\n  50%  { --gradient-angle: 225deg; }\n  100% { --gradient-angle: 135deg; }\n}\n\n/* Sweeps divider gradient midpoint from left to center to right */\n@keyframes divider-sweep {\n  0%   { --divider-progress: 20%; }\n  50%  { --divider-progress: 80%; }\n  100% { --divider-progress: 50%; }\n}\n\n/* Utility class to apply the sweep animation to a divider */\n.divider-animated {\n  animation: divider-sweep 2s ease-in-out forwards;\n}\n\n/* Respect reduced motion */\n@media (prefers-reduced-motion: reduce) {\n  .text-gradient-shimmer {\n    animation: none;\n  }\n  .divider-animated {\n    animation: none;\n  }\n}\n\n/* ============================================================\n   CSS @starting-style entry animations (US-143)\n   Declarative fade/slide-in for elements entering the DOM.\n   Baseline August 2024: Chrome 117+, Firefox 129+, Safari 17.4+.\n   Uses only opacity + transform (GPU compositor thread, no layout).\n   ============================================================ */\n.entry-fade {\n  opacity: 1;\n  transition: opacity 0.3s ease-out;\n  @starting-style { opacity: 0; }\n}\n\n.entry-zoom-in {\n  opacity: 1;\n  transform: scale(1);\n  transition: opacity 0.25s ease-out, transform 0.25s ease-out;\n  @starting-style { opacity: 0; transform: scale(0.95); }\n}\n\n.entry-fade-up {\n  opacity: 1;\n  transform: translateY(0);\n  transition: opacity 0.3s ease-out, transform 0.3s ease-out;\n  @starting-style { opacity: 0; transform: translateY(1rem); }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .entry-fade, .entry-zoom-in, .entry-fade-up { transition: none; }\n}\n\n/* ============================================================\n   Scroll-driven section reveal animations (US-217)\n   Uses animation-timeline: view() for compositor-thread reveals.\n   Only opacity + transform — no layout shifts, no main-thread paint.\n   Gated behind @supports so unsupporting browsers show content normally.\n   ============================================================ */\n@supports (animation-timeline: view()) {\n  @media (prefers-reduced-motion: no-preference) {\n    @keyframes scroll-fade-in-up {\n      from {\n        opacity: 0;\n        transform: translateY(1.5rem);\n      }\n      to {\n        opacity: 1;\n        transform: translateY(0);\n      }\n    }\n\n    .scroll-reveal {\n      animation: scroll-fade-in-up linear both;\n      animation-timeline: view();\n      animation-range: entry 0% entry 30%;\n    }\n  }\n}\n\n/* ============================================================\n   Cross-document View Transitions (US-197)\n   Opts same-origin hard navigations into a smooth cross-fade\n   via CSS View Transitions Level 2 (@view-transition at-rule).\n   Chrome 126+, Edge 126+, Firefox 144+.\n   Safari degrades gracefully — no transition, no error.\n   Soft navigations (Next.js <Link>) use the JS API separately;\n   this covers direct URL entry, back/forward, and external links.\n   ============================================================ */\n@view-transition {\n  navigation: auto;\n}\n\n::view-transition-old(root) {\n  animation: 200ms ease-out both vt-fade-out;\n}\n\n::view-transition-new(root) {\n  animation: 200ms ease-out both vt-fade-in;\n}\n\n@keyframes vt-fade-out {\n  from { opacity: 1; }\n  to { opacity: 0; }\n}\n\n@keyframes vt-fade-in {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n/* Disable view transitions when user prefers reduced motion */\n@media (prefers-reduced-motion: reduce) {\n  @view-transition {\n    navigation: none;\n  }\n}\n\n/* Custom scrollbar */\n::-webkit-scrollbar {\n  width: 8px;\n}\n\n::-webkit-scrollbar-track {\n  @apply bg-stone-100;\n}\n\n::-webkit-scrollbar-thumb {\n  @apply bg-stone-300 rounded-full;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  @apply bg-stone-400;\n}\n\n@media (prefers-color-scheme: dark) {\n  ::-webkit-scrollbar-track {\n    background-color: #1c1917;\n  }\n  ::-webkit-scrollbar-thumb {\n    background-color: #57534e;\n  }\n  ::-webkit-scrollbar-thumb:hover {\n    background-color: #78716c;\n  }\n}\n","structuredPatch":[{"oldStart":657,"oldLines":6,"newStart":657,"newLines":79,"lines":["   }"," }"," ","+/* ============================================================","+   Native Popover + CSS Anchor Positioning (US-144)","+   Uses HTML popover attribute for keyboard/focus management","+   and CSS anchor-name / position-anchor for tethering.","+   @supports fallback for browsers without anchor positioning.","+   Chrome 125+, Edge 125+. Safari/Firefox: absolute fallback.","+   ============================================================ */","+.info-popover-anchor {","+  position: relative;","+  display: inline-flex;","+}","+","+.info-popover-trigger {","+  all: unset;","+  display: inline-flex;","+  cursor: pointer;","+}","+","+.info-popover {","+  margin: 0;","+  border: 1px solid var(--color-stone-200, #e7e5e4);","+  border-radius: 0.75rem;","+  padding: 0.5rem 0.75rem;","+  background: white;","+  color: var(--color-stone-700, #44403c);","+  font-size: 0.8125rem;","+  line-height: 1.4;","+  max-width: 15rem;","+  box-shadow: 0 4px 12px rgb(0 0 0 / 0.08);","+  /* Entry animation */","+  opacity: 1;","+  transition: opacity 0.15s ease-out, transform 0.15s ease-out;","+}","+","+.info-popover:not(:popover-open) {","+  display: none;","+}","+","+/* Anchor positioning (Chrome 125+) */","+@supports (position-anchor: --x) {","+  .info-popover {","+    position: fixed;","+    position-area: block-end span-inline-end;","+    margin-top: 0.375rem;","+  }","+}","+","+/* Fallback for browsers without anchor positioning */","+@supports not (position-anchor: --x) {","+  .info-popover {","+    position: absolute;","+    top: calc(100% + 0.375rem);","+    left: 50%;","+    transform: translateX(-50%);","+  }","+}","+","+@media (prefers-color-scheme: dark) {","+  .info-popover {","+    background: var(--color-stone-800, #292524);","+    color: var(--color-stone-200, #e7e5e4);","+    border-color: var(--color-stone-700, #44403c);","+    box-shadow: 0 4px 12px rgb(0 0 0 / 0.3);","+  }","+}","+","+/* Forced colors: ensure popover border is visible */","+@media (forced-colors: active) {","+  .info-popover {","+    border: 2px solid CanvasText;","+  }","+}","+"," /* Custom scrollbar */"," ::-webkit-scrollbar {","   width: 8px;"]}],"userModified":false,"replaceAll":false}}
