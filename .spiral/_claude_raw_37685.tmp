{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KPYWeNC2JvzxEmFLX3nd4P","type":"tool_result","content":"1\timport type { Metadata } from \"next\";\n2\timport Header from \"@/components/Header\";\n3\timport Footer from \"@/components/Footer\";\n4\timport BlogFilter from \"@/components/BlogFilter\";\n5\timport NewsletterSignupForm from \"@/components/NewsletterSignupForm\";\n6\timport { blogPosts } from \"@/data/blog/posts\";\n7\texport const metadata: Metadata = {\n8\t  title: \"JB Travel Blog | Tips & Guides for Backpackers\",\n9\t  description:\n10\t    \"Backpacker guides, food tips, day trip ideas, and local secrets for Johor Bahru. Written by the team at Pelangi Capsule Hostel.\",\n11\t  alternates: {\n12\t    canonical: \"https://pelangicapsulehostel.com/blog\",\n13\t  },\n14\t  openGraph: {\n15\t    title: \"JB Travel Blog | Tips & Guides for Backpackers\",\n16\t    description:\n17\t      \"Backpacker guides, food tips, day trip ideas, and local secrets for Johor Bahru.\",\n18\t    url: \"https://pelangicapsulehostel.com/blog\",\n19\t    siteName: \"Pelangi Capsule Hostel\",\n20\t    locale: \"en_MY\",\n21\t    type: \"website\",\n22\t    images: [\n23\t      {\n24\t        url: \"/images/og-image.png\",\n25\t        width: 1200,\n26\t        height: 630,\n27\t        alt: \"Pelangi Capsule Hostel JB Travel Blog\",\n28\t      },\n29\t    ],\n30\t  },\n31\t};\n32\t\n33\t// Sort posts newest-first\n34\tconst sortedPosts = [...blogPosts].sort(\n35\t  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()\n36\t);\n37\t\n38\tconst blogBreadcrumbSchema = {\n39\t  \"@context\": \"https://schema.org\",\n40\t  \"@type\": \"BreadcrumbList\",\n41\t  itemListElement: [\n42\t    {\n43\t      \"@type\": \"ListItem\",\n44\t      position: 1,\n45\t      name: \"Home\",\n46\t      item: \"https://pelangicapsulehostel.com\",\n47\t    },\n48\t    {\n49\t      \"@type\": \"ListItem\",\n50\t      position: 2,\n51\t      name: \"Blog\",\n52\t      item: \"https://pelangicapsulehostel.com/blog\",\n53\t    },\n54\t  ],\n55\t};\n56\t\n57\texport default function BlogPage() {\n58\t  return (\n59\t    <main id=\"main-content\" className=\"min-h-screen bg-stone-50 dark:bg-stone-950\">\n60\t      <script\n61\t        type=\"application/ld+json\"\n62\t        dangerouslySetInnerHTML={{ __html: JSON.stringify(blogBreadcrumbSchema) }}\n63\t      />\n64\t      <Header />\n65\t\n66\t      <div className=\"pt-28 pb-16 container-custom\">\n67\t        <div className=\"max-w-5xl mx-auto\">\n68\t          {/* Page header */}\n69\t          <div className=\"text-center mb-10\">\n70\t            <span className=\"inline-block px-4 py-1.5 text-sm font-medium rounded-full bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300 mb-4\">\n71\t              JB Travel Blog\n72\t            </span>\n73\t            <h1 className=\"font-display text-4xl md:text-5xl font-medium mb-4 text-stone-900 dark:text-stone-100\">\n74\t              Guides & Tips for Backpackers\n75\t            </h1>\n76\t            <p className=\"text-xl text-stone-600 dark:text-stone-400 max-w-2xl mx-auto\">\n77\t              Local knowledge from our team in Taman Pelangi — food, day trips,\n78\t              budget hacks, and everything in between.\n79\t            </p>\n80\t          </div>\n81\t\n82\t          {/* Category filter + blog grid (client component) */}\n83\t          <BlogFilter posts={sortedPosts} />\n84\t\n85\t          {/* Newsletter signup */}\n86\t          <NewsletterSignupForm />\n87\t        </div>\n88\t      </div>\n89\t\n90\t      <Footer />\n91\t    </main>\n92\t  );\n93\t}\n94\t"}]},"parent_tool_use_id":null,"session_id":"48cd3948-144c-45c7-ae83-7eda8bdfa883","uuid":"0bcbf939-867d-4cb2-8a9e-df1e94dcec5d","timestamp":"2026-04-14T05:15:17.482Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\app\\blog\\page.tsx","content":"import type { Metadata } from \"next\";\nimport Header from \"@/components/Header\";\nimport Footer from \"@/components/Footer\";\nimport BlogFilter from \"@/components/BlogFilter\";\nimport NewsletterSignupForm from \"@/components/NewsletterSignupForm\";\nimport { blogPosts } from \"@/data/blog/posts\";\nexport const metadata: Metadata = {\n  title: \"JB Travel Blog | Tips & Guides for Backpackers\",\n  description:\n    \"Backpacker guides, food tips, day trip ideas, and local secrets for Johor Bahru. Written by the team at Pelangi Capsule Hostel.\",\n  alternates: {\n    canonical: \"https://pelangicapsulehostel.com/blog\",\n  },\n  openGraph: {\n    title: \"JB Travel Blog | Tips & Guides for Backpackers\",\n    description:\n      \"Backpacker guides, food tips, day trip ideas, and local secrets for Johor Bahru.\",\n    url: \"https://pelangicapsulehostel.com/blog\",\n    siteName: \"Pelangi Capsule Hostel\",\n    locale: \"en_MY\",\n    type: \"website\",\n    images: [\n      {\n        url: \"/images/og-image.png\",\n        width: 1200,\n        height: 630,\n        alt: \"Pelangi Capsule Hostel JB Travel Blog\",\n      },\n    ],\n  },\n};\n\n// Sort posts newest-first\nconst sortedPosts = [...blogPosts].sort(\n  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()\n);\n\nconst blogBreadcrumbSchema = {\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"BreadcrumbList\",\n  itemListElement: [\n    {\n      \"@type\": \"ListItem\",\n      position: 1,\n      name: \"Home\",\n      item: \"https://pelangicapsulehostel.com\",\n    },\n    {\n      \"@type\": \"ListItem\",\n      position: 2,\n      name: \"Blog\",\n      item: \"https://pelangicapsulehostel.com/blog\",\n    },\n  ],\n};\n\nexport default function BlogPage() {\n  return (\n    <main id=\"main-content\" className=\"min-h-screen bg-stone-50 dark:bg-stone-950\">\n      <script\n        type=\"application/ld+json\"\n        dangerouslySetInnerHTML={{ __html: JSON.stringify(blogBreadcrumbSchema) }}\n      />\n      <Header />\n\n      <div className=\"pt-28 pb-16 container-custom\">\n        <div className=\"max-w-5xl mx-auto\">\n          {/* Page header */}\n          <div className=\"text-center mb-10\">\n            <span className=\"inline-block px-4 py-1.5 text-sm font-medium rounded-full bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300 mb-4\">\n              JB Travel Blog\n            </span>\n            <h1 className=\"font-display text-4xl md:text-5xl font-medium mb-4 text-stone-900 dark:text-stone-100\">\n              Guides & Tips for Backpackers\n            </h1>\n            <p className=\"text-xl text-stone-600 dark:text-stone-400 max-w-2xl mx-auto\">\n              Local knowledge from our team in Taman Pelangi — food, day trips,\n              budget hacks, and everything in between.\n            </p>\n          </div>\n\n          {/* Category filter + blog grid (client component) */}\n          <BlogFilter posts={sortedPosts} />\n\n          {/* Newsletter signup */}\n          <NewsletterSignupForm />\n        </div>\n      </div>\n\n      <Footer />\n    </main>\n  );\n}\n","numLines":94,"startLine":1,"totalLines":94}}}
