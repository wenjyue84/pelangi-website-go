{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Hg7WFamKNRbvjSMvEJMHAB","type":"tool_result","content":"1\timport { blogPosts } from \"@/data/blog/posts\";\n2\t\n3\texport async function GET() {\n4\t  const baseUrl = \"https://pelangicapsulehostel.com\";\n5\t\n6\t  const sortedPosts = [...blogPosts].sort(\n7\t    (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()\n8\t  );\n9\t\n10\t  const feed = {\n11\t    version: \"https://jsonfeed.org/version/1.1\",\n12\t    title: \"Pelangi Capsule Hostel Blog\",\n13\t    home_page_url: baseUrl,\n14\t    feed_url: `${baseUrl}/feed.json`,\n15\t    description:\n16\t      \"Travel tips, guides, and stories for budget backpackers visiting Johor Bahru and Singapore\",\n17\t    language: \"en\",\n18\t    authors: [\n19\t      {\n20\t        name: \"Pelangi Team\",\n21\t        url: baseUrl,\n22\t      },\n23\t    ],\n24\t    items: sortedPosts.map((post) => ({\n25\t      id: `${baseUrl}/blog/${post.slug}`,\n26\t      url: `${baseUrl}/blog/${post.slug}`,\n27\t      title: post.title,\n28\t      content_html: post.content,\n29\t      summary: post.excerpt,\n30\t      date_published: new Date(post.date).toISOString(),\n31\t      authors: [{ name: post.author }],\n32\t      tags: post.tags,\n33\t      language: \"en\",\n34\t      image: post.featuredImage.startsWith(\"http\")\n35\t        ? post.featuredImage\n36\t        : `${baseUrl}${post.featuredImage}`,\n37\t    })),\n38\t  };\n39\t\n40\t  return new Response(JSON.stringify(feed, null, 2), {\n41\t    headers: {\n42\t      \"Content-Type\": \"application/feed+json; charset=utf-8\",\n43\t      \"Cache-Control\": \"public, s-maxage=3600, stale-while-revalidate=86400\",\n44\t    },\n45\t  });\n46\t}\n47\t"}]},"parent_tool_use_id":null,"session_id":"48cd3948-144c-45c7-ae83-7eda8bdfa883","uuid":"8267cb9f-c02f-48f8-b4c2-92be557f0ed6","timestamp":"2026-04-14T05:15:22.774Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\app\\feed.json\\route.ts","content":"import { blogPosts } from \"@/data/blog/posts\";\n\nexport async function GET() {\n  const baseUrl = \"https://pelangicapsulehostel.com\";\n\n  const sortedPosts = [...blogPosts].sort(\n    (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()\n  );\n\n  const feed = {\n    version: \"https://jsonfeed.org/version/1.1\",\n    title: \"Pelangi Capsule Hostel Blog\",\n    home_page_url: baseUrl,\n    feed_url: `${baseUrl}/feed.json`,\n    description:\n      \"Travel tips, guides, and stories for budget backpackers visiting Johor Bahru and Singapore\",\n    language: \"en\",\n    authors: [\n      {\n        name: \"Pelangi Team\",\n        url: baseUrl,\n      },\n    ],\n    items: sortedPosts.map((post) => ({\n      id: `${baseUrl}/blog/${post.slug}`,\n      url: `${baseUrl}/blog/${post.slug}`,\n      title: post.title,\n      content_html: post.content,\n      summary: post.excerpt,\n      date_published: new Date(post.date).toISOString(),\n      authors: [{ name: post.author }],\n      tags: post.tags,\n      language: \"en\",\n      image: post.featuredImage.startsWith(\"http\")\n        ? post.featuredImage\n        : `${baseUrl}${post.featuredImage}`,\n    })),\n  };\n\n  return new Response(JSON.stringify(feed, null, 2), {\n    headers: {\n      \"Content-Type\": \"application/feed+json; charset=utf-8\",\n      \"Cache-Control\": \"public, s-maxage=3600, stale-while-revalidate=86400\",\n    },\n  });\n}\n","numLines":47,"startLine":1,"totalLines":47}}}
