{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ma6w9R2yyNq9kyxUFum45t","type":"tool_result","content":"1\t/**\n2\t * instrumentation-client.ts\n3\t *\n4\t * Next.js 15.3+ client instrumentation hook — runs once before React hydration.\n5\t * Centralises Sentry, web-vitals, and Clarity initialisation so that errors\n6\t * and metrics captured during the earliest lifecycle are never missed.\n7\t *\n8\t * IMPORTANT: No React / JSX imports — this file executes before the framework.\n9\t */\n10\t\n11\timport * as Sentry from \"@sentry/nextjs\";\n12\timport { onINP, onLCP, onCLS } from \"web-vitals/attribution\";\n13\t\n14\t// ---------------------------------------------------------------------------\n15\t// 1. Sentry — error monitoring (replaces sentry.client.config.ts)\n16\t// ---------------------------------------------------------------------------\n17\tSentry.init({\n18\t  dsn: process.env.NEXT_PUBLIC_SENTRY_DSN,\n19\t\n20\t  // Capture 10 % of transactions for performance monitoring in production\n21\t  tracesSampleRate: process.env.NODE_ENV === \"production\" ? 0.1 : 1.0,\n22\t\n23\t  // Replay 10 % of sessions, 100 % of sessions with errors\n24\t  replaysSessionSampleRate: 0.1,\n25\t  replaysOnErrorSampleRate: 1.0,\n26\t\n27\t  // Filter known non-actionable browser errors\n28\t  ignoreErrors: [\n29\t    \"ResizeObserver loop limit exceeded\",\n30\t    \"ResizeObserver loop completed with undelivered notifications\",\n31\t    \"Network request failed\",\n32\t    \"Failed to fetch\",\n33\t    \"Load failed\",\n34\t    \"AbortError\",\n35\t  ],\n36\t\n37\t  debug: false,\n38\t});\n39\t\n40\t// ---------------------------------------------------------------------------\n41\t// 2. Web Vitals — INP, LCP, CLS → GA4 via gtag / dataLayer\n42\t// ---------------------------------------------------------------------------\n43\tinterface WindowWithGtag {\n44\t  dataLayer: unknown[];\n45\t  gtag?: (...args: unknown[]) => void;\n46\t}\n47\t\n48\tfunction sendToGA(eventParams: Record<string, string | number>) {\n49\t  const w = window as unknown as WindowWithGtag;\n50\t  w.dataLayer = w.dataLayer || [];\n51\t  if (typeof w.gtag !== \"function\") {\n52\t    w.gtag = (...args: unknown[]) => {\n53\t      w.dataLayer.push(args);\n54\t    };\n55\t  }\n56\t  w.gtag!(\"event\", \"web_vitals\", eventParams);\n57\t}\n58\t\n59\tonINP((metric) => {\n60\t  const attr = metric.attribution;\n61\t  sendToGA({\n62\t    metric_name: \"INP\",\n63\t    metric_value: metric.value,\n64\t    metric_id: metric.id,\n65\t    input_delay: attr.inputDelay ?? 0,\n66\t    processing_time: attr.processingDuration ?? 0,\n67\t    presentation_delay: attr.presentationDelay ?? 0,\n68\t    interaction_target: attr.interactionTarget ?? \"\",\n69\t  });\n70\t});\n71\t\n72\tonLCP((metric) => {\n73\t  sendToGA({\n74\t    metric_name: \"LCP\",\n75\t    metric_value: metric.value,\n76\t    metric_id: metric.id,\n77\t  });\n78\t});\n79\t\n80\tonCLS((metric) => {\n81\t  sendToGA({\n82\t    metric_name: \"CLS\",\n83\t    metric_value: metric.value,\n84\t    metric_id: metric.id,\n85\t  });\n86\t});\n87\t\n88\t// ---------------------------------------------------------------------------\n89\t// 3. Microsoft Clarity — consent-gated heatmap / session recording\n90\t// ---------------------------------------------------------------------------\n91\tconst CLARITY_ID = process.env.NEXT_PUBLIC_CLARITY_PROJECT_ID ?? \"\";\n92\t\n93\tfunction initClarity() {\n94\t  if (\n95\t    !CLARITY_ID ||\n96\t    (window as unknown as Record<string, boolean>).__clarityInit\n97\t  )\n98\t    return;\n99\t  (window as unknown as Record<string, boolean>).__clarityInit = true;\n100\t\n101\t  /* eslint-disable @typescript-eslint/no-explicit-any */\n102\t  (function (c: any, l: any, a: string, r: string, i: string) {\n103\t    c[a] =\n104\t      c[a] ||\n105\t      function () {\n106\t        (c[a].q = c[a].q || []).push(arguments);\n107\t      };\n108\t    const t = l.createElement(r);\n109\t    t.async = 1;\n110\t    t.src = \"https://www.clarity.ms/tag/\" + i;\n111\t    const y = l.getElementsByTagName(r)[0];\n112\t    y.parentNode.insertBefore(t, y);\n113\t  })(window, document, \"clarity\", \"script\", CLARITY_ID);\n114\t  /* eslint-enable @typescript-eslint/no-explicit-any */\n115\t}\n116\t\n117\tfunction hasConsent(): boolean {\n118\t  const match = document.cookie.match(\n119\t    /(?:^|; )pelangi_cookie_consent=([^;]*)/\n120\t  );\n121\t  return match?.[1] === \"accepted\";\n122\t}\n123\t\n124\t// Initialise immediately if consent was already granted in a previous session\n125\tif (hasConsent()) {\n126\t  initClarity();\n127\t}\n128\t\n129\t// Listen for future consent changes (dispatched by <CookieConsent /> component)\n130\twindow.addEventListener(\"cookie-consent\", (e: Event) => {\n131\t  const detail = (e as CustomEvent<{ consent: string }>).detail;\n132\t  if (detail.consent === \"accepted\") {\n133\t    initClarity();\n134\t  }\n135\t});\n136\t\n137\t// ---------------------------------------------------------------------------\n138\t// 4. Long Animation Frames (LoAF) — INP diagnosis (US-198)\n139\t// ---------------------------------------------------------------------------\n140\t// Captures frames >= 100 ms and reports script attribution to GA4 + Sentry.\n141\t// Chrome 123+; silently skipped in unsupporting browsers.\n142\t// Threshold: 100 ms per acceptance criteria (spec default is 50 ms).\n143\t// ---------------------------------------------------------------------------\n144\t\n145\t// TypeScript types for LoAF API (not yet in lib.dom.d.ts as of TS 5.7)\n146\tinterface PerformanceScriptTiming {\n147\t  startTime: number;\n148\t  duration: number;\n149\t  invoker: string;\n150\t  invokerType: string;\n151\t  pauseDuration: number;\n152\t  sourceURL: string;\n153\t  sourceFunctionName: string;\n154\t  sourceCharPosition: number;\n155\t}\n156\t\n157\tinterface PerformanceLongAnimationFrameTiming extends PerformanceEntry {\n158\t  renderStart: number;\n159\t  styleAndLayoutStart: number;\n160\t  firstUIEventTimestamp: number;\n161\t  blockingDuration: number;\n162\t  scripts: PerformanceScriptTiming[];\n163\t}\n164\t\n165\tconst LOAF_THRESHOLD_MS = 100;\n166\t\n167\tif (\n168\t  typeof PerformanceObserver !== \"undefined\" &&\n169\t  PerformanceObserver.supportedEntryTypes?.includes(\"long-animation-frame\")\n170\t) {\n171\t  const loafObserver = new PerformanceObserver((list) => {\n172\t    for (const entry of list.getEntries()) {\n173\t      const loaf = entry as PerformanceLongAnimationFrameTiming;\n174\t      if (loaf.duration < LOAF_THRESHOLD_MS) continue;\n175\t\n176\t      // Find the longest-running script for attribution\n177\t      const topScript = loaf.scripts.reduce<PerformanceScriptTiming | null>(\n178\t        (worst, s) => (worst === null || s.duration > worst.duration ? s : worst),\n179\t        null\n180\t      );\n181\t\n182\t      const payload: Record<string, string | number> = {\n183\t        loaf_duration: Math.round(loaf.duration),\n184\t        loaf_blocking_duration: Math.round(loaf.blockingDuration),\n185\t        loaf_render_start: Math.round(loaf.renderStart),\n186\t        loaf_script_count: loaf.scripts.length,\n187\t        loaf_top_script_invoker: topScript?.invoker ?? \"\",\n188\t        loaf_top_script_invoker_type: topScript?.invokerType ?? \"\",\n189\t        loaf_top_script_duration: topScript ? Math.round(topScript.duration) : 0,\n190\t        loaf_top_script_source: topScript?.sourceURL ?? \"\",\n191\t      };\n192\t\n193\t      // Send to GA4 for dashboard tracking\n194\t      sendToGA({ metric_name: \"LoAF\", ...payload });\n195\t\n196\t      // Send to Sentry as a breadcrumb for error correlation\n197\t      Sentry.addBreadcrumb({\n198\t        category: \"performance\",\n199\t        message: `LoAF ${Math.round(loaf.duration)}ms — ${topScript?.invoker ?? \"unknown\"}`,\n200\t        level: loaf.duration >= 200 ? \"warning\" : \"info\",\n201\t        data: payload as Record<string, unknown>,\n202\t      });\n203\t    }\n204\t  });\n205\t\n206\t  loafObserver.observe({ type: \"long-animation-frame\", buffered: true });\n207\t}\n208\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"e6e4fba7-5ce6-4787-94af-0cd5cb35d7c6","uuid":"6cd05847-ee37-45ba-a53f-5667518d2b32","timestamp":"2026-04-14T08:40:46.812Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\instrumentation-client.ts","content":"/**\n * instrumentation-client.ts\n *\n * Next.js 15.3+ client instrumentation hook — runs once before React hydration.\n * Centralises Sentry, web-vitals, and Clarity initialisation so that errors\n * and metrics captured during the earliest lifecycle are never missed.\n *\n * IMPORTANT: No React / JSX imports — this file executes before the framework.\n */\n\nimport * as Sentry from \"@sentry/nextjs\";\nimport { onINP, onLCP, onCLS } from \"web-vitals/attribution\";\n\n// ---------------------------------------------------------------------------\n// 1. Sentry — error monitoring (replaces sentry.client.config.ts)\n// ---------------------------------------------------------------------------\nSentry.init({\n  dsn: process.env.NEXT_PUBLIC_SENTRY_DSN,\n\n  // Capture 10 % of transactions for performance monitoring in production\n  tracesSampleRate: process.env.NODE_ENV === \"production\" ? 0.1 : 1.0,\n\n  // Replay 10 % of sessions, 100 % of sessions with errors\n  replaysSessionSampleRate: 0.1,\n  replaysOnErrorSampleRate: 1.0,\n\n  // Filter known non-actionable browser errors\n  ignoreErrors: [\n    \"ResizeObserver loop limit exceeded\",\n    \"ResizeObserver loop completed with undelivered notifications\",\n    \"Network request failed\",\n    \"Failed to fetch\",\n    \"Load failed\",\n    \"AbortError\",\n  ],\n\n  debug: false,\n});\n\n// ---------------------------------------------------------------------------\n// 2. Web Vitals — INP, LCP, CLS → GA4 via gtag / dataLayer\n// ---------------------------------------------------------------------------\ninterface WindowWithGtag {\n  dataLayer: unknown[];\n  gtag?: (...args: unknown[]) => void;\n}\n\nfunction sendToGA(eventParams: Record<string, string | number>) {\n  const w = window as unknown as WindowWithGtag;\n  w.dataLayer = w.dataLayer || [];\n  if (typeof w.gtag !== \"function\") {\n    w.gtag = (...args: unknown[]) => {\n      w.dataLayer.push(args);\n    };\n  }\n  w.gtag!(\"event\", \"web_vitals\", eventParams);\n}\n\nonINP((metric) => {\n  const attr = metric.attribution;\n  sendToGA({\n    metric_name: \"INP\",\n    metric_value: metric.value,\n    metric_id: metric.id,\n    input_delay: attr.inputDelay ?? 0,\n    processing_time: attr.processingDuration ?? 0,\n    presentation_delay: attr.presentationDelay ?? 0,\n    interaction_target: attr.interactionTarget ?? \"\",\n  });\n});\n\nonLCP((metric) => {\n  sendToGA({\n    metric_name: \"LCP\",\n    metric_value: metric.value,\n    metric_id: metric.id,\n  });\n});\n\nonCLS((metric) => {\n  sendToGA({\n    metric_name: \"CLS\",\n    metric_value: metric.value,\n    metric_id: metric.id,\n  });\n});\n\n// ---------------------------------------------------------------------------\n// 3. Microsoft Clarity — consent-gated heatmap / session recording\n// ---------------------------------------------------------------------------\nconst CLARITY_ID = process.env.NEXT_PUBLIC_CLARITY_PROJECT_ID ?? \"\";\n\nfunction initClarity() {\n  if (\n    !CLARITY_ID ||\n    (window as unknown as Record<string, boolean>).__clarityInit\n  )\n    return;\n  (window as unknown as Record<string, boolean>).__clarityInit = true;\n\n  /* eslint-disable @typescript-eslint/no-explicit-any */\n  (function (c: any, l: any, a: string, r: string, i: string) {\n    c[a] =\n      c[a] ||\n      function () {\n        (c[a].q = c[a].q || []).push(arguments);\n      };\n    const t = l.createElement(r);\n    t.async = 1;\n    t.src = \"https://www.clarity.ms/tag/\" + i;\n    const y = l.getElementsByTagName(r)[0];\n    y.parentNode.insertBefore(t, y);\n  })(window, document, \"clarity\", \"script\", CLARITY_ID);\n  /* eslint-enable @typescript-eslint/no-explicit-any */\n}\n\nfunction hasConsent(): boolean {\n  const match = document.cookie.match(\n    /(?:^|; )pelangi_cookie_consent=([^;]*)/\n  );\n  return match?.[1] === \"accepted\";\n}\n\n// Initialise immediately if consent was already granted in a previous session\nif (hasConsent()) {\n  initClarity();\n}\n\n// Listen for future consent changes (dispatched by <CookieConsent /> component)\nwindow.addEventListener(\"cookie-consent\", (e: Event) => {\n  const detail = (e as CustomEvent<{ consent: string }>).detail;\n  if (detail.consent === \"accepted\") {\n    initClarity();\n  }\n});\n\n// ---------------------------------------------------------------------------\n// 4. Long Animation Frames (LoAF) — INP diagnosis (US-198)\n// ---------------------------------------------------------------------------\n// Captures frames >= 100 ms and reports script attribution to GA4 + Sentry.\n// Chrome 123+; silently skipped in unsupporting browsers.\n// Threshold: 100 ms per acceptance criteria (spec default is 50 ms).\n// ---------------------------------------------------------------------------\n\n// TypeScript types for LoAF API (not yet in lib.dom.d.ts as of TS 5.7)\ninterface PerformanceScriptTiming {\n  startTime: number;\n  duration: number;\n  invoker: string;\n  invokerType: string;\n  pauseDuration: number;\n  sourceURL: string;\n  sourceFunctionName: string;\n  sourceCharPosition: number;\n}\n\ninterface PerformanceLongAnimationFrameTiming extends PerformanceEntry {\n  renderStart: number;\n  styleAndLayoutStart: number;\n  firstUIEventTimestamp: number;\n  blockingDuration: number;\n  scripts: PerformanceScriptTiming[];\n}\n\nconst LOAF_THRESHOLD_MS = 100;\n\nif (\n  typeof PerformanceObserver !== \"undefined\" &&\n  PerformanceObserver.supportedEntryTypes?.includes(\"long-animation-frame\")\n) {\n  const loafObserver = new PerformanceObserver((list) => {\n    for (const entry of list.getEntries()) {\n      const loaf = entry as PerformanceLongAnimationFrameTiming;\n      if (loaf.duration < LOAF_THRESHOLD_MS) continue;\n\n      // Find the longest-running script for attribution\n      const topScript = loaf.scripts.reduce<PerformanceScriptTiming | null>(\n        (worst, s) => (worst === null || s.duration > worst.duration ? s : worst),\n        null\n      );\n\n      const payload: Record<string, string | number> = {\n        loaf_duration: Math.round(loaf.duration),\n        loaf_blocking_duration: Math.round(loaf.blockingDuration),\n        loaf_render_start: Math.round(loaf.renderStart),\n        loaf_script_count: loaf.scripts.length,\n        loaf_top_script_invoker: topScript?.invoker ?? \"\",\n        loaf_top_script_invoker_type: topScript?.invokerType ?? \"\",\n        loaf_top_script_duration: topScript ? Math.round(topScript.duration) : 0,\n        loaf_top_script_source: topScript?.sourceURL ?? \"\",\n      };\n\n      // Send to GA4 for dashboard tracking\n      sendToGA({ metric_name: \"LoAF\", ...payload });\n\n      // Send to Sentry as a breadcrumb for error correlation\n      Sentry.addBreadcrumb({\n        category: \"performance\",\n        message: `LoAF ${Math.round(loaf.duration)}ms — ${topScript?.invoker ?? \"unknown\"}`,\n        level: loaf.duration >= 200 ? \"warning\" : \"info\",\n        data: payload as Record<string, unknown>,\n      });\n    }\n  });\n\n  loafObserver.observe({ type: \"long-animation-frame\", buffered: true });\n}\n","numLines":208,"startLine":1,"totalLines":208}}}
