{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VCjFK5iwACroKjFhB8UcaA","type":"tool_result","content":"The file C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\components\\AnalyticsProvider.tsx has been updated successfully."}]},"parent_tool_use_id":null,"session_id":"e6e4fba7-5ce6-4787-94af-0cd5cb35d7c6","uuid":"f10a62dd-4e02-4e2e-85f1-9e54e0aaa1ed","timestamp":"2026-04-14T08:42:44.366Z","tool_use_result":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\components\\AnalyticsProvider.tsx","oldString":"      <Script\n        id=\"_next-ga\"\n        strategy=\"lazyOnload\"\n        src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}\n      />","newString":"      <Script\n        id=\"_next-ga\"\n        strategy=\"lazyOnload\"\n        src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}\n        integrity=\"sha384-VgHGdVW55pNfDcu5KaOcZlNPywG7c5uPZKlJmojJOZ4PYYzq02zAspkU6MVejDTo\"\n        crossOrigin=\"anonymous\"\n      />","originalFile":"\"use client\";\n\nimport { useState, useEffect } from \"react\";\nimport Script from \"next/script\";\n\nconst COOKIE_NAME = \"pelangi_cookie_consent\";\nconst GA_ID = process.env.NEXT_PUBLIC_GA_MEASUREMENT_ID ?? \"\";\n\nfunction readConsentCookie(): boolean {\n  if (typeof document === \"undefined\") return false;\n  const match = document.cookie.match(\n    new RegExp(`(?:^|; )${COOKIE_NAME}=([^;]*)`)\n  );\n  return match?.[1] === \"accepted\";\n}\n\nexport default function AnalyticsProvider() {\n  const [consented, setConsented] = useState(false);\n\n  useEffect(() => {\n    // Pick up consent already stored from a previous visit\n    setConsented(readConsentCookie()); // eslint-disable-line react-hooks/set-state-in-effect -- reads browser cookie on mount\n\n    function handleConsent(e: Event) {\n      const value = (e as CustomEvent<{ consent: string }>).detail.consent;\n      setConsented(value === \"accepted\");\n    }\n\n    window.addEventListener(\"cookie-consent\", handleConsent);\n    return () => window.removeEventListener(\"cookie-consent\", handleConsent);\n  }, []);\n\n  if (!consented || !GA_ID) return null;\n\n  return (\n    <>\n      <Script\n        id=\"_next-ga-init\"\n        strategy=\"lazyOnload\"\n        dangerouslySetInnerHTML={{\n          __html: `\n            window.dataLayer = window.dataLayer || [];\n            function gtag(){window.dataLayer.push(arguments);}\n            gtag('js', new Date());\n            gtag('config', '${GA_ID}');`,\n        }}\n      />\n      <Script\n        id=\"_next-ga\"\n        strategy=\"lazyOnload\"\n        src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}\n      />\n    </>\n  );\n}\n","structuredPatch":[{"oldStart":49,"oldLines":6,"newStart":49,"newLines":8,"lines":["         id=\"_next-ga\"","         strategy=\"lazyOnload\"","         src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}","+        integrity=\"sha384-VgHGdVW55pNfDcu5KaOcZlNPywG7c5uPZKlJmojJOZ4PYYzq02zAspkU6MVejDTo\"","+        crossOrigin=\"anonymous\"","       />","     </>","   );"]}],"userModified":false,"replaceAll":false}}
