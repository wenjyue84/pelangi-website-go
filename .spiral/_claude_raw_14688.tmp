{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BLz45tzGBABLqSWWcs8U66","type":"tool_result","content":"1\t\"use client\";\n2\t\n3\timport { useState, useEffect } from \"react\";\n4\timport Script from \"next/script\";\n5\t\n6\tconst PIXEL_ID = process.env.NEXT_PUBLIC_FACEBOOK_PIXEL_ID ?? \"\";\n7\tconst COOKIE_NAME = \"pelangi_cookie_consent\";\n8\t\n9\tfunction readConsentCookie(): boolean {\n10\t  if (typeof document === \"undefined\") return false;\n11\t  const match = document.cookie.match(\n12\t    new RegExp(`(?:^|; )${COOKIE_NAME}=([^;]*)`)\n13\t  );\n14\t  return match?.[1] === \"accepted\";\n15\t}\n16\t\n17\texport default function MetaPixelProvider() {\n18\t  const [consented, setConsented] = useState(false);\n19\t\n20\t  useEffect(() => {\n21\t    // eslint-disable-next-line react-hooks/set-state-in-effect -- reading browser cookie on mount (SSR-safe)\n22\t    setConsented(readConsentCookie());\n23\t\n24\t    function handleConsent(e: Event) {\n25\t      const value = (e as CustomEvent<{ consent: string }>).detail.consent;\n26\t      setConsented(value === \"accepted\");\n27\t    }\n28\t\n29\t    window.addEventListener(\"cookie-consent\", handleConsent);\n30\t    return () => window.removeEventListener(\"cookie-consent\", handleConsent);\n31\t  }, []);\n32\t\n33\t  if (!consented || !PIXEL_ID) return null;\n34\t\n35\t  return (\n36\t    <>\n37\t      <Script\n38\t        id=\"meta-pixel-init\"\n39\t        strategy=\"lazyOnload\"\n40\t        dangerouslySetInnerHTML={{\n41\t          __html: `\n42\t            !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?\n43\t            n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;\n44\t            n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;\n45\t            t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}\n46\t            (window,document,'script','https://connect.facebook.net/en_US/fbevents.js');\n47\t            fbq('init', '${PIXEL_ID}');\n48\t            fbq('track', 'PageView');`,\n49\t        }}\n50\t      />\n51\t      <noscript>\n52\t        <img\n53\t          height=\"1\"\n54\t          width=\"1\"\n55\t          style={{ display: \"none\" }}\n56\t          src={`https://www.facebook.com/tr?id=${PIXEL_ID}&ev=PageView&noscript=1`}\n57\t          alt=\"\"\n58\t        />\n59\t      </noscript>\n60\t    </>\n61\t  );\n62\t}\n63\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"e6e4fba7-5ce6-4787-94af-0cd5cb35d7c6","uuid":"67355ed3-693d-429d-b811-741e32ad40a9","timestamp":"2026-04-14T08:40:18.733Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\components\\MetaPixelProvider.tsx","content":"\"use client\";\n\nimport { useState, useEffect } from \"react\";\nimport Script from \"next/script\";\n\nconst PIXEL_ID = process.env.NEXT_PUBLIC_FACEBOOK_PIXEL_ID ?? \"\";\nconst COOKIE_NAME = \"pelangi_cookie_consent\";\n\nfunction readConsentCookie(): boolean {\n  if (typeof document === \"undefined\") return false;\n  const match = document.cookie.match(\n    new RegExp(`(?:^|; )${COOKIE_NAME}=([^;]*)`)\n  );\n  return match?.[1] === \"accepted\";\n}\n\nexport default function MetaPixelProvider() {\n  const [consented, setConsented] = useState(false);\n\n  useEffect(() => {\n    // eslint-disable-next-line react-hooks/set-state-in-effect -- reading browser cookie on mount (SSR-safe)\n    setConsented(readConsentCookie());\n\n    function handleConsent(e: Event) {\n      const value = (e as CustomEvent<{ consent: string }>).detail.consent;\n      setConsented(value === \"accepted\");\n    }\n\n    window.addEventListener(\"cookie-consent\", handleConsent);\n    return () => window.removeEventListener(\"cookie-consent\", handleConsent);\n  }, []);\n\n  if (!consented || !PIXEL_ID) return null;\n\n  return (\n    <>\n      <Script\n        id=\"meta-pixel-init\"\n        strategy=\"lazyOnload\"\n        dangerouslySetInnerHTML={{\n          __html: `\n            !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?\n            n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;\n            n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;\n            t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}\n            (window,document,'script','https://connect.facebook.net/en_US/fbevents.js');\n            fbq('init', '${PIXEL_ID}');\n            fbq('track', 'PageView');`,\n        }}\n      />\n      <noscript>\n        <img\n          height=\"1\"\n          width=\"1\"\n          style={{ display: \"none\" }}\n          src={`https://www.facebook.com/tr?id=${PIXEL_ID}&ev=PageView&noscript=1`}\n          alt=\"\"\n        />\n      </noscript>\n    </>\n  );\n}\n","numLines":63,"startLine":1,"totalLines":63}}}
