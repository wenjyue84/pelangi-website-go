{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015xmahT12N1xMmwnhQnXRLR","type":"tool_result","content":"1\t\"use client\";\n2\t\n3\timport { useState, useEffect } from \"react\";\n4\timport Script from \"next/script\";\n5\t\n6\tconst PIXEL_ID = process.env.NEXT_PUBLIC_TIKTOK_PIXEL_ID ?? \"\";\n7\tconst COOKIE_NAME = \"pelangi_cookie_consent\";\n8\t\n9\tfunction readConsentCookie(): boolean {\n10\t  if (typeof document === \"undefined\") return false;\n11\t  const match = document.cookie.match(\n12\t    new RegExp(`(?:^|; )${COOKIE_NAME}=([^;]*)`)\n13\t  );\n14\t  return match?.[1] === \"accepted\";\n15\t}\n16\t\n17\t/**\n18\t * Generate a unique event ID for deduplication between browser pixel and Events API.\n19\t * Uses crypto.randomUUID when available, falls back to timestamp + random.\n20\t */\n21\tfunction generateEventId(): string {\n22\t  if (typeof crypto !== \"undefined\" && crypto.randomUUID) {\n23\t    return crypto.randomUUID();\n24\t  }\n25\t  return `${Date.now()}-${Math.random().toString(36).slice(2, 11)}`;\n26\t}\n27\t\n28\t/**\n29\t * SHA-256 hash a string value (browser-side, using SubtleCrypto).\n30\t * Returns the hex digest. Used to hash PII before sending to Events API.\n31\t */\n32\tasync function sha256(value: string): Promise<string> {\n33\t  const data = new TextEncoder().encode(value.trim().toLowerCase());\n34\t  const hashBuffer = await crypto.subtle.digest(\"SHA-256\", data);\n35\t  return Array.from(new Uint8Array(hashBuffer))\n36\t    .map((b) => b.toString(16).padStart(2, \"0\"))\n37\t    .join(\"\");\n38\t}\n39\t\n40\t/**\n41\t * Send a server-side TikTok event for dual-signal deduplication.\n42\t */\n43\tasync function sendServerEvent(\n44\t  eventName: string,\n45\t  eventId: string,\n46\t  url: string,\n47\t  userData?: { em?: string; ph?: string }\n48\t): Promise<void> {\n49\t  try {\n50\t    const hashedUser: Record<string, string> = {};\n51\t    if (userData?.em) {\n52\t      hashedUser.em = await sha256(userData.em);\n53\t    }\n54\t    if (userData?.ph) {\n55\t      const digits = userData.ph.replace(/\\D/g, \"\");\n56\t      if (digits.length > 0) {\n57\t        hashedUser.ph = await sha256(digits);\n58\t      }\n59\t    }\n60\t\n61\t    await fetch(\"/api/tiktok-events\", {\n62\t      method: \"POST\",\n63\t      headers: { \"Content-Type\": \"application/json\" },\n64\t      body: JSON.stringify({\n65\t        event: eventName,\n66\t        event_id: eventId,\n67\t        url,\n68\t        user_data: Object.keys(hashedUser).length > 0 ? hashedUser : undefined,\n69\t      }),\n70\t    });\n71\t  } catch {\n72\t    // Silently fail — analytics should never block user experience\n73\t  }\n74\t}\n75\t\n76\t/**\n77\t * TikTok Pixel + Events API dual-signal provider.\n78\t * Loads the TikTok Pixel base code via lazyOnload and fires browser-side events.\n79\t * For server-side deduplication, sends matching events to /api/tiktok-events.\n80\t *\n81\t * Tracked events:\n82\t * - ViewContent: room pages\n83\t * - Contact: contact form submission\n84\t * - Search: blog/guide search\n85\t */\n86\texport default function TikTokPixelProvider() {\n87\t  const [consented, setConsented] = useState(false);\n88\t\n89\t  useEffect(() => {\n90\t    setConsented(readConsentCookie());\n91\t\n92\t    function handleConsent(e: Event) {\n93\t      const value = (e as CustomEvent<{ consent: string }>).detail.consent;\n94\t      setConsented(value === \"accepted\");\n95\t    }\n96\t\n97\t    window.addEventListener(\"cookie-consent\", handleConsent);\n98\t    return () => window.removeEventListener(\"cookie-consent\", handleConsent);\n99\t  }, []);\n100\t\n101\t  // Register global event handler for TikTok tracking events\n102\t  useEffect(() => {\n103\t    if (!consented || !PIXEL_ID) return;\n104\t\n105\t    function handleTikTokEvent(e: Event) {\n106\t      const detail = (e as CustomEvent<{\n107\t        event: string;\n108\t        url?: string;\n109\t        user_data?: { em?: string; ph?: string };\n110\t      }>).detail;\n111\t\n112\t      const eventId = generateEventId();\n113\t      const url = detail.url || window.location.href;\n114\t\n115\t      // Browser-side pixel event\n116\t      if (typeof window !== \"undefined\" && (window as Record<string, unknown>).ttq) {\n117\t        const ttq = (window as Record<string, unknown>).ttq as {\n118\t          track: (event: string, props?: Record<string, unknown>, opts?: Record<string, unknown>) => void;\n119\t        };\n120\t        ttq.track(detail.event, {}, { event_id: eventId });\n121\t      }\n122\t\n123\t      // Server-side Events API (deduplication via matching event_id)\n124\t      sendServerEvent(detail.event, eventId, url, detail.user_data);\n125\t    }\n126\t\n127\t    window.addEventListener(\"tiktok-track\", handleTikTokEvent);\n128\t    return () => window.removeEventListener(\"tiktok-track\", handleTikTokEvent);\n129\t  }, [consented]);\n130\t\n131\t  if (!consented || !PIXEL_ID) return null;\n132\t\n133\t  return (\n134\t    <Script\n135\t      id=\"tiktok-pixel-init\"\n136\t      strategy=\"lazyOnload\"\n137\t      dangerouslySetInnerHTML={{\n138\t        __html: `\n139\t          !function(w,d,t){w.TiktokAnalyticsObject=t;var ttq=w[t]=w[t]||[];\n140\t          ttq.methods=[\"page\",\"track\",\"identify\",\"instances\",\"debug\",\"on\",\"off\",\n141\t          \"once\",\"ready\",\"alias\",\"group\",\"enableCookie\",\"disableCookie\",\"holdConsent\",\n142\t          \"revokeConsent\",\"grantConsent\"],ttq.setAndDefer=function(t,e){t[e]=\n143\t          function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}};\n144\t          for(var i=0;i<ttq.methods.length;i++)ttq.setAndDefer(ttq,ttq.methods[i]);\n145\t          ttq.instance=function(t){for(var e=ttq._i[t]||[],n=0;n<ttq.methods.length;\n146\t          n++)ttq.setAndDefer(e,ttq.methods[n]);return e};ttq.load=function(e,n){\n147\t          var r=\"https://analytics.tiktok.com/i18n/pixel/events.js\",o=n&&n.partner;\n148\t          ttq._i=ttq._i||{},ttq._i[e]=[],ttq._i[e]._u=r,ttq._t=ttq._t||{},\n149\t          ttq._t[e]=+new Date,ttq._o=ttq._o||{},ttq._o[e]=n||{};\n150\t          var a=d.createElement(\"script\");a.type=\"text/javascript\";a.async=!0;\n151\t          a.src=r+\"?sdkid=\"+e+\"&lib=\"+t;var s=d.getElementsByTagName(\"script\")[0];\n152\t          s.parentNode.insertBefore(a,s)};\n153\t          ttq.load('${PIXEL_ID}');\n154\t          ttq.page();\n155\t          }(window,document,'ttq');`,\n156\t      }}\n157\t    />\n158\t  );\n159\t}\n160\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"e6e4fba7-5ce6-4787-94af-0cd5cb35d7c6","uuid":"c75d4a6e-7255-48f2-97ce-63e934f9760c","timestamp":"2026-04-14T08:40:18.901Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\components\\TikTokPixelProvider.tsx","content":"\"use client\";\n\nimport { useState, useEffect } from \"react\";\nimport Script from \"next/script\";\n\nconst PIXEL_ID = process.env.NEXT_PUBLIC_TIKTOK_PIXEL_ID ?? \"\";\nconst COOKIE_NAME = \"pelangi_cookie_consent\";\n\nfunction readConsentCookie(): boolean {\n  if (typeof document === \"undefined\") return false;\n  const match = document.cookie.match(\n    new RegExp(`(?:^|; )${COOKIE_NAME}=([^;]*)`)\n  );\n  return match?.[1] === \"accepted\";\n}\n\n/**\n * Generate a unique event ID for deduplication between browser pixel and Events API.\n * Uses crypto.randomUUID when available, falls back to timestamp + random.\n */\nfunction generateEventId(): string {\n  if (typeof crypto !== \"undefined\" && crypto.randomUUID) {\n    return crypto.randomUUID();\n  }\n  return `${Date.now()}-${Math.random().toString(36).slice(2, 11)}`;\n}\n\n/**\n * SHA-256 hash a string value (browser-side, using SubtleCrypto).\n * Returns the hex digest. Used to hash PII before sending to Events API.\n */\nasync function sha256(value: string): Promise<string> {\n  const data = new TextEncoder().encode(value.trim().toLowerCase());\n  const hashBuffer = await crypto.subtle.digest(\"SHA-256\", data);\n  return Array.from(new Uint8Array(hashBuffer))\n    .map((b) => b.toString(16).padStart(2, \"0\"))\n    .join(\"\");\n}\n\n/**\n * Send a server-side TikTok event for dual-signal deduplication.\n */\nasync function sendServerEvent(\n  eventName: string,\n  eventId: string,\n  url: string,\n  userData?: { em?: string; ph?: string }\n): Promise<void> {\n  try {\n    const hashedUser: Record<string, string> = {};\n    if (userData?.em) {\n      hashedUser.em = await sha256(userData.em);\n    }\n    if (userData?.ph) {\n      const digits = userData.ph.replace(/\\D/g, \"\");\n      if (digits.length > 0) {\n        hashedUser.ph = await sha256(digits);\n      }\n    }\n\n    await fetch(\"/api/tiktok-events\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({\n        event: eventName,\n        event_id: eventId,\n        url,\n        user_data: Object.keys(hashedUser).length > 0 ? hashedUser : undefined,\n      }),\n    });\n  } catch {\n    // Silently fail — analytics should never block user experience\n  }\n}\n\n/**\n * TikTok Pixel + Events API dual-signal provider.\n * Loads the TikTok Pixel base code via lazyOnload and fires browser-side events.\n * For server-side deduplication, sends matching events to /api/tiktok-events.\n *\n * Tracked events:\n * - ViewContent: room pages\n * - Contact: contact form submission\n * - Search: blog/guide search\n */\nexport default function TikTokPixelProvider() {\n  const [consented, setConsented] = useState(false);\n\n  useEffect(() => {\n    setConsented(readConsentCookie());\n\n    function handleConsent(e: Event) {\n      const value = (e as CustomEvent<{ consent: string }>).detail.consent;\n      setConsented(value === \"accepted\");\n    }\n\n    window.addEventListener(\"cookie-consent\", handleConsent);\n    return () => window.removeEventListener(\"cookie-consent\", handleConsent);\n  }, []);\n\n  // Register global event handler for TikTok tracking events\n  useEffect(() => {\n    if (!consented || !PIXEL_ID) return;\n\n    function handleTikTokEvent(e: Event) {\n      const detail = (e as CustomEvent<{\n        event: string;\n        url?: string;\n        user_data?: { em?: string; ph?: string };\n      }>).detail;\n\n      const eventId = generateEventId();\n      const url = detail.url || window.location.href;\n\n      // Browser-side pixel event\n      if (typeof window !== \"undefined\" && (window as Record<string, unknown>).ttq) {\n        const ttq = (window as Record<string, unknown>).ttq as {\n          track: (event: string, props?: Record<string, unknown>, opts?: Record<string, unknown>) => void;\n        };\n        ttq.track(detail.event, {}, { event_id: eventId });\n      }\n\n      // Server-side Events API (deduplication via matching event_id)\n      sendServerEvent(detail.event, eventId, url, detail.user_data);\n    }\n\n    window.addEventListener(\"tiktok-track\", handleTikTokEvent);\n    return () => window.removeEventListener(\"tiktok-track\", handleTikTokEvent);\n  }, [consented]);\n\n  if (!consented || !PIXEL_ID) return null;\n\n  return (\n    <Script\n      id=\"tiktok-pixel-init\"\n      strategy=\"lazyOnload\"\n      dangerouslySetInnerHTML={{\n        __html: `\n          !function(w,d,t){w.TiktokAnalyticsObject=t;var ttq=w[t]=w[t]||[];\n          ttq.methods=[\"page\",\"track\",\"identify\",\"instances\",\"debug\",\"on\",\"off\",\n          \"once\",\"ready\",\"alias\",\"group\",\"enableCookie\",\"disableCookie\",\"holdConsent\",\n          \"revokeConsent\",\"grantConsent\"],ttq.setAndDefer=function(t,e){t[e]=\n          function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}};\n          for(var i=0;i<ttq.methods.length;i++)ttq.setAndDefer(ttq,ttq.methods[i]);\n          ttq.instance=function(t){for(var e=ttq._i[t]||[],n=0;n<ttq.methods.length;\n          n++)ttq.setAndDefer(e,ttq.methods[n]);return e};ttq.load=function(e,n){\n          var r=\"https://analytics.tiktok.com/i18n/pixel/events.js\",o=n&&n.partner;\n          ttq._i=ttq._i||{},ttq._i[e]=[],ttq._i[e]._u=r,ttq._t=ttq._t||{},\n          ttq._t[e]=+new Date,ttq._o=ttq._o||{},ttq._o[e]=n||{};\n          var a=d.createElement(\"script\");a.type=\"text/javascript\";a.async=!0;\n          a.src=r+\"?sdkid=\"+e+\"&lib=\"+t;var s=d.getElementsByTagName(\"script\")[0];\n          s.parentNode.insertBefore(a,s)};\n          ttq.load('${PIXEL_ID}');\n          ttq.page();\n          }(window,document,'ttq');`,\n      }}\n    />\n  );\n}\n","numLines":160,"startLine":1,"totalLines":160}}}
{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_016Nb5H1ApHkcw3nv1PBGi8s","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01FNvaVcDu59ctZNTRF6spGk","name":"Read","input":{"file_path":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\components\\ChatWidget.tsx"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":604,"cache_read_input_tokens":79471,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":604},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"e6e4fba7-5ce6-4787-94af-0cd5cb35d7c6","uuid":"daefdb1d-1156-4a1e-bb2a-8d853082df73"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FNvaVcDu59ctZNTRF6spGk","type":"tool_result","content":"1\t'use client';\n2\t\n3\timport { useState, useEffect, useRef, useCallback } from 'react';\n4\t\n5\tinterface Message {\n6\t  role: 'user' | 'assistant';\n7\t  content: string;\n8\t  timestamp: number;\n9\t}\n10\t\n11\tinterface FaqEntry {\n12\t  question: string;\n13\t  answer: string;\n14\t  keywords: string[];\n15\t  chipLabel?: string;\n16\t}\n17\t\n18\tconst FAQ_DATA: FaqEntry[] = [\n19\t  {\n20\t    question: 'What time is check-in and check-out?',\n21\t    answer:\n22\t      'Check-in is from 3:00 PM onwards, and check-out is before 12:00 PM (noon). We offer self-check-in so you can arrive anytime after 3 PM. Early check-in or late check-out may be available on request \\u2014 message us on WhatsApp at +60 12-708 8789.',\n23\t    keywords: ['check-in', 'check-out', 'checkout', 'checkin', 'time', 'arrive', 'arrival', 'early', 'late'],\n24\t    chipLabel: 'Check-in times',\n25\t  },\n26\t  {\n27\t    question: 'How much does a capsule pod cost?',\n28\t    answer:\n29\t      'Capsule pods start from RM35 per night. A Tourism Tax (TTx) of RM10 per room per night is added as required by law. Monthly stays are available from RM594/month. Book directly on our website at pelangicapsulehostel.com/book for the best rate.',\n30\t    keywords: ['price', 'pricing', 'cost', 'rate', 'rm', 'cheap', 'afford', 'how much', 'per night', 'monthly', 'budget'],\n31\t    chipLabel: 'Pricing & rates',\n32\t  },\n33\t  {\n34\t    question: 'Where is Pelangi Capsule Hostel located?',\n35\t    answer:\n36\t      'We are at 26A Jalan Perang, Taman Pelangi, 80400 Johor Bahru, Johor, Malaysia. Taman Pelangi is a central neighbourhood known for restaurants, cafes, and the famous Tuesday night market. A short Grab ride from JB Sentral, CIQ, and Senai Airport.',\n37\t    keywords: ['location', 'located', 'where', 'address', 'direction', 'map', 'area', 'taman pelangi', 'jalan'],\n38\t    chipLabel: 'Location',\n39\t  },\n40\t  {\n41\t    question: 'What is a capsule pod like?',\n42\t    answer:\n43\t      'Each capsule pod has a sliding door that locks for privacy, a premium mattress, personal fan and air-conditioning, adjustable LED lighting, USB charging ports, and a power outlet. Unlike open dorm beds, you get your own enclosed private space \\u2014 more privacy than a traditional hostel at a similar budget price.',\n44\t    keywords: ['capsule', 'pod', 'dorm', 'dormitory', 'room', 'bed', 'type', 'private', 'shared', 'what is'],\n45\t    chipLabel: 'Room types',\n46\t  },\n47\t  {\n48\t    question: 'Is there free WiFi?',\n49\t    answer:\n50\t      'Yes! We provide complimentary high-speed WiFi throughout the entire property, including inside the pod areas and common lounge. The connection is reliable enough for video calls and remote work.',\n51\t    keywords: ['wifi', 'wi-fi', 'internet', 'connection', 'online'],\n52\t  },\n53\t  {\n54\t    question: 'How do I get here from Singapore?',\n55\t    answer:\n56\t      'We are only 15 minutes by car from the Woodlands CIQ checkpoint. Take a Grab or taxi from JB CIQ to Taman Pelangi for around RM8\\u201312. Alternatively, take bus CW1 from Woodlands to JB Sentral, then a short Grab ride to us.',\n57\t    keywords: ['singapore', 'border', 'ciq', 'woodlands', 'crossing', 'causeway'],\n58\t  },\n59\t  {\n60\t    question: 'Is parking available?',\n61\t    answer:\n62\t      'Free street parking is available along Jalan Perang in front of the hostel. The area has plenty of open parking spaces, especially in the evenings. For longer stays, there are also nearby paid parking lots.',\n63\t    keywords: ['parking', 'park', 'car', 'drive', 'vehicle'],\n64\t    chipLabel: 'Parking',\n65\t  },\n66\t  {\n67\t    question: 'What payment methods do you accept?',\n68\t    answer:\n69\t      \"We accept cash (Malaysian Ringgit), DuitNow QR (all Malaysian banks and e-wallets including Maybank, CIMB, Touch 'n Go, Boost, GrabPay), and credit cards. DuitNow QR is the most convenient option for domestic travellers.\",\n70\t    keywords: ['payment', 'pay', 'cash', 'card', 'credit', 'duitnow', 'grab', 'boost'],\n71\t  },\n72\t  {\n73\t    question: 'Do you provide towels and toiletries?',\n74\t    answer:\n75\t      'Yes, every guest receives a fresh towel. Body wash and shampoo are provided in the shared bathrooms. Toothbrushes and toothpaste are available at the front desk for a small fee.',\n76\t    keywords: ['towel', 'toiletries', 'shampoo', 'soap', 'toothbrush', 'amenities'],\n77\t  },\n78\t  {\n79\t    question: 'Is breakfast included?',\n80\t    answer:\n81\t      'Breakfast is not included, but we have a fully equipped shared kitchen. Taman Pelangi is surrounded by dozens of affordable local restaurants and kopitiam \\u2014 a typical Malaysian breakfast costs RM3\\u20138 nearby.',\n82\t    keywords: ['breakfast', 'food', 'eat', 'meal', 'kitchen', 'cook'],\n83\t  },\n84\t  {\n85\t    question: 'Is the hostel safe?',\n86\t    answer:\n87\t      'Yes! We have 24/7 CCTV surveillance, secure keypad entry, and personal lockers in each pod room. Each capsule has a sliding door that locks from the inside. The hostel operates 24 hours with no curfew.',\n88\t    keywords: ['safe', 'safety', 'secure', 'security', 'lock', 'cctv', 'locker'],\n89\t  },\n90\t  {\n91\t    question: 'Can I stay monthly?',\n92\t    answer:\n93\t      'Yes, monthly rates start from RM594/month including all amenities: WiFi, air-conditioning, hot showers, kitchen access, and laundry facilities. We also offer in-house laundry service at RM5/load (guests only, cheaper than outside dobi). Popular with remote workers and digital nomads.',\n94\t    keywords: ['monthly', 'long stay', 'long-term', 'month', 'weekly', 'extended'],\n95\t  },\n96\t];\n97\t\n98\t/** Quick suggestion chips: check-in, pricing, location, room types, parking */\n99\tconst QUICK_FAQS: number[] = [0, 1, 2, 3, 6];\n100\t\n101\tconst GREETING =\n102\t  \"Hi! Welcome to Pelangi Capsule Hostel. I can answer common questions about our rooms, pricing, check-in, location, and more. Tap a topic below or type your question!\";\n103\t\n104\tconst FALLBACK =\n105\t  \"I'm not sure about that one. For specific questions, please contact us directly on WhatsApp at +60 12-708 8789 or visit our contact page.\";\n106\t\n107\tconst SESSION_KEY = 'chatwidget_history';\n108\tconst DELAY_MS = 10_000;\n109\t\n110\tfunction matchFaq(input: string): string {\n111\t  const lower = input.toLowerCase().trim();\n112\t  let bestScore = 0;\n113\t  let bestAnswer = '';\n114\t\n115\t  for (const faq of FAQ_DATA) {\n116\t    let score = 0;\n117\t    for (const kw of faq.keywords) {\n118\t      if (lower.includes(kw)) {\n119\t        score += kw.length;\n120\t      }\n121\t    }\n122\t    if (score > bestScore) {\n123\t      bestScore = score;\n124\t      bestAnswer = faq.answer;\n125\t    }\n126\t  }\n127\t\n128\t  return bestScore > 0 ? bestAnswer : FALLBACK;\n129\t}\n130\t\n131\texport default function ChatWidget() {\n132\t  const [isOpen, setIsOpen] = useState(false);\n133\t  const [isVisible, setIsVisible] = useState(false);\n134\t  const [messages, setMessages] = useState<Message[]>([]);\n135\t  const [input, setInput] = useState('');\n136\t  const [showChips, setShowChips] = useState(true);\n137\t\n138\t  const messagesEndRef = useRef<HTMLDivElement>(null);\n139\t  const inputRef = useRef<HTMLTextAreaElement>(null);\n140\t\n141\t  // ─── 10-second delay before showing the widget ────────────────────\n142\t  useEffect(() => {\n143\t    const timer = setTimeout(() => setIsVisible(true), DELAY_MS);\n144\t    return () => clearTimeout(timer);\n145\t  }, []);\n146\t\n147\t  // ─── Init: load session history ───────────────────────────────────\n148\t  useEffect(() => {\n149\t    try {\n150\t      const raw = sessionStorage.getItem(SESSION_KEY);\n151\t      const saved: Message[] = raw ? JSON.parse(raw) : [];\n152\t      if (saved.length > 0) {\n153\t        setMessages(saved);\n154\t        setShowChips(false);\n155\t      } else {\n156\t        setMessages([{ role: 'assistant', content: GREETING, timestamp: Date.now() }]);\n157\t      }\n158\t    } catch {\n159\t      setMessages([{ role: 'assistant', content: GREETING, timestamp: Date.now() }]);\n160\t    }\n161\t  }, []);\n162\t\n163\t  // ─── Auto-scroll to bottom ────────────────────────────────────────\n164\t  useEffect(() => {\n165\t    messagesEndRef.current?.scrollIntoView({ behavior: 'smooth' });\n166\t  }, [messages]);\n167\t\n168\t  // ─── Focus input when opened + notify other components ────────────\n169\t  useEffect(() => {\n170\t    window.dispatchEvent(new CustomEvent('chatwidget-toggle', { detail: isOpen }));\n171\t    if (isOpen) {\n172\t      setTimeout(() => inputRef.current?.focus(), 120);\n173\t    }\n174\t  }, [isOpen]);\n175\t\n176\t  // ─── Escape key to close ──────────────────────────────────────────\n177\t  useEffect(() => {\n178\t    if (!isOpen) return;\n179\t    function handleKeyDown(e: KeyboardEvent) {\n180\t      if (e.key === 'Escape') setIsOpen(false);\n181\t    }\n182\t    document.addEventListener('keydown', handleKeyDown);\n183\t    return () => document.removeEventListener('keydown', handleKeyDown);\n184\t  }, [isOpen]);\n185\t\n186\t  // ─── Persist history ──────────────────────────────────────────────\n187\t  const saveHistory = useCallback((msgs: Message[]) => {\n188\t    try {\n189\t      sessionStorage.setItem(SESSION_KEY, JSON.stringify(msgs.slice(-50)));\n190\t    } catch {\n191\t      /* quota exceeded */\n192\t    }\n193\t  }, []);\n194\t\n195\t  // ─── Handle a question (from input or chip) ───────────────────────\n196\t  const handleQuestion = useCallback(\n197\t    (text: string) => {\n198\t      const userMsg: Message = { role: 'user', content: text, timestamp: Date.now() };\n199\t      const answer = matchFaq(text);\n200\t      const botMsg: Message = { role: 'assistant', content: answer, timestamp: Date.now() + 1 };\n201\t\n202\t      setMessages(prev => {\n203\t        const updated = [...prev, userMsg, botMsg];\n204\t        saveHistory(updated);\n205\t        return updated;\n206\t      });\n207\t      setShowChips(false);\n208\t    },\n209\t    [saveHistory],\n210\t  );\n211\t\n212\t  // ─── Send from input ──────────────────────────────────────────────\n213\t  const sendMessage = () => {\n214\t    const text = input.trim();\n215\t    if (!text) return;\n216\t    setInput('');\n217\t    handleQuestion(text);\n218\t    if (inputRef.current) inputRef.current.style.height = 'auto';\n219\t  };\n220\t\n221\t  // ─── Textarea auto-resize ────────────────────────────────────────\n222\t  const handleInputChange = (e: React.ChangeEvent<HTMLTextAreaElement>) => {\n223\t    setInput(e.target.value);\n224\t    e.target.style.height = 'auto';\n225\t    e.target.style.height = Math.min(e.target.scrollHeight, 96) + 'px';\n226\t  };\n227\t\n228\t  const handleKeyDown = (e: React.KeyboardEvent<HTMLTextAreaElement>) => {\n229\t    if (e.key === 'Enter' && !e.shiftKey) {\n230\t      e.preventDefault();\n231\t      sendMessage();\n232\t    }\n233\t  };\n234\t\n235\t  const canSend = input.trim().length > 0;\n236\t\n237\t  if (!isVisible) return null;\n238\t\n239\t  return (\n240\t    <>\n241\t      {/* ── Chat Panel ──────────────────────────────────────────────── */}\n242\t      <div\n243\t        className={`\n244\t          fixed z-50\n245\t          w-[calc(100vw-2rem)] sm:w-96\n246\t          shadow-2xl rounded-2xl overflow-hidden flex flex-col bg-white dark:bg-stone-800\n247\t          transition-all duration-300 ease-out origin-bottom-right\n248\t          ${isOpen\n249\t            ? 'opacity-100 scale-100 pointer-events-auto'\n250\t            : 'opacity-0 scale-95 pointer-events-none'\n251\t          }\n252\t        `}\n253\t        style={{\n254\t          bottom: 'calc(5rem + 8px)',\n255\t          right: '1rem',\n256\t          maxHeight: 'min(540px, calc(100dvh - 110px))',\n257\t        }}\n258\t        role=\"dialog\"\n259\t        aria-label=\"Chat with Pelangi Capsule Hostel FAQ assistant\"\n260\t        aria-modal=\"true\"\n261\t        aria-hidden={!isOpen}\n262\t      >\n263\t        {/* Header */}\n264\t        <div\n265\t          className=\"flex items-center gap-3 px-4 py-3 text-white shrink-0\"\n266\t          style={{ background: 'linear-gradient(135deg, #a68b64 0%, #715d47 100%)' }}\n267\t        >\n268\t          <div className=\"w-10 h-10 rounded-full bg-white/20 flex items-center justify-center shrink-0\">\n269\t            <svg className=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\">\n270\t              <path d=\"M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-2 12H6v-2h12v2zm0-3H6V9h12v2zm0-3H6V6h12v2z\" />\n271\t            </svg>\n272\t          </div>\n273\t          <div className=\"flex-1 min-w-0\">\n274\t            <div className=\"font-semibold text-sm leading-tight truncate\">\n275\t              Pelangi Capsule Hostel\n276\t            </div>\n277\t            <div className=\"text-xs opacity-80\">FAQ Assistant</div>\n278\t          </div>\n279\t          <button\n280\t            onClick={() => setIsOpen(false)}\n281\t            className=\"w-11 h-11 flex items-center justify-center text-white/70 hover:text-white rounded-lg transition shrink-0\"\n282\t            aria-label=\"Close chat\"\n283\t          >\n284\t            <svg className=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" viewBox=\"0 0 24 24\">\n285\t              <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M6 18L18 6M6 6l12 12\" />\n286\t            </svg>\n287\t          </button>\n288\t        </div>\n289\t\n290\t        {/* Messages */}\n291\t        <div\n292\t          className=\"flex-1 overflow-y-auto px-4 py-3 space-y-2.5\"\n293\t          style={{ background: '#faf8f5' }}\n294\t        >\n295\t          {messages.map((msg, i) => (\n296\t            <div\n297\t              key={i}\n298\t              className={`flex flex-col ${msg.role === 'user' ? 'items-end' : 'items-start'}`}\n299\t              style={{ animation: 'fadeUp 0.2s ease-out' }}\n300\t            >\n301\t              <div\n302\t                className={`\n303\t                  max-w-[82%] px-3.5 py-2.5 rounded-2xl text-sm leading-relaxed\n304\t                  ${msg.role === 'user'\n305\t                    ? 'text-white rounded-br-[4px]'\n306\t                    : 'bg-white dark:bg-stone-700 text-stone-800 dark:text-stone-200 rounded-bl-[4px] shadow-xs border border-stone-100 dark:border-stone-600'\n307\t                  }\n308\t                `}\n309\t                style={msg.role === 'user' ? { background: '#a68b64' } : {}}\n310\t              >\n311\t                {msg.content}\n312\t              </div>\n313\t              <div className=\"text-[10px] text-stone-500 mt-1 px-1\">\n314\t                {new Date(msg.timestamp).toLocaleTimeString([], {\n315\t                  hour: '2-digit',\n316\t                  minute: '2-digit',\n317\t                })}\n318\t              </div>\n319\t            </div>\n320\t          ))}\n321\t\n322\t          {/* Quick FAQ chips */}\n323\t          {showChips && (\n324\t            <div className=\"flex flex-wrap gap-1.5 pt-1\" style={{ animation: 'fadeUp 0.3s ease-out' }}>\n325\t              {QUICK_FAQS.map(idx => {\n326\t                const faq = FAQ_DATA[idx];\n327\t                return (\n328\t                  <button\n329\t                    key={idx}\n330\t                    onClick={() => handleQuestion(faq.question)}\n331\t                    className=\"text-xs px-3 py-1.5 rounded-full border border-stone-200 dark:border-stone-600 bg-white dark:bg-stone-700 text-stone-700 dark:text-stone-300 hover:border-amber-400 hover:text-amber-800 dark:hover:text-amber-300 transition-colors\"\n332\t                  >\n333\t                    {faq.chipLabel ?? faq.question}\n334\t                  </button>\n335\t                );\n336\t              })}\n337\t            </div>\n338\t          )}\n339\t\n340\t          <div ref={messagesEndRef} />\n341\t        </div>\n342\t\n343\t        {/* Input area */}\n344\t        <div className=\"bg-white dark:bg-stone-800 border-t border-stone-100 dark:border-stone-700 px-3 py-2.5 flex gap-2 items-end shrink-0\">\n345\t          <textarea\n346\t            ref={inputRef}\n347\t            value={input}\n348\t            onChange={handleInputChange}\n349\t            onKeyDown={handleKeyDown}\n350\t            placeholder=\"Type a question\\u2026\"\n351\t            rows={1}\n352\t            autoComplete=\"on\"\n353\t            className=\"flex-1 resize-none text-sm transition border border-stone-500 dark:border-stone-600 rounded-xl px-3 py-2 bg-white dark:bg-stone-700 text-stone-900 dark:text-stone-100 focus-visible:border-amber-400 placeholder:text-stone-500\"\n354\t            style={{ lineHeight: '1.4', fontFamily: 'inherit', maxHeight: '96px' }}\n355\t            aria-label=\"Type your question\"\n356\t          />\n357\t          <button\n358\t            onClick={sendMessage}\n359\t            disabled={!canSend}\n360\t            className=\"w-11 h-11 rounded-full flex items-center justify-center shrink-0 transition hover:brightness-110 active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed\"\n361\t            style={{ background: canSend ? '#a68b64' : '#d6d3d1' }}\n362\t            aria-label=\"Send message\"\n363\t          >\n364\t            <svg\n365\t              className=\"w-4 h-4 text-white\"\n366\t              viewBox=\"0 0 24 24\"\n367\t              fill=\"none\"\n368\t              stroke=\"currentColor\"\n369\t              strokeWidth=\"2.5\"\n370\t              strokeLinecap=\"round\"\n371\t              strokeLinejoin=\"round\"\n372\t            >\n373\t              <line x1=\"22\" y1=\"2\" x2=\"11\" y2=\"13\" />\n374\t              <polygon points=\"22 2 15 22 11 13 2 9 22 2\" fill=\"currentColor\" stroke=\"none\" />\n375\t            </svg>\n376\t          </button>\n377\t        </div>\n378\t\n379\t        {/* WhatsApp fallback */}\n380\t        <div className=\"text-center text-[10px] text-stone-500 dark:text-stone-400 py-1.5 bg-white dark:bg-stone-800 border-t border-stone-50 dark:border-stone-700\">\n381\t          Need more help?{' '}\n382\t          <a\n383\t            href=\"https://wa.me/60127088789?text=Hi!%20I%20have%20a%20question%20about%20Pelangi%20Capsule%20Hostel.\"\n384\t            target=\"_blank\"\n385\t            rel=\"noopener noreferrer\"\n386\t            className=\"text-green-600 hover:underline\"\n387\t          >\n388\t            WhatsApp us\n389\t          </a>\n390\t        </div>\n391\t      </div>\n392\t\n393\t      {/* ── Floating Button ─────────────────────────────────────────── */}\n394\t      <button\n395\t        onClick={() => setIsOpen(prev => !prev)}\n396\t        className=\"fixed bottom-20 right-4 sm:bottom-5 sm:right-6 z-50 w-14 h-14 rounded-full shadow-xl flex items-center justify-center transition-all duration-200 hover:scale-110 active:scale-95 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700\"\n397\t        style={{\n398\t          background: 'linear-gradient(135deg, #a68b64 0%, #715d47 100%)',\n399\t          animation: 'fadeUp 0.4s ease-out',\n400\t        }}\n401\t        aria-label={isOpen ? 'Close chat' : 'Open chat'}\n402\t      >\n403\t        {isOpen ? (\n404\t          <svg\n405\t            className=\"w-6 h-6 text-white transition-transform duration-200\"\n406\t            fill=\"none\"\n407\t            stroke=\"currentColor\"\n408\t            strokeWidth=\"2.5\"\n409\t            viewBox=\"0 0 24 24\"\n410\t          >\n411\t            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M6 18L18 6M6 6l12 12\" />\n412\t          </svg>\n413\t        ) : (\n414\t          <svg className=\"w-6 h-6 text-white\" viewBox=\"0 0 24 24\" fill=\"currentColor\">\n415\t            <path d=\"M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z\" />\n416\t          </svg>\n417\t        )}\n418\t      </button>\n419\t\n420\t      {/* ── Keyframe animations ─────────────────────────────────────── */}\n421\t      <style>{`\n422\t        @keyframes fadeUp {\n423\t          from { opacity: 0; transform: translateY(6px); }\n424\t          to   { opacity: 1; transform: translateY(0); }\n425\t        }\n426\t      `}</style>\n427\t    </>\n428\t  );\n429\t}\n430\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"e6e4fba7-5ce6-4787-94af-0cd5cb35d7c6","uuid":"9ddaa13f-c31b-4217-ab6d-0c9001b8d343","timestamp":"2026-04-14T08:40:19.448Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\components\\ChatWidget.tsx","content":"'use client';\n\nimport { useState, useEffect, useRef, useCallback } from 'react';\n\ninterface Message {\n  role: 'user' | 'assistant';\n  content: string;\n  timestamp: number;\n}\n\ninterface FaqEntry {\n  question: string;\n  answer: string;\n  keywords: string[];\n  chipLabel?: string;\n}\n\nconst FAQ_DATA: FaqEntry[] = [\n  {\n    question: 'What time is check-in and check-out?',\n    answer:\n      'Check-in is from 3:00 PM onwards, and check-out is before 12:00 PM (noon). We offer self-check-in so you can arrive anytime after 3 PM. Early check-in or late check-out may be available on request \\u2014 message us on WhatsApp at +60 12-708 8789.',\n    keywords: ['check-in', 'check-out', 'checkout', 'checkin', 'time', 'arrive', 'arrival', 'early', 'late'],\n    chipLabel: 'Check-in times',\n  },\n  {\n    question: 'How much does a capsule pod cost?',\n    answer:\n      'Capsule pods start from RM35 per night. A Tourism Tax (TTx) of RM10 per room per night is added as required by law. Monthly stays are available from RM594/month. Book directly on our website at pelangicapsulehostel.com/book for the best rate.',\n    keywords: ['price', 'pricing', 'cost', 'rate', 'rm', 'cheap', 'afford', 'how much', 'per night', 'monthly', 'budget'],\n    chipLabel: 'Pricing & rates',\n  },\n  {\n    question: 'Where is Pelangi Capsule Hostel located?',\n    answer:\n      'We are at 26A Jalan Perang, Taman Pelangi, 80400 Johor Bahru, Johor, Malaysia. Taman Pelangi is a central neighbourhood known for restaurants, cafes, and the famous Tuesday night market. A short Grab ride from JB Sentral, CIQ, and Senai Airport.',\n    keywords: ['location', 'located', 'where', 'address', 'direction', 'map', 'area', 'taman pelangi', 'jalan'],\n    chipLabel: 'Location',\n  },\n  {\n    question: 'What is a capsule pod like?',\n    answer:\n      'Each capsule pod has a sliding door that locks for privacy, a premium mattress, personal fan and air-conditioning, adjustable LED lighting, USB charging ports, and a power outlet. Unlike open dorm beds, you get your own enclosed private space \\u2014 more privacy than a traditional hostel at a similar budget price.',\n    keywords: ['capsule', 'pod', 'dorm', 'dormitory', 'room', 'bed', 'type', 'private', 'shared', 'what is'],\n    chipLabel: 'Room types',\n  },\n  {\n    question: 'Is there free WiFi?',\n    answer:\n      'Yes! We provide complimentary high-speed WiFi throughout the entire property, including inside the pod areas and common lounge. The connection is reliable enough for video calls and remote work.',\n    keywords: ['wifi', 'wi-fi', 'internet', 'connection', 'online'],\n  },\n  {\n    question: 'How do I get here from Singapore?',\n    answer:\n      'We are only 15 minutes by car from the Woodlands CIQ checkpoint. Take a Grab or taxi from JB CIQ to Taman Pelangi for around RM8\\u201312. Alternatively, take bus CW1 from Woodlands to JB Sentral, then a short Grab ride to us.',\n    keywords: ['singapore', 'border', 'ciq', 'woodlands', 'crossing', 'causeway'],\n  },\n  {\n    question: 'Is parking available?',\n    answer:\n      'Free street parking is available along Jalan Perang in front of the hostel. The area has plenty of open parking spaces, especially in the evenings. For longer stays, there are also nearby paid parking lots.',\n    keywords: ['parking', 'park', 'car', 'drive', 'vehicle'],\n    chipLabel: 'Parking',\n  },\n  {\n    question: 'What payment methods do you accept?',\n    answer:\n      \"We accept cash (Malaysian Ringgit), DuitNow QR (all Malaysian banks and e-wallets including Maybank, CIMB, Touch 'n Go, Boost, GrabPay), and credit cards. DuitNow QR is the most convenient option for domestic travellers.\",\n    keywords: ['payment', 'pay', 'cash', 'card', 'credit', 'duitnow', 'grab', 'boost'],\n  },\n  {\n    question: 'Do you provide towels and toiletries?',\n    answer:\n      'Yes, every guest receives a fresh towel. Body wash and shampoo are provided in the shared bathrooms. Toothbrushes and toothpaste are available at the front desk for a small fee.',\n    keywords: ['towel', 'toiletries', 'shampoo', 'soap', 'toothbrush', 'amenities'],\n  },\n  {\n    question: 'Is breakfast included?',\n    answer:\n      'Breakfast is not included, but we have a fully equipped shared kitchen. Taman Pelangi is surrounded by dozens of affordable local restaurants and kopitiam \\u2014 a typical Malaysian breakfast costs RM3\\u20138 nearby.',\n    keywords: ['breakfast', 'food', 'eat', 'meal', 'kitchen', 'cook'],\n  },\n  {\n    question: 'Is the hostel safe?',\n    answer:\n      'Yes! We have 24/7 CCTV surveillance, secure keypad entry, and personal lockers in each pod room. Each capsule has a sliding door that locks from the inside. The hostel operates 24 hours with no curfew.',\n    keywords: ['safe', 'safety', 'secure', 'security', 'lock', 'cctv', 'locker'],\n  },\n  {\n    question: 'Can I stay monthly?',\n    answer:\n      'Yes, monthly rates start from RM594/month including all amenities: WiFi, air-conditioning, hot showers, kitchen access, and laundry facilities. We also offer in-house laundry service at RM5/load (guests only, cheaper than outside dobi). Popular with remote workers and digital nomads.',\n    keywords: ['monthly', 'long stay', 'long-term', 'month', 'weekly', 'extended'],\n  },\n];\n\n/** Quick suggestion chips: check-in, pricing, location, room types, parking */\nconst QUICK_FAQS: number[] = [0, 1, 2, 3, 6];\n\nconst GREETING =\n  \"Hi! Welcome to Pelangi Capsule Hostel. I can answer common questions about our rooms, pricing, check-in, location, and more. Tap a topic below or type your question!\";\n\nconst FALLBACK =\n  \"I'm not sure about that one. For specific questions, please contact us directly on WhatsApp at +60 12-708 8789 or visit our contact page.\";\n\nconst SESSION_KEY = 'chatwidget_history';\nconst DELAY_MS = 10_000;\n\nfunction matchFaq(input: string): string {\n  const lower = input.toLowerCase().trim();\n  let bestScore = 0;\n  let bestAnswer = '';\n\n  for (const faq of FAQ_DATA) {\n    let score = 0;\n    for (const kw of faq.keywords) {\n      if (lower.includes(kw)) {\n        score += kw.length;\n      }\n    }\n    if (score > bestScore) {\n      bestScore = score;\n      bestAnswer = faq.answer;\n    }\n  }\n\n  return bestScore > 0 ? bestAnswer : FALLBACK;\n}\n\nexport default function ChatWidget() {\n  const [isOpen, setIsOpen] = useState(false);\n  const [isVisible, setIsVisible] = useState(false);\n  const [messages, setMessages] = useState<Message[]>([]);\n  const [input, setInput] = useState('');\n  const [showChips, setShowChips] = useState(true);\n\n  const messagesEndRef = useRef<HTMLDivElement>(null);\n  const inputRef = useRef<HTMLTextAreaElement>(null);\n\n  // ─── 10-second delay before showing the widget ────────────────────\n  useEffect(() => {\n    const timer = setTimeout(() => setIsVisible(true), DELAY_MS);\n    return () => clearTimeout(timer);\n  }, []);\n\n  // ─── Init: load session history ───────────────────────────────────\n  useEffect(() => {\n    try {\n      const raw = sessionStorage.getItem(SESSION_KEY);\n      const saved: Message[] = raw ? JSON.parse(raw) : [];\n      if (saved.length > 0) {\n        setMessages(saved);\n        setShowChips(false);\n      } else {\n        setMessages([{ role: 'assistant', content: GREETING, timestamp: Date.now() }]);\n      }\n    } catch {\n      setMessages([{ role: 'assistant', content: GREETING, timestamp: Date.now() }]);\n    }\n  }, []);\n\n  // ─── Auto-scroll to bottom ────────────────────────────────────────\n  useEffect(() => {\n    messagesEndRef.current?.scrollIntoView({ behavior: 'smooth' });\n  }, [messages]);\n\n  // ─── Focus input when opened + notify other components ────────────\n  useEffect(() => {\n    window.dispatchEvent(new CustomEvent('chatwidget-toggle', { detail: isOpen }));\n    if (isOpen) {\n      setTimeout(() => inputRef.current?.focus(), 120);\n    }\n  }, [isOpen]);\n\n  // ─── Escape key to close ──────────────────────────────────────────\n  useEffect(() => {\n    if (!isOpen) return;\n    function handleKeyDown(e: KeyboardEvent) {\n      if (e.key === 'Escape') setIsOpen(false);\n    }\n    document.addEventListener('keydown', handleKeyDown);\n    return () => document.removeEventListener('keydown', handleKeyDown);\n  }, [isOpen]);\n\n  // ─── Persist history ──────────────────────────────────────────────\n  const saveHistory = useCallback((msgs: Message[]) => {\n    try {\n      sessionStorage.setItem(SESSION_KEY, JSON.stringify(msgs.slice(-50)));\n    } catch {\n      /* quota exceeded */\n    }\n  }, []);\n\n  // ─── Handle a question (from input or chip) ───────────────────────\n  const handleQuestion = useCallback(\n    (text: string) => {\n      const userMsg: Message = { role: 'user', content: text, timestamp: Date.now() };\n      const answer = matchFaq(text);\n      const botMsg: Message = { role: 'assistant', content: answer, timestamp: Date.now() + 1 };\n\n      setMessages(prev => {\n        const updated = [...prev, userMsg, botMsg];\n        saveHistory(updated);\n        return updated;\n      });\n      setShowChips(false);\n    },\n    [saveHistory],\n  );\n\n  // ─── Send from input ──────────────────────────────────────────────\n  const sendMessage = () => {\n    const text = input.trim();\n    if (!text) return;\n    setInput('');\n    handleQuestion(text);\n    if (inputRef.current) inputRef.current.style.height = 'auto';\n  };\n\n  // ─── Textarea auto-resize ────────────────────────────────────────\n  const handleInputChange = (e: React.ChangeEvent<HTMLTextAreaElement>) => {\n    setInput(e.target.value);\n    e.target.style.height = 'auto';\n    e.target.style.height = Math.min(e.target.scrollHeight, 96) + 'px';\n  };\n\n  const handleKeyDown = (e: React.KeyboardEvent<HTMLTextAreaElement>) => {\n    if (e.key === 'Enter' && !e.shiftKey) {\n      e.preventDefault();\n      sendMessage();\n    }\n  };\n\n  const canSend = input.trim().length > 0;\n\n  if (!isVisible) return null;\n\n  return (\n    <>\n      {/* ── Chat Panel ──────────────────────────────────────────────── */}\n      <div\n        className={`\n          fixed z-50\n          w-[calc(100vw-2rem)] sm:w-96\n          shadow-2xl rounded-2xl overflow-hidden flex flex-col bg-white dark:bg-stone-800\n          transition-all duration-300 ease-out origin-bottom-right\n          ${isOpen\n            ? 'opacity-100 scale-100 pointer-events-auto'\n            : 'opacity-0 scale-95 pointer-events-none'\n          }\n        `}\n        style={{\n          bottom: 'calc(5rem + 8px)',\n          right: '1rem',\n          maxHeight: 'min(540px, calc(100dvh - 110px))',\n        }}\n        role=\"dialog\"\n        aria-label=\"Chat with Pelangi Capsule Hostel FAQ assistant\"\n        aria-modal=\"true\"\n        aria-hidden={!isOpen}\n      >\n        {/* Header */}\n        <div\n          className=\"flex items-center gap-3 px-4 py-3 text-white shrink-0\"\n          style={{ background: 'linear-gradient(135deg, #a68b64 0%, #715d47 100%)' }}\n        >\n          <div className=\"w-10 h-10 rounded-full bg-white/20 flex items-center justify-center shrink-0\">\n            <svg className=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\">\n              <path d=\"M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-2 12H6v-2h12v2zm0-3H6V9h12v2zm0-3H6V6h12v2z\" />\n            </svg>\n          </div>\n          <div className=\"flex-1 min-w-0\">\n            <div className=\"font-semibold text-sm leading-tight truncate\">\n              Pelangi Capsule Hostel\n            </div>\n            <div className=\"text-xs opacity-80\">FAQ Assistant</div>\n          </div>\n          <button\n            onClick={() => setIsOpen(false)}\n            className=\"w-11 h-11 flex items-center justify-center text-white/70 hover:text-white rounded-lg transition shrink-0\"\n            aria-label=\"Close chat\"\n          >\n            <svg className=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" viewBox=\"0 0 24 24\">\n              <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M6 18L18 6M6 6l12 12\" />\n            </svg>\n          </button>\n        </div>\n\n        {/* Messages */}\n        <div\n          className=\"flex-1 overflow-y-auto px-4 py-3 space-y-2.5\"\n          style={{ background: '#faf8f5' }}\n        >\n          {messages.map((msg, i) => (\n            <div\n              key={i}\n              className={`flex flex-col ${msg.role === 'user' ? 'items-end' : 'items-start'}`}\n              style={{ animation: 'fadeUp 0.2s ease-out' }}\n            >\n              <div\n                className={`\n                  max-w-[82%] px-3.5 py-2.5 rounded-2xl text-sm leading-relaxed\n                  ${msg.role === 'user'\n                    ? 'text-white rounded-br-[4px]'\n                    : 'bg-white dark:bg-stone-700 text-stone-800 dark:text-stone-200 rounded-bl-[4px] shadow-xs border border-stone-100 dark:border-stone-600'\n                  }\n                `}\n                style={msg.role === 'user' ? { background: '#a68b64' } : {}}\n              >\n                {msg.content}\n              </div>\n              <div className=\"text-[10px] text-stone-500 mt-1 px-1\">\n                {new Date(msg.timestamp).toLocaleTimeString([], {\n                  hour: '2-digit',\n                  minute: '2-digit',\n                })}\n              </div>\n            </div>\n          ))}\n\n          {/* Quick FAQ chips */}\n          {showChips && (\n            <div className=\"flex flex-wrap gap-1.5 pt-1\" style={{ animation: 'fadeUp 0.3s ease-out' }}>\n              {QUICK_FAQS.map(idx => {\n                const faq = FAQ_DATA[idx];\n                return (\n                  <button\n                    key={idx}\n                    onClick={() => handleQuestion(faq.question)}\n                    className=\"text-xs px-3 py-1.5 rounded-full border border-stone-200 dark:border-stone-600 bg-white dark:bg-stone-700 text-stone-700 dark:text-stone-300 hover:border-amber-400 hover:text-amber-800 dark:hover:text-amber-300 transition-colors\"\n                  >\n                    {faq.chipLabel ?? faq.question}\n                  </button>\n                );\n              })}\n            </div>\n          )}\n\n          <div ref={messagesEndRef} />\n        </div>\n\n        {/* Input area */}\n        <div className=\"bg-white dark:bg-stone-800 border-t border-stone-100 dark:border-stone-700 px-3 py-2.5 flex gap-2 items-end shrink-0\">\n          <textarea\n            ref={inputRef}\n            value={input}\n            onChange={handleInputChange}\n            onKeyDown={handleKeyDown}\n            placeholder=\"Type a question\\u2026\"\n            rows={1}\n            autoComplete=\"on\"\n            className=\"flex-1 resize-none text-sm transition border border-stone-500 dark:border-stone-600 rounded-xl px-3 py-2 bg-white dark:bg-stone-700 text-stone-900 dark:text-stone-100 focus-visible:border-amber-400 placeholder:text-stone-500\"\n            style={{ lineHeight: '1.4', fontFamily: 'inherit', maxHeight: '96px' }}\n            aria-label=\"Type your question\"\n          />\n          <button\n            onClick={sendMessage}\n            disabled={!canSend}\n            className=\"w-11 h-11 rounded-full flex items-center justify-center shrink-0 transition hover:brightness-110 active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed\"\n            style={{ background: canSend ? '#a68b64' : '#d6d3d1' }}\n            aria-label=\"Send message\"\n          >\n            <svg\n              className=\"w-4 h-4 text-white\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              strokeWidth=\"2.5\"\n              strokeLinecap=\"round\"\n              strokeLinejoin=\"round\"\n            >\n              <line x1=\"22\" y1=\"2\" x2=\"11\" y2=\"13\" />\n              <polygon points=\"22 2 15 22 11 13 2 9 22 2\" fill=\"currentColor\" stroke=\"none\" />\n            </svg>\n          </button>\n        </div>\n\n        {/* WhatsApp fallback */}\n        <div className=\"text-center text-[10px] text-stone-500 dark:text-stone-400 py-1.5 bg-white dark:bg-stone-800 border-t border-stone-50 dark:border-stone-700\">\n          Need more help?{' '}\n          <a\n            href=\"https://wa.me/60127088789?text=Hi!%20I%20have%20a%20question%20about%20Pelangi%20Capsule%20Hostel.\"\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            className=\"text-green-600 hover:underline\"\n          >\n            WhatsApp us\n          </a>\n        </div>\n      </div>\n\n      {/* ── Floating Button ─────────────────────────────────────────── */}\n      <button\n        onClick={() => setIsOpen(prev => !prev)}\n        className=\"fixed bottom-20 right-4 sm:bottom-5 sm:right-6 z-50 w-14 h-14 rounded-full shadow-xl flex items-center justify-center transition-all duration-200 hover:scale-110 active:scale-95 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700\"\n        style={{\n          background: 'linear-gradient(135deg, #a68b64 0%, #715d47 100%)',\n          animation: 'fadeUp 0.4s ease-out',\n        }}\n        aria-label={isOpen ? 'Close chat' : 'Open chat'}\n      >\n        {isOpen ? (\n          <svg\n            className=\"w-6 h-6 text-white transition-transform duration-200\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            strokeWidth=\"2.5\"\n            viewBox=\"0 0 24 24\"\n          >\n            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M6 18L18 6M6 6l12 12\" />\n          </svg>\n        ) : (\n          <svg className=\"w-6 h-6 text-white\" viewBox=\"0 0 24 24\" fill=\"currentColor\">\n            <path d=\"M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z\" />\n          </svg>\n        )}\n      </button>\n\n      {/* ── Keyframe animations ─────────────────────────────────────── */}\n      <style>{`\n        @keyframes fadeUp {\n          from { opacity: 0; transform: translateY(6px); }\n          to   { opacity: 1; transform: translateY(0); }\n        }\n      `}</style>\n    </>\n  );\n}\n","numLines":430,"startLine":1,"totalLines":430}}}
