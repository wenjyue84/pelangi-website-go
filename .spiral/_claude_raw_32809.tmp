{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ke2yokiQ5r3aJNwdFVxmwi","type":"tool_result","content":"1\t\"use client\";\n2\t\n3\timport { useState, useEffect } from \"react\";\n4\timport { useSearchParams } from \"next/navigation\";\n5\timport { useBookingDraft } from \"@/hooks/useBookingDraft\";\n6\t\n7\tconst WHATSAPP_NUMBER = \"60127088789\";\n8\t\n9\tfunction buildWhatsAppUrl(checkIn: string, checkOut: string, roomType: string): string {\n10\t  let message: string;\n11\t  if (checkIn && checkOut) {\n12\t    message = `Hi Pelangi Capsule! I'd like to book ${roomType} from ${checkIn} to ${checkOut}.`;\n13\t  } else if (checkIn) {\n14\t    message = `Hi Pelangi Capsule! I'd like to book ${roomType} checking in on ${checkIn}.`;\n15\t  } else {\n16\t    message = \"Hi Pelangi Capsule Hostel! I'd like to book a pod. Please confirm availability.\";\n17\t  }\n18\t  return `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`;\n19\t}\n20\t\n21\t/** SC 3.3.3: Validate dates with specific suggestions */\n22\tfunction validateBookingDates(checkIn: string, checkOut: string): Record<string, string> {\n23\t  const errors: Record<string, string> = {};\n24\t  const today = new Date();\n25\t  today.setHours(0, 0, 0, 0);\n26\t\n27\t  if (checkIn) {\n28\t    const d = new Date(checkIn);\n29\t    if (isNaN(d.getTime())) {\n30\t      errors.checkIn = \"Please enter a valid date (e.g. select from the date picker).\";\n31\t    } else if (d < today) {\n32\t      errors.checkIn = \"Check-in date cannot be in the past. Please select today or a future date.\";\n33\t    }\n34\t  }\n35\t  if (checkOut) {\n36\t    const d = new Date(checkOut);\n37\t    if (isNaN(d.getTime())) {\n38\t      errors.checkOut = \"Please enter a valid date (e.g. select from the date picker).\";\n39\t    } else if (checkIn && new Date(checkIn) >= d) {\n40\t      errors.checkOut = \"Check-out date must be after your check-in date.\";\n41\t    }\n42\t  }\n43\t  return errors;\n44\t}\n45\t\n46\texport default function BookingForm() {\n47\t  const { draft, saveDraft } = useBookingDraft();\n48\t  const searchParams = useSearchParams();\n49\t  const [checkIn, setCheckIn] = useState(\"\");\n50\t  const [checkOut, setCheckOut] = useState(\"\");\n51\t  const [roomType, setRoomType] = useState(\"Capsule Pod\");\n52\t  const [errors, setErrors] = useState<Record<string, string>>({});\n53\t  const [showReview, setShowReview] = useState(false);\n54\t\n55\t  // Pre-fill from URL params (Google Hotels traffic) or restore from draft\n56\t  useEffect(() => {\n57\t    const urlCheckin = searchParams.get(\"checkin\");\n58\t    const urlCheckout = searchParams.get(\"checkout\");\n59\t\n60\t    if (urlCheckin || urlCheckout) {\n61\t      // URL params take priority (e.g. Google Hotel free booking links)\n62\t      if (urlCheckin) setCheckIn(urlCheckin);\n63\t      if (urlCheckout) setCheckOut(urlCheckout);\n64\t    } else if (draft) {\n65\t      if (draft.roomType) setRoomType(draft.roomType);\n66\t      if (draft.checkIn) setCheckIn(draft.checkIn);\n67\t      if (draft.checkOut) setCheckOut(draft.checkOut);\n68\t    }\n69\t    // eslint-disable-next-line react-hooks/exhaustive-deps\n70\t  }, []);\n71\t\n72\t  // Save draft whenever form fields change\n73\t  useEffect(() => {\n74\t    if (roomType || checkIn || checkOut) {\n75\t      saveDraft({ roomType, checkIn, checkOut });\n76\t    }\n77\t  }, [roomType, checkIn, checkOut, saveDraft]);\n78\t\n79\t  const whatsappUrl = buildWhatsAppUrl(checkIn, checkOut, roomType);\n80\t\n81\t  // Broadcast dynamic link for MobileBookingBar\n82\t  useEffect(() => {\n83\t    window.dispatchEvent(\n84\t      new CustomEvent(\"booking-link-update\", { detail: whatsappUrl })\n85\t    );\n86\t  }, [whatsappUrl]);\n87\t\n88\t  // Today's date in YYYY-MM-DD for min attribute\n89\t  const today = new Date().toISOString().split(\"T\")[0];\n90\t\n91\t  // Clear errors on field change\n92\t  useEffect(() => {\n93\t    if (Object.keys(errors).length > 0) {\n94\t      setErrors({});\n95\t    }\n96\t    // eslint-disable-next-line react-hooks/exhaustive-deps\n97\t  }, [checkIn, checkOut]);\n98\t\n99\t  /** SC 3.3.3+3.3.4: Validate and show review before sending */\n100\t  function handleBookClick(e: React.MouseEvent) {\n101\t    e.preventDefault();\n102\t    const dateErrors = validateBookingDates(checkIn, checkOut);\n103\t    if (Object.keys(dateErrors).length > 0) {\n104\t      setErrors(dateErrors);\n105\t      return;\n106\t    }\n107\t    if (checkIn && checkOut) {\n108\t      setShowReview(true);\n109\t    } else {\n110\t      // No dates selected — open WhatsApp directly (no review needed for generic inquiry)\n111\t      window.open(whatsappUrl, \"_blank\", \"noopener,noreferrer\");\n112\t    }\n113\t  }\n114\t\n115\t  function handleConfirmBooking() {\n116\t    setShowReview(false);\n117\t    window.open(whatsappUrl, \"_blank\", \"noopener,noreferrer\");\n118\t  }\n119\t\n120\t  return (\n121\t    <div className=\"bg-white dark:bg-stone-900 rounded-3xl p-8 shadow-lg border border-stone-100 dark:border-stone-700\">\n122\t      <h3 className=\"font-display text-xl font-medium text-stone-900 dark:text-stone-100 mb-6 text-center\">\n123\t        Quick Book via WhatsApp\n124\t      </h3>\n125\t\n126\t      {showReview ? (\n127\t        /* SC 3.3.4: Review step before WhatsApp submission */\n128\t        <div className=\"space-y-4\">\n129\t          <div className=\"bg-amber-50 dark:bg-amber-900/20 rounded-xl p-4 border border-amber-200 dark:border-amber-700\">\n130\t            <p className=\"text-sm font-medium text-stone-800 dark:text-stone-200 mb-3\">\n131\t              Please confirm your booking details:\n132\t            </p>\n133\t            <dl className=\"space-y-2 text-sm\">\n134\t              <div className=\"flex justify-between\">\n135\t                <dt className=\"text-stone-500 dark:text-stone-400\">Room Type</dt>\n136\t                <dd className=\"font-medium text-stone-900 dark:text-stone-100\">{roomType}</dd>\n137\t              </div>\n138\t              <div className=\"flex justify-between\">\n139\t                <dt className=\"text-stone-500 dark:text-stone-400\">Check-in</dt>\n140\t                <dd className=\"font-medium text-stone-900 dark:text-stone-100\">{checkIn}</dd>\n141\t              </div>\n142\t              <div className=\"flex justify-between\">\n143\t                <dt className=\"text-stone-500 dark:text-stone-400\">Check-out</dt>\n144\t                <dd className=\"font-medium text-stone-900 dark:text-stone-100\">{checkOut}</dd>\n145\t              </div>\n146\t            </dl>\n147\t          </div>\n148\t\n149\t          <div className=\"bg-green-50 dark:bg-green-900/20 rounded-xl p-4 border border-green-200 dark:border-green-800\">\n150\t            <p className=\"text-sm text-green-800 dark:text-green-300\">\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"e214bee3-232f-4b1b-8118-dc441d3da087","uuid":"48cd98b8-2fed-4f21-9b82-38304758ccf8","timestamp":"2026-04-14T05:42:44.582Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\components\\BookingForm.tsx","content":"\"use client\";\n\nimport { useState, useEffect } from \"react\";\nimport { useSearchParams } from \"next/navigation\";\nimport { useBookingDraft } from \"@/hooks/useBookingDraft\";\n\nconst WHATSAPP_NUMBER = \"60127088789\";\n\nfunction buildWhatsAppUrl(checkIn: string, checkOut: string, roomType: string): string {\n  let message: string;\n  if (checkIn && checkOut) {\n    message = `Hi Pelangi Capsule! I'd like to book ${roomType} from ${checkIn} to ${checkOut}.`;\n  } else if (checkIn) {\n    message = `Hi Pelangi Capsule! I'd like to book ${roomType} checking in on ${checkIn}.`;\n  } else {\n    message = \"Hi Pelangi Capsule Hostel! I'd like to book a pod. Please confirm availability.\";\n  }\n  return `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`;\n}\n\n/** SC 3.3.3: Validate dates with specific suggestions */\nfunction validateBookingDates(checkIn: string, checkOut: string): Record<string, string> {\n  const errors: Record<string, string> = {};\n  const today = new Date();\n  today.setHours(0, 0, 0, 0);\n\n  if (checkIn) {\n    const d = new Date(checkIn);\n    if (isNaN(d.getTime())) {\n      errors.checkIn = \"Please enter a valid date (e.g. select from the date picker).\";\n    } else if (d < today) {\n      errors.checkIn = \"Check-in date cannot be in the past. Please select today or a future date.\";\n    }\n  }\n  if (checkOut) {\n    const d = new Date(checkOut);\n    if (isNaN(d.getTime())) {\n      errors.checkOut = \"Please enter a valid date (e.g. select from the date picker).\";\n    } else if (checkIn && new Date(checkIn) >= d) {\n      errors.checkOut = \"Check-out date must be after your check-in date.\";\n    }\n  }\n  return errors;\n}\n\nexport default function BookingForm() {\n  const { draft, saveDraft } = useBookingDraft();\n  const searchParams = useSearchParams();\n  const [checkIn, setCheckIn] = useState(\"\");\n  const [checkOut, setCheckOut] = useState(\"\");\n  const [roomType, setRoomType] = useState(\"Capsule Pod\");\n  const [errors, setErrors] = useState<Record<string, string>>({});\n  const [showReview, setShowReview] = useState(false);\n\n  // Pre-fill from URL params (Google Hotels traffic) or restore from draft\n  useEffect(() => {\n    const urlCheckin = searchParams.get(\"checkin\");\n    const urlCheckout = searchParams.get(\"checkout\");\n\n    if (urlCheckin || urlCheckout) {\n      // URL params take priority (e.g. Google Hotel free booking links)\n      if (urlCheckin) setCheckIn(urlCheckin);\n      if (urlCheckout) setCheckOut(urlCheckout);\n    } else if (draft) {\n      if (draft.roomType) setRoomType(draft.roomType);\n      if (draft.checkIn) setCheckIn(draft.checkIn);\n      if (draft.checkOut) setCheckOut(draft.checkOut);\n    }\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, []);\n\n  // Save draft whenever form fields change\n  useEffect(() => {\n    if (roomType || checkIn || checkOut) {\n      saveDraft({ roomType, checkIn, checkOut });\n    }\n  }, [roomType, checkIn, checkOut, saveDraft]);\n\n  const whatsappUrl = buildWhatsAppUrl(checkIn, checkOut, roomType);\n\n  // Broadcast dynamic link for MobileBookingBar\n  useEffect(() => {\n    window.dispatchEvent(\n      new CustomEvent(\"booking-link-update\", { detail: whatsappUrl })\n    );\n  }, [whatsappUrl]);\n\n  // Today's date in YYYY-MM-DD for min attribute\n  const today = new Date().toISOString().split(\"T\")[0];\n\n  // Clear errors on field change\n  useEffect(() => {\n    if (Object.keys(errors).length > 0) {\n      setErrors({});\n    }\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [checkIn, checkOut]);\n\n  /** SC 3.3.3+3.3.4: Validate and show review before sending */\n  function handleBookClick(e: React.MouseEvent) {\n    e.preventDefault();\n    const dateErrors = validateBookingDates(checkIn, checkOut);\n    if (Object.keys(dateErrors).length > 0) {\n      setErrors(dateErrors);\n      return;\n    }\n    if (checkIn && checkOut) {\n      setShowReview(true);\n    } else {\n      // No dates selected — open WhatsApp directly (no review needed for generic inquiry)\n      window.open(whatsappUrl, \"_blank\", \"noopener,noreferrer\");\n    }\n  }\n\n  function handleConfirmBooking() {\n    setShowReview(false);\n    window.open(whatsappUrl, \"_blank\", \"noopener,noreferrer\");\n  }\n\n  return (\n    <div className=\"bg-white dark:bg-stone-900 rounded-3xl p-8 shadow-lg border border-stone-100 dark:border-stone-700\">\n      <h3 className=\"font-display text-xl font-medium text-stone-900 dark:text-stone-100 mb-6 text-center\">\n        Quick Book via WhatsApp\n      </h3>\n\n      {showReview ? (\n        /* SC 3.3.4: Review step before WhatsApp submission */\n        <div className=\"space-y-4\">\n          <div className=\"bg-amber-50 dark:bg-amber-900/20 rounded-xl p-4 border border-amber-200 dark:border-amber-700\">\n            <p className=\"text-sm font-medium text-stone-800 dark:text-stone-200 mb-3\">\n              Please confirm your booking details:\n            </p>\n            <dl className=\"space-y-2 text-sm\">\n              <div className=\"flex justify-between\">\n                <dt className=\"text-stone-500 dark:text-stone-400\">Room Type</dt>\n                <dd className=\"font-medium text-stone-900 dark:text-stone-100\">{roomType}</dd>\n              </div>\n              <div className=\"flex justify-between\">\n                <dt className=\"text-stone-500 dark:text-stone-400\">Check-in</dt>\n                <dd className=\"font-medium text-stone-900 dark:text-stone-100\">{checkIn}</dd>\n              </div>\n              <div className=\"flex justify-between\">\n                <dt className=\"text-stone-500 dark:text-stone-400\">Check-out</dt>\n                <dd className=\"font-medium text-stone-900 dark:text-stone-100\">{checkOut}</dd>\n              </div>\n            </dl>\n          </div>\n\n          <div className=\"bg-green-50 dark:bg-green-900/20 rounded-xl p-4 border border-green-200 dark:border-green-800\">\n            <p className=\"text-sm text-green-800 dark:text-green-300\">","numLines":150,"startLine":1,"totalLines":291}}}
