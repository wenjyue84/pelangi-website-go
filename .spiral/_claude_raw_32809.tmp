{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01P6UWWFoVuN9ZB3zUnVHwJj","type":"tool_result","content":"1\t\"use client\";\n2\t\n3\timport type { Route } from \"next\";\n4\timport { useState } from \"react\";\n5\timport { useRouter } from \"next/navigation\";\n6\timport { setLanguagePreference } from \"@/app/actions/language\";\n7\t\n8\tconst LANGUAGES = [\n9\t  { code: \"en\", label: \"EN\" },\n10\t  { code: \"ms\", label: \"BM\", href: \"/ms/terma\" },\n11\t  { code: \"zh\", label: \"中文\", href: \"/zh\" },\n12\t];\n13\t\n14\texport default function LanguageSwitcher() {\n15\t  const [currentLanguage, setCurrentLanguage] = useState(\"en\");\n16\t  const router = useRouter();\n17\t\n18\t  const handleLanguageChange = async (langCode: string) => {\n19\t    setCurrentLanguage(langCode);\n20\t\n21\t    // Set the cookie\n22\t    await setLanguagePreference(langCode);\n23\t\n24\t    // Navigate to BM content page\n25\t    const lang = LANGUAGES.find((l) => l.code === langCode);\n26\t    if (lang && \"href\" in lang && lang.href) {\n27\t      router.push(lang.href as Route);\n28\t      return;\n29\t    }\n30\t\n31\t  };\n32\t\n33\t  return (\n34\t    <div className=\"flex items-center gap-1 ml-4\">\n35\t      <nav\n36\t        className=\"flex gap-1 bg-stone-100 dark:bg-stone-800 rounded-full p-1\"\n37\t        aria-label=\"Language selector\"\n38\t      >\n39\t        {LANGUAGES.map((lang) => (\n40\t          <button\n41\t            key={lang.code}\n42\t            onClick={() => handleLanguageChange(lang.code)}\n43\t            className={`min-h-6 min-w-6 px-3 py-1.5 text-sm font-medium rounded-full transition-all duration-200 ${\n44\t              currentLanguage === lang.code\n45\t                ? \"bg-white dark:bg-stone-700 text-stone-900 dark:text-stone-100 shadow-xs\"\n46\t                : \"text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-200\"\n47\t            }`}\n48\t            aria-pressed={currentLanguage === lang.code}\n49\t            aria-label={`Switch to ${lang.label}`}\n50\t          >\n51\t            {lang.label}\n52\t          </button>\n53\t        ))}\n54\t      </nav>\n55\t\n56\t    </div>\n57\t  );\n58\t}\n59\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"e214bee3-232f-4b1b-8118-dc441d3da087","uuid":"3abc2edc-e41b-4a4b-b793-98aa7e9a3eb6","timestamp":"2026-04-14T05:42:02.409Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\components\\LanguageSwitcher.tsx","content":"\"use client\";\n\nimport type { Route } from \"next\";\nimport { useState } from \"react\";\nimport { useRouter } from \"next/navigation\";\nimport { setLanguagePreference } from \"@/app/actions/language\";\n\nconst LANGUAGES = [\n  { code: \"en\", label: \"EN\" },\n  { code: \"ms\", label: \"BM\", href: \"/ms/terma\" },\n  { code: \"zh\", label: \"中文\", href: \"/zh\" },\n];\n\nexport default function LanguageSwitcher() {\n  const [currentLanguage, setCurrentLanguage] = useState(\"en\");\n  const router = useRouter();\n\n  const handleLanguageChange = async (langCode: string) => {\n    setCurrentLanguage(langCode);\n\n    // Set the cookie\n    await setLanguagePreference(langCode);\n\n    // Navigate to BM content page\n    const lang = LANGUAGES.find((l) => l.code === langCode);\n    if (lang && \"href\" in lang && lang.href) {\n      router.push(lang.href as Route);\n      return;\n    }\n\n  };\n\n  return (\n    <div className=\"flex items-center gap-1 ml-4\">\n      <nav\n        className=\"flex gap-1 bg-stone-100 dark:bg-stone-800 rounded-full p-1\"\n        aria-label=\"Language selector\"\n      >\n        {LANGUAGES.map((lang) => (\n          <button\n            key={lang.code}\n            onClick={() => handleLanguageChange(lang.code)}\n            className={`min-h-6 min-w-6 px-3 py-1.5 text-sm font-medium rounded-full transition-all duration-200 ${\n              currentLanguage === lang.code\n                ? \"bg-white dark:bg-stone-700 text-stone-900 dark:text-stone-100 shadow-xs\"\n                : \"text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-200\"\n            }`}\n            aria-pressed={currentLanguage === lang.code}\n            aria-label={`Switch to ${lang.label}`}\n          >\n            {lang.label}\n          </button>\n        ))}\n      </nav>\n\n    </div>\n  );\n}\n","numLines":59,"startLine":1,"totalLines":59}}}
