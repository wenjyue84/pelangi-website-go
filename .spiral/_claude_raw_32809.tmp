@media (prefers-contrast: more) {\n+    select.select-base {\n+      border-width: 2px;\n+      border-color: var(--color-stone-700, #44403c);\n+    }\n+\n+    @media (prefers-color-scheme: dark) {\n+      select.select-base {\n+        border-color: var(--color-stone-500, #78716c);\n+      }\n+    }\n+  }\n+\n+  @media (forced-colors: active) {\n+    select.select-base {\n+      border: 1px solid ButtonText;\n+      background-color: ButtonFace;\n+      color: ButtonText;\n+      forced-color-adjust: none;\n+    }\n+\n+    select.select-base:hover {\n+      background-color: Highlight;\n+      color: HighlightText;\n+    }\n+  }\n+}\n+\n /* Custom scrollbar */\n ::-webkit-scrollbar {\n   width: 8px;\ndiff --git a/site/src/components/BookingForm.tsx b/site/src/components/BookingForm.tsx\nindex ec3f847..e720c41 100644\n--- a/site/src/components/BookingForm.tsx\n+++ b/site/src/components/BookingForm.tsx\n@@ -189,9 +189,7 @@ export default function BookingForm() {\n                 id=\"room-type\"\n                 value={roomType}\n                 onChange={(e) => setRoomType(e.target.value)}\n-                className=\"w-full rounded-xl border border-stone-500 dark:border-stone-600 bg-stone-50 dark:bg-stone-800\n-                           text-stone-900 dark:text-stone-100 px-4 py-3 text-sm\n-                           focus-visible:border-amber-500\"\n+                className=\"select-base w-full\"\n               >\n                 <option value=\"Capsule Pod\">Capsule Pod — RM35–45/night</option>\n[rerun: b16]","is_error":false}]},"parent_tool_use_id":null,"session_id":"e214bee3-232f-4b1b-8118-dc441d3da087","uuid":"3fa89b44-ac31-4e20-ad5f-c87dfc9b909e","timestamp":"2026-04-14T05:52:56.764Z","tool_use_result":{"stdout":"diff --git a/site/src/app/globals.css b/site/src/app/globals.css\nindex e099358..39aa4d9 100644\n--- a/site/src/app/globals.css\n+++ b/site/src/app/globals.css\n@@ -760,6 +760,81 @@ html.animations-paused *::after {\n   }\n }\n \n+/* =======