{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AD1eyDgDNB3UVEpxxYKhFa","type":"tool_result","content":"1\timport type { Metadata } from \"next\";\n2\timport { Suspense } from \"react\";\n3\timport { Inter, Playfair_Display } from \"next/font/google\";\n4\timport Script from \"next/script\";\n5\timport { GoogleTagManager } from \"@next/third-parties/google\";\n6\timport \"./globals.css\";\n7\timport StructuredData from \"@/components/StructuredData\";\n8\timport { SpeedInsights } from \"@vercel/speed-insights/next\";\n9\timport { ChatWidget, MobileBookingBar, CookieConsent, AnalyticsProvider, BookingRecoveryBanner, MetaPixelProvider, TikTokPixelProvider, PauseAnimationsButton } from \"@/components/DynamicComponents\";\n10\t\n11\tconst GTM_ID = process.env.NEXT_PUBLIC_GTM_ID ?? \"\";\n12\t\n13\tconst inter = Inter({ subsets: [\"latin\"], variable: \"--font-inter\" });\n14\tconst playfair = Playfair_Display({ subsets: [\"latin\"], variable: \"--font-playfair\" });\n15\t\n16\t// TODO: Create OG image at /images/og-image.jpg (1200x630px) for optimal social sharing\n17\t// Recommended: Feature hero image with \"Pelangi Capsule Hostel\" branding and \"From RM35/night\" text\n18\t\n19\texport const metadata: Metadata = {\n20\t  metadataBase: new URL(\"https://pelangicapsulehostel.com\"),\n21\t  title: {\n22\t    default: \"Pelangi Capsule Hostel | Budget Accommodation in Johor Bahru\",\n23\t    template: \"%s | Pelangi Capsule Hostel\",\n24\t  },\n25\t  description: \"Experience Japanese-style capsule accommodation in Taman Pelangi, Johor Bahru. Budget-friendly hostel from RM35/night with free WiFi, 24/7 access, hot showers, and personal lockers. Perfect base for Singapore day trips - just 30 minutes from the border.\",\n26\t  keywords: [\n27\t    \"capsule hostel Johor Bahru\",\n28\t    \"budget accommodation JB\",\n29\t    \"hostel near Singapore\",\n30\t    \"Taman Pelangi hostel\",\n31\t    \"cheap hostel JB\",\n32\t    \"backpacker accommodation Malaysia\",\n33\t    \"Japanese capsule hotel JB\",\n34\t    \"affordable hostel Johor\",\n35\t    \"pod hostel Malaysia\",\n36\t    \"budget stay near Singapore border\",\n37\t  ],\n38\t  robots: {\n39\t    index: true,\n40\t    follow: true,\n41\t    googleBot: {\n42\t      index: true,\n43\t      follow: true,\n44\t      \"max-video-preview\": -1,\n45\t      \"max-image-preview\": \"large\",\n46\t      \"max-snippet\": -1,\n47\t    },\n48\t  },\n49\t  alternates: {\n50\t    canonical: \"https://pelangicapsulehostel.com\",\n51\t    languages: {\n52\t      \"en\": \"https://pelangicapsulehostel.com\",\n53\t      \"ms\": \"https://pelangicapsulehostel.com/ms/terma\",\n54\t      \"x-default\": \"https://pelangicapsulehostel.com\",\n55\t      // \"zh-CN\": \"https://pelangicapsulehostel.com/zh\", // Enable when Chinese translation is ready\n56\t    },\n57\t    types: {\n58\t      \"application/rss+xml\": \"https://pelangicapsulehostel.com/feed.xml\",\n59\t      \"application/feed+json\": \"https://pelangicapsulehostel.com/feed.json\",\n60\t    },\n61\t  },\n62\t  openGraph: {\n63\t    title: \"Pelangi Capsule Hostel | Budget Accommodation in Johor Bahru\",\n64\t    description: \"Japanese-style capsule accommodation from RM35/night in Taman Pelangi, JB. Free WiFi, 24/7 access, hot showers. Perfect for Singapore day trips!\",\n65\t    url: \"https://pelangicapsulehostel.com\",\n66\t    siteName: \"Pelangi Capsule Hostel\",\n67\t    locale: \"en_MY\",\n68\t    type: \"website\",\n69\t    images: [\n70\t      {\n71\t        url: \"/images/og-image.png\",\n72\t        width: 1200,\n73\t        height: 630,\n74\t        alt: \"Pelangi Capsule Hostel - Modern Japanese-style pods in Johor Bahru\",\n75\t      },\n76\t      {\n77\t        url: \"/images/hero-main.webp\",\n78\t        width: 1920,\n79\t        height: 1080,\n80\t        alt: \"Pelangi Capsule Hostel interior view\",\n81\t      },\n82\t    ],\n83\t  },\n84\t  twitter: {\n85\t    card: \"summary_large_image\",\n86\t    title: \"Pelangi Capsule Hostel | From RM35/night in JB\",\n87\t    description: \"Japanese-style capsule hostel in Taman Pelangi, Johor Bahru. Budget-friendly, modern, and just 30 min from Singapore.\",\n88\t    images: [\"/images/og-image.png\"],\n89\t  },\n90\t  verification: {\n91\t    // Replace with actual token from Google Search Console > Add Property > HTML tag method\n92\t    google: \"REPLACE_WITH_GSC_VERIFICATION_TOKEN\",\n93\t  },\n94\t  other: {\n95\t    \"apple-mobile-web-app-status-bar-style\": \"black-translucent\",\n96\t  },\n97\t};\n98\t\n99\texport default function RootLayout({\n100\t  children,\n101\t}: Readonly<{\n102\t  children: React.ReactNode;\n103\t}>) {\n104\t  return (\n105\t    <html lang=\"en\" data-scroll-behavior=\"smooth\">\n106\t      <head>\n107\t        {/* Consent Mode v2: deny all consent parameters before GTM loads */}\n108\t        <Script\n109\t          id=\"consent-mode-defaults\"\n110\t          strategy=\"beforeInteractive\"\n111\t          dangerouslySetInnerHTML={{\n112\t            __html: `\n113\t              window.dataLayer = window.dataLayer || [];\n114\t              function gtag(){window.dataLayer.push(arguments);}\n115\t              gtag('consent', 'default', {\n116\t                ad_storage: 'denied',\n117\t                ad_user_data: 'denied',\n118\t                analytics_storage: 'denied',\n119\t                ad_personalization: 'denied',\n120\t                functionality_storage: 'denied',\n121\t                security_storage: 'granted'\n122\t              });`,\n123\t          }}\n124\t        />\n125\t        {/* Theme color: browser toolbar matches page background in light/dark mode */}\n126\t        <meta name=\"theme-color\" content=\"#fafaf9\" media=\"(prefers-color-scheme: light)\" />\n127\t        <meta name=\"theme-color\" content=\"#1c1917\" media=\"(prefers-color-scheme: dark)\" />\n128\t        {/* Preconnect: YouTube embed and Google Maps iframe */}\n129\t        <link rel=\"preconnect\" href=\"https://www.youtube.com\" />\n130\t        <link rel=\"preconnect\" href=\"https://www.google.com\" />\n131\t        {/* OpenSearch: enables browser address bar search */}\n132\t        <link rel=\"search\" type=\"application/opensearchdescription+xml\" title=\"Pelangi Hostel\" href=\"/opensearch.xml\" />\n133\t        {/* llms.txt: AI crawler content guidance */}\n134\t        <link rel=\"alternate\" type=\"text/plain\" href=\"/llms.txt\" />\n135\t        {/* JSON Feed: modern JSON alternative to RSS for blog syndication */}\n136\t        <link rel=\"alternate\" type=\"application/feed+json\" title=\"Pelangi Blog\" href=\"/feed.json\" />\n137\t        {/* SVG favicon: sharp rendering on modern browsers, ICO/PNG fallbacks auto-detected from app/ */}\n138\t        <link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\" />\n139\t        {/* DNS-prefetch: Trip.com CDN for review/OTA images (cold path) */}\n140\t        <link rel=\"dns-prefetch\" href=\"https://ak-d.tripcdn.com\" />\n141\t        {/* Speculation Rules: prerender high-conversion pages on hover (Chrome/Edge only, ignored by others) */}\n142\t        <script\n143\t          type=\"speculationrules\"\n144\t          dangerouslySetInnerHTML={{\n145\t            __html: JSON.stringify({\n146\t              prerender: [\n147\t                {\n148\t                  urls: [\"/book\", \"/rooms\", \"/gallery\"],\n149\t                  eagerness: \"moderate\",\n150\t                },\n151\t              ],\n152\t            }),\n153\t          }}\n154\t        />\n155\t        {/* Preload LCP hero image — srcset matches Next.js Image optimization breakpoints */}\n156\t        <link\n157\t          rel=\"preload\"\n158\t          as=\"image\"\n159\t          fetchPriority=\"high\"\n160\t          imageSrcSet=\"/_next/image?url=%2Fimages%2Fhero-final.png&w=640&q=75 640w, /_next/image?url=%2Fimages%2Fhero-final.png&w=750&q=75 750w, /_next/image?url=%2Fimages%2Fhero-final.png&w=828&q=75 828w, /_next/image?url=%2Fimages%2Fhero-final.png&w=1080&q=75 1080w, /_next/image?url=%2Fimages%2Fhero-final.png&w=1200&q=75 1200w, /_next/image?url=%2Fimages%2Fhero-final.png&w=1920&q=75 1920w, /_next/image?url=%2Fimages%2Fhero-final.png&w=2048&q=75 2048w, /_next/image?url=%2Fimages%2Fhero-final.png&w=3840&q=75 3840w\"\n161\t          imageSizes=\"100vw\"\n162\t        />\n163\t      </head>\n164\t      <body className={`${inter.variable} ${playfair.variable} pb-16 md:pb-0`}>\n165\t        {GTM_ID && <GoogleTagManager gtmId={GTM_ID} />}\n166\t        <a\n167\t          href=\"#main-content\"\n168\t          className=\"sr-only focus:not-sr-only focus:absolute focus:z-100 focus:top-4 focus:left-4 focus:px-4 focus:py-2 focus:bg-amber-700 focus:text-white focus:rounded-lg focus:font-medium focus:shadow-lg\"\n169\t        >\n170\t          Skip to main content\n171\t        </a>\n172\t        <StructuredData />\n173\t        <Suspense>{children}</Suspense>\n174\t        <MobileBookingBar />\n175\t        <BookingRecoveryBanner />\n176\t        <ChatWidget />\n177\t        <PauseAnimationsButton />\n178\t        <CookieConsent />\n179\t        <AnalyticsProvider />\n180\t        <MetaPixelProvider />\n181\t        <TikTokPixelProvider />\n182\t        <SpeedInsights />\n183\t      </body>\n184\t    </html>\n185\t  );\n186\t}\n187\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"b89af735-9d99-4e67-a035-466b094aa587","uuid":"e84ca291-ab38-43e5-8522-b6a853a8d94f","timestamp":"2026-04-13T21:41:14.204Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\app\\layout.tsx","content":"import type { Metadata } from \"next\";\nimport { Suspense } from \"react\";\nimport { Inter, Playfair_Display } from \"next/font/google\";\nimport Script from \"next/script\";\nimport { GoogleTagManager } from \"@next/third-parties/google\";\nimport \"./globals.css\";\nimport StructuredData from \"@/components/StructuredData\";\nimport { SpeedInsights } from \"@vercel/speed-insights/next\";\nimport { ChatWidget, MobileBookingBar, CookieConsent, AnalyticsProvider, BookingRecoveryBanner, MetaPixelProvider, TikTokPixelProvider, PauseAnimationsButton } from \"@/components/DynamicComponents\";\n\nconst GTM_ID = process.env.NEXT_PUBLIC_GTM_ID ?? \"\";\n\nconst inter = Inter({ subsets: [\"latin\"], variable: \"--font-inter\" });\nconst playfair = Playfair_Display({ subsets: [\"latin\"], variable: \"--font-playfair\" });\n\n// TODO: Create OG image at /images/og-image.jpg (1200x630px) for optimal social sharing\n// Recommended: Feature hero image with \"Pelangi Capsule Hostel\" branding and \"From RM35/night\" text\n\nexport const metadata: Metadata = {\n  metadataBase: new URL(\"https://pelangicapsulehostel.com\"),\n  title: {\n    default: \"Pelangi Capsule Hostel | Budget Accommodation in Johor Bahru\",\n    template: \"%s | Pelangi Capsule Hostel\",\n  },\n  description: \"Experience Japanese-style capsule accommodation in Taman Pelangi, Johor Bahru. Budget-friendly hostel from RM35/night with free WiFi, 24/7 access, hot showers, and personal lockers. Perfect base for Singapore day trips - just 30 minutes from the border.\",\n  keywords: [\n    \"capsule hostel Johor Bahru\",\n    \"budget accommodation JB\",\n    \"hostel near Singapore\",\n    \"Taman Pelangi hostel\",\n    \"cheap hostel JB\",\n    \"backpacker accommodation Malaysia\",\n    \"Japanese capsule hotel JB\",\n    \"affordable hostel Johor\",\n    \"pod hostel Malaysia\",\n    \"budget stay near Singapore border\",\n  ],\n  robots: {\n    index: true,\n    follow: true,\n    googleBot: {\n      index: true,\n      follow: true,\n      \"max-video-preview\": -1,\n      \"max-image-preview\": \"large\",\n      \"max-snippet\": -1,\n    },\n  },\n  alternates: {\n    canonical: \"https://pelangicapsulehostel.com\",\n    languages: {\n      \"en\": \"https://pelangicapsulehostel.com\",\n      \"ms\": \"https://pelangicapsulehostel.com/ms/terma\",\n      \"x-default\": \"https://pelangicapsulehostel.com\",\n      // \"zh-CN\": \"https://pelangicapsulehostel.com/zh\", // Enable when Chinese translation is ready\n    },\n    types: {\n      \"application/rss+xml\": \"https://pelangicapsulehostel.com/feed.xml\",\n      \"application/feed+json\": \"https://pelangicapsulehostel.com/feed.json\",\n    },\n  },\n  openGraph: {\n    title: \"Pelangi Capsule Hostel | Budget Accommodation in Johor Bahru\",\n    description: \"Japanese-style capsule accommodation from RM35/night in Taman Pelangi, JB. Free WiFi, 24/7 access, hot showers. Perfect for Singapore day trips!\",\n    url: \"https://pelangicapsulehostel.com\",\n    siteName: \"Pelangi Capsule Hostel\",\n    locale: \"en_MY\",\n    type: \"website\",\n    images: [\n      {\n        url: \"/images/og-image.png\",\n        width: 1200,\n        height: 630,\n        alt: \"Pelangi Capsule Hostel - Modern Japanese-style pods in Johor Bahru\",\n      },\n      {\n        url: \"/images/hero-main.webp\",\n        width: 1920,\n        height: 1080,\n        alt: \"Pelangi Capsule Hostel interior view\",\n      },\n    ],\n  },\n  twitter: {\n    card: \"summary_large_image\",\n    title: \"Pelangi Capsule Hostel | From RM35/night in JB\",\n    description: \"Japanese-style capsule hostel in Taman Pelangi, Johor Bahru. Budget-friendly, modern, and just 30 min from Singapore.\",\n    images: [\"/images/og-image.png\"],\n  },\n  verification: {\n    // Replace with actual token from Google Search Console > Add Property > HTML tag method\n    google: \"REPLACE_WITH_GSC_VERIFICATION_TOKEN\",\n  },\n  other: {\n    \"apple-mobile-web-app-status-bar-style\": \"black-translucent\",\n  },\n};\n\nexport default function RootLayout({\n  children,\n}: Readonly<{\n  children: React.ReactNode;\n}>) {\n  return (\n    <html lang=\"en\" data-scroll-behavior=\"smooth\">\n      <head>\n        {/* Consent Mode v2: deny all consent parameters before GTM loads */}\n        <Script\n          id=\"consent-mode-defaults\"\n          strategy=\"beforeInteractive\"\n          dangerouslySetInnerHTML={{\n            __html: `\n              window.dataLayer = window.dataLayer || [];\n              function gtag(){window.dataLayer.push(arguments);}\n              gtag('consent', 'default', {\n                ad_storage: 'denied',\n                ad_user_data: 'denied',\n                analytics_storage: 'denied',\n                ad_personalization: 'denied',\n                functionality_storage: 'denied',\n                security_storage: 'granted'\n              });`,\n          }}\n        />\n        {/* Theme color: browser toolbar matches page background in light/dark mode */}\n        <meta name=\"theme-color\" content=\"#fafaf9\" media=\"(prefers-color-scheme: light)\" />\n        <meta name=\"theme-color\" content=\"#1c1917\" media=\"(prefers-color-scheme: dark)\" />\n        {/* Preconnect: YouTube embed and Google Maps iframe */}\n        <link rel=\"preconnect\" href=\"https://www.youtube.com\" />\n        <link rel=\"preconnect\" href=\"https://www.google.com\" />\n        {/* OpenSearch: enables browser address bar search */}\n        <link rel=\"search\" type=\"application/opensearchdescription+xml\" title=\"Pelangi Hostel\" href=\"/opensearch.xml\" />\n        {/* llms.txt: AI crawler content guidance */}\n        <link rel=\"alternate\" type=\"text/plain\" href=\"/llms.txt\" />\n        {/* JSON Feed: modern JSON alternative to RSS for blog syndication */}\n        <link rel=\"alternate\" type=\"application/feed+json\" title=\"Pelangi Blog\" href=\"/feed.json\" />\n        {/* SVG favicon: sharp rendering on modern browsers, ICO/PNG fallbacks auto-detected from app/ */}\n        <link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\" />\n        {/* DNS-prefetch: Trip.com CDN for review/OTA images (cold path) */}\n        <link rel=\"dns-prefetch\" href=\"https://ak-d.tripcdn.com\" />\n        {/* Speculation Rules: prerender high-conversion pages on hover (Chrome/Edge only, ignored by others) */}\n        <script\n          type=\"speculationrules\"\n          dangerouslySetInnerHTML={{\n            __html: JSON.stringify({\n              prerender: [\n                {\n                  urls: [\"/book\", \"/rooms\", \"/gallery\"],\n                  eagerness: \"moderate\",\n                },\n              ],\n            }),\n          }}\n        />\n        {/* Preload LCP hero image — srcset matches Next.js Image optimization breakpoints */}\n        <link\n          rel=\"preload\"\n          as=\"image\"\n          fetchPriority=\"high\"\n          imageSrcSet=\"/_next/image?url=%2Fimages%2Fhero-final.png&w=640&q=75 640w, /_next/image?url=%2Fimages%2Fhero-final.png&w=750&q=75 750w, /_next/image?url=%2Fimages%2Fhero-final.png&w=828&q=75 828w, /_next/image?url=%2Fimages%2Fhero-final.png&w=1080&q=75 1080w, /_next/image?url=%2Fimages%2Fhero-final.png&w=1200&q=75 1200w, /_next/image?url=%2Fimages%2Fhero-final.png&w=1920&q=75 1920w, /_next/image?url=%2Fimages%2Fhero-final.png&w=2048&q=75 2048w, /_next/image?url=%2Fimages%2Fhero-final.png&w=3840&q=75 3840w\"\n          imageSizes=\"100vw\"\n        />\n      </head>\n      <body className={`${inter.variable} ${playfair.variable} pb-16 md:pb-0`}>\n        {GTM_ID && <GoogleTagManager gtmId={GTM_ID} />}\n        <a\n          href=\"#main-content\"\n          className=\"sr-only focus:not-sr-only focus:absolute focus:z-100 focus:top-4 focus:left-4 focus:px-4 focus:py-2 focus:bg-amber-700 focus:text-white focus:rounded-lg focus:font-medium focus:shadow-lg\"\n        >\n          Skip to main content\n        </a>\n        <StructuredData />\n        <Suspense>{children}</Suspense>\n        <MobileBookingBar />\n        <BookingRecoveryBanner />\n        <ChatWidget />\n        <PauseAnimationsButton />\n        <CookieConsent />\n        <AnalyticsProvider />\n        <MetaPixelProvider />\n        <TikTokPixelProvider />\n        <SpeedInsights />\n      </body>\n    </html>\n  );\n}\n","numLines":187,"startLine":1,"totalLines":187}}}
