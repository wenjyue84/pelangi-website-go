{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01U45F8BeQpAYQ5HUDX9iS1G","type":"tool_result","content":"1\timport Link from \"next/link\";\n2\timport Header from \"@/components/Header\";\n3\timport Footer from \"@/components/Footer\";\n4\timport PaymentStatus from \"@/components/PaymentStatus\";\n5\timport type { Metadata } from \"next\";\n6\t\n7\texport const metadata: Metadata = {\n8\t  title: \"Booking Confirmed | Pelangi Capsule Hostel JB\",\n9\t  description:\n10\t    \"Your booking deposit has been received. Check your confirmation details and prepare for your stay at Pelangi Capsule Hostel Johor Bahru.\",\n11\t  robots: { index: false, follow: false },\n12\t};\n13\t\n14\texport default function BookingConfirmationPage() {\n15\t  return (\n16\t    <main id=\"main-content\" className=\"min-h-screen bg-stone-50 dark:bg-stone-950\">\n17\t      <Header />\n18\t\n19\t      <section className=\"pt-28 pb-16 container-custom\">\n20\t        <div className=\"max-w-lg mx-auto\">\n21\t          <PaymentStatus />\n22\t\n23\t          {/* Next Steps */}\n24\t          <div className=\"mt-8 bg-white dark:bg-stone-900 rounded-3xl p-8 shadow-lg border border-stone-100 dark:border-stone-700\">\n25\t            <h2 className=\"font-display text-lg font-medium text-stone-900 dark:text-stone-100 mb-4\">\n26\t              What&apos;s Next?\n27\t            </h2>\n28\t            <ol className=\"space-y-4 text-sm text-stone-600 dark:text-stone-400\">\n29\t              <li className=\"flex gap-3\">\n30\t                <span className=\"w-6 h-6 rounded-full bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400 flex items-center justify-center shrink-0 text-xs font-bold\">\n31\t                  1\n32\t                </span>\n33\t                <span>\n34\t                  <strong className=\"text-stone-800 dark:text-stone-200\">Check your email</strong> — a payment receipt\n35\t                  from Stripe will arrive shortly.\n36\t   