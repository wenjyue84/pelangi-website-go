{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BAyP1KVUNCoruJe3dHe95L","type":"tool_result","content":"1\timport { NextRequest, NextResponse } from \"next/server\";\n2\timport { logPageView } from \"@/lib/server-analytics\";\n3\timport { getVariant } from \"@/lib/flags\";\n4\t\n5\t// ---------------------------------------------------------------------------\n6\t// In-memory sliding window rate limiter\n7\t// Works for single-instance deployments (e.g., Lightsail with `next start`).\n8\t// For multi-instance / edge deployments, replace with @upstash/ratelimit.\n9\t// ---------------------------------------------------------------------------\n10\t\n11\tinterface WindowEntry {\n12\t  timestamps: number[];\n13\t}\n14\t\n15\t// Module-level Map persists across requests within the same process.\n16\tconst store = new Map<string, WindowEntry>();\n17\t\n18\tfunction getIp(req: NextRequest): string {\n19\t  return (\n20\t    req.headers.get(\"x-forwarded-for\")?.split(\",\")[0].trim() ||\n21\t    req.headers.get(\"x-real-ip\") ||\n22\t    \"unknown\"\n23\t  );\n24\t}\n25\t\n26\t/**\n27\t * Sliding window check.\n28\t * @returns allowed, remaining count, and reset time (Unix seconds).\n29\t */\n30\tfunction slidingWindow(\n31\t  key: string,\n32\t  limit: number,\n33\t  windowMs: number\n34\t): { allowed: boolean; remaining: number; reset: number } {\n35\t  const now = Date.now();\n36\t  const windowStart = now - windowMs;\n37\t\n38\t  let entry = store.get(key);\n39\t  if (!entry) {\n40\t    entry = { timestamps: [] };\n41\t    store.set(key, entry);\n42\t  }\n43\t\n44\t  // Evict timestamps outside the current window\n45\t  entry.timestamps = entry.timestamps.filter((ts) => ts > windowStart);\n46\t\n47\t  // Reset is the moment the oldest request in this window expires\n48\t  const oldestTs = entry.timestamps[0];\n49\t  const reset = oldestTs\n50\t    ? Math.ceil((oldestTs + windowMs) / 1000)\n51\t    : Math.ceil((now + windowMs) / 1000);\n52\t\n53\t  if (entry.timestamps.length >= limit) {\n54\t    return { allowed: false, remaining: 0, reset };\n55\t  }\n56\t\n57\t  entry.timestamps.push(now);\n58\t  const remaining = limit - entry.timestamps.length;\n59\t  return { allowed: true, remaining, reset };\n60\t}\n61\t\n62\t// ---------------------------------------------------------------------------\n63\t// Rate-limit configuration\n64\t// ---------------------------------------------------------------------------\n65\t\n66\tconst RATE_LIMIT_ROUTES: Array<{ prefix: string; limit: number }> = [\n67\t  { prefix: \"/api/public/\", limit: 30 },\n68\t  { prefix: \"/api/chat/\", limit: 20 },\n69\t];\n70\t\n71\tconst WINDOW_MS = 60 * 1000; // 1 minute\n72\t\n73\t// ---------------------------------------------------------------------------\n74\t// Proxy (renamed from middleware in Next.js 16)\n75\t// ---------------------------------------------------------------------------\n76\t\n77\texport async function proxy(req: NextRequest): Promise<NextResponse> {\n78\t  const { pathname } = req.nextUrl;\n79\t\n80\t  // --- Deferred page view logging (read headers before deferring) ---\n81\t  const userAgent = req.headers.get(\"user-agent\") ?? \"\";\n82\t  const ip =\n83\t    req.headers.get(\"x-forwarded-for\")?.split(\",\")[0].trim() ??\n84\t    req.headers.get(\"x-real-ip\") ??\n85\t    \"0.0.0.0\";\n86\t  const referrer = req.headers.get(\"referer\") ?? \"\";\n87\t  logPageView({ path: pathname, userAgent, ip, referrer, timestamp: new Date().toISOString() });\n88\t\n89\t  // --- Rate limiting (API routes only) ---\n90\t  const route = RATE_LIMIT_ROUTES.find((r) => pathname.startsWith(r.prefix));\n91\t\n92\t  if (route) {\n93\t    const ip = getIp(req);\n94\t    const key = `${route.prefix}${ip}`;\n95\t    const { allowed, remaining, reset } = slidingWindow(key, route.limit, WINDOW_MS);\n96\t\n97\t    const rateLimitHeaders: Record<string, string> = {\n98\t      \"X-RateLimit-Limit\": route.limit.toString(),\n99\t      \"X-RateLimit-Remaining\": remaining.toString(),\n100\t      \"X-RateLimit-Reset\": reset.toString(),\n101\t    };\n102\t\n103\t    if (!allowed) {\n104\t      const retryAfter = (reset - Math.floor(Date.now() / 1000)).toString();\n105\t      return new NextResponse(\"Too Many Requests\", {\n106\t        status: 429,\n107\t        headers: {\n108\t          \"Content-Type\": \"text/plain\",\n109\t          \"X-Content-Type-Options\": \"nosniff\",\n110\t          \"Retry-After\": retryAfter,\n111\t          ...rateLimitHeaders,\n112\t          \"X-RateLimit-Remaining\": \"0\",\n113\t        },\n114\t      });\n115\t    }\n116\t\n117\t    const res = NextResponse.next();\n118\t    for (const [k, v] of Object.entries(rateLimitHeaders)) {\n119\t      res.headers.set(k, v);\n120\t    }\n121\t    return res;\n122\t  }\n123\t\n124\t  // --- A/B testing: Evaluate CTA variant flag for /book page ---\n125\t  const response = NextResponse.next();\n126\t  if (pathname.startsWith(\"/book\")) {\n127\t    const variant = await getVariant();\n128\t    response.headers.set(\"x-variant\", variant);\n129\t    response.cookies.set(\"x-variant\", variant, {\n130\t      httpOnly: false, // Allow client JS to read for GA4 tracking\n131\t      path: \"/\",\n132\t      maxAge: 30 * 24 * 60 * 60, // 30 days\n133\t      sameSite: \"lax\",\n134\t    });\n135\t  }\n136\t\n137\t  return response;\n138\t}\n139\t\n140\texport const config = {\n141\t  matcher: [\n142\t    // Match all routes except static files, images, and Next.js internals\n143\t    {\n144\t      source: \"/((?!_next/static|_next/image|favicon\\\\.ico).*)\",\n145\t      missing: [\n146\t        { type: \"header\", key: \"next-router-prefetch\" },\n147\t        { type: \"header\", key: \"purpose\", value: \"prefetch\" },\n148\t      ],\n149\t    },\n150\t  ],\n151\t};\n152\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"f1598b8b-caeb-4a6a-b0e7-f4e096d8800b","uuid":"fdd8479a-f194-4cbb-8ecc-de8fa968a9aa","timestamp":"2026-04-14T07:01:11.974Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\proxy.ts","content":"import { NextRequest, NextResponse } from \"next/server\";\nimport { logPageView } from \"@/lib/server-analytics\";\nimport { getVariant } from \"@/lib/flags\";\n\n// ---------------------------------------------------------------------------\n// In-memory sliding window rate limiter\n// Works for single-instance deployments (e.g., Lightsail with `next start`).\n// For multi-instance / edge deployments, replace with @upstash/ratelimit.\n// ---------------------------------------------------------------------------\n\ninterface WindowEntry {\n  timestamps: number[];\n}\n\n// Module-level Map persists across requests within the same process.\nconst store = new Map<string, WindowEntry>();\n\nfunction getIp(req: NextRequest): string {\n  return (\n    req.headers.get(\"x-forwarded-for\")?.split(\",\")[0].trim() ||\n    req.headers.get(\"x-real-ip\") ||\n    \"unknown\"\n  );\n}\n\n/**\n * Sliding window check.\n * @returns allowed, remaining count, and reset time (Unix seconds).\n */\nfunction slidingWindow(\n  key: string,\n  limit: number,\n  windowMs: number\n): { allowed: boolean; remaining: number; reset: number } {\n  const now = Date.now();\n  const windowStart = now - windowMs;\n\n  let entry = store.get(key);\n  if (!entry) {\n    entry = { timestamps: [] };\n    store.set(key, entry);\n  }\n\n  // Evict timestamps outside the current window\n  entry.timestamps = entry.timestamps.filter((ts) => ts > windowStart);\n\n  // Reset is the moment the oldest request in this window expires\n  const oldestTs = entry.timestamps[0];\n  const reset = oldestTs\n    ? Math.ceil((oldestTs + windowMs) / 1000)\n    : Math.ceil((now + windowMs) / 1000);\n\n  if (entry.timestamps.length >= limit) {\n    return { allowed: false, remaining: 0, reset };\n  }\n\n  entry.timestamps.push(now);\n  const remaining = limit - entry.timestamps.length;\n  return { allowed: true, remaining, reset };\n}\n\n// ---------------------------------------------------------------------------\n// Rate-limit configuration\n// ---------------------------------------------------------------------------\n\nconst RATE_LIMIT_ROUTES: Array<{ prefix: string; limit: number }> = [\n  { prefix: \"/api/public/\", limit: 30 },\n  { prefix: \"/api/chat/\", limit: 20 },\n];\n\nconst WINDOW_MS = 60 * 1000; // 1 minute\n\n// ---------------------------------------------------------------------------\n// Proxy (renamed from middleware in Next.js 16)\n// ---------------------------------------------------------------------------\n\nexport async function proxy(req: NextRequest): Promise<NextResponse> {\n  const { pathname } = req.nextUrl;\n\n  // --- Deferred page view logging (read headers before deferring) ---\n  const userAgent = req.headers.get(\"user-agent\") ?? \"\";\n  const ip =\n    req.headers.get(\"x-forwarded-for\")?.split(\",\")[0].trim() ??\n    req.headers.get(\"x-real-ip\") ??\n    \"0.0.0.0\";\n  const referrer = req.headers.get(\"referer\") ?? \"\";\n  logPageView({ path: pathname, userAgent, ip, referrer, timestamp: new Date().toISOString() });\n\n  // --- Rate limiting (API routes only) ---\n  const route = RATE_LIMIT_ROUTES.find((r) => pathname.startsWith(r.prefix));\n\n  if (route) {\n    const ip = getIp(req);\n    const key = `${route.prefix}${ip}`;\n    const { allowed, remaining, reset } = slidingWindow(key, route.limit, WINDOW_MS);\n\n    const rateLimitHeaders: Record<string, string> = {\n      \"X-RateLimit-Limit\": route.limit.toString(),\n      \"X-RateLimit-Remaining\": remaining.toString(),\n      \"X-RateLimit-Reset\": reset.toString(),\n    };\n\n    if (!allowed) {\n      const retryAfter = (reset - Math.floor(Date.now() / 1000)).toString();\n      return new NextResponse(\"Too Many Requests\", {\n        status: 429,\n        headers: {\n          \"Content-Type\": \"text/plain\",\n          \"X-Content-Type-Options\": \"nosniff\",\n          \"Retry-After\": retryAfter,\n          ...rateLimitHeaders,\n          \"X-RateLimit-Remaining\": \"0\",\n        },\n      });\n    }\n\n    const res = NextResponse.next();\n    for (const [k, v] of Object.entries(rateLimitHeaders)) {\n      res.headers.set(k, v);\n    }\n    return res;\n  }\n\n  // --- A/B testing: Evaluate CTA variant flag for /book page ---\n  const response = NextResponse.next();\n  if (pathname.startsWith(\"/book\")) {\n    const variant = await getVariant();\n    response.headers.set(\"x-variant\", variant);\n    response.cookies.set(\"x-variant\", variant, {\n      httpOnly: false, // Allow client JS to read for GA4 tracking\n      path: \"/\",\n      maxAge: 30 * 24 * 60 * 60, // 30 days\n      sameSite: \"lax\",\n    });\n  }\n\n  return response;\n}\n\nexport const config = {\n  matcher: [\n    // Match all routes except static files, images, and Next.js internals\n    {\n      source: \"/((?!_next/static|_next/image|favicon\\\\.ico).*)\",\n      missing: [\n        { type: \"header\", key: \"next-router-prefetch\" },\n        { type: \"header\", key: \"purpose\", value: \"prefetch\" },\n      ],\n    },\n  ],\n};\n","numLines":152,"startLine":1,"totalLines":152}}}
