11.821 0 00-3.48-8.413z\" />\n166\t            </svg>\n167\t            {ctaText}\n168\t          </a>\n169\t          <p className=\"text-amber-300 text-sm mt-4\">\n170\t            Replies within minutes during 8 AM – 10 PM\n171\t          </p>\n172\t\n173\t          {/* Mobile-first trust signals & price comparison — above the fold */}\n174\t          <HeroTrustBadges />\n175\t        </div>\n176\t      </section>\n177\t\n178\t      {/* Pricing Section */}\n179\t      <section className=\"py-16 container-custom\">\n180\t        <div className=\"max-w-4xl mx-auto\">\n181\t          <div className=\"text-center mb-12\">\n182\t            <p className=\"text-xs font-medium tracking-[0.3em] uppercase text-amber-700 dark:text-amber-400 mb-3\">\n183\t              Transparent Pricing\n184\t            </p>\n185\t            <h2 className=\"font-display text-3xl md:text-4xl font-medium text-stone-900 dark:text-stone-100\">\n186\t              Simple, Honest Rates\n187\t            </h2>\n188\t          </div>\n189\t\n190\t          <div className=\"grid md:grid-cols-2 gap-6\">\n191\t            {/* Nightly */}\n192\t            <div className=\"bg-white dark:bg-stone-900 rounded-3xl p-8 shadow-lg border border-stone-100 dark:border-stone-700 text-center\">\n193\t              <div className=\"text-xs tracking-widest uppercase text-stone-500 dark:text-stone-400 mb-2\">Nightly Stay</div>\n194\t              <div className=\"flex items-baseline justify-center gap-1 mb-4\">\n195\t                <span className=\"font-display text-5xl font-medium text-stone-900 dark:text-stone-100\">RM35</span>\n196\t                <span className=\"text-stone-500 dark:text-stone-400\">–</span>\n197\t                <span className=\"font-display text-5xl font-medium text-stone-900 dark:text-stone-100\">45</span>\n198\t                <span className=\"text-stone-500 dark:text-stone-400 ml-1\">/night</span>\n199\t              </div>\n200\t              <div className=\"text-sm text-stone-500 dark:text-stone-400 mb-2 space-y-1\">\n201\t                <div className=\"flex items-center justify-center gap-1.5\">\n202\t                  <span>+ Service Tax (SST) 8%</span>\n203\t                </div>\n204\t                <div className=\"flex items-center justify-center gap-1.5\">\n205\t                  <span>+ Tourism Tax (TTx): RM10/room/night</span>\n206\t                  <a\n207\t                    href=\"https://www.myttx.customs.gov.my/\"\n208\t                    target=\"_blank\"\n209\t                    rel=\"noopener noreferrer\"\n210\t                    aria-label=\"Learn more about Malaysia Tourism Tax (TTx)\"\n211\t                    className=\"text-amber-600 dark:text-amber-400 hover:text-amber-700 dark:hover:text-amber-300\"\n212\t                  >\n213\t                    <svg className=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n214\t                      <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\" />\n215\t                    </svg>\n216\t                  </a>\n217\t                </div>\n218\t              </div>\n219\t              <p className=\"text-stone-500 dark:text-stone-400 text-sm mb-6\">\n220\t                Per person, per night. Price varies by day and season.\n221\t              </p>\n222\t              <ul className=\"text-left space-y-3 text-sm text-stone-600 dark:text-stone-400\">\n223\t                <li className=\"flex items-center gap-2\">\n224\t                  <svg className=\"w-5 h-5 text-green-500 shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M5 13l4 4L19 7\" /></svg>\n225\t                  Private capsule pod with door\n226\t                </li>\n227\t                <li className=\"flex items-center gap-2\">\n228\t                  <svg className=\"w-5 h-5 text-green-500 shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M5 13l4 4L19 7\" /></svg>\n229\t                  Free WiFi, A/C, personal locker\n230\t                </li>\n231\t                <li className=\"flex items-center gap-2\">\n232\t                  <svg className=\"w-5 h-5 text-green-500 shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M5 13l4 4L19 7\" /></svg>\n233\t                  Shared kitchen & laundry access\n234\t                </li>\n235\t              </ul>\n236\t            </div>\n237\t\n238\t            {/* Monthly */}\n239\t            <div className=\"bg-amber-50 dark:bg-amber-900/20 rounded-3xl p-8 shadow-lg border border-amber-200 dark:border-amber-700 text-center relative\">\n240\t              <div className=\"absolute -top-3 left-1/2 -translate-x-1/2 bg-amber-600 text-white text-xs font-bold px-4 py-1 rounded-full uppercase tracking-wider\">\n241\t                Best Value\n242\t              </div>\n243\t              <div className=\"text-xs tracking-widest uppercase text-amber-700 dark:text-amber-400 mb-2\">Monthly Stay</div>\n244\t              <div className=\"flex items-baseline justify-center gap-1 mb-4\">\n245\t                <span className=\"font-display text-5xl font-medium text-stone-900 dark:text-stone-100\">RM594</span>\n246\t                <span className=\"text-stone-500 dark:text-stone-400 ml-1\">/month</span>\n247\t              </div>\n248\t              <div className=\"text-sm text-stone-500 dark:text-stone-400 mb-2 space-y-1\">\n249\t                <div className=\"flex items-center justify-center gap-1.5\">\n250\t                  <span>+ Service Tax (SST) 8%</span>\n251\t                </div>\n252\t                <div className=\"flex items-center justify-center gap-1.5\">\n253\t                  <span>+ Tourism Tax (TTx): RM10/room/night</span>\n254\t                  <a\n255\t                    href=\"https://www.myttx.customs.gov.my/\"\n256\t                    target=\"_blank\"\n257\t                    rel=\"noopener noreferrer\"\n258\t                    aria-label=\"Learn more about Malaysia Tourism Tax (TTx)\"\n259\t                    className=\"text-amber-600 dark:text-amber-400 hover:text-amber-700 dark:hover:text-amber-300\"\n260\t                  >\n261\t                    <svg className=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n262\t                      <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\" />\n263\t                    </svg>\n264\t                  </a>\n265\t                </div>\n266\t              </div>\n267\t              <p className=\"text-stone-500 dark:text-stone-400 text-sm mb-6\">\n268\t                That&apos;s just RM19.80/night — save over 40% vs nightly rate.\n269\t              </p>\n270\t              <ul className=\"text-left space-y-3 text-sm text-stone-600 dark:text-stone-400\">\n271\t                <li className=\"flex items-center gap-2\">\n272\t                  <svg className=\"w-5 h-5 text-green-500 shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M5 13l4 4L19 7\" /></svg>\n273\t                  Everything in nightly stay\n274\t                </li>\n275\t                <li className=\"flex items-center gap-2\">\n276\t                  <svg className=\"w-5 h-5 text-green-500 shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M5 13l4 4L19 7\" /></svg>\n277\t                  Ideal for remote workers & digital nomads\n278\t                </li>\n279\t                <li className=\"flex items-center gap-2\">\n280\t                  <svg className=\"w-5 h-5 text-green-500 shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M5 13l4 4L19 7\" /></svg>\n281\t                  Flexible start date\n282\t                </li>\n283\t              </ul>\n284\t            </div>\n285\t          </div>\n286\t\n287\t          {/* Trust Signals */}\n288\t          <TrustSignals />\n289\t\n290\t          {/* Booking Form */}\n291\t          <div className=\"mt-12 max-w-md mx-auto\">\n292\t            <BookingForm />\n293\t          </div>\n294\t\n295\t          {/* Or divider */}\n296\t          <div className=\"mt-10 flex items-center gap-4 max-w-md mx-auto\">\n297\t            <div className=\"flex-1 border-t border-stone-200 dark:border-stone-700\" />\n298\t            <span className=\"text-xs font-medium text-stone-400 dark:text-stone-500 uppercase tracking-wider\">\n299\t              or pay deposit online\n300\t            </span>\n301\t            <div className=\"flex-1 border-t border-stone-200 dark:border-stone-700\" />\n302\t          </div>\n303\t\n304\t          {/* FPX Online Banking Payment */}\n305\t          <div className=\"mt-8 max-w-md mx-auto\">\n306\t            <FpxPaymentForm />\n307\t          </div>\n308\t        </div>\n309\t      </section>\n310\t\n311\t      {/* Why Book Direct */}\n312\t      <section className=\"py-16 bg-white dark:bg-stone-900\">\n313\t        <div className=\"container-custom\">\n314\t          <div className=\"text-center mb-12\">\n315\t            <p className=\"text-xs font-medium tracking-[0.3em] uppercase text-amber-700 dark:text-amber-400 mb-3\">\n316\t              Direct Booking Benefits\n317\t            </p>\n318\t            <h2 className=\"font-display text-3xl md:text-4xl font-medium text-stone-900 dark:text-stone-100\">\n319\t              Why Book Direct?\n320\t            </h2>\n321\t          </div>\n322\t\n323\t          <div className=\"grid sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-5xl mx-auto\">\n324\t            {directBenefits.map((benefit, index) => (\n325\t              <div\n326\t                key={index}\n327\t                className=\"bg-stone-50 dark:bg-stone-800 rounded-2xl p-6 text-center hover:bg-stone-100 dark:hover:bg-stone-700 transition-colors\"\n328\t              >\n329\t                <div className=\"w-14 h-14 rounded-2xl bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center mx-auto mb-4\">\n330\t                  <svg className=\"w-7 h-7 text-amber-700 dark:text-amber-400\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n331\t                    <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={1.5} d={benefit.icon} />\n332\t                  </svg>\n333\t                </div>\n334\t                <h3 className=\"font-semibold text-stone-900 dark:text-stone-100 mb-2\">{benefit.title}</h3>\n335\t                <p className=\"text-stone-500 dark:text-stone-400 text-sm\">{benefit.description}</p>\n336\t              </div>\n337\t            ))}\n338\t          </div>\n339\t\n340\t          {/* OTA vs Direct Savings Comparison Callout */}\n341\t          <div className=\"mt-12 max-w-3xl mx-auto bg-linear-to-r from-amber-50 to-orange-50 dark:from-stone-800 dark:to-stone-800 rounded-3xl p-8 border border-amber-200 dark:border-amber-700\">\n342\t            <p className=\"text-center text-xs font-medium tracking-[0.3em] uppercase text-amber-700 dark:text-amber-400 mb-6\">\n343\t              Price Comparison\n344\t            </p>\n345\t            <h3 className=\"font-display text-xl font-medium text-stone-900 dark:text-stone-100 text-center mb-6\">\n346\t              Direct vs OTA — What You Actually Pay\n347\t            </h3>\n348\t            <div className=\"grid sm:grid-cols-2 gap-4 mb-6\">\n349\t              {/* OTA column */}\n350\t              <div className=\"bg-white/70 dark:bg-stone-900/70 rounded-2xl p-5 border border-stone-200 dark:border-stone-700\">\n351\t                <div className=\"flex items-center gap-2 mb-3\">\n352\t                  <div className=\"w-7 h-7 rounded-lg bg-stone-100 flex items-center justify-center\">\n353\t                    <svg className=\"w-4 h-4 text-stone-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n354\t                      <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17H3a2 2 0 01-2-2V5a2 2 0 012-2h14a2 2 0 012 2v10a2 2 0 01-2 2h-2\" />\n355\t                    </svg>\n356\t                  </div>\n357\t                  <span className=\"font-medium text-stone-700 dark:text-stone-300\">Via Booking.com</span>\n358\t                </div>\n359\t                <div className=\"text-sm text-stone-600 dark:text-stone-400 space-y-1\">\n360\t                  <div className=\"flex justify-between\">\n361\t                    <span>Room rate</span>\n362\t                    <span className=\"font-medium\">RM40–48</span>\n363\t                  </div>\n364\t                  <div className=\"flex justify-between text-red-500\">\n365\t                    <span>Platform service fee</span>\n366\t                    <span className=\"font-medium\">+15–20%</span>\n367\t                  </div>\n368\t                  <div className=\"flex justify-between\">\n369\t                    <span>Service Tax (SST) 8%</span>\n370\t                    <span className=\"font-medium\">+8%</span>\n371\t                  </div>\n372\t                  <div className=\"flex justify-between\">\n373\t                    <span>Tourism Tax (TTx)</span>\n374\t                    <span className=\"font-medium\">RM10</span>\n375\t                  </div>\n376\t                  <div className=\"border-t border-stone-200 dark:border-stone-700 pt-2 mt-2 flex justify-between font-semibold text-stone-800 dark:text-stone-200\">\n377\t                    <span>You pay</span>\n378\t                    <span>~RM60–73/night</span>\n379\t                  </div>\n380\t                </div>\n381\t              </div>\n382\t\n383\t              {/* Direct column */}\n384\t              <div className=\"bg-green-50 dark:bg-green-900/20 rounded-2xl p-5 border border-green-200 dark:border-green-800\">\n385\t                <div className=\"flex items-center gap-2 mb-3\">\n386\t                  <div className=\"w-7 h-7 rounded-lg bg-green-100 flex items-center justify-center\">\n387\t                    <svg className=\"w-4 h-4 text-green-600\" fill=\"currentColor\" viewBox=\"0 0 24 24\">\n388\t                      <path d=\"M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z\" />\n389\t                    </svg>\n390\t                  </div>\n391\t                  <span className=\"font-medium text-green-800\">Direct via WhatsApp</span>\n392\t                </div>\n393\t                <div className=\"text-sm text-stone-600 dark:text-stone-400 space-y-1\">\n394\t                  <div className=\"flex justify-between\">\n395\t                    <span>Room rate</span>\n396\t                    <span className=\"font-medium\">RM35–45</span>\n397\t                  </div>\n398\t                  <div className=\"flex justify-between text-green-600\">\n399\t                    <span>Platform fee</span>\n400\t                    <span className=\"font-medium\">RM0</span>\n401\t                  </div>\n402\t                  <div className=\"flex justify-between\">\n403\t                    <span>Service Tax (SST) 8%</span>\n404\t                    <span className=\"font-medium\">+8%</span>\n405\t                  </div>\n406\t                  <div className=\"flex justify-between\">\n407\t                    <span>Tourism Tax (TTx)</span>\n408\t                    <span className=\"font-medium\">RM10</span>\n409\t                  </div>\n410\t                  <div className=\"border-t border-green-200 dark:border-green-800 pt-2 mt-2 flex justify-between font-semibold text-green-800 dark:text-green-300\">\n411\t                    <span>You pay</span>\n412\t                    <span>RM48–59/night</span>\n413\t                  </div>\n414\t                </div>\n415\t              </div>\n416\t            </div>\n417\t            <p className=\"text-center text-sm text-amber-800 dark:text-amber-300 font-medium\">\n418\t              Save up to <span className=\"font-bold text-green-700\">RM14/night</span> by booking direct — that&apos;s <span className=\"font-bold text-green-700\">RM98/week</span> back in your pocket.\n419\t            </p>\n420\t            <p className=\"text-center text-xs text-stone-500 dark:text-stone-400 mt-2\">\n421\t              All room rates are subject to Service Tax (SST) 8% and Tourism Tax (TTx) of RM10/room/night for non-Malaysian guests, as required by Malaysian law. Tax rates are subject to change per Malaysian government regulation.{\" \"}\n422\t              <a href=\"https://www.myttx.customs.gov.my/\" target=\"_blank\" rel=\"noopener noreferrer\" className=\"text-amber-600 dark:text-amber-400 hover:underline\" aria-label=\"Learn more about Malaysia Tourism Tax (TTx)\">Learn more about TTx</a>\n423\t            </p>\n424\t          </div>\n425\t\n426\t          {/* Trust Badges */}\n427\t          <div className=\"mt-10 max-w-3xl mx-auto\">\n428\t            <p className=\"text-center text-xs font-medium tracking-[0.3em] uppercase text-stone-500 dark:text-stone-400 mb-5\">\n429\t              Trusted &amp; Secure\n430\t            </p>\n431\t            <div className=\"flex flex-wrap justify-center gap-4\">\n432\t              {[\n433\t                {\n434\t                  icon: \"M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z\",\n435\t                  label: \"Verified Property\",\n436\t                  sub: \"Registered with MOTAC\",\n437\t                },\n438\t                {\n439\t                  icon: \"M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z\",\n440\t                  label: \"Secure Payment\",\n441\t                  sub: \"Cash or card at arrival\",\n442\t                },\n443\t                {\n444\t                  icon: \"M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z\",\n445\t                  label: \"Real Human Support\",\n446\t                  sub: \"Talk to Jay directly\",\n447\t                },\n448\t                {\n449\t                  icon: \"M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z\",\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"f1598b8b-caeb-4a6a-b0e7-f4e096d8800b","uuid":"52797a51-3a85-40b1-8799-442df080bf62","timestamp":"2026-04-14T06:49:15.607Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\app\\book\\page.tsx","content":"            confirmation, and pay at arrival.\n          </p>\n\n          {/* Primary WhatsApp CTA — variant: {variant} */}\n          <a\n            href={WHATSAPP_URL}\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            className=\"inline-flex items-center gap-3 bg-green-500 text-white rounded-2xl\n                       py-5 px-10 font-semibold text-lg hover:bg-green-600 transition-all\n                       duration-300 hover:-translate-y-1 hover:shadow-xl\"\n            aria-label=\"Book via WhatsApp\"\n            data-variant={variant}\n          >\n            <svg className=\"w-6 h-6\" fill=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path d=\"M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z\" />\n            </svg>\n            {ctaText}\n          </a>\n          <p className=\"text-amber-300 text-sm mt-4\">\n            Replies within minutes during 8 AM – 10 PM\n          </p>\n\n          {/* Mobile-first trust signals & price comparison — above the fold */}\n          <HeroTrustBadges />\n        </div>\n      </section>\n\n      {/* Pricing Section */}\n      <section className=\"py-16 container-custom\">\n        <div className=\"max-w-4xl mx-auto\">\n          <div className=\"text-center mb-12\">\n            <p className=\"text-xs font-medium tracking-[0.3em] uppercase text-amber-700 dark:text-amber-400 mb-3\">\n              Transparent Pricing\n            </p>\n            <h2 className=\"font-display text-3xl md:text-4xl font-medium text-stone-900 dark:text-stone-100\">\n              Simple, Honest Rates\n            </h2>\n          </div>\n\n          <div className=\"grid md:grid-cols-2 gap-6\">\n            {/* Nightly */}\n            <div className=\"bg-white dark:bg-stone-900 rounded-3xl p-8 shadow-lg border border-stone-100 dark:border-stone-700 text-center\">\n              <div className=\"text-xs tracking-widest uppercase text-stone-500 dark:text-stone-400 mb-2\">Nightly Stay</div>\n              <div className=\"flex items-baseline justify-center gap-1 mb-4\">\n                <span className=\"font-display text-5xl font-medium text-stone-900 dark:text-stone-100\">RM35</span>\n                <span className=\"text-stone-500 dark:text-stone-400\">–</span>\n                <span className=\"font-display text-5xl font-medium text-stone-900 dark:text-stone-100\">45</span>\n                <span className=\"text-stone-500 dark:text-stone-400 ml-1\">/night</span>\n              </div>\n              <div className=\"text-sm text-stone-500 dark:text-stone-400 mb-2 space-y-1\">\n                <div className=\"flex items-center justify-center gap-1.5\">\n                  <span>+ Service Tax (SST) 8%</span>\n                </div>\n                <div className=\"flex items-center justify-center gap-1.5\">\n                  <span>+ Tourism Tax (TTx): RM10/room/night</span>\n                  <a\n                    href=\"https://www.myttx.customs.gov.my/\"\n                    target=\"_blank\"\n                    rel=\"noopener noreferrer\"\n                    aria-label=\"Learn more about Malaysia Tourism Tax (TTx)\"\n                    className=\"text-amber-600 dark:text-amber-400 hover:text-amber-700 dark:hover:text-amber-300\"\n                  >\n                    <svg className=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n                      <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\" />\n                    </svg>\n                  </a>\n                </div>\n              </div>\n              <p className=\"text-stone-500 dark:text-stone-400 text-sm mb-6\">\n                Per person, per night. Price varies by day and season.\n              </p>\n              <ul className=\"text-left space-y-3 text-sm text-stone-600 dark:text-stone-400\">\n                <li className=\"flex items-center gap-2\">\n                  <svg className=\"w-5 h-5 text-green-500 shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M5 13l4 4L19 7\" /></svg>\n                  Private capsule pod with door\n                </li>\n                <li className=\"flex items-center gap-2\">\n                  <svg className=\"w-5 h-5 text-green-500 shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M5 13l4 4L19 7\" /></svg>\n                  Free WiFi, A/C, personal locker\n                </li>\n                <li className=\"flex items-center gap-2\">\n                  <svg className=\"w-5 h-5 text-green-500 shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M5 13l4 4L19 7\" /></svg>\n                  Shared kitchen & laundry access\n                </li>\n              </ul>\n            </div>\n\n            {/* Monthly */}\n            <div className=\"bg-amber-50 dark:bg-amber-900/20 rounded-3xl p-8 shadow-lg border border-amber-200 dark:border-amber-700 text-center relative\">\n              <div className=\"absolute -top-3 left-1/2 -translate-x-1/2 bg-amber-600 text-white text-xs font-bold px-4 py-1 rounded-full uppercase tracking-wider\">\n                Best Value\n              </div>\n              <div className=\"text-xs tracking-widest uppercase text-amber-700 dark:text-amber-400 mb-2\">Monthly Stay</div>\n              <div className=\"flex items-baseline justify-center gap-1 mb-4\">\n                <span className=\"font-display text-5xl font-medium text-stone-900 dark:text-stone-100\">RM594</span>\n                <span className=\"text-stone-500 dark:text-stone-400 ml-1\">/month</span>\n              </div>\n              <div className=\"text-sm text-stone-500 dark:text-stone-400 mb-2 space-y-1\">\n                <div className=\"flex items-center justify-center gap-1.5\">\n                  <span>+ Service Tax (SST) 8%</span>\n                </div>\n                <div className=\"flex items-center justify-center gap-1.5\">\n                  <span>+ Tourism Tax (TTx): RM10/room/night</span>\n                  <a\n                    href=\"https://www.myttx.customs.gov.my/\"\n                    target=\"_blank\"\n                    rel=\"noopener noreferrer\"\n                    aria-label=\"Learn more about Malaysia Tourism Tax (TTx)\"\n                    className=\"text-amber-600 dark:text-amber-400 hover:text-amber-700 dark:hover:text-amber-300\"\n                  >\n                    <svg className=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n                      <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\" />\n                    </svg>\n                  </a>\n                </div>\n              </div>\n              <p className=\"text-stone-500 dark:text-stone-400 text-sm mb-6\">\n                That&apos;s just RM19.80/night — save over 40% vs nightly rate.\n              </p>\n              <ul className=\"text-left space-y-3 text-sm text-stone-600 dark:text-stone-400\">\n                <li className=\"flex items-center gap-2\">\n                  <svg className=\"w-5 h-5 text-green-500 shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M5 13l4 4L19 7\" /></svg>\n                  Everything in nightly stay\n                </li>\n                <li className=\"flex items-center gap-2\">\n                  <svg className=\"w-5 h-5 text-green-500 shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M5 13l4 4L19 7\" /></svg>\n                  Ideal for remote workers & digital nomads\n                </li>\n                <li className=\"flex items-center gap-2\">\n                  <svg className=\"w-5 h-5 text-green-500 shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M5 13l4 4L19 7\" /></svg>\n                  Flexible start date\n                </li>\n              </ul>\n            </div>\n          </div>\n\n          {/* Trust Signals */}\n          <TrustSignals />\n\n          {/* Booking Form */}\n          <div className=\"mt-12 max-w-md mx-auto\">\n            <BookingForm />\n          </div>\n\n          {/* Or divider */}\n          <div className=\"mt-10 flex items-center gap-4 max-w-md mx-auto\">\n            <div className=\"flex-1 border-t border-stone-200 dark:border-stone-700\" />\n            <span className=\"text-xs font-medium text-stone-400 dark:text-stone-500 uppercase tracking-wider\">\n              or pay deposit online\n            </span>\n            <div className=\"flex-1 border-t border-stone-200 dark:border-stone-700\" />\n          </div>\n\n          {/* FPX Online Banking Payment */}\n          <div className=\"mt-8 max-w-md mx-auto\">\n            <FpxPaymentForm />\n          </div>\n        </div>\n      </section>\n\n      {/* Why Book Direct */}\n      <section className=\"py-16 bg-white dark:bg-stone-900\">\n        <div className=\"container-custom\">\n          <div className=\"text-center mb-12\">\n            <p className=\"text-xs font-medium tracking-[0.3em] uppercase text-amber-700 dark:text-amber-400 mb-3\">\n              Direct Booking Benefits\n            </p>\n            <h2 className=\"font-display text-3xl md:text-4xl font-medium text-stone-900 dark:text-stone-100\">\n              Why Book Direct?\n            </h2>\n          </div>\n\n          <div className=\"grid sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-5xl mx-auto\">\n            {directBenefits.map((benefit, index) => (\n              <div\n                key={index}\n                className=\"bg-stone-50 dark:bg-stone-800 rounded-2xl p-6 text-center hover:bg-stone-100 dark:hover:bg-stone-700 transition-colors\"\n              >\n                <div className=\"w-14 h-14 rounded-2xl bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center mx-auto mb-4\">\n                  <svg className=\"w-7 h-7 text-amber-700 dark:text-amber-400\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                    <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={1.5} d={benefit.icon} />\n                  </svg>\n                </div>\n                <h3 className=\"font-semibold text-stone-900 dark:text-stone-100 mb-2\">{benefit.title}</h3>\n                <p className=\"text-stone-500 dark:text-stone-400 text-sm\">{benefit.description}</p>\n              </div>\n            ))}\n          </div>\n\n          {/* OTA vs Direct Savings Comparison Callout */}\n          <div className=\"mt-12 max-w-3xl mx-auto bg-linear-to-r from-amber-50 to-orange-50 dark:from-stone-800 dark:to-stone-800 rounded-3xl p-8 border border-amber-200 dark:border-amber-700\">\n            <p className=\"text-center text-xs font-medium tracking-[0.3em] uppercase text-amber-700 dark:text-amber-400 mb-6\">\n              Price Comparison\n            </p>\n            <h3 className=\"font-display text-xl font-medium text-stone-900 dark:text-stone-100 text-center mb-6\">\n              Direct vs OTA — What You Actually Pay\n            </h3>\n            <div className=\"grid sm:grid-cols-2 gap-4 mb-6\">\n              {/* OTA column */}\n              <div className=\"bg-white/70 dark:bg-stone-900/70 rounded-2xl p-5 border border-stone-200 dark:border-stone-700\">\n                <div className=\"flex items-center gap-2 mb-3\">\n                  <div className=\"w-7 h-7 rounded-lg bg-stone-100 flex items-center justify-center\">\n                    <svg className=\"w-4 h-4 text-stone-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                      <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17H3a2 2 0 01-2-2V5a2 2 0 012-2h14a2 2 0 012 2v10a2 2 0 01-2 2h-2\" />\n                    </svg>\n                  </div>\n                  <span className=\"font-medium text-stone-700 dark:text-stone-300\">Via Booking.com</span>\n                </div>\n                <div className=\"text-sm text-stone-600 dark:text-stone-400 space-y-1\">\n                  <div className=\"flex justify-between\">\n                    <span>Room rate</span>\n                    <span className=\"font-medium\">RM40–48</span>\n                  </div>\n                  <div className=\"flex justify-between text-red-500\">\n                    <span>Platform service fee</span>\n                    <span className=\"font-medium\">+15–20%</span>\n                  </div>\n                  <div className=\"flex justify-between\">\n                    <span>Service Tax (SST) 8%</span>\n                    <span className=\"font-medium\">+8%</span>\n                  </div>\n                  <div className=\"flex justify-between\">\n                    <span>Tourism Tax (TTx)</span>\n                    <span className=\"font-medium\">RM10</span>\n                  </div>\n                  <div className=\"border-t border-stone-200 dark:border-stone-700 pt-2 mt-2 flex justify-between font-semibold text-stone-800 dark:text-stone-200\">\n                    <span>You pay</span>\n                    <span>~RM60–73/night</span>\n                  </div>\n                </div>\n              </div>\n\n              {/* Direct column */}\n              <div className=\"bg-green-50 dark:bg-green-900/20 rounded-2xl p-5 border border-green-200 dark:border-green-800\">\n                <div className=\"flex items-center gap-2 mb-3\">\n                  <div className=\"w-7 h-7 rounded-lg bg-green-100 flex items-center justify-center\">\n                    <svg className=\"w-4 h-4 text-green-600\" fill=\"currentColor\" viewBox=\"0 0 24 24\">\n                      <path d=\"M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z\" />\n                    </svg>\n                  </div>\n                  <span className=\"font-medium text-green-800\">Direct via WhatsApp</span>\n                </div>\n                <div className=\"text-sm text-stone-600 dark:text-stone-400 space-y-1\">\n                  <div className=\"flex justify-between\">\n                    <span>Room rate</span>\n                    <span className=\"font-medium\">RM35–45</span>\n                  </div>\n                  <div className=\"flex justify-between text-green-600\">\n                    <span>Platform fee</span>\n                    <span className=\"font-medium\">RM0</span>\n                  </div>\n                  <div className=\"flex justify-between\">\n                    <span>Service Tax (SST) 8%</span>\n                    <span className=\"font-medium\">+8%</span>\n                  </div>\n                  <div className=\"flex justify-between\">\n                    <span>Tourism Tax (TTx)</span>\n                    <span className=\"font-medium\">RM10</span>\n                  </div>\n                  <div className=\"border-t border-green-200 dark:border-green-800 pt-2 mt-2 flex justify-between font-semibold text-green-800 dark:text-green-300\">\n                    <span>You pay</span>\n                    <span>RM48–59/night</span>\n                  </div>\n                </div>\n              </div>\n            </div>\n            <p className=\"text-center text-sm text-amber-800 dark:text-amber-300 font-medium\">\n              Save up to <span className=\"font-bold text-green-700\">RM14/night</span> by booking direct — that&apos;s <span className=\"font-bold text-green-700\">RM98/week</span> back in your pocket.\n            </p>\n            <p className=\"text-center text-xs text-stone-500 dark:text-stone-400 mt-2\">\n              All room rates are subject to Service Tax (SST) 8% and Tourism Tax (TTx) of RM10/room/night for non-Malaysian guests, as required by Malaysian law. Tax rates are subject to change per Malaysian government regulation.{\" \"}\n              <a href=\"https://www.myttx.customs.gov.my/\" target=\"_blank\" rel=\"noopener noreferrer\" className=\"text-amber-600 dark:text-amber-400 hover:underline\" aria-label=\"Learn more about Malaysia Tourism Tax (TTx)\">Learn more about TTx</a>\n            </p>\n          </div>\n\n          {/* Trust Badges */}\n          <div className=\"mt-10 max-w-3xl mx-auto\">\n            <p className=\"text-center text-xs font-medium tracking-[0.3em] uppercase text-stone-500 dark:text-stone-400 mb-5\">\n              Trusted &amp; Secure\n            </p>\n            <div className=\"flex flex-wrap justify-center gap-4\">\n              {[\n                {\n                  icon: \"M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z\",\n                  label: \"Verified Property\",\n                  sub: \"Registered with MOTAC\",\n                },\n                {\n                  icon: \"M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z\",\n                  label: \"Secure Payment\",\n                  sub: \"Cash or card at arrival\",\n                },\n                {\n                  icon: \"M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z\",\n                  label: \"Real Human Support\",\n                  sub: \"Talk to Jay directly\",\n                },\n                {\n                  icon: \"M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z\",","numLines":300,"startLine":150,"totalLines":652}}}
