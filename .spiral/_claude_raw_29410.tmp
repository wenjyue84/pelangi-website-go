n: \"Learn about Pelangi Capsule Hostel in Johor Bahru — our story, mission, and why we're the perfect base for exploring JB and Singapore.\",\n  alternates: {\n    canonical: \"https://pelangicapsulehostel.com/about\",\n  },\n};\n\nexport default function AboutPage() {\n  return (\n    <main id=\"main-content\" className=\"min-h-screen bg-stone-50 dark:bg-stone-950\">\n      <Header />\n      <div className=\"pt-20\"> {/* Add padding for fixed header */}\n        <About />\n      </div>\n      <Footer />\n    </main>\n  );\n}\n","numLines":24,"startLine":1,"totalLines":24}}}
