{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019k5yDdNDFAb8tQe6uEyz6D","type":"tool_result","content":"The file C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\app\\sitemap.ts has been updated successfully."}]},"parent_tool_use_id":null,"session_id":"87549396-fcb5-45ed-b760-9777ff9839ec","uuid":"49bcda5e-04d8-4cb4-8270-3b2b33fed0e4","timestamp":"2026-04-13T20:28:58.860Z","tool_use_result":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\app\\sitemap.ts","oldString":"        {\n            url: `${baseUrl}/visit-malaysia-2026`,\n            lastModified,\n            changeFrequency: \"monthly\",\n            priority: 0.85,\n        },\n        {\n            url: `${baseUrl}/sitemap-html`,\n            lastModified,\n            changeFrequency: \"monthly\",\n            priority: 0.3,\n        },","newString":"        {\n            url: `${baseUrl}/visit-malaysia-2026`,\n            lastModified,\n            changeFrequency: \"monthly\",\n            priority: 0.85,\n        },\n        {\n            url: `${baseUrl}/visa-run`,\n            lastModified,\n            changeFrequency: \"monthly\",\n            priority: 0.85,\n        },\n        {\n            url: `${baseUrl}/sitemap-html`,\n            lastModified,\n            changeFrequency: \"monthly\",\n            priority: 0.3,\n        },","originalFile":"import { MetadataRoute } from \"next\";\nimport { blogPosts, categoryToSlug, getUniqueCategories } from \"@/data/blog/posts\";\n\nexport default function sitemap(): MetadataRoute.Sitemap {\n    const baseUrl = \"https://pelangicapsulehostel.com\";\n    const lastModified = new Date();\n\n    const blogPostEntries: MetadataRoute.Sitemap = blogPosts.map((post) => ({\n        url: `${baseUrl}/blog/${post.slug}`,\n        lastModified: new Date(post.date),\n        changeFrequency: \"monthly\",\n        priority: 0.7,\n        images: [`${baseUrl}${post.featuredImage}`],\n    }));\n\n    const categoryEntries: MetadataRoute.Sitemap = getUniqueCategories().map((cat) => ({\n        url: `${baseUrl}/blog/category/${categoryToSlug(cat)}`,\n        lastModified,\n        changeFrequency: \"weekly\",\n        priority: 0.65,\n    }));\n\n    return [\n        {\n            url: baseUrl,\n            lastModified,\n            changeFrequency: \"weekly\",\n            priority: 1.0,\n            images: [`${baseUrl}/images/hero-final.png`],\n        },\n        {\n            url: `${baseUrl}/book`,\n            lastModified,\n            changeFrequency: \"weekly\",\n            priority: 0.95,\n        },\n        {\n            url: `${baseUrl}/rooms`,\n            lastModified,\n            changeFrequency: \"weekly\",\n            priority: 0.9,\n            images: [\n                `${baseUrl}/images/capsule-4.webp`,\n                `${baseUrl}/images/capsule-2.webp`,\n                `${baseUrl}/images/capsule-1.webp`,\n                `${baseUrl}/images/capsule-3.webp`,\n            ],\n        },\n        {\n            url: `${baseUrl}/about`,\n            lastModified,\n            changeFrequency: \"monthly\",\n            priority: 0.8,\n            images: [`${baseUrl}/images/exterior.JPG`],\n        },\n        {\n            url: `${baseUrl}/gallery`,\n            lastModified,\n            changeFrequency: \"monthly\",\n            priority: 0.8,\n            images: [\n                `${baseUrl}/images/living-room.jpeg`,\n                `${baseUrl}/images/capsule-1.webp`,\n                `${baseUrl}/images/entrance.jpeg`,\n                `${baseUrl}/images/exterior.JPG`,\n                `${baseUrl}/images/capsule-2.webp`,\n                `${baseUrl}/images/toilet.jpg`,\n                `${baseUrl}/images/facility-heater.jpg`,\n                `${baseUrl}/images/sink.jpg`,\n                `${baseUrl}/images/capsule-3.webp`,\n                `${baseUrl}/images/facility-shoes-rack.jpg`,\n                `${baseUrl}/images/facility-1.webp`,\n                `${baseUrl}/images/facility-2.webp`,\n                `${baseUrl}/images/facility-3.webp`,\n            ],\n        },\n        {\n            url: `${baseUrl}/location`,\n            lastModified,\n            changeFrequency: \"monthly\",\n            priority: 0.8,\n        },\n        {\n            url: `${baseUrl}/contact`,\n            lastModified,\n            changeFrequency: \"monthly\",\n            priority: 0.7,\n        },\n        {\n            url: `${baseUrl}/check-in`,\n            lastModified,\n            changeFrequency: \"monthly\",\n            priority: 0.7,\n        },\n        {\n            url: `${baseUrl}/getting-here`,\n            lastModified,\n            changeFrequency: \"monthly\",\n            priority: 0.8,\n        },\n        {\n            url: `${baseUrl}/guide`,\n            lastModified,\n            changeFrequency: \"monthly\",\n            priority: 0.6,\n        },\n        {\n            url: `${baseUrl}/blog`,\n            lastModified,\n            changeFrequency: \"weekly\",\n            priority: 0.8,\n        },\n        {\n            url: `${baseUrl}/amenities`,\n            lastModified,\n            changeFrequency: \"monthly\",\n            priority: 0.8,\n        },\n        {\n            url: `${baseUrl}/visit-malaysia-2026`,\n            lastModified,\n            changeFrequency: \"monthly\",\n            priority: 0.85,\n        },\n        {\n            url: `${baseUrl}/sitemap-html`,\n            lastModified,\n            changeFrequency: \"monthly\",\n            priority: 0.3,\n        },\n        ...categoryEntries,\n        ...blogPostEntries,\n    ];\n}\n","structuredPatch":[{"oldStart":123,"oldLines":6,"newStart":123,"newLines":12,"lines":["             priority: 0.85,","         },","         {","+            url: `${baseUrl}/visa-run`,","+            lastModified,","+            changeFrequency: \"monthly\",","+            priority: 0.85,","+        },","+        {","             url: `${baseUrl}/sitemap-html`,","             lastModified,","             changeFrequency: \"monthly\","]}],"userModified":false,"replaceAll":false}}
