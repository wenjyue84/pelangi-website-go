{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011EowE7NkAtydCu57YsAD5Y","type":"tool_result","content":"1\timport { MetadataRoute } from \"next\";\n2\timport { blogPosts, categoryToSlug, getUniqueCategories } from \"@/data/blog/posts\";\n3\t\n4\texport default function sitemap(): MetadataRoute.Sitemap {\n5\t    const baseUrl = \"https://pelangicapsulehostel.com\";\n6\t    const lastModified = new Date();\n7\t\n8\t    const blogPostEntries: MetadataRoute.Sitemap = blogPosts.map((post) => ({\n9\t        url: `${baseUrl}/blog/${post.slug}`,\n10\t        lastModified: new Date(post.date),\n11\t        changeFrequency: \"monthly\",\n12\t        priority: 0.7,\n13\t        images: [`${baseUrl}${post.featuredImage}`],\n14\t    }));\n15\t\n16\t    const categoryEntries: MetadataRoute.Sitemap = getUniqueCategories().map((cat) => ({\n17\t        url: `${baseUrl}/blog/category/${categoryToSlug(cat)}`,\n18\t        lastModified,\n19\t        changeFrequency: \"weekly\",\n20\t        priority: 0.65,\n21\t    }));\n22\t\n23\t    return [\n24\t        {\n25\t            url: baseUrl,\n26\t            lastModified,\n27\t            changeFrequency: \"weekly\",\n28\t            priority: 1.0,\n29\t            images: [`${baseUrl}/images/hero-final.png`],\n30\t        },\n31\t        {\n32\t            url: `${baseUrl}/book`,\n33\t            lastModified,\n34\t            changeFrequency: \"weekly\",\n35\t            priority: 0.95,\n36\t        },\n37\t        {\n38\t            url: `${baseUrl}/rooms`,\n39\t            lastModified,\n40\t            changeFrequency: \"weekly\",\n41\t            priority: 0.9,\n42\t            images: [\n43\t                `${baseUrl}/images/capsule-4.webp`,\n44\t                `${baseUrl}/images/capsule-2.webp`,\n45\t                `${baseUrl}/images/capsule-1.webp`,\n46\t                `${baseUrl}/images/capsule-3.webp`,\n47\t            ],\n48\t        },\n49\t        {\n50\t            url: `${baseUrl}/about`,\n51\t            lastModified,\n52\t            changeFrequency: \"monthly\",\n53\t            priority: 0.8,\n54\t            images: [`${baseUrl}/images/exterior.JPG`],\n55\t        },\n56\t        {\n57\t            url: `${baseUrl}/gallery`,\n58\t            lastModified,\n59\t            changeFrequency: \"monthly\",\n60\t            priority: 0.8,\n61\t            images: [\n62\t                `${baseUrl}/images/living-room.jpeg`,\n63\t                `${baseUrl}/images/capsule-1.webp`,\n64\t                `${baseUrl}/images/entrance.jpeg`,\n65\t                `${baseUrl}/images/exterior.JPG`,\n66\t                `${baseUrl}/images/capsule-2.webp`,\n67\t                `${baseUrl}/images/toilet.jpg`,\n68\t                `${baseUrl}/images/facility-heater.jpg`,\n69\t                `${baseUrl}/images/sink.jpg`,\n70\t                `${baseUrl}/images/capsule-3.webp`,\n71\t                `${baseUrl}/images/facility-shoes-rack.jpg`,\n72\t                `${baseUrl}/images/facility-1.webp`,\n73\t                `${baseUrl}/images/facility-2.webp`,\n74\t                `${baseUrl}/images/facility-3.webp`,\n75\t            ],\n76\t        },\n77\t        {\n78\t            url: `${baseUrl}/location`,\n79\t            lastModified,\n80\t            changeFrequency: \"monthly\",\n81\t            priority: 0.8,\n82\t        },\n83\t        {\n84\t            url: `${baseUrl}/contact`,\n85\t            lastModified,\n86\t            changeFrequency: \"monthly\",\n87\t            priority: 0.7,\n88\t        },\n89\t        {\n90\t            url: `${baseUrl}/check-in`,\n91\t            lastModified,\n92\t            changeFrequency: \"monthly\",\n93\t            priority: 0.7,\n94\t        },\n95\t        {\n96\t            url: `${baseUrl}/getting-here`,\n97\t            lastModified,\n98\t            changeFrequency: \"monthly\",\n99\t            priority: 0.8,\n100\t        },\n101\t        {\n102\t            url: `${baseUrl}/guide`,\n103\t            lastModified,\n104\t            changeFrequency: \"monthly\",\n105\t            priority: 0.6,\n106\t        },\n107\t        {\n108\t            url: `${baseUrl}/blog`,\n109\t            lastModified,\n110\t            changeFrequency: \"weekly\",\n111\t            priority: 0.8,\n112\t        },\n113\t        {\n114\t            url: `${baseUrl}/amenities`,\n115\t            lastModified,\n116\t            changeFrequency: \"monthly\",\n117\t            priority: 0.8,\n118\t        },\n119\t        {\n120\t            url: `${baseUrl}/visit-malaysia-2026`,\n121\t            lastModified,\n122\t            changeFrequency: \"monthly\",\n123\t            priority: 0.85,\n124\t        },\n125\t        {\n126\t            url: `${baseUrl}/sitemap-html`,\n127\t            lastModified,\n128\t            changeFrequency: \"monthly\",\n129\t            priority: 0.3,\n130\t        },\n131\t        ...categoryEntries,\n132\t        ...blogPostEntries,\n133\t    ];\n134\t}\n135\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"87549396-fcb5-45ed-b760-9777ff9839ec","uuid":"e80e941d-e992-406e-b545-9b5238fedd36","timestamp":"2026-04-13T20:28:31.520Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\app\\sitemap.ts","content":"import { MetadataRoute } from \"next\";\nimport { blogPosts, categoryToSlug, getUniqueCategories } from \"@/data/blog/posts\";\n\nexport default function sitemap(): MetadataRoute.Sitemap {\n    const baseUrl = \"https://pelangicapsulehostel.com\";\n    const lastModified = new Date();\n\n    const blogPostEntries: MetadataRoute.Sitemap = blogPosts.map((post) => ({\n        url: `${baseUrl}/blog/${post.slug}`,\n        lastModified: new Date(post.date),\n        changeFrequency: \"monthly\",\n        priority: 0.7,\n        images: [`${baseUrl}${post.featuredImage}`],\n    }));\n\n    const categoryEntries: MetadataRoute.Sitemap = getUniqueCategories().map((cat) => ({\n        url: `${baseUrl}/blog/category/${categoryToSlug(cat)}`,\n        lastModified,\n        changeFrequency: \"weekly\",\n        priority: 0.65,\n    }));\n\n    return [\n        {\n            url: baseUrl,\n            lastModified,\n            changeFrequency: \"weekly\",\n            priority: 1.0,\n            images: [`${baseUrl}/images/hero-final.png`],\n        },\n        {\n            url: `${baseUrl}/book`,\n            lastModified,\n            changeFrequency: \"weekly\",\n            priority: 0.95,\n        },\n        {\n            url: `${baseUrl}/rooms`,\n            lastModified,\n            changeFrequency: \"weekly\",\n            priority: 0.9,\n            images: [\n                `${baseUrl}/images/capsule-4.webp`,\n                `${baseUrl}/images/capsule-2.webp`,\n                `${baseUrl}/images/capsule-1.webp`,\n                `${baseUrl}/images/capsule-3.webp`,\n            ],\n        },\n        {\n            url: `${baseUrl}/about`,\n            lastModified,\n            changeFrequency: \"monthly\",\n            priority: 0.8,\n            images: [`${baseUrl}/images/exterior.JPG`],\n        },\n        {\n            url: `${baseUrl}/gallery`,\n            lastModified,\n            changeFrequency: \"monthly\",\n            priority: 0.8,\n            images: [\n                `${baseUrl}/images/living-room.jpeg`,\n                `${baseUrl}/images/capsule-1.webp`,\n                `${baseUrl}/images/entrance.jpeg`,\n                `${baseUrl}/images/exterior.JPG`,\n                `${baseUrl}/images/capsule-2.webp`,\n                `${baseUrl}/images/toilet.jpg`,\n                `${baseUrl}/images/facility-heater.jpg`,\n                `${baseUrl}/images/sink.jpg`,\n                `${baseUrl}/images/capsule-3.webp`,\n                `${baseUrl}/images/facility-shoes-rack.jpg`,\n                `${baseUrl}/images/facility-1.webp`,\n                `${baseUrl}/images/facility-2.webp`,\n                `${baseUrl}/images/facility-3.webp`,\n            ],\n        },\n        {\n            url: `${baseUrl}/location`,\n            lastModified,\n            changeFrequency: \"monthly\",\n            priority: 0.8,\n        },\n        {\n            url: `${baseUrl}/contact`,\n            lastModified,\n            changeFrequency: \"monthly\",\n            priority: 0.7,\n        },\n        {\n            url: `${baseUrl}/check-in`,\n            lastModified,\n            changeFrequency: \"monthly\",\n            priority: 0.7,\n        },\n        {\n            url: `${baseUrl}/getting-here`,\n            lastModified,\n            changeFrequency: \"monthly\",\n            priority: 0.8,\n        },\n        {\n            url: `${baseUrl}/guide`,\n            lastModified,\n            changeFrequency: \"monthly\",\n            priority: 0.6,\n        },\n        {\n            url: `${baseUrl}/blog`,\n            lastModified,\n            changeFrequency: \"weekly\",\n            priority: 0.8,\n        },\n        {\n            url: `${baseUrl}/amenities`,\n            lastModified,\n            changeFrequency: \"monthly\",\n            priority: 0.8,\n        },\n        {\n            url: `${baseUrl}/visit-malaysia-2026`,\n            lastModified,\n            changeFrequency: \"monthly\",\n            priority: 0.85,\n        },\n        {\n            url: `${baseUrl}/sitemap-html`,\n            lastModified,\n            changeFrequency: \"monthly\",\n            priority: 0.3,\n        },\n        ...categoryEntries,\n        ...blogPostEntries,\n    ];\n}\n","numLines":135,"startLine":1,"totalLines":135}}}
{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01F8a78CRnwmXRWYENHRVzPm","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"Great! I have the patterns. Now I understand:\n\n1. Pages import Header and Footer from \"@/components/Header\" and \"@/components/Footer\"\n2. They export metadata using `type { Metadata } from \"next\"`\n3. They have a default export component that returns a JSX structure\n4. sitemap.ts returns an array of entries with url, lastModified, changeFrequency, priority, and optional images\n\nNow I need to create the /visa-run page. Let me plan my implementation:\n\n## Current State\n- Existing pages follow the pattern: metadata, Header/Footer, main content\n- Sitemap.ts has entries for all main pages with priorities ranging from 0.3 to 1.0\n- The new page needs to include FAQPage and HowTo JSON-LD schemas\n\n## Problem Identified\nI need to create a new /visa-run page with:\n- FAQPage JSON-LD schema with 5 Q&As about visa runs\n- HowTo JSON-LD schema with 5 steps\n- Header/Footer components\n- Proper metadata\n- Update sitemap.ts\n\n## Planned Changes\n1. Create `site/src/app/visa-run/page.tsx` with:\n   - Metadata title: \"Visa Run Singapore to JB | Pelangi Capsule Hostel\"\n   - Header and Footer components\n   - Two JSON-LD scripts: FAQPage and HowTo\n   - CTA button to /book\n2. Update `site/src/app/sitemap.ts` to add /visa-run entry with priority 0.85\n\nLet me implement this now.","signature":""}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":2883,"cache_read_input_tokens":80491,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2883},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"87549396-fcb5-45ed-b760-9777ff9839ec","uuid":"6d9530ae-bd2a-4fa5-9b1f-ac684dee4d29"}
{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01F8a78CRnwmXRWYENHRVzPm","type":"message","role":"assistant","content":[{"type":"text","text":"## Current State\nExamined existing page structure (about/page.tsx) and sitemap.ts. Pages import Header/Footer, define metadata, and render components. Sitemap has entries for all main routes.\n\n## Problem Identified\nNeed to create a new /visa-run page with FAQPage and HowTo JSON-LD schemas, Header/Footer, and update the sitemap.\n\n## Planned Changes\n1. Create `site/src/app/visa-run/page.tsx` with metadata, Header/Footer, FAQPage + HowTo schemas, and CTA\n2. Update `site/src/app/sitemap.ts` to add /visa-run entry with priority 0.85\n\n<plan>\n{\n  \"files_to_create\": [\"site/src/app/visa-run/page.tsx\"],\n  \"files_to_modify\": [\"site/src/app/sitemap.ts\"],\n  \"functions_to_add\": [],\n  \"estimated_loc\": 180\n}\n</plan>\n\nNow implementing:"}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":2883,"cache_read_input_tokens":80491,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2883},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"87549396-fcb5-45ed-b760-9777ff9839ec","uuid":"48fe42ee-e228-4ca3-9c3a-639de787629e"}
{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01F8a78CRnwmXRWYENHRVzPm","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01SRMJVcyx6v9KK9dgypQ6aE","name":"Write","input":{"file_path":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\app\\visa-run\\page.tsx","content":"import Header from \"@/components/Header\";\nimport Footer from \"@/components/Footer\";\nimport type { Metadata } from \"next\";\nimport Link from \"next/link\";\n\nexport const metadata: Metadata = {\n  title: \"Visa Run Singapore to JB | Pelangi Capsule Hostel\",\n  description: \"Complete guide to visa runs from Singapore to Johor Bahru. Learn the process, costs, requirements, and FAQs. Perfect for expats and travelers.\",\n  alternates: {\n    canonical: \"https://pelangicapsulehostel.com/visa-run\",\n  },\n};\n\nconst faqSchema = {\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"FAQPage\",\n  mainEntity: [\n    {\n      \"@type\": \"Question\",\n      name: \"What is a visa run and why do people do them from Singapore?\",\n      acceptedAnswer: {\n        \"@type\": \"Answer\",\n        text: \"A visa run is a trip outside your home country to reset your visa status or obtain a new visa. Expats in Singapore frequently visit Johor Bahru for quick visa runs to extend social visit passes or renew tourist visas.\",\n      },\n    },\n    {\n      \"@type\": \"Question\",\n      name: \"How long does a typical Singapore to JB visa run take?\",\n      acceptedAnswer: {\n        \"@type\": \"Answer\",\n        text: \"A standard visa run typically takes 1-3 days. You can cross into Malaysia, stay overnight, and return the next day. The actual border crossing usually takes 30-60 minutes depending on traffic.\",\n      },\n    },\n    {\n      \"@type\": \"Question\",\n      name: \"What documents do I need for a Singapore-JB visa run?\",\n      acceptedAnswer: {\n        \"@type\": \"Answer\",\n        text: \"You'll need your passport, proof of funds (usually SGD 1,000-1,500), and a return ticket or proof of onward travel. Some visitors may need a visa for Malaysia depending on their nationality.\",\n      },\n    },\n    {\n      \"@type\": \"Question\",\n      name: \"How much does a visa run to Johor Bahru cost?\",\n      acceptedAnswer: {\n        \"@type\": \"Answer\",\n        text: \"Costs vary: causeway toll (RM10-15), accommodation (RM50-150), meals (RM30-50), and immigration fees (if applicable). Budget SGD 80-200 total for a basic 2-day trip.\",\n      },\n    },\n    {\n      \"@type\": \"Question\",\n      name: \"Is Pelangi Capsule Hostel a good base for a Singapore visa run?\",\n      acceptedAnswer: {\n        \"@type\": \"Answer\",\n        text: \"Yes! We're just 5 minutes from the Johor Bahru city center and 15 minutes from the Causeway. Affordable beds (RM50-80/night), WiFi, and a central location make us ideal for visa run stopovers.\",\n      },\n    },\n  ],\n};\n\nconst howToSchema = {\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"HowTo\",\n  name: \"How to Do a Singapore to JB Visa Run\",\n  step: [\n    {\n      \"@type\": \"HowToStep\",\n      position: \"1\",\n      name: \"Prepare your documents\",\n      text: \"Gather your passport, proof of funds (SGD 1,000-1,500), and return ticket. Check Malaysia's entry requirements for your nationality.\",\n    },\n    {\n      \"@type\": \"HowToStep\",\n      position: \"2\",\n      name: \"Travel to Johor Bahru\",\n      text: \"Take a bus, taxi, or drive across the Causeway. The journey from Singapore city takes 45-90 minutes. Have your passport ready for Malaysian immigration.\",\n    },\n    {\n      \"@type\": \"HowToStep\",\n      position: \"3\",\n      name: \"Check into accommodation\",\n      text: \"Book a hostel or hotel in JB city center. Pelangi Capsule Hostel offers affordable beds and is walking distance to restaurants and shops.\",\n    },\n    {\n      \"@type\": \"HowToStep\",\n      position: \"4\",\n      name: \"Spend time in Malaysia\",\n      text: \"Explore local attractions, eat at hawker stalls, and enjoy JB's shopping and nightlife. Typically spend 1-2 days in Malaysia.\",\n    },\n    {\n      \"@type\": \"HowToStep\",\n      position: \"5\",\n      name: \"Return to Singapore\",\n      text: \"Head back to the Causeway with your passport. Pass through Malaysian immigration (exit) then Singapore immigration (entry). Your new entry will reset your visa status.\",\n    },\n  ],\n};\n\nexport default function VisaRunPage() {\n  return (\n    <main id=\"main-content\" className=\"min-h-screen bg-stone-50 dark:bg-stone-950\">\n      <Header />\n      <script\n        type=\"application/ld+json\"\n        dangerouslySetInnerHTML={{ __html: JSON.stringify(faqSchema) }}\n      />\n      <script\n        type=\"application/ld+json\"\n        dangerouslySetInnerHTML={{ __html: JSON.stringify(howToSchema) }}\n      />\n      <div className=\"pt-20\">\n        <section className=\"container mx-auto px-4 py-16\">\n          <h1 className=\"text-4xl font-bold mb-4\">Visa Run: Singapore to Johor Bahru</h1>\n          <p className=\"text-xl text-stone-600 dark:text-stone-400 mb-8\">\n            Your complete guide to visa runs from Singapore, with Pelangi Capsule Hostel as your perfect base.\n          </p>\n\n          <div className=\"grid gap-8 md:grid-cols-2 mb-12\">\n            <div className=\"bg-white dark:bg-stone-900 p-6 rounded-lg\">\n              <h2 className=\"text-2xl font-semibold mb-4\">Why Choose JB for Your Visa Run?</h2>\n              <ul className=\"space-y-2 text-stone-700 dark:text-stone-300\">\n                <li>✓ Only 45-90 minutes from Singapore</li>\n                <li>✓ Affordable accommodation and meals</li>\n                <li>✓ Quick Malaysia entry/exit process</li>\n                <li>✓ Great for exploring Malaysian culture</li>\n                <li>✓ Perfect for resetting your visa status</li>\n              </ul>\n            </div>\n\n            <div className=\"bg-white dark:bg-stone-900 p-6 rounded-lg\">\n              <h2 className=\"text-2xl font-semibold mb-4\">Budget Estimate</h2>\n              <table className=\"w-full text-stone-700 dark:text-stone-300\">\n                <tbody>\n                  <tr className=\"border-b\">\n                    <td className=\"py-2\">Causeway toll</td>\n                    <td className=\"text-right\">RM10-15</td>\n                  </tr>\n                  <tr className=\"border-b\">\n                    <td className=\"py-2\">Accommodation (1 night)</td>\n                    <td className=\"text-right\">RM50-80</td>\n                  </tr>\n                  <tr className=\"border-b\">\n                    <td className=\"py-2\">Meals</td>\n                    <td className=\"text-right\">RM30-50</td>\n                  </tr>\n                  <tr>\n                    <td className=\"py-2 font-semibold\">Total (SGD)</td>\n                    <td className=\"text-right font-semibold\">SGD 80-200</td>\n                  </tr>\n                </tbody>\n              </table>\n            </div>\n          </div>\n\n          <div className=\"bg-blue-50 dark:bg-blue-950 border-l-4 border-blue-500 p-6 rounded mb-8\">\n            <h3 className=\"text-xl font-semibold mb-2\">Ready to book your visa run?</h3>\n            <p className=\"text-stone-700 dark:text-stone-300 mb-4\">\n              Pelangi Capsule Hostel offers affordable beds, central location, and friendly staff to make your visa run hassle-free.\n            </p>\n            <Link\n              href=\"/book\"\n              className=\"inline-block bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-6 rounded-lg transition\"\n            >\n              Book Your Stay Now\n            </Link>\n          </div>\n\n          <section className=\"bg-white dark:bg-stone-900 p-8 rounded-lg\">\n            <h2 className=\"text-2xl font-semibold mb-6\">Important Reminders</h2>\n            <ul className=\"space-y-3 text-stone-700 dark:text-stone-300\">\n              <li>\n                <strong>Check visa requirements:</strong> Verify Malaysia's entry requirements for your nationality before traveling.\n              </li>\n              <li>\n                <strong>Keep funds:</strong> Have at least SGD 1,000-1,500 in accessible funds for immigration checks.\n              </li>\n              <li>\n                <strong>Plan your return:</strong> Ensure your passport has sufficient blank pages and validity (6+ months recommended).\n              </li>\n              <li>\n                <strong>Immigration rules:</strong> Be honest during immigration interviews. Visa runs are legitimate, but don't abuse the system.\n              </li>\n            </ul>\n          </section>\n        </section>\n      </div>\n      <Footer />\n    </main>\n  );\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":2883,"cache_read_input_tokens":80491,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2883},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"87549396-fcb5-45ed-b760-9777ff9839ec","uuid":"e03438a5-7b73-4793-9502-738b11f917ce"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SRMJVcyx6v9KK9dgypQ6aE","type":"tool_result","content":"File created successfully at: C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\app\\visa-run\\page.tsx"}]},"parent_tool_use_id":null,"session_id":"87549396-fcb5-45ed-b760-9777ff9839ec","uuid":"2de5374c-018e-4da2-b147-d55047aacfbe","timestamp":"2026-04-13T20:28:54.711Z","tool_use_result":{"type":"create","filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\app\\visa-run\\page.tsx","content":"import Header from \"@/components/Header\";\nimport Footer from \"@/components/Footer\";\nimport type { Metadata } from \"next\";\nimport Link from \"next/link\";\n\nexport const metadata: Metadata = {\n  title: \"Visa Run Singapore to JB | Pelangi Capsule Hostel\",\n  description: \"Complete guide to visa runs from Singapore to Johor Bahru. Learn the process, costs, requirements, and FAQs. Perfect for expats and travelers.\",\n  alternates: {\n    canonical: \"https://pelangicapsulehostel.com/visa-run\",\n  },\n};\n\nconst faqSchema = {\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"FAQPage\",\n  mainEntity: [\n    {\n      \"@type\": \"Question\",\n      name: \"What is a visa run and why do people do them from Singapore?\",\n      acceptedAnswer: {\n        \"@type\": \"Answer\",\n        text: \"A visa run is a trip outside your home country to reset your visa status or obtain a new visa. Expats in Singapore frequently visit Johor Bahru for quick visa runs to extend social visit passes or renew tourist visas.\",\n      },\n    },\n    {\n      \"@type\": \"Question\",\n      name: \"How long does a typical Singapore to JB visa run take?\",\n      acceptedAnswer: {\n        \"@type\": \"Answer\",\n        text: \"A standard visa run typically takes 1-3 days. You can cross into Malaysia, stay overnight, and return the next day. The actual border crossing usually takes 30-60 minutes depending on traffic.\",\n      },\n    },\n    {\n      \"@type\": \"Question\",\n      name: \"What documents do I need for a Singapore-JB visa run?\",\n      acceptedAnswer: {\n        \"@type\": \"Answer\",\n        text: \"You'll need your passport, proof of funds (usually SGD 1,000-1,500), and a return ticket or proof of onward travel. Some visitors may need a visa for Malaysia depending on their nationality.\",\n      },\n    },\n    {\n      \"@type\": \"Question\",\n      name: \"How much does a visa run to Johor Bahru cost?\",\n      acceptedAnswer: {\n        \"@type\": \"Answer\",\n        text: \"Costs vary: causeway toll (RM10-15), accommodation (RM50-150), meals (RM30-50), and immigration fees (if applicable). Budget SGD 80-200 total for a basic 2-day trip.\",\n      },\n    },\n    {\n      \"@type\": \"Question\",\n      name: \"Is Pelangi Capsule Hostel a good base for a Singapore visa run?\",\n      acceptedAnswer: {\n        \"@type\": \"Answer\",\n        text: \"Yes! We're just 5 minutes from the Johor Bahru city center and 15 minutes from the Causeway. Affordable beds (RM50-80/night), WiFi, and a central location make us ideal for visa run stopovers.\",\n      },\n    },\n  ],\n};\n\nconst howToSchema = {\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"HowTo\",\n  name: \"How to Do a Singapore to JB Visa Run\",\n  step: [\n    {\n      \"@type\": \"HowToStep\",\n      position: \"1\",\n      name: \"Prepare your documents\",\n      text: \"Gather your passport, proof of funds (SGD 1,000-1,500), and return ticket. Check Malaysia's entry requirements for your nationality.\",\n    },\n    {\n      \"@type\": \"HowToStep\",\n      position: \"2\",\n      name: \"Travel to Johor Bahru\",\n      text: \"Take a bus, taxi, or drive across the Causeway. The journey from Singapore city takes 45-90 minutes. Have your passport ready for Malaysian immigration.\",\n    },\n    {\n      \"@type\": \"HowToStep\",\n      position: \"3\",\n      name: \"Check into accommodation\",\n      text: \"Book a hostel or hotel in JB city center. Pelangi Capsule Hostel offers affordable beds and is walking distance to restaurants and shops.\",\n    },\n    {\n      \"@type\": \"HowToStep\",\n      position: \"4\",\n      name: \"Spend time in Malaysia\",\n      text: \"Explore local attractions, eat at hawker stalls, and enjoy JB's shopping and nightlife. Typically spend 1-2 days in Malaysia.\",\n    },\n    {\n      \"@type\": \"HowToStep\",\n      position: \"5\",\n      name: \"Return to Singapore\",\n      text: \"Head back to the Causeway with your passport. Pass through Malaysian immigration (exit) then Singapore immigration (entry). Your new entry will reset your visa status.\",\n    },\n  ],\n};\n\nexport default function VisaRunPage() {\n  return (\n    <main id=\"main-content\" className=\"min-h-screen bg-stone-50 dark:bg-stone-950\">\n      <Header />\n      <script\n        type=\"application/ld+json\"\n        dangerouslySetInnerHTML={{ __html: JSON.stringify(faqSchema) }}\n      />\n      <script\n        type=\"application/ld+json\"\n        dangerouslySetInnerHTML={{ __html: JSON.stringify(howToSchema) }}\n      />\n      <div className=\"pt-20\">\n        <section className=\"container mx-auto px-4 py-16\">\n          <h1 className=\"text-4xl font-bold mb-4\">Visa Run: Singapore to Johor Bahru</h1>\n          <p className=\"text-xl text-stone-600 dark:text-stone-400 mb-8\">\n            Your complete guide to visa runs from Singapore, with Pelangi Capsule Hostel as your perfect base.\n          </p>\n\n          <div className=\"grid gap-8 md:grid-cols-2 mb-12\">\n            <div className=\"bg-white dark:bg-stone-900 p-6 rounded-lg\">\n              <h2 className=\"text-2xl font-semibold mb-4\">Why Choose JB for Your Visa Run?</h2>\n              <ul className=\"space-y-2 text-stone-700 dark:text-stone-300\">\n                <li>✓ Only 45-90 minutes from Singapore</li>\n                <li>✓ Affordable accommodation and meals</li>\n                <li>✓ Quick Malaysia entry/exit process</li>\n                <li>✓ Great for exploring Malaysian culture</li>\n                <li>✓ Perfect for resetting your visa status</li>\n              </ul>\n            </div>\n\n            <div className=\"bg-white dark:bg-stone-900 p-6 rounded-lg\">\n              <h2 className=\"text-2xl font-semibold mb-4\">Budget Estimate</h2>\n              <table className=\"w-full text-stone-700 dark:text-stone-300\">\n                <tbody>\n                  <tr className=\"border-b\">\n                    <td className=\"py-2\">Causeway toll</td>\n                    <td className=\"text-right\">RM10-15</td>\n                  </tr>\n                  <tr className=\"border-b\">\n                    <td className=\"py-2\">Accommodation (1 night)</td>\n                    <td className=\"text-right\">RM50-80</td>\n                  </tr>\n                  <tr className=\"border-b\">\n                    <td className=\"py-2\">Meals</td>\n                    <td className=\"text-right\">RM30-50</td>\n                  </tr>\n                  <tr>\n                    <td className=\"py-2 font-semibold\">Total (SGD)</td>\n                    <td className=\"text-right font-semibold\">SGD 80-200</td>\n                  </tr>\n                </tbody>\n              </table>\n            </div>\n          </div>\n\n          <div className=\"bg-blue-50 dark:bg-blue-950 border-l-4 border-blue-500 p-6 rounded mb-8\">\n            <h3 className=\"text-xl font-semibold mb-2\">Ready to book your visa run?</h3>\n            <p className=\"text-stone-700 dark:text-stone-300 mb-4\">\n              Pelangi Capsule Hostel offers affordable beds, central location, and friendly staff to make your visa run hassle-free.\n            </p>\n            <Link\n              href=\"/book\"\n              className=\"inline-block bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-6 rounded-lg transition\"\n            >\n              Book Your Stay Now\n            </Link>\n          </div>\n\n          <section className=\"bg-white dark:bg-stone-900 p-8 rounded-lg\">\n            <h2 className=\"text-2xl font-semibold mb-6\">Important Reminders</h2>\n            <ul className=\"space-y-3 text-stone-700 dark:text-stone-300\">\n              <li>\n                <strong>Check visa requirements:</strong> Verify Malaysia's entry requirements for your nationality before traveling.\n              </li>\n              <li>\n                <strong>Keep funds:</strong> Have at least SGD 1,000-1,500 in accessible funds for immigration checks.\n              </li>\n              <li>\n                <strong>Plan your return:</strong> Ensure your passport has sufficient blank pages and validity (6+ months recommended).\n              </li>\n              <li>\n                <strong>Immigration rules:</strong> Be honest during immigration interviews. Visa runs are legitimate, but don't abuse the system.\n              </li>\n            </ul>\n          </section>\n        </section>\n      </div>\n      <Footer />\n    </main>\n  );\n}\n","structuredPatch":[],"originalFile":null}}
