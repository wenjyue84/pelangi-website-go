{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TSQ81gxdxyxVk1VzAYXW5h","type":"tool_result","content":"1\t/**\n2\t * Next.js Middleware — Evaluates Vercel Feature Flags server-side.\n3\t * Reads CTA variant flag and sets it in response headers for consumption by Server Components.\n4\t * This ensures zero layout shift and no client-side hydration mismatch.\n5\t */\n6\t\n7\timport { NextRequest, NextResponse } from \"next/server\";\n8\timport { getVariant } from \"@/lib/flags\";\n9\t\n10\t/**\n11\t * Middleware that evaluates A/B test flags for feature flag-controlled pages.\n12\t * Runs before route handlers and Server Components render.\n13\t */\n14\texport async function middleware(request: NextRequest) {\n15\t  const response = NextResponse.next();\n16\t\n17\t  // Evaluate the CTA variant for the /book page\n18\t  if (request.nextUrl.pathname.startsWith(\"/book\")) {\n19\t    const variant = await getVariant();\n20\t\n21\t    // Pass variant to Server Components via response header\n22\t    response.headers.set(\"x-variant\", variant);\n23\t\n24\t    // Also set as cookie for client-side tracking (optional)\n25\t    response.cookies.set(\"x-variant\", variant, {\n26\t      httpOnly: false, // Allow client JS to read for GA4 tracking\n27\t      path: \"/\",\n28\t      maxAge: 30 * 24 * 60 * 60, // 30 days\n29\t      sameSite: \"lax\",\n30\t    });\n31\t  }\n32\t\n33\t  return response;\n34\t}\n35\t\n36\texport const config = {\n37\t  matcher: [\n38\t    /*\n39\t     * Match all request paths except for the ones starting with:\n40\t     * - api (API routes)\n41\t     * - _next/static (static files)\n42\t     * - _next/image (image optimization files)\n43\t     * - favicon.ico (favicon file)\n44\t     * - public (public assets)\n45\t     */\n46\t    \"/((?!api|_next/static|_next/image|favicon.ico|public).*)\",\n47\t  ],\n48\t};\n49\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"a0509890-c56d-430e-b350-61a2b3042ba1","uuid":"fa7cca3d-8b29-4e83-896d-49ab38906beb","timestamp":"2026-04-14T06:33:16.932Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\middleware.ts.bak","content":"/**\n * Next.js Middleware — Evaluates Vercel Feature Flags server-side.\n * Reads CTA variant flag and sets it in response headers for consumption by Server Components.\n * This ensures zero layout shift and no client-side hydration mismatch.\n */\n\nimport { NextRequest, NextResponse } from \"next/server\";\nimport { getVariant } from \"@/lib/flags\";\n\n/**\n * Middleware that evaluates A/B test flags for feature flag-controlled pages.\n * Runs before route handlers and Server Components render.\n */\nexport async function middleware(request: NextRequest) {\n  const response = NextResponse.next();\n\n  // Evaluate the CTA variant for the /book page\n  if (request.nextUrl.pathname.startsWith(\"/book\")) {\n    const variant = await getVariant();\n\n    // Pass variant to Server Components via response header\n    response.headers.set(\"x-variant\", variant);\n\n    // Also set as cookie for client-side tracking (optional)\n    response.cookies.set(\"x-variant\", variant, {\n      httpOnly: false, // Allow client JS to read for GA4 tracking\n      path: \"/\",\n      maxAge: 30 * 24 * 60 * 60, // 30 days\n      sameSite: \"lax\",\n    });\n  }\n\n  return response;\n}\n\nexport const config = {\n  matcher: [\n    /*\n     * Match all request paths except for the ones starting with:\n     * - api (API routes)\n     * - _next/static (static files)\n     * - _next/image (image optimization files)\n     * - favicon.ico (favicon file)\n     * - public (public assets)\n     */\n    \"/((?!api|_next/static|_next/image|favicon.ico|public).*)\",\n  ],\n};\n","numLines":49,"startLine":1,"totalLines":49}}}
