{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ab15SZphxUgWMvaTUFSm5G","type":"tool_result","content":"1\t/**\n2\t * instrumentation-client.ts\n3\t *\n4\t * Next.js 15.3+ client instrumentation hook — runs once before React hydration.\n5\t * Centralises Sentry, web-vitals, and Clarity initialisation so that errors\n6\t * and metrics captured during the earliest lifecycle are never missed.\n7\t *\n8\t * IMPORTANT: No React / JSX imports — this file executes before the framework.\n9\t */\n10\t\n11\timport * as Sentry from \"@sentry/nextjs\";\n12\timport { onINP, onLCP, onCLS } from \"web-vitals/attribution\";\n13\t\n14\t// ---------------------------------------------------------------------------\n15\t// 1. Sentry — error monitoring (replaces sentry.client.config.ts)\n16\t// ---------------------------------------------------------------------------\n17\tSentry.init({\n18\t  dsn: process.env.NEXT_PUBLIC_SENTRY_DSN,\n19\t\n20\t  // Capture 10 % of transactions for performance monitoring in production\n21\t  tracesSampleRate: process.env.NODE_ENV === \"production\" ? 0.1 : 1.0,\n22\t\n23\t  // Replay 10 % of sessions, 100 % of sessions with errors\n24\t  replaysSessionSampleRate: 0.1,\n25\t  replaysOnErrorSampleRate: 1.0,\n26\t\n27\t  // Filter known non-actionable browser errors\n28\t  ignoreErrors: [\n29\t    \"ResizeObserver loop limit exceeded\",\n30\t    \"ResizeObserver loop completed with undelivered notifications\",\n31\t    \"Network request failed\",\n32\t    \"Failed to fetch\",\n33\t    \"Load failed\",\n34\t    \"AbortError\",\n35\t  ],\n36\t\n37\t  debug: false,\n38\t});\n39\t\n40\t// ---------------------------------------------------------------------------\n41\t// 2. Web Vitals — INP, LCP, CLS → GA4 via gtag / dataLayer\n42\t// ---------------------------------------------------------------------------\n43\tinterface WindowWithGtag {\n44\t  dataLayer: unknown[];\n45\t  gtag?: (...args: unknown[]) => void;\n46\t}\n47\t\n48\tfunction sendToGA(eventParams: Record<string, string | number>) {\n49\t  const w = window as unknown as WindowWithGtag;\n50\t  w.dataLayer = w.dataLayer || [];\n51\t  if (typeof w.gtag !== \"function\") {\n52\t    w.gtag = (...args: unknown[]) => {\n53\t      w.dataLayer.push(args);\n54\t    };\n55\t  }\n56\t  w.gtag!(\"event\", \"web_vitals\", eventParams);\n57\t}\n58\t\n59\tonINP((metric) => {\n60\t  const attr = metric.attribution;\n61\t  sendToGA({\n62\t    metric_name: \"INP\",\n63\t    metric_value: metric.value,\n64\t    metric_id: metric.id,\n65\t    input_delay: attr.inputDelay ?? 0,\n66\t    processing_time: attr.processingDuration ?? 0,\n67\t    presentation_delay: attr.presentationDelay ?? 0,\n68\t    interaction_target: attr.interactionTarget ?? \"\",\n69\t  });\n70\t});\n71\t\n72\tonLCP((metric) => {\n73\t  sendToGA({\n74\t    metric_name: \"LCP\",\n75\t    metric_value: metric.value,\n76\t    metric_id: metric.id,\n77\t  });\n78\t});\n79\t\n80\tonCLS((metric) => {\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"a0509890-c56d-430e-b350-61a2b3042ba1","uuid":"30df0c47-6853-4cba-8e64-814dd92e2a3c","timestamp":"2026-04-14T06:37:38.576Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\instrumentation-client.ts","content":"/**\n * instrumentation-client.ts\n *\n * Next.js 15.3+ client instrumentation hook — runs once before React hydration.\n * Centralises Sentry, web-vitals, and Clarity initialisation so that errors\n * and metrics captured during the earliest lifecycle are never missed.\n *\n * IMPORTANT: No React / JSX imports — this file executes before the framework.\n */\n\nimport * as Sentry from \"@sentry/nextjs\";\nimport { onINP, onLCP, onCLS } from \"web-vitals/attribution\";\n\n// ---------------------------------------------------------------------------\n// 1. Sentry — error monitoring (replaces sentry.client.config.ts)\n// ---------------------------------------------------------------------------\nSentry.init({\n  dsn: process.env.NEXT_PUBLIC_SENTRY_DSN,\n\n  // Capture 10 % of transactions for performance monitoring in production\n  tracesSampleRate: process.env.NODE_ENV === \"production\" ? 0.1 : 1.0,\n\n  // Replay 10 % of sessions, 100 % of sessions with errors\n  replaysSessionSampleRate: 0.1,\n  replaysOnErrorSampleRate: 1.0,\n\n  // Filter known non-actionable browser errors\n  ignoreErrors: [\n    \"ResizeObserver loop limit exceeded\",\n    \"ResizeObserver loop completed with undelivered notifications\",\n    \"Network request failed\",\n    \"Failed to fetch\",\n    \"Load failed\",\n    \"AbortError\",\n  ],\n\n  debug: false,\n});\n\n// ---------------------------------------------------------------------------\n// 2. Web Vitals — INP, LCP, CLS → GA4 via gtag / dataLayer\n// ---------------------------------------------------------------------------\ninterface WindowWithGtag {\n  dataLayer: unknown[];\n  gtag?: (...args: unknown[]) => void;\n}\n\nfunction sendToGA(eventParams: Record<string, string | number>) {\n  const w = window as unknown as WindowWithGtag;\n  w.dataLayer = w.dataLayer || [];\n  if (typeof w.gtag !== \"function\") {\n    w.gtag = (...args: unknown[]) => {\n      w.dataLayer.push(args);\n    };\n  }\n  w.gtag!(\"event\", \"web_vitals\", eventParams);\n}\n\nonINP((metric) => {\n  const attr = metric.attribution;\n  sendToGA({\n    metric_name: \"INP\",\n    metric_value: metric.value,\n    metric_id: metric.id,\n    input_delay: attr.inputDelay ?? 0,\n    processing_time: attr.processingDuration ?? 0,\n    presentation_delay: attr.presentationDelay ?? 0,\n    interaction_target: attr.interactionTarget ?? \"\",\n  });\n});\n\nonLCP((metric) => {\n  sendToGA({\n    metric_name: \"LCP\",\n    metric_value: metric.value,\n    metric_id: metric.id,\n  });\n});\n\nonCLS((metric) => {","numLines":80,"startLine":1,"totalLines":208}}}
