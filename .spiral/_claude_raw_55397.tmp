{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017pwg2cxqA24ohW4te1ygEk","type":"tool_result","content":"1\t/**\n2\t * Vercel Feature Flags and flag resolution logic.\n3\t * Reads flags from Edge Config in production, falls back to mock values in local dev.\n4\t * Reference: https://vercel.com/docs/feature-flags\n5\t */\n6\t\n7\texport type CTAVariant = \"book-now\" | \"check-availability\" | \"best-price-direct\";\n8\t\n9\texport interface FlagsConfig {\n10\t  \"cta-variant\": CTAVariant;\n11\t}\n12\t\n13\t// Default flags for development / fallback\n14\tconst DEFAULT_FLAGS: FlagsConfig = {\n15\t  \"cta-variant\": \"book-now\",\n16\t};\n17\t\n18\t/**\n19\t * Get a flag value from Edge Config (production) or mock (local dev).\n20\t * In production with Vercel Edge Config enabled, reads the flag value.\n21\t * In development or when Edge Config is not configured, falls back to environment variable.\n22\t *\n23\t * @param key - The flag key (e.g., 'cta-variant')\n24\t * @param defaultValue - Fallback value if flag is not found\n25\t * @returns The flag value\n26\t */\n27\texport async function getFlag<K extends keyof FlagsConfig>(\n28\t  key: K,\n29\t  defaultValue?: FlagsConfig[K]\n30\t): Promise<FlagsConfig[K]> {\n31\t  try {\n32\t    // In production: Use @vercel/edge-config if available\n33\t    if (process.env.EDGE_CONFIG) {\n34\t      const { get } = await import(\"@vercel/edge-config\");\n35\t      const value = (await get(key)) as FlagsConfig[K] | undefined;\n36\t      if (value !== undefined) {\n37\t        return value;\n38\t      }\n39\t    }\n40\t\n41\t    // Fallback to environment variable for local development\n42\t    if (key === \"cta-variant\") {\n43\t      const envValue = process.env.NEXT_PUBLIC_FLAG_CTA_VARIANT as CTAVariant | undefined;\n44\t      if (envValue) {\n45\t        return envValue as FlagsConfig[K];\n46\t      }\n47\t    }\n48\t\n49\t    // Final fallback to hardcoded defaults\n50\t    return defaultValue ?? DEFAULT_FLAGS[key];\n51\t  } catch (error) {\n52\t    console.error(`[flags] Error reading flag '${key}':`, error);\n53\t    return defaultValue ?? DEFAULT_FLAGS[key];\n54\t  }\n55\t}\n56\t\n57\t/**\n58\t * Get the CTA variant for A/B testing.\n59\t * Evaluates the flag and returns the assigned variant for this session.\n60\t *\n61\t * @returns The assigned variant\n62\t */\n63\texport async function getVariant(): Promise<CTAVariant> {\n64\t  return getFlag(\"cta-variant\");\n65\t}\n66\t\n67\t/**\n68\t * Get the human-readable CTA button text for a given variant.\n69\t */\n70\texport function getCTAText(variant: CTAVariant): string {\n71\t  const ctaMap: Record<CTAVariant, string> = {\n72\t    \"book-now\": \"Book via WhatsApp\",\n73\t    \"check-availability\": \"Check Availability\",\n74\t    \"best-price-direct\": \"Get Best Price Direct\",\n75\t  };\n76\t  return ctaMap[variant] ?? \"Book via WhatsApp\";\n77\t}\n78\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"a0509890-c56d-430e-b350-61a2b3042ba1","uuid":"848ed5b8-49d1-4584-95b4-5b8a91249e6c","timestamp":"2026-04-14T06:33:16.830Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\lib\\flags.ts","content":"/**\n * Vercel Feature Flags and flag resolution logic.\n * Reads flags from Edge Config in production, falls back to mock values in local dev.\n * Reference: https://vercel.com/docs/feature-flags\n */\n\nexport type CTAVariant = \"book-now\" | \"check-availability\" | \"best-price-direct\";\n\nexport interface FlagsConfig {\n  \"cta-variant\": CTAVariant;\n}\n\n// Default flags for development / fallback\nconst DEFAULT_FLAGS: FlagsConfig = {\n  \"cta-variant\": \"book-now\",\n};\n\n/**\n * Get a flag value from Edge Config (production) or mock (local dev).\n * In production with Vercel Edge Config enabled, reads the flag value.\n * In development or when Edge Config is not configured, falls back to environment variable.\n *\n * @param key - The flag key (e.g., 'cta-variant')\n * @param defaultValue - Fallback value if flag is not found\n * @returns The flag value\n */\nexport async function getFlag<K extends keyof FlagsConfig>(\n  key: K,\n  defaultValue?: FlagsConfig[K]\n): Promise<FlagsConfig[K]> {\n  try {\n    // In production: Use @vercel/edge-config if available\n    if (process.env.EDGE_CONFIG) {\n      const { get } = await import(\"@vercel/edge-config\");\n      const value = (await get(key)) as FlagsConfig[K] | undefined;\n      if (value !== undefined) {\n        return value;\n      }\n    }\n\n    // Fallback to environment variable for local development\n    if (key === \"cta-variant\") {\n      const envValue = process.env.NEXT_PUBLIC_FLAG_CTA_VARIANT as CTAVariant | undefined;\n      if (envValue) {\n        return envValue as FlagsConfig[K];\n      }\n    }\n\n    // Final fallback to hardcoded defaults\n    return defaultValue ?? DEFAULT_FLAGS[key];\n  } catch (error) {\n    console.error(`[flags] Error reading flag '${key}':`, error);\n    return defaultValue ?? DEFAULT_FLAGS[key];\n  }\n}\n\n/**\n * Get the CTA variant for A/B testing.\n * Evaluates the flag and returns the assigned variant for this session.\n *\n * @returns The assigned variant\n */\nexport async function getVariant(): Promise<CTAVariant> {\n  return getFlag(\"cta-variant\");\n}\n\n/**\n * Get the human-readable CTA button text for a given variant.\n */\nexport function getCTAText(variant: CTAVariant): string {\n  const ctaMap: Record<CTAVariant, string> = {\n    \"book-now\": \"Book via WhatsApp\",\n    \"check-availability\": \"Check Availability\",\n    \"best-price-direct\": \"Get Best Price Direct\",\n  };\n  return ctaMap[variant] ?? \"Book via WhatsApp\";\n}\n","numLines":78,"startLine":1,"totalLines":78}}}
