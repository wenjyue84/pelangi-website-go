// View Transitions API for animated soft-navigation between pages (US-126)\n37\t    // Enables useViewTransition() hook and viewTransition prop on <Link>\n38\t    viewTransition: true,\n39\t    // Control Client Router Cache TTLs (staleTimes are in seconds)\n40\t    staleTimes: {\n41\t      dynamic: 30,   // Dynamic pages: cache prefetched links for 30s\n42\t      static: 180,   // Static pages: cache prefetched links for 3 min\n43\t    },\n44\t    // Turbopack file system caching for faster development cold starts (US-160)\n45\t    // Stores compiler artifacts on disk between dev server restarts\n46\t    turbopackFileSystemCacheForDev: true,\n47\t  },\n48\t  async headers() {\n49\t    return [\n50\t      {\n51\t        source: \"/(.*)\",\n52\t        headers: [\n53\t          { key: \"X-Content-Type-Options\", value: \"nosniff\" },\n54\t          { key: \"X-Frame-Options\", value: \"SAMEORIGIN\" },\n55\t          { key: \"Referrer-Policy\", value: \"strict-origin-when-cross-origin\" },\n56\t          { key: \"Cross-Origin-Opener-Policy\", value: \"same-origin\" },\n57\t          {\n58\t            key: \"Permissions-Policy\",\n59\t            value: \"camera=(), microphone=(), geolocation=(), payment=(), usb=(), fullscreen=(self)\",\n60\t          },\n61\t          {\n62\t            key: \"Strict-Transport-Security\",\n63\t            value: \"max-age=63072000; includeSubDomains; preload\",\n64\t          },\n65\t          // CSP is now set per-request in proxy.ts (nonce-based policy)\n66\t        ],\n67\t      },\n68\t    ];\n69\t  },\n70\t  images: {\n71\t    formats: ['image/avif', 'image/webp'],\n72\t    // Next.js 16 changed qualities default to [75] — any <Image quality={n}>\n73\t    // not listed here is silently coerced to the nearest value. Declare all\n74\t    // quality tiers used across the codebase. (US-228)\n75\t    qualities: [75, 80, 85],\n76\t    // Next.js 16 increased minimumCacheTTL from 60s to 14400s (4h).\n77\t    // 1 hour is a good balance: long enough to avoid redundant re-optimisation\n78\t    // during traffic spikes, short enough to pick up image replacements\n79\t    // (e.g. updated room photos) within a reasonable window. (US-228)\n80\t    minimumCacheTTL: 3600,\n81\t    remotePatterns: [\n82\t      {\n83\t        protocol: 'https',\n84\t        hostname: 'ak-d.tripcdn.com',\n85\t      },\n86\t      {\n87\t        protocol: 'https',\n88\t        hostname: 'img.youtube.com',\n89\t      },\n90\t    ],\n91\t  },\n92\t  async rewrites() {\n93\t    const adminHost = \"https://admin.pelangicapsulehostel.com\";\n94\t    // In local dev, set RAINBOW_API_URL=http://localhost:3002 in .env.local\n95\t    const rainbowHost = process.env.RAINBOW_API_URL || adminHost;\n96\t    return [\n97\t      // Proxy the SPA shell (index.html) for the booking page\n98\t      { source: \"/book\", destination: `${adminHost}/book` },\n99\t      // Proxy Vite-built JS/CSS chunks (referenced as absolute /assets/ paths in index.html)\n100\t      { source: \"/assets/:path*\", destination: `${adminHost}/assets/:path*` },\n101\t      // Proxy the public booking API (availability check + form submission)\n102\t      { source: \"/api/public/:path*\", destination: `${adminHost}/api/public/:path*` },\n103\t      // Proxy Rainbow AI public chat API (webchat widget)\n104\t      { source: \"/api/chat/:path*\", destination: `${rainbowHost}/api/chat/:path*` },\n105\t    ];\n106\t  },\n107\t};\n108\t\n109\texport default withSerwist(withBundleAnalyzer(withSentryConfig(nextConfig, {\n110\t  // Sentry organisation and project (set via SENTRY_ORG / SENTRY_PROJECT env vars,\n111\t  // or override here for CI). These are non-secret build-time values.\n112\t  silent: !process.env.CI, // Suppress output locally; show in CI for visibility\n113\t\n114\t  // Upload source maps to Sentry on every production build.\n115\t  // Requires SENTRY_AUTH_TOKEN env var (add to CI secrets and Vercel env vars).\n116\t  authToken: process.env.SENTRY_AUTH_TOKEN,\n117\t\n118\t  // Automatically tree-shake Sentry logger statements in production\n119\t  disableLogger: true,\n120\t\n121\t  // Hides Sentry telemetry/debug output in the build logs\n122\t  telemetry: false,\n123\t})));\n124\t"}]},"parent_tool_use_id":null,"session_id":"cc0cb108-6a31-408b-bd96-18d17a736d90","uuid":"234f9962-af13-4729-a736-2ce65ba34833","timestamp":"2026-04-14T08:20:57.152Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\next.config.ts","content":"import { spawnSync } from \"node:child_process\";\nimport type { NextConfig } from \"next\";\nimport { withSentryConfig } from \"@sentry/nextjs\";\nimport withSerwistInit from \"@serwist/next\";\nimport bundleAnalyzer from \"@next/bundle-analyzer\";\n\n// Serwist: Service Worker for PWA offline fallback (US-121)\nconst revision = spawnSync(\"git\", [\"rev-parse\", \"HEAD\"], { encoding: \"utf-8\" }).stdout?.trim() ?? crypto.randomUUID();\nconst withSerwist = withSerwistInit({\n  swSrc: \"src/app/sw.ts\",\n  swDest: \"public/sw.js\",\n  additionalPrecacheEntries: [{ url: \"/~offline\", revision }],\n});\n\n// Bundle analyzer — run with: ANALYZE=true npm run build\n// Top 3 JS contributors (measured via ANALYZE=true build, 2026-03-13):\n//   1. @sentry/nextjs  — ~120 KB gzip (error monitoring SDK; tree-shaken via disableLogger)\n//   2. next (framework) — ~90 KB gzip (React runtime, router, hydration)\n//   3. fuse.js          — ~11 KB gzip (fuzzy search on /search page; loaded lazily)\n// Sentry tree-shaking: withSentryConfig({ disableLogger: true }) strips all debug/logger\n// code from the client bundle — verified via ANALYZE treemap (no sentry/utils/logger node).\nconst withBundleAnalyzer = bundleAnalyzer({\n  enabled: process.env.ANALYZE === \"true\",\n});\n\nconst nextConfig: NextConfig = {\n  poweredByHeader: false,\n  // React Compiler: automatic memoization (top-level in Next.js 16)\n  reactCompiler: true,\n  // Cache Components: explicit opt-in caching via 'use cache' directive (US-192)\n  // Replaces implicit caching; pages use cacheLife/cacheTag for fine-grained control\n  cacheComponents: true,\n  // Typed routes: stable as of Next.js 15.5 (US-153)\n  typedRoutes: true,\n  experimental: {\n    // View Transitions API for animated soft-navigation between pages (US-126)\n    // Enables useViewTransition() hook and viewTransition prop on <Link>\n    viewTransition: true,\n    // Control Client Router Cache TTLs (staleTimes are in seconds)\n    staleTimes: {\n      dynamic: 30,   // Dynamic pages: cache prefetched links for 30s\n      static: 180,   // Static pages: cache prefetched links for 3 min\n    },\n    // Turbopack file system caching for faster development cold starts (US-160)\n    // Stores compiler artifacts on disk between dev server restarts\n    turbopackFileSystemCacheForDev: true,\n  },\n  async headers() {\n    return [\n      {\n        source: \"/(.*)\",\n        headers: [\n          { key: \"X-Content-Type-Options\", value: \"nosniff\" },\n          { key: \"X-Frame-Options\", value: \"SAMEORIGIN\" },\n          { key: \"Referrer-Policy\", value: \"strict-origin-when-cross-origin\" },\n          { key: \"Cross-Origin-Opener-Policy\", value: \"same-origin\" },\n          {\n            key: \"Permissions-Policy\",\n            value: \"camera=(), microphone=(), geolocation=(), payment=(), usb=(), fullscreen=(self)\",\n          },\n          {\n            key: \"Strict-Transport-Security\",\n            value: \"max-age=63072000; includeSubDomains; preload\",\n          },\n          // CSP is now set per-request in proxy.ts (nonce-based policy)\n        ],\n      },\n    ];\n  },\n  images: {\n    formats: ['image/avif', 'image/webp'],\n    // Next.js 16 changed qualities default to [75] — any <Image quality={n}>\n    // not listed here is silently coerced to the nearest value. Declare all\n    // quality tiers used across the codebase. (US-228)\n    qualities: [75, 80, 85],\n    // Next.js 16 increased minimumCacheTTL from 60s to 14400s (4h).\n    // 1 hour is a good balance: long enough to avoid redundant re-optimisation\n    // during traffic spikes, short enough to pick up image replacements\n    // (e.g. updated room photos) within a reasonable window. (US-228)\n    minimumCacheTTL: 3600,\n    remotePatterns: [\n      {\n        protocol: 'https',\n        hostname: 'ak-d.tripcdn.com',\n      },\n      {\n        protocol: 'https',\n        hostname: 'img.youtube.com',\n      },\n    ],\n  },\n  async rewrites() {\n    const adminHost = \"https://admin.pelangicapsulehostel.com\";\n    // In local dev, set RAINBOW_API_URL=http://localhost:3002 in .env.local\n    const rainbowHost = process.env.RAINBOW_API_URL || adminHost;\n    return [\n      // Proxy the SPA shell (index.html) for the booking page\n      { source: \"/book\", destination: `${adminHost}/book` },\n      // Proxy Vite-built JS/CSS chunks (referenced as absolute /assets/ paths in index.html)\n      { source: \"/assets/:path*\", destination: `${adminHost}/assets/:path*` },\n      // Proxy the public booking API (availability check + form submission)\n      { source: \"/api/public/:path*\", destination: `${adminHost}/api/public/:path*` },\n      // Proxy Rainbow AI public chat API (webchat widget)\n      { source: \"/api/chat/:path*\", destination: `${rainbowHost}/api/chat/:path*` },\n    ];\n  },\n};\n\nexport default withSerwist(withBundleAnalyzer(withSentryConfig(nextConfig, {\n  // Sentry organisation and project (set via SENTRY_ORG / SENTRY_PROJECT env vars,\n  // or override here for CI). These are non-secret build-time values.\n  silent: !process.env.CI, // Suppress output locally; show in CI for visibility\n\n  // Upload source maps to Sentry on every production build.\n  // Requires SENTRY_AUTH_TOKEN env var (add to CI secrets and Vercel env vars).\n  authToken: process.env.SENTRY_AUTH_TOKEN,\n\n  // Automatically tree-shake Sentry logger statements in production\n  disableLogger: true,\n\n  // Hides Sentry telemetry/debug output in the build logs\n  telemetry: false,\n})));\n","numLines":124,"startLine":1,"totalLines":124}}}
