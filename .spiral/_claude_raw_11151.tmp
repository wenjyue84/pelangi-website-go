{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011oBtQcWzWEtkuG5kkacixo","type":"tool_result","content":"100\t  \"reservationStatus\": \"https://schema.org/ReservationPending\",\n101\t  \"reservationFor\": {\n102\t    \"@type\": \"LodgingBusiness\",\n103\t    \"@id\": \"https://pelangicapsulehostel.com/#hostel\",\n104\t    \"name\": \"Pelangi Capsule Hostel\",\n105\t    \"address\": {\n106\t      \"@type\": \"PostalAddress\",\n107\t      \"streetAddress\": \"26A Jalan Perang, Taman Pelangi\",\n108\t      \"addressLocality\": \"Johor Bahru\",\n109\t      \"addressRegion\": \"Johor\",\n110\t      \"postalCode\": \"80400\",\n111\t      \"addressCountry\": \"MY\",\n112\t    },\n113\t  },\n114\t  \"checkinTime\": \"T14:00:00\",\n115\t  \"checkoutTime\": \"T12:00:00\",\n116\t  \"totalPrice\": \"37.80\",\n117\t  \"priceCurrency\": \"MYR\",\n118\t};\n119\t\n120\texport default async function BookPage() {\n121\t  // Read variant from middleware (set in response header)\n122\t  const headersList = await headers();\n123\t  const variant = (headersList.get(\"x-variant\") ?? \"book-now\") as any;\n124\t  const ctaText = getCTAText(variant);\n125\t\n126\t  return (\n127\t    <main id=\"main-content\" className=\"min-h-screen bg-stone-50 dark:bg-stone-950\">\n128\t      <script\n129\t        type=\"application/ld+json\"\n130\t        dangerouslySetInnerHTML={{ __html: JSON.stringify(lodgingReservationSchema) }}\n131\t      />\n132\t      <Header />\n133\t\n134\t      {/* Hero */}\n135\t      <section className=\"pt-28 pb-16 bg-linear-to-b from-amber-800 to-amber-900 text-white relative overflow-hidden\">\n136\t        <div className=\"absolute inset-0\">\n137\t          <div className=\"absolute top-0 left-0 w-96 h-96 bg-amber-700/50 rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2\" />\n138\t          <div className=\"absolute bottom-0 right-0 w-96 h-96 bg-orange-600/20 rounded-full blur-3xl translate-x-1/2 translate-y-1/2\" />\n139\t        </div