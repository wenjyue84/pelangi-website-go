{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LXhhDm2hR4vWEiAEFYi9tk","type":"tool_result","content":"1\t\"use client\";\n2\t\n3\timport { useState, useEffect, useRef, useCallback } from \"react\";\n4\timport Image from \"next/image\";\n5\timport Lightbox from \"yet-another-react-lightbox\";\n6\timport Zoom from \"yet-another-react-lightbox/plugins/zoom\";\n7\timport Counter from \"yet-another-react-lightbox/plugins/counter\";\n8\timport \"yet-another-react-lightbox/styles.css\";\n9\timport \"yet-another-react-lightbox/plugins/counter.css\";\n10\timport {\n11\t  galleryImages,\n12\t  galleryCategories,\n13\t  type GalleryCategoryId,\n14\t  type GalleryImage,\n15\t} from \"@/data/gallery\";\n16\t\n17\tfunction GalleryThumbnail({\n18\t  image,\n19\t  index,\n20\t  onClick,\n21\t}: {\n22\t  image: GalleryImage;\n23\t  index: number;\n24\t  onClick: (index: number) => void;\n25\t}) {\n26\t  return (\n27\t    <button\n28\t      type=\"button\"\n29\t      onClick={() => onClick(index)}\n30\t      className=\"relative aspect-[4/3] rounded-xl overflow-hidden group focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600\"\n31\t      aria-label={`View photo: ${image.alt}`}\n32\t    >\n33\t      <Image\n34\t        src={image.src}\n35\t        alt={image.alt}\n36\t        fill\n37\t        sizes=\"(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 25vw\"\n38\t        className=\"object-cover transition-transform duration-300 group-hover:scale-105\"\n39\t        loading=\"lazy\"\n40\t      />\n41\t      <div className=\"absolute inset-0 bg-stone-900/0 group-hover:bg-stone-900/20 transition-colors duration-300\" />\n42\t      <div className=\"absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300\">\n43\t        <svg\n44\t          className=\"w-8 h-8 text-white drop-shadow-lg\"\n45\t          fill=\"none\"\n46\t          stroke=\"currentColor\"\n47\t          viewBox=\"0 0 24 24\"\n48\t          aria-hidden=\"true\"\n49\t        >\n50\t          <path\n51\t            strokeLinecap=\"round\"\n52\t            strokeLinejoin=\"round\"\n53\t            strokeWidth={2}\n54\t            d=\"M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7\"\n55\t          />\n56\t        </svg>\n57\t      </div>\n58\t    </button>\n59\t  );\n60\t}\n61\t\n62\texport default function PhotoGallery() {\n63\t  const [lightboxOpen, setLightboxOpen] = useState(false);\n64\t  const [lightboxIndex, setLightboxIndex] = useState(0);\n65\t  const [activeCategory, setActiveCategory] = useState<GalleryCategoryId>(\"all\");\n66\t  const [isVisible, setIsVisible] = useState(false);\n67\t  const sectionRef = useRef<HTMLElement>(null);\n68\t\n69\t  // Intersection Observer for lazy initialization\n70\t  useEffect(() => {\n71\t    const el = sectionRef.current;\n72\t    if (!el) return;\n73\t\n74\t    const observer = new IntersectionObserver(\n75\t      ([entry]) => {\n76\t        if (entry.isIntersecting) {\n77\t          setIsVisible(true);\n78\t          observer.disconnect();\n79\t        }\n80\t      },\n81\t      { rootMargin: \"200px\" }\n82\t    );\n83\t\n84\t    observer.observe(el);\n85\t    return () => observer.disconnect();\n86\t  }, []);\n87\t\n88\t  const filteredImages =\n89\t    activeCategory === \"all\"\n90\t      ? galleryImages\n91\t      : galleryImages.filter((img) => img.category === activeCategory);\n92\t\n93\t  const lightboxSlides = filteredImages.map((img) => ({\n94\t    src: img.src,\n95\t    alt: img.alt,\n96\t    width: img.width,\n97\t    height: img.height,\n98\t  }));\n99\t\n100\t  const handleThumbnailClick = useCallback((index: number) => {\n101\t    setLightboxIndex(index);\n102\t    setLightboxOpen(true);\n103\t  }, []);\n104\t\n105\t  return (\n106\t    <section\n107\t      ref={sectionRef}\n108\t      className=\"py-16 bg-stone-50 dark:bg-stone-950\"\n109\t      aria-labelledby=\"gallery-heading\"\n110\t    >\n111\t      <div className=\"container-custom\">\n112\t        <div className=\"text-center mb-10\">\n113\t          <p className=\"section-label\">Gallery</p>\n114\t          <h2\n115\t            id=\"gallery-heading\"\n116\t            className=\"section-heading mb-4\"\n117\t          >\n118\t            Explore Our Space\n119\t          </h2>\n120\t          <p className=\"text-stone-600 dark:text-stone-400 text-lg max-w-2xl mx-auto\">\n121\t            Take a closer look at our capsule pods, shared facilities, and\n122\t            everything that makes Pelangi Capsule Hostel feel like home.\n123\t          </p>\n124\t        </div>\n125\t\n126\t        {/* Category filter */}\n127\t        <div\n128\t          className=\"flex flex-wrap justify-center gap-2 mb-10\"\n129\t          role=\"tablist\"\n130\t          aria-label=\"Filter gallery by category\"\n131\t        >\n132\t          {galleryCategories.map((cat) => (\n133\t            <button\n134\t              key={cat.id}\n135\t              role=\"tab\"\n136\t              aria-selected={activeCategory === cat.id}\n137\t              onClick={() => setActiveCategory(cat.id)}\n138\t              className={`px-4 py-2 rounded-full text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 ${\n139\t                activeCategory === cat.id\n140\t                  ? \"bg-amber-600 text-white\"\n141\t                  : \"bg-white dark:bg-stone-800 text-stone-600 dark:text-stone-400 hover:bg-stone-100 dark:hover:bg-stone-700\"\n142\t              }`}\n143\t            >\n144\t              {cat.label}\n145\t            </button>\n146\t          ))}\n147\t        </div>\n148\t\n149\t        {/* Gallery grid */}\n150\t        {isVisible && (\n151\t          <div\n152\t            className=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4\"\n153\t            role=\"tabpanel\"\n154\t            aria-label={`${galleryCategories.find((c) => c.id === activeCategory)?.label} photos`}\n155\t          >\n156\t            {filteredImages.map((image, index) => (\n157\t              <GalleryThumbnail\n158\t                key={image.src}\n159\t                image={image}\n160\t                index={index}\n161\t                onClick={handleThumbnailClick}\n162\t              />\n163\t            ))}\n164\t          </div>\n165\t        )}\n166\t\n167\t        {!isVisible && (\n168\t          <div className=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4\">\n169\t            {Array.from({ length: 8 }).map((_, i) => (\n170\t              <div\n171\t                key={i}\n172\t                className=\"aspect-[4/3] rounded-xl bg-stone-200 dark:bg-stone-800 animate-pulse\"\n173\t              />\n174\t            ))}\n175\t          </div>\n176\t        )}\n177\t      </div>\n178\t\n179\t      {/* Lightbox */}\n180\t      <Lightbox\n181\t        open={lightboxOpen}\n182\t        close={() => setLightboxOpen(false)}\n183\t        index={lightboxIndex}\n184\t        slides={lightboxSlides}\n185\t        plugins={[Zoom, Counter]}\n186\t        animation={{ fade: 300 }}\n187\t        carousel={{ finite: true }}\n188\t        controller={{ closeOnBackdropClick: true }}\n189\t        labels={{\n190\t          Next: \"Next photo\",\n191\t          Previous: \"Previous photo\",\n192\t          Close: \"Close gallery\",\n193\t        }}\n194\t      />\n195\t    </section>\n196\t  );\n197\t}\n198\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"c8cb50fe-9df1-48cd-b7a1-251e7a41c10c","uuid":"0558833e-614a-4030-8d5f-7ad82fce756f","timestamp":"2026-04-14T05:09:49.088Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\components\\PhotoGallery.tsx","content":"\"use client\";\n\nimport { useState, useEffect, useRef, useCallback } from \"react\";\nimport Image from \"next/image\";\nimport Lightbox from \"yet-another-react-lightbox\";\nimport Zoom from \"yet-another-react-lightbox/plugins/zoom\";\nimport Counter from \"yet-another-react-lightbox/plugins/counter\";\nimport \"yet-another-react-lightbox/styles.css\";\nimport \"yet-another-react-lightbox/plugins/counter.css\";\nimport {\n  galleryImages,\n  galleryCategories,\n  type GalleryCategoryId,\n  type GalleryImage,\n} from \"@/data/gallery\";\n\nfunction GalleryThumbnail({\n  image,\n  index,\n  onClick,\n}: {\n  image: GalleryImage;\n  index: number;\n  onClick: (index: number) => void;\n}) {\n  return (\n    <button\n      type=\"button\"\n      onClick={() => onClick(index)}\n      className=\"relative aspect-[4/3] rounded-xl overflow-hidden group focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600\"\n      aria-label={`View photo: ${image.alt}`}\n    >\n      <Image\n        src={image.src}\n        alt={image.alt}\n        fill\n        sizes=\"(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 25vw\"\n        className=\"object-cover transition-transform duration-300 group-hover:scale-105\"\n        loading=\"lazy\"\n      />\n      <div className=\"absolute inset-0 bg-stone-900/0 group-hover:bg-stone-900/20 transition-colors duration-300\" />\n      <div className=\"absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300\">\n        <svg\n          className=\"w-8 h-8 text-white drop-shadow-lg\"\n          fill=\"none\"\n          stroke=\"currentColor\"\n          viewBox=\"0 0 24 24\"\n          aria-hidden=\"true\"\n        >\n          <path\n            strokeLinecap=\"round\"\n            strokeLinejoin=\"round\"\n            strokeWidth={2}\n            d=\"M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7\"\n          />\n        </svg>\n      </div>\n    </button>\n  );\n}\n\nexport default function PhotoGallery() {\n  const [lightboxOpen, setLightboxOpen] = useState(false);\n  const [lightboxIndex, setLightboxIndex] = useState(0);\n  const [activeCategory, setActiveCategory] = useState<GalleryCategoryId>(\"all\");\n  const [isVisible, setIsVisible] = useState(false);\n  const sectionRef = useRef<HTMLElement>(null);\n\n  // Intersection Observer for lazy initialization\n  useEffect(() => {\n    const el = sectionRef.current;\n    if (!el) return;\n\n    const observer = new IntersectionObserver(\n      ([entry]) => {\n        if (entry.isIntersecting) {\n          setIsVisible(true);\n          observer.disconnect();\n        }\n      },\n      { rootMargin: \"200px\" }\n    );\n\n    observer.observe(el);\n    return () => observer.disconnect();\n  }, []);\n\n  const filteredImages =\n    activeCategory === \"all\"\n      ? galleryImages\n      : galleryImages.filter((img) => img.category === activeCategory);\n\n  const lightboxSlides = filteredImages.map((img) => ({\n    src: img.src,\n    alt: img.alt,\n    width: img.width,\n    height: img.height,\n  }));\n\n  const handleThumbnailClick = useCallback((index: number) => {\n    setLightboxIndex(index);\n    setLightboxOpen(true);\n  }, []);\n\n  return (\n    <section\n      ref={sectionRef}\n      className=\"py-16 bg-stone-50 dark:bg-stone-950\"\n      aria-labelledby=\"gallery-heading\"\n    >\n      <div className=\"container-custom\">\n        <div className=\"text-center mb-10\">\n          <p className=\"section-label\">Gallery</p>\n          <h2\n            id=\"gallery-heading\"\n            className=\"section-heading mb-4\"\n          >\n            Explore Our Space\n          </h2>\n          <p className=\"text-stone-600 dark:text-stone-400 text-lg max-w-2xl mx-auto\">\n            Take a closer look at our capsule pods, shared facilities, and\n            everything that makes Pelangi Capsule Hostel feel like home.\n          </p>\n        </div>\n\n        {/* Category filter */}\n        <div\n          className=\"flex flex-wrap justify-center gap-2 mb-10\"\n          role=\"tablist\"\n          aria-label=\"Filter gallery by category\"\n        >\n          {galleryCategories.map((cat) => (\n            <button\n              key={cat.id}\n              role=\"tab\"\n              aria-selected={activeCategory === cat.id}\n              onClick={() => setActiveCategory(cat.id)}\n              className={`px-4 py-2 rounded-full text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 ${\n                activeCategory === cat.id\n                  ? \"bg-amber-600 text-white\"\n                  : \"bg-white dark:bg-stone-800 text-stone-600 dark:text-stone-400 hover:bg-stone-100 dark:hover:bg-stone-700\"\n              }`}\n            >\n              {cat.label}\n            </button>\n          ))}\n        </div>\n\n        {/* Gallery grid */}\n        {isVisible && (\n          <div\n            className=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4\"\n            role=\"tabpanel\"\n            aria-label={`${galleryCategories.find((c) => c.id === activeCategory)?.label} photos`}\n          >\n            {filteredImages.map((image, index) => (\n              <GalleryThumbnail\n                key={image.src}\n                image={image}\n                index={index}\n                onClick={handleThumbnailClick}\n              />\n            ))}\n          </div>\n        )}\n\n        {!isVisible && (\n          <div className=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4\">\n            {Array.from({ length: 8 }).map((_, i) => (\n              <div\n                key={i}\n                className=\"aspect-[4/3] rounded-xl bg-stone-200 dark:bg-stone-800 animate-pulse\"\n              />\n            ))}\n          </div>\n        )}\n      </div>\n\n      {/* Lightbox */}\n      <Lightbox\n        open={lightboxOpen}\n        close={() => setLightboxOpen(false)}\n        index={lightboxIndex}\n        slides={lightboxSlides}\n        plugins={[Zoom, Counter]}\n        animation={{ fade: 300 }}\n        carousel={{ finite: true }}\n        controller={{ closeOnBackdropClick: true }}\n        labels={{\n          Next: \"Next photo\",\n          Previous: \"Previous photo\",\n          Close: \"Close gallery\",\n        }}\n      />\n    </section>\n  );\n}\n","numLines":198,"startLine":1,"totalLines":198}}}
