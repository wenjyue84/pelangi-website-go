{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VG5qxKLypSLrsKC56R4sdv","type":"tool_result","content":"1\t'use client';\n2\t\n3\timport { Activity } from 'react';\n4\timport { useState } from 'react';\n5\timport Image from 'next/image';\n6\timport Link from 'next/link';\n7\timport capsule4Image from '../../public/images/capsule-4.webp';\n8\timport capsule2Image from '../../public/images/capsule-2.webp';\n9\timport capsule3Image from '../../public/images/capsule-3.webp';\n10\t\n11\ttype RoomTab = 'standard' | 'premium' | 'monthly';\n12\t\n13\tconst TABS: { id: RoomTab; label: string; badge?: string }[] = [\n14\t  { id: 'standard', label: 'Standard Pod' },\n15\t  { id: 'premium', label: 'Premium Pod', badge: 'Enhanced' },\n16\t  { id: 'monthly', label: 'Long Stay' },\n17\t];\n18\t\n19\tconst standardFeatures = [\n20\t  'Personal climate control',\n21\t  'Adjustable LED lighting',\n22\t  'USB & power outlets',\n23\t  'Privacy sliding door',\n24\t  'Premium mattress',\n25\t  'Personal locker',\n26\t];\n27\t\n28\tconst premiumFeatures = [\n29\t  'Personal climate control',\n30\t  'Enhanced LED lighting system',\n31\t  'USB & power outlets',\n32\t  'Privacy sliding door',\n33\t  'Premium memory foam mattress',\n34\t  'Personal locker',\n35\t  'Extra storage space',\n36\t];\n37\t\n38\tconst monthlyFeatures = [\n39\t  'Fixed monthly rate — no nightly fluctuation',\n40\t  'Priority room assignment',\n41\t  'Personal climate control',\n42\t  'Adjustable LED lighting',\n43\t  'USB & power outlets',\n44\t  'Privacy sliding door',\n45\t  'Premium mattress',\n46\t  'Personal locker',\n47\t];\n48\t\n49\tfunction FeatureList({ features }: { features: string[] }) {\n50\t  return (\n51\t    <div className=\"space-y-4 grow\">\n52\t      {features.map((feature, index) => (\n53\t        <div key={index} className=\"flex items-center gap-4\">\n54\t          <div className=\"w-10 h-10 rounded-xl bg-white dark:bg-stone-700 flex items-center justify-center shadow-xs shrink-0\">\n55\t            <svg\n56\t              className=\"w-5 h-5 text-amber-600 dark:text-amber-400\"\n57\t              fill=\"none\"\n58\t              stroke=\"currentColor\"\n59\t              viewBox=\"0 0 24 24\"\n60\t              aria-hidden=\"true\"\n61\t            >\n62\t              <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={1.5} d=\"M5 13l4 4L19 7\" />\n63\t            </svg>\n64\t          </div>\n65\t          <span className=\"text-stone-700 dark:text-stone-300\">{feature}</span>\n66\t        </div>\n67\t      ))}\n68\t    </div>\n69\t  );\n70\t}\n71\t\n72\tfunction RateRow({ label, value }: { label: string; value: string }) {\n73\t  return (\n74\t    <div className=\"flex justify-between text-sm\">\n75\t      <span className=\"text-stone-500 dark:text-stone-400\">{label}</span>\n76\t      <span className=\"font-medium text-stone-800 dark:text-stone-200\">{value}</span>\n77\t    </div>\n78\t  );\n79\t}\n80\t\n81\texport default function RoomsTabsClient() {\n82\t  const [activeTab, setActiveTab] = useState<RoomTab>('standard');\n83\t\n84\t  return (\n85\t    <div>\n86\t      {/* Tab navigation */}\n87\t      <div\n88\t        role=\"tablist\"\n89\t        aria-label=\"Room type\"\n90\t        className=\"flex gap-2 mb-8 bg-stone-100 dark:bg-stone-800 rounded-2xl p-1.5\"\n91\t      >\n92\t        {TABS.map((tab) => (\n93\t          <button\n94\t            key={tab.id}\n95\t            role=\"tab\"\n96\t            aria-selected={activeTab === tab.id}\n97\t            aria-controls={`tabpanel-${tab.id}`}\n98\t            id={`tab-${tab.id}`}\n99\t            onClick={() => setActiveTab(tab.id)}\n100\t            className={`flex-1 flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl text-sm font-medium transition-all duration-200 ${\n101\t              activeTab === tab.id\n102\t                ? 'bg-white dark:bg-stone-700 text-stone-900 dark:text-stone-100 shadow-sm'\n103\t                : 'text-stone-500 dark:text-stone-400 hover:text-stone-700 dark:hover:text-stone-300'\n104\t            }`}\n105\t          >\n106\t            {tab.label}\n107\t            {tab.badge && (\n108\t              <span className=\"inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-amber-100 dark:bg-amber-900/30 text-amber-800 dark:text-amber-300\">\n109\t                {tab.badge}\n110\t              </span>\n111\t            )}\n112\t          </button>\n113\t        ))}\n114\t      </div>\n115\t\n116\t      {/* Standard Pod tab panel */}\n117\t      <Activity mode={activeTab === 'standard' ? 'visible' : 'hidden'} name=\"standard-pod-tab\">\n118\t        <div\n119\t          id=\"tabpanel-standard\"\n120\t          role=\"tabpanel\"\n121\t          aria-labelledby=\"tab-standard\"\n122\t          className=\"grid lg:grid-cols-5 gap-8 lg:gap-12\"\n123\t        >\n124\t          {/* Image gallery */}\n125\t          <div className=\"lg:col-span-3 grid sm:grid-cols-2 gap-4\">\n126\t            <div className=\"relative h-64 md:h-72 rounded-2xl overflow-hidden group sm:col-span-2\">\n127\t              <Image\n128\t                src={capsule4Image}\n129\t                alt=\"Modern Japanese-style capsule pod interior at Pelangi Hostel Johor Bahru with personal lighting and privacy curtain\"\n130\t                fill\n131\t                sizes=\"(max-width: 1024px) 100vw, 60vw\"\n132\t                quality={80}\n133\t                className=\"object-cover image-zoom\"\n134\t                placeholder=\"blur\"\n135\t                fetchPriority=\"low\"\n136\t              />\n137\t              <div className=\"absolute inset-0 bg-linear-to-t from-stone-900/40 to-transparent\" />\n138\t              <div className=\"absolute bottom-4 left-4 text-white\">\n139\t                <div className=\"text-xs tracking-widest uppercase opacity-70\">Featured</div>\n140\t                <div className=\"text-lg font-medium\">Standard Capsule Interior</div>\n141\t              </div>\n142\t            </div>\n143\t            <div className=\"relative h-48 md:h-56 rounded-2xl overflow-hidden group\">\n144\t              <Image\n145\t                src={capsule2Image}\n146\t                alt=\"Comfortable mattress in standard capsule pod at Pelangi Hostel JB\"\n147\t                fill\n148\t                sizes=\"(max-width: 768px) 50vw, (max-width: 1024px) 50vw, 30vw\"\n149\t                quality={80}\n150\t                className=\"object-cover image-zoom\"\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"c8cb50fe-9df1-48cd-b7a1-251e7a41c10c","uuid":"5e4c2cb4-e4ed-4f5e-92b1-c4c9193b8c3c","timestamp":"2026-04-14T05:09:52.830Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\components\\RoomsTabsClient.tsx","content":"'use client';\n\nimport { Activity } from 'react';\nimport { useState } from 'react';\nimport Image from 'next/image';\nimport Link from 'next/link';\nimport capsule4Image from '../../public/images/capsule-4.webp';\nimport capsule2Image from '../../public/images/capsule-2.webp';\nimport capsule3Image from '../../public/images/capsule-3.webp';\n\ntype RoomTab = 'standard' | 'premium' | 'monthly';\n\nconst TABS: { id: RoomTab; label: string; badge?: string }[] = [\n  { id: 'standard', label: 'Standard Pod' },\n  { id: 'premium', label: 'Premium Pod', badge: 'Enhanced' },\n  { id: 'monthly', label: 'Long Stay' },\n];\n\nconst standardFeatures = [\n  'Personal climate control',\n  'Adjustable LED lighting',\n  'USB & power outlets',\n  'Privacy sliding door',\n  'Premium mattress',\n  'Personal locker',\n];\n\nconst premiumFeatures = [\n  'Personal climate control',\n  'Enhanced LED lighting system',\n  'USB & power outlets',\n  'Privacy sliding door',\n  'Premium memory foam mattress',\n  'Personal locker',\n  'Extra storage space',\n];\n\nconst monthlyFeatures = [\n  'Fixed monthly rate — no nightly fluctuation',\n  'Priority room assignment',\n  'Personal climate control',\n  'Adjustable LED lighting',\n  'USB & power outlets',\n  'Privacy sliding door',\n  'Premium mattress',\n  'Personal locker',\n];\n\nfunction FeatureList({ features }: { features: string[] }) {\n  return (\n    <div className=\"space-y-4 grow\">\n      {features.map((feature, index) => (\n        <div key={index} className=\"flex items-center gap-4\">\n          <div className=\"w-10 h-10 rounded-xl bg-white dark:bg-stone-700 flex items-center justify-center shadow-xs shrink-0\">\n            <svg\n              className=\"w-5 h-5 text-amber-600 dark:text-amber-400\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              viewBox=\"0 0 24 24\"\n              aria-hidden=\"true\"\n            >\n              <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={1.5} d=\"M5 13l4 4L19 7\" />\n            </svg>\n          </div>\n          <span className=\"text-stone-700 dark:text-stone-300\">{feature}</span>\n        </div>\n      ))}\n    </div>\n  );\n}\n\nfunction RateRow({ label, value }: { label: string; value: string }) {\n  return (\n    <div className=\"flex justify-between text-sm\">\n      <span className=\"text-stone-500 dark:text-stone-400\">{label}</span>\n      <span className=\"font-medium text-stone-800 dark:text-stone-200\">{value}</span>\n    </div>\n  );\n}\n\nexport default function RoomsTabsClient() {\n  const [activeTab, setActiveTab] = useState<RoomTab>('standard');\n\n  return (\n    <div>\n      {/* Tab navigation */}\n      <div\n        role=\"tablist\"\n        aria-label=\"Room type\"\n        className=\"flex gap-2 mb-8 bg-stone-100 dark:bg-stone-800 rounded-2xl p-1.5\"\n      >\n        {TABS.map((tab) => (\n          <button\n            key={tab.id}\n            role=\"tab\"\n            aria-selected={activeTab === tab.id}\n            aria-controls={`tabpanel-${tab.id}`}\n            id={`tab-${tab.id}`}\n            onClick={() => setActiveTab(tab.id)}\n            className={`flex-1 flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl text-sm font-medium transition-all duration-200 ${\n              activeTab === tab.id\n                ? 'bg-white dark:bg-stone-700 text-stone-900 dark:text-stone-100 shadow-sm'\n                : 'text-stone-500 dark:text-stone-400 hover:text-stone-700 dark:hover:text-stone-300'\n            }`}\n          >\n            {tab.label}\n            {tab.badge && (\n              <span className=\"inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-amber-100 dark:bg-amber-900/30 text-amber-800 dark:text-amber-300\">\n                {tab.badge}\n              </span>\n            )}\n          </button>\n        ))}\n      </div>\n\n      {/* Standard Pod tab panel */}\n      <Activity mode={activeTab === 'standard' ? 'visible' : 'hidden'} name=\"standard-pod-tab\">\n        <div\n          id=\"tabpanel-standard\"\n          role=\"tabpanel\"\n          aria-labelledby=\"tab-standard\"\n          className=\"grid lg:grid-cols-5 gap-8 lg:gap-12\"\n        >\n          {/* Image gallery */}\n          <div className=\"lg:col-span-3 grid sm:grid-cols-2 gap-4\">\n            <div className=\"relative h-64 md:h-72 rounded-2xl overflow-hidden group sm:col-span-2\">\n              <Image\n                src={capsule4Image}\n                alt=\"Modern Japanese-style capsule pod interior at Pelangi Hostel Johor Bahru with personal lighting and privacy curtain\"\n                fill\n                sizes=\"(max-width: 1024px) 100vw, 60vw\"\n                quality={80}\n                className=\"object-cover image-zoom\"\n                placeholder=\"blur\"\n                fetchPriority=\"low\"\n              />\n              <div className=\"absolute inset-0 bg-linear-to-t from-stone-900/40 to-transparent\" />\n              <div className=\"absolute bottom-4 left-4 text-white\">\n                <div className=\"text-xs tracking-widest uppercase opacity-70\">Featured</div>\n                <div className=\"text-lg font-medium\">Standard Capsule Interior</div>\n              </div>\n            </div>\n            <div className=\"relative h-48 md:h-56 rounded-2xl overflow-hidden group\">\n              <Image\n                src={capsule2Image}\n                alt=\"Comfortable mattress in standard capsule pod at Pelangi Hostel JB\"\n                fill\n                sizes=\"(max-width: 768px) 50vw, (max-width: 1024px) 50vw, 30vw\"\n                quality={80}\n                className=\"object-cover image-zoom\"","numLines":150,"startLine":1,"totalLines":384}}}
