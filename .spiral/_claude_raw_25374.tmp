x;\n    align-items: center;\n    justify-content: center;\n    cursor: pointer;\n    transition-property: background-color, box-shadow;\n    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n    transition-duration: 150ms;\n    position: absolute;\n    left: 0;\n    top: 50%;\n    transform: translateY(-50%);\n    z-index: 20;\n  }\n\n  .carousel-scroll-container::scroll-button(prev):hover {\n    background-color: #f5f5f4;\n  }\n\n  .carousel-scroll-container::scroll-button(next) {\n    width: 2.75rem;\n    height: 2.75rem;\n    border-radius: 9999px;\n    background-color: white;\n    box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    cursor: pointer;\n    transition-property: background-color, box-shadow;\n    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n    transition-duration: 150ms;\n    position: absolute;\n    right: 0;\n    top: 50%;\n    transform: translateY(-50%);\n    z-index: 20;\n  }\n\n  .carousel-scroll-container::scroll-button(next):hover {\n    background-color: #f5f5f4;\n  }\n\n  /* Automatic scroll marker group for keyboard-accessible navigation dots */\n  .carousel-scroll-container::scroll-marker {\n    display: flex;\n    gap: 0.5rem;\n    justify-content: center;\n    margin-top: 1rem;\n    flex-wrap: wrap;\n  }\n\n  .carousel-scroll-container::scroll-marker-item {\n    width: 0.5rem;\n    height: 0.5rem;\n    border-radius: 9999px;\n    background-color: #d6d3d1;\n    cursor: pointer;\n    transition-property: background-color;\n    transition-duration: 150ms;\n  }\n\n  .carousel-scroll-container::scroll-marker-item[aria-current=\"true\"] {\n    background-color: #b45309;\n  }\n\n  @media (prefers-color-scheme: dark) {\n    .carousel-scroll-container::scroll-button(prev),\n    .carousel-scroll-container::scroll-button(next) {\n      background-color: #292524;\n    }\n\n    .carousel-scroll-container::scroll-button(prev):hover,\n    .carousel-scroll-container::scroll-button(next):hover {\n      background-color: #44403c;\n    }\n\n    .carousel-scroll-container::scroll-marker-item {\n      background-color: #78716c;\n    }\n\n    .carousel-scroll-container::scroll-marker-item[aria-current=\"true\"] {\n      background-color: #fbbf24;\n    }\n  }\n}\n\n/* Fallback: browsers without ::scroll-button() support degrade gracefully */\n@supports not (selector(::scroll-button(*))) {\n  .carousel-scroll-container {\n    scroll-snap-type: x mandatory;\n    overflow-x: auto;\n    scrollbar-width: none;\n    -ms-overflow-style: none;\n    scroll-behavior: smooth;\n  }\n\n  .carousel-scroll-container::-webkit-scrollbar {\n    display: none;\n  }\n\n  .carousel-scroll-container > * {\n    scroll-snap-align: start;\n    scroll-snap-stop: always;\n    flex-shrink: 0;\n  }\n}","newString":"/* ============================================================\n   CSS Native Scroll-Driven Carousel (US-187)\n   Implements scroll-snap carousel with graceful degradation.\n   Future: Chrome 135+ may support ::scroll-button() and\n   ::scroll-marker pseudo-elements for automatic controls.\n   Currently uses scroll-snap CSS for fallback browsers.\n   Ensures CLS=0 via fixed aspect-ratio on carousel items.\n   Reference: https://developer.chrome.com/blog/carousels-with-css\n   Spec: https://drafts.csswg.org/css-overflow-5/#scroll-marker-group\n   ============================================================ */\n\n/* Scroll-snap carousel with hidden scrollbar (all browsers) */\n.carousel-scroll-container {\n  scroll-snap-type: x mandatory;\n  overflow-x: auto;\n  scrollbar-width: none;\n  -ms-overflow-style: none;\n  scroll-behavior: smooth;\n}\n\n.carousel-scroll-container::-webkit-scrollbar {\n  display: none;\n}\n\n.carousel-scroll-container > * {\n  scroll-snap-align: start;\n  scroll-snap-stop: always;\n  flex-shrink: 0;\n}","originalFile":"@import 'tailwindcss';\n\n@plugin \"@tailwindcss/typography\";\n\n/* ============================================================\n   CSS @property — Type-safe, animatable design tokens (US-233)\n   Registered custom properties can be interpolated by the browser\n   because their syntax is known (angle, percentage, etc.).\n   Browsers without @property support treat these as untyped\n   custom properties — static fallback values still render correctly,\n   only the animation is lost (progressive enhancement).\n   Chrome 85+, Firefox 128+, Safari 17.2+.\n   ============================================================ */\n@property --gradient-angle {\n  syntax: \"<angle>\";\n  inherits: false;\n  initial-value: 135deg;\n}\n\n@property --divider-progress {\n  syntax: \"<percentage>\";\n  inherits: false;\n  initial-value: 50%;\n}\n\n@theme {\n  --color-primary-50: #faf8f5;\n  --color-primary-100: #f5f0e8;\n  --color-primary-200: #e8ddd0;\n  --color-primary-300: #d4c4ad;\n  --color-primary-400: #bda685;\n  --color-primary-500: #a68b64;\n  --color-primary-600: #8b7355;\n  --color-primary-700: #715d47;\n  --color-primary-800: #5c4c3c;\n  --color-primary-900: #4a3f33;\n\n  --color-accent-50: #fdf8f6;\n  --color-accent-100: #f9ede8;\n  --color-accent-200: #f4dcd3;\n  --color-accent-300: #ecc4b5;\n  --color-accent-400: #e0a48d;\n  --color-accent-500: #d4846a;\n  --color-accent-600: #c26a4f;\n  --color-accent-700: #a25540;\n  --color-accent-800: #864738;\n  --color-accent-900: #6e3d31;\n\n  --color-sand-50: #fafaf9;\n  --color-sand-100: #f5f5f4;\n  --color-sand-200: #e7e5e4;\n  --color-sand-300: #d6d3d1;\n  --color-sand-400: #a8a29e;\n  --color-sand-500: #78716c;\n  --color-sand-600: #57534e;\n  --color-sand-700: #44403c;\n  --color-sand-800: #292524;\n  --color-sand-900: #1c1917;\n\n  --font-sans: var(--font-inter), system-ui, sans-serif;\n  --font-display: var(--font-playfair), Georgia, serif;\n\n  --text-2xs: 0.65rem;\n  --text-2xs--line-height: 1rem;\n\n  --tracking-widest: 0.2em;\n\n  --animate-fade-in: fadeIn 0.6s ease-out forwards;\n  --animate-slide-up: slideUp 0.6s ease-out forwards;\n  --animate-scale-in: scaleIn 0.4s ease-out forwards;\n\n  --background-image-gradient-radial: radial-gradient(var(--tw-gradient-stops));\n  --background-image-noise: url('/images/noise.png');\n\n  @keyframes fadeIn {\n    0% {\n      opacity: 0;\n    }\n    100% {\n      opacity: 1;\n    }\n  }\n  @keyframes slideUp {\n    0% {\n      opacity: 0;\n      transform: translateY(20px);\n    }\n    100% {\n      opacity: 1;\n      transform: translateY(0);\n    }\n  }\n  @keyframes scaleIn {\n    0% {\n      opacity: 0;\n      transform: scale(0.95);\n    }\n    100% {\n      opacity: 1;\n      transform: scale(1);\n    }\n  }\n}\n\n/*\n  The default border color has changed to `currentcolor` in Tailwind CSS v4,\n  so we've added these compatibility styles to make sure everything still\n  looks the same as it did with Tailwind CSS v3.\n\n  If we ever want to remove these styles, we need to add an explicit border\n  color utility to any element that depends on these defaults.\n*/\n@layer base {\n  *,\n  ::after,\n  ::before,\n  ::backdrop,\n  ::file-selector-button {\n    border-color: var(--color-gray-200, currentcolor);\n  }\n}\n\n@utility btn-primary {\n  /* Primary Button - Warm, sophisticated */\n  @apply bg-stone-700 hover:bg-stone-800 text-white font-medium\n           py-3.5 px-8 rounded-full transition-all duration-300\n           shadow-xs hover:shadow-md cursor-pointer\n           tracking-wide text-sm uppercase\n           focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700\n           dark:bg-stone-200 dark:text-stone-900 dark:hover:bg-stone-100\n           dark:focus-visible:outline-amber-400;\n}\n\n@utility btn-secondary {\n  /* Secondary Button - Minimal outline */\n  @apply bg-transparent hover:bg-stone-100 text-stone-700\n           font-medium py-3.5 px-8 rounded-full\n           border border-stone-500 hover:border-stone-600\n           transition-all duration-300 cursor-pointer\n           tracking-wide text-sm uppercase\n           focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700\n           dark:text-stone-300 dark:border-stone-600 dark:hover:bg-stone-800 dark:hover:border-stone-500\n           dark:focus-visible:outline-amber-400;\n}\n\n@utility section-padding {\n  /* Section spacing - More breathing room */\n  @apply py-20 md:py-28 lg:py-32 px-6 md:px-8;\n}\n\n/* ============================================================\n   CSS Native Scroll-Driven Carousel (US-187)\n   Chrome 135+ proposed ::scroll-button() and ::scroll-marker\n   pseudo-elements for automatic ARIA button roles and\n   keyboard handling. Wrapped in @supports guard for future.\n   Current fallback: scroll-snap CSS with hidden scrollbar.\n   Ensures CLS=0 via fixed aspect-ratio on carousel items.\n   Reference: https://developer.chrome.com/blog/carousels-with-css\n   Spec: https://drafts.csswg.org/css-overflow-5/#scroll-marker-group\n   ============================================================ */\n\n/* Future Chrome 135+ native scroll-driven carousel support */\n@supports (selector(::scroll-button(*))) {\n  .carousel-scroll-container {\n    scroll-snap-type: x mandatory;\n    scroll-behavior: smooth;\n    overflow-x: auto;\n    scrollbar-width: none;\n    -ms-overflow-style: none;\n  }\n\n  .carousel-scroll-container::-webkit-scrollbar {\n    display: none;\n  }\n\n  .carousel-scroll-container > * {\n    scroll-snap-align: start;\n    scroll-snap-stop: always;\n    flex-shrink: 0;\n  }\n\n  /* Automatic scroll prev/next buttons with built-in ARIA roles */\n  .carousel-scroll-container::scroll-button(prev) {\n    width: 2.75rem;\n    height: 2.75rem;\n    border-radius: 9999px;\n    background-color: white;\n    box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    cursor: pointer;\n    transition-property: background-color, box-shadow;\n    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n    transition-duration: 150ms;\n    position: absolute;\n    left: 0;\n    top: 50%;\n    transform: translateY(-50%);\n    z-index: 20;\n  }\n\n  .carousel-scroll-container::scroll-button(prev):hover {\n    background-color: #f5f5f4;\n  }\n\n  .carousel-scroll-container::scroll-button(next) {\n    width: 2.75rem;\n    height: 2.75rem;\n    border-radius: 9999px;\n    background-color: white;\n    box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    cursor: pointer;\n    transition-property: background-color, box-shadow;\n    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n    transition-duration: 150ms;\n    position: absolute;\n    right: 0;\n    top: 50%;\n    transform: translateY(-50%);\n    z-index: 20;\n  }\n\n  .carousel-scroll-container::scroll-button(next):hover {\n    background-color: #f5f5f4;\n  }\n\n  /* Automatic scroll marker group for keyboard-accessible navigation dots */\n  .carousel-scroll-container::scroll-marker {\n    display: flex;\n    gap: 0.5rem;\n    justify-content: center;\n    margin-top: 1rem;\n    flex-wrap: wrap;\n  }\n\n  .carousel-scroll-container::scroll-marker-item {\n    width: 0.5rem;\n    height: 0.5rem;\n    border-radius: 9999px;\n    background-color: #d6d3d1;\n    cursor: pointer;\n    transition-property: background-color;\n    transition-duration: 150ms;\n  }\n\n  .carousel-scroll-container::scroll-marker-item[aria-current=\"true\"] {\n    background-color: #b45309;\n  }\n\n  @media (prefers-color-scheme: dark) {\n    .carousel-scroll-container::scroll-button(prev),\n    .carousel-scroll-container::scroll-button(next) {\n      background-color: #292524;\n    }\n\n    .carousel-scroll-container::scroll-button(prev):hover,\n    .carousel-scroll-container::scroll-button(next):hover {\n      background-color: #44403c;\n    }\n\n    .carousel-scroll-container::scroll-marker-item {\n      background-color: #78716c;\n    }\n\n    .carousel-scroll-container::scroll-marker-item[aria-current=\"true\"] {\n      background-color: #fbbf24;\n    }\n  }\n}\n\n/* Fallback: browsers without ::scroll-button() support degrade gracefully */\n@supports not (selector(::scroll-button(*))) {\n  .carousel-scroll-container {\n    scroll-snap-type: x mandatory;\n    overflow-x: auto;\n    scrollbar-width: none;\n    -ms-overflow-style: none;\n    scroll-behavior: smooth;\n  }\n\n  .carousel-scroll-container::-webkit-scrollbar {\n    display: none;\n  }\n\n  .carousel-scroll-container > * {\n    scroll-snap-align: start;\n    scroll-snap-stop: always;\n    flex-shrink: 0;\n  }\n}\n\n@utility container-custom {\n  /* Container */\n  @apply max-w-6xl mx-auto;\n}\n\n@utility section-label {\n  /* Section label - Elegant uppercase */\n  @apply text-xs font-medium tracking-widest uppercase text-amber-700 mb-4 dark:text-amber-400;\n}\n\n@utility section-heading {\n  /* Section heading - Serif display font (uses theme --font-display for next/font metric-adjusted fallback) */\n  @apply text-3xl md:text-4xl lg:text-5xl font-medium text-stone-900\n           leading-tight tracking-tight dark:text-stone-100;\n  font-family: var(--font-display);\n}\n\n@utility body-text {\n  /* Body text */\n  @apply text-stone-600 leading-relaxed dark:text-stone-400;\n}\n\n@utility card {\n  /* Card with subtle hover */\n  @apply bg-white rounded-2xl p-6 md:p-8\n           shadow-xs hover:shadow-md transition-shadow duration-300\n           border border-stone-100\n           dark:bg-stone-800 dark:border-stone-700;\n}\n\n@utility image-frame {\n  /* Image container with elegant corners */\n  @apply rounded-2xl overflow-hidden shadow-lg;\n}\n\n@utility divider {\n  /* Divider — uses @property --divider-progress for animatable gradient midpoint */\n  height: 1px;\n  background: linear-gradient(\n    to right,\n    transparent,\n    var(--color-stone-200, #e7e5e4) var(--divider-progress, 50%),\n    transparent\n  );\n}\n\n@media (prefers-color-scheme: dark) {\n  .divider {\n    background: linear-gradient(\n      to right,\n      transparent,\n      var(--color-stone-700, #44403c) var(--divider-progress, 50%),\n      transparent\n    );\n  }\n}\n\n@utility icon-box {\n  /* Feature icon container */\n  @apply w-12 h-12 rounded-xl bg-amber-50 flex items-center justify-center\n           text-amber-700 dark:bg-amber-900/30 dark:text-amber-400;\n}\n\n@utility font-display {\n  /* Display font utility — uses theme variable for next/font metric-adjusted fallback */\n  font-family: var(--font-display);\n}\n\n@utility text-gradient {\n  /* Text gradient — uses @property --gradient-angle for animatable direction */\n  background: linear-gradient(var(--gradient-angle, 135deg), #b45309, #ea580c);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n  color: transparent;\n}\n\n@utility text-gradient-shimmer {\n  /* Animated shimmer variant — rotates gradient angle via @property token */\n  background: linear-gradient(var(--gradient-angle, 135deg), #b45309, #ea580c, #b45309);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n  color: transparent;\n  animation: gradient-shimmer 4s ease-in-out infinite;\n}\n\n@utility image-zoom {\n  /* Smooth image zoom on hover and focus (WCAG 2.1 SC 1.4.13 parity) */\n  @apply transition-transform duration-700 ease-out;\n\n  .group:hover &,\n  .group:focus-within & {\n    @apply scale-105;\n  }\n}\n\n@utility delay-100 {\n  /* Fade in animation delays */\n  animation-delay: 100ms;\n}\n\n@utility delay-200 {\n  animation-delay: 200ms;\n}\n\n@utility delay-300 {\n  animation-delay: 300ms;\n}\n\n@utility delay-400 {\n  animation-delay: 400ms;\n}\n\n@utility scrollbar-hide {\n  /* Hide scrollbar for horizontal scroll sections */\n  -ms-overflow-style: none;\n  scrollbar-width: none;\n\n  &::-webkit-scrollbar {\n    display: none;\n  }\n}\n\n/* CSS Container Query utilities — US-219\n   @supports guard ensures older browsers without CQ support silently ignore\n   container-type and fall back to Tailwind viewport breakpoints (sm:, md:, lg:).\n   Container query units (cqi, cqw) are used here for adaptive label sizing. */\n@supports (container-type: inline-size) {\n  .card-label-cq {\n    /* cqi = 1% of container inline (width) — scales label relative to card width */\n    font-size: clamp(0.75rem, 4.5cqi, 0.875rem);\n    line-height: 1.4;\n  }\n}\n\n@layer base {\n  html {\n    scroll-behavior: smooth;\n    overflow-x: hidden; /* WCAG 2.2 SC 1.4.4 — prevent horizontal scrollbar at 200% zoom */\n  }\n\n  /* Offset sticky header (64px) when scrolling to heading anchors */\n  h2,\n  h3,\n  section[id] {\n    scroll-margin-top: 5rem; /* 80px = 64px header + 16px breathing room */\n  }\n\n  /* US-204: text-wrap: balance prevents awkward single-word orphans on headings.\n     Progressive enhancement — unsupported browsers silently fall back to default wrap.\n     Chrome 114+, Edge 114+, Firefox 121+, Safari 17.4+ */\n  h1,\n  h2,\n  h3 {\n    text-wrap: balance;\n  }\n\n  /* US-204: text-wrap: pretty reduces orphan words in body paragraphs.\n     Uses a lookahead algorithm to avoid lonely single words on the final line.\n     Progressive enhancement — no visual change in unsupported browsers.\n     Chrome 117+, Edge 117+ */\n  p {\n    text-wrap: pretty;\n  }\n\n  /* WCAG 2.2 SC 2.4.11 — prevent MobileBookingBar from obscuring focused elements */\n  @media (max-width: 767px) {\n    html {\n      scroll-padding-bottom: 4rem; /* matches ~64px MobileBookingBar height */\n    }\n  }\n\n  /* WCAG 2.2 SC 2.5.8 — Target Size Minimum: 24×24 CSS px for all interactive elements */\n  /* Inline text links inside .prose are exempt per the inline-text exception */\n  button,\n  [role=\"button\"] {\n    min-height: 1.5rem; /* 24px */\n    min-width: 1.5rem; /* 24px */\n  }\n\n  /* WCAG 2.2 SC 2.4.13 — Focus Appearance: 2px outline, ≥ 3:1 contrast */\n  /* Uses CSS outline (not box-shadow) for Windows High Contrast Mode visibility */\n  :focus-visible {\n    outline: 2px solid var(--color-amber-700, #b45309);\n    outline-offset: 2px;\n  }\n\n  @media (prefers-color-scheme: dark) {\n    :focus-visible {\n      outline-color: var(--color-amber-400, #fbbf24);\n    }\n  }\n\n  body {\n    @apply antialiased bg-stone-50 text-stone-800 dark:bg-stone-950 dark:text-stone-200;\n    font-feature-settings: \"kern\" 1, \"liga\" 1;\n  }\n\n  /* Elegant selection color */\n  ::selection {\n    background-color: #e8ddd0;\n    color: #4a3f33;\n  }\n\n  @media (prefers-color-scheme: dark) {\n    ::selection {\n      background-color: #5c4c3c;\n      color: #f5f0e8;\n    }\n  }\n}\n\n/* WCAG 2.1 SC 1.4.10 — Reflow: prose tables scroll horizontally instead of breaking page layout */\n.prose table {\n  display: block;\n  overflow-x: auto;\n  -webkit-overflow-scrolling: touch;\n}\n\n/* WCAG 2.3.3 / WCAG 2.2.2 — Respect prefers-reduced-motion OS preference */\n/* Technique C39: https://www.w3.org/WAI/WCAG22/Techniques/css/C39 */\n@media (prefers-reduced-motion: reduce) {\n  *, *::before, *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n    scroll-behavior: auto !important;\n  }\n}\n\n/* ============================================================\n   WCAG 2.1 SC 2.2.2 — In-page pause control\n   Pauses all continuous animations when the user activates the\n   PauseAnimationsButton. This is separate from prefers-reduced-motion\n   which only responds to the OS-level preference.\n   ============================================================ */\nhtml.animations-paused *,\nhtml.animations-paused *::before,\nhtml.animations-paused *::after {\n  animation-play-state: paused !important;\n}\n\n/* ============================================================\n   Forced Colors (Windows High Contrast Mode)\n   Ensures all custom-styled interactive elements remain visible\n   when the OS overrides author colors.\n   ============================================================ */\n@media (forced-colors: active) {\n  /* Primary buttons: add explicit border so they remain distinguishable */\n  .btn-primary {\n    border: 2px solid ButtonText;\n    background: ButtonFace;\n    color: ButtonText;\n    forced-color-adjust: none;\n  }\n\n  .btn-primary:hover {\n    background: Highlight;\n    color: HighlightText;\n    border-color: Highlight;\n  }\n\n  /* Secondary buttons: ensure border stays visible */\n  .btn-secondary {\n    border: 2px solid ButtonText;\n    color: ButtonText;\n  }\n\n  .btn-secondary:hover {\n    background: Highlight;\n    color: HighlightText;\n    border-color: Highlight;\n  }\n\n  /* Cards: ensure visible boundary */\n  .card {\n    border: 1px solid CanvasText;\n  }\n\n  /* Icon boxes: add border for visibility without background */\n  .icon-box {\n    border: 1px solid CanvasText;\n  }\n\n  /* Badges (category pills, status indicators): add border so they don't disappear */\n  [class*=\"rounded-full\"][class*=\"bg-amber\"] {\n    border: 1px solid CanvasText;\n    forced-color-adjust: none;\n  }\n\n  /* Focus indicators: ensure outline uses system highlight color */\n  :focus-visible {\n    outline-color: Highlight;\n  }\n\n  /* Icon-only buttons (close, nav arrows): add border for visibility */\n  button:has(> svg:only-child),\n  [role=\"button\"]:has(> svg:only-child) {\n    border: 1px solid ButtonText;\n  }\n\n  /* Dividers: ensure visible in forced-colors */\n  .divider {\n    background: CanvasText;\n  }\n\n  /* Form inputs and textareas: explicit border */\n  input,\n  textarea,\n  select {\n    border: 1px solid ButtonText;\n  }\n\n  /* Links: use system link color */\n  a {\n    color: LinkText;\n  }\n}\n\n/* ============================================================\n   Increased Contrast (macOS \"Increase contrast\" / Windows)\n   Strengthens borders and text contrast for users who opted in.\n   ============================================================ */\n@media (prefers-contrast: more) {\n  /* Form inputs: thicker, darker borders */\n  input,\n  textarea,\n  select {\n    border-width: 2px;\n    border-color: var(--color-stone-700, #44403c);\n  }\n\n  /* Cards: stronger border for visual separation */\n  .card {\n    border-width: 2px;\n    border-color: var(--color-stone-400, #a8a29e);\n  }\n\n  @media (prefers-color-scheme: dark) {\n    .card {\n      border-color: var(--color-stone-500, #78716c);\n    }\n  }\n\n  /* Dividers: more visible */\n  .divider {\n    height: 2px;\n    opacity: 1;\n  }\n\n  /* Badges: stronger borders */\n  [class*=\"rounded-full\"][class*=\"bg-amber\"] {\n    border: 1px solid var(--color-amber-700, #b45309);\n  }\n\n  /* Icon boxes: add border */\n  .icon-box {\n    border: 1px solid var(--color-amber-600, #d97706);\n  }\n\n  /* Section labels and small text: slightly bolder */\n  .section-label {\n    font-weight: 600;\n  }\n\n  /* Body text: increase contrast */\n  .body-text {\n    color: var(--color-stone-700, #44403c);\n  }\n\n  @media (prefers-color-scheme: dark) {\n    .body-text {\n      color: var(--color-stone-300, #d6d3d1);\n    }\n  }\n}\n\n/* ============================================================\n   @property-powered keyframe animations (US-233)\n   These animations target @property-registered custom properties,\n   enabling smooth interpolation that would otherwise be impossible\n   with untyped CSS variables.\n   ============================================================ */\n\n/* Rotates gradient angle 135° → 225° → 135° for a subtle shimmer */\n@keyframes gradient-shimmer {\n  0%   { --gradient-angle: 135deg; }\n  50%  { --gradient-angle: 225deg; }\n  100% { --gradient-angle: 135deg; }\n}\n\n/* Sweeps divider gradient midpoint from left to center to right */\n@keyframes divider-sweep {\n  0%   { --divider-progress: 20%; }\n  50%  { --divider-progress: 80%; }\n  100% { --divider-progress: 50%; }\n}\n\n/* Utility class to apply the sweep animation to a divider */\n.divider-animated {\n  animation: divider-sweep 2s ease-in-out forwards;\n}\n\n/* Respect reduced motion */\n@media (prefers-reduced-motion: reduce) {\n  .text-gradient-shimmer {\n    animation: none;\n  }\n  .divider-animated {\n    animation: none;\n  }\n}\n\n/* ============================================================\n   CSS @starting-style entry animations (US-143)\n   Declarative fade/slide-in for elements entering the DOM.\n   Baseline August 2024: Chrome 117+, Firefox 129+, Safari 17.4+.\n   Uses only opacity + transform (GPU compositor thread, no layout).\n   ============================================================ */\n.entry-fade {\n  opacity: 1;\n  transition: opacity 0.3s ease-out;\n  @starting-style { opacity: 0; }\n}\n\n.entry-zoom-in {\n  opacity: 1;\n  transform: scale(1);\n  transition: opacity 0.25s ease-out, transform 0.25s ease-out;\n  @starting-style { opacity: 0; transform: scale(0.95); }\n}\n\n.entry-fade-up {\n  opacity: 1;\n  transform: translateY(0);\n  transition: opacity 0.3s ease-out, transform 0.3s ease-out;\n  @starting-style { opacity: 0; transform: translateY(1rem); }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .entry-fade, .entry-zoom-in, .entry-fade-up { transition: none; }\n}\n\n/* ============================================================\n   Scroll-driven section reveal animations (US-217)\n   Uses animation-timeline: view() for compositor-thread reveals.\n   Only opacity + transform — no layout shifts, no main-thread paint.\n   Gated behind @supports so unsupporting browsers show content normally.\n   ============================================================ */\n@supports (animation-timeline: view()) {\n  @media (prefers-reduced-motion: no-preference) {\n    @keyframes scroll-fade-in-up {\n      from {\n        opacity: 0;\n        transform: translateY(1.5rem);\n      }\n      to {\n        opacity: 1;\n        transform: translateY(0);\n      }\n    }\n\n    .scroll-reveal {\n      animation: scroll-fade-in-up linear both;\n      animation-timeline: view();\n      animation-range: entry 0% entry 30%;\n    }\n  }\n}\n\n/* ============================================================\n   Cross-document View Transitions (US-197)\n   Opts same-origin hard navigations into a smooth cross-fade\n   via CSS View Transitions Level 2 (@view-transition at-rule).\n   Chrome 126+, Edge 126+, Firefox 144+.\n   Safari degrades gracefully — no transition, no error.\n   Soft navigations (Next.js <Link>) use the JS API separately;\n   this covers direct URL entry, back/forward, and external links.\n   ============================================================ */\n@view-transition {\n  navigation: auto;\n}\n\n::view-transition-old(root) {\n  animation: 200ms ease-out both vt-fade-out;\n}\n\n::view-transition-new(root) {\n  animation: 200ms ease-out both vt-fade-in;\n}\n\n@keyframes vt-fade-out {\n  from { opacity: 1; }\n  to { opacity: 0; }\n}\n\n@keyframes vt-fade-in {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n/* Disable view transitions when user prefers reduced motion */\n@media (prefers-reduced-motion: reduce) {\n  @view-transition {\n    navigation: none;\n  }\n}\n\n/* ============================================================\n   Native Popover + CSS Anchor Positioning (US-144)\n   Uses HTML popover attribute for keyboard/focus management\n   and CSS anchor-name / position-anchor for tethering.\n   @supports fallback for browsers without anchor positioning.\n   Chrome 125+, Edge 125+. Safari/Firefox: absolute fallback.\n   ============================================================ */\n.info-popover-anchor {\n  position: relative;\n  display: inline-flex;\n}\n\n.info-popover-trigger {\n  all: unset;\n  display: inline-flex;\n  cursor: pointer;\n}\n\n.info-popover {\n  margin: 0;\n  border: 1px solid var(--color-stone-200, #e7e5e4);\n  border-radius: 0.75rem;\n  padding: 0.5rem 0.75rem;\n  background: white;\n  color: var(--color-stone-700, #44403c);\n  font-size: 0.8125rem;\n  line-height: 1.4;\n  max-width: 15rem;\n  box-shadow: 0 4px 12px rgb(0 0 0 / 0.08);\n  /* Entry animation */\n  opacity: 1;\n  transition: opacity 0.15s ease-out, transform 0.15s ease-out;\n}\n\n.info-popover:not(:popover-open) {\n  display: none;\n}\n\n/* Anchor positioning (Chrome 125+) */\n@supports (position-anchor: --x) {\n  .info-popover {\n    position: fixed;\n    position-area: block-end span-inline-end;\n    margin-top: 0.375rem;\n  }\n}\n\n/* Fallback for browsers without anchor positioning */\n@supports not (position-anchor: --x) {\n  .info-popover {\n    position: absolute;\n    top: calc(100% + 0.375rem);\n    left: 50%;\n    transform: translateX(-50%);\n  }\n}\n\n@media (prefers-color-scheme: dark) {\n  .info-popover {\n    background: var(--color-stone-800, #292524);\n    color: var(--color-stone-200, #e7e5e4);\n    border-color: var(--color-stone-700, #44403c);\n    box-shadow: 0 4px 12px rgb(0 0 0 / 0.3);\n  }\n}\n\n/* Forced colors: ensure popover border is visible */\n@media (forced-colors: active) {\n  .info-popover {\n    border: 2px solid CanvasText;\n  }\n}\n\n/* Custom scrollbar */\n::-webkit-scrollbar {\n  width: 8px;\n}\n\n::-webkit-scrollbar-track {\n  @apply bg-stone-100;\n}\n\n::-webkit-scrollbar-thumb {\n  @apply bg-stone-300 rounded-full;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  @apply bg-stone-400;\n}\n\n@media (prefers-color-scheme: dark) {\n  ::-webkit-scrollbar-track {\n    background-color: #1c1917;\n  }\n  ::-webkit-scrollbar-thumb {\n    background-color: #57534e;\n  }\n  ::-webkit-scrollbar-thumb:hover {\n    background-color: #78716c;\n  }\n}\n\n/* Print styles — booking confirmation and receipt pages */\n@media print {\n  nav,\n  footer,\n  .cookie-banner,\n  .chat-widget,\n  [data-chat-widget],\n  .sticky-booking-bar,\n  [data-cookie-banner] {\n    display: none !important;\n  }\n\n  * {\n    color: #000 !important;\n    background: transparent !important;\n    box-shadow: none !important;\n  }\n\n  body {\n    font-size: 12pt;\n  }\n\n  .booking-summary,\n  [class*=\"booking-summary\"],\n  [class*=\"confirmation\"] {\n    page-break-inside: avoid;\n  }\n}\n","structuredPatch":[{"oldStart":150,"oldLines":147,"newStart":150,"newLines":32,"lines":[" "," /* ============================================================","    CSS Native Scroll-Driven Carousel (US-187)","-   Chrome 135+ proposed ::scroll-button() and ::scroll-marker","-   pseudo-elements for automatic ARIA button roles and","-   keyboard handling. Wrapped in @supports guard for future.","-   Current fallback: scroll-snap CSS with hidden scrollbar.","+   Implements scroll-snap carousel with graceful degradation.","+   Future: Chrome 135+ may support ::scroll-button() and","+   ::scroll-marker pseudo-elements for automatic controls.","+   Currently uses scroll-snap CSS for fallback browsers.","    Ensures CLS=0 via fixed aspect-ratio on carousel items.","    Reference: https://developer.chrome.com/blog/carousels-with-css","    Spec: https://drafts.csswg.org/css-overflow-5/#scroll-marker-group","    ============================================================ */"," ","-/* Future Chrome 135+ native scroll-driven carousel support */","-@supports (selector(::scroll-button(*))) {","-  .carousel-scroll-container {","-    scroll-snap-type: x mandatory;","-    scroll-behavior: smooth;","-    overflow-x: auto;","-    scrollbar-width: none;","-    -ms-overflow-style: none;","-  }","+/* Scroll-snap carousel with hidden scrollbar (all browsers) */","+.carousel-scroll-container {","+  scroll-snap-type: x mandatory;","+  overflow-x: auto;","+  scrollbar-width: none;","+  -ms-overflow-style: none;","+  scroll-behavior: smooth;","+}"," ","-  .carousel-scroll-container::-webkit-scrollbar {","-    display: none;","-  }","-","-  .carousel-scroll-container > * {","-    scroll-snap-align: start;","-    scroll-snap-stop: always;","-    flex-shrink: 0;","-  }","-","-  /* Automatic scroll prev/next buttons with built-in ARIA roles */","-  .carousel-scroll-container::scroll-button(prev) {","-    width: 2.75rem;","-    height: 2.75rem;","-    border-radius: 9999px;","-    background-color: white;","-    box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);","-    display: flex;","-    align-items: center;","-    justify-content: center;","-    cursor: pointer;","-    transition-property: background-color, box-shadow;","-    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);","-    transition-duration: 150ms;","-    position: absolute;","-    left: 0;","-    top: 50%;","-    transform: translateY(-50%);","-    z-index: 20;","-  }","-","-  .carousel-scroll-container::scroll-button(prev):hover {","-    background-color: #f5f5f4;","-  }","-","-  .carousel-scroll-container::scroll-button(next) {","-    width: 2.75rem;","-    height: 2.75rem;","-    border-radius: 9999px;","-    background-color: white;","-    box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);","-    display: flex;","-    align-items: center;","-    justify-content: center;","-    cursor: pointer;","-    transition-property: background-color, box-shadow;","-    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);","-    transition-duration: 150ms;","-    position: absolute;","-    right: 0;","-    top: 50%;","-    transform: translateY(-50%);","-    z-index: 20;","-  }","-","-  .carousel-scroll-container::scroll-button(next):hover {","-    background-color: #f5f5f4;","-  }","-","-  /* Automatic scroll marker group for keyboard-accessible navigation dots */","-  .carousel-scroll-container::scroll-marker {","-    display: flex;","-    gap: 0.5rem;","-    justify-content: center;","-    margin-top: 1rem;","-    flex-wrap: wrap;","-  }","-","-  .carousel-scroll-container::scroll-marker-item {","-    width: 0.5rem;","-    height: 0.5rem;","-    border-radius: 9999px;","-    background-color: #d6d3d1;","-    cursor: pointer;","-    transition-property: background-color;","-    transition-duration: 150ms;","-  }","-","-  .carousel-scroll-container::scroll-marker-item[aria-current=\"true\"] {","-    background-color: #b45309;","-  }","-","-  @media (prefers-color-scheme: dark) {","-    .carousel-scroll-container::scroll-button(prev),","-    .carousel-scroll-container::scroll-button(next) {","-      background-color: #292524;","-    }","-","-    .carousel-scroll-container::scroll-button(prev):hover,","-    .carousel-scroll-container::scroll-button(next):hover {","-      background-color: #44403c;","-    }","-","-    .carousel-scroll-container::scroll-marker-item {","-      background-color: #78716c;","-    }","-","-    .carousel-scroll-container::scroll-marker-item[aria-current=\"true\"] {","-      background-color: #fbbf24;","-    }","-  }","+.carousel-scroll-container::-webkit-scrollbar {","+  display: none;"," }"," ","-/* Fallback: browsers without ::scroll-button() support degrade gracefully */","-@supports not (selector(::scroll-button(*))) {","-  .carousel-scroll-container {","-    scroll-snap-type: x mandatory;","-    overflow-x: auto;","-    scrollbar-width: none;","-    -ms-overflow-style: none;","-    scroll-behavior: smooth;","-  }","-","-  .carousel-scroll-container::-webkit-scrollbar {","-    display: none;","-  }","-","-  .carousel-scroll-container > * {","-    scroll-snap-align: start;","-    scroll-snap-stop: always;","-    flex-shrink: 0;","-  }","+.carousel-scroll-container > * {","+  scroll-snap-align: start;","+  scroll-snap-stop: always;","+  flex-shrink: 0;"," }"," "," @utility container-custom {"]}],"userModified":false,"replaceAll":false}}
