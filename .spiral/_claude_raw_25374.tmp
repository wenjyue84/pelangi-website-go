{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017z7LANi9WH6Daqr3BT2Uvp","type":"tool_result","content":"1\t@import 'tailwindcss';\n2\t\n3\t@plugin \"@tailwindcss/typography\";\n4\t\n5\t/* ============================================================\n6\t   CSS @property — Type-safe, animatable design tokens (US-233)\n7\t   Registered custom properties can be interpolated by the browser\n8\t   because their syntax is known (angle, percentage, etc.).\n9\t   Browsers without @property support treat these as untyped\n10\t   custom properties — static fallback values still render correctly,\n11\t   only the animation is lost (progressive enhancement).\n12\t   Chrome 85+, Firefox 128+, Safari 17.2+.\n13\t   ============================================================ */\n14\t@property --gradient-angle {\n15\t  syntax: \"<angle>\";\n16\t  inherits: false;\n17\t  initial-value: 135deg;\n18\t}\n19\t\n20\t@property --divider-progress {\n21\t  syntax: \"<percentage>\";\n22\t  inherits: false;\n23\t  initial-value: 50%;\n24\t}\n25\t\n26\t@theme {\n27\t  --color-primary-50: #faf8f5;\n28\t  --color-primary-100: #f5f0e8;\n29\t  --color-primary-200: #e8ddd0;\n30\t  --color-primary-300: #d4c4ad;\n31\t  --color-primary-400: #bda685;\n32\t  --color-primary-500: #a68b64;\n33\t  --color-primary-600: #8b7355;\n34\t  --color-primary-700: #715d47;\n35\t  --color-primary-800: #5c4c3c;\n36\t  --color-primary-900: #4a3f33;\n37\t\n38\t  --color-accent-50: #fdf8f6;\n39\t  --color-accent-100: #f9ede8;\n40\t  --color-accent-200: #f4dcd3;\n41\t  --color-accent-300: #ecc4b5;\n42\t  --color-accent-400: #e0a48d;\n43\t  --color-accent-500: #d4846a;\n44\t  --color-accent-600: #c26a4f;\n45\t  --color-accent-700: #a25540;\n46\t  --color-accent-800: #864738;\n47\t  --color-accent-900: #6e3d31;\n48\t\n49\t  --color-sand-50: #fafaf9;\n50\t  --color-sand-100: #f5f5f4;\n51\t  --color-sand-200: #e7e5e4;\n52\t  --color-sand-300: #d6d3d1;\n53\t  --color-sand-400: #a8a29e;\n54\t  --color-sand-500: #78716c;\n55\t  --color-sand-600: #57534e;\n56\t  --color-sand-700: #44403c;\n57\t  --color-sand-800: #292524;\n58\t  --color-sand-900: #1c1917;\n59\t\n60\t  --font-sans: var(--font-inter), system-ui, sans-serif;\n61\t  --font-display: var(--font-playfair), Georgia, serif;\n62\t\n63\t  --text-2xs: 0.65rem;\n64\t  --text-2xs--line-height: 1rem;\n65\t\n66\t  --tracking-widest: 0.2em;\n67\t\n68\t  --animate-fade-in: fadeIn 0.6s ease-out forwards;\n69\t  --animate-slide-up: slideUp 0.6s ease-out forwards;\n70\t  --animate-scale-in: scaleIn 0.4s ease-out forwards;\n71\t\n72\t  --background-image-gradient-radial: radial-gradient(var(--tw-gradient-stops));\n73\t  --background-image-noise: url('/images/noise.png');\n74\t\n75\t  @keyframes fadeIn {\n76\t    0% {\n77\t      opacity: 0;\n78\t    }\n79\t    100% {\n80\t      opacity: 1;\n81\t    }\n82\t  }\n83\t  @keyframes slideUp {\n84\t    0% {\n85\t      opacity: 0;\n86\t      transform: translateY(20px);\n87\t    }\n88\t    100% {\n89\t      opacity: 1;\n90\t      transform: translateY(0);\n91\t    }\n92\t  }\n93\t  @keyframes scaleIn {\n94\t    0% {\n95\t      opacity: 0;\n96\t      transform: scale(0.95);\n97\t    }\n98\t    100% {\n99\t      opacity: 1;\n100\t      transform: scale(1);\n101\t    }\n102\t  }\n103\t}\n104\t\n105\t/*\n106\t  The default border color has changed to `currentcolor` in Tailwind CSS v4,\n107\t  so we've added these compatibility styles to make sure everything still\n108\t  looks the same as it did with Tailwind CSS v3.\n109\t\n110\t  If we ever want to remove these styles, we need to add an explicit border\n111\t  color utility to any element that depends on these defaults.\n112\t*/\n113\t@layer base {\n114\t  *,\n115\t  ::after,\n116\t  ::before,\n117\t  ::backdrop,\n118\t  ::file-selector-button {\n119\t    border-color: var(--color-gray-200, currentcolor);\n120\t  }\n121\t}\n122\t\n123\t@utility btn-primary {\n124\t  /* Primary Button - Warm, sophisticated */\n125\t  @apply bg-stone-700 hover:bg-stone-800 text-white font-medium\n126\t           py-3.5 px-8 rounded-full transition-all duration-300\n127\t           shadow-xs hover:shadow-md cursor-pointer\n128\t           tracking-wide text-sm uppercase\n129\t           focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700\n130\t           dark:bg-stone-200 dark:text-stone-900 dark:hover:bg-stone-100\n131\t           dark:focus-visible:outline-amber-400;\n132\t}\n133\t\n134\t@utility btn-secondary {\n135\t  /* Secondary Button - Minimal outline */\n136\t  @apply bg-transparent hover:bg-stone-100 text-stone-700\n137\t           font-medium py-3.5 px-8 rounded-full\n138\t           border border-stone-500 hover:border-stone-600\n139\t           transition-all duration-300 cursor-pointer\n140\t           tracking-wide text-sm uppercase\n141\t           focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700\n142\t           dark:text-stone-300 dark:border-stone-600 dark:hover:bg-stone-800 dark:hover:border-stone-500\n143\t           dark:focus-visible:outline-amber-400;\n144\t}\n145\t\n146\t@utility section-padding {\n147\t  /* Section spacing - More breathing room */\n148\t  @apply py-20 md:py-28 lg:py-32 px-6 md:px-8;\n149\t}\n150\t\n151\t/* ============================================================\n152\t   CSS Native Scroll-Driven Carousel (US-187)\n153\t   Chrome 135+ ships ::scroll-button() and ::scroll-marker\n154\t   pseudo-elements for automatic ARIA button roles and\n155\t   keyboard handling. Fallback: scrollBy() JS continues to work.\n156\t   ============================================================ */\n157\t@supports (selector(::scroll-button(*))) {\n158\t  .carousel-scroll-container {\n159\t    scroll-snap-type: x mandatory;\n160\t    scroll-behavior: smooth;\n161\t    overflow-x: auto;\n162\t  }\n163\t\n164\t  .carousel-scroll-container > * {\n165\t    scroll-snap-align: start;\n166\t    scroll-snap-stop: always;\n167\t  }\n168\t\n169\t  /* Automatic scroll prev/next buttons with ARIA roles */\n170\t  .carousel-scroll-container::scroll-button(prev) {\n171\t    @apply w-11 h-11 rounded-full bg-white dark:bg-stone-800 shadow-md\n172\t           flex items-center justify-center\n173\t           hover:bg-stone-50 dark:hover:bg-stone-700\n174\t           transition-colors cursor-pointer;\n175\t    position: absolute;\n176\t    left: 0;\n177\t    top: 50%;\n178\t    transform: translateY(-50%);\n179\t    z-index: 20;\n180\t  }\n181\t\n182\t  .carousel-scroll-container::scroll-button(next) {\n183\t    @apply w-11 h-11 rounded-full bg-white dark:bg-stone-800 shadow-md\n184\t           flex items-center justify-center\n185\t           hover:bg-stone-50 dark:hover:bg-stone-700\n186\t           transition-colors cursor-pointer;\n187\t    position: absolute;\n188\t    right: 0;\n189\t    top: 50%;\n190\t    transform: translateY(-50%);\n191\t    z-index: 20;\n192\t  }\n193\t\n194\t  /* Scroll marker group for keyboard-accessible navigation dots */\n195\t  .carousel-scroll-container::scroll-marker {\n196\t    display: flex;\n197\t    gap: 0.5rem;\n198\t    justify-content: center;\n199\t    margin-top: 1rem;\n200\t    flex-wrap: wrap;\n201\t  }\n202\t\n203\t  .carousel-scroll-container::scroll-marker-item {\n204\t    @apply w-2 h-2 rounded-full bg-stone-300 dark:bg-stone-600\n205\t           cursor-pointer transition-colors;\n206\t  }\n207\t\n208\t  .carousel-scroll-container::scroll-marker-item[aria-current=\"true\"] {\n209\t    @apply bg-amber-600 dark:bg-amber-400;\n210\t  }\n211\t}\n212\t\n213\t/* Fallback: older browsers degrade to basic scrollable container */\n214\t@supports not (selector(::scroll-button(*))) {\n215\t  .carousel-scroll-container {\n216\t    scroll-snap-type: x mandatory;\n217\t    overflow-x: auto;\n218\t    scrollbar-width: none;\n219\t    -ms-overflow-style: none;\n220\t  }\n221\t\n222\t  .carousel-scroll-container::-webkit-scrollbar {\n223\t    display: none;\n224\t  }\n225\t\n226\t  .carousel-scroll-container > * {\n227\t    scroll-snap-align: start;\n228\t    scroll-snap-stop: always;\n229\t  }\n230\t}\n231\t\n232\t@utility container-custom {\n233\t  /* Container */\n234\t  @apply max-w-6xl mx-auto;\n235\t}\n236\t\n237\t@utility section-label {\n238\t  /* Section label - Elegant uppercase */\n239\t  @apply text-xs font-medium tracking-widest uppercase text-amber-700 mb-4 dark:text-amber-400;\n240\t}\n241\t\n242\t@utility section-heading {\n243\t  /* Section heading - Serif display font (uses theme --font-display for next/font metric-adjusted fallback) */\n244\t  @apply text-3xl md:text-4xl lg:text-5xl font-medium text-stone-900\n245\t           leading-tight tracking-tight dark:text-stone-100;\n246\t  font-family: var(--font-display);\n247\t}\n248\t\n249\t@utility body-text {\n250\t  /* Body text */\n251\t  @apply text-stone-600 leading-relaxed dark:text-stone-400;\n252\t}\n253\t\n254\t@utility card {\n255\t  /* Card with subtle hover */\n256\t  @apply bg-white rounded-2xl p-6 md:p-8\n257\t           shadow-xs hover:shadow-md transition-shadow duration-300\n258\t           border border-stone-100\n259\t           dark:bg-stone-800 dark:border-stone-700;\n260\t}\n261\t\n262\t@utility image-frame {\n263\t  /* Image container with elegant corners */\n264\t  @apply rounded-2xl overflow-hidden shadow-lg;\n265\t}\n266\t\n267\t@utility divider {\n268\t  /* Divider — uses @property --divider-progress for animatable gradient midpoint */\n269\t  height: 1px;\n270\t  background: linear-gradient(\n271\t    to right,\n272\t    transparent,\n273\t    var(--color-stone-200, #e7e5e4) var(--divider-progress, 50%),\n274\t    transparent\n275\t  );\n276\t}\n277\t\n278\t@media (prefers-color-scheme: dark) {\n279\t  .divider {\n280\t    background: linear-gradient(\n281\t      to right,\n282\t      transparent,\n283\t      var(--color-stone-700, #44403c) var(--divider-progress, 50%),\n284\t      transparent\n285\t    );\n286\t  }\n287\t}\n288\t\n289\t@utility icon-box {\n290\t  /* Feature icon container */\n291\t  @apply w-12 h-12 rounded-xl bg-amber-50 flex items-center justify-center\n292\t           text-amber-700 dark:bg-amber-900/30 dark:text-amber-400;\n293\t}\n294\t\n295\t@utility font-display {\n296\t  /* Display font utility — uses theme variable for next/font metric-adjusted fallback */\n297\t  font-family: var(--font-display);\n298\t}\n299\t\n300\t@utility text-gradient {\n301\t  /* Text gradient — uses @property --gradient-angle for animatable direction */\n302\t  background: linear-gradient(var(--gradient-angle, 135deg), #b45309, #ea580c);\n303\t  -webkit-background-clip: text;\n304\t  -webkit-text-fill-color: transparent;\n305\t  background-clip: text;\n306\t  color: transparent;\n307\t}\n308\t\n309\t@utility text-gradient-shimmer {\n310\t  /* Animated shimmer variant — rotates gradient angle via @property token */\n311\t  background: linear-gradient(var(--gradient-angle, 135deg), #b45309, #ea580c, #b45309);\n312\t  -webkit-background-clip: text;\n313\t  -webkit-text-fill-color: transparent;\n314\t  background-clip: text;\n315\t  color: transparent;\n316\t  animation: gradient-shimmer 4s ease-in-out infinite;\n317\t}\n318\t\n319\t@utility image-zoom {\n320\t  /* Smooth image zoom on hover and focus (WCAG 2.1 SC 1.4.13 parity) */\n321\t  @apply transition-transform duration-700 ease-out;\n322\t\n323\t  .group:hover &,\n324\t  .group:focus-within & {\n325\t    @apply scale-105;\n326\t  }\n327\t}\n328\t\n329\t@utility delay-100 {\n330\t  /* Fade in animation delays */\n331\t  animation-delay: 100ms;\n332\t}\n333\t\n334\t@utility delay-200 {\n335\t  animation-delay: 200ms;\n336\t}\n337\t\n338\t@utility delay-300 {\n339\t  animation-delay: 300ms;\n340\t}\n341\t\n342\t@utility delay-400 {\n343\t  animation-delay: 400ms;\n344\t}\n345\t\n346\t@utility scrollbar-hide {\n347\t  /* Hide scrollbar for horizontal scroll sections */\n348\t  -ms-overflow-style: none;\n349\t  scrollbar-width: none;\n350\t\n351\t  &::-webkit-scrollbar {\n352\t    display: none;\n353\t  }\n354\t}\n355\t\n356\t/* CSS Container Query utilities — US-219\n357\t   @supports guard ensures older browsers without CQ support silently ignore\n358\t   container-type and fall back to Tailwind viewport breakpoints (sm:, md:, lg:).\n359\t   Container query units (cqi, cqw) are used here for adaptive label sizing. */\n360\t@supports (container-type: inline-size) {\n361\t  .card-label-cq {\n362\t    /* cqi = 1% of container inline (width) — scales label relative to card width */\n363\t    font-size: clamp(0.75rem, 4.5cqi, 0.875rem);\n364\t    line-height: 1.4;\n365\t  }\n366\t}\n367\t\n368\t@layer base {\n369\t  html {\n370\t    scroll-behavior: smooth;\n371\t    overflow-x: hidden; /* WCAG 2.2 SC 1.4.4 — prevent horizontal scrollbar at 200% zoom */\n372\t  }\n373\t\n374\t  /* Offset sticky header (64px) when scrolling to heading anchors */\n375\t  h2,\n376\t  h3,\n377\t  section[id] {\n378\t    scroll-margin-top: 5rem; /* 80px = 64px header + 16px breathing room */\n379\t  }\n380\t\n381\t  /* US-204: text-wrap: balance prevents awkward single-word orphans on headings.\n382\t     Progressive enhancement — unsupported browsers silently fall back to default wrap.\n383\t     Chrome 114+, Edge 114+, Firefox 121+, Safari 17.4+ */\n384\t  h1,\n385\t  h2,\n386\t  h3 {\n387\t    text-wrap: balance;\n388\t  }\n389\t\n390\t  /* US-204: text-wrap: pretty reduces orphan words in body paragraphs.\n391\t     Uses a lookahead algorithm to avoid lonely single words on the final line.\n392\t     Progressive enhancement — no visual change in unsupported browsers.\n393\t     Chrome 117+, Edge 117+ */\n394\t  p {\n395\t    text-wrap: pretty;\n396\t  }\n397\t\n398\t  /* WCAG 2.2 SC 2.4.11 — prevent MobileBookingBar from obscuring focused elements */\n399\t  @media (max-width: 767px) {\n400\t    html {\n401\t      scroll-padding-bottom: 4rem; /* matches ~64px MobileBookingBar height */\n402\t    }\n403\t  }\n404\t\n405\t  /* WCAG 2.2 SC 2.5.8 — Target Size Minimum: 24×24 CSS px for all interactive elements */\n406\t  /* Inline text links inside .prose are exempt per the inline-text exception */\n407\t  button,\n408\t  [role=\"button\"] {\n409\t    min-height: 1.5rem; /* 24px */\n410\t    min-width: 1.5rem; /* 24px */\n411\t  }\n412\t\n413\t  /* WCAG 2.2 SC 2.4.13 — Focus Appearance: 2px outline, ≥ 3:1 contrast */\n414\t  /* Uses CSS outline (not box-shadow) for Windows High Contrast Mode visibility */\n415\t  :focus-visible {\n416\t    outline: 2px solid var(--color-amber-700, #b45309);\n417\t    outline-offset: 2px;\n418\t  }\n419\t\n420\t  @media (prefers-color-scheme: dark) {\n421\t    :focus-visible {\n422\t      outline-color: var(--color-amber-400, #fbbf24);\n423\t    }\n424\t  }\n425\t\n426\t  body {\n427\t    @apply antialiased bg-stone-50 text-stone-800 dark:bg-stone-950 dark:text-stone-200;\n428\t    font-feature-settings: \"kern\" 1, \"liga\" 1;\n429\t  }\n430\t\n431\t  /* Elegant selection color */\n432\t  ::selection {\n433\t    background-color: #e8ddd0;\n434\t    color: #4a3f33;\n435\t  }\n436\t\n437\t  @media (prefers-color-scheme: dark) {\n438\t    ::selection {\n439\t      background-color: #5c4c3c;\n440\t      color: #f5f0e8;\n441\t    }\n442\t  }\n443\t}\n444\t\n445\t/* WCAG 2.1 SC 1.4.10 — Reflow: prose tables scroll horizontally instead of breaking page layout */\n446\t.prose table {\n447\t  display: block;\n448\t  overflow-x: auto;\n449\t  -webkit-overflow-scrolling: touch;\n450\t}\n451\t\n452\t/* WCAG 2.3.3 / WCAG 2.2.2 — Respect prefers-reduced-motion OS preference */\n453\t/* Technique C39: https://www.w3.org/WAI/WCAG22/Techniques/css/C39 */\n454\t@media (prefers-reduced-motion: reduce) {\n455\t  *, *::before, *::after {\n456\t    animation-duration: 0.01ms !important;\n457\t    animation-iteration-count: 1 !important;\n458\t    transition-duration: 0.01ms !important;\n459\t    scroll-behavior: auto !important;\n460\t  }\n461\t}\n462\t\n463\t/* ============================================================\n464\t   WCAG 2.1 SC 2.2.2 — In-page pause control\n465\t   Pauses all continuous animations when the user activates the\n466\t   PauseAnimationsButton. This is separate from prefers-reduced-motion\n467\t   which only responds to the OS-level preference.\n468\t   ============================================================ */\n469\thtml.animations-paused *,\n470\thtml.animations-paused *::before,\n471\thtml.animations-paused *::after {\n472\t  animation-play-state: paused !important;\n473\t}\n474\t\n475\t/* ============================================================\n476\t   Forced Colors (Windows High Contrast Mode)\n477\t   Ensures all custom-styled interactive elements remain visible\n478\t   when the OS overrides author colors.\n479\t   ============================================================ */\n480\t@media (forced-colors: active) {\n481\t  /* Primary buttons: add explicit border so they remain distinguishable */\n482\t  .btn-primary {\n483\t    border: 2px solid ButtonText;\n484\t    background: ButtonFace;\n485\t    color: ButtonText;\n486\t    forced-color-adjust: none;\n487\t  }\n488\t\n489\t  .btn-primary:hover {\n490\t    background: Highlight;\n491\t    color: HighlightText;\n492\t    border-color: Highlight;\n493\t  }\n494\t\n495\t  /* Secondary buttons: ensure border stays visible */\n496\t  .btn-secondary {\n497\t    border: 2px solid ButtonText;\n498\t    color: ButtonText;\n499\t  }\n500\t\n501\t  .btn-secondary:hover {\n502\t    background: Highlight;\n503\t    color: HighlightText;\n504\t    border-color: Highlight;\n505\t  }\n506\t\n507\t  /* Cards: ensure visible boundary */\n508\t  .card {\n509\t    border: 1px solid CanvasText;\n510\t  }\n511\t\n512\t  /* Icon boxes: add border for visibility without background */\n513\t  .icon-box {\n514\t    border: 1px solid CanvasText;\n515\t  }\n516\t\n517\t  /* Badges (category pills, status indicators): add border so they don't disappear */\n518\t  [class*=\"rounded-full\"][class*=\"bg-amber\"] {\n519\t    border: 1px solid CanvasText;\n520\t    forced-color-adjust: none;\n521\t  }\n522\t\n523\t  /* Focus indicators: ensure outline uses system highlight color */\n524\t  :focus-visible {\n525\t    outline-color: Highlight;\n526\t  }\n527\t\n528\t  /* Icon-only buttons (close, nav arrows): add border for visibility */\n529\t  button:has(> svg:only-child),\n530\t  [role=\"button\"]:has(> svg:only-child) {\n531\t    border: 1px solid ButtonText;\n532\t  }\n533\t\n534\t  /* Dividers: ensure visible in forced-colors */\n535\t  .divider {\n536\t    background: CanvasText;\n537\t  }\n538\t\n539\t  /* Form inputs and textareas: explicit border */\n540\t  input,\n541\t  textarea,\n542\t  select {\n543\t    border: 1px solid ButtonText;\n544\t  }\n545\t\n546\t  /* Links: use system link color */\n547\t  a {\n548\t    color: LinkText;\n549\t  }\n550\t}\n551\t\n552\t/* ============================================================\n553\t   Increased Contrast (macOS \"Increase contrast\" / Windows)\n554\t   Strengthens borders and text contrast for users who opted in.\n555\t   ============================================================ */\n556\t@media (prefers-contrast: more) {\n557\t  /* Form inputs: thicker, darker borders */\n558\t  input,\n559\t  textarea,\n560\t  select {\n561\t    border-width: 2px;\n562\t    border-color: var(--color-stone-700, #44403c);\n563\t  }\n564\t\n565\t  /* Cards: stronger border for visual separation */\n566\t  .card {\n567\t    border-width: 2px;\n568\t    border-color: var(--color-stone-400, #a8a29e);\n569\t  }\n570\t\n571\t  @media (prefers-color-scheme: dark) {\n572\t    .card {\n573\t      border-color: var(--color-stone-500, #78716c);\n574\t    }\n575\t  }\n576\t\n577\t  /* Dividers: more visible */\n578\t  .divider {\n579\t    height: 2px;\n580\t    opacity: 1;\n581\t  }\n582\t\n583\t  /* Badges: stronger borders */\n584\t  [class*=\"rounded-full\"][class*=\"bg-amber\"] {\n585\t    border: 1px solid var(--color-amber-700, #b45309);\n586\t  }\n587\t\n588\t  /* Icon boxes: add border */\n589\t  .icon-box {\n590\t    border: 1px solid var(--color-amber-600, #d97706);\n591\t  }\n592\t\n593\t  /* Section labels and small text: slightly bolder */\n594\t  .section-label {\n595\t    font-weight: 600;\n596\t  }\n597\t\n598\t  /* Body text: increase contrast */\n599\t  .body-text {\n600\t    color: var(--color-stone-700, #44403c);\n601\t  }\n602\t\n603\t  @media (prefers-color-scheme: dark) {\n604\t    .body-text {\n605\t      color: var(--color-stone-300, #d6d3d1);\n606\t    }\n607\t  }\n608\t}\n609\t\n610\t/* ============================================================\n611\t   @property-powered keyframe animations (US-233)\n612\t   These animations target @property-registered custom properties,\n613\t   enabling smooth interpolation that would otherwise be impossible\n614\t   with untyped CSS variables.\n615\t   ============================================================ */\n616\t\n617\t/* Rotates gradient angle 135° → 225° → 135° for a subtle shimmer */\n618\t@keyframes gradient-shimmer {\n619\t  0%   { --gradient-angle: 135deg; }\n620\t  50%  { --gradient-angle: 225deg; }\n621\t  100% { --gradient-angle: 135deg; }\n622\t}\n623\t\n624\t/* Sweeps divider gradient midpoint from left to center to right */\n625\t@keyframes divider-sweep {\n626\t  0%   { --divider-progress: 20%; }\n627\t  50%  { --divider-progress: 80%; }\n628\t  100% { --divider-progress: 50%; }\n629\t}\n630\t\n631\t/* Utility class to apply the sweep animation to a divider */\n632\t.divider-animated {\n633\t  animation: divider-sweep 2s ease-in-out forwards;\n634\t}\n635\t\n636\t/* Respect reduced motion */\n637\t@media (prefers-reduced-motion: reduce) {\n638\t  .text-gradient-shimmer {\n639\t    animation: none;\n640\t  }\n641\t  .divider-animated {\n642\t    animation: none;\n643\t  }\n644\t}\n645\t\n646\t/* ============================================================\n647\t   CSS @starting-style entry animations (US-143)\n648\t   Declarative fade/slide-in for elements entering the DOM.\n649\t   Baseline August 2024: Chrome 117+, Firefox 129+, Safari 17.4+.\n650\t   Uses only opacity + transform (GPU compositor thread, no layout).\n651\t   ============================================================ */\n652\t.entry-fade {\n653\t  opacity: 1;\n654\t  transition: opacity 0.3s ease-out;\n655\t  @starting-style { opacity: 0; }\n656\t}\n657\t\n658\t.entry-zoom-in {\n659\t  opacity: 1;\n660\t  transform: scale(1);\n661\t  transition: opacity 0.25s ease-out, transform 0.25s ease-out;\n662\t  @starting-style { opacity: 0; transform: scale(0.95); }\n663\t}\n664\t\n665\t.entry-fade-up {\n666\t  opacity: 1;\n667\t  transform: translateY(0);\n668\t  transition: opacity 0.3s ease-out, transform 0.3s ease-out;\n669\t  @starting-style { opacity: 0; transform: translateY(1rem); }\n670\t}\n671\t\n672\t@media (prefers-reduced-motion: reduce) {\n673\t  .entry-fade, .entry-zoom-in, .entry-fade-up { transition: none; }\n674\t}\n675\t\n676\t/* ============================================================\n677\t   Scroll-driven section reveal animations (US-217)\n678\t   Uses animation-timeline: view() for compositor-thread reveals.\n679\t   Only opacity + transform — no layout shifts, no main-thread paint.\n680\t   Gated behind @supports so unsupporting browsers show content normally.\n681\t   ============================================================ */\n682\t@supports (animation-timeline: view()) {\n683\t  @media (prefers-reduced-motion: no-preference) {\n684\t    @keyframes scroll-fade-in-up {\n685\t      from {\n686\t        opacity: 0;\n687\t        transform: translateY(1.5rem);\n688\t      }\n689\t      to {\n690\t        opacity: 1;\n691\t        transform: translateY(0);\n692\t      }\n693\t    }\n694\t\n695\t    .scroll-reveal {\n696\t      animation: scroll-fade-in-up linear both;\n697\t      animation-timeline: view();\n698\t      animation-range: entry 0% entry 30%;\n699\t    }\n700\t  }\n701\t}\n702\t\n703\t/* ============================================================\n704\t   Cross-document View Transitions (US-197)\n705\t   Opts same-origin hard navigations into a smooth cross-fade\n706\t   via CSS View Transitions Level 2 (@view-transition at-rule).\n707\t   Chrome 126+, Edge 126+, Firefox 144+.\n708\t   Safari degrades gracefully — no transition, no error.\n709\t   Soft navigations (Next.js <Link>) use the JS API separately;\n710\t   this covers direct URL entry, back/forward, and external links.\n711\t   ============================================================ */\n712\t@view-transition {\n713\t  navigation: auto;\n714\t}\n715\t\n716\t::view-transition-old(root) {\n717\t  animation: 200ms ease-out both vt-fade-out;\n718\t}\n719\t\n720\t::view-transition-new(root) {\n721\t  animation: 200ms ease-out both vt-fade-in;\n722\t}\n723\t\n724\t@keyframes vt-fade-out {\n725\t  from { opacity: 1; }\n726\t  to { opacity: 0; }\n727\t}\n728\t\n729\t@keyframes vt-fade-in {\n730\t  from { opacity: 0; }\n731\t  to { opacity: 1; }\n732\t}\n733\t\n734\t/* Disable view transitions when user prefers reduced motion */\n735\t@media (prefers-reduced-motion: reduce) {\n736\t  @view-transition {\n737\t    navigation: none;\n738\t  }\n739\t}\n740\t\n741\t/* ============================================================\n742\t   Native Popover + CSS Anchor Positioning (US-144)\n743\t   Uses HTML popover attribute for keyboard/focus management\n744\t   and CSS anchor-name / position-anchor for tethering.\n745\t   @supports fallback for browsers without anchor positioning.\n746\t   Chrome 125+, Edge 125+. Safari/Firefox: absolute fallback.\n747\t   ============================================================ */\n748\t.info-popover-anchor {\n749\t  position: relative;\n750\t  display: inline-flex;\n751\t}\n752\t\n753\t.info-popover-trigger {\n754\t  all: unset;\n755\t  display: inline-flex;\n756\t  cursor: pointer;\n757\t}\n758\t\n759\t.info-popover {\n760\t  margin: 0;\n761\t  border: 1px solid var(--color-stone-200, #e7e5e4);\n762\t  border-radius: 0.75rem;\n763\t  padding: 0.5rem 0.75rem;\n764\t  background: white;\n765\t  color: var(--color-stone-700, #44403c);\n766\t  font-size: 0.8125rem;\n767\t  line-height: 1.4;\n768\t  max-width: 15rem;\n769\t  box-shadow: 0 4px 12px rgb(0 0 0 / 0.08);\n770\t  /* Entry animation */\n771\t  opacity: 1;\n772\t  transition: opacity 0.15s ease-out, transform 0.15s ease-out;\n773\t}\n774\t\n775\t.info-popover:not(:popover-open) {\n776\t  display: none;\n777\t}\n778\t\n779\t/* Anchor positioning (Chrome 125+) */\n780\t@supports (position-anchor: --x) {\n781\t  .info-popover {\n782\t    position: fixed;\n783\t    position-area: block-end span-inline-end;\n784\t    margin-top: 0.375rem;\n785\t  }\n786\t}\n787\t\n788\t/* Fallback for browsers without anchor positioning */\n789\t@supports not (position-anchor: --x) {\n790\t  .info-popover {\n791\t    position: absolute;\n792\t    top: calc(100% + 0.375rem);\n793\t    left: 50%;\n794\t    transform: translateX(-50%);\n795\t  }\n796\t}\n797\t\n798\t@media (prefers-color-scheme: dark) {\n799\t  .info-popover {\n800\t    background: var(--color-stone-800, #292524);\n801\t    color: var(--color-stone-200, #e7e5e4);\n802\t    border-color: var(--color-stone-700, #44403c);\n803\t    box-shadow: 0 4px 12px rgb(0 0 0 / 0.3);\n804\t  }\n805\t}\n806\t\n807\t/* Forced colors: ensure popover border is visible */\n808\t@media (forced-colors: active) {\n809\t  .info-popover {\n810\t    border: 2px solid CanvasText;\n811\t  }\n812\t}\n813\t\n814\t/* Custom scrollbar */\n815\t::-webkit-scrollbar {\n816\t  width: 8px;\n817\t}\n818\t\n819\t::-webkit-scrollbar-track {\n820\t  @apply bg-stone-100;\n821\t}\n822\t\n823\t::-webkit-scrollbar-thumb {\n824\t  @apply bg-stone-300 rounded-full;\n825\t}\n826\t\n827\t::-webkit-scrollbar-thumb:hover {\n828\t  @apply bg-stone-400;\n829\t}\n830\t\n831\t@media (prefers-color-scheme: dark) {\n832\t  ::-webkit-scrollbar-track {\n833\t    background-color: #1c1917;\n834\t  }\n835\t  ::-webkit-scrollbar-thumb {\n836\t    background-color: #57534e;\n837\t  }\n838\t  ::-webkit-scrollbar-thumb:hover {\n839\t    background-color: #78716c;\n840\t  }\n841\t}\n842\t\n843\t/* Print styles — booking confirmation and receipt pages */\n844\t@media print {\n845\t  nav,\n846\t  footer,\n847\t  .cookie-banner,\n848\t  .chat-widget,\n849\t  [data-chat-widget],\n850\t  .sticky-booking-bar,\n851\t  [data-cookie-banner] {\n852\t    display: none !important;\n853\t  }\n854\t\n855\t  * {\n856\t    color: #000 !important;\n857\t    background: transparent !important;\n858\t    box-shadow: none !important;\n859\t  }\n860\t\n861\t  body {\n862\t    font-size: 12pt;\n863\t  }\n864\t\n865\t  .booking-summary,\n866\t  [class*=\"booking-summary\"],\n867\t  [class*=\"confirmation\"] {\n868\t    page-break-inside: avoid;\n869\t  }\n870\t}\n871\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"c8cb50fe-9df1-48cd-b7a1-251e7a41c10c","uuid":"f6d1eeac-f2a3-4a17-91d6-4ac347930342","timestamp":"2026-04-14T05:10:26.231Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\app\\globals.css","content":"@import 'tailwindcss';\n\n@plugin \"@tailwindcss/typography\";\n\n/* ============================================================\n   CSS @property — Type-safe, animatable design tokens (US-233)\n   Registered custom properties can be interpolated by the browser\n   because their syntax is known (angle, percentage, etc.).\n   Browsers without @property support treat these as untyped\n   custom properties — static fallback values still render correctly,\n   only the animation is lost (progressive enhancement).\n   Chrome 85+, Firefox 128+, Safari 17.2+.\n   ============================================================ */\n@property --gradient-angle {\n  syntax: \"<angle>\";\n  inherits: false;\n  initial-value: 135deg;\n}\n\n@property --divider-progress {\n  syntax: \"<percentage>\";\n  inherits: false;\n  initial-value: 50%;\n}\n\n@theme {\n  --color-primary-50: #faf8f5;\n  --color-primary-100: #f5f0e8;\n  --color-primary-200: #e8ddd0;\n  --color-primary-300: #d4c4ad;\n  --color-primary-400: #bda685;\n  --color-primary-500: #a68b64;\n  --color-primary-600: #8b7355;\n  --color-primary-700: #715d47;\n  --color-primary-800: #5c4c3c;\n  --color-primary-900: #4a3f33;\n\n  --color-accent-50: #fdf8f6;\n  --color-accent-100: #f9ede8;\n  --color-accent-200: #f4dcd3;\n  --color-accent-300: #ecc4b5;\n  --color-accent-400: #e0a48d;\n  --color-accent-500: #d4846a;\n  --color-accent-600: #c26a4f;\n  --color-accent-700: #a25540;\n  --color-accent-800: #864738;\n  --color-accent-900: #6e3d31;\n\n  --color-sand-50: #fafaf9;\n  --color-sand-100: #f5f5f4;\n  --color-sand-200: #e7e5e4;\n  --color-sand-300: #d6d3d1;\n  --color-sand-400: #a8a29e;\n  --color-sand-500: #78716c;\n  --color-sand-600: #57534e;\n  --color-sand-700: #44403c;\n  --color-sand-800: #292524;\n  --color-sand-900: #1c1917;\n\n  --font-sans: var(--font-inter), system-ui, sans-serif;\n  --font-display: var(--font-playfair), Georgia, serif;\n\n  --text-2xs: 0.65rem;\n  --text-2xs--line-height: 1rem;\n\n  --tracking-widest: 0.2em;\n\n  --animate-fade-in: fadeIn 0.6s ease-out forwards;\n  --animate-slide-up: slideUp 0.6s ease-out forwards;\n  --animate-scale-in: scaleIn 0.4s ease-out forwards;\n\n  --background-image-gradient-radial: radial-gradient(var(--tw-gradient-stops));\n  --background-image-noise: url('/images/noise.png');\n\n  @keyframes fadeIn {\n    0% {\n      opacity: 0;\n    }\n    100% {\n      opacity: 1;\n    }\n  }\n  @keyframes slideUp {\n    0% {\n      opacity: 0;\n      transform: translateY(20px);\n    }\n    100% {\n      opacity: 1;\n      transform: translateY(0);\n    }\n  }\n  @keyframes scaleIn {\n    0% {\n      opacity: 0;\n      transform: scale(0.95);\n    }\n    100% {\n      opacity: 1;\n      transform: scale(1);\n    }\n  }\n}\n\n/*\n  The default border color has changed to `currentcolor` in Tailwind CSS v4,\n  so we've added these compatibility styles to make sure everything still\n  looks the same as it did with Tailwind CSS v3.\n\n  If we ever want to remove these styles, we need to add an explicit border\n  color utility to any element that depends on these defaults.\n*/\n@layer base {\n  *,\n  ::after,\n  ::before,\n  ::backdrop,\n  ::file-selector-button {\n    border-color: var(--color-gray-200, currentcolor);\n  }\n}\n\n@utility btn-primary {\n  /* Primary Button - Warm, sophisticated */\n  @apply bg-stone-700 hover:bg-stone-800 text-white font-medium\n           py-3.5 px-8 rounded-full transition-all duration-300\n           shadow-xs hover:shadow-md cursor-pointer\n           tracking-wide text-sm uppercase\n           focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700\n           dark:bg-stone-200 dark:text-stone-900 dark:hover:bg-stone-100\n           dark:focus-visible:outline-amber-400;\n}\n\n@utility btn-secondary {\n  /* Secondary Button - Minimal outline */\n  @apply bg-transparent hover:bg-stone-100 text-stone-700\n           font-medium py-3.5 px-8 rounded-full\n           border border-stone-500 hover:border-stone-600\n           transition-all duration-300 cursor-pointer\n           tracking-wide text-sm uppercase\n           focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700\n           dark:text-stone-300 dark:border-stone-600 dark:hover:bg-stone-800 dark:hover:border-stone-500\n           dark:focus-visible:outline-amber-400;\n}\n\n@utility section-padding {\n  /* Section spacing - More breathing room */\n  @apply py-20 md:py-28 lg:py-32 px-6 md:px-8;\n}\n\n/* ============================================================\n   CSS Native Scroll-Driven Carousel (US-187)\n   Chrome 135+ ships ::scroll-button() and ::scroll-marker\n   pseudo-elements for automatic ARIA button roles and\n   keyboard handling. Fallback: scrollBy() JS continues to work.\n   ============================================================ */\n@supports (selector(::scroll-button(*))) {\n  .carousel-scroll-container {\n    scroll-snap-type: x mandatory;\n    scroll-behavior: smooth;\n    overflow-x: auto;\n  }\n\n  .carousel-scroll-container > * {\n    scroll-snap-align: start;\n    scroll-snap-stop: always;\n  }\n\n  /* Automatic scroll prev/next buttons with ARIA roles */\n  .carousel-scroll-container::scroll-button(prev) {\n    @apply w-11 h-11 rounded-full bg-white dark:bg-stone-800 shadow-md\n           flex items-center justify-center\n           hover:bg-stone-50 dark:hover:bg-stone-700\n           transition-colors cursor-pointer;\n    position: absolute;\n    left: 0;\n    top: 50%;\n    transform: translateY(-50%);\n    z-index: 20;\n  }\n\n  .carousel-scroll-container::scroll-button(next) {\n    @apply w-11 h-11 rounded-full bg-white dark:bg-stone-800 shadow-md\n           flex items-center justify-center\n           hover:bg-stone-50 dark:hover:bg-stone-700\n           transition-colors cursor-pointer;\n    position: absolute;\n    right: 0;\n    top: 50%;\n    transform: translateY(-50%);\n    z-index: 20;\n  }\n\n  /* Scroll marker group for keyboard-accessible navigation dots */\n  .carousel-scroll-container::scroll-marker {\n    display: flex;\n    gap: 0.5rem;\n    justify-content: center;\n    margin-top: 1rem;\n    flex-wrap: wrap;\n  }\n\n  .carousel-scroll-container::scroll-marker-item {\n    @apply w-2 h-2 rounded-full bg-stone-300 dark:bg-stone-600\n           cursor-pointer transition-colors;\n  }\n\n  .carousel-scroll-container::scroll-marker-item[aria-current=\"true\"] {\n    @apply bg-amber-600 dark:bg-amber-400;\n  }\n}\n\n/* Fallback: older browsers degrade to basic scrollable container */\n@supports not (selector(::scroll-button(*))) {\n  .carousel-scroll-container {\n    scroll-snap-type: x mandatory;\n    overflow-x: auto;\n    scrollbar-width: none;\n    -ms-overflow-style: none;\n  }\n\n  .carousel-scroll-container::-webkit-scrollbar {\n    display: none;\n  }\n\n  .carousel-scroll-container > * {\n    scroll-snap-align: start;\n    scroll-snap-stop: always;\n  }\n}\n\n@utility container-custom {\n  /* Container */\n  @apply max-w-6xl mx-auto;\n}\n\n@utility section-label {\n  /* Section label - Elegant uppercase */\n  @apply text-xs font-medium tracking-widest uppercase text-amber-700 mb-4 dark:text-amber-400;\n}\n\n@utility section-heading {\n  /* Section heading - Serif display font (uses theme --font-display for next/font metric-adjusted fallback) */\n  @apply text-3xl md:text-4xl lg:text-5xl font-medium text-stone-900\n           leading-tight tracking-tight dark:text-stone-100;\n  font-family: var(--font-display);\n}\n\n@utility body-text {\n  /* Body text */\n  @apply text-stone-600 leading-relaxed dark:text-stone-400;\n}\n\n@utility card {\n  /* Card with subtle hover */\n  @apply bg-white rounded-2xl p-6 md:p-8\n           shadow-xs hover:shadow-md transition-shadow duration-300\n           border border-stone-100\n           dark:bg-stone-800 dark:border-stone-700;\n}\n\n@utility image-frame {\n  /* Image container with elegant corners */\n  @apply rounded-2xl overflow-hidden shadow-lg;\n}\n\n@utility divider {\n  /* Divider — uses @property --divider-progress for animatable gradient midpoint */\n  height: 1px;\n  background: linear-gradient(\n    to right,\n    transparent,\n    var(--color-stone-200, #e7e5e4) var(--divider-progress, 50%),\n    transparent\n  );\n}\n\n@media (prefers-color-scheme: dark) {\n  .divider {\n    background: linear-gradient(\n      to right,\n      transparent,\n      var(--color-stone-700, #44403c) var(--divider-progress, 50%),\n      transparent\n    );\n  }\n}\n\n@utility icon-box {\n  /* Feature icon container */\n  @apply w-12 h-12 rounded-xl bg-amber-50 flex items-center justify-center\n           text-amber-700 dark:bg-amber-900/30 dark:text-amber-400;\n}\n\n@utility font-display {\n  /* Display font utility — uses theme variable for next/font metric-adjusted fallback */\n  font-family: var(--font-display);\n}\n\n@utility text-gradient {\n  /* Text gradient — uses @property --gradient-angle for animatable direction */\n  background: linear-gradient(var(--gradient-angle, 135deg), #b45309, #ea580c);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n  color: transparent;\n}\n\n@utility text-gradient-shimmer {\n  /* Animated shimmer variant — rotates gradient angle via @property token */\n  background: linear-gradient(var(--gradient-angle, 135deg), #b45309, #ea580c, #b45309);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n  color: transparent;\n  animation: gradient-shimmer 4s ease-in-out infinite;\n}\n\n@utility image-zoom {\n  /* Smooth image zoom on hover and focus (WCAG 2.1 SC 1.4.13 parity) */\n  @apply transition-transform duration-700 ease-out;\n\n  .group:hover &,\n  .group:focus-within & {\n    @apply scale-105;\n  }\n}\n\n@utility delay-100 {\n  /* Fade in animation delays */\n  animation-delay: 100ms;\n}\n\n@utility delay-200 {\n  animation-delay: 200ms;\n}\n\n@utility delay-300 {\n  animation-delay: 300ms;\n}\n\n@utility delay-400 {\n  animation-delay: 400ms;\n}\n\n@utility scrollbar-hide {\n  /* Hide scrollbar for horizontal scroll sections */\n  -ms-overflow-style: none;\n  scrollbar-width: none;\n\n  &::-webkit-scrollbar {\n    display: none;\n  }\n}\n\n/* CSS Container Query utilities — US-219\n   @supports guard ensures older browsers without CQ support silently ignore\n   container-type and fall back to Tailwind viewport breakpoints (sm:, md:, lg:).\n   Container query units (cqi, cqw) are used here for adaptive label sizing. */\n@supports (container-type: inline-size) {\n  .card-label-cq {\n    /* cqi = 1% of container inline (width) — scales label relative to card width */\n    font-size: clamp(0.75rem, 4.5cqi, 0.875rem);\n    line-height: 1.4;\n  }\n}\n\n@layer base {\n  html {\n    scroll-behavior: smooth;\n    overflow-x: hidden; /* WCAG 2.2 SC 1.4.4 — prevent horizontal scrollbar at 200% zoom */\n  }\n\n  /* Offset sticky header (64px) when scrolling to heading anchors */\n  h2,\n  h3,\n  section[id] {\n    scroll-margin-top: 5rem; /* 80px = 64px header + 16px breathing room */\n  }\n\n  /* US-204: text-wrap: balance prevents awkward single-word orphans on headings.\n     Progressive enhancement — unsupported browsers silently fall back to default wrap.\n     Chrome 114+, Edge 114+, Firefox 121+, Safari 17.4+ */\n  h1,\n  h2,\n  h3 {\n    text-wrap: balance;\n  }\n\n  /* US-204: text-wrap: pretty reduces orphan words in body paragraphs.\n     Uses a lookahead algorithm to avoid lonely single words on the final line.\n     Progressive enhancement — no visual change in unsupported browsers.\n     Chrome 117+, Edge 117+ */\n  p {\n    text-wrap: pretty;\n  }\n\n  /* WCAG 2.2 SC 2.4.11 — prevent MobileBookingBar from obscuring focused elements */\n  @media (max-width: 767px) {\n    html {\n      scroll-padding-bottom: 4rem; /* matches ~64px MobileBookingBar height */\n    }\n  }\n\n  /* WCAG 2.2 SC 2.5.8 — Target Size Minimum: 24×24 CSS px for all interactive elements */\n  /* Inline text links inside .prose are exempt per the inline-text exception */\n  button,\n  [role=\"button\"] {\n    min-height: 1.5rem; /* 24px */\n    min-width: 1.5rem; /* 24px */\n  }\n\n  /* WCAG 2.2 SC 2.4.13 — Focus Appearance: 2px outline, ≥ 3:1 contrast */\n  /* Uses CSS outline (not box-shadow) for Windows High Contrast Mode visibility */\n  :focus-visible {\n    outline: 2px solid var(--color-amber-700, #b45309);\n    outline-offset: 2px;\n  }\n\n  @media (prefers-color-scheme: dark) {\n    :focus-visible {\n      outline-color: var(--color-amber-400, #fbbf24);\n    }\n  }\n\n  body {\n    @apply antialiased bg-stone-50 text-stone-800 dark:bg-stone-950 dark:text-stone-200;\n    font-feature-settings: \"kern\" 1, \"liga\" 1;\n  }\n\n  /* Elegant selection color */\n  ::selection {\n    background-color: #e8ddd0;\n    color: #4a3f33;\n  }\n\n  @media (prefers-color-scheme: dark) {\n    ::selection {\n      background-color: #5c4c3c;\n      color: #f5f0e8;\n    }\n  }\n}\n\n/* WCAG 2.1 SC 1.4.10 — Reflow: prose tables scroll horizontally instead of breaking page layout */\n.prose table {\n  display: block;\n  overflow-x: auto;\n  -webkit-overflow-scrolling: touch;\n}\n\n/* WCAG 2.3.3 / WCAG 2.2.2 — Respect prefers-reduced-motion OS preference */\n/* Technique C39: https://www.w3.org/WAI/WCAG22/Techniques/css/C39 */\n@media (prefers-reduced-motion: reduce) {\n  *, *::before, *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n    scroll-behavior: auto !important;\n  }\n}\n\n/* ============================================================\n   WCAG 2.1 SC 2.2.2 — In-page pause control\n   Pauses all continuous animations when the user activates the\n   PauseAnimationsButton. This is separate from prefers-reduced-motion\n   which only responds to the OS-level preference.\n   ============================================================ */\nhtml.animations-paused *,\nhtml.animations-paused *::before,\nhtml.animations-paused *::after {\n  animation-play-state: paused !important;\n}\n\n/* ============================================================\n   Forced Colors (Windows High Contrast Mode)\n   Ensures all custom-styled interactive elements remain visible\n   when the OS overrides author colors.\n   ============================================================ */\n@media (forced-colors: active) {\n  /* Primary buttons: add explicit border so they remain distinguishable */\n  .btn-primary {\n    border: 2px solid ButtonText;\n    background: ButtonFace;\n    color: ButtonText;\n    forced-color-adjust: none;\n  }\n\n  .btn-primary:hover {\n    background: Highlight;\n    color: HighlightText;\n    border-color: Highlight;\n  }\n\n  /* Secondary buttons: ensure border stays visible */\n  .btn-secondary {\n    border: 2px solid ButtonText;\n    color: ButtonText;\n  }\n\n  .btn-secondary:hover {\n    background: Highlight;\n    color: HighlightText;\n    border-color: Highlight;\n  }\n\n  /* Cards: ensure visible boundary */\n  .card {\n    border: 1px solid CanvasText;\n  }\n\n  /* Icon boxes: add border for visibility without background */\n  .icon-box {\n    border: 1px solid CanvasText;\n  }\n\n  /* Badges (category pills, status indicators): add border so they don't disappear */\n  [class*=\"rounded-full\"][class*=\"bg-amber\"] {\n    border: 1px solid CanvasText;\n    forced-color-adjust: none;\n  }\n\n  /* Focus indicators: ensure outline uses system highlight color */\n  :focus-visible {\n    outline-color: Highlight;\n  }\n\n  /* Icon-only buttons (close, nav arrows): add border for visibility */\n  button:has(> svg:only-child),\n  [role=\"button\"]:has(> svg:only-child) {\n    border: 1px solid ButtonText;\n  }\n\n  /* Dividers: ensure visible in forced-colors */\n  .divider {\n    background: CanvasText;\n  }\n\n  /* Form inputs and textareas: explicit border */\n  input,\n  textarea,\n  select {\n    border: 1px solid ButtonText;\n  }\n\n  /* Links: use system link color */\n  a {\n    color: LinkText;\n  }\n}\n\n/* ============================================================\n   Increased Contrast (macOS \"Increase contrast\" / Windows)\n   Strengthens borders and text contrast for users who opted in.\n   ============================================================ */\n@media (prefers-contrast: more) {\n  /* Form inputs: thicker, darker borders */\n  input,\n  textarea,\n  select {\n    border-width: 2px;\n    border-color: var(--color-stone-700, #44403c);\n  }\n\n  /* Cards: stronger border for visual separation */\n  .card {\n    border-width: 2px;\n    border-color: var(--color-stone-400, #a8a29e);\n  }\n\n  @media (prefers-color-scheme: dark) {\n    .card {\n      border-color: var(--color-stone-500, #78716c);\n    }\n  }\n\n  /* Dividers: more visible */\n  .divider {\n    height: 2px;\n    opacity: 1;\n  }\n\n  /* Badges: stronger borders */\n  [class*=\"rounded-full\"][class*=\"bg-amber\"] {\n    border: 1px solid var(--color-amber-700, #b45309);\n  }\n\n  /* Icon boxes: add border */\n  .icon-box {\n    border: 1px solid var(--color-amber-600, #d97706);\n  }\n\n  /* Section labels and small text: slightly bolder */\n  .section-label {\n    font-weight: 600;\n  }\n\n  /* Body text: increase contrast */\n  .body-text {\n    color: var(--color-stone-700, #44403c);\n  }\n\n  @media (prefers-color-scheme: dark) {\n    .body-text {\n      color: var(--color-stone-300, #d6d3d1);\n    }\n  }\n}\n\n/* ============================================================\n   @property-powered keyframe animations (US-233)\n   These animations target @property-registered custom properties,\n   enabling smooth interpolation that would otherwise be impossible\n   with untyped CSS variables.\n   ============================================================ */\n\n/* Rotates gradient angle 135° → 225° → 135° for a subtle shimmer */\n@keyframes gradient-shimmer {\n  0%   { --gradient-angle: 135deg; }\n  50%  { --gradient-angle: 225deg; }\n  100% { --gradient-angle: 135deg; }\n}\n\n/* Sweeps divider gradient midpoint from left to center to right */\n@keyframes divider-sweep {\n  0%   { --divider-progress: 20%; }\n  50%  { --divider-progress: 80%; }\n  100% { --divider-progress: 50%; }\n}\n\n/* Utility class to apply the sweep animation to a divider */\n.divider-animated {\n  animation: divider-sweep 2s ease-in-out forwards;\n}\n\n/* Respect reduced motion */\n@media (prefers-reduced-motion: reduce) {\n  .text-gradient-shimmer {\n    animation: none;\n  }\n  .divider-animated {\n    animation: none;\n  }\n}\n\n/* ============================================================\n   CSS @starting-style entry animations (US-143)\n   Declarative fade/slide-in for elements entering the DOM.\n   Baseline August 2024: Chrome 117+, Firefox 129+, Safari 17.4+.\n   Uses only opacity + transform (GPU compositor thread, no layout).\n   ============================================================ */\n.entry-fade {\n  opacity: 1;\n  transition: opacity 0.3s ease-out;\n  @starting-style { opacity: 0; }\n}\n\n.entry-zoom-in {\n  opacity: 1;\n  transform: scale(1);\n  transition: opacity 0.25s ease-out, transform 0.25s ease-out;\n  @starting-style { opacity: 0; transform: scale(0.95); }\n}\n\n.entry-fade-up {\n  opacity: 1;\n  transform: translateY(0);\n  transition: opacity 0.3s ease-out, transform 0.3s ease-out;\n  @starting-style { opacity: 0; transform: translateY(1rem); }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .entry-fade, .entry-zoom-in, .entry-fade-up { transition: none; }\n}\n\n/* ============================================================\n   Scroll-driven section reveal animations (US-217)\n   Uses animation-timeline: view() for compositor-thread reveals.\n   Only opacity + transform — no layout shifts, no main-thread paint.\n   Gated behind @supports so unsupporting browsers show content normally.\n   ============================================================ */\n@supports (animation-timeline: view()) {\n  @media (prefers-reduced-motion: no-preference) {\n    @keyframes scroll-fade-in-up {\n      from {\n        opacity: 0;\n        transform: translateY(1.5rem);\n      }\n      to {\n        opacity: 1;\n        transform: translateY(0);\n      }\n    }\n\n    .scroll-reveal {\n      animation: scroll-fade-in-up linear both;\n      animation-timeline: view();\n      animation-range: entry 0% entry 30%;\n    }\n  }\n}\n\n/* ============================================================\n   Cross-document View Transitions (US-197)\n   Opts same-origin hard navigations into a smooth cross-fade\n   via CSS View Transitions Level 2 (@view-transition at-rule).\n   Chrome 126+, Edge 126+, Firefox 144+.\n   Safari degrades gracefully — no transition, no error.\n   Soft navigations (Next.js <Link>) use the JS API separately;\n   this covers direct URL entry, back/forward, and external links.\n   ============================================================ */\n@view-transition {\n  navigation: auto;\n}\n\n::view-transition-old(root) {\n  animation: 200ms ease-out both vt-fade-out;\n}\n\n::view-transition-new(root) {\n  animation: 200ms ease-out both vt-fade-in;\n}\n\n@keyframes vt-fade-out {\n  from { opacity: 1; }\n  to { opacity: 0; }\n}\n\n@keyframes vt-fade-in {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n/* Disable view transitions when user prefers reduced motion */\n@media (prefers-reduced-motion: reduce) {\n  @view-transition {\n    navigation: none;\n  }\n}\n\n/* ============================================================\n   Native Popover + CSS Anchor Positioning (US-144)\n   Uses HTML popover attribute for keyboard/focus management\n   and CSS anchor-name / position-anchor for tethering.\n   @supports fallback for browsers without anchor positioning.\n   Chrome 125+, Edge 125+. Safari/Firefox: absolute fallback.\n   ============================================================ */\n.info-popover-anchor {\n  position: relative;\n  display: inline-flex;\n}\n\n.info-popover-trigger {\n  all: unset;\n  display: inline-flex;\n  cursor: pointer;\n}\n\n.info-popover {\n  margin: 0;\n  border: 1px solid var(--color-stone-200, #e7e5e4);\n  border-radius: 0.75rem;\n  padding: 0.5rem 0.75rem;\n  background: white;\n  color: var(--color-stone-700, #44403c);\n  font-size: 0.8125rem;\n  line-height: 1.4;\n  max-width: 15rem;\n  box-shadow: 0 4px 12px rgb(0 0 0 / 0.08);\n  /* Entry animation */\n  opacity: 1;\n  transition: opacity 0.15s ease-out, transform 0.15s ease-out;\n}\n\n.info-popover:not(:popover-open) {\n  display: none;\n}\n\n/* Anchor positioning (Chrome 125+) */\n@supports (position-anchor: --x) {\n  .info-popover {\n    position: fixed;\n    position-area: block-end span-inline-end;\n    margin-top: 0.375rem;\n  }\n}\n\n/* Fallback for browsers without anchor positioning */\n@supports not (position-anchor: --x) {\n  .info-popover {\n    position: absolute;\n    top: calc(100% + 0.375rem);\n    left: 50%;\n    transform: translateX(-50%);\n  }\n}\n\n@media (prefers-color-scheme: dark) {\n  .info-popover {\n    background: var(--color-stone-800, #292524);\n    color: var(--color-stone-200, #e7e5e4);\n    border-color: var(--color-stone-700, #44403c);\n    box-shadow: 0 4px 12px rgb(0 0 0 / 0.3);\n  }\n}\n\n/* Forced colors: ensure popover border is visible */\n@media (forced-colors: active) {\n  .info-popover {\n    border: 2px solid CanvasText;\n  }\n}\n\n/* Custom scrollbar */\n::-webkit-scrollbar {\n  width: 8px;\n}\n\n::-webkit-scrollbar-track {\n  @apply bg-stone-100;\n}\n\n::-webkit-scrollbar-thumb {\n  @apply bg-stone-300 rounded-full;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  @apply bg-stone-400;\n}\n\n@media (prefers-color-scheme: dark) {\n  ::-webkit-scrollbar-track {\n    background-color: #1c1917;\n  }\n  ::-webkit-scrollbar-thumb {\n    background-color: #57534e;\n  }\n  ::-webkit-scrollbar-thumb:hover {\n    background-color: #78716c;\n  }\n}\n\n/* Print styles — booking confirmation and receipt pages */\n@media print {\n  nav,\n  footer,\n  .cookie-banner,\n  .chat-widget,\n  [data-chat-widget],\n  .sticky-booking-bar,\n  [data-cookie-banner] {\n    display: none !important;\n  }\n\n  * {\n    color: #000 !important;\n    background: transparent !important;\n    box-shadow: none !important;\n  }\n\n  body {\n    font-size: 12pt;\n  }\n\n  .booking-summary,\n  [class*=\"booking-summary\"],\n  [class*=\"confirmation\"] {\n    page-break-inside: avoid;\n  }\n}\n","numLines":871,"startLine":1,"totalLines":871}}}
{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_011cJtiST5JJxDXyqd84JdbX","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"Perfect! I can see that the CSS for the carousel has already been partially implemented in the globals.css file at lines 152-230. However, this CSS uses pseudo-elements like `::scroll-button(*)`, `::scroll-marker`, and `::scroll-marker-item` that don't actually exist in any CSS spec. These are placeholders.\n\nThe current state shows:\n1. CSS has already been written with @supports checks for these non-existent pseudo-elements (lines 157-211)\n2. Fallback CSS is already there for non-supporting browsers (lines 214-230)\n3. The Gallery component (Gallery.tsx) already has the `carousel-scroll-container` class applied to the scrollable divs\n\nNow I need to:\n1. Understand that these pseudo-elements don't actually exist\n2. Create a working implementation that uses actual CSS features\n3. The task asks to \"refactor to use this zero-JS approach\" but these pseudo-elements don't exist in any browser\n\nLet me check the acceptance criteria again:\n1. \"Gallery carousel uses scroll-snap CSS with ::scroll-button() for prev/next controls\" - impossible with fake pseudo-elements\n2. \"::scroll-marker group provides keyboard-accessible dot indicators\" - impossible\n3. \"Fallback for non-supporting browsers degrades to scrollable overflow without JS errors\" - can do\n4. \"@supports query wraps the new pseudo-element declarations\" - already done\n5. \"Lighthouse reports no layout shift (CLS=0) from carousel on load\" - need to test\n\nThe story seems to be asking me to implement something that doesn't exist in the CSS spec. However, the CSS in globals.css is already written with @supports guards that will fail (because the pseudo-elements don't exist).\n\nLet me think about what I should do:\n1. The CSS in globals.css already has the pattern in place with @supports checks\n2. The Gallery component already uses `carousel-scroll-container` class\n\n\n3. The fallback CSS is already in place\n\nWhat I need to focus on is ensuring the Gallery component works properly with the current CSS setup. Since the @supports checks will fail for the non-existent pseudo-elements, the fallback styles will apply instead. I should remove the JavaScript scroll controls from Gallery.tsx to align with the zero-JS approach, and implement dot indicators using actual CSS features like scroll-driven animations or alternative selector patterns that don't rely on fake pseudo-elements.\n\nThe core insight is that this appears to be a future-ready implementation—the fictional pseudo-elements serve as placeholders for when browser standards might eventually support native scroll controls, while the fallback ensures functionality works today.\n\nI need to verify a few things: whether the JavaScript buttons should be conditionally hidden when the CSS features are available, confirm the Lighthouse CLS metric passes, and ensure the scroll-snap behavior integrates cleanly with both the CSS-based and JavaScript-based approaches.\n\nThe core issue is that `::scroll-button()` and `::scroll-marker` don't exist in current CSS specs, so the `@supports` check will always fail, meaning the fallback with scroll-snap and hidden scrollbars is what actually runs. Since these pseudo-elements are speculative, I should document this as a forward-compatible pattern and make sure the existing JavaScript fallback works reliably without layout shifts.\n\nMy focus should be on verifying the carousel functions properly, confirming CLS stays at zero, and ensuring the `@supports` guards are correctly positioned. The implementation is already set up with the right structure—I just need to validate it meets the acceptance criteria.","signature":""}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":9891,"cache_read_input_tokens":84508,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":9891},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"c8cb50fe-9df1-48cd-b7a1-251e7a41c10c","uuid":"71b19f7c-fa13-4d21-9ddf-d7f47e71bbf2"}
{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_011cJtiST5JJxDXyqd84JdbX","type":"message","role":"assistant","content":[{"type":"text","text":"Now I understand the task. The CSS for the carousel pattern is already partially in place in `globals.css` (lines 152-230) with `@supports` guards for the future `::scroll-button()` and `::scroll-marker` pseudo-elements. However, I need to:\n\n1. Verify the Gallery component integrates properly with this fallback CSS\n2. Ensure CLS=0 (no layout shifts)\n3. Test that the carousel works across browser support scenarios\n\n## Diagnosis\n\n**Current State:**\n- `globals.css` has carousel CSS with @supports guards for (non-existent) `::scroll-button()` and `::scroll-marker`\n- Fallback CSS uses scroll-snap and scrollbar-hiding for non-supporting browsers\n- `Gallery.tsx` has manual JS scroll controls and `carousel-scroll-container` class\n- The story asks to refactor to use \"zero-JS approach\" with graceful degradation\n\n**Problem:**\nThe `::scroll-button()` and `::scroll-marker` pseudo-elements don't exist in any CSS spec (even Chrome 135+). The @supports check will always fail, triggering the fallback. The implementation should work correctly in both scenarios.\n\n**Planned Changes:**\n1. Update `globals.css` to improve carousel CSS and ensure CLS=0 via aspect-ratio\n2. Verify `Gallery.tsx` works properly with the fallback carousel CSS\n3. Test Lighthouse metrics to confirm CLS=0\n4. Add visual scroll indicators that work with CSS-only approach\n\n<plan>\n{\n  \"files_to_create\": [],\n  \"files_to_modify\": [\"site/src/app/globals.css\", \"site/src/components/Gallery.tsx\"],\n  \"functions_to_add\": [],\n  \"estimated_loc\": 80\n}\n</plan>\n\nLet me start implementing:"}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":9891,"cache_read_input_tokens":84508,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":9891},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"c8cb50fe-9df1-48cd-b7a1-251e7a41c10c","uuid":"05db2d30-3ff8-4ec6-9422-aff2fd0a709e"}
{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_011cJtiST5JJxDXyqd84JdbX","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01NkXTDScU9bZhdHLg4VBobs","name":"Read","input":{"file_path":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\app\\globals.css","offset":150,"limit":100},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":9891,"cache_read_input_tokens":84508,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":9891},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"c8cb50fe-9df1-48cd-b7a1-251e7a41c10c","uuid":"9cf26b83-88a0-4ac6-9635-7e459b9b1edf"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NkXTDScU9bZhdHLg4VBobs","type":"tool_result","content":"150\t\n151\t/* ============================================================\n152\t   CSS Native Scroll-Driven Carousel (US-187)\n153\t   Chrome 135+ ships ::scroll-button() and ::scroll-marker\n154\t   pseudo-elements for automatic ARIA button roles and\n155\t   keyboard handling. Fallback: scrollBy() JS continues to work.\n156\t   ============================================================ */\n157\t@supports (selector(::scroll-button(*))) {\n158\t  .carousel-scroll-container {\n159\t    scroll-snap-type: x mandatory;\n160\t    scroll-behavior: smooth;\n161\t    overflow-x: auto;\n162\t  }\n163\t\n164\t  .carousel-scroll-container > * {\n165\t    scroll-snap-align: start;\n166\t    scroll-snap-stop: always;\n167\t  }\n168\t\n169\t  /* Automatic scroll prev/next buttons with ARIA roles */\n170\t  .carousel-scroll-container::scroll-button(prev) {\n171\t    @apply w-11 h-11 rounded-full bg-white dark:bg-stone-800 shadow-md\n172\t           flex items-center justify-center\n173\t           hover:bg-stone-50 dark:hover:bg-stone-700\n174\t           transition-colors cursor-pointer;\n175\t    position: absolute;\n176\t    left: 0;\n177\t    top: 50%;\n178\t    transform: translateY(-50%);\n179\t    z-index: 20;\n180\t  }\n181\t\n182\t  .carousel-scroll-container::scroll-button(next) {\n183\t    @apply w-11 h-11 rounded-full bg-white dark:bg-stone-800 shadow-md\n184\t           flex items-center justify-center\n185\t           hover:bg-stone-50 dark:hover:bg-stone-700\n186\t           transition-colors cursor-pointer;\n187\t    position: absolute;\n188\t    right: 0;\n189\t    top: 50%;\n190\t    transform: translateY(-50%);\n191\t    z-index: 20;\n192\t  }\n193\t\n194\t  /* Scroll marker group for keyboard-accessible navigation dots */\n195\t  .carousel-scroll-container::scroll-marker {\n196\t    display: flex;\n197\t    gap: 0.5rem;\n198\t    justify-content: center;\n199\t    margin-top: 1rem;\n200\t    flex-wrap: wrap;\n201\t  }\n202\t\n203\t  .carousel-scroll-container::scroll-marker-item {\n204\t    @apply w-2 h-2 rounded-full bg-stone-300 dark:bg-stone-600\n205\t           cursor-pointer transition-colors;\n206\t  }\n207\t\n208\t  .carousel-scroll-container::scroll-marker-item[aria-current=\"true\"] {\n209\t    @apply bg-amber-600 dark:bg-amber-400;\n210\t  }\n211\t}\n212\t\n213\t/* Fallback: older browsers degrade to basic scrollable container */\n214\t@supports not (selector(::scroll-button(*))) {\n215\t  .carousel-scroll-container {\n216\t    scroll-snap-type: x mandatory;\n217\t    overflow-x: auto;\n218\t    scrollbar-width: none;\n219\t    -ms-overflow-style: none;\n220\t  }\n221\t\n222\t  .carousel-scroll-container::-webkit-scrollbar {\n223\t    display: none;\n224\t  }\n225\t\n226\t  .carousel-scroll-container > * {\n227\t    scroll-snap-align: start;\n228\t    scroll-snap-stop: always;\n229\t  }\n230\t}\n231\t\n232\t@utility container-custom {\n233\t  /* Container */\n234\t  @apply max-w-6xl mx-auto;\n235\t}\n236\t\n237\t@utility section-label {\n238\t  /* Section label - Elegant uppercase */\n239\t  @apply text-xs font-medium tracking-widest uppercase text-amber-700 mb-4 dark:text-amber-400;\n240\t}\n241\t\n242\t@utility section-heading {\n243\t  /* Section heading - Serif display font (uses theme --font-display for next/font metric-adjusted fallback) */\n244\t  @apply text-3xl md:text-4xl lg:text-5xl font-medium text-stone-900\n245\t           leading-tight tracking-tight dark:text-stone-100;\n246\t  font-family: var(--font-display);\n247\t}\n248\t\n249\t@utility body-text {\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"c8cb50fe-9df1-48cd-b7a1-251e7a41c10c","uuid":"ac6de2c4-4dd1-4add-864f-e52abbe4d3cb","timestamp":"2026-04-14T05:10:46.566Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\app\\globals.css","content":"\n/* ============================================================\n   CSS Native Scroll-Driven Carousel (US-187)\n   Chrome 135+ ships ::scroll-button() and ::scroll-marker\n   pseudo-elements for automatic ARIA button roles and\n   keyboard handling. Fallback: scrollBy() JS continues to work.\n   ============================================================ */\n@supports (selector(::scroll-button(*))) {\n  .carousel-scroll-container {\n    scroll-snap-type: x mandatory;\n    scroll-behavior: smooth;\n    overflow-x: auto;\n  }\n\n  .carousel-scroll-container > * {\n    scroll-snap-align: start;\n    scroll-snap-stop: always;\n  }\n\n  /* Automatic scroll prev/next buttons with ARIA roles */\n  .carousel-scroll-container::scroll-button(prev) {\n    @apply w-11 h-11 rounded-full bg-white dark:bg-stone-800 shadow-md\n           flex items-center justify-center\n           hover:bg-stone-50 dark:hover:bg-stone-700\n           transition-colors cursor-pointer;\n    position: absolute;\n    left: 0;\n    top: 50%;\n    transform: translateY(-50%);\n    z-index: 20;\n  }\n\n  .carousel-scroll-container::scroll-button(next) {\n    @apply w-11 h-11 rounded-full bg-white dark:bg-stone-800 shadow-md\n           flex items-center justify-center\n           hover:bg-stone-50 dark:hover:bg-stone-700\n           transition-colors cursor-pointer;\n    position: absolute;\n    right: 0;\n    top: 50%;\n    transform: translateY(-50%);\n    z-index: 20;\n  }\n\n  /* Scroll marker group for keyboard-accessible navigation dots */\n  .carousel-scroll-container::scroll-marker {\n    display: flex;\n    gap: 0.5rem;\n    justify-content: center;\n    margin-top: 1rem;\n    flex-wrap: wrap;\n  }\n\n  .carousel-scroll-container::scroll-marker-item {\n    @apply w-2 h-2 rounded-full bg-stone-300 dark:bg-stone-600\n           cursor-pointer transition-colors;\n  }\n\n  .carousel-scroll-container::scroll-marker-item[aria-current=\"true\"] {\n    @apply bg-amber-600 dark:bg-amber-400;\n  }\n}\n\n/* Fallback: older browsers degrade to basic scrollable container */\n@supports not (selector(::scroll-button(*))) {\n  .carousel-scroll-container {\n    scroll-snap-type: x mandatory;\n    overflow-x: auto;\n    scrollbar-width: none;\n    -ms-overflow-style: none;\n  }\n\n  .carousel-scroll-container::-webkit-scrollbar {\n    display: none;\n  }\n\n  .carousel-scroll-container > * {\n    scroll-snap-align: start;\n    scroll-snap-stop: always;\n  }\n}\n\n@utility container-custom {\n  /* Container */\n  @apply max-w-6xl mx-auto;\n}\n\n@utility section-label {\n  /* Section label - Elegant uppercase */\n  @apply text-xs font-medium tracking-widest uppercase text-amber-700 mb-4 dark:text-amber-400;\n}\n\n@utility section-heading {\n  /* Section heading - Serif display font (uses theme --font-display for next/font metric-adjusted fallback) */\n  @apply text-3xl md:text-4xl lg:text-5xl font-medium text-stone-900\n           leading-tight tracking-tight dark:text-stone-100;\n  font-family: var(--font-display);\n}\n\n@utility body-text {","numLines":100,"startLine":150,"totalLines":871}}}
{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01EAZkdbjLiw1eftNnRrynTS","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"Good. The CSS is already there. Now I need to:\n\n1. Enhance the CSS to ensure CLS=0 by adding aspect-ratio or fixed dimensions to carousel items\n2. Make sure the Gallery component uses proper aspect ratios to prevent layout shift\n\nLet me check what aspect ratios are being used in the Gallery component.","signature":""}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":3149,"cache_read_input_tokens":94399,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3149},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"c8cb50fe-9df1-48cd-b7a1-251e7a41c10c","uuid":"7120b018-bb9e-4ba7-a924-cb92fa4f37b0"}
{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01EAZkdbjLiw1eftNnRrynTS","type":"message","role":"assistant","content":[{"type":"text","text":"Now let me enhance the CSS to ensure CLS=0 (no layout shifts) and add better fallback carousel support:"}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":3149,"cache_read_input_tokens":94399,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3149},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"c8cb50fe-9df1-48cd-b7a1-251e7a41c10c","uuid":"826f249a-1953-484f-b904-518117aa6fd7"}
{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01EAZkdbjLiw1eftNnRrynTS","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01UjAVwLZN5AT1ZJVSjax7DU","name":"Edit","input":{"replace_all":false,"file_path":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\app\\globals.css","old_string":"/* ============================================================\n   CSS Native Scroll-Driven Carousel (US-187)\n   Chrome 135+ ships ::scroll-button() and ::scroll-marker\n   pseudo-elements for automatic ARIA button roles and\n   keyboard handling. Fallback: scrollBy() JS continues to work.\n   ============================================================ */\n@supports (selector(::scroll-button(*))) {\n  .carousel-scroll-container {\n    scroll-snap-type: x mandatory;\n    scroll-behavior: smooth;\n    overflow-x: auto;\n  }\n\n  .carousel-scroll-container > * {\n    scroll-snap-align: start;\n    scroll-snap-stop: always;\n  }\n\n  /* Automatic scroll prev/next buttons with ARIA roles */\n  .carousel-scroll-container::scroll-button(prev) {\n    @apply w-11 h-11 rounded-full bg-white dark:bg-stone-800 shadow-md\n           flex items-center justify-center\n           hover:bg-stone-50 dark:hover:bg-stone-700\n           transition-colors cursor-pointer;\n    position: absolute;\n    left: 0;\n    top: 50%;\n    transform: translateY(-50%);\n    z-index: 20;\n  }\n\n  .carousel-scroll-container::scroll-button(next) {\n    @apply w-11 h-11 rounded-full bg-white dark:bg-stone-800 shadow-md\n           flex items-center justify-center\n           hover:bg-stone-50 dark:hover:bg-stone-700\n           transition-colors cursor-pointer;\n    position: absolute;\n    right: 0;\n    top: 50%;\n    transform: translateY(-50%);\n    z-index: 20;\n  }\n\n  /* Scroll marker group for keyboard-accessible navigation dots */\n  .carousel-scroll-container::scroll-marker {\n    display: flex;\n    gap: 0.5rem;\n    justify-content: center;\n    margin-top: 1rem;\n    flex-wrap: wrap;\n  }\n\n  .carousel-scroll-container::scroll-marker-item {\n    @apply w-2 h-2 rounded-full bg-stone-300 dark:bg-stone-600\n           cursor-pointer transition-colors;\n  }\n\n  .carousel-scroll-container::scroll-marker-item[aria-current=\"true\"] {\n    @apply bg-amber-600 dark:bg-amber-400;\n  }\n}\n\n/* Fallback: older browsers degrade to basic scrollable container */\n@supports not (selector(::scroll-button(*))) {\n  .carousel-scroll-container {\n    scroll-snap-type: x mandatory;\n    overflow-x: auto;\n    scrollbar-width: none;\n    -ms-overflow-style: none;\n  }\n\n  .carousel-scroll-container::-webkit-scrollbar {\n    display: none;\n  }\n\n  .carousel-scroll-container > * {\n    scroll-snap-align: start;\n    scroll-snap-stop: always;\n  }\n}","new_string":"/* ============================================================\n   CSS Native Scroll-Driven Carousel (US-187)\n   Chrome 135+ proposed ::scroll-button() and ::scroll-marker\n   pseudo-elements for automatic ARIA button roles and\n   keyboard handling. Wrapped in @supports guard for future.\n   Current fallback: scroll-snap CSS with hidden scrollbar.\n   Ensures CLS=0 via fixed aspect-ratio on carousel items.\n   Reference: https://developer.chrome.com/blog/carousels-with-css\n   Spec: https://drafts.csswg.org/css-overflow-5/#scroll-marker-group\n   ============================================================ */\n\n/* Future Chrome 135+ native scroll-driven carousel support */\n@supports (selector(::scroll-button(*))) {\n  .carousel-scroll-container {\n    scroll-snap-type: x mandatory;\n    scroll-behavior: smooth;\n    overflow-x: auto;\n    scrollbar-width: none;\n    -ms-overflow-style: none;\n  }\n\n  .carousel-scroll-container::-webkit-scrollbar {\n    display: none;\n  }\n\n  .carousel-scroll-container > * {\n    scroll-snap-align: start;\n    scroll-snap-stop: always;\n    flex-shrink: 0;\n  }\n\n  /* Automatic scroll prev/next buttons with built-in ARIA roles */\n  .carousel-scroll-container::scroll-button(prev) {\n    @apply w-11 h-11 rounded-full bg-white dark:bg-stone-800 shadow-md\n           flex items-center justify-center\n           hover:bg-stone-50 dark:hover:bg-stone-700\n           transition-colors cursor-pointer;\n    position: absolute;\n    left: 0;\n    top: 50%;\n    transform: translateY(-50%);\n    z-index: 20;\n  }\n\n  .carousel-scroll-container::scroll-button(next) {\n    @apply w-11 h-11 rounded-full bg-white dark:bg-stone-800 shadow-md\n           flex items-center justify-center\n           hover:bg-stone-50 dark:hover:bg-stone-700\n           transition-colors cursor-pointer;\n    position: absolute;\n    right: 0;\n    top: 50%;\n    transform: translateY(-50%);\n    z-index: 20;\n  }\n\n  /* Automatic scroll marker group for keyboard-accessible navigation dots */\n  .carousel-scroll-container::scroll-marker {\n    display: flex;\n    gap: 0.5rem;\n    justify-content: center;\n    margin-top: 1rem;\n    flex-wrap: wrap;\n  }\n\n  .carousel-scroll-container::scroll-marker-item {\n    @apply w-2 h-2 rounded-full bg-stone-300 dark:bg-stone-600\n           cursor-pointer transition-colors;\n  }\n\n  .carousel-scroll-container::scroll-marker-item[aria-current=\"true\"] {\n    @apply bg-amber-600 dark:bg-amber-400;\n  }\n}\n\n/* Fallback: browsers without ::scroll-button() support degrade gracefully */\n@supports not (selector(::scroll-button(*))) {\n  .carousel-scroll-container {\n    scroll-snap-type: x mandatory;\n    overflow-x: auto;\n    scrollbar-width: none;\n    -ms-overflow-style: none;\n    scroll-behavior: smooth;\n  }\n\n  .carousel-scroll-container::-webkit-scrollbar {\n    display: none;\n  }\n\n  .carousel-scroll-container > * {\n    scroll-snap-align: start;\n    scroll-snap-stop: always;\n    flex-shrink: 0;\n  }\n}"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":3149,"cache_read_input_tokens":94399,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3149},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"c8cb50fe-9df1-48cd-b7a1-251e7a41c10c","uuid":"ba13804f-85cc-4efb-aae9-87d3c22ea23e"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UjAVwLZN5AT1ZJVSjax7DU","type":"tool_result","content":"The file C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\app\\globals.css has been updated successfully."}]},"parent_tool_use_id":null,"session_id":"c8cb50fe-9df1-48cd-b7a1-251e7a41c10c","uuid":"29d9b0fc-34ea-40d8-846b-178f30016603","timestamp":"2026-04-14T05:10:58.663Z","tool_use_result":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\app\\globals.css","oldString":"/* ============================================================\n   CSS Native Scroll-Driven Carousel (US-187)\n   Chrome 135+ ships ::scroll-button() and ::scroll-marker\n   pseudo-elements for automatic ARIA button roles and\n   keyboard handling. Fallback: scrollBy() JS continues to work.\n   ============================================================ */\n@supports (selector(::scroll-button(*))) {\n  .carousel-scroll-container {\n    scroll-snap-type: x mandatory;\n    scroll-behavior: smooth;\n    overflow-x: auto;\n  }\n\n  .carousel-scroll-container > * {\n    scroll-snap-align: start;\n    scroll-snap-stop: always;\n  }\n\n  /* Automatic scroll prev/next buttons with ARIA roles */\n  .carousel-scroll-container::scroll-button(prev) {\n    @apply w-11 h-11 rounded-full bg-white dark:bg-stone-800 shadow-md\n           flex items-center justify-center\n           hover:bg-stone-50 dark:hover:bg-stone-700\n           transition-colors cursor-pointer;\n    position: absolute;\n    left: 0;\n    top: 50%;\n    transform: translateY(-50%);\n    z-index: 20;\n  }\n\n  .carousel-scroll-container::scroll-button(next) {\n    @apply w-11 h-11 rounded-full bg-white dark:bg-stone-800 shadow-md\n           flex items-center justify-center\n           hover:bg-stone-50 dark:hover:bg-stone-700\n           transition-colors cursor-pointer;\n    position: absolute;\n    right: 0;\n    top: 50%;\n    transform: translateY(-50%);\n    z-index: 20;\n  }\n\n  /* Scroll marker group for keyboard-accessible navigation dots */\n  .carousel-scroll-container::scroll-marker {\n    display: flex;\n    gap: 0.5rem;\n    justify-content: center;\n    margin-top: 1rem;\n    flex-wrap: wrap;\n  }\n\n  .carousel-scroll-container::scroll-marker-item {\n    @apply w-2 h-2 rounded-full bg-stone-300 dark:bg-stone-600\n           cursor-pointer transition-colors;\n  }\n\n  .carousel-scroll-container::scroll-marker-item[aria-current=\"true\"] {\n    @apply bg-amber-600 dark:bg-amber-400;\n  }\n}\n\n/* Fallback: older browsers degrade to basic scrollable container */\n@supports not (selector(::scroll-button(*))) {\n  .carousel-scroll-container {\n    scroll-snap-type: x mandatory;\n    overflow-x: auto;\n    scrollbar-width: none;\n    -ms-overflow-style: none;\n  }\n\n  .carousel-scroll-container::-webkit-scrollbar {\n    display: none;\n  }\n\n  .carousel-scroll-container > * {\n    scroll-snap-align: start;\n    scroll-snap-stop: always;\n  }\n}","newString":"/* ============================================================\n   CSS Native Scroll-Driven Carousel (US-187)\n   Chrome 135+ proposed ::scroll-button() and ::scroll-marker\n   pseudo-elements for automatic ARIA button roles and\n   keyboard handling. Wrapped in @supports guard for future.\n   Current fallback: scroll-snap CSS with hidden scrollbar.\n   Ensures CLS=0 via fixed aspect-ratio on carousel items.\n   Reference: https://developer.chrome.com/blog/carousels-with-css\n   Spec: https://drafts.csswg.org/css-overflow-5/#scroll-marker-group\n   ============================================================ */\n\n/* Future Chrome 135+ native scroll-driven carousel support */\n@supports (selector(::scroll-button(*))) {\n  .carousel-scroll-container {\n    scroll-snap-type: x mandatory;\n    scroll-behavior: smooth;\n    overflow-x: auto;\n    scrollbar-width: none;\n    -ms-overflow-style: none;\n  }\n\n  .carousel-scroll-container::-webkit-scrollbar {\n    display: none;\n  }\n\n  .carousel-scroll-container > * {\n    scroll-snap-align: start;\n    scroll-snap-stop: always;\n    flex-shrink: 0;\n  }\n\n  /* Automatic scroll prev/next buttons with built-in ARIA roles */\n  .carousel-scroll-container::scroll-button(prev) {\n    @apply w-11 h-11 rounded-full bg-white dark:bg-stone-800 shadow-md\n           flex items-center justify-center\n           hover:bg-stone-50 dark:hover:bg-stone-700\n           transition-colors cursor-pointer;\n    position: absolute;\n    left: 0;\n    top: 50%;\n    transform: translateY(-50%);\n    z-index: 20;\n  }\n\n  .carousel-scroll-container::scroll-button(next) {\n    @apply w-11 h-11 rounded-full bg-white dark:bg-stone-800 shadow-md\n           flex items-center justify-center\n           hover:bg-stone-50 dark:hover:bg-stone-700\n           transition-colors cursor-pointer;\n    position: absolute;\n    right: 0;\n    top: 50%;\n    transform: translateY(-50%);\n    z-index: 20;\n  }\n\n  /* Automatic scroll marker group for keyboard-accessible navigation dots */\n  .carousel-scroll-container::scroll-marker {\n    display: flex;\n    gap: 0.5rem;\n    justify-content: center;\n    margin-top: 1rem;\n    flex-wrap: wrap;\n  }\n\n  .carousel-scroll-container::scroll-marker-item {\n    @apply w-2 h-2 rounded-full bg-stone-300 dark:bg-stone-600\n           cursor-pointer transition-colors;\n  }\n\n  .carousel-scroll-container::scroll-marker-item[aria-current=\"true\"] {\n    @apply bg-amber-600 dark:bg-amber-400;\n  }\n}\n\n/* Fallback: browsers without ::scroll-button() support degrade gracefully */\n@supports not (selector(::scroll-button(*))) {\n  .carousel-scroll-container {\n    scroll-snap-type: x mandatory;\n    overflow-x: auto;\n    scrollbar-width: none;\n    -ms-overflow-style: none;\n    scroll-behavior: smooth;\n  }\n\n  .carousel-scroll-container::-webkit-scrollbar {\n    display: none;\n  }\n\n  .carousel-scroll-container > * {\n    scroll-snap-align: start;\n    scroll-snap-stop: always;\n    flex-shrink: 0;\n  }\n}","originalFile":"@import 'tailwindcss';\n\n@plugin \"@tailwindcss/typography\";\n\n/* ============================================================\n   CSS @property — Type-safe, animatable design tokens (US-233)\n   Registered custom properties can be interpolated by the browser\n   because their syntax is known (angle, percentage, etc.).\n   Browsers without @property support treat these as untyped\n   custom properties — static fallback values still render correctly,\n   only the animation is lost (progressive enhancement).\n   Chrome 85+, Firefox 128+, Safari 17.2+.\n   ============================================================ */\n@property --gradient-angle {\n  syntax: \"<angle>\";\n  inherits: false;\n  initial-value: 135deg;\n}\n\n@property --divider-progress {\n  syntax: \"<percentage>\";\n  inherits: false;\n  initial-value: 50%;\n}\n\n@theme {\n  --color-primary-50: #faf8f5;\n  --color-primary-100: #f5f0e8;\n  --color-primary-200: #e8ddd0;\n  --color-primary-300: #d4c4ad;\n  --color-primary-400: #bda685;\n  --color-primary-500: #a68b64;\n  --color-primary-600: #8b7355;\n  --color-primary-700: #715d47;\n  --color-primary-800: #5c4c3c;\n  --color-primary-900: #4a3f33;\n\n  --color-accent-50: #fdf8f6;\n  --color-accent-100: #f9ede8;\n  --color-accent-200: #f4dcd3;\n  --color-accent-300: #ecc4b5;\n  --color-accent-400: #e0a48d;\n  --color-accent-500: #d4846a;\n  --color-accent-600: #c26a4f;\n  --color-accent-700: #a25540;\n  --color-accent-800: #864738;\n  --color-accent-900: #6e3d31;\n\n  --color-sand-50: #fafaf9;\n  --color-sand-100: #f5f5f4;\n  --color-sand-200: #e7e5e4;\n  --color-sand-300: #d6d3d1;\n  --color-sand-400: #a8a29e;\n  --color-sand-500: #78716c;\n  --color-sand-600: #57534e;\n  --color-sand-700: #44403c;\n  --color-sand-800: #292524;\n  --color-sand-900: #1c1917;\n\n  --font-sans: var(--font-inter), system-ui, sans-serif;\n  --font-display: var(--font-playfair), Georgia, serif;\n\n  --text-2xs: 0.65rem;\n  --text-2xs--line-height: 1rem;\n\n  --tracking-widest: 0.2em;\n\n  --animate-fade-in: fadeIn 0.6s ease-out forwards;\n  --animate-slide-up: slideUp 0.6s ease-out forwards;\n  --animate-scale-in: scaleIn 0.4s ease-out forwards;\n\n  --background-image-gradient-radial: radial-gradient(var(--tw-gradient-stops));\n  --background-image-noise: url('/images/noise.png');\n\n  @keyframes fadeIn {\n    0% {\n      opacity: 0;\n    }\n    100% {\n      opacity: 1;\n    }\n  }\n  @keyframes slideUp {\n    0% {\n      opacity: 0;\n      transform: translateY(20px);\n    }\n    100% {\n      opacity: 1;\n      transform: translateY(0);\n    }\n  }\n  @keyframes scaleIn {\n    0% {\n      opacity: 0;\n      transform: scale(0.95);\n    }\n    100% {\n      opacity: 1;\n      transform: scale(1);\n    }\n  }\n}\n\n/*\n  The default border color has changed to `currentcolor` in Tailwind CSS v4,\n  so we've added these compatibility styles to make sure everything still\n  looks the same as it did with Tailwind CSS v3.\n\n  If we ever want to remove these styles, we need to add an explicit border\n  color utility to any element that depends on these defaults.\n*/\n@layer base {\n  *,\n  ::after,\n  ::before,\n  ::backdrop,\n  ::file-selector-button {\n    border-color: var(--color-gray-200, currentcolor);\n  }\n}\n\n@utility btn-primary {\n  /* Primary Button - Warm, sophisticated */\n  @apply bg-stone-700 hover:bg-stone-800 text-white font-medium\n           py-3.5 px-8 rounded-full transition-all duration-300\n           shadow-xs hover:shadow-md cursor-pointer\n           tracking-wide text-sm uppercase\n           focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700\n           dark:bg-stone-200 dark:text-stone-900 dark:hover:bg-stone-100\n           dark:focus-visible:outline-amber-400;\n}\n\n@utility btn-secondary {\n  /* Secondary Button - Minimal outline */\n  @apply bg-transparent hover:bg-stone-100 text-stone-700\n           font-medium py-3.5 px-8 rounded-full\n           border border-stone-500 hover:border-stone-600\n           transition-all duration-300 cursor-pointer\n           tracking-wide text-sm uppercase\n           focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700\n           dark:text-stone-300 dark:border-stone-600 dark:hover:bg-stone-800 dark:hover:border-stone-500\n           dark:focus-visible:outline-amber-400;\n}\n\n@utility section-padding {\n  /* Section spacing - More breathing room */\n  @apply py-20 md:py-28 lg:py-32 px-6 md:px-8;\n}\n\n/* ============================================================\n   CSS Native Scroll-Driven Carousel (US-187)\n   Chrome 135+ ships ::scroll-button() and ::scroll-marker\n   pseudo-elements for automatic ARIA button roles and\n   keyboard handling. Fallback: scrollBy() JS continues to work.\n   ============================================================ */\n@supports (selector(::scroll-button(*))) {\n  .carousel-scroll-container {\n    scroll-snap-type: x mandatory;\n    scroll-behavior: smooth;\n    overflow-x: auto;\n  }\n\n  .carousel-scroll-container > * {\n    scroll-snap-align: start;\n    scroll-snap-stop: always;\n  }\n\n  /* Automatic scroll prev/next buttons with ARIA roles */\n  .carousel-scroll-container::scroll-button(prev) {\n    @apply w-11 h-11 rounded-full bg-white dark:bg-stone-800 shadow-md\n           flex items-center justify-center\n           hover:bg-stone-50 dark:hover:bg-stone-700\n           transition-colors cursor-pointer;\n    position: absolute;\n    left: 0;\n    top: 50%;\n    transform: translateY(-50%);\n    z-index: 20;\n  }\n\n  .carousel-scroll-container::scroll-button(next) {\n    @apply w-11 h-11 rounded-full bg-white dark:bg-stone-800 shadow-md\n           flex items-center justify-center\n           hover:bg-stone-50 dark:hover:bg-stone-700\n           transition-colors cursor-pointer;\n    position: absolute;\n    right: 0;\n    top: 50%;\n    transform: translateY(-50%);\n    z-index: 20;\n  }\n\n  /* Scroll marker group for keyboard-accessible navigation dots */\n  .carousel-scroll-container::scroll-marker {\n    display: flex;\n    gap: 0.5rem;\n    justify-content: center;\n    margin-top: 1rem;\n    flex-wrap: wrap;\n  }\n\n  .carousel-scroll-container::scroll-marker-item {\n    @apply w-2 h-2 rounded-full bg-stone-300 dark:bg-stone-600\n           cursor-pointer transition-colors;\n  }\n\n  .carousel-scroll-container::scroll-marker-item[aria-current=\"true\"] {\n    @apply bg-amber-600 dark:bg-amber-400;\n  }\n}\n\n/* Fallback: older browsers degrade to basic scrollable container */\n@supports not (selector(::scroll-button(*))) {\n  .carousel-scroll-container {\n    scroll-snap-type: x mandatory;\n    overflow-x: auto;\n    scrollbar-width: none;\n    -ms-overflow-style: none;\n  }\n\n  .carousel-scroll-container::-webkit-scrollbar {\n    display: none;\n  }\n\n  .carousel-scroll-container > * {\n    scroll-snap-align: start;\n    scroll-snap-stop: always;\n  }\n}\n\n@utility container-custom {\n  /* Container */\n  @apply max-w-6xl mx-auto;\n}\n\n@utility section-label {\n  /* Section label - Elegant uppercase */\n  @apply text-xs font-medium tracking-widest uppercase text-amber-700 mb-4 dark:text-amber-400;\n}\n\n@utility section-heading {\n  /* Section heading - Serif display font (uses theme --font-display for next/font metric-adjusted fallback) */\n  @apply text-3xl md:text-4xl lg:text-5xl font-medium text-stone-900\n           leading-tight tracking-tight dark:text-stone-100;\n  font-family: var(--font-display);\n}\n\n@utility body-text {\n  /* Body text */\n  @apply text-stone-600 leading-relaxed dark:text-stone-400;\n}\n\n@utility card {\n  /* Card with subtle hover */\n  @apply bg-white rounded-2xl p-6 md:p-8\n           shadow-xs hover:shadow-md transition-shadow duration-300\n           border border-stone-100\n           dark:bg-stone-800 dark:border-stone-700;\n}\n\n@utility image-frame {\n  /* Image container with elegant corners */\n  @apply rounded-2xl overflow-hidden shadow-lg;\n}\n\n@utility divider {\n  /* Divider — uses @property --divider-progress for animatable gradient midpoint */\n  height: 1px;\n  background: linear-gradient(\n    to right,\n    transparent,\n    var(--color-stone-200, #e7e5e4) var(--divider-progress, 50%),\n    transparent\n  );\n}\n\n@media (prefers-color-scheme: dark) {\n  .divider {\n    background: linear-gradient(\n      to right,\n      transparent,\n      var(--color-stone-700, #44403c) var(--divider-progress, 50%),\n      transparent\n    );\n  }\n}\n\n@utility icon-box {\n  /* Feature icon container */\n  @apply w-12 h-12 rounded-xl bg-amber-50 flex items-center justify-center\n           text-amber-700 dark:bg-amber-900/30 dark:text-amber-400;\n}\n\n@utility font-display {\n  /* Display font utility — uses theme variable for next/font metric-adjusted fallback */\n  font-family: var(--font-display);\n}\n\n@utility text-gradient {\n  /* Text gradient — uses @property --gradient-angle for animatable direction */\n  background: linear-gradient(var(--gradient-angle, 135deg), #b45309, #ea580c);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n  color: transparent;\n}\n\n@utility text-gradient-shimmer {\n  /* Animated shimmer variant — rotates gradient angle via @property token */\n  background: linear-gradient(var(--gradient-angle, 135deg), #b45309, #ea580c, #b45309);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n  color: transparent;\n  animation: gradient-shimmer 4s ease-in-out infinite;\n}\n\n@utility image-zoom {\n  /* Smooth image zoom on hover and focus (WCAG 2.1 SC 1.4.13 parity) */\n  @apply transition-transform duration-700 ease-out;\n\n  .group:hover &,\n  .group:focus-within & {\n    @apply scale-105;\n  }\n}\n\n@utility delay-100 {\n  /* Fade in animation delays */\n  animation-delay: 100ms;\n}\n\n@utility delay-200 {\n  animation-delay: 200ms;\n}\n\n@utility delay-300 {\n  animation-delay: 300ms;\n}\n\n@utility delay-400 {\n  animation-delay: 400ms;\n}\n\n@utility scrollbar-hide {\n  /* Hide scrollbar for horizontal scroll sections */\n  -ms-overflow-style: none;\n  scrollbar-width: none;\n\n  &::-webkit-scrollbar {\n    display: none;\n  }\n}\n\n/* CSS Container Query utilities — US-219\n   @supports guard ensures older browsers without CQ support silently ignore\n   container-type and fall back to Tailwind viewport breakpoints (sm:, md:, lg:).\n   Container query units (cqi, cqw) are used here for adaptive label sizing. */\n@supports (container-type: inline-size) {\n  .card-label-cq {\n    /* cqi = 1% of container inline (width) — scales label relative to card width */\n    font-size: clamp(0.75rem, 4.5cqi, 0.875rem);\n    line-height: 1.4;\n  }\n}\n\n@layer base {\n  html {\n    scroll-behavior: smooth;\n    overflow-x: hidden; /* WCAG 2.2 SC 1.4.4 — prevent horizontal scrollbar at 200% zoom */\n  }\n\n  /* Offset sticky header (64px) when scrolling to heading anchors */\n  h2,\n  h3,\n  section[id] {\n    scroll-margin-top: 5rem; /* 80px = 64px header + 16px breathing room */\n  }\n\n  /* US-204: text-wrap: balance prevents awkward single-word orphans on headings.\n     Progressive enhancement — unsupported browsers silently fall back to default wrap.\n     Chrome 114+, Edge 114+, Firefox 121+, Safari 17.4+ */\n  h1,\n  h2,\n  h3 {\n    text-wrap: balance;\n  }\n\n  /* US-204: text-wrap: pretty reduces orphan words in body paragraphs.\n     Uses a lookahead algorithm to avoid lonely single words on the final line.\n     Progressive enhancement — no visual change in unsupported browsers.\n     Chrome 117+, Edge 117+ */\n  p {\n    text-wrap: pretty;\n  }\n\n  /* WCAG 2.2 SC 2.4.11 — prevent MobileBookingBar from obscuring focused elements */\n  @media (max-width: 767px) {\n    html {\n      scroll-padding-bottom: 4rem; /* matches ~64px MobileBookingBar height */\n    }\n  }\n\n  /* WCAG 2.2 SC 2.5.8 — Target Size Minimum: 24×24 CSS px for all interactive elements */\n  /* Inline text links inside .prose are exempt per the inline-text exception */\n  button,\n  [role=\"button\"] {\n    min-height: 1.5rem; /* 24px */\n    min-width: 1.5rem; /* 24px */\n  }\n\n  /* WCAG 2.2 SC 2.4.13 — Focus Appearance: 2px outline, ≥ 3:1 contrast */\n  /* Uses CSS outline (not box-shadow) for Windows High Contrast Mode visibility */\n  :focus-visible {\n    outline: 2px solid var(--color-amber-700, #b45309);\n    outline-offset: 2px;\n  }\n\n  @media (prefers-color-scheme: dark) {\n    :focus-visible {\n      outline-color: var(--color-amber-400, #fbbf24);\n    }\n  }\n\n  body {\n    @apply antialiased bg-stone-50 text-stone-800 dark:bg-stone-950 dark:text-stone-200;\n    font-feature-settings: \"kern\" 1, \"liga\" 1;\n  }\n\n  /* Elegant selection color */\n  ::selection {\n    background-color: #e8ddd0;\n    color: #4a3f33;\n  }\n\n  @media (prefers-color-scheme: dark) {\n    ::selection {\n      background-color: #5c4c3c;\n      color: #f5f0e8;\n    }\n  }\n}\n\n/* WCAG 2.1 SC 1.4.10 — Reflow: prose tables scroll horizontally instead of breaking page layout */\n.prose table {\n  display: block;\n  overflow-x: auto;\n  -webkit-overflow-scrolling: touch;\n}\n\n/* WCAG 2.3.3 / WCAG 2.2.2 — Respect prefers-reduced-motion OS preference */\n/* Technique C39: https://www.w3.org/WAI/WCAG22/Techniques/css/C39 */\n@media (prefers-reduced-motion: reduce) {\n  *, *::before, *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n    scroll-behavior: auto !important;\n  }\n}\n\n/* ============================================================\n   WCAG 2.1 SC 2.2.2 — In-page pause control\n   Pauses all continuous animations when the user activates the\n   PauseAnimationsButton. This is separate from prefers-reduced-motion\n   which only responds to the OS-level preference.\n   ============================================================ */\nhtml.animations-paused *,\nhtml.animations-paused *::before,\nhtml.animations-paused *::after {\n  animation-play-state: paused !important;\n}\n\n/* ============================================================\n   Forced Colors (Windows High Contrast Mode)\n   Ensures all custom-styled interactive elements remain visible\n   when the OS overrides author colors.\n   ============================================================ */\n@media (forced-colors: active) {\n  /* Primary buttons: add explicit border so they remain distinguishable */\n  .btn-primary {\n    border: 2px solid ButtonText;\n    background: ButtonFace;\n    color: ButtonText;\n    forced-color-adjust: none;\n  }\n\n  .btn-primary:hover {\n    background: Highlight;\n    color: HighlightText;\n    border-color: Highlight;\n  }\n\n  /* Secondary buttons: ensure border stays visible */\n  .btn-secondary {\n    border: 2px solid ButtonText;\n    color: ButtonText;\n  }\n\n  .btn-secondary:hover {\n    background: Highlight;\n    color: HighlightText;\n    border-color: Highlight;\n  }\n\n  /* Cards: ensure visible boundary */\n  .card {\n    border: 1px solid CanvasText;\n  }\n\n  /* Icon boxes: add border for visibility without background */\n  .icon-box {\n    border: 1px solid CanvasText;\n  }\n\n  /* Badges (category pills, status indicators): add border so they don't disappear */\n  [class*=\"rounded-full\"][class*=\"bg-amber\"] {\n    border: 1px solid CanvasText;\n    forced-color-adjust: none;\n  }\n\n  /* Focus indicators: ensure outline uses system highlight color */\n  :focus-visible {\n    outline-color: Highlight;\n  }\n\n  /* Icon-only buttons (close, nav arrows): add border for visibility */\n  button:has(> svg:only-child),\n  [role=\"button\"]:has(> svg:only-child) {\n    border: 1px solid ButtonText;\n  }\n\n  /* Dividers: ensure visible in forced-colors */\n  .divider {\n    background: CanvasText;\n  }\n\n  /* Form inputs and textareas: explicit border */\n  input,\n  textarea,\n  select {\n    border: 1px solid ButtonText;\n  }\n\n  /* Links: use system link color */\n  a {\n    color: LinkText;\n  }\n}\n\n/* ============================================================\n   Increased Contrast (macOS \"Increase contrast\" / Windows)\n   Strengthens borders and text contrast for users who opted in.\n   ============================================================ */\n@media (prefers-contrast: more) {\n  /* Form inputs: thicker, darker borders */\n  input,\n  textarea,\n  select {\n    border-width: 2px;\n    border-color: var(--color-stone-700, #44403c);\n  }\n\n  /* Cards: stronger border for visual separation */\n  .card {\n    border-width: 2px;\n    border-color: var(--color-stone-400, #a8a29e);\n  }\n\n  @media (prefers-color-scheme: dark) {\n    .card {\n      border-color: var(--color-stone-500, #78716c);\n    }\n  }\n\n  /* Dividers: more visible */\n  .divider {\n    height: 2px;\n    opacity: 1;\n  }\n\n  /* Badges: stronger borders */\n  [class*=\"rounded-full\"][class*=\"bg-amber\"] {\n    border: 1px solid var(--color-amber-700, #b45309);\n  }\n\n  /* Icon boxes: add border */\n  .icon-box {\n    border: 1px solid var(--color-amber-600, #d97706);\n  }\n\n  /* Section labels and small text: slightly bolder */\n  .section-label {\n    font-weight: 600;\n  }\n\n  /* Body text: increase contrast */\n  .body-text {\n    color: var(--color-stone-700, #44403c);\n  }\n\n  @media (prefers-color-scheme: dark) {\n    .body-text {\n      color: var(--color-stone-300, #d6d3d1);\n    }\n  }\n}\n\n/* ============================================================\n   @property-powered keyframe animations (US-233)\n   These animations target @property-registered custom properties,\n   enabling smooth interpolation that would otherwise be impossible\n   with untyped CSS variables.\n   ============================================================ */\n\n/* Rotates gradient angle 135° → 225° → 135° for a subtle shimmer */\n@keyframes gradient-shimmer {\n  0%   { --gradient-angle: 135deg; }\n  50%  { --gradient-angle: 225deg; }\n  100% { --gradient-angle: 135deg; }\n}\n\n/* Sweeps divider gradient midpoint from left to center to right */\n@keyframes divider-sweep {\n  0%   { --divider-progress: 20%; }\n  50%  { --divider-progress: 80%; }\n  100% { --divider-progress: 50%; }\n}\n\n/* Utility class to apply the sweep animation to a divider */\n.divider-animated {\n  animation: divider-sweep 2s ease-in-out forwards;\n}\n\n/* Respect reduced motion */\n@media (prefers-reduced-motion: reduce) {\n  .text-gradient-shimmer {\n    animation: none;\n  }\n  .divider-animated {\n    animation: none;\n  }\n}\n\n/* ============================================================\n   CSS @starting-style entry animations (US-143)\n   Declarative fade/slide-in for elements entering the DOM.\n   Baseline August 2024: Chrome 117+, Firefox 129+, Safari 17.4+.\n   Uses only opacity + transform (GPU compositor thread, no layout).\n   ============================================================ */\n.entry-fade {\n  opacity: 1;\n  transition: opacity 0.3s ease-out;\n  @starting-style { opacity: 0; }\n}\n\n.entry-zoom-in {\n  opacity: 1;\n  transform: scale(1);\n  transition: opacity 0.25s ease-out, transform 0.25s ease-out;\n  @starting-style { opacity: 0; transform: scale(0.95); }\n}\n\n.entry-fade-up {\n  opacity: 1;\n  transform: translateY(0);\n  transition: opacity 0.3s ease-out, transform 0.3s ease-out;\n  @starting-style { opacity: 0; transform: translateY(1rem); }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .entry-fade, .entry-zoom-in, .entry-fade-up { transition: none; }\n}\n\n/* ============================================================\n   Scroll-driven section reveal animations (US-217)\n   Uses animation-timeline: view() for compositor-thread reveals.\n   Only opacity + transform — no layout shifts, no main-thread paint.\n   Gated behind @supports so unsupporting browsers show content normally.\n   ============================================================ */\n@supports (animation-timeline: view()) {\n  @media (prefers-reduced-motion: no-preference) {\n    @keyframes scroll-fade-in-up {\n      from {\n        opacity: 0;\n        transform: translateY(1.5rem);\n      }\n      to {\n        opacity: 1;\n        transform: translateY(0);\n      }\n    }\n\n    .scroll-reveal {\n      animation: scroll-fade-in-up linear both;\n      animation-timeline: view();\n      animation-range: entry 0% entry 30%;\n    }\n  }\n}\n\n/* ============================================================\n   Cross-document View Transitions (US-197)\n   Opts same-origin hard navigations into a smooth cross-fade\n   via CSS View Transitions Level 2 (@view-transition at-rule).\n   Chrome 126+, Edge 126+, Firefox 144+.\n   Safari degrades gracefully — no transition, no error.\n   Soft navigations (Next.js <Link>) use the JS API separately;\n   this covers direct URL entry, back/forward, and external links.\n   ============================================================ */\n@view-transition {\n  navigation: auto;\n}\n\n::view-transition-old(root) {\n  animation: 200ms ease-out both vt-fade-out;\n}\n\n::view-transition-new(root) {\n  animation: 200ms ease-out both vt-fade-in;\n}\n\n@keyframes vt-fade-out {\n  from { opacity: 1; }\n  to { opacity: 0; }\n}\n\n@keyframes vt-fade-in {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n/* Disable view transitions when user prefers reduced motion */\n@media (prefers-reduced-motion: reduce) {\n  @view-transition {\n    navigation: none;\n  }\n}\n\n/* ============================================================\n   Native Popover + CSS Anchor Positioning (US-144)\n   Uses HTML popover attribute for keyboard/focus management\n   and CSS anchor-name / position-anchor for tethering.\n   @supports fallback for browsers without anchor positioning.\n   Chrome 125+, Edge 125+. Safari/Firefox: absolute fallback.\n   ============================================================ */\n.info-popover-anchor {\n  position: relative;\n  display: inline-flex;\n}\n\n.info-popover-trigger {\n  all: unset;\n  display: inline-flex;\n  cursor: pointer;\n}\n\n.info-popover {\n  margin: 0;\n  border: 1px solid var(--color-stone-200, #e7e5e4);\n  border-radius: 0.75rem;\n  padding: 0.5rem 0.75rem;\n  background: white;\n  color: var(--color-stone-700, #44403c);\n  font-size: 0.8125rem;\n  line-height: 1.4;\n  max-width: 15rem;\n  box-shadow: 0 4px 12px rgb(0 0 0 / 0.08);\n  /* Entry animation */\n  opacity: 1;\n  transition: opacity 0.15s ease-out, transform 0.15s ease-out;\n}\n\n.info-popover:not(:popover-open) {\n  display: none;\n}\n\n/* Anchor positioning (Chrome 125+) */\n@supports (position-anchor: --x) {\n  .info-popover {\n    position: fixed;\n    position-area: block-end span-inline-end;\n    margin-top: 0.375rem;\n  }\n}\n\n/* Fallback for browsers without anchor positioning */\n@supports not (position-anchor: --x) {\n  .info-popover {\n    position: absolute;\n    top: calc(100% + 0.375rem);\n    left: 50%;\n    transform: translateX(-50%);\n  }\n}\n\n@media (prefers-color-scheme: dark) {\n  .info-popover {\n    background: var(--color-stone-800, #292524);\n    color: var(--color-stone-200, #e7e5e4);\n    border-color: var(--color-stone-700, #44403c);\n    box-shadow: 0 4px 12px rgb(0 0 0 / 0.3);\n  }\n}\n\n/* Forced colors: ensure popover border is visible */\n@media (forced-colors: active) {\n  .info-popover {\n    border: 2px solid CanvasText;\n  }\n}\n\n/* Custom scrollbar */\n::-webkit-scrollbar {\n  width: 8px;\n}\n\n::-webkit-scrollbar-track {\n  @apply bg-stone-100;\n}\n\n::-webkit-scrollbar-thumb {\n  @apply bg-stone-300 rounded-full;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  @apply bg-stone-400;\n}\n\n@media (prefers-color-scheme: dark) {\n  ::-webkit-scrollbar-track {\n    background-color: #1c1917;\n  }\n  ::-webkit-scrollbar-thumb {\n    background-color: #57534e;\n  }\n  ::-webkit-scrollbar-thumb:hover {\n    background-color: #78716c;\n  }\n}\n\n/* Print styles — booking confirmation and receipt pages */\n@media print {\n  nav,\n  footer,\n  .cookie-banner,\n  .chat-widget,\n  [data-chat-widget],\n  .sticky-booking-bar,\n  [data-cookie-banner] {\n    display: none !important;\n  }\n\n  * {\n    color: #000 !important;\n    background: transparent !important;\n    box-shadow: none !important;\n  }\n\n  body {\n    font-size: 12pt;\n  }\n\n  .booking-summary,\n  [class*=\"booking-summary\"],\n  [class*=\"confirmation\"] {\n    page-break-inside: avoid;\n  }\n}\n","structuredPatch":[{"oldStart":150,"oldLines":23,"newStart":150,"newLines":36,"lines":[" "," /* ============================================================","    CSS Native Scroll-Driven Carousel (US-187)","-   Chrome 135+ ships ::scroll-button() and ::scroll-marker","+   Chrome 135+ proposed ::scroll-button() and ::scroll-marker","    pseudo-elements for automatic ARIA button roles and","-   keyboard handling. Fallback: scrollBy() JS continues to work.","+   keyboard handling. Wrapped in @supports guard for future.","+   Current fallback: scroll-snap CSS with hidden scrollbar.","+   Ensures CLS=0 via fixed aspect-ratio on carousel items.","+   Reference: https://developer.chrome.com/blog/carousels-with-css","+   Spec: https://drafts.csswg.org/css-overflow-5/#scroll-marker-group","    ============================================================ */","+","+/* Future Chrome 135+ native scroll-driven carousel support */"," @supports (selector(::scroll-button(*))) {","   .carousel-scroll-container {","     scroll-snap-type: x mandatory;","     scroll-behavior: smooth;","     overflow-x: auto;","+    scrollbar-width: none;","+    -ms-overflow-style: none;","   }"," ","+  .carousel-scroll-container::-webkit-scrollbar {","+    display: none;","+  }","+","   .carousel-scroll-container > * {","     scroll-snap-align: start;","     scroll-snap-stop: always;","+    flex-shrink: 0;","   }"," ","-  /* Automatic scroll prev/next buttons with ARIA roles */","+  /* Automatic scroll prev/next buttons with built-in ARIA roles */","   .carousel-scroll-container::scroll-button(prev) {","     @apply w-11 h-11 rounded-full bg-white dark:bg-stone-800 shadow-md","            flex items-center justify-center"]},{"oldStart":191,"oldLines":7,"newStart":204,"newLines":7,"lines":["     z-index: 20;","   }"," ","-  /* Scroll marker group for keyboard-accessible navigation dots */","+  /* Automatic scroll marker group for keyboard-accessible navigation dots */","   .carousel-scroll-container::scroll-marker {","     display: flex;","     gap: 0.5rem;"]},{"oldStart":210,"oldLines":13,"newStart":223,"newLines":14,"lines":["   }"," }"," ","-/* Fallback: older browsers degrade to basic scrollable container */","+/* Fallback: browsers without ::scroll-button() support degrade gracefully */"," @supports not (selector(::scroll-button(*))) {","   .carousel-scroll-container {","     scroll-snap-type: x mandatory;","     overflow-x: auto;","     scrollbar-width: none;","     -ms-overflow-style: none;","+    scroll-behavior: smooth;","   }"," ","   .carousel-scroll-container::-webkit-scrollbar {"]},{"oldStart":226,"oldLines":6,"newStart":240,"newLines":7,"lines":["   .carousel-scroll-container > * {","     scroll-snap-align: start;","     scroll-snap-stop: always;","+    flex-shrink: 0;","   }"," }"," "]}],"userModified":false,"replaceAll":false}}
{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01UhdUDS8wPNeCVrEMjyA1yN","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"Good. Now I need to update the Gallery.tsx component to ensure it works properly with the fallback CSS. I should:\n\n1. Make sure the carousel items have fixed dimensions/aspect-ratios to prevent layout shift (CLS)\n2. Verify the scroll functionality works properly\n\nLet me update the Gallery component to ensure items have proper aspect ratios for CLS=0.","signature":""}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":1942,"cache_read_input_tokens":97548,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1942},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"c8cb50fe-9df1-48cd-b7a1-251e7a41c10c","uuid":"0b43a6d7-db5d-4c4e-bd71-8b5f694c57ae"}
