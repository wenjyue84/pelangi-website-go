{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01E3ZM17ywhT4NsZEzx8exd1","type":"tool_result","content":"1\t/**\n2\t * Vercel Feature Flags and flag resolution logic.\n3\t * Defines flag types and server-side flag reading from Edge Config.\n4\t * For local dev, falls back to mock flags from environment variables.\n5\t */\n6\t\n7\texport type CTAVariant = \"book-now\" | \"check-availability\" | \"best-price-direct\";\n8\t\n9\texport interface FlagsConfig {\n10\t  \"cta-variant\": CTAVariant;\n11\t}\n12\t\n13\t// Default flags for local development / fallback\n14\tconst DEFAULT_FLAGS: FlagsConfig = {\n15\t  \"cta-variant\": \"book-now\",\n16\t};\n17\t\n18\t// Mock flag values from environment\n19\tconst MOCK_FLAGS: Partial<FlagsConfig> = {\n20\t  \"cta-variant\":\n21\t    (process.env.NEXT_PUBLIC_FLAG_CTA_VARIANT as CTAVariant) ?? \"book-now\",\n22\t};\n23\t\n24\t/**\n25\t * Get a flag value from Edge Config (production) or mock (local dev).\n26\t * In production, reads from Vercel Edge Config.\n27\t * In development, uses mock values from environment variables.\n28\t *\n29\t * @param key - The flag key (e.g., 'cta-variant')\n30\t * @param defaultValue - Fallback value if flag is not found\n31\t * @returns The flag value\n32\t */\n33\texport async function getFlag<K extends keyof FlagsConfig>(\n34\t  key: K,\n35\t  defaultValue?: FlagsConfig[K]\n36\t): Promise<FlagsConfig[K]> {\n37\t  try {\n38\t    // In production with Vercel Edge Config, import and use @vercel/edge-config\n39\t    // For now, use mock values that respect environment overrides\n40\t    const mockValue = MOCK_FLAGS[key];\n41\t    if (mockValue !== undefined) {\n42\t      return mockValue as FlagsConfig[K];\n43\t    }\n44\t\n45\t    // Fall back to defaults\n46\t    return defaultValue ?? DEFAULT_FLAGS[key];\n47\t  } catch (error) {\n48\t    console.error(`[flags] Error reading flag '${key}':`, error);\n49\t    return defaultValue ?? DEFAULT_FLAGS[key];\n50\t  }\n51\t}\n52\t\n53\t/**\n54\t * Get a variant for a specific A/B test from the flag value.\n55\t * Deterministically assigns variants based on flag configuration\n56\t * and optional user identifier for consistent variants within a session.\n57\t *\n58\t * @param sessionId - Optional session ID for deterministic variant assignment\n59\t * @returns The assigned variant\n60\t */\n61\texport async function getVariant(\n62\t  sessionId?: string\n63\t): Promise<CTAVariant> {\n64\t  const variant = await getFlag(\"cta-variant\");\n65\t  return variant;\n66\t}\n67\t\n68\t/**\n69\t * Get the human-readable CTA text for a given variant.\n70\t */\n71\texport function getCTAText(variant: CTAVariant): string {\n72\t  const ctaMap: Record<CTAVariant, string> = {\n73\t    \"book-now\": \"Book via WhatsApp\",\n74\t    \"check-availability\": \"Check Availability\",\n75\t    \"best-price-direct\": \"Get Best Price Direct\",\n76\t  };\n77\t  return ctaMap[variant] ?? \"Book via WhatsApp\";\n78\t}\n79\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"3712043e-c0e8-41eb-922a-1509bd1ca824","uuid":"0ab9a2b1-79df-47c3-bda3-3b3086a4a211","timestamp":"2026-04-14T06:10:18.148Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\lib\\flags.ts","content":"/**\n * Vercel Feature Flags and flag resolution logic.\n * Defines flag types and server-side flag reading from Edge Config.\n * For local dev, falls back to mock flags from environment variables.\n */\n\nexport type CTAVariant = \"book-now\" | \"check-availability\" | \"best-price-direct\";\n\nexport interface FlagsConfig {\n  \"cta-variant\": CTAVariant;\n}\n\n// Default flags for local development / fallback\nconst DEFAULT_FLAGS: FlagsConfig = {\n  \"cta-variant\": \"book-now\",\n};\n\n// Mock flag values from environment\nconst MOCK_FLAGS: Partial<FlagsConfig> = {\n  \"cta-variant\":\n    (process.env.NEXT_PUBLIC_FLAG_CTA_VARIANT as CTAVariant) ?? \"book-now\",\n};\n\n/**\n * Get a flag value from Edge Config (production) or mock (local dev).\n * In production, reads from Vercel Edge Config.\n * In development, uses mock values from environment variables.\n *\n * @param key - The flag key (e.g., 'cta-variant')\n * @param defaultValue - Fallback value if flag is not found\n * @returns The flag value\n */\nexport async function getFlag<K extends keyof FlagsConfig>(\n  key: K,\n  defaultValue?: FlagsConfig[K]\n): Promise<FlagsConfig[K]> {\n  try {\n    // In production with Vercel Edge Config, import and use @vercel/edge-config\n    // For now, use mock values that respect environment overrides\n    const mockValue = MOCK_FLAGS[key];\n    if (mockValue !== undefined) {\n      return mockValue as FlagsConfig[K];\n    }\n\n    // Fall back to defaults\n    return defaultValue ?? DEFAULT_FLAGS[key];\n  } catch (error) {\n    console.error(`[flags] Error reading flag '${key}':`, error);\n    return defaultValue ?? DEFAULT_FLAGS[key];\n  }\n}\n\n/**\n * Get a variant for a specific A/B test from the flag value.\n * Deterministically assigns variants based on flag configuration\n * and optional user identifier for consistent variants within a session.\n *\n * @param sessionId - Optional session ID for deterministic variant assignment\n * @returns The assigned variant\n */\nexport async function getVariant(\n  sessionId?: string\n): Promise<CTAVariant> {\n  const variant = await getFlag(\"cta-variant\");\n  return variant;\n}\n\n/**\n * Get the human-readable CTA text for a given variant.\n */\nexport function getCTAText(variant: CTAVariant): string {\n  const ctaMap: Record<CTAVariant, string> = {\n    \"book-now\": \"Book via WhatsApp\",\n    \"check-availability\": \"Check Availability\",\n    \"best-price-direct\": \"Get Best Price Direct\",\n  };\n  return ctaMap[variant] ?? \"Book via WhatsApp\";\n}\n","numLines":79,"startLine":1,"totalLines":79}}}
