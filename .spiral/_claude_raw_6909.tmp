{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01V4eCkQDtFeSJ8FrtSTrPXp","type":"tool_result","content":"1\t{\n2\t  \"productName\": \"Pelangi Capsule Hostel Website\",\n3\t  \"branchName\": \"master\",\n4\t  \"overview\": \"Enhance the Next.js 15 hostel website with a full blog system, SEO-optimised travel articles about Johor Bahru & Singapore, RSS feed, live JB news widget, and richer content to attract backpackers searching for budget accommodation near the Singapore-Malaysia border.\",\n5\t  \"goals\": [\n6\t    \"Create a blog system with static TypeScript posts for long-tail SEO\",\n7\t    \"Publish 6+ high-quality, original travel articles about JB and Singapore for tourists\",\n8\t    \"Add RSS/Atom feed at /feed.xml for the blog\",\n9\t    \"Add a 'JB News & Updates' widget on the homepage pulling from curated RSS sources\",\n10\t    \"Enhance structured data (Article, BreadcrumbList schemas) and internal linking\",\n11\t    \"Update sitemap.ts to include all blog post URLs\",\n12\t    \"Improve the /guide page with richer, more lively backpacker-focused content\"\n13\t  ],\n14\t  \"userStories\": [\n15\t    {\n16\t      \"id\": \"US-001\",\n17\t      \"title\": \"Create blog system with static TypeScript data\",\n18\t      \"priority\": \"high\",\n19\t      \"description\": \"Build a blog system using Next.js App Router. Blog posts are stored as TypeScript objects in /src/data/blog/posts.ts. Each post has: slug, title, excerpt, content (HTML string), date, category, author, readTime, tags, and featured image path. Create /app/blog/page.tsx (listing with cards) and /app/blog/[slug]/page.tsx (article page with full content). Both pages must have proper metadata (title, description, OG tags). Add a BlogCard component at /src/components/BlogCard.tsx.\",\n20\t      \"acceptanceCriteria\": [\n21\t        \"/blog page renders a grid of blog post cards with title, excerpt, date, category badge, and read time\",\n22\t        \"/blog/[slug] renders individual article with full HTML content, author, date, tags, and back link\",\n23\t        \"Both pages have generateMetadata with unique title, description, and OG image\",\n24\t        \"TypeScript compiles without errors\",\n25\t        \"No external database or CMS â€” pure static data in /src/data/blog/posts.ts\"\n26\t      ],\n27\t      \"technicalNotes\": [\n28\t        \"site/src/data/blog/posts.ts â€” create blog post data array\",\n29\t        \"site/src/app/blog/page.tsx â€” blog listing page\",\n30\t        \"site/src/app/blog/[slug]/page.tsx â€” individual article page\",\n31\t        \"site/src/components/BlogCard.tsx â€” reusable card component\",\n32\t        \"Use Tailwind prose classes for article body typography\"\n33\t      ],\n34\t      \"dependencies\": [],\n35\t      \"estimatedComplexity\": \"medium\",\n36\t      \"passes\": true\n37\t    },\n38\t    {\n39\t      \"id\": \"US-002\",\n40\t      \"title\": \"Write 6 SEO-optimised travel blog articles about JB for backpackers\",\n41\t      \"priority\": \"high\",\n42\t      \"description\": \"Research backpacker content online and write 6 original, high-quality blog articles targeting tourists visiting Johor Bahru. Articles must be 600-900 words each, written in friendly travel-guide style, and contain keywords backpackers actually search for. Include internal links to /guide, /rooms, and /book pages. Topics: (1) Ultimate JB Food Guide for Backpackers, (2) Singapore to JB Day Trip Guide: How to Cross the Causeway, (3) Top 10 Things to Do in Johor Bahru on a Budget, (4) JB Street Food Hawker Centers You Must Visit, (5) Johor Bahru vs Singapore: Why Savvy Travellers Base Themselves in JB, (6) Hidden Gems in Johor Bahru: Beyond the Usual Tourist Spots. Each article must have a unique slug, proper SEO metadata, and be added to posts.ts.\",\n43\t      \"acceptanceCriteria\": [\n44\t        \"All 6 articles exist in posts.ts with unique slugs, titles, excerpts, categories, dates, and tags\",\n45\t        \"Each article body is 600-900 words of original, rewritten content (not copied)\",\n46\t        \"Each article contains 2-3 internal links to /guide, /rooms, or /book\",\n47\t        \"Articles cover: food, border crossing, budget activities, hawker centers, JB vs SG comparison, hidden gems\",\n48\t        \"All articles have SEO-friendly titles with keywords like 'Johor Bahru', 'JB', 'budget', 'backpacker'\"\n49\t      ],\n50\t      \"technicalNotes\": [\n51\t        \"site/src/data/blog/posts.ts â€” add all 6 articles\",\n52\t        \"Research sources: numbeo.com, hostelworld.com, lonelyplanet.com, timeout.com/kuala-lumpur, thepoortraveler.net\",\n53\t        \"Content must be original rewrites, not copy-paste\",\n54\t        \"Use categories: 'Food & Drink', 'Travel Tips', 'Things To Do', 'Local Life'\",\n55\t        \"Tags should include: johor-bahru, singapore, budget-travel, food, backpacker, malaysia\"\n56\t      ],\n57\t      \"dependencies\": [\n58\t        \"US-001\"\n59\t      ],\n60\t      \"estimatedComplexity\": \"large\",\n61\t      \"passes\": true\n62\t    },\n63\t    {\n64\t      \"id\": \"US-003\",\n65\t      \"title\": \"Add RSS/Atom feed at /feed.xml for the blog\",\n66\t      \"priority\": \"medium\",\n67\t      \"description\": \"Create a Next.js Route Handler at /app/feed.xml/route.ts that returns a valid RSS 2.0 XML feed from the blog posts data. The feed must include: channel title, link, description, language, and item entries with title, link, description (excerpt), pubDate, category, and guid. Add a <link rel='alternate' type='application/rss+xml'> tag in layout.tsx. Also add the feed URL to robots.ts.\",\n68\t      \"acceptanceCriteria\": [\n69\t        \"GET /feed.xml returns valid RSS 2.0 XML with Content-Type: application/xml\",\n70\t        \"Feed contains all blog posts as <item> entries\",\n71\t        \"Each item has title, link, description, pubDate, and guid\",\n72\t        \"layout.tsx has <link rel='alternate' type='application/rss+xml' href='/feed.xml'>\",\n73\t        \"TypeScript compiles without errors\"\n74\t      ],\n75\t      \"technicalNotes\": [\n76\t        \"site/src/app/feed.xml/route.ts â€” Route Handler returning XML\",\n77\t        \"Import posts from /src/data/blog/posts.ts\",\n78\t        \"Use Response with headers {'Content-Type': 'application/xml'}\",\n79\t        \"site/src/app/layout.tsx â€” add RSS link in <head>\"\n80\t      ],\n81\t      \"dependencies\": [\n82\t        \"US-001\"\n83\t      ],\n84\t      \"estimatedComplexity\": \"small\",\n85\t      \"passes\": true\n86\t    },\n87\t    {\n88\t      \"id\": \"US-004\",\n89\t      \"title\": \"Add JB News & Updates widget on homepage using curated RSS links\",\n90\t      \"priority\": \"medium\",\n91\t      \"description\": \"Add a 'JB Buzz' section on the homepage between CommunityEvents and the teaser section. This is a static, curated section (no live API calls at runtime to avoid SSR issues). It should show: (1) a list of 4-5 curated news/blog links from real JB/Malaysia sources like Johor Now, Malay Mail, The Star Johor, and Visit Johor â€” shown as stylish news cards with title, source, date, and a short description. (2) An RSS subscribe button linking to /feed.xml. (3) A 'Latest from Our Blog' teaser showing the 3 most recent blog posts. All links open in new tab with rel='noopener noreferrer'.\",\n92\t      \"acceptanceCriteria\": [\n93\t        \"New 'JB Buzz' section visible on homepage with at least 4 curated external news links\",\n94\t        \"Section has 'Latest from Our Blog' showing 3 most recent blog post cards\",\n95\t        \"RSS subscribe button links to /feed.xml\",\n96\t        \"All external links have rel='noopener noreferrer' and target='_blank'\",\n97\t        \"Section looks consistent with existing design (stone/amber color scheme, rounded cards)\"\n98\t      ],\n99\t      \"technicalNotes\": [\n100\t        \"site/src/components/JBBuzz.tsx â€” new component\",\n101\t        \"site/src/app/page.tsx â€” import and add <JBBuzz /> after <CommunityEvents />\",\n102\t        \"Curated links: johornow.com, malaymail.com, thestar.com.my, visitjohor.com\",\n103\t        \"Latest blog posts: import from posts.ts and show top 3 by date\",\n104\t        \"Use same card styling as other homepage sections\"\n105\t      ],\n106\t      \"dependencies\": [\n107\t        \"US-001\",\n108\t        \"US-002\"\n109\t      ],\n110\t      \"estimatedComplexity\": \"medium\",\n111\t      \"passes\": true\n112\t    },\n113\t    {\n114\t      \"id\": \"US-005\",\n115\t      \"title\": \"Add Article schema and BreadcrumbList structured data to blog pages\",\n116\t      \"priority\": \"high\",\n117\t      \"description\": \"Enhance SEO with JSON-LD structured data. Add Article schema to each /blog/[slug] page (type: BlogPosting, headline, description, author, datePublished, image, publisher). Add BreadcrumbList schema to /blog and /blog/[slug] pages. Update the existing StructuredData component or create a new BlogStructuredData component. Also add FAQ schema to the homepage FAQ section if it does not already exist.\",\n118\t      \"acceptanceCriteria\": [\n119\t        \"/blog/[slug] pages include JSON-LD <script> with BlogPosting schema\",\n120\t        \"BlogPosting includes: headline, description, datePublished, author (name: 'Pelangi Capsule Hostel'), publisher (name, logo), image\",\n121\t        \"/blog and /blog/[slug] include BreadcrumbList JSON-LD\",\n122\t        \"No TypeScript errors\",\n123\t        \"Schema validates correctly (structure is correct JSON-LD)\"\n124\t      ],\n125\t      \"technicalNotes\": [\n126\t        \"site/src/components/BlogStructuredData.tsx â€” new component accepting post data\",\n127\t        \"site/src/app/blog/[slug]/page.tsx â€” import and render BlogStructuredData\",\n128\t        \"BreadcrumbList: Home > Blog > Article Title\",\n129\t        \"Publisher logo URL: https://pelangicapsulehostel.com/images/logo.png\"\n130\t      ],\n131\t      \"dependencies\": [\n132\t        \"US-001\"\n133\t      ],\n134\t      \"estimatedComplexity\": \"small\",\n135\t      \"passes\": true\n136\t    },\n137\t    {\n138\t      \"id\": \"US-006\",\n139\t      \"title\": \"Update sitemap.ts to include all blog posts\",\n140\t      \"priority\": \"high\",\n141\t      \"description\": \"Update /app/sitemap.ts to dynamically include all blog post URLs. Import the posts array from /src/data/blog/posts.ts. For each post, add an entry with url: `${baseUrl}/blog/${post.slug}`, lastModified using post.date, changeFrequency: 'monthly', and priority: 0.7. Also add the /blog listing page with priority 0.8. This ensures Google can discover and index all articles.\",\n142\t      \"acceptanceCriteria\": [\n143\t        \"/sitemap.xml includes /blog URL with priority 0.8\",\n144\t        \"/sitemap.xml includes all individual blog post URLs\",\n145\t        \"Each blog post entry has correct slug from posts.ts\",\n146\t        \"TypeScript compiles without errors\",\n147\t        \"No hardcoded slugs â€” all generated dynamically from posts array\"\n148\t      ],\n149\t      \"technicalNotes\": [\n150\t        \"site/src/app/sitemap.ts â€” update to import posts and map to sitemap entries\",\n151\t        \"Import: import { posts } from '@/data/blog/posts'\",\n152\t        \"Add /blog and /blog/[slug] entries to the returned array\"\n153\t      ],\n154\t      \"dependencies\": [\n155\t        \"US-001\"\n156\t      ],\n157\t      \"estimatedComplexity\": \"small\",\n158\t      \"passes\": true\n159\t    },\n160\t    {\n161\t      \"id\": \"US-007\",\n162\t      \"title\": \"Enhance /guide page with rich backpacker-focused local content\",\n163\t      \"priority\": \"medium\",\n164\t      \"description\": \"Substantially improve the /guide page (site/src/app/guide/page.tsx) with richer, more lively content for backpackers. Add sections: (1) Getting Around JB â€” GrabCar, bus, taxi fares with real prices; (2) Money & Currency â€” where to exchange, ATMs near Taman Pelangi; (3) Singapore Day Trip â€” Causeway vs Second Link, immigration tips, operating hours; (4) Top Hawker Centers Near Us â€” with distance and opening hours; (5) Safety Tips for Backpackers; (6) Useful Local Apps â€” Grab, MyRapid, MySejahtera. All with practical, accurate information. Add internal links to /blog articles where relevant.\",\n165\t      \"acceptanceCriteria\": [\n166\t        \"/guide page has at least 6 content sections as described\",\n167\t        \"Each section has practical, specific information (prices, distances, hours â€” not vague)\",\n168\t        \"Page has proper metadata with 'Johor Bahru local guide backpacker' keywords\",\n169\t        \"Internal links to 2+ blog articles (once those exist)\",\n170\t        \"Consistent design with rest of site (Tailwind, stone/amber palette)\"\n171\t      ],\n172\t      \"technicalNotes\": [\n173\t        \"site/src/app/guide/page.tsx â€” read existing file first, then enhance\",\n174\t        \"Add generateMetadata with description targeting 'JB travel guide backpacker' keywords\",\n175\t        \"Currency exchange: Jalan Wong Ah Fook money changers\",\n176\t        \"Causeway: open 24h, busiest 7-9am and 5-8pm\",\n177\t        \"Add Link components pointing to /blog articles\"\n178\t      ],\n179\t      \"dependencies\": [\n180\t        \"US-002\"\n181\t      ],\n182\t      \"estimatedComplexity\": \"medium\",\n183\t      \"passes\": true\n184\t    },\n185\t    {\n186\t      \"id\": \"US-008\",\n187\t      \"title\": \"Add 'Singapore Day Trip' teaser section to homepage\",\n188\t      \"priority\": \"low\",\n189\t      \"description\": \"Add a visually compelling 'Singapore from JB' section on the homepage between LocationMap and FAQ. It should highlight: 30-min Singapore proximity, cost comparison (JB accommodation vs SG), Causeway/Second Link access, and link to the blog article about Singapore day trips. Include a CTA button to the relevant blog article. Use an eye-catching gradient or illustration.\",\n190\t      \"acceptanceCriteria\": [\n191\t        \"New section visible on homepage between LocationMap and FAQ\",\n192\t        \"Section shows Singapore distance/proximity callout (30 min from border)\",\n193\t        \"Section shows cost comparison stat (e.g. 'Save 70% on accommodation vs Singapore')\",\n194\t        \"CTA button links to /blog/singapore-day-trip-from-jb or /guide\",\n195\t        \"Responsive design matches rest of site\"\n196\t      ],\n197\t      \"technicalNotes\": [\n198\t        \"site/src/components/SingaporeTeaser.tsx â€” new component\",\n199\t        \"site/src/app/page.tsx â€” add <SingaporeTeaser /> between <LocationMap /> and <FAQ />\",\n200\t        \"Use amber/warm gradient background to stand out\",\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"3712043e-c0e8-41eb-922a-1509bd1ca824","uuid":"6a63da4c-ec7d-42a5-aac5-e3b60a27e117","timestamp":"2026-04-14T06:04:15.804Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\prd.json","content":"{\n  \"productName\": \"Pelangi Capsule Hostel Website\",\n  \"branchName\": \"master\",\n  \"overview\": \"Enhance the Next.js 15 hostel website with a full blog system, SEO-optimised travel articles about Johor Bahru & Singapore, RSS feed, live JB news widget, and richer content to attract backpackers searching for budget accommodation near the Singapore-Malaysia border.\",\n  \"goals\": [\n    \"Create a blog system with static TypeScript posts for long-tail SEO\",\n    \"Publish 6+ high-quality, original travel articles about JB and Singapore for tourists\",\n    \"Add RSS/Atom feed at /feed.xml for the blog\",\n    \"Add a 'JB News & Updates' widget on the homepage pulling from curated RSS sources\",\n    \"Enhance structured data (Article, BreadcrumbList schemas) and internal linking\",\n    \"Update sitemap.ts to include all blog post URLs\",\n    \"Improve the /guide page with richer, more lively backpacker-focused content\"\n  ],\n  \"userStories\": [\n    {\n      \"id\": \"US-001\",\n      \"title\": \"Create blog system with static TypeScript data\",\n      \"priority\": \"high\",\n      \"description\": \"Build a blog system using Next.js App Router. Blog posts are stored as TypeScript objects in /src/data/blog/posts.ts. Each post has: slug, title, excerpt, content (HTML string), date, category, author, readTime, tags, and featured image path. Create /app/blog/page.tsx (listing with cards) and /app/blog/[slug]/page.tsx (article page with full content). Both pages must have proper metadata (title, description, OG tags). Add a BlogCard component at /src/components/BlogCard.tsx.\",\n      \"acceptanceCriteria\": [\n        \"/blog page renders a grid of blog post cards with title, excerpt, date, category badge, and read time\",\n        \"/blog/[slug] renders individual article with full HTML content, author, date, tags, and back link\",\n        \"Both pages have generateMetadata with unique title, description, and OG image\",\n        \"TypeScript compiles without errors\",\n        \"No external database or CMS â€” pure static data in /src/data/blog/posts.ts\"\n      ],\n      \"technicalNotes\": [\n        \"site/src/data/blog/posts.ts â€” create blog post data array\",\n        \"site/src/app/blog/page.tsx â€” blog listing page\",\n        \"site/src/app/blog/[slug]/page.tsx â€” individual article page\",\n        \"site/src/components/BlogCard.tsx â€” reusable card component\",\n        \"Use Tailwind prose classes for article body typography\"\n      ],\n      \"dependencies\": [],\n      \"estimatedComplexity\": \"medium\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"US-002\",\n      \"title\": \"Write 6 SEO-optimised travel blog articles about JB for backpackers\",\n      \"priority\": \"high\",\n      \"description\": \"Research backpacker content online and write 6 original, high-quality blog articles targeting tourists visiting Johor Bahru. Articles must be 600-900 words each, written in friendly travel-guide style, and contain keywords backpackers actually search for. Include internal links to /guide, /rooms, and /book pages. Topics: (1) Ultimate JB Food Guide for Backpackers, (2) Singapore to JB Day Trip Guide: How to Cross the Causeway, (3) Top 10 Things to Do in Johor Bahru on a Budget, (4) JB Street Food Hawker Centers You Must Visit, (5) Johor Bahru vs Singapore: Why Savvy Travellers Base Themselves in JB, (6) Hidden Gems in Johor Bahru: Beyond the Usual Tourist Spots. Each article must have a unique slug, proper SEO metadata, and be added to posts.ts.\",\n      \"acceptanceCriteria\": [\n        \"All 6 articles exist in posts.ts with unique slugs, titles, excerpts, categories, dates, and tags\",\n        \"Each article body is 600-900 words of original, rewritten content (not copied)\",\n        \"Each article contains 2-3 internal links to /guide, /rooms, or /book\",\n        \"Articles cover: food, border crossing, budget activities, hawker centers, JB vs SG comparison, hidden gems\",\n        \"All articles have SEO-friendly titles with keywords like 'Johor Bahru', 'JB', 'budget', 'backpacker'\"\n      ],\n      \"technicalNotes\": [\n        \"site/src/data/blog/posts.ts â€” add all 6 articles\",\n        \"Research sources: numbeo.com, hostelworld.com, lonelyplanet.com, timeout.com/kuala-lumpur, thepoortraveler.net\",\n        \"Content must be original rewrites, not copy-paste\",\n        \"Use categories: 'Food & Drink', 'Travel Tips', 'Things To Do', 'Local Life'\",\n        \"Tags should include: johor-bahru, singapore, budget-travel, food, backpacker, malaysia\"\n      ],\n      \"dependencies\": [\n        \"US-001\"\n      ],\n      \"estimatedComplexity\": \"large\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"US-003\",\n      \"title\": \"Add RSS/Atom feed at /feed.xml for the blog\",\n      \"priority\": \"medium\",\n      \"description\": \"Create a Next.js Route Handler at /app/feed.xml/route.ts that returns a valid RSS 2.0 XML feed from the blog posts data. The feed must include: channel title, link, description, language, and item entries with title, link, description (excerpt), pubDate, category, and guid. Add a <link rel='alternate' type='application/rss+xml'> tag in layout.tsx. Also add the feed URL to robots.ts.\",\n      \"acceptanceCriteria\": [\n        \"GET /feed.xml returns valid RSS 2.0 XML with Content-Type: application/xml\",\n        \"Feed contains all blog posts as <item> entries\",\n        \"Each item has title, link, description, pubDate, and guid\",\n        \"layout.tsx has <link rel='alternate' type='application/rss+xml' href='/feed.xml'>\",\n        \"TypeScript compiles without errors\"\n      ],\n      \"technicalNotes\": [\n        \"site/src/app/feed.xml/route.ts â€” Route Handler returning XML\",\n        \"Import posts from /src/data/blog/posts.ts\",\n        \"Use Response with headers {'Content-Type': 'application/xml'}\",\n        \"site/src/app/layout.tsx â€” add RSS link in <head>\"\n      ],\n      \"dependencies\": [\n        \"US-001\"\n      ],\n      \"estimatedComplexity\": \"small\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"US-004\",\n      \"title\": \"Add JB News & Updates widget on homepage using curated RSS links\",\n      \"priority\": \"medium\",\n      \"description\": \"Add a 'JB Buzz' section on the homepage between CommunityEvents and the teaser section. This is a static, curated section (no live API calls at runtime to avoid SSR issues). It should show: (1) a list of 4-5 curated news/blog links from real JB/Malaysia sources like Johor Now, Malay Mail, The Star Johor, and Visit Johor â€” shown as stylish news cards with title, source, date, and a short description. (2) An RSS subscribe button linking to /feed.xml. (3) A 'Latest from Our Blog' teaser showing the 3 most recent blog posts. All links open in new tab with rel='noopener noreferrer'.\",\n      \"acceptanceCriteria\": [\n        \"New 'JB Buzz' section visible on homepage with at least 4 curated external news links\",\n        \"Section has 'Latest from Our Blog' showing 3 most recent blog post cards\",\n        \"RSS subscribe button links to /feed.xml\",\n        \"All external links have rel='noopener noreferrer' and target='_blank'\",\n        \"Section looks consistent with existing design (stone/amber color scheme, rounded cards)\"\n      ],\n      \"technicalNotes\": [\n        \"site/src/components/JBBuzz.tsx â€” new component\",\n        \"site/src/app/page.tsx â€” import and add <JBBuzz /> after <CommunityEvents />\",\n        \"Curated links: johornow.com, malaymail.com, thestar.com.my, visitjohor.com\",\n        \"Latest blog posts: import from posts.ts and show top 3 by date\",\n        \"Use same card styling as other homepage sections\"\n      ],\n      \"dependencies\": [\n        \"US-001\",\n        \"US-002\"\n      ],\n      \"estimatedComplexity\": \"medium\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"US-005\",\n      \"title\": \"Add Article schema and BreadcrumbList structured data to blog pages\",\n      \"priority\": \"high\",\n      \"description\": \"Enhance SEO with JSON-LD structured data. Add Article schema to each /blog/[slug] page (type: BlogPosting, headline, description, author, datePublished, image, publisher). Add BreadcrumbList schema to /blog and /blog/[slug] pages. Update the existing StructuredData component or create a new BlogStructuredData component. Also add FAQ schema to the homepage FAQ section if it does not already exist.\",\n      \"acceptanceCriteria\": [\n        \"/blog/[slug] pages include JSON-LD <script> with BlogPosting schema\",\n        \"BlogPosting includes: headline, description, datePublished, author (name: 'Pelangi Capsule Hostel'), publisher (name, logo), image\",\n        \"/blog and /blog/[slug] include BreadcrumbList JSON-LD\",\n        \"No TypeScript errors\",\n        \"Schema validates correctly (structure is correct JSON-LD)\"\n      ],\n      \"technicalNotes\": [\n        \"site/src/components/BlogStructuredData.tsx â€” new component accepting post data\",\n        \"site/src/app/blog/[slug]/page.tsx â€” import and render BlogStructuredData\",\n        \"BreadcrumbList: Home > Blog > Article Title\",\n        \"Publisher logo URL: https://pelangicapsulehostel.com/images/logo.png\"\n      ],\n      \"dependencies\": [\n        \"US-001\"\n      ],\n      \"estimatedComplexity\": \"small\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"US-006\",\n      \"title\": \"Update sitemap.ts to include all blog posts\",\n      \"priority\": \"high\",\n      \"description\": \"Update /app/sitemap.ts to dynamically include all blog post URLs. Import the posts array from /src/data/blog/posts.ts. For each post, add an entry with url: `${baseUrl}/blog/${post.slug}`, lastModified using post.date, changeFrequency: 'monthly', and priority: 0.7. Also add the /blog listing page with priority 0.8. This ensures Google can discover and index all articles.\",\n      \"acceptanceCriteria\": [\n        \"/sitemap.xml includes /blog URL with priority 0.8\",\n        \"/sitemap.xml includes all individual blog post URLs\",\n        \"Each blog post entry has correct slug from posts.ts\",\n        \"TypeScript compiles without errors\",\n        \"No hardcoded slugs â€” all generated dynamically from posts array\"\n      ],\n      \"technicalNotes\": [\n        \"site/src/app/sitemap.ts â€” update to import posts and map to sitemap entries\",\n        \"Import: import { posts } from '@/data/blog/posts'\",\n        \"Add /blog and /blog/[slug] entries to the returned array\"\n      ],\n      \"dependencies\": [\n        \"US-001\"\n      ],\n      \"estimatedComplexity\": \"small\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"US-007\",\n      \"title\": \"Enhance /guide page with rich backpacker-focused local content\",\n      \"priority\": \"medium\",\n      \"description\": \"Substantially improve the /guide page (site/src/app/guide/page.tsx) with richer, more lively content for backpackers. Add sections: (1) Getting Around JB â€” GrabCar, bus, taxi fares with real prices; (2) Money & Currency â€” where to exchange, ATMs near Taman Pelangi; (3) Singapore Day Trip â€” Causeway vs Second Link, immigration tips, operating hours; (4) Top Hawker Centers Near Us â€” with distance and opening hours; (5) Safety Tips for Backpackers; (6) Useful Local Apps â€” Grab, MyRapid, MySejahtera. All with practical, accurate information. Add internal links to /blog articles where relevant.\",\n      \"acceptanceCriteria\": [\n        \"/guide page has at least 6 content sections as described\",\n        \"Each section has practical, specific information (prices, distances, hours â€” not vague)\",\n        \"Page has proper metadata with 'Johor Bahru local guide backpacker' keywords\",\n        \"Internal links to 2+ blog articles (once those exist)\",\n        \"Consistent design with rest of site (Tailwind, stone/amber palette)\"\n      ],\n      \"technicalNotes\": [\n        \"site/src/app/guide/page.tsx â€” read existing file first, then enhance\",\n        \"Add generateMetadata with description targeting 'JB travel guide backpacker' keywords\",\n        \"Currency exchange: Jalan Wong Ah Fook money changers\",\n        \"Causeway: open 24h, busiest 7-9am and 5-8pm\",\n        \"Add Link components pointing to /blog articles\"\n      ],\n      \"dependencies\": [\n        \"US-002\"\n      ],\n      \"estimatedComplexity\": \"medium\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"US-008\",\n      \"title\": \"Add 'Singapore Day Trip' teaser section to homepage\",\n      \"priority\": \"low\",\n      \"description\": \"Add a visually compelling 'Singapore from JB' section on the homepage between LocationMap and FAQ. It should highlight: 30-min Singapore proximity, cost comparison (JB accommodation vs SG), Causeway/Second Link access, and link to the blog article about Singapore day trips. Include a CTA button to the relevant blog article. Use an eye-catching gradient or illustration.\",\n      \"acceptanceCriteria\": [\n        \"New section visible on homepage between LocationMap and FAQ\",\n        \"Section shows Singapore distance/proximity callout (30 min from border)\",\n        \"Section shows cost comparison stat (e.g. 'Save 70% on accommodation vs Singapore')\",\n        \"CTA button links to /blog/singapore-day-trip-from-jb or /guide\",\n        \"Responsive design matches rest of site\"\n      ],\n      \"technicalNotes\": [\n        \"site/src/components/SingaporeTeaser.tsx â€” new component\",\n        \"site/src/app/page.tsx â€” add <SingaporeTeaser /> between <LocationMap /> and <FAQ />\",\n        \"Use amber/warm gradient background to stand out\",","numLines":200,"startLine":1,"totalLines":5736}}}
