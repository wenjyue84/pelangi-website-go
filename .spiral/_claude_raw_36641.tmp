{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01VttsQx3MsgeoaWYwM8PtPn","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01YCCsypDV1A5CFw9qFXkAgv","name":"Write","input":{"file_path":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\config\\channel-manager.ts","content":"/**\n * Channel Manager Configuration\n * Supports Beds24 (recommended for small hostels)\n *\n * Required environment variables:\n *   - CHANNEL_MANAGER_PROVIDER: \"beds24\" (required)\n *   - BEDS24_API_KEY: Beds24 API key (required if using Beds24)\n *   - BEDS24_PROPERTY_ID: Beds24 property ID (required if using Beds24)\n *   - WEBHOOK_SECRET: Shared secret for webhook validation (required)\n */\n\nexport const CHANNEL_MANAGER_CONFIG = {\n  provider: (process.env.CHANNEL_MANAGER_PROVIDER || \"beds24\") as \"beds24\",\n  beds24: {\n    apiKey: process.env.BEDS24_API_KEY || \"\",\n    propertyId: process.env.BEDS24_PROPERTY_ID || \"\",\n    apiBaseUrl: \"https://api.beds24.com/json\",\n  },\n  webhook: {\n    secret: process.env.WEBHOOK_SECRET || \"\",\n    endpoint: \"/api/webhooks/beds24\",\n  },\n  syncInterval: 300000, // 5 minutes\n  cacheTimeout: 60000, // 1 minute\n  retryAttempts: 3,\n  retryDelay: 1000, // 1 second\n};\n\nexport function isChannelManagerConfigured(): boolean {\n  return (\n    CHANNEL_MANAGER_CONFIG.beds24.apiKey !== \"\" &&\n    CHANNEL_MANAGER_CONFIG.beds24.propertyId !== \"\" &&\n    CHANNEL_MANAGER_CONFIG.webhook.secret !== \"\"\n  );\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":561,"cache_read_input_tokens":92198,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":561},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"e6d90c97-f395-42af-a0ca-354a9893adb6","uuid":"dbda0074-8545-4996-bb2b-adbaeddc7fa8"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YCCsypDV1A5CFw9qFXkAgv","type":"tool_result","content":"File created successfully at: C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\config\\channel-manager.ts"}]},"parent_tool_use_id":null,"session_id":"e6d90c97-f395-42af-a0ca-354a9893adb6","uuid":"1a8e37f6-601c-494c-8bf3-fdf99a0cfcca","timestamp":"2026-04-13T19:20:58.500Z","tool_use_result":{"type":"create","filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\config\\channel-manager.ts","content":"/**\n * Channel Manager Configuration\n * Supports Beds24 (recommended for small hostels)\n *\n * Required environment variables:\n *   - CHANNEL_MANAGER_PROVIDER: \"beds24\" (required)\n *   - BEDS24_API_KEY: Beds24 API key (required if using Beds24)\n *   - BEDS24_PROPERTY_ID: Beds24 property ID (required if using Beds24)\n *   - WEBHOOK_SECRET: Shared secret for webhook validation (required)\n */\n\nexport const CHANNEL_MANAGER_CONFIG = {\n  provider: (process.env.CHANNEL_MANAGER_PROVIDER || \"beds24\") as \"beds24\",\n  beds24: {\n    apiKey: process.env.BEDS24_API_KEY || \"\",\n    propertyId: process.env.BEDS24_PROPERTY_ID || \"\",\n    apiBaseUrl: \"https://api.beds24.com/json\",\n  },\n  webhook: {\n    secret: process.env.WEBHOOK_SECRET || \"\",\n    endpoint: \"/api/webhooks/beds24\",\n  },\n  syncInterval: 300000, // 5 minutes\n  cacheTimeout: 60000, // 1 minute\n  retryAttempts: 3,\n  retryDelay: 1000, // 1 second\n};\n\nexport function isChannelManagerConfigured(): boolean {\n  return (\n    CHANNEL_MANAGER_CONFIG.beds24.apiKey !== \"\" &&\n    CHANNEL_MANAGER_CONFIG.beds24.propertyId !== \"\" &&\n    CHANNEL_MANAGER_CONFIG.webhook.secret !== \"\"\n  );\n}\n","structuredPatch":[],"originalFile":null}}
{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01LV2DuHnmWwT6kxjhckyc3a","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"Now let me create the Beds24 API client.","signature":""}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":586,"cache_read_input_tokens":92759,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":586},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"e6d90c97-f395-42af-a0ca-354a9893adb6","uuid":"2ed9f42b-1166-49b2-b816-0b3c38fd6835"}
{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01LV2DuHnmWwT6kxjhckyc3a","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01LX47AqKqvothsVqZNGorwF","name":"Write","input":{"file_path":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\lib\\beds24-client.ts","content":"/**\n * Beds24 API Client for channel manager integration.\n * Handles API communication with Beds24 for ARI (Availability, Rate, Inventory) sync.\n */\n\nimport { CHANNEL_MANAGER_CONFIG } from \"@/config/channel-manager\";\nimport type { ChannelManagerAvailability, ChannelManagerBooking } from \"./channel-manager-types\";\n\nexport class Beds24Client {\n  private apiKey: string;\n  private propertyId: string;\n  private baseUrl: string;\n\n  constructor() {\n    this.apiKey = CHANNEL_MANAGER_CONFIG.beds24.apiKey;\n    this.propertyId = CHANNEL_MANAGER_CONFIG.beds24.propertyId;\n    this.baseUrl = CHANNEL_MANAGER_CONFIG.beds24.apiBaseUrl;\n  }\n\n  /**\n   * Fetch availability from Beds24 for a given date range.\n   * Returns inventory and rates for each room type.\n   */\n  async getAvailability(\n    checkin: string,\n    checkout: string,\n  ): Promise<ChannelManagerAvailability[]> {\n    if (!this.isConfigured()) {\n      return this.getPlaceholderAvailability(checkin, checkout);\n    }\n\n    try {\n      const params = new URLSearchParams({\n        apiKey: this.apiKey,\n        propid: this.propertyId,\n        checkin,\n        checkout,\n      });\n\n      const response = await fetch(`${this.baseUrl}/getAvailability?${params}`, {\n        cache: \"no-store\",\n      });\n\n      if (!response.ok) {\n        console.error(\"Beds24 API error:\", response.statusText);\n        return this.getPlaceholderAvailability(checkin, checkout);\n      }\n\n      const data = await response.json();\n      return this.parseAvailabilityResponse(data);\n    } catch (error) {\n      console.error(\"Beds24 availability fetch failed:\", error);\n      return this.getPlaceholderAvailability(checkin, checkout);\n    }\n  }\n\n  /**\n   * Sync a new booking to Beds24.\n   * Called when a booking is confirmed on the website.\n   */\n  async syncBooking(booking: Partial<ChannelManagerBooking>): Promise<boolean> {\n    if (!this.isConfigured()) {\n      console.warn(\"Channel manager not configured, skipping booking sync\");\n      return false;\n    }\n\n    try {\n      const payload = {\n        apiKey: this.apiKey,\n        propid: this.propertyId,\n        guestName: booking.guestName,\n        guestEmail: booking.guestEmail,\n        guestPhone: booking.guestPhone,\n        checkin: booking.checkin,\n        checkout: booking.checkout,\n        roomId: booking.roomId,\n        noOfGuests: booking.adults || 1,\n        status: booking.status || \"confirmed\",\n        source: booking.source || \"website\",\n      };\n\n      const response = await fetch(`${this.baseUrl}/putBooking`, {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify(payload),\n      });\n\n      return response.ok;\n    } catch (error) {\n      console.error(\"Beds24 booking sync failed:\", error);\n      return false;\n    }\n  }\n\n  /**\n   * Cancel a booking in Beds24.\n   * Called when a booking is cancelled on the website.\n   */\n  async cancelBooking(externalBookingId: string): Promise<boolean> {\n    if (!this.isConfigured()) {\n      console.warn(\"Channel manager not configured, skipping booking cancellation\");\n      return false;\n    }\n\n    try {\n      const params = new URLSearchParams({\n        apiKey: this.apiKey,\n        propid: this.propertyId,\n        bookid: externalBookingId,\n      });\n\n      const response = await fetch(`${this.baseUrl}/delBooking?${params}`, {\n        method: \"DELETE\",\n      });\n\n      return response.ok;\n    } catch (error) {\n      console.error(\"Beds24 booking cancellation failed:\", error);\n      return false;\n    }\n  }\n\n  /**\n   * Validate webhook payload using shared secret.\n   * Beds24 includes X-Beds24-Signature header for verification.\n   */\n  validateWebhook(payload: string, signature: string | null): boolean {\n    if (!signature) return false;\n\n    const crypto = require(\"crypto\");\n    const hmac = crypto.createHmac(\n      \"sha256\",\n      CHANNEL_MANAGER_CONFIG.webhook.secret,\n    );\n    hmac.update(payload);\n    const computed = hmac.digest(\"hex\");\n\n    return computed === signature;\n  }\n\n  private isConfigured(): boolean {\n    return this.apiKey !== \"\" && this.propertyId !== \"\";\n  }\n\n  private parseAvailabilityResponse(\n    data: Record<string, unknown>,\n  ): ChannelManagerAvailability[] {\n    // Parse Beds24 API response format\n    // This is a placeholder implementation - adjust based on actual Beds24 API response\n    return [];\n  }\n\n  private getPlaceholderAvailability(\n    checkin: string,\n    checkout: string,\n  ): ChannelManagerAvailability[] {\n    // Return placeholder data when channel manager is not configured\n    const nights = Math.ceil(\n      (new Date(checkout).getTime() - new Date(checkin).getTime()) /\n        (1000 * 60 * 60 * 24),\n    );\n\n    return [\n      {\n        roomId: \"standard-capsule\",\n        roomName: \"Standard Capsule Pod\",\n        checkin,\n        checkout,\n        available: 18,\n        total: 18,\n        rate: 35 * nights,\n        currency: \"MYR\",\n      },\n      {\n        roomId: \"premium-capsule\",\n        roomName: \"Premium Capsule Pod\",\n        checkin,\n        checkout,\n        available: 6,\n        total: 6,\n        rate: 45 * nights,\n        currency: \"MYR\",\n      },\n    ];\n  }\n}\n\nexport const beds24Client = new Beds24Client();\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":586,"cache_read_input_tokens":92759,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":586},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"e6d90c97-f395-42af-a0ca-354a9893adb6","uuid":"25aa997b-d4bc-40b3-acba-ba546d395465"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LX47AqKqvothsVqZNGorwF","type":"tool_result","content":"File created successfully at: C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\lib\\beds24-client.ts"}]},"parent_tool_use_id":null,"session_id":"e6d90c97-f395-42af-a0ca-354a9893adb6","uuid":"01830623-b063-434a-9371-1e283fa26b3b","timestamp":"2026-04-13T19:21:09.287Z","tool_use_result":{"type":"create","filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\lib\\beds24-client.ts","content":"/**\n * Beds24 API Client for channel manager integration.\n * Handles API communication with Beds24 for ARI (Availability, Rate, Inventory) sync.\n */\n\nimport { CHANNEL_MANAGER_CONFIG } from \"@/config/channel-manager\";\nimport type { ChannelManagerAvailability, ChannelManagerBooking } from \"./channel-manager-types\";\n\nexport class Beds24Client {\n  private apiKey: string;\n  private propertyId: string;\n  private baseUrl: string;\n\n  constructor() {\n    this.apiKey = CHANNEL_MANAGER_CONFIG.beds24.apiKey;\n    this.propertyId = CHANNEL_MANAGER_CONFIG.beds24.propertyId;\n    this.baseUrl = CHANNEL_MANAGER_CONFIG.beds24.apiBaseUrl;\n  }\n\n  /**\n   * Fetch availability from Beds24 for a given date range.\n   * Returns inventory and rates for each room type.\n   */\n  async getAvailability(\n    checkin: string,\n    checkout: string,\n  ): Promise<ChannelManagerAvailability[]> {\n    if (!this.isConfigured()) {\n      return this.getPlaceholderAvailability(checkin, checkout);\n    }\n\n    try {\n      const params = new URLSearchParams({\n        apiKey: this.apiKey,\n        propid: this.propertyId,\n        checkin,\n        checkout,\n      });\n\n      const response = await fetch(`${this.baseUrl}/getAvailability?${params}`, {\n        cache: \"no-store\",\n      });\n\n      if (!response.ok) {\n        console.error(\"Beds24 API error:\", response.statusText);\n        return this.getPlaceholderAvailability(checkin, checkout);\n      }\n\n      const data = await response.json();\n      return this.parseAvailabilityResponse(data);\n    } catch (error) {\n      console.error(\"Beds24 availability fetch failed:\", error);\n      return this.getPlaceholderAvailability(checkin, checkout);\n    }\n  }\n\n  /**\n   * Sync a new booking to Beds24.\n   * Called when a booking is confirmed on the website.\n   */\n  async syncBooking(booking: Partial<ChannelManagerBooking>): Promise<boolean> {\n    if (!this.isConfigured()) {\n      console.warn(\"Channel manager not configured, skipping booking sync\");\n      return false;\n    }\n\n    try {\n      const payload = {\n        apiKey: this.apiKey,\n        propid: this.propertyId,\n        guestName: booking.guestName,\n        guestEmail: booking.guestEmail,\n        guestPhone: booking.guestPhone,\n        checkin: booking.checkin,\n        checkout: booking.checkout,\n        roomId: booking.roomId,\n        noOfGuests: booking.adults || 1,\n        status: booking.status || \"confirmed\",\n        source: booking.source || \"website\",\n      };\n\n      const response = await fetch(`${this.baseUrl}/putBooking`, {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify(payload),\n      });\n\n      return response.ok;\n    } catch (error) {\n      console.error(\"Beds24 booking sync failed:\", error);\n      return false;\n    }\n  }\n\n  /**\n   * Cancel a booking in Beds24.\n   * Called when a booking is cancelled on the website.\n   */\n  async cancelBooking(externalBookingId: string): Promise<boolean> {\n    if (!this.isConfigured()) {\n      console.warn(\"Channel manager not configured, skipping booking cancellation\");\n      return false;\n    }\n\n    try {\n      const params = new URLSearchParams({\n        apiKey: this.apiKey,\n        propid: this.propertyId,\n        bookid: externalBookingId,\n      });\n\n      const response = await fetch(`${this.baseUrl}/delBooking?${params}`, {\n        method: \"DELETE\",\n      });\n\n      return response.ok;\n    } catch (error) {\n      console.error(\"Beds24 booking cancellation failed:\", error);\n      return false;\n    }\n  }\n\n  /**\n   * Validate webhook payload using shared secret.\n   * Beds24 includes X-Beds24-Signature header for verification.\n   */\n  validateWebhook(payload: string, signature: string | null): boolean {\n    if (!signature) return false;\n\n    const crypto = require(\"crypto\");\n    const hmac = crypto.createHmac(\n      \"sha256\",\n      CHANNEL_MANAGER_CONFIG.webhook.secret,\n    );\n    hmac.update(payload);\n    const computed = hmac.digest(\"hex\");\n\n    return computed === signature;\n  }\n\n  private isConfigured(): boolean {\n    return this.apiKey !== \"\" && this.propertyId !== \"\";\n  }\n\n  private parseAvailabilityResponse(\n    data: Record<string, unknown>,\n  ): ChannelManagerAvailability[] {\n    // Parse Beds24 API response format\n    // This is a placeholder implementation - adjust based on actual Beds24 API response\n    return [];\n  }\n\n  private getPlaceholderAvailability(\n    checkin: string,\n    checkout: string,\n  ): ChannelManagerAvailability[] {\n    // Return placeholder data when channel manager is not configured\n    const nights = Math.ceil(\n      (new Date(checkout).getTime() - new Date(checkin).getTime()) /\n        (1000 * 60 * 60 * 24),\n    );\n\n    return [\n      {\n        roomId: \"standard-capsule\",\n        roomName: \"Standard Capsule Pod\",\n        checkin,\n        checkout,\n        available: 18,\n        total: 18,\n        rate: 35 * nights,\n        currency: \"MYR\",\n      },\n      {\n        roomId: \"premium-capsule\",\n        roomName: \"Premium Capsule Pod\",\n        checkin,\n        checkout,\n        available: 6,\n        total: 6,\n        rate: 45 * nights,\n        currency: \"MYR\",\n      },\n    ];\n  }\n}\n\nexport const beds24Client = new Beds24Client();\n","structuredPatch":[],"originalFile":null}}
{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01HHUoLf6RLt6qpW5S6HSuEK","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"Now let me create the webhook handler for Beds24.","signature":""}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":1736,"cache_read_input_tokens":93345,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1736},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"e6d90c97-f395-42af-a0ca-354a9893adb6","uuid":"d060ab7e-0a67-4c68-b538-e51147bd7b74"}
{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01HHUoLf6RLt6qpW5S6HSuEK","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_016i6HhZi3kvt6VkJhhuAzeU","name":"Write","input":{"file_path":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\app\\api\\webhooks\\beds24\\route.ts","content":"import { NextResponse } from \"next/server\";\nimport type { NextRequest } from \"next/server\";\nimport { beds24Client } from \"@/lib/beds24-client\";\nimport type { ChannelManagerWebhookPayload } from \"@/lib/channel-manager-types\";\n\n/**\n * Webhook endpoint for Beds24 events.\n * Receives real-time updates for availability and booking changes.\n *\n * Beds24 sends webhooks to this endpoint when:\n * - Availability/rates change in the channel manager\n * - New bookings arrive from OTAs\n * - Bookings are cancelled\n *\n * Headers:\n *   X-Beds24-Signature: HMAC-SHA256 signature for validation\n */\nexport async function POST(request: NextRequest) {\n  try {\n    const rawBody = await request.text();\n    const signature = request.headers.get(\"x-beds24-signature\");\n\n    // Validate webhook authenticity\n    if (!beds24Client.validateWebhook(rawBody, signature)) {\n      console.warn(\"Invalid Beds24 webhook signature\");\n      return NextResponse.json({ error: \"Unauthorized\" }, { status: 401 });\n    }\n\n    const payload: ChannelManagerWebhookPayload = JSON.parse(rawBody);\n\n    // Handle different event types\n    switch (payload.eventType) {\n      case \"availability_update\":\n        // TODO: Update local availability cache\n        // When availability changes in Beds24, sync to website database\n        console.info(\"Availability update received:\", payload.data);\n        return NextResponse.json({ status: \"processed\" });\n\n      case \"booking_created\":\n        // TODO: Create local booking record\n        // When a booking comes from OTA, sync to website booking system\n        console.info(\"Booking created from OTA:\", payload.data);\n        return NextResponse.json({ status: \"processed\" });\n\n      case \"booking_cancelled\":\n        // TODO: Cancel local booking record\n        // When an OTA booking is cancelled, mark as cancelled locally\n        console.info(\"Booking cancelled:\", payload.data);\n        return NextResponse.json({ status: \"processed\" });\n\n      default:\n        console.warn(\"Unknown webhook event type:\", payload.eventType);\n        return NextResponse.json(\n          { error: \"Unknown event type\" },\n          { status: 400 },\n        );\n    }\n  } catch (error) {\n    console.error(\"Webhook processing error:\", error);\n    return NextResponse.json(\n      { error: \"Webhook processing failed\" },\n      { status: 500 },\n    );\n  }\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":1736,"cache_read_input_tokens":93345,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1736},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"e6d90c97-f395-42af-a0ca-354a9893adb6","uuid":"f1cee208-194a-4413-a1c3-7bef9e798ae7"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016i6HhZi3kvt6VkJhhuAzeU","type":"tool_result","content":"File created successfully at: C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\app\\api\\webhooks\\beds24\\route.ts"}]},"parent_tool_use_id":null,"session_id":"e6d90c97-f395-42af-a0ca-354a9893adb6","uuid":"06cbf5be-ed07-43c2-bac4-8cbfd2e89c15","timestamp":"2026-04-13T19:21:16.571Z","tool_use_result":{"type":"create","filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\app\\api\\webhooks\\beds24\\route.ts","content":"import { NextResponse } from \"next/server\";\nimport type { NextRequest } from \"next/server\";\nimport { beds24Client } from \"@/lib/beds24-client\";\nimport type { ChannelManagerWebhookPayload } from \"@/lib/channel-manager-types\";\n\n/**\n * Webhook endpoint for Beds24 events.\n * Receives real-time updates for availability and booking changes.\n *\n * Beds24 sends webhooks to this endpoint when:\n * - Availability/rates change in the channel manager\n * - New bookings arrive from OTAs\n * - Bookings are cancelled\n *\n * Headers:\n *   X-Beds24-Signature: HMAC-SHA256 signature for validation\n */\nexport async function POST(request: NextRequest) {\n  try {\n    const rawBody = await request.text();\n    const signature = request.headers.get(\"x-beds24-signature\");\n\n    // Validate webhook authenticity\n    if (!beds24Client.validateWebhook(rawBody, signature)) {\n      console.warn(\"Invalid Beds24 webhook signature\");\n      return NextResponse.json({ error: \"Unauthorized\" }, { status: 401 });\n    }\n\n    const payload: ChannelManagerWebhookPayload = JSON.parse(rawBody);\n\n    // Handle different event types\n    switch (payload.eventType) {\n      case \"availability_update\":\n        // TODO: Update local availability cache\n        // When availability changes in Beds24, sync to website database\n        console.info(\"Availability update received:\", payload.data);\n        return NextResponse.json({ status: \"processed\" });\n\n      case \"booking_created\":\n        // TODO: Create local booking record\n        // When a booking comes from OTA, sync to website booking system\n        console.info(\"Booking created from OTA:\", payload.data);\n        return NextResponse.json({ status: \"processed\" });\n\n      case \"booking_cancelled\":\n        // TODO: Cancel local booking record\n        // When an OTA booking is cancelled, mark as cancelled locally\n        console.info(\"Booking cancelled:\", payload.data);\n        return NextResponse.json({ status: \"processed\" });\n\n      default:\n        console.warn(\"Unknown webhook event type:\", payload.eventType);\n        return NextResponse.json(\n          { error: \"Unknown event type\" },\n          { status: 400 },\n        );\n    }\n  } catch (error) {\n    console.error(\"Webhook processing error:\", error);\n    return NextResponse.json(\n      { error: \"Webhook processing failed\" },\n      { status: 500 },\n    );\n  }\n}\n","structuredPatch":[],"originalFile":null}}
{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01QHaFth1v4bNCwk7pPNVABd","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"Now let me create the booking sync endpoint.","signature":""}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":824,"cache_read_input_tokens":95081,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":824},"output_tokens":5,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"e6d90c97-f395-42af-a0ca-354a9893adb6","uuid":"e3c4ea4c-08a8-452b-8656-3dda22c3d09b"}
{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01QHaFth1v4bNCwk7pPNVABd","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018paQ4aXxHkKdEA5TTyXYry","name":"Write","input":{"file_path":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\app\\api\\bookings\\sync\\route.ts","content":"import { NextResponse } from \"next/server\";\nimport type { NextRequest } from \"next/server\";\nimport { beds24Client } from \"@/lib/beds24-client\";\nimport type { ChannelManagerBooking } from \"@/lib/channel-manager-types\";\n\n/**\n * Booking sync endpoint.\n * Called when a booking is created on the website to sync it to Beds24.\n *\n * This ensures that:\n * 1. Website bookings reduce availability on all OTAs in real-time\n * 2. Bookings are tracked in the channel manager for central management\n * 3. Rate parity is maintained across all distribution channels\n *\n * POST /api/bookings/sync\n * Body: { booking data }\n */\nexport async function POST(request: NextRequest) {\n  try {\n    const body = await request.json();\n\n    // Validate required fields\n    const { checkIn, checkOut, roomType, guestName, guestEmail, guestPhone } = body;\n\n    if (\n      !checkIn ||\n      !checkOut ||\n      !roomType ||\n      !guestName ||\n      !guestEmail ||\n      !guestPhone\n    ) {\n      return NextResponse.json(\n        { error: \"Missing required booking fields\" },\n        { status: 400 },\n      );\n    }\n\n    // Calculate nights and validate dates\n    const checkin = new Date(checkIn);\n    const checkout = new Date(checkOut);\n\n    if (isNaN(checkin.getTime()) || isNaN(checkout.getTime())) {\n      return NextResponse.json(\n        { error: \"Invalid date format\" },\n        { status: 400 },\n      );\n    }\n\n    if (checkout <= checkin) {\n      return NextResponse.json(\n        { error: \"Invalid date range\" },\n        { status: 400 },\n      );\n    }\n\n    const nights = Math.ceil(\n      (checkout.getTime() - checkin.getTime()) / (1000 * 60 * 60 * 24),\n    );\n\n    // Map room type to room ID\n    const roomId = roomType === \"Premium Capsule Pod\" ? \"premium-capsule\" : \"standard-capsule\";\n    const rate = roomType === \"Premium Capsule Pod\" ? 45 : 35;\n\n    // Create booking object for channel manager\n    const booking: Partial<ChannelManagerBooking> = {\n      roomId,\n      guestName,\n      guestEmail,\n      guestPhone,\n      checkin: checkin.toISOString().split(\"T\")[0],\n      checkout: checkout.toISOString().split(\"T\")[0],\n      nights,\n      adults: body.adults || 1,\n      children: body.children,\n      totalPrice: rate * nights,\n      currency: \"MYR\",\n      status: \"confirmed\",\n      source: \"website\",\n      createdAt: new Date().toISOString(),\n    };\n\n    // Sync to Beds24\n    const synced = await beds24Client.syncBooking(booking);\n\n    if (!synced) {\n      console.warn(\"Failed to sync booking to channel manager, proceeding anyway\");\n      // Don't fail the website booking if sync fails - log it for manual review\n    }\n\n    return NextResponse.json({\n      success: true,\n      synced,\n      booking: {\n        checkIn,\n        checkOut,\n        roomType,\n        nights,\n        totalPrice: booking.totalPrice,\n        currency: \"MYR\",\n      },\n    });\n  } catch (error) {\n    console.error(\"Booking sync error:\", error);\n    return NextResponse.json(\n      { error: \"Booking sync failed\" },\n      { status: 500 },\n    );\n  }\n}\n\n/**\n * GET /api/bookings/sync?action=check&checkin=YYYY-MM-DD&checkout=YYYY-MM-DD&roomId=standard-capsule\n * Check availability before confirming a booking (prevent overbookings).\n */\nexport async function GET(request: NextRequest) {\n  const params = request.nextUrl.searchParams;\n  const action = params.get(\"action\");\n\n  if (action === \"check\") {\n    const checkin = params.get(\"checkin\");\n    const checkout = params.get(\"checkout\");\n    const roomId = params.get(\"roomId\");\n\n    if (!checkin || !checkout || !roomId) {\n      return NextResponse.json(\n        { error: \"Missing required parameters: checkin, checkout, roomId\" },\n        { status: 400 },\n      );\n    }\n\n    // Fetch real-time availability from Beds24\n    const availability = await beds24Client.getAvailability(checkin, checkout);\n    const room = availability.find((a) => a.roomId === roomId);\n\n    if (!room) {\n      return NextResponse.json(\n        { available: false, reason: \"Room not found\" },\n        { status: 404 },\n      );\n    }\n\n    return NextResponse.json({\n      available: room.available > 0,\n      availableUnits: room.available,\n      totalUnits: room.total,\n      rate: room.rate,\n      currency: room.currency,\n    });\n  }\n\n  return NextResponse.json({ error: \"Invalid action\" }, { status: 400 });\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":824,"cache_read_input_tokens":95081,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":824},"output_tokens":5,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"e6d90c97-f395-42af-a0ca-354a9893adb6","uuid":"80c6fc24-9443-4aba-bbbe-aaeb00576569"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018paQ4aXxHkKdEA5TTyXYry","type":"tool_result","content":"File created successfully at: C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\app\\api\\bookings\\sync\\route.ts"}]},"parent_tool_use_id":null,"session_id":"e6d90c97-f395-42af-a0ca-354a9893adb6","uuid":"df90343f-7b75-4fe1-9c85-3bc8547551ef","timestamp":"2026-04-13T19:21:26.611Z","tool_use_result":{"type":"create","filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\app\\api\\bookings\\sync\\route.ts","content":"import { NextResponse } from \"next/server\";\nimport type { NextRequest } from \"next/server\";\nimport { beds24Client } from \"@/lib/beds24-client\";\nimport type { ChannelManagerBooking } from \"@/lib/channel-manager-types\";\n\n/**\n * Booking sync endpoint.\n * Called when a booking is created on the website to sync it to Beds24.\n *\n * This ensures that:\n * 1. Website bookings reduce availability on all OTAs in real-time\n * 2. Bookings are tracked in the channel manager for central management\n * 3. Rate parity is maintained across all distribution channels\n *\n * POST /api/bookings/sync\n * Body: { booking data }\n */\nexport async function POST(request: NextRequest) {\n  try {\n    const body = await request.json();\n\n    // Validate required fields\n    const { checkIn, checkOut, roomType, guestName, guestEmail, guestPhone } = body;\n\n    if (\n      !checkIn ||\n      !checkOut ||\n      !roomType ||\n      !guestName ||\n      !guestEmail ||\n      !guestPhone\n    ) {\n      return NextResponse.json(\n        { error: \"Missing required booking fields\" },\n        { status: 400 },\n      );\n    }\n\n    // Calculate nights and validate dates\n    const checkin = new Date(checkIn);\n    const checkout = new Date(checkOut);\n\n    if (isNaN(checkin.getTime()) || isNaN(checkout.getTime())) {\n      return NextResponse.json(\n        { error: \"Invalid date format\" },\n        { status: 400 },\n      );\n    }\n\n    if (checkout <= checkin) {\n      return NextResponse.json(\n        { error: \"Invalid date range\" },\n        { status: 400 },\n      );\n    }\n\n    const nights = Math.ceil(\n      (checkout.getTime() - checkin.getTime()) / (1000 * 60 * 60 * 24),\n    );\n\n    // Map room type to room ID\n    const roomId = roomType === \"Premium Capsule Pod\" ? \"premium-capsule\" : \"standard-capsule\";\n    const rate = roomType === \"Premium Capsule Pod\" ? 45 : 35;\n\n    // Create booking object for channel manager\n    const booking: Partial<ChannelManagerBooking> = {\n      roomId,\n      guestName,\n      guestEmail,\n      guestPhone,\n      checkin: checkin.toISOString().split(\"T\")[0],\n      checkout: checkout.toISOString().split(\"T\")[0],\n      nights,\n      adults: body.adults || 1,\n      children: body.children,\n      totalPrice: rate * nights,\n      currency: \"MYR\",\n      status: \"confirmed\",\n      source: \"website\",\n      createdAt: new Date().toISOString(),\n    };\n\n    // Sync to Beds24\n    const synced = await beds24Client.syncBooking(booking);\n\n    if (!synced) {\n      console.warn(\"Failed to sync booking to channel manager, proceeding anyway\");\n      // Don't fail the website booking if sync fails - log it for manual review\n    }\n\n    return NextResponse.json({\n      success: true,\n      synced,\n      booking: {\n        checkIn,\n        checkOut,\n        roomType,\n        nights,\n        totalPrice: booking.totalPrice,\n        currency: \"MYR\",\n      },\n    });\n  } catch (error) {\n    console.error(\"Booking sync error:\", error);\n    return NextResponse.json(\n      { error: \"Booking sync failed\" },\n      { status: 500 },\n    );\n  }\n}\n\n/**\n * GET /api/bookings/sync?action=check&checkin=YYYY-MM-DD&checkout=YYYY-MM-DD&roomId=standard-capsule\n * Check availability before confirming a booking (prevent overbookings).\n */\nexport async function GET(request: NextRequest) {\n  const params = request.nextUrl.searchParams;\n  const action = params.get(\"action\");\n\n  if (action === \"check\") {\n    const checkin = params.get(\"checkin\");\n    const checkout = params.get(\"checkout\");\n    const roomId = params.get(\"roomId\");\n\n    if (!checkin || !checkout || !roomId) {\n      return NextResponse.json(\n        { error: \"Missing required parameters: checkin, checkout, roomId\" },\n        { status: 400 },\n      );\n    }\n\n    // Fetch real-time availability from Beds24\n    const availability = await beds24Client.getAvailability(checkin, checkout);\n    const room = availability.find((a) => a.roomId === roomId);\n\n    if (!room) {\n      return NextResponse.json(\n        { available: false, reason: \"Room not found\" },\n        { status: 404 },\n      );\n    }\n\n    return NextResponse.json({\n      available: room.available > 0,\n      availableUnits: room.available,\n      totalUnits: room.total,\n      rate: room.rate,\n      currency: room.currency,\n    });\n  }\n\n  return NextResponse.json({ error: \"Invalid action\" }, { status: 400 });\n}\n","structuredPatch":[],"originalFile":null}}
