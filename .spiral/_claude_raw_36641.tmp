 \"booking_cancelled\":\n        // TODO: Process event - update local DB, sync inventory\n        console.info(`Event ${payload.eventType}:`, payload.data);\n        return NextResponse.json({ status: \"processed\" });\n      default:\n        return NextResponse.json(\n          { error: \"Unknown event type\" },\n          { status: 400 },\n        );\n    }\n  } catch (error) {\n    console.error(\"Webhook error:\", error);\n    return NextResponse.json(\n      { error: \"Processing failed\" },\n      { status: 500 },\n    );\n  }\n}","originalFile":"import { NextResponse } from \"next/server\";\nimport type { NextRequest } from \"next/server\";\nimport { beds24Client } from \"@/lib/beds24-client\";\nimport type { ChannelManagerWebhookPayload } from \"@/lib/channel-manager-types\";\n\n/**\n * Webhook endpoint for Beds24 events.\n * Receives real-time updates for availability and booking changes.\n *\n * Beds24 sends webhooks to this endpoint when:\n * - Availability/rates change in the channel manager\n * - New bookings arrive from OTAs\n * - Bookings are cancelled\n *\n * Headers:\n *   X-Beds24-Signature: HMAC-SHA256 signature for validation\n */\nexport async function POST(request: NextRequest) {\n  try {\n    const rawBody = await request.text();\n    const signature = request.headers.get(\"x-beds24-signature\");\n\n    // Validate webhook authenticity\n    if (!beds24Client.validateWebhook(rawBody, signature)) {\n      console.warn(\"Invalid Beds24 webhook signature\");\n      return NextResponse.json({ error: \"Unauthorized\" }, { status: 401 });\n    }\n\n    const payload: ChannelManagerWebhookPayload = JSON.parse(rawBody);\n\n    // Handle different event types\n    switch (payload.eventType) {\n      case \"availability_update\":\n        // TODO: Update local availability cache\n        // When availability changes in Beds24, sync to website database\n        console.info(\"Availability update received:\", payload.data);\n        return NextResponse.json({ status: \"processed\" });\n\n      case \"booking_created\":\n        // TODO: Create local booking record\n        // When a booking comes from OTA, sync to website booking system\n        console.info(\"Booking created from OTA:\", payload.data);\n        return NextResponse.json({ status: \"processed\" });\n\n      case \"booking_cancelled\":\n        // TODO: Cancel local booking record\n        // When an OTA booking is cancelled, mark as cancelled locally\n        console.info(\"Booking cancelled:\", payload.data);\n        return NextResponse.json({ status: \"processed\" });\n\n      default:\n        console.warn(\"Unknown webhook event type:\", payload.eventType);\n        return NextResponse.json(\n          { error: \"Unknown event type\" },\n          { status: 400 },\n        );\n    }\n  } catch (error) {\n    console.error(\"Webhook processing error:\", error);\n    return NextResponse.json(\n      { error: \"Webhook processing failed\" },\n      { status: 500 },\n    );\n  }\n}\n","structuredPatch":[{"oldStart":3,"oldLines":62,"newStart":3,"newLines":36,"lines":[" import { beds24Client } from \"@/lib/beds24-client\";"," import type { ChannelManagerWebhookPayload } from \"@/lib/channel-manager-types\";"," ","-/**","- * Webhook endpoint for Beds24 events.","- * Receives real-time updates for availability and booking changes.","- *","- * Beds24 sends webhooks to this endpoint when:","- * - Availability/rates change in the channel manager","- * - New bookings arrive from OTAs","- * - Bookings are cancelled","- *","- * Headers:","- *   X-Beds24-Signature: HMAC-SHA256 signature for validation","- */","+// Webhook endpoint for Beds24 real-time updates","+// Validates signature, then processes availability/booking changes"," export async function POST(request: NextRequest) {","   try {","     const rawBody = await request.text();","     const signature = request.headers.get(\"x-beds24-signature\");"," ","-    // Validate webhook authenticity","     if (!beds24Client.validateWebhook(rawBody, signature)) {","-      console.warn(\"Invalid Beds24 webhook signature\");","       return NextResponse.json({ error: \"Unauthorized\" }, { status: 401 });","     }"," ","     const payload: ChannelManagerWebhookPayload = JSON.parse(rawBody);"," ","-    // Handle different event types","     switch (payload.eventType) {","       case \"availability_update\":","-        // TODO: Update local availability cache","-        // When availability changes in Beds24, sync to website database","-        console.info(\"Availability update received:\", payload.data);","-        return NextResponse.json({ status: \"processed\" });","-","       case \"booking_created\":","-        // TODO: Create local booking record","-        // When a booking comes from OTA, sync to website booking system","-        console.info(\"Booking created from OTA:\", payload.data);","-        return NextResponse.json({ status: \"processed\" });","-","       case \"booking_cancelled\":","-        // TODO: Cancel local booking record","-        // When an OTA booking is cancelled, mark as cancelled locally","-        console.info(\"Booking cancelled:\", payload.data);","+        // TODO: Process event - update local DB, sync inventory","+        console.info(`Event ${payload.eventType}:`, payload.data);","         return NextResponse.json({ status: \"processed\" });","-","       default:","-        console.warn(\"Unknown webhook event type:\", payload.eventType);","         return NextResponse.json(","           { error: \"Unknown event type\" },","           { status: 400 },","         );","     }","   } catch (error) {","-    console.error(\"Webhook processing error:\", error);","+    console.error(\"Webhook error:\", error);","     return NextResponse.json(","-      { error: \"Webhook processing failed\" },","+      { error: \"Processing failed\" },","       { status: 500 },","     );","   }"]}],"userModified":false,"replaceAll":true}}
{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_019xHeZsyTj5aFATrAmAHMdJ","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"Now let me simplify the booking sync endpoint.","signature":""}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":1252,"cache_read_input_tokens":109318,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1252},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"e6d90c97-f395-42af-a0ca-354a9893adb6","uuid":"1325284d-c0dc-459b-843d-16a3994a6c54"}
{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_019xHeZsyTj5aFATrAmAHMdJ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_019bLhkQ34kBRQ5bzUun6yUB","name":"Edit","input":{"replace_all":true,"file_path":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\app\\api\\bookings\\sync\\route.ts","old_string":"import { NextResponse } from \"next/server\";\nimport type { NextRequest } from \"next/server\";\nimport { beds24Client } from \"@/lib/beds24-client\";\nimport type { ChannelManagerBooking } from \"@/lib/channel-manager-types\";\n\n/**\n * Booking sync endpoint.\n * Called when a booking is created on the website to sync it to Beds24.\n *\n * This ensures that:\n * 1. Website bookings reduce availability on all OTAs in real-time\n * 2. Bookings are tracked in the channel manager for central management\n * 3. Rate parity is maintained across all distribution channels\n *\n * POST /api/bookings/sync\n * Body: { booking data }\n */\nexport async function POST(request: NextRequest) {\n  try {\n    const body = await request.json();\n\n    // Validate required fields\n    const { checkIn, checkOut, roomType, guestName, guestEmail, guestPhone } = body;\n\n    if (\n      !checkIn ||\n      !checkOut ||\n      !roomType ||\n      !guestName ||\n      !guestEmail ||\n      !guestPhone\n    ) {\n      return NextResponse.json(\n        { error: \"Missing required booking fields\" },\n        { status: 400 },\n      );\n    }\n\n    // Calculate nights and validate dates\n    const checkin = new Date(checkIn);\n    const checkout = new Date(checkOut);\n\n    if (isNaN(checkin.getTime()) || isNaN(checkout.getTime())) {\n      return NextResponse.json(\n        { error: \"Invalid date format\" },\n        { status: 400 },\n      );\n    }\n\n    if (checkout <= checkin) {\n      return NextResponse.json(\n        { error: \"Invalid date range\" },\n        { status: 400 },\n      );\n    }\n\n    const nights = Math.ceil(\n      (checkout.getTime() - checkin.getTime()) / (1000 * 60 * 60 * 24),\n    );\n\n    // Map room type to room ID\n    const roomId = roomType === \"Premium Capsule Pod\" ? \"premium-capsule\" : \"standard-capsule\";\n    const rate = roomType === \"Premium Capsule Pod\" ? 45 : 35;\n\n    // Create booking object for channel manager\n    const booking: Partial<ChannelManagerBooking> = {\n      roomId,\n      guestName,\n      guestEmail,\n      guestPhone,\n      checkin: checkin.toISOString().split(\"T\")[0],\n      checkout: checkout.toISOString().split(\"T\")[0],\n      nights,\n      adults: body.adults || 1,\n      children: body.children,\n      totalPrice: rate * nights,\n      currency: \"MYR\",\n      status: \"confirmed\",\n      source: \"website\",\n      createdAt: new Date().toISOString(),\n    };\n\n    // Sync to Beds24\n    const synced = await beds24Client.syncBooking(booking);\n\n    if (!synced) {\n      console.warn(\"Failed to sync booking to channel manager, proceeding anyway\");\n      // Don't fail the website booking if sync fails - log it for manual review\n    }\n\n    return NextResponse.json({\n      success: true,\n      synced,\n      booking: {\n        checkIn,\n        checkOut,\n        roomType,\n        nights,\n        totalPrice: booking.totalPrice,\n        currency: \"MYR\",\n      },\n    });\n  } catch (error) {\n    console.error(\"Booking sync error:\", error);\n    return NextResponse.json(\n      { error: \"Booking sync failed\" },\n      { status: 500 },\n    );\n  }\n}\n\n/**\n * GET /api/bookings/sync?action=check&checkin=YYYY-MM-DD&checkout=YYYY-MM-DD&roomId=standard-capsule\n * Check availability before confirming a booking (prevent overbookings).\n */\nexport async function GET(request: NextRequest) {\n  const params = request.nextUrl.searchParams;\n  const action = params.get(\"action\");\n\n  if (action === \"check\") {\n    const checkin = params.get(\"checkin\");\n    const checkout = params.get(\"checkout\");\n    const roomId = params.get(\"roomId\");\n\n    if (!checkin || !checkout || !roomId) {\n      return NextResponse.json(\n        { error: \"Missing required parameters: checkin, checkout, roomId\" },\n        { status: 400 },\n      );\n    }\n\n    // Fetch real-time availability from Beds24\n    const availability = await beds24Client.getAvailability(checkin, checkout);\n    const room = availability.find((a) => a.roomId === roomId);\n\n    if (!room) {\n      return NextResponse.json(\n        { available: false, reason: \"Room not found\" },\n        { status: 404 },\n      );\n    }\n\n    return NextResponse.json({\n      available: room.available > 0,\n      availableUnits: room.available,\n      totalUnits: room.total,\n      rate: room.rate,\n      currency: room.currency,\n    });\n  }\n\n  return NextResponse.json({ error: \"Invalid action\" }, { status: 400 });\n}","new_string":"import { NextResponse } from \"next/server\";\nimport type { NextRequest } from \"next/server\";\nimport { beds24Client } from \"@/lib/beds24-client\";\nimport type { ChannelManagerBooking } from \"@/lib/channel-manager-types\";\n\n// POST: Sync booking to channel manager\nexport async function POST(request: NextRequest) {\n  try {\n    const body = await request.json();\n    const { checkIn, checkOut, roomType, guestName, guestEmail, guestPhone } = body;\n\n    if (!checkIn || !checkOut || !roomType || !guestName || !guestEmail || !guestPhone) {\n      return NextResponse.json({ error: \"Missing fields\" }, { status: 400 });\n    }\n\n    const checkin = new Date(checkIn);\n    const checkout = new Date(checkOut);\n    if (isNaN(checkin.getTime()) || isNaN(checkout.getTime()) || checkout <= checkin) {\n      return NextResponse.json({ error: \"Invalid dates\" }, { status: 400 });\n    }\n\n    const nights = Math.ceil(\n      (checkout.getTime() - checkin.getTime()) / (1000 * 60 * 60 * 24),\n    );\n\n    const isPremium = roomType === \"Premium Capsule Pod\";\n    const booking: Partial<ChannelManagerBooking> = {\n      roomId: isPremium ? \"premium-capsule\" : \"standard-capsule\",\n      guestName,\n      guestEmail,\n      guestPhone,\n      checkin: checkin.toISOString().split(\"T\")[0],\n      checkout: checkout.toISOString().split(\"T\")[0],\n      nights,\n      adults: body.adults || 1,\n      totalPrice: (isPremium ? 45 : 35) * nights,\n      currency: \"MYR\",\n      status: \"confirmed\",\n      source: \"website\",\n      createdAt: new Date().toISOString(),\n    };\n\n    const synced = await beds24Client.syncBooking(booking);\n    return NextResponse.json({ success: true, synced });\n  } catch (error) {\n    console.error(\"Sync error:\", error);\n    return NextResponse.json({ error: \"Failed\" }, { status: 500 });\n  }\n}\n\n// GET: Check availability\nexport async function GET(request: NextRequest) {\n  const params = request.nextUrl.searchParams;\n  if (params.get(\"action\") !== \"check\") {\n    return NextResponse.json({ error: \"Invalid action\" }, { status: 400 });\n  }\n\n  const checkin = params.get(\"checkin\");\n  const checkout = params.get(\"checkout\");\n  const roomId = params.get(\"roomId\");\n\n  if (!checkin || !checkout || !roomId) {\n    return NextResponse.json({ error: \"Missing params\" }, { status: 400 });\n  }\n\n  const availability = await beds24Client.getAvailability(checkin, checkout);\n  const room = availability.find((a) => a.roomId === roomId);\n\n  if (!room) {\n    return NextResponse.json({ available: false }, { status: 404 });\n  }\n\n  return NextResponse.json({\n    available: room.available > 0,\n    availableUnits: room.available,\n    totalUnits: room.total,\n    rate: room.rate,\n    currency: room.currency,\n  });\n}"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":1252,"cache_read_input_tokens":109318,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1252},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"e6d90c97-f395-42af-a0ca-354a9893adb6","uuid":"c8e339e1-d8c4-44c4-a69f-6d7d89fecc26"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019bLhkQ34kBRQ5bzUun6yUB","type":"tool_result","content":"The file C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\app\\api\\bookings\\sync\\route.ts has been updated. All occurrences were successfully replaced."}]},"parent_tool_use_id":null,"session_id":"e6d90c97-f395-42af-a0ca-354a9893adb6","uuid":"29de1af6-7ed8-4bd8-a6fd-1602e0ba4e8b","timestamp":"2026-04-13T19:24:24.161Z","tool_use_result":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\app\\api\\bookings\\sync\\route.ts","oldString":"import { NextResponse } from \"next/server\";\nimport type { NextRequest } from \"next/server\";\nimport { beds24Client } from \"@/lib/beds24-client\";\nimport type { ChannelManagerBooking } from \"@/lib/channel-manager-types\";\n\n/**\n * Booking sync endpoint.\n * Called when a booking is created on the website to sync it to Beds24.\n *\n * This ensures that:\n * 1. Website bookings reduce availability on all OTAs in real-time\n * 2. Bookings are tracked in the channel manager for central management\n * 3. Rate parity is maintained across all distribution channels\n *\n * POST /api/bookings/sync\n * Body: { booking data }\n */\nexport async function POST(request: NextRequest) {\n  try {\n    const body = await request.json();\n\n    // Validate required fields\n    const { checkIn, checkOut, roomType, guestName, guestEmail, guestPhone } = body;\n\n    if (\n      !checkIn ||\n      !checkOut ||\n      !roomType ||\n      !guestName ||\n      !guestEmail ||\n      !guestPhone\n    ) {\n      return NextResponse.json(\n        { error: \"Missing required booking fields\" },\n        { status: 400 },\n      );\n    }\n\n    // Calculate nights and validate dates\n    const checkin = new Date(checkIn);\n    const checkout = new Date(checkOut);\n\n    if (isNaN(checkin.getTime()) || isNaN(checkout.getTime())) {\n      return NextResponse.json(\n        { error: \"Invalid date format\" },\n        { status: 400 },\n      );\n    }\n\n    if (checkout <= checkin) {\n      return NextResponse.json(\n        { error: \"Invalid date range\" },\n        { status: 400 },\n      );\n    }\n\n    const nights = Math.ceil(\n      (checkout.getTime() - checkin.getTime()) / (1000 * 60 * 60 * 24),\n    );\n\n    // Map room type to room ID\n    const roomId = roomType === \"Premium Capsule Pod\" ? \"premium-capsule\" : \"standard-capsule\";\n    const rate = roomType === \"Premium Capsule Pod\" ? 45 : 35;\n\n    // Create booking object for channel manager\n    const booking: Partial<ChannelManagerBooking> = {\n      roomId,\n      guestName,\n      guestEmail,\n      guestPhone,\n      checkin: checkin.toISOString().split(\"T\")[0],\n      checkout: checkout.toISOString().split(\"T\")[0],\n      nights,\n      adults: body.adults || 1,\n      children: body.children,\n      totalPrice: rate * nights,\n      currency: \"MYR\",\n      status: \"confirmed\",\n      source: \"website\",\n      createdAt: new Date().toISOString(),\n    };\n\n    // Sync to Beds24\n    const synced = await beds24Client.syncBooking(booking);\n\n    if (!synced) {\n      console.warn(\"Failed to sync booking to channel manager, proceeding anyway\");\n      // Don't fail the website booking if sync fails - log it for manual review\n    }\n\n    return NextResponse.json({\n      success: true,\n      synced,\n      booking: {\n        checkIn,\n        checkOut,\n        roomType,\n        nights,\n        totalPrice: booking.totalPrice,\n        currency: \"MYR\",\n      },\n    });\n  } catch (error) {\n    console.error(\"Booking sync error:\", error);\n    return NextResponse.json(\n      { error: \"Booking sync failed\" },\n      { status: 500 },\n    );\n  }\n}\n\n/**\n * GET /api/bookings/sync?action=check&checkin=YYYY-MM-DD&checkout=YYYY-MM-DD&roomId=standard-capsule\n * Check availability before confirming a booking (prevent overbookings).\n */\nexport async function GET(request: NextRequest) {\n  const params = request.nextUrl.searchParams;\n  const action = params.get(\"action\");\n\n  if (action === \"check\") {\n    const checkin = params.get(\"checkin\");\n    const checkout = params.get(\"checkout\");\n    const roomId = params.get(\"roomId\");\n\n    if (!checkin || !checkout || !roomId) {\n      return NextResponse.json(\n        { error: \"Missing required parameters: checkin, checkout, roomId\" },\n        { status: 400 },\n      );\n    }\n\n    // Fetch real-time availability from Beds24\n    const availability = await beds24Client.getAvailability(checkin, checkout);\n    const room = availability.find((a) => a.roomId === roomId);\n\n    if (!room) {\n      return NextResponse.json(\n        { available: false, reason: \"Room not found\" },\n        { status: 404 },\n      );\n    }\n\n    return NextResponse.json({\n      available: room.available > 0,\n      availableUnits: room.available,\n      totalUnits: room.total,\n      rate: room.rate,\n      currency: room.currency,\n    });\n  }\n\n  return NextResponse.json({ error: \"Invalid action\" }, { status: 400 });\n}","newString":"import { NextResponse } from \"next/server\";\nimport type { NextRequest } from \"next/server\";\nimport { beds24Client } from \"@/lib/beds24-client\";\nimport type { ChannelManagerBooking } from \"@/lib/channel-manager-types\";\n\n// POST: Sync booking to channel manager\nexport async function POST(request: NextRequest) {\n  try {\n    const body = await request.json();\n    const { checkIn, checkOut, roomType, guestName, guestEmail, guestPhone } = body;\n\n    if (!checkIn || !checkOut || !roomType || !guestName || !guestEmail || !guestPhone) {\n      return NextResponse.json({ error: \"Missing fields\" }, { status: 400 });\n    }\n\n    const checkin = new Date(checkIn);\n    const checkout = new Date(checkOut);\n    if (isNaN(checkin.getTime()) || isNaN(checkout.getTime()) || checkout <= checkin) {\n      return NextResponse.json({ error: \"Invalid dates\" }, { status: 400 });\n    }\n\n    const nights = Math.ceil(\n      (checkout.getTime() - checkin.getTime()) / (1000 * 60 * 60 * 24),\n    );\n\n    const isPremium = roomType === \"Premium Capsule Pod\";\n    const booking: Partial<ChannelManagerBooking> = {\n      roomId: isPremium ? \"premium-capsule\" : \"standard-capsule\",\n      guestName,\n      guestEmail,\n      guestPhone,\n      checkin: checkin.toISOString().split(\"T\")[0],\n      checkout: checkout.toISOString().split(\"T\")[0],\n      nights,\n      adults: body.adults || 1,\n      totalPrice: (isPremium ? 45 : 35) * nights,\n      currency: \"MYR\",\n      status: \"confirmed\",\n      source: \"website\",\n      createdAt: new Date().toISOString(),\n    };\n\n    const synced = await beds24Client.syncBooking(booking);\n    return NextResponse.json({ success: true, synced });\n  } catch (error) {\n    console.error(\"Sync error:\", error);\n    return NextResponse.json({ error: \"Failed\" }, { status: 500 });\n  }\n}\n\n// GET: Check availability\nexport async function GET(request: NextRequest) {\n  const params = request.nextUrl.searchParams;\n  if (params.get(\"action\") !== \"check\") {\n    return NextResponse.json({ error: \"Invalid action\" }, { status: 400 });\n  }\n\n  const checkin = params.get(\"checkin\");\n  const checkout = params.get(\"checkout\");\n  const roomId = params.get(\"roomId\");\n\n  if (!checkin || !checkout || !roomId) {\n    return NextResponse.json({ error: \"Missing params\" }, { status: 400 });\n  }\n\n  const availability = await beds24Client.getAvailability(checkin, checkout);\n  const room = availability.find((a) => a.roomId === roomId);\n\n  if (!room) {\n    return NextResponse.json({ available: false }, { status: 404 });\n  }\n\n  return NextResponse.json({\n    available: room.available > 0,\n    availableUnits: room.available,\n    totalUnits: room.total,\n    rate: room.rate,\n    currency: room.currency,\n  });\n}","originalFile":"import { NextResponse } from \"next/server\";\nimport type { NextRequest } from \"next/server\";\nimport { beds24Client } from \"@/lib/beds24-client\";\nimport type { ChannelManagerBooking } from \"@/lib/channel-manager-types\";\n\n/**\n * Booking sync endpoint.\n * Called when a booking is created on the website to sync it to Beds24.\n *\n * This ensures that:\n * 1. Website bookings reduce availability on all OTAs in real-time\n * 2. Bookings are tracked in the channel manager for central management\n * 3. Rate parity is maintained across all distribution channels\n *\n * POST /api/bookings/sync\n * Body: { booking data }\n */\nexport async function POST(request: NextRequest) {\n  try {\n    const body = await request.json();\n\n    // Validate required fields\n    const { checkIn, checkOut, roomType, guestName, guestEmail, guestPhone } = body;\n\n    if (\n      !checkIn ||\n      !checkOut ||\n      !roomType ||\n      !guestName ||\n      !guestEmail ||\n      !guestPhone\n    ) {\n      return NextResponse.json(\n        { error: \"Missing required booking fields\" },\n        { status: 400 },\n      );\n    }\n\n    // Calculate nights and validate dates\n    const checkin = new Date(checkIn);\n    const checkout = new Date(checkOut);\n\n    if (isNaN(checkin.getTime()) || isNaN(checkout.getTime())) {\n      return NextResponse.json(\n        { error: \"Invalid date format\" },\n        { status: 400 },\n      );\n    }\n\n    if (checkout <= checkin) {\n      return NextResponse.json(\n        { error: \"Invalid date range\" },\n        { status: 400 },\n      );\n    }\n\n    const nights = Math.ceil(\n      (checkout.getTime() - checkin.getTime()) / (1000 * 60 * 60 * 24),\n    );\n\n    // Map room type to room ID\n    const roomId = roomType === \"Premium Capsule Pod\" ? \"premium-capsule\" : \"standard-capsule\";\n    const rate = roomType === \"Premium Capsule Pod\" ? 45 : 35;\n\n    // Create booking object for channel manager\n    const booking: Partial<ChannelManagerBooking> = {\n      roomId,\n      guestName,\n      guestEmail,\n      guestPhone,\n      checkin: checkin.toISOString().split(\"T\")[0],\n      checkout: checkout.toISOString().split(\"T\")[0],\n      nights,\n      adults: body.adults || 1,\n      children: body.children,\n      totalPrice: rate * nights,\n      currency: \"MYR\",\n      status: \"confirmed\",\n      source: \"website\",\n      createdAt: new Date().toISOString(),\n    };\n\n    // Sync to Beds24\n    const synced = await beds24Client.syncBooking(booking);\n\n    if (!synced) {\n      console.warn(\"Failed to sync booking to channel manager, proceeding anyway\");\n      // Don't fail the website booking if sync fails - log it for manual review\n    }\n\n    return NextResponse.json({\n      success: true,\n      synced,\n      booking: {\n        checkIn,\n        checkOut,\n        roomType,\n        nights,\n        totalPrice: booking.totalPrice,\n        currency: \"MYR\",\n      },\n    });\n  } catch (error) {\n    console.error(\"Booking sync error:\", error);\n    return NextResponse.json(\n      { error: \"Booking sync failed\" },\n      { status: 500 },\n    );\n  }\n}\n\n/**\n * GET /api/bookings/sync?action=check&checkin=YYYY-MM-DD&checkout=YYYY-MM-DD&roomId=standard-capsule\n * Check availability before confirming a booking (prevent overbookings).\n */\nexport async function GET(request: NextRequest) {\n  const params = request.nextUrl.searchParams;\n  const action = params.get(\"action\");\n\n  if (action === \"check\") {\n    const checkin = params.get(\"checkin\");\n    const checkout = params.get(\"checkout\");\n    const roomId = params.get(\"roomId\");\n\n    if (!checkin || !checkout || !roomId) {\n      return NextResponse.json(\n        { error: \"Missing required parameters: checkin, checkout, roomId\" },\n        { status: 400 },\n      );\n    }\n\n    // Fetch real-time availability from Beds24\n    const availability = await beds24Client.getAvailability(checkin, checkout);\n    const room = availability.find((a) => a.roomId === roomId);\n\n    if (!room) {\n      return NextResponse.json(\n        { available: false, reason: \"Room not found\" },\n        { status: 404 },\n      );\n    }\n\n    return NextResponse.json({\n      available: room.available > 0,\n      availableUnits: room.available,\n      totalUnits: room.total,\n      rate: room.rate,\n      currency: room.currency,\n    });\n  }\n\n  return NextResponse.json({ error: \"Invalid action\" }, { status: 400 });\n}\n","structuredPatch":[{"oldStart":3,"oldLines":68,"newStart":3,"newLines":29,"lines":[" import { beds24Client } from \"@/lib/beds24-client\";"," import type { ChannelManagerBooking } from \"@/lib/channel-manager-types\";"," ","-/**","- * Booking sync endpoint.","- * Called when a booking is created on the website to sync it to Beds24.","- *","- * This ensures that:","- * 1. Website bookings reduce availability on all OTAs in real-time","- * 2. Bookings are tracked in the channel manager for central management","- * 3. Rate parity is maintained across all distribution channels","- *","- * POST /api/bookings/sync","- * Body: { booking data }","- */","+// POST: Sync booking to channel manager"," export async function POST(request: NextRequest) {","   try {","     const body = await request.json();","-","-    // Validate required fields","     const { checkIn, checkOut, roomType, guestName, guestEmail, guestPhone } = body;"," ","-    if (","-      !checkIn ||","-      !checkOut ||","-      !roomType ||","-      !guestName ||","-      !guestEmail ||","-      !guestPhone","-    ) {","-      return NextResponse.json(","-        { error: \"Missing required booking fields\" },","-        { status: 400 },","-      );","+    if (!checkIn || !checkOut || !roomType || !guestName || !guestEmail || !guestPhone) {","+      return NextResponse.json({ error: \"Missing fields\" }, { status: 400 });","     }",