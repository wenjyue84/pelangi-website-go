{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_014nWLDc5kXEWtCx4db2N3YW","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01TUDHtLXEfQMA35p2GZn8GH","name":"Edit","input":{"replace_all":true,"file_path":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\lib\\beds24-client.ts","old_string":"/**\n * Beds24 API Client for channel manager integration.\n * Handles API communication with Beds24 for ARI (Availability, Rate, Inventory) sync.\n */\n\nimport { createHmac } from \"crypto\";\nimport { CHANNEL_MANAGER_CONFIG } from \"@/config/channel-manager\";\nimport type { ChannelManagerAvailability, ChannelManagerBooking } from \"./channel-manager-types\";\n\nexport class Beds24Client {\n  private apiKey: string;\n  private propertyId: string;\n  private baseUrl: string;\n\n  constructor() {\n    this.apiKey = CHANNEL_MANAGER_CONFIG.beds24.apiKey;\n    this.propertyId = CHANNEL_MANAGER_CONFIG.beds24.propertyId;\n    this.baseUrl = CHANNEL_MANAGER_CONFIG.beds24.apiBaseUrl;\n  }\n\n  /**\n   * Fetch availability from Beds24 for a given date range.\n   * Returns inventory and rates for each room type.\n   */\n  async getAvailability(\n    checkin: string,\n    checkout: string,\n  ): Promise<ChannelManagerAvailability[]> {\n    if (!this.isConfigured()) {\n      return this.getPlaceholderAvailability(checkin, checkout);\n    }\n\n    try {\n      const params = new URLSearchParams({\n        apiKey: this.apiKey,\n        propid: this.propertyId,\n        checkin,\n        checkout,\n      });\n\n      const response = await fetch(`${this.baseUrl}/getAvailability?${params}`, {\n        cache: \"no-store\",\n      });\n\n      if (!response.ok) {\n        console.error(\"Beds24 API error:\", response.statusText);\n        return this.getPlaceholderAvailability(checkin, checkout);\n      }\n\n      const data = await response.json();\n      return this.parseAvailabilityResponse(data);\n    } catch (error) {\n      console.error(\"Beds24 availability fetch failed:\", error);\n      return this.getPlaceholderAvailability(checkin, checkout);\n    }\n  }\n\n  /**\n   * Sync a new booking to Beds24.\n   * Called when a booking is confirmed on the website.\n   */\n  async syncBooking(booking: Partial<ChannelManagerBooking>): Promise<boolean> {\n    if (!this.isConfigured()) {\n      console.warn(\"Channel manager not configured, skipping booking sync\");\n      return false;\n    }\n\n    try {\n      const payload = {\n        apiKey: this.apiKey,\n        propid: this.propertyId,\n        guestName: booking.guestName,\n        guestEmail: booking.guestEmail,\n        guestPhone: booking.guestPhone,\n        checkin: booking.checkin,\n        checkout: booking.checkout,\n        roomId: booking.roomId,\n        noOfGuests: booking.adults || 1,\n        status: booking.status || \"confirmed\",\n        source: booking.source || \"website\",\n      };\n\n      const response = await fetch(`${this.baseUrl}/putBooking`, {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify(payload),\n      });\n\n      return response.ok;\n    } catch (error) {\n      console.error(\"Beds24 booking sync failed:\", error);\n      return false;\n    }\n  }\n\n  /**\n   * Cancel a booking in Beds24.\n   * Called when a booking is cancelled on the website.\n   */\n  async cancelBooking(externalBookingId: string): Promise<boolean> {\n    if (!this.isConfigured()) {\n      console.warn(\"Channel manager not configured, skipping booking cancellation\");\n      return false;\n    }\n\n    try {\n      const params = new URLSearchParams({\n        apiKey: this.apiKey,\n        propid: this.propertyId,\n        bookid: externalBookingId,\n      });\n\n      const response = await fetch(`${this.baseUrl}/delBooking?${params}`, {\n        method: \"DELETE\",\n      });\n\n      return response.ok;\n    } catch (error) {\n      console.error(\"Beds24 booking cancellation failed:\", error);\n      return false;\n    }\n  }\n\n  /**\n   * Validate webhook payload using shared secret.\n   * Beds24 includes X-Beds24-Signature header for verification.\n   */\n  validateWebhook(payload: string, signature: string | null): boolean {\n    if (!signature) return false;\n\n    const hmac = createHmac(\"sha256\", CHANNEL_MANAGER_CONFIG.webhook.secret);\n    hmac.update(payload);\n    const computed = hmac.digest(\"hex\");\n\n    return computed === signature;\n  }\n\n  private isConfigured(): boolean {\n    return this.apiKey !== \"\" && this.propertyId !== \"\";\n  }\n\n  private parseAvailabilityResponse(\n    // eslint-disable-next-line @typescript-eslint/no-unused-vars\n    _data: Record<string, unknown>,\n  ): ChannelManagerAvailability[] {\n    // Parse Beds24 API response format\n    // This is a placeholder implementation - adjust based on actual Beds24 API response\n    return [];\n  }\n\n  private getPlaceholderAvailability(\n    checkin: string,\n    checkout: string,\n  ): ChannelManagerAvailability[] {\n    // Return placeholder data when channel manager is not configured\n    const nights = Math.ceil(\n      (new Date(checkout).getTime() - new Date(checkin).getTime()) /\n        (1000 * 60 * 60 * 24),\n    );\n\n    return [\n      {\n        roomId: \"standard-capsule\",\n        roomName: \"Standard Capsule Pod\",\n        checkin,\n        checkout,\n        available: 18,\n        total: 18,\n        rate: 35 * nights,\n        currency: \"MYR\",\n      },\n      {\n        roomId: \"premium-capsule\",\n        roomName: \"Premium Capsule Pod\",\n        checkin,\n        checkout,\n        available: 6,\n        total: 6,\n        rate: 45 * nights,\n        currency: \"MYR\",\n      },\n    ];\n  }\n}\n\nexport const beds24Client = new Beds24Client();","new_string":"import { createHmac } from \"crypto\";\nimport { CHANNEL_MANAGER_CONFIG } from \"@/config/channel-manager\";\nimport type { ChannelManagerAvailability, ChannelManagerBooking } from \"./channel-manager-types\";\n\nexport class Beds24Client {\n  private apiKey: string;\n  private propertyId: string;\n  private baseUrl: string;\n\n  constructor() {\n    this.apiKey = CHANNEL_MANAGER_CONFIG.beds24.apiKey;\n    this.propertyId = CHANNEL_MANAGER_CONFIG.beds24.propertyId;\n    this.baseUrl = CHANNEL_MANAGER_CONFIG.beds24.apiBaseUrl;\n  }\n\n  async getAvailability(\n    checkin: string,\n    checkout: string,\n  ): Promise<ChannelManagerAvailability[]> {\n    if (!this.isConfigured()) {\n      return this.placeholderAvailability(checkin, checkout);\n    }\n\n    try {\n      const params = new URLSearchParams({\n        apiKey: this.apiKey,\n        propid: this.propertyId,\n        checkin,\n        checkout,\n      });\n\n      const response = await fetch(`${this.baseUrl}/getAvailability?${params}`, {\n        cache: \"no-store\",\n      });\n\n      if (!response.ok) {\n        console.error(\"Beds24 API error:\", response.statusText);\n        return this.placeholderAvailability(checkin, checkout);\n      }\n\n      // TODO: Parse actual Beds24 response format\n      return [];\n    } catch (error) {\n      console.error(\"Beds24 fetch failed:\", error);\n      return this.placeholderAvailability(checkin, checkout);\n    }\n  }\n\n  async syncBooking(booking: Partial<ChannelManagerBooking>): Promise<boolean> {\n    if (!this.isConfigured()) return false;\n\n    try {\n      const response = await fetch(`${this.baseUrl}/putBooking`, {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({\n          apiKey: this.apiKey,\n          propid: this.propertyId,\n          guestName: booking.guestName,\n          guestEmail: booking.guestEmail,\n          guestPhone: booking.guestPhone,\n          checkin: booking.checkin,\n          checkout: booking.checkout,\n          roomId: booking.roomId,\n          noOfGuests: booking.adults || 1,\n          status: \"confirmed\",\n        }),\n      });\n\n      return response.ok;\n    } catch (error) {\n      console.error(\"Booking sync failed:\", error);\n      return false;\n    }\n  }\n\n  validateWebhook(payload: string, signature: string | null): boolean {\n    if (!signature) return false;\n    const hmac = createHmac(\"sha256\", CHANNEL_MANAGER_CONFIG.webhook.secret);\n    hmac.update(payload);\n    return hmac.digest(\"hex\") === signature;\n  }\n\n  private isConfigured(): boolean {\n    return this.apiKey !== \"\" && this.propertyId !== \"\";\n  }\n\n  private placeholderAvailability(\n    checkin: string,\n    checkout: string,\n  ): ChannelManagerAvailability[] {\n    const nights = Math.ceil(\n      (new Date(checkout).getTime() - new Date(checkin).getTime()) /\n        (1000 * 60 * 60 * 24),\n    );\n\n    return [\n      {\n        roomId: \"standard-capsule\",\n        roomName: \"Standard Capsule Pod\",\n        checkin,\n        checkout,\n        available: 18,\n        total: 18,\n        rate: 35 * nights,\n        currency: \"MYR\",\n      },\n      {\n        roomId: \"premium-capsule\",\n        roomName: \"Premium Capsule Pod\",\n        checkin,\n        checkout,\n        available: 6,\n        total: 6,\n        rate: 45 * nights,\n        currency: \"MYR\",\n      },\n    ];\n  }\n}\n\nexport const beds24Client = new Beds24Client();"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":309,"cache_read_input_tokens":105803,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":309},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"e6d90c97-f395-42af-a0ca-354a9893adb6","uuid":"62b2390c-be2a-494c-8e0b-b8c48718e688"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TUDHtLXEfQMA35p2GZn8GH","type":"tool_result","content":"The file C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\lib\\beds24-client.ts has been updated. All occurrences were successfully replaced."}]},"parent_tool_use_id":null,"session_id":"e6d90c97-f395-42af-a0ca-354a9893adb6","uuid":"da37d0af-7810-456a-9e3e-d54c477e67c3","timestamp":"2026-04-13T19:24:01.657Z","tool_use_result":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\lib\\beds24-client.ts","oldString":"/**\n * Beds24 API Client for channel manager integration.\n * Handles API communication with Beds24 for ARI (Availability, Rate, Inventory) sync.\n */\n\nimport { createHmac } from \"crypto\";\nimport { CHANNEL_MANAGER_CONFIG } from \"@/config/channel-manager\";\nimport type { ChannelManagerAvailability, ChannelManagerBooking } from \"./channel-manager-types\";\n\nexport class Beds24Client {\n  private apiKey: string;\n  private propertyId: string;\n  private baseUrl: string;\n\n  constructor() {\n    this.apiKey = CHANNEL_MANAGER_CONFIG.beds24.apiKey;\n    this.propertyId = CHANNEL_MANAGER_CONFIG.beds24.propertyId;\n    this.baseUrl = CHANNEL_MANAGER_CONFIG.beds24.apiBaseUrl;\n  }\n\n  /**\n   * Fetch availability from Beds24 for a given date range.\n   * Returns inventory and rates for each room type.\n   */\n  async getAvailability(\n    checkin: string,\n    checkout: string,\n  ): Promise<ChannelManagerAvailability[]> {\n    if (!this.isConfigured()) {\n      return this.getPlaceholderAvailability(checkin, checkout);\n    }\n\n    try {\n      const params = new URLSearchParams({\n        apiKey: this.apiKey,\n        propid: this.propertyId,\n        checkin,\n        checkout,\n      });\n\n      const response = await fetch(`${this.baseUrl}/getAvailability?${params}`, {\n        cache: \"no-store\",\n      });\n\n      if (!response.ok) {\n        console.error(\"Beds24 API error:\", response.statusText);\n        return this.getPlaceholderAvailability(checkin, checkout);\n      }\n\n      const data = await response.json();\n      return this.parseAvailabilityResponse(data);\n    } catch (error) {\n      console.error(\"Beds24 availability fetch failed:\", error);\n      return this.getPlaceholderAvailability(checkin, checkout);\n    }\n  }\n\n  /**\n   * Sync a new booking to Beds24.\n   * Called when a booking is confirmed on the website.\n   */\n  async syncBooking(booking: Partial<ChannelManagerBooking>): Promise<boolean> {\n    if (!this.isConfigured()) {\n      console.warn(\"Channel manager not configured, skipping booking sync\");\n      return false;\n    }\n\n    try {\n      const payload = {\n        apiKey: this.apiKey,\n        propid: this.propertyId,\n        guestName: booking.guestName,\n        guestEmail: booking.guestEmail,\n        guestPhone: booking.guestPhone,\n        checkin: booking.checkin,\n        checkout: booking.checkout,\n        roomId: booking.roomId,\n        noOfGuests: booking.adults || 1,\n        status: booking.status || \"confirmed\",\n        source: booking.source || \"website\",\n      };\n\n      const response = await fetch(`${this.baseUrl}/putBooking`, {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify(payload),\n      });\n\n      return response.ok;\n    } catch (error) {\n      console.error(\"Beds24 booking sync failed:\", error);\n      return false;\n    }\n  }\n\n  /**\n   * Cancel a booking in Beds24.\n   * Called when a booking is cancelled on the website.\n   */\n  async cancelBooking(externalBookingId: string): Promise<boolean> {\n    if (!this.isConfigured()) {\n      console.warn(\"Channel manager not configured, skipping booking cancellation\");\n      return false;\n    }\n\n    try {\n      const params = new URLSearchParams({\n        apiKey: this.apiKey,\n        propid: this.propertyId,\n        bookid: externalBookingId,\n      });\n\n      const response = await fetch(`${this.baseUrl}/delBooking?${params}`, {\n        method: \"DELETE\",\n      });\n\n      return response.ok;\n    } catch (error) {\n      console.error(\"Beds24 booking cancellation failed:\", error);\n      return false;\n    }\n  }\n\n  /**\n   * Validate webhook payload using shared secret.\n   * Beds24 includes X-Beds24-Signature header for verification.\n   */\n  validateWebhook(payload: string, signature: string | null): boolean {\n    if (!signature) return false;\n\n    const hmac = createHmac(\"sha256\", CHANNEL_MANAGER_CONFIG.webhook.secret);\n    hmac.update(payload);\n    const computed = hmac.digest(\"hex\");\n\n    return computed === signature;\n  }\n\n  private isConfigured(): boolean {\n    return this.apiKey !== \"\" && this.propertyId !== \"\";\n  }\n\n  private parseAvailabilityResponse(\n    // eslint-disable-next-line @typescript-eslint/no-unused-vars\n    _data: Record<string, unknown>,\n  ): ChannelManagerAvailability[] {\n    // Parse Beds24 API response format\n    // This is a placeholder implementation - adjust based on actual Beds24 API response\n    return [];\n  }\n\n  private getPlaceholderAvailability(\n    checkin: string,\n    checkout: string,\n  ): ChannelManagerAvailability[] {\n    // Return placeholder data when channel manager is not configured\n    const nights = Math.ceil(\n      (new Date(checkout).getTime() - new Date(checkin).getTime()) /\n        (1000 * 60 * 60 * 24),\n    );\n\n    return [\n      {\n        roomId: \"standard-capsule\",\n        roomName: \"Standard Capsule Pod\",\n        checkin,\n        checkout,\n        available: 18,\n        total: 18,\n        rate: 35 * nights,\n        currency: \"MYR\",\n      },\n      {\n        roomId: \"premium-capsule\",\n        roomName: \"Premium Capsule Pod\",\n        checkin,\n        checkout,\n        available: 6,\n        total: 6,\n        rate: 45 * nights,\n        currency: \"MYR\",\n      },\n    ];\n  }\n}\n\nexport const beds24Client = new Beds24Client();","newString":"import { createHmac } from \"crypto\";\nimport { CHANNEL_MANAGER_CONFIG } from \"@/config/channel-manager\";\nimport type { ChannelManagerAvailability, ChannelManagerBooking } from \"./channel-manager-types\";\n\nexport class Beds24Client {\n  private apiKey: string;\n  private propertyId: string;\n  private baseUrl: string;\n\n  constructor() {\n    this.apiKey = CHANNEL_MANAGER_CONFIG.beds24.apiKey;\n    this.propertyId = CHANNEL_MANAGER_CONFIG.beds24.propertyId;\n    this.baseUrl = CHANNEL_MANAGER_CONFIG.beds24.apiBaseUrl;\n  }\n\n  async getAvailability(\n    checkin: string,\n    checkout: string,\n  ): Promise<ChannelManagerAvailability[]> {\n    if (!this.isConfigured()) {\n      return this.placeholderAvailability(checkin, checkout);\n    }\n\n    try {\n      const params = new URLSearchParams({\n        apiKey: this.apiKey,\n        propid: this.propertyId,\n        checkin,\n        checkout,\n      });\n\n      const response = await fetch(`${this.baseUrl}/getAvailability?${params}`, {\n        cache: \"no-store\",\n      });\n\n      if (!response.ok) {\n        console.error(\"Beds24 API error:\", response.statusText);\n        return this.placeholderAvailability(checkin, checkout);\n      }\n\n      // TODO: Parse actual Beds24 response format\n      return [];\n    } catch (error) {\n      console.error(\"Beds24 fetch failed:\", error);\n      return this.placeholderAvailability(checkin, checkout);\n    }\n  }\n\n  async syncBooking(booking: Partial<ChannelManagerBooking>): Promise<boolean> {\n    if (!this.isConfigured()) return false;\n\n    try {\n      const response = await fetch(`${this.baseUrl}/putBooking`, {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({\n          apiKey: this.apiKey,\n          propid: this.propertyId,\n          guestName: booking.guestName,\n          guestEmail: booking.guestEmail,\n          guestPhone: booking.guestPhone,\n          checkin: booking.checkin,\n          checkout: booking.checkout,\n          roomId: booking.roomId,\n          noOfGuests: booking.adults || 1,\n          status: \"confirmed\",\n        }),\n      });\n\n      return response.ok;\n    } catch (error) {\n      console.error(\"Booking sync failed:\", error);\n      return false;\n    }\n  }\n\n  validateWebhook(payload: string, signature: string | null): boolean {\n    if (!signature) return false;\n    const hmac = createHmac(\"sha256\", CHANNEL_MANAGER_CONFIG.webhook.secret);\n    hmac.update(payload);\n    return hmac.digest(\"hex\") === signature;\n  }\n\n  private isConfigured(): boolean {\n    return this.apiKey !== \"\" && this.propertyId !== \"\";\n  }\n\n  private placeholderAvailability(\n    checkin: string,\n    checkout: string,\n  ): ChannelManagerAvailability[] {\n    const nights = Math.ceil(\n      (new Date(checkout).getTime() - new Date(checkin).getTime()) /\n        (1000 * 60 * 60 * 24),\n    );\n\n    return [\n      {\n        roomId: \"standard-capsule\",\n        roomName: \"Standard Capsule Pod\",\n        checkin,\n        checkout,\n        available: 18,\n        total: 18,\n        rate: 35 * nights,\n        currency: \"MYR\",\n      },\n      {\n        roomId: \"premium-capsule\",\n        roomName: \"Premium Capsule Pod\",\n        checkin,\n        checkout,\n        available: 6,\n        total: 6,\n        rate: 45 * nights,\n        currency: \"MYR\",\n      },\n    ];\n  }\n}\n\nexport const beds24Client = new Beds24Client();","originalFile":"/**\n * Beds24 API Client for channel manager integration.\n * Handles API communication with Beds24 for ARI (Availability, Rate, Inventory) sync.\n */\n\nimport { createHmac } from \"crypto\";\nimport { CHANNEL_MANAGER_CONFIG } from \"@/config/channel-manager\";\nimport type { ChannelManagerAvailability, ChannelManagerBooking } from \"./channel-manager-types\";\n\nexport class Beds24Client {\n  private apiKey: string;\n  private propertyId: string;\n  private baseUrl: string;\n\n  constructor() {\n    this.apiKey = CHANNEL_MANAGER_CONFIG.beds24.apiKey;\n    this.propertyId = CHANNEL_MANAGER_CONFIG.beds24.propertyId;\n    this.baseUrl = CHANNEL_MANAGER_CONFIG.beds24.apiBaseUrl;\n  }\n\n  /**\n   * Fetch availability from Beds24 for a given date range.\n   * Returns inventory and rates for each room type.\n   */\n  async getAvailability(\n    checkin: string,\n    checkout: string,\n  ): Promise<ChannelManagerAvailability[]> {\n    if (!this.isConfigured()) {\n      return this.getPlaceholderAvailability(checkin, checkout);\n    }\n\n    try {\n      const params = new URLSearchParams({\n        apiKey: this.apiKey,\n        propid: this.propertyId,\n        checkin,\n        checkout,\n      });\n\n      const response = await fetch(`${this.baseUrl}/getAvailability?${params}`, {\n        cache: \"no-store\",\n      });\n\n      if (!response.ok) {\n        console.error(\"Beds24 API error:\", response.statusText);\n        return this.getPlaceholderAvailability(checkin, checkout);\n      }\n\n      const data = await response.json();\n      return this.parseAvailabilityResponse(data);\n    } catch (error) {\n      console.error(\"Beds24 availability fetch failed:\", error);\n      return this.getPlaceholderAvailability(checkin, checkout);\n    }\n  }\n\n  /**\n   * Sync a new booking to Beds24.\n   * Called when a booking is confirmed on the website.\n   */\n  async syncBooking(booking: Partial<ChannelManagerBooking>): Promise<boolean> {\n    if (!this.isConfigured()) {\n      console.warn(\"Channel manager not configured, skipping booking sync\");\n      return false;\n    }\n\n    try {\n      const payload = {\n        apiKey: this.apiKey,\n        propid: this.propertyId,\n        guestName: booking.guestName,\n        guestEmail: booking.guestEmail,\n        guestPhone: booking.guestPhone,\n        checkin: booking.checkin,\n        checkout: booking.checkout,\n        roomId: booking.roomId,\n        noOfGuests: booking.adults || 1,\n        status: booking.status || \"confirmed\",\n        source: booking.source || \"website\",\n      };\n\n      const response = await fetch(`${this.baseUrl}/putBooking`, {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify(payload),\n      });\n\n      return response.ok;\n    } catch (error) {\n      console.error(\"Beds24 booking sync failed:\", error);\n      return false;\n    }\n  }\n\n  /**\n   * Cancel a booking in Beds24.\n   * Called when a booking is cancelled on the website.\n   */\n  async cancelBooking(externalBookingId: string): Promise<boolean> {\n    if (!this.isConfigured()) {\n      console.warn(\"Channel manager not configured, skipping booking cancellation\");\n      return false;\n    }\n\n    try {\n      const params = new URLSearchParams({\n        apiKey: this.apiKey,\n        propid: this.propertyId,\n        bookid: externalBookingId,\n      });\n\n      const response = await fetch(`${this.baseUrl}/delBooking?${params}`, {\n        method: \"DELETE\",\n      });\n\n      return response.ok;\n    } catch (error) {\n      console.error(\"Beds24 booking cancellation failed:\", error);\n      return false;\n    }\n  }\n\n  /**\n   * Validate webhook payload using shared secret.\n   * Beds24 includes X-Beds24-Signature header for verification.\n   */\n  validateWebhook(payload: string, signature: string | null): boolean {\n    if (!signature) return false;\n\n    const hmac = createHmac(\"sha256\", CHANNEL_MANAGER_CONFIG.webhook.secret);\n    hmac.update(payload);\n    const computed = hmac.digest(\"hex\");\n\n    return computed === signature;\n  }\n\n  private isConfigured(): boolean {\n    return this.apiKey !== \"\" && this.propertyId !== \"\";\n  }\n\n  private parseAvailabilityResponse(\n    // eslint-disable-next-line @typescript-eslint/no-unused-vars\n    _data: Record<string, unknown>,\n  ): ChannelManagerAvailability[] {\n    // Parse Beds24 API response format\n    // This is a placeholder implementation - adjust based on actual Beds24 API response\n    return [];\n  }\n\n  private getPlaceholderAvailability(\n    checkin: string,\n    checkout: string,\n  ): ChannelManagerAvailability[] {\n    // Return placeholder data when channel manager is not configured\n    const nights = Math.ceil(\n      (new Date(checkout).getTime() - new Date(checkin).getTime()) /\n        (1000 * 60 * 60 * 24),\n    );\n\n    return [\n      {\n        roomId: \"standard-capsule\",\n        roomName: \"Standard Capsule Pod\",\n        checkin,\n        checkout,\n        available: 18,\n        total: 18,\n        rate: 35 * nights,\n        currency: \"MYR\",\n      },\n      {\n        roomId: \"premium-capsule\",\n        roomName: \"Premium Capsule Pod\",\n        checkin,\n        checkout,\n        available: 6,\n        total: 6,\n        rate: 45 * nights,\n        currency: \"MYR\",\n      },\n    ];\n  }\n}\n\nexport const beds24Client = new Beds24Client();\n","structuredPatch":[{"oldStart":1,"oldLines":8,"newStart":1,"newLines":3,"lines":["-/**","- * Beds24 API Client for channel manager integration.","- * Handles API communication with Beds24 for ARI (Availability, Rate, Inventory) sync.","- */","-"," import { createHmac } from \"crypto\";"," import { CHANNEL_MANAGER_CONFIG } from \"@/config/channel-manager\";"," import type { ChannelManagerAvailability, ChannelManagerBooking } from \"./channel-manager-types\";"]},{"oldStart":18,"oldLines":16,"newStart":13,"newLines":12,"lines":["     this.baseUrl = CHANNEL_MANAGER_CONFIG.beds24.apiBaseUrl;","   }"," ","-  /**","-   * Fetch availability from Beds24 for a given date range.","-   * Returns inventory and rates for each room type.","-   */","   async getAvailability(","     checkin: string,","     checkout: string,","   ): Pro