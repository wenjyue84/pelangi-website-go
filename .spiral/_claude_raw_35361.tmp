code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"ed72d350-820b-4f7d-bbc7-332537a10136","uuid":"65559164-6145-43ff-af4d-fbe914528f4e","timestamp":"2026-04-14T05:45:33.353Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\components\\LanguageSwitcher.tsx","content":"\"use client\";\n\nimport type { Route } from \"next\";\nimport { useRouter } from \"next/navigation\";\nimport { setLanguagePreference } from \"@/app/actions/language\";\n\nconst LANGUAGES = [\n  { code: \"en\", label: \"EN\" },\n  { code: \"ms\", label: \"BM\", href: \"/ms/terma\" },\n  { code: \"zh\", label: \"中文\", href: \"/zh\" },\n];\n\nexport default function LanguageSwitcher() {\n  const router = useRouter();\n\n  const handleLanguageChange = async (e: React.ChangeEvent<HTMLSelectElement>) => {\n    const langCode = e.currentTarget.value;\n\n    // Set the cookie\n    await setLanguagePreference(langCode);\n\n    // Navigate to language-specific content page if href is defined\n    const lang = LANGUAGES.find((l) => l.code === langCode);\n    if (lang && \"href\" in lang && lang.href) {\n      router.push(lang.href as Route);\n      return;\n    }\n  };\n\n  return (\n    <div className=\"ml-4\">\n      <label htmlFor=\"language-select\" className=\"sr-only\">\n        Select language\n      </label>\n      <select\n        id=\"language-select\"\n        className=\"select-base\"\n        defaultValue=\"en\"\n        onChange={handleLanguageChange}\n        aria-label=\"Language selector\"\n      >\n        {LANGUAGES.map((lang) => (\n          <option key={lang.code} value={lang.code}>\n            {lang.label}\n          </option>\n        ))}\n      </select>\n    </div>\n  );\n}\n","numLines":51,"startLine":1,"totalLines":51}}}
