{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01T9d6X3PavMooMe5owXYy9Y","type":"tool_result","content":"1\t\"use client\";\n2\t\n3\timport type { Route } from \"next\";\n4\timport { useState, useEffect, useCallback } from \"react\";\n5\timport Link from \"next/link\";\n6\timport Image from \"next/image\";\n7\timport dynamic from \"next/dynamic\";\n8\timport LanguageSwitcher from \"./LanguageSwitcher\";\n9\timport BookNowCTA from \"./BookNowCTA\";\n10\timport InfoPopover from \"./InfoPopover\";\n11\timport {\n12\t  SEARCH_ARIA,\n13\t  SEARCH_ARIA_DESKTOP,\n14\t} from \"@/lib/ui-labels\";\n15\t\n16\tfunction pushNavEvent(href: string) {\n17\t  if (typeof window === \"undefined\") return;\n18\t  const w = window as unknown as { dataLayer: Record<string, unknown>[] };\n19\t  w.dataLayer = w.dataLayer || [];\n20\t  w.dataLayer.push({ event: \"nav_click\", nav_href: href });\n21\t}\n22\t\n23\tconst SearchDialog = dynamic(() => import(\"./SearchDialog\"), { ssr: false });\n24\t\n25\texport default function Header() {\n26\t  const [isMenuOpen, setIsMenuOpen] = useState(false);\n27\t  const [isSearchOpen, setIsSearchOpen] = useState(false);\n28\t\n29\t  const closeSearch = useCallback(() => setIsSearchOpen(false), []);\n30\t\n31\t  // Cmd/Ctrl+K keyboard shortcut + Escape to close mobile nav\n32\t  useEffect(() => {\n33\t    function handleKeyDown(e: KeyboardEvent) {\n34\t      if ((e.metaKey || e.ctrlKey) && e.key === \"k\") {\n35\t        e.preventDefault();\n36\t        setIsSearchOpen((prev) => !prev);\n37\t      }\n38\t      if (e.key === \"Escape\" && isMenuOpen) {\n39\t        setIsMenuOpen(false);\n40\t      }\n41\t    }\n42\t    document.addEventListener(\"keydown\", handleKeyDown);\n43\t    return () => document.removeEventListener(\"keydown\", handleKeyDown);\n44\t  }, [isMenuOpen]);\n45\t\n46\t  const navLinks = [\n47\t    { href: \"/about\", label: \"About\" },\n48\t    { href: \"/rooms\", label: \"Rooms\" },\n49\t    { href: \"/#destinations\", label: \"Destinations\" },\n50\t    { href: \"/gallery\", label: \"Gallery\" },\n51\t    { href: \"/#community\", label: \"Community\" },\n52\t    { href: \"/contact\", label: \"Location\" },\n53\t    { href: \"/check-in\", label: \"Check-in Guide\" },\n54\t  ];\n55\t\n56\t  return (\n57\t    <header className=\"fixed top-0 left-0 right-0 z-50 transition-all duration-500 bg-white/95 backdrop-blur-md shadow-xs py-3 dark:bg-stone-900/95 dark:shadow-stone-950/50\">\n58\t      <nav className=\"container-custom flex items-center justify-between px-6 md:px-8\">\n59\t        {/* Logo */}\n60\t        <Link href=\"/\" className=\"flex items-center gap-3 group\">\n61\t          <Image\n62\t            src=\"/images/logo.png\"\n63\t            alt=\"Pelangi Capsule Hostel Logo - Budget accommodation in Johor Bahru\"\n64\t            width={40}\n65\t            height={40}\n66\t            className=\"object-contain\"\n67\t            priority\n68\t            unoptimized\n69\t          />\n70\t          <div className=\"flex flex-col\">\n71\t            <span className=\"font-display text-xl font-medium tracking-tight transition-colors duration-300 text-stone-900 dark:text-stone-100\">\n72\t              Pelangi\n73\t            </span>\n74\t            <span className=\"text-[10px] font-medium tracking-widest uppercase transition-colors duration-300 text-stone-500 dark:text-stone-400\">\n75\t              Capsule Hostel\n76\t            </span>\n77\t          </div>\n78\t        </Link>\n79\t\n80\t        {/* Desktop Navigation */}\n81\t        <div className=\"hidden md:flex items-center gap-1\">\n82\t          {navLinks.map((link) => (\n83\t            <Link\n84\t              key={link.href}\n85\t              href={link.href as Route}\n86\t              className=\"px-4 py-2 text-sm font-medium transition-all duration-300 rounded-full text-stone-600 hover:text-stone-900 hover:bg-stone-100 dark:text-stone-400 dark:hover:text-stone-100 dark:hover:bg-stone-800\"\n87\t              onNavigate={() => pushNavEvent(link.href)}\n88\t            >\n89\t              {link.label}\n90\t            </Link>\n91\t          ))}\n92\t          <InfoPopover\n93\t            content=\"Search (Ctrl+K)\"\n94\t            ariaLabel={SEARCH_ARIA_DESKTOP}\n95\t          >\n96\t            <span\n97\t              role=\"button\"\n98\t              tabIndex={0}\n99\t              onClick={() => setIsSearchOpen(true)}\n100\t              onKeyDown={(e) => { if (e.key === \"Enter\" || e.key === \" \") { e.preventDefault(); setIsSearchOpen(true); } }}\n101\t              className=\"p-2 text-stone-500 hover:text-stone-900 hover:bg-stone-100 rounded-full transition-colors dark:text-stone-400 dark:hover:text-stone-100 dark:hover:bg-stone-800 inline-flex\"\n102\t            >\n103\t              <svg className=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n104\t                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={1.5} d=\"M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z\" />\n105\t              </svg>\n106\t            </span>\n107\t          </InfoPopover>\n108\t          <LanguageSwitcher />\n109\t          <BookNowCTA className=\"ml-4 px-6 py-2.5 text-sm font-medium rounded-full transition-all duration-300 bg-amber-700 text-white hover:bg-amber-800\" />\n110\t        </div>\n111\t\n112\t        {/* Mobile Search + Menu Buttons */}\n113\t        <div className=\"flex items-center gap-1 md:hidden\">\n114\t          <button\n115\t            className=\"p-2 rounded-full transition-colors duration-300 text-stone-700 hover:bg-stone-100 dark:text-stone-300 dark:hover:bg-stone-800\"\n116\t            onClick={() => setIsSearchOpen(true)}\n117\t            aria-label={SEARCH_ARIA}\n118\t          >\n119\t            <svg className=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n120\t              <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={1.5} d=\"M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z\" />\n121\t            </svg>\n122\t          </button>\n123\t          <button\n124\t            className=\"p-2 rounded-full transition-colors duration-300 text-stone-700 hover:bg-stone-100 dark:text-stone-300 dark:hover:bg-stone-800\"\n125\t            onClick={() => setIsMenuOpen(!isMenuOpen)}\n126\t            aria-label={isMenuOpen ? \"Close menu\" : \"Open menu\"}\n127\t            aria-expanded={isMenuOpen}\n128\t          >\n129\t            <svg className=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n130\t              {isMenuOpen ? (\n131\t                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={1.5} d=\"M6 18L18 6M6 6l12 12\" />\n132\t              ) : (\n133\t                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={1.5} d=\"M4 6h16M4 12h16M4 18h16\" />\n134\t              )}\n135\t            </svg>\n136\t          </button>\n137\t        </div>\n138\t\n139\t        {/* Mobile Navigation */}\n140\t        <div\n141\t          className={`absolute top-full left-4 right-4 mt-2 bg-white rounded-2xl shadow-xl md:hidden dark:bg-stone-800 dark:shadow-stone-950/50\n142\t                     overflow-hidden transition-all duration-300 ${isMenuOpen ? \"opacity-100 translate-y-0\" : \"opacity-0 -translate-y-4 pointer-events-none\"\n143\t            }`}\n144\t        >\n145\t          <div className=\"py-4\">\n146\t            {navLinks.map((link) => (\n147\t              <Link\n148\t                key={link.href}\n149\t                href={link.href as Route}\n150\t                className=\"block px-6 py-3 text-stone-700 hover:bg-stone-50 hover:text-stone-900 transition-colors dark:text-stone-300 dark:hover:bg-stone-700 dark:hover:text-stone-100\"\n151\t                onClick={() => setIsMenuOpen(false)}\n152\t                onNavigate={() => pushNavEvent(link.href)}\n153\t              >\n154\t                {link.label}\n155\t              </Link>\n156\t            ))}\n157\t            <div className=\"px-6 py-3 border-t border-stone-100 mt-2 dark:border-stone-700\">\n158\t              <div className=\"flex items-center justify-center mb-4\">\n159\t                <LanguageSwitcher />\n160\t              </div>\n161\t              <BookNowCTA\n162\t                className=\"block w-full text-center bg-amber-700 text-white py-3 rounded-xl font-medium hover:bg-amber-800 transition-colors\"\n163\t                onClick={() => setIsMenuOpen(false)}\n164\t              />\n165\t            </div>\n166\t          </div>\n167\t        </div>\n168\t      </nav>\n169\t      <SearchDialog open={isSearchOpen} onClose={closeSearch} />\n170\t    </header>\n171\t  );\n172\t}\n173\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"ed72d350-820b-4f7d-bbc7-332537a10136","uuid":"3ec026f4-9b51-43ae-b3ae-a3412af3b508","timestamp":"2026-04-14T05:45:29.858Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\components\\Header.tsx","content":"\"use client\";\n\nimport type { Route } from \"next\";\nimport { useState, useEffect, useCallback } from \"react\";\nimport Link from \"next/link\";\nimport Image from \"next/image\";\nimport dynamic from \"next/dynamic\";\nimport LanguageSwitcher from \"./LanguageSwitcher\";\nimport BookNowCTA from \"./BookNowCTA\";\nimport InfoPopover from \"./InfoPopover\";\nimport {\n  SEARCH_ARIA,\n  SEARCH_ARIA_DESKTOP,\n} from \"@/lib/ui-labels\";\n\nfunction pushNavEvent(href: string) {\n  if (typeof window === \"undefined\") return;\n  const w = window as unknown as { dataLayer: Record<string, unknown>[] };\n  w.dataLayer = w.dataLayer || [];\n  w.dataLayer.push({ event: \"nav_click\", nav_href: href });\n}\n\nconst SearchDialog = dynamic(() => import(\"./SearchDialog\"), { ssr: false });\n\nexport default function Header() {\n  const [isMenuOpen, setIsMenuOpen] = useState(false);\n  const [isSearchOpen, setIsSearchOpen] = useState(false);\n\n  const closeSearch = useCallback(() => setIsSearchOpen(false), []);\n\n  // Cmd/Ctrl+K keyboard shortcut + Escape to close mobile nav\n  useEffect(() => {\n    function handleKeyDown(e: KeyboardEvent) {\n      if ((e.metaKey || e.ctrlKey) && e.key === \"k\") {\n        e.preventDefault();\n        setIsSearchOpen((prev) => !prev);\n      }\n      if (e.key === \"Escape\" && isMenuOpen) {\n        setIsMenuOpen(false);\n      }\n    }\n    document.addEventListener(\"keydown\", handleKeyDown);\n    return () => document.removeEventListener(\"keydown\", handleKeyDown);\n  }, [isMenuOpen]);\n\n  const navLinks = [\n    { href: \"/about\", label: \"About\" },\n    { href: \"/rooms\", label: \"Rooms\" },\n    { href: \"/#destinations\", label: \"Destinations\" },\n    { href: \"/gallery\", label: \"Gallery\" },\n    { href: \"/#community\", label: \"Community\" },\n    { href: \"/contact\", label: \"Location\" },\n    { href: \"/check-in\", label: \"Check-in Guide\" },\n  ];\n\n  return (\n    <header className=\"fixed top-0 left-0 right-0 z-50 transition-all duration-500 bg-white/95 backdrop-blur-md shadow-xs py-3 dark:bg-stone-900/95 dark:shadow-stone-950/50\">\n      <nav className=\"container-custom flex items-center justify-between px-6 md:px-8\">\n        {/* Logo */}\n        <Link href=\"/\" className=\"flex items-center gap-3 group\">\n          <Image\n            src=\"/images/logo.png\"\n            alt=\"Pelangi Capsule Hostel Logo - Budget accommodation in Johor Bahru\"\n            width={40}\n            height={40}\n            className=\"object-contain\"\n            priority\n            unoptimized\n          />\n          <div className=\"flex flex-col\">\n            <span className=\"font-display text-xl font-medium tracking-tight transition-colors duration-300 text-stone-900 dark:text-stone-100\">\n              Pelangi\n            </span>\n            <span className=\"text-[10px] font-medium tracking-widest uppercase transition-colors duration-300 text-stone-500 dark:text-stone-400\">\n              Capsule Hostel\n            </span>\n          </div>\n        </Link>\n\n        {/* Desktop Navigation */}\n        <div className=\"hidden md:flex items-center gap-1\">\n          {navLinks.map((link) => (\n            <Link\n              key={link.href}\n              href={link.href as Route}\n              className=\"px-4 py-2 text-sm font-medium transition-all duration-300 rounded-full text-stone-600 hover:text-stone-900 hover:bg-stone-100 dark:text-stone-400 dark:hover:text-stone-100 dark:hover:bg-stone-800\"\n              onNavigate={() => pushNavEvent(link.href)}\n            >\n              {link.label}\n            </Link>\n          ))}\n          <InfoPopover\n            content=\"Search (Ctrl+K)\"\n            ariaLabel={SEARCH_ARIA_DESKTOP}\n          >\n            <span\n              role=\"button\"\n              tabIndex={0}\n              onClick={() => setIsSearchOpen(true)}\n              onKeyDown={(e) => { if (e.key === \"Enter\" || e.key === \" \") { e.preventDefault(); setIsSearchOpen(true); } }}\n              className=\"p-2 text-stone-500 hover:text-stone-900 hover:bg-stone-100 rounded-full transition-colors dark:text-stone-400 dark:hover:text-stone-100 dark:hover:bg-stone-800 inline-flex\"\n            >\n              <svg className=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={1.5} d=\"M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z\" />\n              </svg>\n            </span>\n          </InfoPopover>\n          <LanguageSwitcher />\n          <BookNowCTA className=\"ml-4 px-6 py-2.5 text-sm font-medium rounded-full transition-all duration-300 bg-amber-700 text-white hover:bg-amber-800\" />\n        </div>\n\n        {/* Mobile Search + Menu Buttons */}\n        <div className=\"flex items-center gap-1 md:hidden\">\n          <button\n            className=\"p-2 rounded-full transition-colors duration-300 text-stone-700 hover:bg-stone-100 dark:text-stone-300 dark:hover:bg-stone-800\"\n            onClick={() => setIsSearchOpen(true)}\n            aria-label={SEARCH_ARIA}\n          >\n            <svg className=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={1.5} d=\"M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z\" />\n            </svg>\n          </button>\n          <button\n            className=\"p-2 rounded-full transition-colors duration-300 text-stone-700 hover:bg-stone-100 dark:text-stone-300 dark:hover:bg-stone-800\"\n            onClick={() => setIsMenuOpen(!isMenuOpen)}\n            aria-label={isMenuOpen ? \"Close menu\" : \"Open menu\"}\n            aria-expanded={isMenuOpen}\n          >\n            <svg className=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              {isMenuOpen ? (\n                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={1.5} d=\"M6 18L18 6M6 6l12 12\" />\n              ) : (\n                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={1.5} d=\"M4 6h16M4 12h16M4 18h16\" />\n              )}\n            </svg>\n          </button>\n        </div>\n\n        {/* Mobile Navigation */}\n        <div\n          className={`absolute top-full left-4 right-4 mt-2 bg-white rounded-2xl shadow-xl md:hidden dark:bg-stone-800 dark:shadow-stone-950/50\n                     overflow-hidden transition-all duration-300 ${isMenuOpen ? \"opacity-100 translate-y-0\" : \"opacity-0 -translate-y-4 pointer-events-none\"\n            }`}\n        >\n          <div className=\"py-4\">\n            {navLinks.map((link) => (\n              <Link\n                key={link.href}\n                href={link.href as Route}\n                className=\"block px-6 py-3 text-stone-700 hover:bg-stone-50 hover:text-stone-900 transition-colors dark:text-stone-300 dark:hover:bg-stone-700 dark:hover:text-stone-100\"\n                onClick={() => setIsMenuOpen(false)}\n                onNavigate={() => pushNavEvent(link.href)}\n              >\n                {link.label}\n              </Link>\n            ))}\n            <div className=\"px-6 py-3 border-t border-stone-100 mt-2 dark:border-stone-700\">\n              <div className=\"flex items-center justify-center mb-4\">\n                <LanguageSwitcher />\n              </div>\n              <BookNowCTA\n                className=\"block w-full text-center bg-amber-700 text-white py-3 rounded-xl font-medium hover:bg-amber-800 transition-colors\"\n                onClick={() => setIsMenuOpen(false)}\n              />\n            </div>\n          </div>\n        </div>\n      </nav>\n      <SearchDialog open={isSearchOpen} onClose={closeSearch} />\n    </header>\n  );\n}\n","numLines":173,"startLine":1,"totalLines":173}}}
