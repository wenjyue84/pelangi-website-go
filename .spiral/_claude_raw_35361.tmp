{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Pune1fLnekwgryobdZxz2c","type":"tool_result","content":"1\timport React from \"react\";\n2\t\n3\t/**\n4\t * Wraps Malay-language text with lang=\"ms\" for WCAG 2.2 SC 3.1.2 compliance.\n5\t * Screen readers use this to switch to a Malay TTS voice for correct pronunciation.\n6\t */\n7\texport default function LangMs({\n8\t  children,\n9\t  className,\n10\t}: {\n11\t  children: React.ReactNode;\n12\t  className?: string;\n13\t}) {\n14\t  return (\n15\t    <span lang=\"ms\" className={className}>\n16\t      {children}\n17\t    </span>\n18\t  );\n19\t}\n20\t\n21\t/**\n22\t * Known Malay-language terms that appear on the site.\n23\t * Proper nouns (place names like \"Johor Bahru\") are excluded — SC 3.1.2 applies\n24\t * to passages of text, not individual proper nouns which retain their original form.\n25\t * Food, cultural, and common Malay terms that a screen reader might mispronounce\n26\t * are included.\n27\t */\n28\tconst MALAY_TERMS = [\n29\t  // Food terms\n30\t  \"nasi lemak\",\n31\t  \"nasi goreng\",\n32\t  \"roti canai\",\n33\t  \"teh tarik\",\n34\t  \"kopi-O\",\n35\t  \"kopi\",\n36\t  \"mee rebus\",\n37\t  \"laksa\",\n38\t  \"satay\",\n39\t  \"rendang\",\n40\t  \"rojak\",\n41\t  \"kuih\",\n42\t  \"cendol\",\n43\t  \"ikan bakar\",\n44\t  \"sup tulang merah\",\n45\t  \"sup tulang\",\n46\t  \"char kway teow\",\n47\t  // Cultural/common terms\n48\t  \"pasar malam\",\n49\t  \"kopitiam\",\n50\t  \"kopitiams\",\n51\t  \"mamak\",\n52\t  \"warung\",\n53\t  \"kampung\",\n54\t  // Malay holidays and greetings\n55\t  \"Hari Raya Aidilfitri\",\n56\t  \"Hari Raya Haji\",\n57\t  \"Hari Raya\",\n58\t  \"Selamat Hari Raya\",\n59\t  \"Merdeka\",\n60\t  \"Yang di-Pertuan Agong\",\n61\t  // Place descriptors (Malay common nouns, not proper names)\n62\t  \"restoran\",\n63\t  \"kedai\",\n64\t  \"pulau\",\n65\t  \"sungai\",\n66\t  \"pantai\",\n67\t  \"tanjung\",\n68\t  \"jalan\",\n69\t  \"taman\",\n70\t];\n71\t\n72\t// Sort by length descending so longer terms match first (e.g. \"sup tulang merah\" before \"sup tulang\")\n73\tconst SORTED_TERMS = [...MALAY_TERMS].sort((a, b) => b.length - a.length);\n74\t\n75\tconst MALAY_REGEX = new RegExp(\n76\t  `(${SORTED_TERMS.map((t) => t.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\")).join(\"|\")})`,\n77\t  \"gi\"\n78\t);\n79\t\n80\t/**\n81\t * Wraps known Malay terms in a string with <span lang=\"ms\">.\n82\t * Returns a ReactNode array suitable for JSX rendering.\n83\t */\n84\texport function annotateMs(text: string): React.ReactNode {\n85\t  const parts = text.split(MALAY_REGEX);\n86\t  if (parts.length === 1) return text;\n87\t\n88\t  return parts.map((part, i) => {\n89\t    if (SORTED_TERMS.some((t) => t.toLowerCase() === part.toLowerCase())) {\n90\t      return (\n91\t        <span key={i} lang=\"ms\">\n92\t          {part}\n93\t        </span>\n94\t      );\n95\t    }\n96\t    return part;\n97\t  });\n98\t}\n99\t\n100\t/**\n101\t * Wraps known Malay terms in an HTML string with <span lang=\"ms\">.\n102\t * For use with dangerouslySetInnerHTML content (e.g., blog posts).\n103\t * Avoids wrapping terms that are already inside HTML tags or attributes.\n104\t */\n105\texport function annotateMsHtml(html: string): string {\n106\t  // Only replace terms in text nodes (not inside < > tags)\n107\t  return html.replace(\n108\t    /(<[^>]*>)|([^<]+)/g,\n109\t    (match, tag: string | undefined, text: string | undefined) => {\n110\t      if (tag) return tag;\n111\t      if (!text) return match;\n112\t      return text.replace(MALAY_REGEX, '<span lang=\"ms\">$1</span>');\n113\t    }\n114\t  );\n115\t}\n116\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"ed72d350-820b-4f7d-bbc7-332537a10136","uuid":"728f2d57-28e7-490f-a7ef-ff4eb67f7ce0","timestamp":"2026-04-14T05:45:29.640Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\components\\LangMs.tsx","content":"import React from \"react\";\n\n/**\n * Wraps Malay-language text with lang=\"ms\" for WCAG 2.2 SC 3.1.2 compliance.\n * Screen readers use this to switch to a Malay TTS voice for correct pronunciation.\n */\nexport default function LangMs({\n  children,\n  className,\n}: {\n  children: React.ReactNode;\n  className?: string;\n}) {\n  return (\n    <span lang=\"ms\" className={className}>\n      {children}\n    </span>\n  );\n}\n\n/**\n * Known Malay-language terms that appear on the site.\n * Proper nouns (place names like \"Johor Bahru\") are excluded — SC 3.1.2 applies\n * to passages of text, not individual proper nouns which retain their original form.\n * Food, cultural, and common Malay terms that a screen reader might mispronounce\n * are included.\n */\nconst MALAY_TERMS = [\n  // Food terms\n  \"nasi lemak\",\n  \"nasi goreng\",\n  \"roti canai\",\n  \"teh tarik\",\n  \"kopi-O\",\n  \"kopi\",\n  \"mee rebus\",\n  \"laksa\",\n  \"satay\",\n  \"rendang\",\n  \"rojak\",\n  \"kuih\",\n  \"cendol\",\n  \"ikan bakar\",\n  \"sup tulang merah\",\n  \"sup tulang\",\n  \"char kway teow\",\n  // Cultural/common terms\n  \"pasar malam\",\n  \"kopitiam\",\n  \"kopitiams\",\n  \"mamak\",\n  \"warung\",\n  \"kampung\",\n  // Malay holidays and greetings\n  \"Hari Raya Aidilfitri\",\n  \"Hari Raya Haji\",\n  \"Hari Raya\",\n  \"Selamat Hari Raya\",\n  \"Merdeka\",\n  \"Yang di-Pertuan Agong\",\n  // Place descriptors (Malay common nouns, not proper names)\n  \"restoran\",\n  \"kedai\",\n  \"pulau\",\n  \"sungai\",\n  \"pantai\",\n  \"tanjung\",\n  \"jalan\",\n  \"taman\",\n];\n\n// Sort by length descending so longer terms match first (e.g. \"sup tulang merah\" before \"sup tulang\")\nconst SORTED_TERMS = [...MALAY_TERMS].sort((a, b) => b.length - a.length);\n\nconst MALAY_REGEX = new RegExp(\n  `(${SORTED_TERMS.map((t) => t.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\")).join(\"|\")})`,\n  \"gi\"\n);\n\n/**\n * Wraps known Malay terms in a string with <span lang=\"ms\">.\n * Returns a ReactNode array suitable for JSX rendering.\n */\nexport function annotateMs(text: string): React.ReactNode {\n  const parts = text.split(MALAY_REGEX);\n  if (parts.length === 1) return text;\n\n  return parts.map((part, i) => {\n    if (SORTED_TERMS.some((t) => t.toLowerCase() === part.toLowerCase())) {\n      return (\n        <span key={i} lang=\"ms\">\n          {part}\n        </span>\n      );\n    }\n    return part;\n  });\n}\n\n/**\n * Wraps known Malay terms in an HTML string with <span lang=\"ms\">.\n * For use with dangerouslySetInnerHTML content (e.g., blog posts).\n * Avoids wrapping terms that are already inside HTML tags or attributes.\n */\nexport function annotateMsHtml(html: string): string {\n  // Only replace terms in text nodes (not inside < > tags)\n  return html.replace(\n    /(<[^>]*>)|([^<]+)/g,\n    (match, tag: string | undefined, text: string | undefined) => {\n      if (tag) return tag;\n      if (!text) return match;\n      return text.replace(MALAY_REGEX, '<span lang=\"ms\">$1</span>');\n    }\n  );\n}\n","numLines":116,"startLine":1,"totalLines":116}}}
