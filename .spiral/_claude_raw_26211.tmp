{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Mn6Yh6i34dFtPddjzphfwY","type":"tool_result","content":"1\t{\n2\t  \"productName\": \"Pelangi Capsule Hostel Website\",\n3\t  \"branchName\": \"master\",\n4\t  \"overview\": \"Enhance the Next.js 15 hostel website with a full blog system, SEO-optimised travel articles about Johor Bahru & Singapore, RSS feed, live JB news widget, and richer content to attract backpackers searching for budget accommodation near the Singapore-Malaysia border.\",\n5\t  \"goals\": [\n6\t    \"Create a blog system with static TypeScript posts for long-tail SEO\",\n7\t    \"Publish 6+ high-quality, original travel articles about JB and Singapore for tourists\",\n8\t    \"Add RSS/Atom feed at /feed.xml for the blog\",\n9\t    \"Add a 'JB News & Updates' widget on the homepage pulling from curated RSS sources\",\n10\t    \"Enhance structured data (Article, BreadcrumbList schemas) and internal linking\",\n11\t    \"Update sitemap.ts to include all blog post URLs\",\n12\t    \"Improve the /guide page with richer, more lively backpacker-focused content\"\n13\t  ],\n14\t  \"userStories\": [\n15\t    {\n16\t      \"id\": \"US-001\",\n17\t      \"title\": \"Create blog system with static TypeScript data\",\n18\t      \"priority\": \"high\",\n19\t      \"description\": \"Build a blog system using Next.js App Router. Blog posts are stored as TypeScript objects in /src/data/blog/posts.ts. Each post has: slug, title, excerpt, content (HTML string), date, category, author, readTime, tags, and featured image path. Create /app/blog/page.tsx (listing with cards) and /app/blog/[slug]/page.tsx (article page with full content). Both pages must have proper metadata (title, description, OG tags). Add a BlogCard component at /src/components/BlogCard.tsx.\",\n20\t      \"acceptanceCriteria\": [\n21\t        \"/blog page renders a grid of blog post cards with title, excerpt, date, category badge, and read time\",\n22\t        \"/blog/[slug] renders individual article with full HTML content, author, date, tags, and back link\",\n23\t        \"Both pages have generateMetadata with unique title, description, and OG image\",\n24\t        \"TypeScript compiles without errors\",\n25\t        \"No external database or CMS â€” pure static data in /src/data/blog/posts.ts\"\n26\t      ],\n27\t      \"technicalNotes\": [\n28\t        \"site/src/data/blog/posts.ts â€” create blog post data array\",\n29\t        \"site/src/app/blog/page.tsx â€” blog listing page\",\n30\t        \"site/src/app/blog/[slug]/page.tsx â€” individual article page\",\n31\t        \"site/src/components/BlogCard.tsx â€” reusable card component\",\n32\t        \"Use Tailwind prose classes for article body typography\"\n33\t      ],\n34\t      \"dependencies\": [],\n35\t      \"estimatedComplexity\": \"medium\",\n36\t      \"passes\": true\n37\t    },\n38\t    {\n39\t      \"id\": \"US-002\",\n40\t      \"title\": \"Write 6 SEO-optimised travel blog articles about JB for backpackers\",\n41\t      \"priority\": \"high\",\n42\t      \"description\": \"Research backpacker content online and write 6 original, high-quality blog articles targeting tourists visiting Johor Bahru. Articles must be 600-900 words each, written in friendly travel-guide style, and contain keywords backpackers actually search for. Include internal links to /guide, /rooms, and /book pages. Topics: (1) Ultimate JB Food Guide for Backpackers, (2) Singapore to JB Day Trip Guide: How to Cross the Causeway, (3) Top 10 Things to Do in Johor Bahru on a Budget, (4) JB Street Food Hawker Centers You Must Visit, (5) Johor Bahru vs Singapore: Why Savvy Travellers Base Themselves in JB, (6) Hidden Gems in Johor Bahru: Beyond the Usual Tourist Spots. Each article must have a unique slug, proper SEO metadata, and be added to posts.ts.\",\n43\t      \"acceptanceCriteria\": [\n44\t        \"All 6 articles exist in posts.ts with unique slugs, titles, excerpts, categories, dates, and tags\",\n45\t        \"Each article body is 600-900 words of original, rewritten content (not copied)\",\n46\t        \"Each article contains 2-3 internal links to /guide, /rooms, or /book\",\n47\t        \"Articles cover: food, border crossing, budget activities, hawker centers, JB vs SG comparison, hidden gems\",\n48\t        \"All articles have SEO-friendly titles with keywords like 'Johor Bahru', 'JB', 'budget', 'backpacker'\"\n49\t      ],\n50\t      \"technicalNotes\": [\n51\t        \"site/src/data/blog/posts.ts â€” add all 6 articles\",\n52\t        \"Research sources: numbeo.com, hostelworld.com, lonelyplanet.com, timeout.com/kuala-lumpur, thepoortraveler.net\",\n53\t        \"Content must be original rewrites, not copy-paste\",\n54\t        \"Use categories: 'Food & Drink', 'Travel Tips', 'Things To Do', 'Local Life'\",\n55\t        \"Tags should include: johor-bahru, singapore, budget-travel, food, backpacker, malaysia\"\n56\t      ],\n57\t      \"dependencies\": [\n58\t        \"US-001\"\n59\t      ],\n60\t      \"estimatedComplexity\": \"large\",\n61\t      \"passes\": true\n62\t    },\n63\t    {\n64\t      \"id\": \"US-003\",\n65\t      \"title\": \"Add RSS/Atom feed at /feed.xml for the blog\",\n66\t      \"priority\": \"medium\",\n67\t      \"description\": \"Create a Next.js Route Handler at /app/feed.xml/route.ts that returns a valid RSS 2.0 XML feed from the blog posts data. The feed must include: channel title, link, description, language, and item entries with title, link, description (excerpt), pubDate, category, and guid. Add a <link rel='alternate' type='application/rss+xml'> tag in layout.tsx. Also add the feed URL to robots.ts.\",\n68\t      \"acceptanceCriteria\": [\n69\t        \"GET /feed.xml returns valid RSS 2.0 XML with Content-Type: application/xml\",\n70\t        \"Feed contains all blog posts as <item> entries\",\n71\t        \"Each item has title, link, description, pubDate, and guid\",\n72\t        \"layout.tsx has <link rel='alternate' type='application/rss+xml' href='/feed.xml'>\",\n73\t        \"TypeScript compiles without errors\"\n74\t      ],\n75\t      \"technicalNotes\": [\n76\t        \"site/src/app/feed.xml/route.ts â€” Route Handler returning XML\",\n77\t        \"Import posts from /src/data/blog/posts.ts\",\n78\t        \"Use Response with headers {'Content-Type': 'application/xml'}\",\n79\t        \"site/src/app/layout.tsx â€” add RSS link in <head>\"\n80\t      ],\n81\t      \"dependencies\": [\n82\t        \"US-001\"\n83\t      ],\n84\t      \"estimatedComplexity\": \"small\",\n85\t      \"passes\": true\n86\t    },\n87\t    {\n88\t      \"id\": \"US-004\",\n89\t      \"title\": \"Add JB News & Updates widget on homepage using curated RSS links\",\n90\t      \"priority\": \"medium\",\n91\t      \"description\": \"Add a 'JB Buzz' section on the homepage between CommunityEvents and the teaser section. This is a static, curated section (no live API calls at runtime to avoid SSR issues). It should show: (1) a list of 4-5 curated news/blog links from real JB/Malaysia sources like Johor Now, Malay Mail, The Star Johor, and Visit Johor â€” shown as stylish news cards with title, source, date, and a short description. (2) An RSS subscribe button linking to /feed.xml. (3) A 'Latest from Our Blog' teaser showing the 3 most recent blog posts. All links open in new tab with rel='noopener noreferrer'.\",\n92\t      \"acceptanceCriteria\": [\n93\t        \"New 'JB Buzz' section visible on homepage with at least 4 curated external news links\",\n94\t        \"Section has 'Latest from Our Blog' showing 3 most recent blog post cards\",\n95\t        \"RSS subscribe button links to /feed.xml\",\n96\t        \"All external links have rel='noopener noreferrer' and target='_blank'\",\n97\t        \"Section looks consistent with existing design (stone/amber color scheme, rounded cards)\"\n98\t      ],\n99\t      \"technicalNotes\": [\n100\t        \"site/src/components/JBBuzz.tsx â€” new component\",\n101\t        \"site/src/app/page.tsx â€” import and add <JBBuzz /> after <CommunityEvents />\",\n102\t        \"Curated links: johornow.com, malaymail.com, thestar.com.my, visitjohor.com\",\n103\t        \"Latest blog posts: import from posts.ts and show top 3 by date\",\n104\t        \"Use same card styling as other homepage sections\"\n105\t      ],\n106\t      \"dependencies\": [\n107\t        \"US-001\",\n108\t        \"US-002\"\n109\t      ],\n110\t      \"estimatedComplexity\": \"medium\",\n111\t      \"passes\": true\n112\t    },\n113\t    {\n114\t      \"id\": \"US-005\",\n115\t      \"title\": \"Add Article schema and BreadcrumbList structured data to blog pages\",\n116\t      \"priority\": \"high\",\n117\t      \"description\": \"Enhance SEO with JSON-LD structured data. Add Article schema to each /blog/[slug] page (type: BlogPosting, headline, description, author, datePublished, image, publisher). Add BreadcrumbList schema to /blog and /blog/[slug] pages. Update the existing StructuredData component or create a new BlogStructuredData component. Also add FAQ schema to the homepage FAQ section if it does not already exist.\",\n118\t      \"acceptanceCriteria\": [\n119\t        \"/blog/[slug] pages include JSON-LD <script> with BlogPosting schema\",\n120\t        \"BlogPosting includes: headline, description, datePublished, author (name: 'Pelangi Capsule Hostel'), publisher (name, logo), image\",\n121\t        \"/blog and /blog/[slug] include BreadcrumbList JSON-LD\",\n122\t        \"No TypeScript errors\",\n123\t        \"Schema validates correctly (structure is correct JSON-LD)\"\n124\t      ],\n125\t      \"technicalNotes\": [\n126\t        \"site/src/components/BlogStructuredData.tsx â€” new component accepting post data\",\n127\t        \"site/src/app/blog/[slug]/page.tsx â€” import and render BlogStructuredData\",\n128\t        \"BreadcrumbList: Home > Blog > Article Title\",\n129\t        \"Publisher logo URL: https://pelangicapsulehostel.com/images/logo.png\"\n130\t      ],\n131\t      \"dependencies\": [\n132\t        \"US-001\"\n133\t      ],\n134\t      \"estimatedComplexity\": \"small\",\n135\t      \"passes\": true\n136\t    },\n137\t    {\n138\t      \"id\": \"US-006\",\n139\t      \"title\": \"Update sitemap.ts to include all blog posts\",\n140\t      \"priority\": \"high\",\n141\t      \"description\": \"Update /app/sitemap.ts to dynamically include all blog post URLs. Import the posts array from /src/data/blog/posts.ts. For each post, add an entry with url: `${baseUrl}/blog/${post.slug}`, lastModified using post.date, changeFrequency: 'monthly', and priority: 0.7. Also add the /blog listing page with priority 0.8. This ensures Google can discover and index all articles.\",\n142\t      \"acceptanceCriteria\": [\n143\t        \"/sitemap.xml includes /blog URL with priority 0.8\",\n144\t        \"/sitemap.xml includes all individual blog post URLs\",\n145\t        \"Each blog post entry has correct slug from posts.ts\",\n146\t        \"TypeScript compiles without errors\",\n147\t        \"No hardcoded slugs â€” all generated dynamically from posts array\"\n148\t      ],\n149\t      \"technicalNotes\": [\n150\t        \"site/src/app/sitemap.ts â€” update to import posts and map to sitemap entries\",\n151\t        \"Import: import { posts } from '@/data/blog/posts'\",\n152\t        \"Add /blog and /blog/[slug] entries to the returned array\"\n153\t      ],\n154\t      \"dependencies\": [\n155\t        \"US-001\"\n156\t      ],\n157\t      \"estimatedComplexity\": \"small\",\n158\t      \"passes\": true\n159\t    },\n160\t    {\n161\t      \"id\": \"US-007\",\n162\t      \"title\": \"Enhance /guide page with rich backpacker-focused local content\",\n163\t      \"priority\": \"medium\",\n164\t      \"description\": \"Substantially improve the /guide page (site/src/app/guide/page.tsx) with richer, more lively content for backpackers. Add sections: (1) Getting Around JB â€” GrabCar, bus, taxi fares with real prices; (2) Money & Currency â€” where to exchange, ATMs near Taman Pelangi; (3) Singapore Day Trip â€” Causeway vs Second Link, immigration tips, operating hours; (4) Top Hawker Centers Near Us â€” with distance and opening hours; (5) Safety Tips for Backpackers; (6) Useful Local Apps â€” Grab, MyRapid, MySejahtera. All with practical, accurate information. Add internal links to /blog articles where relevant.\",\n165\t      \"acceptanceCriteria\": [\n166\t        \"/guide page has at least 6 content sections as described\",\n167\t        \"Each section has practical, specific information (prices, distances, hours â€” not vague)\",\n168\t        \"Page has proper metadata with 'Johor Bahru local guide backpacker' keywords\",\n169\t        \"Internal links to 2+ blog articles (once those exist)\",\n170\t        \"Consistent design with rest of site (Tailwind, stone/amber palette)\"\n171\t      ],\n172\t      \"technicalNotes\": [\n173\t        \"site/src/app/guide/page.tsx â€” read existing file first, then enhance\",\n174\t        \"Add generateMetadata with description targeting 'JB travel guide backpacker' keywords\",\n175\t        \"Currency exchange: Jalan Wong Ah Fook money changers\",\n176\t        \"Causeway: open 24h, busiest 7-9am and 5-8pm\",\n177\t        \"Add Link components pointing to /blog articles\"\n178\t      ],\n179\t      \"dependencies\": [\n180\t        \"US-002\"\n181\t      ],\n182\t      \"estimatedComplexity\": \"medium\",\n183\t      \"passes\": true\n184\t    },\n185\t    {\n186\t      \"id\": \"US-008\",\n187\t      \"title\": \"Add 'Singapore Day Trip' teaser section to homepage\",\n188\t      \"priority\": \"low\",\n189\t      \"description\": \"Add a visually compelling 'Singapore from JB' section on the homepage between LocationMap and FAQ. It should highlight: 30-min Singapore proximity, cost comparison (JB accommodation vs SG), Causeway/Second Link access, and link to the blog article about Singapore day trips. Include a CTA button to the relevant blog article. Use an eye-catching gradient or illustration.\",\n190\t      \"acceptanceCriteria\": [\n191\t        \"New section visible on homepage between LocationMap and FAQ\",\n192\t        \"Section shows Singapore distance/proximity callout (30 min from border)\",\n193\t        \"Section shows cost comparison stat (e.g. 'Save 70% on accommodation vs Singapore')\",\n194\t        \"CTA button links to /blog/singapore-day-trip-from-jb or /guide\",\n195\t        \"Responsive design matches rest of site\"\n196\t      ],\n197\t      \"technicalNotes\": [\n198\t        \"site/src/components/SingaporeTeaser.tsx â€” new component\",\n199\t        \"site/src/app/page.tsx â€” add <SingaporeTeaser /> between <LocationMap /> and <FAQ />\",\n200\t        \"Use amber/warm gradient background to stand out\",\n201\t        \"Keep it concise â€” 3-4 stat/icon cards max\"\n202\t      ],\n203\t      \"dependencies\": [\n204\t        \"US-002\"\n205\t      ],\n206\t      \"estimatedComplexity\": \"small\",\n207\t      \"passes\": true\n208\t    },\n209\t    {\n210\t      \"id\": \"US-009\",\n211\t      \"title\": \"Create /book page with direct booking + OTA options\",\n212\t      \"priority\": \"critical\",\n213\t      \"description\": \"The /book URL is linked from the homepage dashboard card, footer, Hero CTAs, and multiple components, but no app/book/page.tsx exists — users hit a 404. Create a dedicated booking page with: (1) direct WhatsApp booking as primary CTA with pre-filled message, (2) direct booking benefits section, (3) Booking.com and Hostelworld links as secondary OTA options, (4) pricing summary (RM35 nightly, RM594 monthly), and (5) house rules summary.\",\n214\t      \"acceptanceCriteria\": [\n215\t        \"GET /book returns a 200 page (no 404)\",\n216\t        \"Page has a primary WhatsApp CTA that opens wa.me/60127088789 with a pre-filled booking message\",\n217\t        \"Page shows nightly (RM35-45) and monthly (RM594) pricing clearly\",\n218\t        \"Page has secondary links to Booking.com and Hostelworld listings\",\n219\t        \"Page has proper generateMetadata with title/description targeting 'book capsule hostel JB'\",\n220\t        \"Responsive design consistent with site (stone/amber palette, Tailwind)\"\n221\t      ],\n222\t      \"technicalNotes\": [\n223\t        \"Create site/src/app/book/page.tsx\",\n224\t        \"Pre-filled WhatsApp URL: https://wa.me/60127088789?text=Hi%20Pelangi%20Capsule%20Hostel!%20I'd%20like%20to%20book%20a%20pod.%20Please%20confirm%20availability%20for%20[dates].\",\n225\t        \"Check-in: 2:00 PM / Check-out: 12:00 PM (from business data)\",\n226\t        \"Import Booking.tsx component or build inline; reuse existing amber/stone card patterns\"\n227\t      ],\n228\t      \"dependencies\": [],\n229\t      \"estimatedComplexity\": \"medium\",\n230\t      \"passes\": true\n231\t    },\n232\t    {\n233\t      \"id\": \"US-010\",\n234\t      \"title\": \"Create custom not-found.tsx (404 page) with hostel branding\",\n235\t      \"priority\": \"high\",\n236\t      \"description\": \"No app/not-found.tsx exists; Next.js App Router serves a generic 404. A branded 404 page recovers lost visitors by surfacing key navigation links and a WhatsApp booking CTA. Google recommends soft 404 handling (do not redirect all 404s to homepage) — a proper not-found.tsx is the correct approach.\",\n237\t      \"acceptanceCriteria\": [\n238\t        \"app/not-found.tsx file exists and renders on any invalid URL\",\n239\t        \"Page has a friendly on-brand message (e.g. 'Looks like this pod is taken!')\",\n240\t        \"Page includes navigation links to: Home, Rooms, /book, /guide, /blog\",\n241\t        \"Page includes a WhatsApp contact CTA\",\n242\t        \"Header and Footer are present for consistent navigation\",\n243\t        \"Page has proper HTTP 404 status (not 200) — Next.js App Router not-found.tsx sets this automatically\"\n244\t      ],\n245\t      \"technicalNotes\": [\n246\t        \"Create site/src/app/not-found.tsx (not 404.tsx — App Router convention)\",\n247\t        \"Import Header and Footer components\",\n248\t        \"Use amber/stone design consistent with rest of site\",\n249\t        \"No generateMetadata needed — Next.js sets noindex automatically for 404 pages\"\n250\t      ],\n251\t      \"dependencies\": [],\n252\t      \"estimatedComplexity\": \"small\",\n253\t      \"passes\": true\n254\t    },\n255\t    {\n256\t      \"id\": \"US-011\",\n257\t      \"title\": \"Fix NAP inconsistency in StructuredData.tsx (wrong phone and address)\",\n258\t      \"priority\": \"high\",\n259\t      \"description\": \"StructuredData.tsx contains factually incorrect business data: phone is '+60123456789' (placeholder, not a real number) and street address is 'Jalan Maju, Taman Pelangi' (wrong — correct is '26A Jalan Perang'). NAP (Name, Address, Phone) must exactly match Google Business Profile for local search trust. These errors could suppress local ranking and confuse map integrations.\",\n260\t      \"acceptanceCriteria\": [\n261\t        \"telephone in Hostel schema is '+60127088789' (Jay's real number from business data)\",\n262\t        \"streetAddress in Hostel schema is '26A Jalan Perang, Taman Pelangi'\",\n263\t        \"Same NAP fixes applied to localBusinessSchema in same file\",\n264\t        \"geo coordinates updated to 5 decimal precision (e.g. latitude: 1.48552, longitude: 103.75940)\",\n265\t        \"checkinTime updated to '14:00' (business data shows 2:00 PM, not 15:00)\",\n266\t        \"TypeScript compiles without errors after changes\"\n267\t      ],\n268\t      \"technicalNotes\": [\n269\t        \"Edit site/src/components/StructuredData.tsx\",\n270\t        \"Correct phone: +60127088789 (Jay) — from pelangi-website-plan.md\",\n271\t        \"Correct address: 26A Jalan Perang, Taman Pelangi, 80400 Johor Bahru\",\n272\t        \"Check-in from plan: 2:00 PM = 14:00 in ISO 8601; current file has 15:00\",\n273\t        \"Validate via: https://search.google.com/test/rich-results after fix\"\n274\t      ],\n275\t      \"dependencies\": [],\n276\t      \"estimatedComplexity\": \"small\",\n277\t      \"passes\": true\n278\t    },\n279\t    {\n280\t      \"id\": \"US-012\",\n281\t      \"title\": \"Add FAQPage JSON-LD schema to FAQ component\",\n282\t      \"priority\": \"high\",\n283\t      \"description\": \"The FAQ.tsx component renders a set of Q&A items on the homepage, but there is no FAQPage JSON-LD structured data. Adding the FAQPage schema can earn an expandable FAQ rich result in Google SERPs, increasing click-through rate. This is one of the highest-ROI structured data additions for a local business.\",\n284\t      \"acceptanceCriteria\": [\n285\t        \"Homepage (or FAQ component) renders a <script type='application/ld+json'> with @type: 'FAQPage'\",\n286\t        \"Each FAQ item maps to a Question with name (question text) and acceptedAnswer.text\",\n287\t        \"Schema validates without errors in Google Rich Results Test\",\n288\t        \"Questions include high-value search queries: check-in time, WiFi, price, location, Singapore proximity\",\n289\t        \"No TypeScript errors\"\n290\t      ],\n291\t      \"technicalNotes\": [\n292\t        \"Edit site/src/components/FAQ.tsx or inject from site/src/app/page.tsx\",\n293\t        \"Schema structure: { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: [ { '@type': 'Question', name: '...', acceptedAnswer: { '@type': 'Answer', text: '...' } } ] }\",\n294\t        \"Keep answer text concise (1-3 sentences) to maximize SERP display\",\n295\t        \"Validate at: https://search.google.com/test/rich-results\",\n296\t        \"Reference: https://developers.google.com/search/docs/appearance/structured-data/faqpage\"\n297\t      ],\n298\t      \"dependencies\": [],\n299\t      \"estimatedComplexity\": \"small\",\n300\t      \"passes\": true\n301\t    },\n302\t    {\n303\t      \"id\": \"US-013\",\n304\t      \"title\": \"Add dynamic OG images for blog posts using next/og ImageResponse\",\n305\t      \"priority\": \"medium\",\n306\t      \"description\": \"All blog posts currently share the same static /images/og-image.png when shared on social media. Next.js App Router supports per-route dynamic OG image generation via opengraph-image.tsx using the ImageResponse API. Adding per-post OG images with the article title, category badge, and branding significantly improves social sharing click-through from WhatsApp, Facebook, and Twitter.\",\n307\t      \"acceptanceCriteria\": [\n308\t        \"Each blog post URL generates a unique 1200x630 OG image when scraped by social crawlers\",\n309\t        \"OG image shows: post title (large text), category badge, site name 'Pelangi Capsule Hostel', amber/stone brand colors\",\n310\t        \"Validates correctly with Facebook Sharing Debugger and Twitter Card Validator\",\n311\t        \"No TypeScript errors\",\n312\t        \"Image generation does not exceed 500KB bundle limit\"\n313\t      ],\n314\t      \"technicalNotes\": [\n315\t        \"Create site/src/app/blog/[slug]/opengraph-image.tsx\",\n316\t        \"Use ImageResponse from 'next/og'\",\n317\t        \"Export: export const size = { width: 1200, height: 630 } and export const contentType = 'image/png'\",\n318\t        \"Only flexbox CSS supported in ImageResponse (no grid)\",\n319\t        \"Font: use fetch() to load .ttf font or use system font fallback\",\n320\t        \"Access post data via params.slug — import posts from data/blog/posts.ts\",\n321\t        \"Reference: https://nextjs.org/docs/app/api-reference/file-conventions/opengraph-image\"\n322\t      ],\n323\t      \"dependencies\": [],\n324\t      \"estimatedComplexity\": \"medium\",\n325\t      \"passes\": true\n326\t    },\n327\t    {\n328\t      \"id\": \"US-014\",\n329\t      \"title\": \"Add HotelRoom structured data with Offer pricing on /rooms page\",\n330\t      \"priority\": \"medium\",\n331\t      \"description\": \"The /rooms page describes capsule pod pricing but has no structured data. Google's hotel rich results support HotelRoom schema (typed as ['HotelRoom', 'Product']) with Offer/UnitPriceSpecification for pricing. Adding this can make pricing visible in Google Search and enable integration with Google Hotels panel. This is separate from the site-level Hostel schema already in StructuredData.tsx.\",\n332\t      \"acceptanceCriteria\": [\n333\t        \"/rooms page includes JSON-LD with @type: ['HotelRoom', 'Product'] for each pod type\",\n334\t        \"Each room has: name, description, containedInPlace (linking to hostel schema), and offers (Offer with price, priceCurrency, businessFunction)\",\n335\t        \"Nightly rate (RM35-45) and monthly rate (RM594) are both represented\",\n336\t        \"Schema validates in Google Rich Results Test without errors\",\n337\t        \"No TypeScript errors\"\n338\t      ],\n339\t      \"technicalNotes\": [\n340\t        \"Edit site/src/app/rooms/page.tsx to inject JSON-LD script\",\n341\t        \"Dual type: '@type': ['HotelRoom', 'Product'] — both required for pricing rich results\",\n342\t        \"Offer structure: { '@type': 'Offer', 'price': '35', 'priceCurrency': 'MYR', 'businessFunction': 'http://purl.org/goodrelations/v1#LeaseOut' }\",\n343\t        \"containedInPlace: { '@type': 'Hostel', 'name': 'Pelangi Capsule Hostel', 'url': 'https://pelangicapsulehostel.com' }\",\n344\t        \"Reference: https://schema.org/HotelRoom and https://wordlift.io/blog/en/schema-markup-for-hotels-bb-and-resorts-a-complete-guide/\"\n345\t      ],\n346\t      \"dependencies\": [],\n347\t      \"estimatedComplexity\": \"small\",\n348\t      \"passes\": true\n349\t    },\n350\t    {\n351\t      \"id\": \"US-015\",\n352\t      \"title\": \"Add Google Search Console verification meta tag to layout.tsx\",\n353\t      \"priority\": \"medium\",\n354\t      \"description\": \"layout.tsx has a TODO comment: '// TODO: Add your Google Search Console verification code'. Google Search Console is required to monitor indexing status, Core Web Vitals data, search performance, and submit sitemaps. Without verification, there is no visibility into whether Google is correctly crawling the site. This is a one-line configuration change.\",\n355\t      \"acceptanceCriteria\": [\n356\t        \"layout.tsx metadata includes a valid Google Search Console verification code\",\n357\t        \"Google Search Console shows the property as 'verified'\",\n358\t        \"The sitemap URL (https://pelangicapsulehostel.com/sitemap.xml) is submitted in GSC\",\n359\t        \"No TypeScript errors\"\n360\t      ],\n361\t      \"technicalNotes\": [\n362\t        \"Edit site/src/app/layout.tsx — find the verification: {} object\",\n363\t        \"Add: verification: { google: 'YOUR_VERIFICATION_TOKEN' }\",\n364\t        \"Get token from: Google Search Console > Add Property > HTML tag method\",\n365\t        \"After deploy, verify ownership in GSC and submit sitemap.xml\",\n366\t        \"Reference: https://nextjs.org/docs/app/api-reference/functions/generate-metadata#verification\"\n367\t      ],\n368\t      \"dependencies\": [],\n369\t      \"estimatedComplexity\": \"small\",\n370\t      \"passes\": true\n371\t    },\n372\t    {\n373\t      \"id\": \"US-016\",\n374\t      \"title\": \"Add sticky mobile WhatsApp booking bar for conversion\",\n375\t      \"priority\": \"medium\",\n376\t      \"description\": \"WhatsApp has a 98% open rate and 45-60% conversion rate for hospitality. Mobile visitors (majority of hostel traffic) should always see a persistent 'Book via WhatsApp' CTA regardless of scroll position. A sticky bottom bar appearing on mobile-only (hidden on desktop where the chat widget serves this role) is a proven conversion pattern for small hostels. The pre-filled message reduces friction.\",\n377\t      \"acceptanceCriteria\": [\n378\t        \"A sticky bar appears at the bottom of all pages on mobile (hidden on md: and above)\",\n379\t        \"Bar contains: WhatsApp icon, 'Book from RM35/night' text, and a green CTA button\",\n380\t        \"Clicking opens wa.me/60127088789 with pre-filled booking message\",\n381\t        \"Bar does not overlap the existing ChatWidget floating button (positioned to avoid conflict)\",\n382\t        \"Bar is hidden when the ChatWidget is open\",\n383\t        \"Accessible: has aria-label and sufficient color contrast\"\n384\t      ],\n385\t      \"technicalNotes\": [\n386\t        \"Create site/src/components/MobileBookingBar.tsx\",\n387\t        \"Add to site/src/app/layout.tsx (renders on all pages)\",\n388\t        \"Use fixed bottom-0 left-0 right-0 z-40 (below ChatWidget's z-50)\",\n389\t        \"Hidden on md+ screens: className='md:hidden'\",\n390\t        \"Pre-filled URL: https://wa.me/60127088789?text=Hi!%20I'd%20like%20to%20book%20a%20pod%20at%20Pelangi%20Capsule%20Hostel.\",\n391\t        \"Add padding-bottom to <body> or main sections to prevent bar from covering content\"\n392\t      ],\n393\t      \"dependencies\": [],\n394\t      \"estimatedComplexity\": \"small\",\n395\t      \"passes\": true\n396\t    },\n397\t    {\n398\t      \"id\": \"US-017\",\n399\t      \"title\": \"Add canonical URL tags to all inner pages via generateMetadata\",\n400\t      \"priority\": \"medium\",\n401\t      \"description\": \"Currently only the homepage has an explicit canonical URL in metadata. Inner pages (/about, /rooms, /gallery, /contact, /check-in, /guide, /book) rely on Next.js auto-generation, which may not produce the exact preferred URL format. Explicit canonical tags on each page prevent duplicate content issues and confirm the preferred URL to Google — especially important now that blog posts exist with similar content themes.\",\n402\t      \"acceptanceCriteria\": [\n403\t        \"Each inner page (/about, /rooms, /gallery, /contact, /check-in, /guide, /book) has generateMetadata with alternates.canonical set to the full absolute URL\",\n404\t        \"/blog page and /blog/[slug] pages already have canonical set (verify existing implementation)\",\n405\t        \"Canonical URLs use https://pelangicapsulehostel.com as base (no trailing slash inconsistency)\",\n406\t        \"TypeScript compiles without errors\"\n407\t      ],\n408\t      \"technicalNotes\": [\n409\t        \"Edit each page.tsx to add export async function generateMetadata()\",\n410\t        \"Pattern: alternates: { canonical: 'https://pelangicapsulehostel.com/PAGE_PATH' }\",\n411\t        \"Pages to update: /about, /rooms, /gallery, /contact, /check-in, /guide\",\n412\t        \"Verify blog pages already have this from US-005 implementation\",\n413\t        \"Reference: https://nextjs.org/docs/app/api-reference/functions/generate-metadata#alternates\"\n414\t      ],\n415\t      \"dependencies\": [],\n416\t      \"estimatedComplexity\": \"small\",\n417\t      \"passes\": true\n418\t    },\n419\t    {\n420\t      \"id\": \"US-018\",\n421\t      \"title\": \"Add Core Web Vitals optimization: hero image priority and lazy-loading\",\n422\t      \"priority\": \"medium\",\n423\t      \"description\": \"The Hero component (Hero.tsx) likely uses a large banner image that is the Largest Contentful Paint (LCP) element. Without the `priority` prop on the Next.js Image component, the hero image is lazy-loaded, causing LCP scores above 4s on mobile — a Google ranking signal. Additionally, below-fold images should be explicitly lazy-loaded and sized with the `sizes` attribute to prevent Cumulative Layout Shift (CLS). Target: LCP < 2.5s, CLS < 0.1.\",\n424\t      \"acceptanceCriteria\": [\n425\t        \"Hero image uses <Image priority> prop (no lazy loading on LCP element)\",\n426\t        \"Hero image has explicit width, height, and sizes attribute set\",\n427\t        \"All gallery images and below-fold images use loading='lazy' or default lazy behavior\",\n428\t        \"No images use width/height that cause layout shift (CLS < 0.1)\",\n429\t        \"PageSpeed Insights mobile score improves (document current score before, target 70+)\"\n430\t      ],\n431\t      \"technicalNotes\": [\n432\t        \"Read site/src/components/Hero.tsx first to check current Image usage\",\n433\t        \"Add priority prop to the hero <Image> component\",\n434\t        \"Add sizes='(max-width: 768px) 100vw, 1920px' to hero image\",\n435\t        \"Check Gallery.tsx for images without explicit dimensions\",\n436\t        \"Reference: https://nextjs.org/docs/pages/api-reference/components/image#priority\",\n437\t        \"Test with: https://pagespeed.web.dev/ (mobile tab)\"\n438\t      ],\n439\t      \"dependencies\": [],\n440\t      \"estimatedComplexity\": \"small\",\n441\t      \"passes\": true\n442\t    },\n443\t    {\n444\t      \"id\": \"US-019\",\n445\t      \"title\": \"Add web app manifest (manifest.json) for mobile installability\",\n446\t      \"priority\": \"low\",\n447\t      \"description\": \"Next.js 15 App Router supports manifest.ts for generating a PWA web app manifest. A manifest enables 'Add to Home Screen' prompts on iOS/Android, giving repeat visitors (e.g. long-stay guests checking house rules, WiFi password, check-in guide) a native-app-like experience. This is particularly valuable for the /check-in page which guests may reference repeatedly during their stay.\",\n448\t      \"acceptanceCriteria\": [\n449\t        \"GET /manifest.json returns a valid Web App Manifest JSON\",\n450\t        \"Manifest includes: name, short_name, start_url, display, background_color, theme_color, icons\",\n451\t        \"At minimum two icon sizes: 192x192 and 512x512 (PNG format)\",\n452\t        \"theme_color matches the amber brand (#a68b64 or similar)\",\n453\t        \"Browser shows 'Add to Home Screen' prompt on eligible Android devices\"\n454\t      ],\n455\t      \"technicalNotes\": [\n456\t        \"Create site/src/app/manifest.ts (Next.js App Router convention)\",\n457\t        \"Export default function manifest(): MetadataRoute.Manifest\",\n458\t        \"Icons: create /public/icons/icon-192.png and /public/icons/icon-512.png\",\n459\t        \"start_url: '/', display: 'standalone'\",\n460\t        \"Reference: https://nextjs.org/docs/app/api-reference/file-conventions/metadata/manifest\"\n461\t      ],\n462\t      \"dependencies\": [],\n463\t      \"estimatedComplexity\": \"small\",\n464\t      \"passes\": true\n465\t    },\n466\t    {\n467\t      \"id\": \"US-020\",\n468\t      \"title\": \"Add hreflang tags for EN/ZH-CN multilingual SEO groundwork\",\n469\t      \"priority\": \"low\",\n470\t      \"description\": \"Pelangi Capsule Hostel's primary market includes Singapore and Malaysian Chinese-speaking travelers. The website content doc explicitly calls for EN/ZH support. Even before a full Chinese translation is available, adding hreflang infrastructure (x-default + en) in generateMetadata prevents future SEO migration pain. A Chinese landing page at /zh targeting Singapore Chinese travelers is a second phase. Hreflang is bidirectional — each language version must reference all others.\",\n471\t      \"acceptanceCriteria\": [\n472\t        \"layout.tsx metadata includes alternates.languages with at minimum 'en' and 'x-default' pointing to canonical URL\",\n473\t        \"Code is structured to easily add 'zh-CN': 'https://pelangicapsulehostel.com/zh' when Chinese content is ready\",\n474\t        \"HTML lang attribute in layout.tsx is 'en' (currently correct — verify it stays 'en' not 'en-MY')\",\n475\t        \"No TypeScript errors\"\n476\t      ],\n477\t      \"technicalNotes\": [\n478\t        \"Edit site/src/app/layout.tsx metadata.alternates\",\n479\t        \"Add: languages: { 'en': 'https://pelangicapsulehostel.com', 'x-default': 'https://pelangicapsulehostel.com' }\",\n480\t        \"When /zh exists, add: 'zh-CN': 'https://pelangicapsulehostel.com/zh'\",\n481\t        \"Reference: https://developers.google.com/search/docs/specialty/international/localized-versions\",\n482\t        \"Use i18n: subdirectory approach (/zh/) not query params (?lang=zh)\"\n483\t      ],\n484\t      \"dependencies\": [],\n485\t      \"estimatedComplexity\": \"small\",\n486\t      \"passes\": true\n487\t    },\n488\t    {\n489\t      \"id\": \"US-021\",\n490\t      \"title\": \"Add Instagram social link to Footer and fix social media URLs\",\n491\t      \"priority\": \"low\",\n492\t      \"description\": \"The Footer currently has Facebook and WhatsApp links, but Instagram is missing despite being a key discovery channel for budget traveler audiences. The Facebook URL (pelangicapsulehostel) and Google Business URL (g.page/pelangicapsulehostel) are placeholder-style and may not resolve to real profiles. Confirm all social URLs are live and add Instagram.\",\n493\t      \"acceptanceCriteria\": [\n494\t        \"Footer has an Instagram icon linking to the hostel's real Instagram profile\",\n495\t        \"Facebook URL is verified as a live page (not a 404)\",\n496\t        \"Google Business URL resolves to the real Google Maps listing\",\n497\t        \"All social links open in new tab with rel='noopener noreferrer'\",\n498\t        \"Consistent icon styling with existing social icons in Footer.tsx\"\n499\t      ],\n500\t      \"technicalNotes\": [\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"6b67213d-2eef-4ac1-bb69-724ff9b6a3c0","uuid":"8cfd7818-be30-48b0-953e-0ce8fdb8643e","timestamp":"2026-04-14T01:53:01.005Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\prd.json","content":"{\n  \"productName\": \"Pelangi Capsule Hostel Website\",\n  \"branchName\": \"master\",\n  \"overview\": \"Enhance the Next.js 15 hostel website with a full blog system, SEO-optimised travel articles about Johor Bahru & Singapore, RSS feed, live JB news widget, and richer content to attract backpackers searching for budget accommodation near the Singapore-Malaysia border.\",\n  \"goals\": [\n    \"Create a blog system with static TypeScript posts for long-tail SEO\",\n    \"Publish 6+ high-quality, original travel articles about JB and Singapore for tourists\",\n    \"Add RSS/Atom feed at /feed.xml for the blog\",\n    \"Add a 'JB News & Updates' widget on the homepage pulling from curated RSS sources\",\n    \"Enhance structured data (Article, BreadcrumbList schemas) and internal linking\",\n    \"Update sitemap.ts to include all blog post URLs\",\n    \"Improve the /guide page with richer, more lively backpacker-focused content\"\n  ],\n  \"userStories\": [\n    {\n      \"id\": \"US-001\",\n      \"title\": \"Create blog system with static TypeScript data\",\n      \"priority\": \"high\",\n      \"description\": \"Build a blog system using Next.js App Router. Blog posts are stored as TypeScript objects in /src/data/blog/posts.ts. Each post has: slug, title, excerpt, content (HTML string), date, category, author, readTime, tags, and featured image path. Create /app/blog/page.tsx (listing with cards) and /app/blog/[slug]/page.tsx (article page with full content). Both pages must have proper metadata (title, description, OG tags). Add a BlogCard component at /src/components/BlogCard.tsx.\",\n      \"acceptanceCriteria\": [\n        \"/blog page renders a grid of blog post cards with title, excerpt, date, category badge, and read time\",\n        \"/blog/[slug] renders individual article with full HTML content, author, date, tags, and back link\",\n        \"Both pages have generateMetadata with unique title, description, and OG image\",\n        \"TypeScript compiles without errors\",\n        \"No external database or CMS â€” pure static data in /src/data/blog/posts.ts\"\n      ],\n      \"technicalNotes\": [\n        \"site/src/data/blog/posts.ts â€” create blog post data array\",\n        \"site/src/app/blog/page.tsx â€” blog listing page\",\n        \"site/src/app/blog/[slug]/page.tsx â€” individual article page\",\n        \"site/src/components/BlogCard.tsx â€” reusable card component\",\n        \"Use Tailwind prose classes for article body typography\"\n      ],\n      \"dependencies\": [],\n      \"estimatedComplexity\": \"medium\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"US-002\",\n      \"title\": \"Write 6 SEO-optimised travel blog articles about JB for backpackers\",\n      \"priority\": \"high\",\n      \"description\": \"Research backpacker content online and write 6 original, high-quality blog articles targeting tourists visiting Johor Bahru. Articles must be 600-900 words each, written in friendly travel-guide style, and contain keywords backpackers actually search for. Include internal links to /guide, /rooms, and /book pages. Topics: (1) Ultimate JB Food Guide for Backpackers, (2) Singapore to JB Day Trip Guide: How to Cross the Causeway, (3) Top 10 Things to Do in Johor Bahru on a Budget, (4) JB Street Food Hawker Centers You Must Visit, (5) Johor Bahru vs Singapore: Why Savvy Travellers Base Themselves in JB, (6) Hidden Gems in Johor Bahru: Beyond the Usual Tourist Spots. Each article must have a unique slug, proper SEO metadata, and be added to posts.ts.\",\n      \"acceptanceCriteria\": [\n        \"All 6 articles exist in posts.ts with unique slugs, titles, excerpts, categories, dates, and tags\",\n        \"Each article body is 600-900 words of original, rewritten content (not copied)\",\n        \"Each article contains 2-3 internal links to /guide, /rooms, or /book\",\n        \"Articles cover: food, border crossing, budget activities, hawker centers, JB vs SG comparison, hidden gems\",\n        \"All articles have SEO-friendly titles with keywords like 'Johor Bahru', 'JB', 'budget', 'backpacker'\"\n      ],\n      \"technicalNotes\": [\n        \"site/src/data/blog/posts.ts â€” add all 6 articles\",\n        \"Research sources: numbeo.com, hostelworld.com, lonelyplanet.com, timeout.com/kuala-lumpur, thepoortraveler.net\",\n        \"Content must be original rewrites, not copy-paste\",\n        \"Use categories: 'Food & Drink', 'Travel Tips', 'Things To Do', 'Local Life'\",\n        \"Tags should include: johor-bahru, singapore, budget-travel, food, backpacker, malaysia\"\n      ],\n      \"dependencies\": [\n        \"US-001\"\n      ],\n      \"estimatedComplexity\": \"large\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"US-003\",\n      \"title\": \"Add RSS/Atom feed at /feed.xml for the blog\",\n      \"priority\": \"medium\",\n      \"description\": \"Create a Next.js Route Handler at /app/feed.xml/route.ts that returns a valid RSS 2.0 XML feed from the blog posts data. The feed must include: channel title, link, description, language, and item entries with title, link, description (excerpt), pubDate, category, and guid. Add a <link rel='alternate' type='application/rss+xml'> tag in layout.tsx. Also add the feed URL to robots.ts.\",\n      \"acceptanceCriteria\": [\n        \"GET /feed.xml returns valid RSS 2.0 XML with Content-Type: application/xml\",\n        \"Feed contains all blog posts as <item> entries\",\n        \"Each item has title, link, description, pubDate, and guid\",\n        \"layout.tsx has <link rel='alternate' type='application/rss+xml' href='/feed.xml'>\",\n        \"TypeScript compiles without errors\"\n      ],\n      \"technicalNotes\": [\n        \"site/src/app/feed.xml/route.ts â€” Route Handler returning XML\",\n        \"Import posts from /src/data/blog/posts.ts\",\n        \"Use Response with headers {'Content-Type': 'application/xml'}\",\n        \"site/src/app/layout.tsx â€” add RSS link in <head>\"\n      ],\n      \"dependencies\": [\n        \"US-001\"\n      ],\n      \"estimatedComplexity\": \"small\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"US-004\",\n      \"title\": \"Add JB News & Updates widget on homepage using curated RSS links\",\n      \"priority\": \"medium\",\n      \"description\": \"Add a 'JB Buzz' section on the homepage between CommunityEvents and the teaser section. This is a static, curated section (no live API calls at runtime to avoid SSR issues). It should show: (1) a list of 4-5 curated news/blog links from real JB/Malaysia sources like Johor Now, Malay Mail, The Star Johor, and Visit Johor â€” shown as stylish news cards with title, source, date, and a short description. (2) An RSS subscribe button linking to /feed.xml. (3) A 'Latest from Our Blog' teaser showing the 3 most recent blog posts. All links open in new tab with rel='noopener noreferrer'.\",\n      \"acceptanceCriteria\": [\n        \"New 'JB Buzz' section visible on homepage with at least 4 curated external news links\",\n        \"Section has 'Latest from Our Blog' showing 3 most recent blog post cards\",\n        \"RSS subscribe button links to /feed.xml\",\n        \"All external links have rel='noopener noreferrer' and target='_blank'\",\n        \"Section looks consistent with existing design (stone/amber color scheme, rounded cards)\"\n      ],\n      \"technicalNotes\": [\n        \"site/src/components/JBBuzz.tsx â€” new component\",\n        \"site/src/app/page.tsx â€” import and add <JBBuzz /> after <CommunityEvents />\",\n        \"Curated links: johornow.com, malaymail.com, thestar.com.my, visitjohor.com\",\n        \"Latest blog posts: import from posts.ts and show top 3 by date\",\n        \"Use same card styling as other homepage sections\"\n      ],\n      \"dependencies\": [\n        \"US-001\",\n        \"US-002\"\n      ],\n      \"estimatedComplexity\": \"medium\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"US-005\",\n      \"title\": \"Add Article schema and BreadcrumbList structured data to blog pages\",\n      \"priority\": \"high\",\n      \"description\": \"Enhance SEO with JSON-LD structured data. Add Article schema to each /blog/[slug] page (type: BlogPosting, headline, description, author, datePublished, image, publisher). Add BreadcrumbList schema to /blog and /blog/[slug] pages. Update the existing StructuredData component or create a new BlogStructuredData component. Also add FAQ schema to the homepage FAQ section if it does not already exist.\",\n      \"acceptanceCriteria\": [\n        \"/blog/[slug] pages include JSON-LD <script> with BlogPosting schema\",\n        \"BlogPosting includes: headline, description, datePublished, author (name: 'Pelangi Capsule Hostel'), publisher (name, logo), image\",\n        \"/blog and /blog/[slug] include BreadcrumbList JSON-LD\",\n        \"No TypeScript errors\",\n        \"Schema validates correctly (structure is correct JSON-LD)\"\n      ],\n      \"technicalNotes\": [\n        \"site/src/components/BlogStructuredData.tsx â€” new component accepting post data\",\n        \"site/src/app/blog/[slug]/page.tsx â€” import and render BlogStructuredData\",\n        \"BreadcrumbList: Home > Blog > Article Title\",\n        \"Publisher logo URL: https://pelangicapsulehostel.com/images/logo.png\"\n      ],\n      \"dependencies\": [\n        \"US-001\"\n      ],\n      \"estimatedComplexity\": \"small\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"US-006\",\n      \"title\": \"Update sitemap.ts to include all blog posts\",\n      \"priority\": \"high\",\n      \"description\": \"Update /app/sitemap.ts to dynamically include all blog post URLs. Import the posts array from /src/data/blog/posts.ts. For each post, add an entry with url: `${baseUrl}/blog/${post.slug}`, lastModified using post.date, changeFrequency: 'monthly', and priority: 0.7. Also add the /blog listing page with priority 0.8. This ensures Google can discover and index all articles.\",\n      \"acceptanceCriteria\": [\n        \"/sitemap.xml includes /blog URL with priority 0.8\",\n        \"/sitemap.xml includes all individual blog post URLs\",\n        \"Each blog post entry has correct slug from posts.ts\",\n        \"TypeScript compiles without errors\",\n        \"No hardcoded slugs â€” all generated dynamically from posts array\"\n      ],\n      \"technicalNotes\": [\n        \"site/src/app/sitemap.ts â€” update to import posts and map to sitemap entries\",\n        \"Import: import { posts } from '@/data/blog/posts'\",\n        \"Add /blog and /blog/[slug] entries to the returned array\"\n      ],\n      \"dependencies\": [\n        \"US-001\"\n      ],\n      \"estimatedComplexity\": \"small\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"US-007\",\n      \"title\": \"Enhance /guide page with rich backpacker-focused local content\",\n      \"priority\": \"medium\",\n      \"description\": \"Substantially improve the /guide page (site/src/app/guide/page.tsx) with richer, more lively content for backpackers. Add sections: (1) Getting Around JB â€” GrabCar, bus, taxi fares with real prices; (2) Money & Currency â€” where to exchange, ATMs near Taman Pelangi; (3) Singapore Day Trip â€” Causeway vs Second Link, immigration tips, operating hours; (4) Top Hawker Centers Near Us â€” with distance and opening hours; (5) Safety Tips for Backpackers; (6) Useful Local Apps â€” Grab, MyRapid, MySejahtera. All with practical, accurate information. Add internal links to /blog articles where relevant.\",\n      \"acceptanceCriteria\": [\n        \"/guide page has at least 6 content sections as described\",\n        \"Each section has practical, specific information (prices, distances, hours â€” not vague)\",\n        \"Page has proper metadata with 'Johor Bahru local guide backpacker' keywords\",\n        \"Internal links to 2+ blog articles (once those exist)\",\n        \"Consistent design with rest of site (Tailwind, stone/amber palette)\"\n      ],\n      \"technicalNotes\": [\n        \"site/src/app/guide/page.tsx â€” read existing file first, then enhance\",\n        \"Add generateMetadata with description targeting 'JB travel guide backpacker' keywords\",\n        \"Currency exchange: Jalan Wong Ah Fook money changers\",\n        \"Causeway: open 24h, busiest 7-9am and 5-8pm\",\n        \"Add Link components pointing to /blog articles\"\n      ],\n      \"dependencies\": [\n        \"US-002\"\n      ],\n      \"estimatedComplexity\": \"medium\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"US-008\",\n      \"title\": \"Add 'Singapore Day Trip' teaser section to homepage\",\n      \"priority\": \"low\",\n      \"description\": \"Add a visually compelling 'Singapore from JB' section on the homepage between LocationMap and FAQ. It should highlight: 30-min Singapore proximity, cost comparison (JB accommodation vs SG), Causeway/Second Link access, and link to the blog article about Singapore day trips. Include a CTA button to the relevant blog article. Use an eye-catching gradient or illustration.\",\n      \"acceptanceCriteria\": [\n        \"New section visible on homepage between LocationMap and FAQ\",\n        \"Section shows Singapore distance/proximity callout (30 min from border)\",\n        \"Section shows cost comparison stat (e.g. 'Save 70% on accommodation vs Singapore')\",\n        \"CTA button links to /blog/singapore-day-trip-from-jb or /guide\",\n        \"Responsive design matches rest of site\"\n      ],\n      \"technicalNotes\": [\n        \"site/src/components/SingaporeTeaser.tsx â€” new component\",\n        \"site/src/app/page.tsx â€” add <SingaporeTeaser /> between <LocationMap /> and <FAQ />\",\n        \"Use amber/warm gradient background to stand out\",\n        \"Keep it concise â€” 3-4 stat/icon cards max\"\n      ],\n      \"dependencies\": [\n        \"US-002\"\n      ],\n      \"estimatedComplexity\": \"small\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"US-009\",\n      \"title\": \"Create /book page with direct booking + OTA options\",\n      \"priority\": \"critical\",\n      \"description\": \"The /book URL is linked from the homepage dashboard card, footer, Hero CTAs, and multiple components, but no app/book/page.tsx exists — users hit a 404. Create a dedicated booking page with: (1) direct WhatsApp booking as primary CTA with pre-filled message, (2) direct booking benefits section, (3) Booking.com and Hostelworld links as secondary OTA options, (4) pricing summary (RM35 nightly, RM594 monthly), and (5) house rules summary.\",\n      \"acceptanceCriteria\": [\n        \"GET /book returns a 200 page (no 404)\",\n        \"Page has a primary WhatsApp CTA that opens wa.me/60127088789 with a pre-filled booking message\",\n        \"Page shows nightly (RM35-45) and monthly (RM594) pricing clearly\",\n        \"Page has secondary links to Booking.com and Hostelworld listings\",\n        \"Page has proper generateMetadata with title/description targeting 'book capsule hostel JB'\",\n        \"Responsive design consistent with site (stone/amber palette, Tailwind)\"\n      ],\n      \"technicalNotes\": [\n        \"Create site/src/app/book/page.tsx\",\n        \"Pre-filled WhatsApp URL: https://wa.me/60127088789?text=Hi%20Pelangi%20Capsule%20Hostel!%20I'd%20like%20to%20book%20a%20pod.%20Please%20confirm%20availability%20for%20[dates].\",\n        \"Check-in: 2:00 PM / Check-out: 12:00 PM (from business data)\",\n        \"Import Booking.tsx component or build inline; reuse existing amber/stone card patterns\"\n      ],\n      \"dependencies\": [],\n      \"estimatedComplexity\": \"medium\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"US-010\",\n      \"title\": \"Create custom not-found.tsx (404 page) with hostel branding\",\n      \"priority\": \"high\",\n      \"description\": \"No app/not-found.tsx exists; Next.js App Router serves a generic 404. A branded 404 page recovers lost visitors by surfacing key navigation links and a WhatsApp booking CTA. Google recommends soft 404 handling (do not redirect all 404s to homepage) — a proper not-found.tsx is the correct approach.\",\n      \"acceptanceCriteria\": [\n        \"app/not-found.tsx file exists and renders on any invalid URL\",\n        \"Page has a friendly on-brand message (e.g. 'Looks like this pod is taken!')\",\n        \"Page includes navigation links to: Home, Rooms, /book, /guide, /blog\",\n        \"Page includes a WhatsApp contact CTA\",\n        \"Header and Footer are present for consistent navigation\",\n        \"Page has proper HTTP 404 status (not 200) — Next.js App Router not-found.tsx sets this automatically\"\n      ],\n      \"technicalNotes\": [\n        \"Create site/src/app/not-found.tsx (not 404.tsx — App Router convention)\",\n        \"Import Header and Footer components\",\n        \"Use amber/stone design consistent with rest of site\",\n        \"No generateMetadata needed — Next.js sets noindex automatically for 404 pages\"\n      ],\n      \"dependencies\": [],\n      \"estimatedComplexity\": \"small\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"US-011\",\n      \"title\": \"Fix NAP inconsistency in StructuredData.tsx (wrong phone and address)\",\n      \"priority\": \"high\",\n      \"description\": \"StructuredData.tsx contains factually incorrect business data: phone is '+60123456789' (placeholder, not a real number) and street address is 'Jalan Maju, Taman Pelangi' (wrong — correct is '26A Jalan Perang'). NAP (Name, Address, Phone) must exactly match Google Business Profile for local search trust. These errors could suppress local ranking and confuse map integrations.\",\n      \"acceptanceCriteria\": [\n        \"telephone in Hostel schema is '+60127088789' (Jay's real number from business data)\",\n        \"streetAddress in Hostel schema is '26A Jalan Perang, Taman Pelangi'\",\n        \"Same NAP fixes applied to localBusinessSchema in same file\",\n        \"geo coordinates updated to 5 decimal precision (e.g. latitude: 1.48552, longitude: 103.75940)\",\n        \"checkinTime updated to '14:00' (business data shows 2:00 PM, not 15:00)\",\n        \"TypeScript compiles without errors after changes\"\n      ],\n      \"technicalNotes\": [\n        \"Edit site/src/components/StructuredData.tsx\",\n        \"Correct phone: +60127088789 (Jay) — from pelangi-website-plan.md\",\n        \"Correct address: 26A Jalan Perang, Taman Pelangi, 80400 Johor Bahru\",\n        \"Check-in from plan: 2:00 PM = 14:00 in ISO 8601; current file has 15:00\",\n        \"Validate via: https://search.google.com/test/rich-results after fix\"\n      ],\n      \"dependencies\": [],\n      \"estimatedComplexity\": \"small\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"US-012\",\n      \"title\": \"Add FAQPage JSON-LD schema to FAQ component\",\n      \"priority\": \"high\",\n      \"description\": \"The FAQ.tsx component renders a set of Q&A items on the homepage, but there is no FAQPage JSON-LD structured data. Adding the FAQPage schema can earn an expandable FAQ rich result in Google SERPs, increasing click-through rate. This is one of the highest-ROI structured data additions for a local business.\",\n      \"acceptanceCriteria\": [\n        \"Homepage (or FAQ component) renders a <script type='application/ld+json'> with @type: 'FAQPage'\",\n        \"Each FAQ item maps to a Question with name (question text) and acceptedAnswer.text\",\n        \"Schema validates without errors in Google Rich Results Test\",\n        \"Questions include high-value search queries: check-in time, WiFi, price, location, Singapore proximity\",\n        \"No TypeScript errors\"\n      ],\n      \"technicalNotes\": [\n        \"Edit site/src/components/FAQ.tsx or inject from site/src/app/page.tsx\",\n        \"Schema structure: { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: [ { '@type': 'Question', name: '...', acceptedAnswer: { '@type': 'Answer', text: '...' } } ] }\",\n        \"Keep answer text concise (1-3 sentences) to maximize SERP display\",\n        \"Validate at: https://search.google.com/test/rich-results\",\n        \"Reference: https://developers.google.com/search/docs/appearance/structured-data/faqpage\"\n      ],\n      \"dependencies\": [],\n      \"estimatedComplexity\": \"small\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"US-013\",\n      \"title\": \"Add dynamic OG images for blog posts using next/og ImageResponse\",\n      \"priority\": \"medium\",\n      \"description\": \"All blog posts currently share the same static /images/og-image.png when shared on social media. Next.js App Router supports per-route dynamic OG image generation via opengraph-image.tsx using the ImageResponse API. Adding per-post OG images with the article title, category badge, and branding significantly improves social sharing click-through from WhatsApp, Facebook, and Twitter.\",\n      \"acceptanceCriteria\": [\n        \"Each blog post URL generates a unique 1200x630 OG image when scraped by social crawlers\",\n        \"OG image shows: post title (large text), category badge, site name 'Pelangi Capsule Hostel', amber/stone brand colors\",\n        \"Validates correctly with Facebook Sharing Debugger and Twitter Card Validator\",\n        \"No TypeScript errors\",\n        \"Image generation does not exceed 500KB bundle limit\"\n      ],\n      \"technicalNotes\": [\n        \"Create site/src/app/blog/[slug]/opengraph-image.tsx\",\n        \"Use ImageResponse from 'next/og'\",\n        \"Export: export const size = { width: 1200, height: 630 } and export const contentType = 'image/png'\",\n        \"Only flexbox CSS supported in ImageResponse (no grid)\",\n        \"Font: use fetch() to load .ttf font or use system font fallback\",\n        \"Access post data via params.slug — import posts from data/blog/posts.ts\",\n        \"Reference: https://nextjs.org/docs/app/api-reference/file-conventions/opengraph-image\"\n      ],\n      \"dependencies\": [],\n      \"estimatedComplexity\": \"medium\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"US-014\",\n      \"title\": \"Add HotelRoom structured data with Offer pricing on /rooms page\",\n      \"priority\": \"medium\",\n      \"description\": \"The /rooms page describes capsule pod pricing but has no structured data. Google's hotel rich results support HotelRoom schema (typed as ['HotelRoom', 'Product']) with Offer/UnitPriceSpecification for pricing. Adding this can make pricing visible in Google Search and enable integration with Google Hotels panel. This is separate from the site-level Hostel schema already in StructuredData.tsx.\",\n      \"acceptanceCriteria\": [\n        \"/rooms page includes JSON-LD with @type: ['HotelRoom', 'Product'] for each pod type\",\n        \"Each room has: name, description, containedInPlace (linking to hostel schema), and offers (Offer with price, priceCurrency, businessFunction)\",\n        \"Nightly rate (RM35-45) and monthly rate (RM594) are both represented\",\n        \"Schema validates in Google Rich Results Test without errors\",\n        \"No TypeScript errors\"\n      ],\n      \"technicalNotes\": [\n        \"Edit site/src/app/rooms/page.tsx to inject JSON-LD script\",\n        \"Dual type: '@type': ['HotelRoom', 'Product'] — both required for pricing rich results\",\n        \"Offer structure: { '@type': 'Offer', 'price': '35', 'priceCurrency': 'MYR', 'businessFunction': 'http://purl.org/goodrelations/v1#LeaseOut' }\",\n        \"containedInPlace: { '@type': 'Hostel', 'name': 'Pelangi Capsule Hostel', 'url': 'https://pelangicapsulehostel.com' }\",\n        \"Reference: https://schema.org/HotelRoom and https://wordlift.io/blog/en/schema-markup-for-hotels-bb-and-resorts-a-complete-guide/\"\n      ],\n      \"dependencies\": [],\n      \"estimatedComplexity\": \"small\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"US-015\",\n      \"title\": \"Add Google Search Console verification meta tag to layout.tsx\",\n      \"priority\": \"medium\",\n      \"description\": \"layout.tsx has a TODO comment: '// TODO: Add your Google Search Console verification code'. Google Search Console is required to monitor indexing status, Core Web Vitals data, search performance, and submit sitemaps. Without verification, there is no visibility into whether Google is correctly crawling the site. This is a one-line configuration change.\",\n      \"acceptanceCriteria\": [\n        \"layout.tsx metadata includes a valid Google Search Console verification code\",\n        \"Google Search Console shows the property as 'verified'\",\n        \"The sitemap URL (https://pelangicapsulehostel.com/sitemap.xml) is submitted in GSC\",\n        \"No TypeScript errors\"\n      ],\n      \"technicalNotes\": [\n        \"Edit site/src/app/layout.tsx — find the verification: {} object\",\n        \"Add: verification: { google: 'YOUR_VERIFICATION_TOKEN' }\",\n        \"Get token from: Google Search Console > Add Property > HTML tag method\",\n        \"After deploy, verify ownership in GSC and submit sitemap.xml\",\n        \"Reference: https://nextjs.org/docs/app/api-reference/functions/generate-metadata#verification\"\n      ],\n      \"dependencies\": [],\n      \"estimatedComplexity\": \"small\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"US-016\",\n      \"title\": \"Add sticky mobile WhatsApp booking bar for conversion\",\n      \"priority\": \"medium\",\n      \"description\": \"WhatsApp has a 98% open rate and 45-60% conversion rate for hospitality. Mobile visitors (majority of hostel traffic) should always see a persistent 'Book via WhatsApp' CTA regardless of scroll position. A sticky bottom bar appearing on mobile-only (hidden on desktop where the chat widget serves this role) is a proven conversion pattern for small hostels. The pre-filled message reduces friction.\",\n      \"acceptanceCriteria\": [\n        \"A sticky bar appears at the bottom of all pages on mobile (hidden on md: and above)\",\n        \"Bar contains: WhatsApp icon, 'Book from RM35/night' text, and a green CTA button\",\n        \"Clicking opens wa.me/60127088789 with pre-filled booking message\",\n        \"Bar does not overlap the existing ChatWidget floating button (positioned to avoid conflict)\",\n        \"Bar is hidden when the ChatWidget is open\",\n        \"Accessible: has aria-label and sufficient color contrast\"\n      ],\n      \"technicalNotes\": [\n        \"Create site/src/components/MobileBookingBar.tsx\",\n        \"Add to site/src/app/layout.tsx (renders on all pages)\",\n        \"Use fixed bottom-0 left-0 right-0 z-40 (below ChatWidget's z-50)\",\n        \"Hidden on md+ screens: className='md:hidden'\",\n        \"Pre-filled URL: https://wa.me/60127088789?text=Hi!%20I'd%20like%20to%20book%20a%20pod%20at%20Pelangi%20Capsule%20Hostel.\",\n        \"Add padding-bottom to <body> or main sections to prevent bar from covering content\"\n      ],\n      \"dependencies\": [],\n      \"estimatedComplexity\": \"small\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"US-017\",\n      \"title\": \"Add canonical URL tags to all inner pages via generateMetadata\",\n      \"priority\": \"medium\",\n      \"description\": \"Currently only the homepage has an explicit canonical URL in metadata. Inner pages (/about, /rooms, /gallery, /contact, /check-in, /guide, /book) rely on Next.js auto-generation, which may not produce the exact preferred URL format. Explicit canonical tags on each page prevent duplicate content issues and confirm the preferred URL to Google — especially important now that blog posts exist with similar content themes.\",\n      \"acceptanceCriteria\": [\n        \"Each inner page (/about, /rooms, /gallery, /contact, /check-in, /guide, /book) has generateMetadata with alternates.canonical set to the full absolute URL\",\n        \"/blog page and /blog/[slug] pages already have canonical set (verify existing implementation)\",\n        \"Canonical URLs use https://pelangicapsulehostel.com as base (no trailing slash inconsistency)\",\n        \"TypeScript compiles without errors\"\n      ],\n      \"technicalNotes\": [\n        \"Edit each page.tsx to add export async function generateMetadata()\",\n        \"Pattern: alternates: { canonical: 'https://pelangicapsulehostel.com/PAGE_PATH' }\",\n        \"Pages to update: /about, /rooms, /gallery, /contact, /check-in, /guide\",\n        \"Verify blog pages already have this from US-005 implementation\",\n        \"Reference: https://nextjs.org/docs/app/api-reference/functions/generate-metadata#alternates\"\n      ],\n      \"dependencies\": [],\n      \"estimatedComplexity\": \"small\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"US-018\",\n      \"title\": \"Add Core Web Vitals optimization: hero image priority and lazy-loading\",\n      \"priority\": \"medium\",\n      \"description\": \"The Hero component (Hero.tsx) likely uses a large banner image that is the Largest Contentful Paint (LCP) element. Without the `priority` prop on the Next.js Image component, the hero image is lazy-loaded, causing LCP scores above 4s on mobile — a Google ranking signal. Additionally, below-fold images should be explicitly lazy-loaded and sized with the `sizes` attribute to prevent Cumulative Layout Shift (CLS). Target: LCP < 2.5s, CLS < 0.1.\",\n      \"acceptanceCriteria\": [\n        \"Hero image uses <Image priority> prop (no lazy loading on LCP element)\",\n        \"Hero image has explicit width, height, and sizes attribute set\",\n        \"All gallery images and below-fold images use loading='lazy' or default lazy behavior\",\n        \"No images use width/height that cause layout shift (CLS < 0.1)\",\n        \"PageSpeed Insights mobile score improves (document current score before, target 70+)\"\n      ],\n      \"technicalNotes\": [\n        \"Read site/src/components/Hero.tsx first to check current Image usage\",\n        \"Add priority prop to the hero <Image> component\",\n        \"Add sizes='(max-width: 768px) 100vw, 1920px' to hero image\",\n        \"Check Gallery.tsx for images without explicit dimensions\",\n        \"Reference: https://nextjs.org/docs/pages/api-reference/components/image#priority\",\n        \"Test with: https://pagespeed.web.dev/ (mobile tab)\"\n      ],\n      \"dependencies\": [],\n      \"estimatedComplexity\": \"small\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"US-019\",\n      \"title\": \"Add web app manifest (manifest.json) for mobile installability\",\n      \"priority\": \"low\",\n      \"description\": \"Next.js 15 App Router supports manifest.ts for generating a PWA web app manifest. A manifest enables 'Add to Home Screen' prompts on iOS/Android, giving repeat visitors (e.g. long-stay guests checking house rules, WiFi password, check-in guide) a native-app-like experience. This is particularly valuable for the /check-in page which guests may reference repeatedly during their stay.\",\n      \"acceptanceCriteria\": [\n        \"GET /manifest.json returns a valid Web App Manifest JSON\",\n        \"Manifest includes: name, short_name, start_url, display, background_color, theme_color, icons\",\n        \"At minimum two icon sizes: 192x192 and 512x512 (PNG format)\",\n        \"theme_color matches the amber brand (#a68b64 or similar)\",\n        \"Browser shows 'Add to Home Screen' prompt on eligible Android devices\"\n      ],\n      \"technicalNotes\": [\n        \"Create site/src/app/manifest.ts (Next.js App Router convention)\",\n        \"Export default function manifest(): MetadataRoute.Manifest\",\n        \"Icons: create /public/icons/icon-192.png and /public/icons/icon-512.png\",\n        \"start_url: '/', display: 'standalone'\",\n        \"Reference: https://nextjs.org/docs/app/api-reference/file-conventions/metadata/manifest\"\n      ],\n      \"dependencies\": [],\n      \"estimatedComplexity\": \"small\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"US-020\",\n      \"title\": \"Add hreflang tags for EN/ZH-CN multilingual SEO groundwork\",\n      \"priority\": \"low\",\n      \"description\": \"Pelangi Capsule Hostel's primary market includes Singapore and Malaysian Chinese-speaking travelers. The website content doc explicitly calls for EN/ZH support. Even before a full Chinese translation is available, adding hreflang infrastructure (x-default + en) in generateMetadata prevents future SEO migration pain. A Chinese landing page at /zh targeting Singapore Chinese travelers is a second phase. Hreflang is bidirectional — each language version must reference all others.\",\n      \"acceptanceCriteria\": [\n        \"layout.tsx metadata includes alternates.languages with at minimum 'en' and 'x-default' pointing to canonical URL\",\n        \"Code is structured to easily add 'zh-CN': 'https://pelangicapsulehostel.com/zh' when Chinese content is ready\",\n        \"HTML lang attribute in layout.tsx is 'en' (currently correct — verify it stays 'en' not 'en-MY')\",\n        \"No TypeScript errors\"\n      ],\n      \"technicalNotes\": [\n        \"Edit site/src/app/layout.tsx metadata.alternates\",\n        \"Add: languages: { 'en': 'https://pelangicapsulehostel.com', 'x-default': 'https://pelangicapsulehostel.com' }\",\n        \"When /zh exists, add: 'zh-CN': 'https://pelangicapsulehostel.com/zh'\",\n        \"Reference: https://developers.google.com/search/docs/specialty/international/localized-versions\",\n        \"Use i18n: subdirectory approach (/zh/) not query params (?lang=zh)\"\n      ],\n      \"dependencies\": [],\n      \"estimatedComplexity\": \"small\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"US-021\",\n      \"title\": \"Add Instagram social link to Footer and fix social media URLs\",\n      \"priority\": \"low\",\n      \"description\": \"The Footer currently has Facebook and WhatsApp links, but Instagram is missing despite being a key discovery channel for budget traveler audiences. The Facebook URL (pelangicapsulehostel) and Google Business URL (g.page/pelangicapsulehostel) are placeholder-style and may not resolve to real profiles. Confirm all social URLs are live and add Instagram.\",\n      \"acceptanceCriteria\": [\n        \"Footer has an Instagram icon linking to the hostel's real Instagram profile\",\n        \"Facebook URL is verified as a live page (not a 404)\",\n        \"Google Business URL resolves to the real Google Maps listing\",\n        \"All social links open in new tab with rel='noopener noreferrer'\",\n        \"Consistent icon styling with existing social icons in Footer.tsx\"\n      ],\n      \"technicalNotes\": [","numLines":500,"startLine":1,"totalLines":5662}}}
