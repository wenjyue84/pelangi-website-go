", name: \"Premium Mattress\", value: true },\n83\t            { \"@type\": \"LocationFeatureSpecification\", name: \"Personal Locker\", value: true },\n84\t            { \"@type\": \"LocationFeatureSpecification\", name: \"Free WiFi\", value: true },\n85\t        ],\n86\t        offers: [\n87\t            {\n88\t                \"@type\": \"Offer\",\n89\t                price: \"37.80\",\n90\t                priceCurrency: \"MYR\",\n91\t                availability: \"https://schema.org/InStock\",\n92\t                seller,\n93\t                priceValidUntil,\n94\t                businessFunction: \"http://purl.org/goodrelations/v1#LeaseOut\",\n95\t                description: \"Nightly rate inclusive of SST 8%\",\n96\t                unitCode: \"DAY\",\n97\t                priceSpecification: {\n98\t                    \"@type\": \"UnitPriceSpecification\",\n99\t                    price: \"37.80\",\n100\t                    priceCurrency: \"MYR\",\n101\t                    unitText: \"night\",\n102\t                    referenceQuantity: {\n103\t                        \"@type\": \"QuantitativeValue\",\n104\t                        value: 1,\n105\t                        unitCode: \"DAY\",\n106\t                    },\n107\t                },\n108\t            },\n109\t            {\n110\t                \"@type\": \"Offer\",\n111\t                price: \"641.52\",\n112\t                priceCurrency: \"MYR\",\n113\t                availability: \"https://schema.org/InStock\",\n114\t                seller,\n115\t                priceValidUntil,\n116\t                businessFunction: \"http://purl.org/goodrelations/v1#LeaseOut\",\n117\t                description: \"Monthly rate inclusive of SST 8%\",\n118\t                unitCode: \"MON\",\n119\t                priceSpecification: {\n120\t                    \"@type\": \"UnitPriceSpecification\",\n121\t                    price: \"641.52\",\n122\t                    priceCurrency: \"MYR\",\n123\t                    unitText: \"month\",\n124\t                    referenceQuantity: {\n125\t                        \"@type\": \"QuantitativeValue\",\n126\t                        value: 1,\n127\t                        unitCode: \"MON\",\n128\t                    },\n129\t                },\n130\t            },\n131\t        ],\n132\t    },\n133\t    {\n134\t        \"@context\": \"https://schema.org\",\n135\t        \"@type\": [\"HotelRoom\", \"Product\"],\n136\t        name: \"Premium Capsule Pod\",\n137\t        description:\n138\t            \"Premium private capsule pod with enhanced comfort features, personal climate control, adjustable LED lighting, USB and power outlets, privacy sliding door, premium mattress, and personal locker. Free high-speed WiFi included.\",\n139\t        url: \"https://pelangicapsulehostel.com/rooms\",\n140\t        image: \"https://pelangicapsulehostel.com/images/capsule-2.webp\",\n141\t        containedInPlace,\n142\t        checkinTime: \"T14:00:00\",\n143\t        checkoutTime: \"T12:00:00\",\n144\t        occupancy: {\n145\t            \"@type\": \"QuantitativeValue\",\n146\t            minValue: 1,\n147\t            maxValue: 1,\n148\t            unitText: \"persons\",\n149\t        },\n150\t        amenityFeature: [\n151\t            { \"@type\": \"LocationFeatureSpecification\", name: \"Personal Climate Control\", value: true },\n152\t            { \"@type\": \"LocationFeatureSpecification\", name: \"Adjustable LED Lighting\", value: true },\n153\t            { \"@type\": \"LocationFeatureSpecification\", name: \"USB & Power Outlets\", value: true },\n154\t            { \"@type\": \"LocationFeatureSpecification\", name: \"Privacy Sliding Door\", value: true },\n155\t            { \"@type\": \"LocationFeatureSpecification\", name: \"Premium Mattress\", value: true },\n156\t            { \"@type\": \"LocationFeatureSpecification\", name: \"Personal Locker\", value: true },\n157\t            { \"@type\": \"LocationFeatureSpecification\", name: \"Free WiFi\", value: true },\n158\t        ],\n159\t        offers: [\n160\t            {\n161\t                \"@type\": \"Offer\",\n162\t                price: \"48.60\",\n163\t                priceCurrency: \"MYR\",\n164\t                availability: \"https://schema.org/InStock\",\n165\t                seller,\n166\t                priceValidUntil,\n167\t                businessFunction: \"http://purl.org/goodrelations/v1#LeaseOut\",\n168\t                description: \"Nightly rate inclusive of SST 8%\",\n169\t                unitCode: \"DAY\",\n170\t                priceSpecification: {\n171\t                    \"@type\": \"UnitPriceSpecification\",\n172\t                    price: \"48.60\",\n173\t                    priceCurrency: \"MYR\",\n174\t                    unitText: \"night\",\n175\t                    referenceQuantity: {\n176\t                        \"@type\": \"QuantitativeValue\",\n177\t                        value: 1,\n178\t                        unitCode: \"DAY\",\n179\t                    },\n180\t                },\n181\t            },\n182\t        ],\n183\t    },\n184\t];\n185\t\n186\texport default async function RoomsPage() {\n187\t    return (\n188\t        <main id=\"main-content\" className=\"min-h-screen bg-stone-50 dark:bg-stone-950\">\n189\t            {hotelRoomsSchema.map((schema, i) => (\n190\t                <script\n191\t                    key={i}\n192\t                    type=\"application/ld+json\"\n193\t                    dangerouslySetInnerHTML={{ __html: JSON.stringify(schema) }}\n194\t                />\n195\t            ))}\n196\t            <Header />\n197\t            <div className=\"pt-20\">\n198\t                <Suspense fallback={<RoomCardSkeleton />}>\n199\t                    <Rooms />\n200\t                </Suspense>\n201\t\n202\t                <PhotoGallery />\n203\t\n204\t                {/* AI Overviews: concise factual paragraph for pod price and feature queries */}\n205\t                <section className=\"py-16 bg-stone-50 dark:bg-stone-950\">\n206\t                    <div className=\"container-custom max-w-3xl\">\n207\t                        <div className=\"flex items-center justify-between gap-4 mb-6 flex-wrap\">\n208\t                            <h2 className=\"font-display text-3xl font-medium text-stone-900 dark:text-stone-100\">\n209\t                                Capsule Pod Pricing &amp; Features\n210\t                            </h2>\n211\t                            <ShareButton\n212\t                                title=\"Capsule Pod Rooms | Pelangi Capsule Hostel JB\"\n213\t                                text=\"Private capsule pods from RM35/night in Taman Pelangi, Johor Bahru.\"\n214\t                                url=\"https://pelangicapsulehostel.com/rooms\"\n215\t                            />\n216\t                        </div>\n217\t                        <div className=\"text-lg text-stone-700 dark:text-stone-300 leading-relaxed space-y-4\">\n218\t                            <p>\n219\t                                Pelangi Capsule Hostel offers two pod types in Taman Pelangi, Johor Bahru. Standard Capsule Pods start from RM35 per night and Premium Capsule Pods from RM45 per night. Monthly long-stay rates begin at RM594 per month. All rates are subject to Malaysia Service Tax (SST) at 8% and Tourism Tax (TTx) of RM10 per room per night for non-Malaysian guests as mandated by the Royal Malaysian Customs Department. Tax rates are subject to change per Malaysian government regulation.\n220\t                            </p>\n221\t                            <p>\n222\t                                Every pod includes a lockable sliding privacy door, personal climate control (fan and air-conditioning), adjustable LED lighting, USB and power outlets, a premium mattress, and a personal locker. Shared facilities include free high-speed WiFi, hot showers, a fully equipped kitchen, a water dispenser, laundry facilities, and luggage storage. The hostel operates 24/7 with self-check-in access and CCTV security throughout the property.\n223\t                            </p>\n224\t                        </div>\n225\t                    </div>\n226\t                </section>\n227\t\n228\t                <Facilities />\n229\t            </div>\n230\t            <Footer />\n231\t            <RoomsEcommerceTracker />\n232\t        </main>\n233\t    );\n234\t}\n235\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"6b67213d-2eef-4ac1-bb69-724ff9b6a3c0","uuid":"b2e8a1df-77f4-41fc-ac0e-63691034825d","timestamp":"2026-04-14T01:54:12.710Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\app\\rooms\\page.tsx","content":"import { Suspense } from \"react\";\nimport type { Metadata } from \"next\";\nimport Header from \"@/components/Header\";\nimport Footer from \"@/components/Footer\";\nimport Rooms from \"@/components/Rooms\";\nimport RoomCardSkeleton from \"@/components/RoomCardSkeleton\";\nimport Facilities from \"@/components/Facilities\";\nimport RoomsEcommerceTracker from \"@/components/RoomsEcommerceTracker\";\nimport PhotoGallery from \"@/components/PhotoGallery\";\nimport ShareButton from \"@/components/ShareButton\";\nexport const metadata: Metadata = {\n    title: \"Capsule Pod Rooms | Pelangi Capsule Hostel JB\",\n    description:\n        \"Private capsule pods from RM35/night in Taman Pelangi, Johor Bahru. Personal climate control, USB charging, LED lighting, and personal locker included.\",\n    alternates: {\n        canonical: \"https://pelangicapsulehostel.