{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01BmbLZn4hLPodKyLKfv7sdS","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01MwtpxdmwayPeu5dVzz5srW","name":"Edit","input":{"replace_all":false,"file_path":"C:/Users/Jyue/Documents/1-projects/Software Projects/pelangi-website/site/src/app/api/ari/route.ts","old_string":"import { NextResponse } from \"next/server\";\nimport type { NextRequest } from \"next/server\";\nimport { ROOM_TYPES, PROPERTY } from \"@/data/rooms\";\nimport { beds24Client } from \"@/lib/beds24-client\";","new_string":"import { NextResponse } from \"next/server\";\nimport type { NextRequest } from \"next/server\";\nimport { ROOM_TYPES, PROPERTY } from \"@/data/rooms\";\nimport { getCachedAvailability } from \"@/lib/cached-availability\";"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":1953,"cache_read_input_tokens":84110,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1953},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"747c8b95-3597-4de2-850f-60587c80eb91","uuid":"26a40f39-3c57-4309-8fdb-a26bde35e1bc"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MwtpxdmwayPeu5dVzz5srW","type":"tool_result","content":"The file C:/Users/Jyue/Documents/1-projects/Software Projects/pelangi-website/site/src/app/api/ari/route.ts has been updated successfully."}]},"parent_tool_use_id":null,"session_id":"747c8b95-3597-4de2-850f-60587c80eb91","uuid":"befdbb3a-8733-4dc7-962d-97888df0a8c7","timestamp":"2026-04-14T01:55:20.528Z","tool_use_result":{"filePath":"C:/Users/Jyue/Documents/1-projects/Software Projects/pelangi-website/site/src/app/api/ari/route.ts","oldString":"import { NextResponse } from \"next/server\";\nimport type { NextRequest } from \"next/server\";\nimport { ROOM_TYPES, PROPERTY } from \"@/data/rooms\";\nimport { beds24Client } from \"@/lib/beds24-client\";","newString":"import { NextResponse } from \"next/server\";\nimport type { NextRequest } from \"next/server\";\nimport { ROOM_TYPES, PROPERTY } from \"@/data/rooms\";\nimport { getCachedAvailability } from \"@/lib/cached-availability\";","originalFile":"import { NextResponse } from \"next/server\";\nimport type { NextRequest } from \"next/server\";\nimport { ROOM_TYPES, PROPERTY } from \"@/data/rooms\";\nimport { beds24Client } from \"@/lib/beds24-client\";\n\n/**\n * ARI (Availability, Rates, Inventory) endpoint for connectivity partners.\n *\n * Google Free Booking Links require a connectivity partner (e.g., Beds24,\n * Cloudbeds, RoomRaccoon) to pull live rates and availability. This endpoint\n * exposes the hostel's ARI data in a standard JSON format that partners can\n * consume via their pull-based integration.\n *\n * Pulls real-time data from the configured channel manager (Beds24).\n * Falls back to local room data if channel manager is not configured.\n *\n * Query params:\n *   - checkin  (YYYY-MM-DD, required)\n *   - checkout (YYYY-MM-DD, required)\n *   - currency (default: MYR)\n *\n * Authentication: API key via x-api-key header (set ARI_API_KEY env var).\n */\nexport async function GET(request: NextRequest) {\n  const apiKey = process.env.ARI_API_KEY;\n  if (apiKey) {\n    const provided = request.headers.get(\"x-api-key\");\n    if (provided !== apiKey) {\n      return NextResponse.json(\n        { error: \"Unauthorized\" },\n        { status: 401 },\n      );\n    }\n  }\n\n  const params = request.nextUrl.searchParams;\n  const checkin = params.get(\"checkin\");\n  const checkout = params.get(\"checkout\");\n  const currency = params.get(\"currency\") || \"MYR\";\n\n  if (!checkin || !checkout) {\n    return NextResponse.json(\n      { error: \"checkin and checkout query parameters are required (YYYY-MM-DD)\" },\n      { status: 400 },\n    );\n  }\n\n  const checkinDate = new Date(checkin);\n  const checkoutDate = new Date(checkout);\n\n  if (isNaN(checkinDate.getTime()) || isNaN(checkoutDate.getTime())) {\n    return NextResponse.json(\n      { error: \"Invalid date format. Use YYYY-MM-DD.\" },\n      { status: 400 },\n    );\n  }\n\n  if (checkoutDate <= checkinDate) {\n    return NextResponse.json(\n      { error: \"checkout must be after checkin\" },\n      { status: 400 },\n    );\n  }\n\n  const nights = Math.ceil(\n    (checkoutDate.getTime() - checkinDate.getTime()) / (1000 * 60 * 60 * 24),\n  );\n\n  // Fetch live availability from channel manager\n  const channelAvailability = await beds24Client.getAvailability(checkin, checkout);\n\n  // Map to ARI response format\n  const rooms = ROOM_TYPES.map((room) => {\n    const channelRoom = channelAvailability.find((r) => r.roomId === room.id);\n    const availableUnits = channelRoom?.available ?? room.totalUnits;\n    const totalInventory = channelRoom?.total ?? room.totalUnits;\n\n    return {\n      room_id: room.id,\n      room_name: room.name,\n      description: room.description,\n      max_occupancy: room.maxOccupancy,\n      total_inventory: totalInventory,\n      available_units: Math.max(0, availableUnits),\n      rate: {\n        nightly: room.nightlyRate,\n        total: room.nightlyRate * nights,\n        currency,\n      },\n      amenities: room.amenities,\n    };\n  });\n\n  const response = {\n    property_id: PROPERTY.id,\n    property_name: PROPERTY.name,\n    checkin,\n    checkout,\n    nights,\n    currency,\n    timezone: PROPERTY.timezone,\n    checkin_time: PROPERTY.checkinTime,\n    checkout_time: PROPERTY.checkoutTime,\n    rooms,\n    booking_url: `https://pelangicapsulehostel.com/book?checkin=${checkin}&checkout=${checkout}`,\n    updated_at: new Date().toISOString(),\n  };\n\n  return NextResponse.json(response, {\n    headers: {\n      \"Cache-Control\": \"public, max-age=300, s-maxage=300\",\n    },\n  });\n}\n","structuredPatch":[{"oldStart":1,"oldLines":7,"newStart":1,"newLines":7,"lines":[" import { NextResponse } from \"next/server\";"," import type { NextRequest } from \"next/server\";"," import { ROOM_TYPES, PROPERTY } from \"@/data/rooms\";","-import { beds24Client } from \"@/lib/beds24-client\";","+import { getCachedAvailability } from \"@/lib/cached-availability\";"," "," /**","  * ARI (Availability, Rates, Inventory) endpoint for connectivity partners."]}],"userModified":false,"replaceAll":false}}
