{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QGwjHP5qp1gdLVXgVub5TZ","type":"tool_result","content":"The file C:/Users/Jyue/Documents/1-projects/Software Projects/pelangi-website/site/src/app/api/ari/route.ts has been updated successfully."}]},"parent_tool_use_id":null,"session_id":"747c8b95-3597-4de2-850f-60587c80eb91","uuid":"f1fc4413-73d7-4cd1-a3c4-c8aeb6ca8168","timestamp":"2026-04-14T01:55:24.820Z","tool_use_result":{"filePath":"C:/Users/Jyue/Documents/1-projects/Software Projects/pelangi-website/site/src/app/api/ari/route.ts","oldString":"  // Fetch live availability from channel manager\n  const channelAvailability = await beds24Client.getAvailability(checkin, checkout);","newString":"  // Fetch live availability from channel manager (with cache() + cacheSignal() for cleanup)\n  const channelAvailability = await getCachedAvailability(checkin, checkout);","originalFile":"import { NextResponse } from \"next/server\";\nimport type { NextRequest } from \"next/server\";\nimport { ROOM_TYPES, PROPERTY } from \"@/data/rooms\";\nimport { getCachedAvailability } from \"@/lib/cached-availability\";\n\n/**\n * ARI (Availability, Rates, Inventory) endpoint for connectivity partners.\n *\n * Google Free Booking Links require a connectivity partner (e.g., Beds24,\n * Cloudbeds, RoomRaccoon) to pull live rates and availability. This endpoint\n * exposes the hostel's ARI data in a standard JSON format that partners can\n * consume via their pull-based integration.\n *\n * Pulls real-time data from the configured channel manager (Beds24).\n * Falls back to local room data if channel manager is not configured.\n *\n * Query params:\n *   - checkin  (YYYY-MM-DD, required)\n *   - checkout (YYYY-MM-DD, required)\n *   - currency (default: MYR)\n *\n * Authentication: API key via x-api-key header (set ARI_API_KEY env var).\n */\nexport async function GET(request: NextRequest) {\n  const apiKey = process.env.ARI_API_KEY;\n  if (apiKey) {\n    const provided = request.headers.get(\"x-api-key\");\n    if (provided !== apiKey) {\n      return NextResponse.json(\n        { error: \"Unauthorized\" },\n        { status: 401 },\n      );\n    }\n  }\n\n  const params = request.nextUrl.searchParams;\n  const checkin = params.get(\"checkin\");\n  const checkout = params.get(\"checkout\");\n  const currency = params.get(\"currency\") || \"MYR\";\n\n  if (!checkin || !checkout) {\n    return NextResponse.json(\n      { error: \"checkin and checkout query parameters are required (YYYY-MM-DD)\" },\n      { status: 400 },\n    );\n  }\n\n  const checkinDate = new Date(checkin);\n  const checkoutDate = new Date(checkout);\n\n  if (isNaN(checkinDate.getTime()) || isNaN(checkoutDate.getTime())) {\n    return NextResponse.json(\n      { error: \"Invalid date format. Use YYYY-MM-DD.\" },\n      { status: 400 },\n    );\n  }\n\n  if (checkoutDate <= checkinDate) {\n    return NextResponse.json(\n      { error: \"checkout must be after checkin\" },\n      { status: 400 },\n    );\n  }\n\n  const nights = Math.ceil(\n    (checkoutDate.getTime() - checkinDate.getTime()) / (1000 * 60 * 60 * 24),\n  );\n\n  // Fetch live availability from channel manager\n  const channelAvailability = await beds24Client.getAvailability(checkin, checkout);\n\n  // Map to ARI response format\n  const rooms = ROOM_TYPES.map((room) => {\n    const channelRoom = channelAvailability.find((r) => r.roomId === room.id);\n    const availableUnits = channelRoom?.available ?? room.totalUnits;\n    const totalInventory = channelRoom?.total ?? room.totalUnits;\n\n    return {\n      room_id: room.id,\n      room_name: room.name,\n      description: room.description,\n      max_occupancy: room.maxOccupancy,\n      total_inventory: totalInventory,\n      available_units: Math.max(0, availableUnits),\n      rate: {\n        nightly: room.nightlyRate,\n        total: room.nightlyRate * nights,\n        currency,\n      },\n      amenities: room.amenities,\n    };\n  });\n\n  const response = {\n    property_id: PROPERTY.id,\n    property_name: PROPERTY.name,\n    checkin,\n    checkout,\n    nights,\n    currency,\n    timezone: PROPERTY.timezone,\n    checkin_time: PROPERTY.checkinTime,\n    checkout_time: PROPERTY.checkoutTime,\n    rooms,\n    booking_url: `https://pelangicapsulehostel.com/book?checkin=${checkin}&checkout=${checkout}`,\n    updated_at: new Date().toISOString(),\n  };\n\n  return NextResponse.json(response, {\n    headers: {\n      \"Cache-Control\": \"public, max-age=300, s-maxage=300\",\n    },\n  });\n}\n","structuredPatch":[{"oldStart":66,"oldLines":8,"newStart":66,"newLines":8,"lines":["     (checkoutDate.getTime() - checkinDate.getTime()) / (1000 * 60 * 60 * 24),","   );"," ","-  // Fetch live availability from channel manager","-  const channelAvailability = await beds24Client.getAvailability(checkin, checkout);","+  // Fetch live availability from channel manager (with cache() + cacheSignal() for cleanup)","+  const channelAvailability = await getCachedAvailability(checkin, checkout);"," ","   // Map to ARI response format","   const rooms = ROOM_TYPES.map((room) => {"]}],"userModified":false,"replaceAll":false}}
