-sand-500: #78716c;\n55\t  --color-sand-600: #57534e;\n56\t  --color-sand-700: #44403c;\n57\t  --color-sand-800: #292524;\n58\t  --color-sand-900: #1c1917;\n59\t\n60\t  --font-sans: var(--font-inter), system-ui, sans-serif;\n61\t  --font-display: var(--font-playfair), Georgia, serif;\n62\t\n63\t  --text-2xs: 0.65rem;\n64\t  --text-2xs--line-height: 1rem;\n65\t\n66\t  --tracking-widest: 0.2em;\n67\t\n68\t  --animate-fade-in: fadeIn 0.6s ease-out forwards;\n69\t  --animate-slide-up: slideUp 0.6s ease-out forwards;\n70\t  --animate-scale-in: scaleIn 0.4s ease-out forwards;\n71\t\n72\t  --background-image-gradient-radial: radial-gradient(var(--tw-gradient-stops));\n73\t  --background-image-noise: url('/images/noise.png');\n74\t\n75\t  @keyframes fadeIn {\n76\t    0% {\n77\t      opacity: 0;\n78\t    }\n79\t    100% {\n80\t      opacity: 1;\n81\t    }\n82\t  }\n83\t  @keyframes slideUp {\n84\t    0% {\n85\t      opacity: 0;\n86\t      transform: translateY(20px);\n87\t    }\n88\t    100% {\n89\t      opacity: 1;\n90\t      transform: translateY(0);\n91\t    }\n92\t  }\n93\t  @keyframes scaleIn {\n94\t    0% {\n95\t      opacity: 0;\n96\t      transform: scale(0.95);\n97\t    }\n98\t    100% {\n99\t      opacity: 1;\n100\t      transform: scale(1);\n101\t    }\n102\t  }\n103\t}\n104\t\n105\t/*\n106\t  The default border color has changed to `currentcolor` in Tailwind CSS v4,\n107\t  so we've added these compatibility styles to make sure everything still\n108\t  looks the same as it did with Tailwind CSS v3.\n109\t\n110\t  If we ever want to remove these styles, we need to add an explicit border\n111\t  color utility to any element that depends on these defaults.\n112\t*/\n113\t@layer base {\n114\t  *,\n115\t  ::after,\n116\t  ::before,\n117\t  ::backdrop,\n118\t  ::file-selector-button {\n119\t    border-color: var(--color-gray-200, currentcolor);\n120\t  }\n121\t}\n122\t\n123\t@utility btn-primary {\n124\t  /* Primary Button - Warm, sophisticated */\n125\t  @apply bg-stone-700 hover:bg-stone-800 text-white font-medium\n126\t           py-3.5 px-8 rounded-full transition-all duration-300\n127\t           shadow-xs hover:shadow-md cursor-pointer\n128\t           tracking-wide text-sm uppercase\n129\t           focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700\n130\t           dark:bg-stone-200 dark:text-stone-900 dark:hover:bg-stone-100\n131\t           dark:focus-visible:outline-amber-400;\n132\t}\n133\t\n134\t@utility btn-secondary {\n135\t  /* Secondary Button - Minimal outline */\n136\t  @apply bg-transparent hover:bg-stone-100 text-stone-700\n137\t           font-medium py-3.5 px-8 rounded-full\n138\t           border border-stone-500 hover:border-stone-600\n139\t           transition-all duration-300 cursor-pointer\n140\t           tracking-wide text-sm uppercase\n141\t           focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700\n142\t           dark:text-stone-300 dark:border-stone-600 dark:hover:bg-stone-800 dark:hover:border-stone-500\n143\t           dark:focus-visible:outline-amber-400;\n144\t}\n145\t\n146\t@utility section-padding {\n147\t  /* Section spacing - More breathing room */\n148\t  @apply py-20 md:py-28 lg:py-32 px-6 md:px-8;\n149\t}\n150\t\n151\t/* ============================================================\n152\t   CSS Native Scroll-Driven Carousel (US-187)\n153\t   Chrome 135+ ships ::scroll-button() and ::scroll-marker\n154\t   pseudo-elements for automatic ARIA button roles and\n155\t   keyboard handling. Fallback: scrollBy() JS continues to work.\n156\t   ============================================================ */\n157\t@supports (selector(::scroll-button(*))) {\n158\t  .carousel-scroll-container {\n159\t    scroll-snap-type: x mandatory;\n160\t    scroll-behavior: smooth;\n161\t    overflow-x: auto;\n162\t  }\n163\t\n164\t  .carousel-scroll-container > * {\n165\t    scroll-snap-align: start;\n166\t    scroll-snap-stop: always;\n167\t  }\n168\t\n169\t  /* Automatic scroll prev/next buttons with ARIA roles */\n170\t  .carousel-scroll-container::scroll-button(prev) {\n171\t    @apply w-11 h-11 rounded-full bg-white dark:bg-stone-800 shadow-md\n172\t           flex items-center justify-center\n173\t           hover:bg-stone-50 dark:hover:bg-stone-700\n174\t           transition-colors cursor-pointer;\n175\t    position: absolute;\n176\t    left: 0;\n177\t    top: 50%;\n178\t    transform: translateY(-50%);\n179\t    z-index: 20;\n180\t  }\n181\t\n182\t  .carousel-scroll-container::scroll-button(next) {\n183\t    @apply w-11 h-11 rounded-full bg-white dark:bg-stone-800 shadow-md\n184\t           flex items-center justify-center\n185\t           hover:bg-stone-50 dark:hover:bg-stone-700\n186\t           transition-colors cursor-pointer;\n187\t    position: absolute;\n188\t    right: 0;\n189\t    top: 50%;\n190\t    transform: translateY(-50%);\n191\t    z-index: 20;\n192\t  }\n193\t\n194\t  /* Scroll marker group for keyboard-accessible navigation dots */\n195\t  .carousel-scroll-container::scroll-marker {\n196\t    display: flex;\n197\t    gap: 0.5rem;\n198\t    justify-content: center;\n199\t    margin-top: 1rem;\n200\t    flex-wrap: wrap;\n201\t  }\n202\t\n203\t  .carousel-scroll-container::scroll-marker-item {\n204\t    @apply w-2 h-2 rounded-full bg-stone-300 dark:bg-stone-600\n205\t           cursor-pointer transition-colors;\n206\t  }\n207\t\n208\t  .carousel-scroll-container::scroll-marker-item[aria-current=\"true\"] {\n209\t    @apply bg-amber-600 dark:bg-amber-400;\n210\t  }\n211\t}\n212\t\n213\t/* Fallback: older browsers degrade to basic scrollable container */\n214\t@supports not (selector(::scroll-button(*))) {\n215\t  .carousel-scroll-container {\n216\t    scroll-snap-type: x mandatory;\n217\t    overflow-x: auto;\n218\t    scrollbar-width: none;\n219\t    -ms-overflow-style: none;\n220\t  }\n221\t\n222\t  .carousel-scroll-container::-webkit-scrollbar {\n223\t    display: none;\n224\t  }\n225\t\n226\t  .carousel-scroll-container > * {\n227\t    scroll-snap-align: start;\n228\t    scroll-snap-stop: always;\n229\t  }\n230\t}\n231\t\n232\t@utility container-custom {\n233\t  /* Container */\n234\t  @apply max-w-6xl mx-auto;\n235\t}\n236\t\n237\t@utility section-label {\n238\t  /* Section label - Elegant uppercase */\n239\t  @apply text-xs font-medium tracking-widest uppercase text-amber-700 mb-4 dark:text-amber-400;\n240\t}\n241\t\n242\t@utility section-heading {\n243\t  /* Section heading - Serif display font (uses theme --font-display for next/font metric-adjusted fallback) */\n244\t  @apply text-3xl md:text-4xl lg:text-5xl font-medium text-stone-900\n245\t           leading-tight tracking-tight dark:text-stone-100;\n246\t  font-family: var(--font-display);\n247\t}\n248\t\n249\t@utility body-text {\n250\t  /* Body text */\n251\t  @apply text-stone-600 leading-relaxed dark:text-stone-400;\n252\t}\n253\t\n254\t@utility card {\n255\t  /* Card with subtle hover */\n256\t  @apply bg-white rounded-2xl p-6 md:p-8\n257\t           shadow-xs hover:shadow-md transition-shadow duration-300\n258\t           border border-stone-100\n259\t           dark:bg-stone-800 dark:border-stone-700;\n260\t}\n261\t\n262\t@utility image-frame {\n263\t  /* Image container with elegant corners */\n264\t  @apply rounded-2xl overflow-hidden shadow-lg;\n265\t}\n266\t\n267\t@utility divider {\n268\t  /* Divider — uses @property --divider-progress for animatable gradient midpoint */\n269\t  height: 1px;\n270\t  background: linear-gradient(\n271\t    to right,\n272\t    transparent,\n273\t    var(--color-stone-200, #e7e5e4) var(--divider-progress, 50%),\n274\t    transparent\n275\t  );\n276\t}\n277\t\n278\t@media (prefers-color-scheme: dark) {\n279\t  .divider {\n280\t    background: linear-gradient(\n281\t      to right,\n282\t      transparent,\n283\t      var(--color-stone-700, #44403c) var(--divider-progress, 50%),\n284\t      transparent\n285\t    );\n286\t  }\n287\t}\n288\t\n289\t@utility icon-box {\n290\t  /* Feature icon container */\n291\t  @apply w-12 h-12 rounded-xl bg-amber-50 flex items-center justify-center\n292\t           text-amber-700 dark:bg-amber-900/30 dark:text-amber-400;\n293\t}\n294\t\n295\t@utility font-display {\n296\t  /* Display font utility — uses theme variable for next/font metric-adjusted fallback */\n297\t  font-family: var(--font-display);\n298\t}\n299\t\n300\t@utility text-gradient {\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"650472e5-a1e2-490b-836b-3f33e6c52d9d","uuid":"881ea439-4866-4c84-ba40-030519a2f1ef","timestamp":"2026-04-14T05:10:18.266Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\app\\globals.css","content":"@import 'tailwindcss';\n\n@plugin \"@tailwindcss/typography\";\n\n/* ============================================================\n   CSS @property — Type-safe, animatable design tokens (US-233)\n   Registered custom properties can be interpolated by the browser\n   because their syntax is known (angle, percentage, etc.).\n   Browsers without @property support treat these as untyped\n   custom properties — static fallback values still render correctly,\n   only the animation is lost (progressive enhancement).\n   Chrome 85+, Firefox 128+, Safari 17.2+.\n   ============================================================ */\n@property --gradient-angle {\n  syntax: \"<angle>\";\n  inherits: false;\n  initial-value: 135deg;\n}\n\n@property --divider-progress {\n  syntax: \"<percentage>\";\n  inherits: false;\n  initial-value: 50%;\n}\n\n@theme {\n  --color-primary-50: #faf8f5;\n  --color-primary-100: #f5f0e8;\n  --color-primary-200: #e8ddd0;\n  --color-primary-300: #d4c4ad;\n  --color-primary-400: #bda685;\n  --color-primary-500: #a68b64;\n  --color-primary-600: #8b7355;\n  --color-primary-700: #715d47;\n  --color-primary-800: #5c4c3c;\n  --color-primary-900: #4a3f33;\n\n  --color-accent-50: #fdf8f6;\n  --color-accent-100: #f9ede8;\n  --color-accent-200: #f4dcd3;\n  --color-accent-300: #ecc4b5;\n  --color-accent-400: #e0a48d;\n  --color-accent-500: #d4846a;\n  --color-accent-600: #c26a4f;\n  --color-accent-700: #a25540;\n  --color-accent-800: #864738;\n  --color-accent-900: #6e3d31;\n\n  --color-sand-50: #fafaf9;\n  --color-sand-100: #f5f5f4;\n  --color-sand-200: #e7e5e4;\n  --color-sand-300: #d6d3d1;\n  --color-sand-400: #a8a29e;\n  --color-sand-500: #78716c;\n  --color-sand-600: #57534e;\n  --color-sand-700: #44403c;\n  --color-sand-800: #292524;\n  --color-sand-900: #1c1917;\n\n  --font-sans: var(--font-inter), system-ui, sans-serif;\n  --font-display: var(--font-playfair), Georgia, serif;\n\n  --text-2xs: 0.65rem;\n  --text-2xs--line-height: 1rem;\n\n  --tracking-widest: 0.2em;\n\n  --animate-fade-in: fadeIn 0.6s ease-out forwards;\n  --animate-slide-up: slideUp 0.6s ease-out forwards;\n  --animate-scale-in: scaleIn 0.4s ease-out forwards;\n\n  --background-image-gradient-radial: radial-gradient(var(--tw-gradient-stops));\n  --background-image-noise: url('/images/noise.png');\n\n  @keyframes fadeIn {\n    0% {\n      opacity: 0;\n    }\n    100% {\n      opacity: 1;\n    }\n  }\n  @keyframes slideUp {\n    0% {\n      opacity: 0;\n      transform: translateY(20px);\n    }\n    100% {\n      opacity: 1;\n      transform: translateY(0);\n    }\n  }\n  @keyframes scaleIn {\n    0% {\n      opacity: 0;\n      transform: scale(0.95);\n    }\n    100% {\n      opacity: 1;\n      transform: scale(1);\n    }\n  }\n}\n\n/*\n  The default border color has changed to `currentcolor` in Tailwind CSS v4,\n  so we've added these compatibility styles to make sure everything still\n  looks the same as it did with Tailwind CSS v3.\n\n  If we ever want to remove these styles, we need to add an explicit border\n  color utility to any element that depends on these defaults.\n*/\n@layer base {\n  *,\n  ::after,\n  ::before,\n  ::backdrop,\n  ::file-selector-button {\n    border-color: var(--color-gray-200, currentcolor);\n  }\n}\n\n@utility btn-primary {\n  /* Primary Button - Warm, sophisticated */\n  @apply bg-stone-700 hover:bg-stone-800 text-white font-medium\n           py-3.5 px-8 rounded-full transition-all duration-300\n           shadow-xs hover:shadow-md cursor-pointer\n           tracking-wide text-sm uppercase\n           focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700\n           dark:bg-stone-200 dark:text-stone-900 dark:hover:bg-stone-100\n           dark:focus-visible:outline-amber-400;\n}\n\n@utility btn-secondary {\n  /* Secondary Button - Minimal outline */\n  @apply bg-transparent hover:bg-stone-100 text-stone-700\n           font-medium py-3.5 px-8 rounded-full\n           border border-stone-500 hover:border-stone-600\n           transition-all duration-300 cursor-pointer\n           tracking-wide text-sm uppercase\n           focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700\n           dark:text-stone-300 dark:border-stone-600 dark:hover:bg-stone-800 dark:hover:border-stone-500\n           dark:focus-visible:outline-amber-400;\n}\n\n@utility section-padding {\n  /* Section spacing - More breathing room */\n  @apply py-20 md:py-28 lg:py-32 px-6 md:px-8;\n}\n\n/* ============================================================\n   CSS Native Scroll-Driven Carousel (US-187)\n   Chrome 135+ ships ::scroll-button() and ::scroll-marker\n   pseudo-elements for automatic ARIA button roles and\n   keyboard handling. Fallback: scrollBy() JS continues to work.\n   ============================================================ */\n@supports (selector(::scroll-button(*))) {\n  .carousel-scroll-container {\n    scroll-snap-type: x mandatory;\n    scroll-behavior: smooth;\n    overflow-x: auto;\n  }\n\n  .carousel-scroll-container > * {\n    scroll-snap-align: start;\n    scroll-snap-stop: always;\n  }\n\n  /* Automatic scroll prev/next buttons with ARIA roles */\n  .carousel-scroll-container::scroll-button(prev) {\n    @apply w-11 h-11 rounded-full bg-white dark:bg-stone-800 shadow-md\n           flex items-center justify-center\n           hover:bg-stone-50 dark:hover:bg-stone-700\n           transition-colors cursor-pointer;\n    position: absolute;\n    left: 0;\n    top: 50%;\n    transform: translateY(-50%);\n    z-index: 20;\n  }\n\n  .carousel-scroll-container::scroll-button(next) {\n    @apply w-11 h-11 rounded-full bg-white dark:bg-stone-800 shadow-md\n           flex items-center justify-center\n           hover:bg-stone-50 dark:hover:bg-stone-700\n           transition-colors cursor-pointer;\n    position: absolute;\n    right: 0;\n    top: 50%;\n    transform: translateY(-50%);\n    z-index: 20;\n  }\n\n  /* Scroll marker group for keyboard-accessible navigation dots */\n  .carousel-scroll-container::scroll-marker {\n    display: flex;\n    gap: 0.5rem;\n    justify-content: center;\n    margin-top: 1rem;\n    flex-wrap: wrap;\n  }\n\n  .carousel-scroll-container::scroll-marker-item {\n    @apply w-2 h-2 rounded-full bg-stone-300 dark:bg-stone-600\n           cursor-pointer transition-colors;\n  }\n\n  .carousel-scroll-container::scroll-marker-item[aria-current=\"true\"] {\n    @apply bg-amber-600 dark:bg-amber-400;\n  }\n}\n\n/* Fallback: older browsers degrade to basic scrollable container */\n@supports not (selector(::scroll-button(*))) {\n  .carousel-scroll-container {\n    scroll-snap-type: x mandatory;\n    overflow-x: auto;\n    scrollbar-width: none;\n    -ms-overflow-style: none;\n  }\n\n  .carousel-scroll-container::-webkit-scrollbar {\n    display: none;\n  }\n\n  .carousel-scroll-container > * {\n    scroll-snap-align: start;\n    scroll-snap-stop: always;\n  }\n}\n\n@utility container-custom {\n  /* Container */\n  @apply max-w-6xl mx-auto;\n}\n\n@utility section-label {\n  /* Section label - Elegant uppercase */\n  @apply text-xs font-medium tracking-widest uppercase text-amber-700 mb-4 dark:text-amber-400;\n}\n\n@utility section-heading {\n  /* Section heading - Serif display font (uses theme --font-display for next/font metric-adjusted fallback) */\n  @apply text-3xl md:text-4xl lg:text-5xl font-medium text-stone-900\n           leading-tight tracking-tight dark:text-stone-100;\n  font-family: var(--font-display);\n}\n\n@utility body-text {\n  /* Body text */\n  @apply text-stone-600 leading-relaxed dark:text-stone-400;\n}\n\n@utility card {\n  /* Card with subtle hover */\n  @apply bg-white rounded-2xl p-6 md:p-8\n           shadow-xs hover:shadow-md transition-shadow duration-300\n           border border-stone-100\n           dark:bg-stone-800 dark:border-stone-700;\n}\n\n@utility image-frame {\n  /* Image container with elegant corners */\n  @apply rounded-2xl overflow-hidden shadow-lg;\n}\n\n@utility divider {\n  /* Divider — uses @property --divider-progress for animatable gradient midpoint */\n  height: 1px;\n  background: linear-gradient(\n    to right,\n    transparent,\n    var(--color-stone-200, #e7e5e4) var(--divider-progress, 50%),\n    transparent\n  );\n}\n\n@media (prefers-color-scheme: dark) {\n  .divider {\n    background: linear-gradient(\n      to right,\n      transparent,\n      var(--color-stone-700, #44403c) var(--divider-progress, 50%),\n      transparent\n    );\n  }\n}\n\n@utility icon-box {\n  /* Feature icon container */\n  @apply w-12 h-12 rounded-xl bg-amber-50 flex items-center justify-center\n           text-amber-700 dark:bg-amber-900/30 dark:text-amber-400;\n}\n\n@utility font-display {\n  /* Display font utility — uses theme variable for next/font metric-adjusted fallback */\n  font-family: var(--font-display);\n}\n\n@utility text-gradient {","numLines":300,"startLine":1,"totalLines":871}}}
{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01KULJtykUecfhLiTM1izQKX","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018JoTJEq49ycE9i3s2qDRg8","name":"Read","input":{"file_path":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\components\\Gallery.tsx"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":1136,"cache_read_input_tokens":68456,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1136},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"650472e5-a1e2-490b-836b-3f33e6c52d9d","uuid":"e20a80f7-063c-45dd-9520-c887b7353500"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018JoTJEq49ycE9i3s2qDRg8","type":"tool_result","content":"1\t\"use client\";\n2\t\n3\timport { useState, useRef, useEffect, useCallback } from \"react\";\n4\timport Image from \"next/image\";\n5\t\n6\tfunction handleActivate(callback: () => void) {\n7\t  return {\n8\t    onClick: callback,\n9\t    onKeyDown: (e: React.KeyboardEvent) => {\n10\t      if (e.key === \"Enter\" || e.key === \" \") {\n11\t        e.preventDefault();\n12\t        callback();\n13\t      }\n14\t    },\n15\t  };\n16\t}\n17\t\n18\texport default function Gallery() {\n19\t  const [selectedImage, setSelectedImage] = useState<string | null>(null);\n20\t  const [activeModal, setActiveModal] = useState<string | null>(null);\n21\t  const [lightboxImages, setLightboxImages] = useState<string[]>([]);\n22\t  const lightboxCloseRef = useRef<HTMLButtonElement>(null);\n23\t  const modalCloseRef = useRef<HTMLButtonElement>(null);\n24\t  const triggerRef = useRef<HTMLElement | null>(null);\n25\t\n26\t  const openLightbox = (src: string, images: string[]) => {\n27\t    triggerRef.current = document.activeElement as HTMLElement;\n28\t    setLightboxImages(images);\n29\t    setSelectedImage(src);\n30\t  };\n31\t\n32\t  const closeLightbox = useCallback(() => {\n33\t    setSelectedImage(null);\n34\t    setLightboxImages([]);\n35\t    triggerRef.current?.focus();\n36\t  }, []);\n37\t\n38\t  const closeModal = useCallback(() => {\n39\t    setActiveModal(null);\n40\t    triggerRef.current?.focus();\n41\t  }, []);\n42\t\n43\t  const navigateLightbox = useCallback((direction: 'prev' | 'next') => {\n44\t    setSelectedImage((prev) => {\n45\t      if (!prev || lightboxImages.length === 0) return prev;\n46\t      const currentIndex = lightboxImages.indexOf(prev);\n47\t      if (currentIndex === -1) return prev;\n48\t      const newIndex = direction === 'prev'\n49\t        ? (currentIndex - 1 + lightboxImages.length) % lightboxImages.length\n50\t        : (currentIndex + 1) % lightboxImages.length;\n51\t      return lightboxImages[newIndex];\n52\t    });\n53\t  }, [lightboxImages]);\n54\t\n55\t  // Lightbox keyboard: Escape, ArrowLeft, ArrowRight\n56\t  useEffect(() => {\n57\t    if (!selectedImage) return;\n58\t    // Focus close button when lightbox opens\n59\t    lightboxCloseRef.current?.focus();\n60\t\n61\t    function handleKeyDown(e: KeyboardEvent) {\n62\t      if (e.key === \"Escape\") {\n63\t        closeLightbox();\n64\t      } else if (e.key === \"ArrowLeft\") {\n65\t        e.preventDefault();\n66\t        navigateLightbox('prev');\n67\t      } else if (e.key === \"ArrowRight\") {\n68\t        e.preventDefault();\n69\t        navigateLightbox('next');\n70\t      }\n71\t    }\n72\t    document.addEventListener(\"keydown\", handleKeyDown);\n73\t    return () => document.removeEventListener(\"keydown\", handleKeyDown);\n74\t  }, [selectedImage, closeLightbox, navigateLightbox]);\n75\t\n76\t  // Modal keyboard: Escape to close\n77\t  useEffect(() => {\n78\t    if (!activeModal) return;\n79\t    modalCloseRef.current?.focus();\n80\t\n81\t    function handleKeyDown(e: KeyboardEvent) {\n82\t      if (e.key === \"Escape\") {\n83\t        closeModal();\n84\t      }\n85\t    }\n86\t    document.addEventListener(\"keydown\", handleKeyDown);\n87\t    return () => document.removeEventListener(\"keydown\", handleKeyDown);\n88\t  }, [activeModal, closeModal]);\n89\t\n90\t  // Hostel photos - best shots\n91\t  const hostelPhotos = [\n92\t    { src: \"/images/living-room.jpeg\", alt: \"Cozy common area and living room at Pelangi Capsule Hostel Johor Bahru\" },\n93\t    { src: \"/images/capsule-1.webp\", alt: \"Japanese-style capsule pod interior with privacy features at budget hostel JB\" },\n94\t    { src: \"/images/entrance.jpeg\", alt: \"Welcoming entrance of Pelangi Capsule Hostel in Taman Pelangi\" },\n95\t    { src: \"/images/exterior.JPG\", alt: \"Pelangi Capsule Hostel building exterior in Johor Bahru Malaysia\" },\n96\t    { src: \"/images/capsule-2.webp\", alt: \"Comfortable premium mattress in affordable hostel pod near Singapore\" },\n97\t    { src: \"/images/toilet.jpg\", alt: \"Clean private bathroom with hot shower at Pelangi Hostel JB\" },\n98\t    { src: \"/images/facility-heater.jpg\", alt: \"24/7 hot water heater facility at budget accommodation Johor Bahru\" },\n99\t    { src: \"/images/sink.jpg\", alt: \"Washing and sink area at Pelangi Capsule Hostel\" },\n100\t    { src: \"/images/capsule-3.webp\", alt: \"Capsule pod amenities including USB charging and ventilation\" },\n101\t    { src: \"/images/facility-shoes-rack.jpg\", alt: \"Organized shoe storage at clean hostel in Taman Pelangi JB\" },\n102\t  ];\n103\t\n104\t  // Guest photos - social proof\n105\t  const guestPhotos = Array.from({ length: 20 }, (_, i) => ({\n106\t    src: `/images/guests/guest-${i + 1}.jpg`,\n107\t    alt: `Happy guest enjoying their stay at Pelangi Capsule Hostel Johor Bahru - photo ${i + 1}`,\n108\t  }));\n109\t\n110\t  // Tourist destinations\n111\t  const destinations = [\n112\t    { src: \"/images/destinations/tioman-island.jpg\", name: \"Tioman Island\", distance: \"4 hours\" },\n113\t    { src: \"/images/destinations/singapore.jpg\", name: \"Singapore\", distance: \"30 min\" },\n114\t    { src: \"/images/destinations/jewel.jpg\", name: \"Jewel Changi\", distance: \"45 min\" },\n115\t    { src: \"/images/destinations/garden-by-the-bay.jpg\", name: \"Gardens by the Bay\", distance: \"1 hour\" },\n116\t    { src: \"/images/destinations/melaka.jpg\", name: \"Melaka\", distance: \"3 hours\" },\n117\t    { src: \"/images/destinations/tanjung-piai-nationa.jpg\", name: \"Tanjung Piai\", distance: \"1.5 hours\" },\n118\t  ];\n119\t\n120\t  const ScrollSection = ({\n121\t    title,\n122\t    subtitle,\n123\t    children,\n124\t    onSeeAll,\n125\t    id\n126\t  }: {\n127\t    title: string;\n128\t    subtitle: string;\n129\t    children: React.ReactNode;\n130\t    onSeeAll?: () => void;\n131\t    id?: string;\n132\t  }) => {\n133\t    const scrollRef = useRef<HTMLDivElement>(null);\n134\t\n135\t    const scroll = (direction: 'left' | 'right') => {\n136\t      if (scrollRef.current) {\n137\t        const scrollAmount = 320;\n138\t        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n139\t        scrollRef.current.scrollBy({\n140\t          left: direction === 'left' ? -scrollAmount : scrollAmount,\n141\t          behavior: prefersReducedMotion ? 'auto' : 'smooth'\n142\t        });\n143\t      }\n144\t    };\n145\t\n146\t    return (\n147\t      <div id={id} className=\"mb-16 scroll-mt-24\">\n148\t        <div className=\"flex items-end justify-between mb-6 px-4 md:px-0\">\n149\t          <div>\n150\t            <h3 className=\"font-display text-2xl md:text-3xl font-medium text-stone-900 dark:text-stone-100\">{title}</h3>\n151\t            <p className=\"text-stone-500 dark:text-stone-400 text-sm mt-1\">{subtitle}</p>\n152\t          </div>\n153\t          <div className=\"flex items-center gap-2\">\n154\t            {onSeeAll && (\n155\t              <button\n156\t                onClick={onSeeAll}\n157\t                className=\"min-h-6 inline-flex items-center text-amber-700 dark:text-amber-400 hover:text-amber-800 dark:hover:text-amber-300 font-medium text-sm mr-4 cursor-pointer\"\n158\t              >\n159\t                See All →\n160\t              </button>\n161\t            )}\n162\t            <button\n163\t              onClick={() => scroll('left')}\n164\t              className=\"w-11 h-11 rounded-full bg-white dark:bg-stone-800 shadow-md flex items-center justify-center\n165\t                       hover:bg-stone-50 dark:hover:bg-stone-700 transition-colors cursor-pointer\"\n166\t              aria-label=\"Previous image\"\n167\t            >\n168\t              <svg className=\"w-5 h-5 text-stone-600 dark:text-stone-300\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n169\t                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M15 19l-7-7 7-7\" />\n170\t              </svg>\n171\t            </button>\n172\t            <button\n173\t              onClick={() => scroll('right')}\n174\t              className=\"w-11 h-11 rounded-full bg-white dark:bg-stone-800 shadow-md flex items-center justify-center\n175\t                       hover:bg-stone-50 dark:hover:bg-stone-700 transition-colors cursor-pointer\"\n176\t              aria-label=\"Next image\"\n177\t            >\n178\t              <svg className=\"w-5 h-5 text-stone-600 dark:text-stone-300\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n179\t                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M9 5l7 7-7 7\" />\n180\t              </svg>\n181\t            </button>\n182\t          </div>\n183\t        </div>\n184\t        <div\n185\t          ref={scrollRef}\n186\t          className=\"flex gap-4 overflow-x-auto scrollbar-hide pb-4 px-4 md:px-0 snap-x snap-mandatory carousel-scroll-container\"\n187\t          style={{ scrollbarWidth: 'none', msOverflowStyle: 'none' }}\n188\t        >\n189\t          {children}\n190\t        </div>\n191\t      </div>\n192\t    );\n193\t  };\n194\t\n195\t  return (\n196\t    <section id=\"gallery\" className=\"section-padding bg-stone-50 dark:bg-stone-950\">\n197\t      <div className=\"max-w-7xl mx-auto\">\n198\t        {/* Header */}\n199\t        <div className=\"text-center max-w-2xl mx-auto mb-14 px-4\">\n200\t          <p className=\"section-label\">Gallery</p>\n201\t          <h2 className=\"section-heading mb-6\">Photo Gallery</h2>\n202\t          <p className=\"text-stone-600 dark:text-stone-400 text-lg leading-relaxed\">\n203\t            Browse through our hostel, see happy guests, and discover adventures waiting for you.\n204\t          </p>\n205\t        </div>\n206\t\n207\t        {/* Section 1: Our Hostel */}\n208\t        <ScrollSection\n209\t          title=\"Our Hostel\"\n210\t          subtitle=\"Capsules, facilities, and common areas\"\n211\t        >\n212\t          {hostelPhotos.map((photo, index) => (\n213\t            <div\n214\t              key={index}\n215\t              role=\"button\"\n216\t              tabIndex={0}\n217\t              aria-label={`View photo: ${photo.alt}`}\n218\t              className=\"shrink-0 w-72 h-48 md:w-80 md:h-56 relative rounded-2xl overflow-hidden\n219\t                       cursor-pointer group snap-start focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700\"\n220\t              {...handleActivate(() => openLightbox(photo.src, hostelPhotos.map(p => p.src)))}\n221\t            >\n222\t              <Image\n223\t                src={photo.src}\n224\t                alt={photo.alt}\n225\t                fill\n226\t                sizes=\"(max-width: 768px) 288px, 320px\"\n227\t                className=\"object-cover transition-transform duration-500 group-hover:scale-110\"\n228\t              />\n229\t              <div className=\"absolute inset-0 bg-linear-to-t from-stone-900/60 via-transparent to-transparent\n230\t                            opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-opacity duration-300\" />\n231\t              <div className=\"absolute bottom-3 left-3 text-white opacity-0 group-hover:opacity-100 group-focus-within:opacity-100\n232\t                            transition-opacity duration-300\">\n233\t                <p className=\"text-sm font-medium\">{photo.alt}</p>\n234\t              </div>\n235\t            </div>\n236\t          ))}\n237\t        </ScrollSection>\n238\t\n239\t        {/* Section 2: Happy Guests */}\n240\t        <ScrollSection\n241\t          id=\"community\"\n242\t          title=\"Guest Photos\"\n243\t          subtitle=\"Real moments from our community\"\n244\t          onSeeAll={() => { triggerRef.current = document.activeElement as HTMLElement; setActiveModal('guests'); }}\n245\t        >\n246\t          {guestPhotos.slice(0, 12).map((photo, index) => (\n247\t            <div\n248\t              key={index}\n249\t              role=\"button\"\n250\t              tabIndex={0}\n251\t              aria-label={`View guest photo ${index + 1}`}\n252\t              className=\"shrink-0 w-40 h-40 md:w-48 md:h-48 relative rounded-2xl overflow-hidden\n253\t                       cursor-pointer group snap-start focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700\"\n254\t              {...handleActivate(() => openLightbox(photo.src, guestPhotos.map(p => p.src)))}\n255\t            >\n256\t              <Image\n257\t                src={photo.src}\n258\t                alt={photo.alt}\n259\t                fill\n260\t                sizes=\"(max-width: 768px) 160px, 192px\"\n261\t                className=\"object-cover transition-transform duration-500 group-hover:scale-110\"\n262\t              />\n263\t              <div className=\"absolute inset-0 bg-stone-900/0 group-hover:bg-stone-900/20 transition-colors\" />\n264\t            </div>\n265\t          ))}\n266\t          {/* See more card */}\n267\t          <div\n268\t            role=\"button\"\n269\t            tabIndex={0}\n270\t            aria-label={`View all ${guestPhotos.length} guest photos`}\n271\t            className=\"shrink-0 w-40 h-40 md:w-48 md:h-48 relative rounded-2xl overflow-hidden\n272\t                     cursor-pointer group snap-start bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center\n273\t                     focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700\"\n274\t            {...handleActivate(() => { triggerRef.current = document.activeElement as HTMLElement; setActiveModal('guests'); })}\n275\t          >\n276\t            <div className=\"text-center\">\n277\t              <div className=\"text-3xl font-display font-medium text-amber-700 dark:text-amber-400\">+{guestPhotos.length - 12}</div>\n278\t              <div className=\"text-sm text-amber-600 dark:text-amber-400 mt-1\">more photos</div>\n279\t            </div>\n280\t          </div>\n281\t        </ScrollSection>\n282\t\n283\t        {/* Section 3: Explore from JB */}\n284\t        <ScrollSection\n285\t          title=\"Adventures Await\"\n286\t          subtitle=\"Amazing destinations within reach\"\n287\t        >\n288\t          {destinations.map((dest, index) => (\n289\t            <div\n290\t              key={index}\n291\t              role=\"button\"\n292\t              tabIndex={0}\n293\t              aria-label={`View photo: ${dest.name}`}\n294\t              className=\"shrink-0 w-64 md:w-72 relative rounded-2xl overflow-hidden\n295\t                       cursor-pointer group snap-start focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700\"\n296\t              {...handleActivate(() => openLightbox(dest.src, destinations.map(d => d.src)))}\n297\t            >\n298\t              <div className=\"relative h-44 md:h-52\">\n299\t                <Image\n300\t                  src={dest.src}\n301\t                  alt={dest.name}\n302\t                  fill\n303\t                  sizes=\"(max-width: 768px) 256px, 288px\"\n304\t                  className=\"object-cover transition-transform duration-500 group-hover:scale-110\"\n305\t                />\n306\t                <div className=\"absolute inset-0 bg-linear-to-t from-stone-900/80 via-stone-900/20 to-transparent\" />\n307\t              </div>\n308\t              <div className=\"absolute bottom-0 left-0 right-0 p-4 text-white\">\n309\t                <h4 className=\"font-semibold text-lg\">{dest.name}</h4>\n310\t                <p className=\"text-sm text-stone-300 flex items-center gap-1 mt-1\">\n311\t                  <svg className=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n312\t                    <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2}\n313\t                      d=\"M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z\" />\n314\t                  </svg>\n315\t                  {dest.distance} from hostel\n316\t                </p>\n317\t              </div>\n318\t            </div>\n319\t          ))}\n320\t        </ScrollSection>\n321\t\n322\t        {/* Video Section */}\n323\t        <div className=\"mt-8 px-4 md:px-0\">\n324\t          <div className=\"text-center mb-8\">\n325\t            <p className=\"text-xs tracking-widest uppercase text-stone-500 dark:text-stone-400 mb-2\">Virtual Tour</p>\n326\t            <h3 className=\"font-display text-2xl font-medium text-stone-900 dark:text-stone-100\">\n327\t              Watch Our Check-in Guide\n328\t            </h3>\n329\t          </div>\n330\t          <div className=\"relative max-w-3xl mx-auto aspect-video rounded-2xl overflow-hidden shadow-2xl\">\n331\t            <iframe\n332\t              src=\"https://www.youtube.com/embed/6Ux11oBZaQQ?cc_load_policy=1&cc_lang_pref=en\"\n333\t              title=\"Pelangi Capsule Hostel Check-in Guide\"\n334\t              allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\"\n335\t              allowFullScreen\n336\t              className=\"absolute inset-0 w-full h-full\"\n337\t            />\n338\t          </div>\n339\t        </div>\n340\t      </div>\n341\t\n342\t      {/* Lightbox */}\n343\t      {selectedImage && (\n344\t        <div\n345\t          role=\"dialog\"\n346\t          aria-label=\"Image lightbox\"\n347\t          aria-modal=\"true\"\n348\t          className=\"fixed inset-0 z-50 bg-stone-900/95 backdrop-blur-xs flex items-center justify-center p-4\"\n349\t          onClick={() => closeLightbox()}\n350\t        >\n351\t          <button\n352\t            ref={lightboxCloseRef}\n353\t            className=\"absolute top-6 right-6 w-12 h-12 rounded-full bg-white/10 flex items-center justify-center\n354\t                     text-white hover:bg-white/20 transition-colors cursor-pointer\"\n355\t            onClick={() => closeLightbox()}\n356\t            aria-label=\"Close lightbox (Escape)\"\n357\t          >\n358\t            <svg className=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n359\t              <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={1.5} d=\"M6 18L18 6M6 6l12 12\" />\n360\t            </svg>\n361\t          </button>\n362\t          {lightboxImages.length > 1 && (\n363\t            <button\n364\t              className=\"absolute left-4 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-white/10 flex items-center justify-center\n365\t                       text-white hover:bg-white/20 transition-colors cursor-pointer z-10\"\n366\t              onClick={(e) => { e.stopPropagation(); navigateLightbox('prev'); }}\n367\t              aria-label=\"Previous image (Left arrow)\"\n368\t            >\n369\t              <svg className=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n370\t                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M15 19l-7-7 7-7\" />\n371\t              </svg>\n372\t            </button>\n373\t          )}\n374\t          <div className=\"relative w-full max-w-5xl h-[80vh]\" onClick={(e) => e.stopPropagation()}>\n375\t            <Image\n376\t              src={selectedImage}\n377\t              alt=\"Pelangi Capsule Hostel Johor Bahru - Gallery photo view\"\n378\t              fill\n379\t              sizes=\"100vw\"\n380\t              className=\"object-contain\"\n381\t            />\n382\t          </div>\n383\t          {lightboxImages.length > 1 && (\n384\t            <button\n385\t              className=\"absolute right-4 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-white/10 flex items-center justify-center\n386\t                       text-white hover:bg-white/20 transition-colors cursor-pointer z-10\"\n387\t              onClick={(e) => { e.stopPropagation(); navigateLightbox('next'); }}\n388\t              aria-label=\"Next image (Right arrow)\"\n389\t            >\n390\t              <svg className=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n391\t                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M9 5l7 7-7 7\" />\n392\t              </svg>\n393\t            </button>\n394\t          )}\n395\t        </div>\n396\t      )}\n397\t\n398\t      {/* All Guests Modal */}\n399\t      {activeModal === 'guests' && (\n400\t        <div\n401\t          role=\"dialog\"\n402\t          aria-label=\"All guest photos\"\n403\t          aria-modal=\"true\"\n404\t          className=\"fixed inset-0 z-50 bg-stone-900/95 backdrop-blur-xs overflow-y-auto\"\n405\t          onClick={() => closeModal()}\n406\t        >\n407\t          <div className=\"min-h-screen p-4 md:p-8\">\n408\t            <div className=\"max-w-6xl mx-auto\">\n409\t              <div className=\"flex items-center justify-between mb-8 sticky top-0 bg-stone-900/80 backdrop-blur-xs py-4 -mx-4 px-4\">\n410\t                <div>\n411\t                  <h3 className=\"text-2xl font-display font-medium text-white\">Guest Photos</h3>\n412\t                  <p className=\"text-stone-400 text-sm\">{guestPhotos.length} photos from our community</p>\n413\t                </div>\n414\t                <button\n415\t                  ref={modalCloseRef}\n416\t                  className=\"w-12 h-12 rounded-full bg-white/10 flex items-center justify-center\n417\t                           text-white hover:bg-white/20 transition-colors cursor-pointer\"\n418\t                  onClick={() => closeModal()}\n419\t                  aria-label=\"Close guest photos gallery (Escape)\"\n420\t                >\n421\t                  <svg className=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n422\t                    <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={1.5} d=\"M6 18L18 6M6 6l12 12\" />\n423\t                  </svg>\n424\t                </button>\n425\t              </div>\n426\t              <div\n427\t                className=\"grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-3\"\n428\t                onClick={(e) => e.stopPropagation()}\n429\t              >\n430\t                {guestPhotos.map((photo, index) => (\n431\t                  <div\n432\t                    key={index}\n433\t                    role=\"button\"\n434\t                    tabIndex={0}\n435\t                    aria-label={`View guest photo ${index + 1}`}\n436\t                    className=\"relative aspect-square rounded-xl overflow-hidden cursor-pointer group\n437\t                             focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700\"\n438\t                    {...handleActivate(() => {\n439\t                      closeModal();\n440\t                      openLightbox(photo.src, guestPhotos.map(p => p.src));\n441\t                    })}\n442\t                  >\n443\t                    <Image\n444\t                      src={photo.src}\n445\t                      alt={photo.alt}\n446\t                      fill\n447\t                      sizes=\"(max-width: 768px) 50vw, (max-width: 1024px) 25vw, 20vw\"\n448\t                      className=\"object-cover transition-transform duration-300 group-hover:scale-110\"\n449\t                    />\n450\t                    <div className=\"absolute inset-0 bg-stone-900/0 group-hover:bg-stone-900/30 transition-colors\" />\n451\t                  </div>\n452\t                ))}\n453\t              </div>\n454\t            </div>\n455\t          </div>\n456\t        </div>\n457\t      )}\n458\t    </section>\n459\t  );\n460\t}\n461\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"650472e5-a1e2-490b-836b-3f33e6c52d9d","uuid":"4699a16e-ec2a-4508-8dd4-f5cee310b313","timestamp":"2026-04-14T05:10:18.774Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\components\\Gallery.tsx","content":"\"use client\";\n\nimport { useState, useRef, useEffect, useCallback } from \"react\";\nimport Image from \"next/image\";\n\nfunction handleActivate(callback: () => void) {\n  return {\n    onClick: callback,\n    onKeyDown: (e: React.KeyboardEvent) => {\n      if (e.key === \"Enter\" || e.key === \" \") {\n        e.preventDefault();\n        callback();\n      }\n    },\n  };\n}\n\nexport default function Gallery() {\n  const [selectedImage, setSelectedImage] = useState<string | null>(null);\n  const [activeModal, setActiveModal] = useState<string | null>(null);\n  const [lightboxImages, setLightboxImages] = useState<string[]>([]);\n  const lightboxCloseRef = useRef<HTMLButtonElement>(null);\n  const modalCloseRef = useRef<HTMLButtonElement>(null);\n  const triggerRef = useRef<HTMLElement | null>(null);\n\n  const openLightbox = (src: string, images: string[]) => {\n    triggerRef.current = document.activeElement as HTMLElement;\n    setLightboxImages(images);\n    setSelectedImage(src);\n  };\n\n  const closeLightbox = useCallback(() => {\n    setSelectedImage(null);\n    setLightboxImages([]);\n    triggerRef.current?.focus();\n  }, []);\n\n  const closeModal = useCallback(() => {\n    setActiveModal(null);\n    triggerRef.current?.focus();\n  }, []);\n\n  const navigateLightbox = useCallback((direction: 'prev' | 'next') => {\n    setSelectedImage((prev) => {\n      if (!prev || lightboxImages.length === 0) return prev;\n      const currentIndex = lightboxImages.indexOf(prev);\n      if (currentIndex === -1) return prev;\n      const newIndex = direction === 'prev'\n        ? (currentIndex - 1 + lightboxImages.length) % lightboxImages.length\n        : (currentIndex + 1) % lightboxImages.length;\n      return lightboxImages[newIndex];\n    });\n  }, [lightboxImages]);\n\n  // Lightbox keyboard: Escape, ArrowLeft, ArrowRight\n  useEffect(() => {\n    if (!selectedImage) return;\n    // Focus close button when lightbox opens\n    lightboxCloseRef.current?.focus();\n\n    function handleKeyDown(e: KeyboardEvent) {\n      if (e.key === \"Escape\") {\n        closeLightbox();\n      } else if (e.key === \"ArrowLeft\") {\n        e.preventDefault();\n        navigateLightbox('prev');\n      } else if (e.key === \"ArrowRight\") {\n        e.preventDefault();\n        navigateLightbox('next');\n      }\n    }\n    document.addEventListener(\"keydown\", handleKeyDown);\n    return () => document.removeEventListener(\"keydown\", handleKeyDown);\n  }, [selectedImage, closeLightbox, navigateLightbox]);\n\n  // Modal keyboard: Escape to close\n  useEffect(() => {\n    if (!activeModal) return;\n    modalCloseRef.current?.focus();\n\n    function handleKeyDown(e: KeyboardEvent) {\n      if (e.key === \"Escape\") {\n        closeModal();\n      }\n    }\n    document.addEventListener(\"keydown\", handleKeyDown);\n    return () => document.removeEventListener(\"keydown\", handleKeyDown);\n  }, [activeModal, closeModal]);\n\n  // Hostel photos - best shots\n  const hostelPhotos = [\n    { src: \"/images/living-room.jpeg\", alt: \"Cozy common area and living room at Pelangi Capsule Hostel Johor Bahru\" },\n    { src: \"/images/capsule-1.webp\", alt: \"Japanese-style capsule pod interior with privacy features at budget hostel JB\" },\n    { src: \"/images/entrance.jpeg\", alt: \"Welcoming entrance of Pelangi Capsule Hostel in Taman Pelangi\" },\n    { src: \"/images/exterior.JPG\", alt: \"Pelangi Capsule Hostel building exterior in Johor Bahru Malaysia\" },\n    { src: \"/images/capsule-2.webp\", alt: \"Comfortable premium mattress in affordable hostel pod near Singapore\" },\n    { src: \"/images/toilet.jpg\", alt: \"Clean private bathroom with hot shower at Pelangi Hostel JB\" },\n    { src: \"/images/facility-heater.jpg\", alt: \"24/7 hot water heater facility at budget accommodation Johor Bahru\" },\n    { src: \"/images/sink.jpg\", alt: \"Washing and sink area at Pelangi Capsule Hostel\" },\n    { src: \"/images/capsule-3.webp\", alt: \"Capsule pod amenities including USB charging and ventilation\" },\n    { src: \"/images/facility-shoes-rack.jpg\", alt: \"Organized shoe storage at clean hostel in Taman Pelangi JB\" },\n  ];\n\n  // Guest photos - social proof\n  const guestPhotos = Array.from({ length: 20 }, (_, i) => ({\n    src: `/images/guests/guest-${i + 1}.jpg`,\n    alt: `Happy guest enjoying their stay at Pelangi Capsule Hostel Johor Bahru - photo ${i + 1}`,\n  }));\n\n  // Tourist destinations\n  const destinations = [\n    { src: \"/images/destinations/tioman-island.jpg\", name: \"Tioman Island\", distance: \"4 hours\" },\n    { src: \"/images/destinations/singapore.jpg\", name: \"Singapore\", distance: \"30 min\" },\n    { src: \"/images/destinations/jewel.jpg\", name: \"Jewel Changi\", distance: \"45 min\" },\n    { src: \"/images/destinations/garden-by-the-bay.jpg\", name: \"Gardens by the Bay\", distance: \"1 hour\" },\n    { src: \"/images/destinations/melaka.jpg\", name: \"Melaka\", distance: \"3 hours\" },\n    { src: \"/images/destinations/tanjung-piai-nationa.jpg\", name: \"Tanjung Piai\", distance: \"1.5 hours\" },\n  ];\n\n  const ScrollSection = ({\n    title,\n    subtitle,\n    children,\n    onSeeAll,\n    id\n  }: {\n    title: string;\n    subtitle: string;\n    children: React.ReactNode;\n    onSeeAll?: () => void;\n    id?: string;\n  }) => {\n    const scrollRef = useRef<HTMLDivElement>(null);\n\n    const scroll = (direction: 'left' | 'right') => {\n      if (scrollRef.current) {\n        const scrollAmount = 320;\n        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n        scrollRef.current.scrollBy({\n          left: direction === 'left' ? -scrollAmount : scrollAmount,\n          behavior: prefersReducedMotion ? 'auto' : 'smooth'\n        });\n      }\n    };\n\n    return (\n      <div id={id} className=\"mb-16 scroll-mt-24\">\n        <div className=\"flex items-end justify-between mb-6 px-4 md:px-0\">\n          <div>\n            <h3 className=\"font-display text-2xl md:text-3xl font-medium text-stone-900 dark:text-stone-100\">{title}</h3>\n            <p className=\"text-stone-500 dark:text-stone-400 text-sm mt-1\">{subtitle}</p>\n          </div>\n          <div className=\"flex items-center gap-2\">\n            {onSeeAll && (\n              <button\n                onClick={onSeeAll}\n                className=\"min-h-6 inline-flex items-center text-amber-700 dark:text-amber-400 hover:text-amber-800 dark:hover:text-amber-300 font-medium text-sm mr-4 cursor-pointer\"\n              >\n                See All →\n              </button>\n            )}\n            <button\n              onClick={() => scroll('left')}\n              className=\"w-11 h-11 rounded-full bg-white dark:bg-stone-800 shadow-md flex items-center justify-center\n                       hover:bg-stone-50 dark:hover:bg-stone-700 transition-colors cursor-pointer\"\n              aria-label=\"Previous image\"\n            >\n              <svg className=\"w-5 h-5 text-stone-600 dark:text-stone-300\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M15 19l-7-7 7-7\" />\n              </svg>\n            </button>\n            <button\n              onClick={() => scroll('right')}\n              className=\"w-11 h-11 rounded-full bg-white dark:bg-stone-800 shadow-md flex items-center justify-center\n                       hover:bg-stone-50 dark:hover:bg-stone-700 transition-colors cursor-pointer\"\n              aria-label=\"Next image\"\n            >\n              <svg className=\"w-5 h-5 text-stone-600 dark:text-stone-300\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M9 5l7 7-7 7\" />\n              </svg>\n            </button>\n          </div>\n        </div>\n        <div\n          ref={scrollRef}\n          className=\"flex gap-4 overflow-x-auto scrollbar-hide pb-4 px-4 md:px-0 snap-x snap-mandatory carousel-scroll-container\"\n          style={{ scrollbarWidth: 'none', msOverflowStyle: 'none' }}\n        >\n          {children}\n        </div>\n      </div>\n    );\n  };\n\n  return (\n    <section id=\"gallery\" className=\"section-padding bg-stone-50 dark:bg-stone-950\">\n      <div className=\"max-w-7xl mx-auto\">\n        {/* Header */}\n        <div className=\"text-center max-w-2xl mx-auto mb-14 px-4\">\n          <p className=\"section-label\">Gallery</p>\n          <h2 className=\"section-heading mb-6\">Photo Gallery</h2>\n          <p className=\"text-stone-600 dark:text-stone-400 text-lg leading-relaxed\">\n            Browse through our hostel, see happy guests, and discover adventures waiting for you.\n          </p>\n        </div>\n\n        {/* Section 1: Our Hostel */}\n        <ScrollSection\n          title=\"Our Hostel\"\n          subtitle=\"Capsules, facilities, and common areas\"\n        >\n          {hostelPhotos.map((photo, index) => (\n            <div\n              key={index}\n              role=\"button\"\n              tabIndex={0}\n              aria-label={`View photo: ${photo.alt}`}\n              className=\"shrink-0 w-72 h-48 md:w-80 md:h-56 relative rounded-2xl overflow-hidden\n                       cursor-pointer group snap-start focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700\"\n              {...handleActivate(() => openLightbox(photo.src, hostelPhotos.map(p => p.src)))}\n            >\n              <Image\n                src={photo.src}\n                alt={photo.alt}\n                fill\n                sizes=\"(max-width: 768px) 288px, 320px\"\n                className=\"object-cover transition-transform duration-500 group-hover:scale-110\"\n              />\n              <div className=\"absolute inset-0 bg-linear-to-t from-stone-900/60 via-transparent to-transparent\n                            opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-opacity duration-300\" />\n              <div className=\"absolute bottom-3 left-3 text-white opacity-0 group-hover:opacity-100 group-focus-within:opacity-100\n                            transition-opacity duration-300\">\n                <p className=\"text-sm font-medium\">{photo.alt}</p>\n              </div>\n            </div>\n          ))}\n        </ScrollSection>\n\n        {/* Section 2: Happy Guests */}\n        <ScrollSection\n          id=\"community\"\n          title=\"Guest Photos\"\n          subtitle=\"Real moments from our community\"\n          onSeeAll={() => { triggerRef.current = document.activeElement as HTMLElement; setActiveModal('guests'); }}\n        >\n          {guestPhotos.slice(0, 12).map((photo, index) => (\n            <div\n              key={index}\n              role=\"button\"\n              tabIndex={0}\n              aria-label={`View guest photo ${index + 1}`}\n              className=\"shrink-0 w-40 h-40 md:w-48 md:h-48 relative rounded-2xl overflow-hidden\n                       cursor-pointer group snap-start focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700\"\n              {...handleActivate(() => openLightbox(photo.src, guestPhotos.map(p => p.src)))}\n            >\n              <Image\n                src={photo.src}\n                alt={photo.alt}\n                fill\n                sizes=\"(max-width: 768px) 160px, 192px\"\n                className=\"object-cover transition-transform duration-500 group-hover:scale-110\"\n              />\n              <div className=\"absolute inset-0 bg-stone-900/0 group-hover:bg-stone-900/20 transition-colors\" />\n            </div>\n          ))}\n          {/* See more card */}\n          <div\n            role=\"button\"\n            tabIndex={0}\n            aria-label={`View all ${guestPhotos.length} guest photos`}\n            className=\"shrink-0 w-40 h-40 md:w-48 md:h-48 relative rounded-2xl overflow-hidden\n                     cursor-pointer group snap-start bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center\n                     focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700\"\n            {...handleActivate(() => { triggerRef.current = document.activeElement as HTMLElement; setActiveModal('guests'); })}\n          >\n            <div className=\"text-center\">\n              <div className=\"text-3xl font-display font-medium text-amber-700 dark:text-amber-400\">+{guestPhotos.length - 12}</div>\n              <div className=\"text-sm text-amber-600 dark:text-amber-400 mt-1\">more photos</div>\n            </div>\n          </div>\n        </ScrollSection>\n\n        {/* Section 3: Explore from JB */}\n        <ScrollSection\n          title=\"Adventures Await\"\n          subtitle=\"Amazing destinations within reach\"\n        >\n          {destinations.map((dest, index) => (\n            <div\n              key={index}\n              role=\"button\"\n              tabIndex={0}\n              aria-label={`View photo: ${dest.name}`}\n              className=\"shrink-0 w-64 md:w-72 relative rounded-2xl overflow-hidden\n                       cursor-pointer group snap-start focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700\"\n              {...handleActivate(() => openLightbox(dest.src, destinations.map(d => d.src)))}\n            >\n              <div className=\"relative h-44 md:h-52\">\n                <Image\n                  src={dest.src}\n                  alt={dest.name}\n                  fill\n                  sizes=\"(max-width: 768px) 256px, 288px\"\n                  className=\"object-cover transition-transform duration-500 group-hover:scale-110\"\n                />\n                <div className=\"absolute inset-0 bg-linear-to-t from-stone-900/80 via-stone-900/20 to-transparent\" />\n              </div>\n              <div className=\"absolute bottom-0 left-0 right-0 p-4 text-white\">\n                <h4 className=\"font-semibold text-lg\">{dest.name}</h4>\n                <p className=\"text-sm text-stone-300 flex items-center gap-1 mt-1\">\n                  <svg className=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                    <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2}\n                      d=\"M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z\" />\n                  </svg>\n                  {dest.distance} from hostel\n                </p>\n              </div>\n            </div>\n          ))}\n        </ScrollSection>\n\n        {/* Video Section */}\n        <div className=\"mt-8 px-4 md:px-0\">\n          <div className=\"text-center mb-8\">\n            <p className=\"text-xs tracking-widest uppercase text-stone-500 dark:text-stone-400 mb-2\">Virtual Tour</p>\n            <h3 className=\"font-display text-2xl font-medium text-stone-900 dark:text-stone-100\">\n              Watch Our Check-in Guide\n            </h3>\n          </div>\n          <div className=\"relative max-w-3xl mx-auto aspect-video rounded-2xl overflow-hidden shadow-2xl\">\n            <iframe\n              src=\"https://www.youtube.com/embed/6Ux11oBZaQQ?cc_load_policy=1&cc_lang_pref=en\"\n              title=\"Pelangi Capsule Hostel Check-in Guide\"\n              allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\"\n              allowFullScreen\n              className=\"absolute inset-0 w-full h-full\"\n            />\n          </div>\n        </div>\n      </div>\n\n      {/* Lightbox */}\n      {selectedImage && (\n        <div\n          role=\"dialog\"\n          aria-label=\"Image lightbox\"\n          aria-modal=\"true\"\n          className=\"fixed inset-0 z-50 bg-stone-900/95 backdrop-blur-xs flex items-center justify-center p-4\"\n          onClick={() => closeLightbox()}\n        >\n          <button\n            ref={lightboxCloseRef}\n            className=\"absolute top-6 right-6 w-12 h-12 rounded-full bg-white/10 flex items-center justify-center\n                     text-white hover:bg-white/20 transition-colors cursor-pointer\"\n            onClick={() => closeLightbox()}\n            aria-label=\"Close lightbox (Escape)\"\n          >\n            <svg className=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={1.5} d=\"M6 18L18 6M6 6l12 12\" />\n            </svg>\n          </button>\n          {lightboxImages.length > 1 && (\n            <button\n              className=\"absolute left-4 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-white/10 flex items-center justify-center\n                       text-white hover:bg-white/20 transition-colors cursor-pointer z-10\"\n              onClick={(e) => { e.stopPropagation(); navigateLightbox('prev'); }}\n              aria-label=\"Previous image (Left arrow)\"\n            >\n              <svg className=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M15 19l-7-7 7-7\" />\n              </svg>\n            </button>\n          )}\n          <div className=\"relative w-full max-w-5xl h-[80vh]\" onClick={(e) => e.stopPropagation()}>\n            <Image\n              src={selectedImage}\n              alt=\"Pelangi Capsule Hostel Johor Bahru - Gallery photo view\"\n              fill\n              sizes=\"100vw\"\n              className=\"object-contain\"\n            />\n          </div>\n          {lightboxImages.length > 1 && (\n            <button\n              className=\"absolute right-4 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-white/10 flex items-center justify-center\n                       text-white hover:bg-white/20 transition-colors cursor-pointer z-10\"\n              onClick={(e) => { e.stopPropagation(); navigateLightbox('next'); }}\n              aria-label=\"Next image (Right arrow)\"\n            >\n              <svg className=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M9 5l7 7-7 7\" />\n              </svg>\n            </button>\n          )}\n        </div>\n      )}\n\n      {/* All Guests Modal */}\n      {activeModal === 'guests' && (\n        <div\n          role=\"dialog\"\n          aria-label=\"All guest photos\"\n          aria-modal=\"true\"\n          className=\"fixed inset-0 z-50 bg-stone-900/95 backdrop-blur-xs overflow-y-auto\"\n          onClick={() => closeModal()}\n        >\n          <div className=\"min-h-screen p-4 md:p-8\">\n            <div className=\"max-w-6xl mx-auto\">\n              <div className=\"flex items-center justify-between mb-8 sticky top-0 bg-stone-900/80 backdrop-blur-xs py-4 -mx-4 px-4\">\n                <div>\n                  <h3 className=\"text-2xl font-display font-medium text-white\">Guest Photos</h3>\n                  <p className=\"text-stone-400 text-sm\">{guestPhotos.length} photos from our community</p>\n                </div>\n                <button\n                  ref={modalCloseRef}\n                  className=\"w-12 h-12 rounded-full bg-white/10 flex items-center justify-center\n                           text-white hover:bg-white/20 transition-colors cursor-pointer\"\n                  onClick={() => closeModal()}\n                  aria-label=\"Close guest photos gallery (Escape)\"\n                >\n                  <svg className=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                    <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={1.5} d=\"M6 18L18 6M6 6l12 12\" />\n                  </svg>\n                </button>\n              </div>\n              <div\n                className=\"grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-3\"\n                onClick={(e) => e.stopPropagation()}\n              >\n                {guestPhotos.map((photo, index) => (\n                  <div\n                    key={index}\n                    role=\"button\"\n                    tabIndex={0}\n                    aria-label={`View guest photo ${index + 1}`}\n                    className=\"relative aspect-square rounded-xl overflow-hidden cursor-pointer group\n                             focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700\"\n                    {...handleActivate(() => {\n                      closeModal();\n                      openLightbox(photo.src, guestPhotos.map(p => p.src));\n                    })}\n                  >\n                    <Image\n                      src={photo.src}\n                      alt={photo.alt}\n                      fill\n                      sizes=\"(max-width: 768px) 50vw, (max-width: 1024px) 25vw, 20vw\"\n                      className=\"object-cover transition-transform duration-300 group-hover:scale-110\"\n                    />\n                    <div className=\"absolute inset-0 bg-stone-900/0 group-hover:bg-stone-900/30 transition-colors\" />\n                  </div>\n                ))}\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n    </section>\n  );\n}\n","numLines":461,"startLine":1,"totalLines":461}}}
{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01HG4xaxuugBRMXqKN2EY3rZ","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"Great! Now I understand the current state. The code already has:\n\n1. CSS in globals.css (lines 151-230) that uses `@supports (selector(::scroll-button(*)))` to define carousel styling for native scroll-driven carousels\n2. Gallery.tsx uses the `carousel-scroll-container` class on line 186\n3. The ScrollSection component has manual scroll buttons that use JavaScript\n\nThe problem is that the CSS is already defined, but it's not being fully utilized. The acceptance criteria require:\n1. Gallery carousel uses scroll-snap CSS with ::scroll-button() for prev/next controls\n2. ::scroll-marker group provides keyboard-accessible dot indicators\n3. Fallback for non-supporting browsers degrades to scrollable overflow without JS errors\n4. @supports query wraps the new pseudo-element declarations\n5. Lighthouse reports no layout shift (CLS=0) from carousel on load\n\nLooking at the current implementation:\n- The CSS is defined with @supports\n- The Gallery.tsx already applies the carousel-scroll-container class\n- But the JS buttons (in ScrollSection) are still manually controlling the carousel\n\nThe story is to implement the native CSS scroll-driven carousel using ::scroll-button() and ::scroll-marker. These are Chrome 135+ features that provide automatic ARIA button roles and keyboard handling.\n\nHowever, there's an important issue: the pseudo-elements `::scroll-button()` and `::scroll-marker` are not standard CSS yet. Let me verify if this is the actual spec or if the story description is aspirational.\n\nLooking at the technical notes:\n- \"Chrome 135+ required; use @supports (selector(::scroll-button(*))) guard\"\n- Reference: https://developer.chrome.com/blog/carousels-with-css\n- Companion spec: https://drafts.csswg.org/css-overflow-5/#scroll-marker-group\n\nThis looks like it might be a proposed or future feature. \n\nThe CSS already defines these pseudo-elements with styling rules for `::scroll-button(prev)`, `::scroll-button(next)`, `::scroll-marker`, and `::scroll-marker-item` states. The @supports guard checks for selector support, but I need to verify whether the current browser environment actually recognizes these pseudo-elements or if they're placeholder declarations waiting for browser implementation.\n\nLooking at ScrollSection in Gallery.tsx, the manual JavaScript buttons are calling the `scroll()` function directly rather than relying on the native pseudo-element controls. The goal seems to be removing those manual buttons and letting the CSS-based navigation handle carousel movement instead, with appropriate fallbacks for browsers that don't support the feature yet.\n\nThis appears to be preparation for a future CSS feature that Chrome 135+ will introduce, so the implementation needs to gracefully degrade when the pseudo-elements aren't available. is passing. Looking at the acceptance criteria, I need to verify the implementation covers each one. AC1 requires the gallery to use scroll-snap CSS with ::scroll-button() for controls—currently the CSS is defined but Gallery.tsx still has manual JS buttons. AC2 needs ::scroll-marker groups for keyboard-accessible indicators, though the CSS styles exist without corresponding HTML elements. AC3 expects graceful degradation for unsupporting browsers via the @supports fallback, which is already in place. I should map out what changes are needed to fully satisfy each criterion before proceeding.","signature":""}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":11172,"cache_read_input_tokens":69592,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":11172},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"650472e5-a1e2-490b-836b-3f33e6c52d9d","uuid":"4430773b-48a3-4cb8-b31d-375278f6faf7"}
