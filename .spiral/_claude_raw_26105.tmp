{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PVhtYHNBeswZsGcyrDm7HJ","type":"tool_result","content":"1\t@import 'tailwindcss';\n2\t\n3\t@plugin \"@tailwindcss/typography\";\n4\t\n5\t/* ============================================================\n6\t   CSS @property — Type-safe, animatable design tokens (US-233)\n7\t   Registered custom properties can be interpolated by the browser\n8\t   because their syntax is known (angle, percentage, etc.).\n9\t   Browsers without @property support treat these as untyped\n10\t   custom properties — static fallback values still render correctly,\n11\t   only the animation is lost (progressive enhancement).\n12\t   Chrome 85+, Firefox 128+, Safari 17.2+.\n13\t   ============================================================ */\n14\t@property --gradient-angle {\n15\t  syntax: \"<angle>\";\n16\t  inherits: false;\n17\t  initial-value: 135deg;\n18\t}\n19\t\n20\t@property --divider-progress {\n21\t  syntax: \"<percentage>\";\n22\t  inherits: false;\n23\t  initial-value: 50%;\n24\t}\n25\t\n26\t@theme {\n27\t  --color-primary-50: #faf8f5;\n28\t  --color-primary-100: #f5f0e8;\n29\t  --color-primary-200: #e8ddd0;\n30\t  --color-primary-300: #d4c4ad;\n31\t  --color-primary-400: #bda685;\n32\t  --color-primary-500: #a68b64;\n33\t  --color-primary-600: #8b7355;\n34\t  --color-primary-700: #715d47;\n35\t  --color-primary-800: #5c4c3c;\n36\t  --color-primary-900: #4a3f33;\n37\t\n38\t  --color-accent-50: #fdf8f6;\n39\t  --color-accent-100: #f9ede8;\n40\t  --color-accent-200: #f4dcd3;\n41\t  --color-accent-300: #ecc4b5;\n42\t  --color-accent-400: #e0a48d;\n43\t  --color-accent-500: #d4846a;\n44\t  --color-accent-600: #c26a4f;\n45\t  --color-accent-700: #a25540;\n46\t  --color-accent-800: #864738;\n47\t  --color-accent-900: #6e3d31;\n48\t\n49\t  --color-sand-50: #fafaf9;\n50\t  --color-sand-100: #f5f5f4;\n51\t  --color-sand-200: #e7e5e4;\n52\t  --color-sand-300: #d6d3d1;\n53\t  --color-sand-400: #a8a29e;\n54\t  --color-sand-500: #78716c;\n55\t  --color-sand-600: #57534e;\n56\t  --color-sand-700: #44403c;\n57\t  --color-sand-800: #292524;\n58\t  --color-sand-900: #1c1917;\n59\t\n60\t  --font-sans: var(--font-inter), system-ui, sans-serif;\n61\t  --font-display: var(--font-playfair), Georgia, serif;\n62\t\n63\t  --text-2xs: 0.65rem;\n64\t  --text-2xs--line-height: 1rem;\n65\t\n66\t  --tracking-widest: 0.2em;\n67\t\n68\t  --animate-fade-in: fadeIn 0.6s ease-out forwards;\n69\t  --animate-slide-up: slideUp 0.6s ease-out forwards;\n70\t  --animate-scale-in: scaleIn 0.4s ease-out forwards;\n71\t\n72\t  --background-image-gradient-radial: radial-gradient(var(--tw-gradient-stops));\n73\t  --background-image-noise: url('/images/noise.png');\n74\t\n75\t  @keyframes fadeIn {\n76\t    0% {\n77\t      opacity: 0;\n78\t    }\n79\t    100% {\n80\t      opacity: 1;\n81\t    }\n82\t  }\n83\t  @keyframes slideUp {\n84\t    0% {\n85\t      opacity: 0;\n86\t      transform: translateY(20px);\n87\t    }\n88\t    100% {\n89\t      opacity: 1;\n90\t      transform: translateY(0);\n91\t    }\n92\t  }\n93\t  @keyframes scaleIn {\n94\t    0% {\n95\t      opacity: 0;\n96\t      transform: scale(0.95);\n97\t    }\n98\t    100% {\n99\t      opacity: 1;\n100\t      transform: scale(1);\n101\t    }\n102\t  }\n103\t}\n104\t\n105\t/*\n106\t  The default border color has changed to `currentcolor` in Tailwind CSS v4,\n107\t  so we've added these compatibility styles to make sure everything still\n108\t  looks the same as it did with Tailwind CSS v3.\n109\t\n110\t  If we ever want to remove these styles, we need to add an explicit border\n111\t  color utility to any element that depends on these defaults.\n112\t*/\n113\t@layer base {\n114\t  *,\n115\t  ::after,\n116\t  ::before,\n117\t  ::backdrop,\n118\t  ::file-selector-button {\n119\t    border-color: var(--color-gray-200, currentcolor);\n120\t  }\n121\t}\n122\t\n123\t@utility btn-primary {\n124\t  /* Primary Button - Warm, sophisticated */\n125\t  @apply bg-stone-700 hover:bg-stone-800 text-white font-medium\n126\t           py-3.5 px-8 rounded-full transition-all duration-300\n127\t           shadow-xs hover:shadow-md cursor-pointer\n128\t           tracking-wide text-sm uppercase\n129\t           focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700\n130\t           dark:bg-stone-200 dark:text-stone-900 dark:hover:bg-stone-100\n131\t           dark:focus-visible:outline-amber-400;\n132\t}\n133\t\n134\t@utility btn-secondary {\n135\t  /* Secondary Button - Minimal outline */\n136\t  @apply bg-transparent hover:bg-stone-100 text-stone-700\n137\t           font-medium py-3.5 px-8 rounded-full\n138\t           border border-stone-500 hover:border-stone-600\n139\t           transition-all duration-300 cursor-pointer\n140\t           tracking-wide text-sm uppercase\n141\t           focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700\n142\t           dark:text-stone-300 dark:border-stone-600 dark:hover:bg-stone-800 dark:hover:border-stone-500\n143\t           dark:focus-visible:outline-amber-400;\n144\t}\n145\t\n146\t@utility section-padding {\n147\t  /* Section spacing - More breathing room */\n148\t  @apply py-20 md:py-28 lg:py-32 px-6 md:px-8;\n149\t}\n150\t\n151\t/* ============================================================\n152\t   CSS Native Scroll-Driven Carousel (US-187)\n153\t   Implements scroll-snap carousel with graceful degradation.\n154\t   Future: Chrome 135+ may support ::scroll-button() and\n155\t   ::scroll-marker pseudo-elements for automatic controls.\n156\t   Currently uses scroll-snap CSS for fallback browsers.\n157\t   Ensures CLS=0 via fixed aspect-ratio on carousel items.\n158\t   Reference: https://developer.chrome.com/blog/carousels-with-css\n159\t   Spec: https://drafts.csswg.org/css-overflow-5/#scroll-marker-group\n160\t   ============================================================ */\n161\t\n162\t/* Scroll-snap carousel with hidden scrollbar (all browsers) */\n163\t.carousel-scroll-container {\n164\t  scroll-snap-type: x mandatory;\n165\t  overflow-x: auto;\n166\t  scrollbar-width: none;\n167\t  -ms-overflow-style: none;\n168\t  scroll-behavior: smooth;\n169\t}\n170\t\n171\t.carousel-scroll-container::-webkit-scrollbar {\n172\t  display: none;\n173\t}\n174\t\n175\t.carousel-scroll-container > * {\n176\t  scroll-snap-align: start;\n177\t  scroll-snap-stop: always;\n178\t  flex-shrink: 0;\n179\t}\n180\t\n181\t@utility container-custom {\n182\t  /* Container */\n183\t  @apply max-w-6xl mx-auto;\n184\t}\n185\t\n186\t@utility section-label {\n187\t  /* Section label - Elegant uppercase */\n188\t  @apply text-xs font-medium tracking-widest uppercase text-amber-700 mb-4 dark:text-amber-400;\n189\t}\n190\t\n191\t@utility section-heading {\n192\t  /* Section heading - Serif display font (uses theme --font-display for next/font metric-adjusted fallback) */\n193\t  @apply text-3xl md:text-4xl lg:text-5xl font-medium text-stone-900\n194\t           leading-tight tracking-tight dark:text-stone-100;\n195\t  font-family: var(--font-display);\n196\t}\n197\t\n198\t@utility body-text {\n199\t  /* Body text */\n200\t  @apply text-stone-600 leading-relaxed dark:text-stone-400;\n201\t}\n202\t\n203\t@utility card {\n204\t  /* Card with subtle hover */\n205\t  @apply bg-white rounded-2xl p-6 md:p-8\n206\t           shadow-xs hover:shadow-md transition-shadow duration-300\n207\t           border border-stone-100\n208\t           dark:bg-stone-800 dark:border-stone-700;\n209\t}\n210\t\n211\t@utility image-frame {\n212\t  /* Image container with elegant corners */\n213\t  @apply rounded-2xl overflow-hidden shadow-lg;\n214\t}\n215\t\n216\t@utility divider {\n217\t  /* Divider — uses @property --divider-progress for animatable gradient midpoint */\n218\t  height: 1px;\n219\t  background: linear-gradient(\n220\t    to right,\n221\t    transparent,\n222\t    var(--color-stone-200, #e7e5e4) var(--divider-progress, 50%),\n223\t    transparent\n224\t  );\n225\t}\n226\t\n227\t@media (prefers-color-scheme: dark) {\n228\t  .divider {\n229\t    background: linear-gradient(\n230\t      to right,\n231\t      transparent,\n232\t      var(--color-stone-700, #44403c) var(--divider-progress, 50%),\n233\t      transparent\n234\t    );\n235\t  }\n236\t}\n237\t\n238\t@utility icon-box {\n239\t  /* Feature icon container */\n240\t  @apply w-12 h-12 rounded-xl bg-amber-50 flex items-center justify-center\n241\t           text-amber-700 dark:bg-amber-900/30 dark:text-amber-400;\n242\t}\n243\t\n244\t@utility font-display {\n245\t  /* Display font utility — uses theme variable for next/font metric-adjusted fallback */\n246\t  font-family: var(--font-display);\n247\t}\n248\t\n249\t@utility text-gradient {\n250\t  /* Text gradient — uses @property --gradient-angle for animatable direction */\n251\t  background: linear-gradient(var(--gradient-angle, 135deg), #b45309, #ea580c);\n252\t  -webkit-background-clip: text;\n253\t  -webkit-text-fill-color: transparent;\n254\t  background-clip: text;\n255\t  color: transparent;\n256\t}\n257\t\n258\t@utility text-gradient-shimmer {\n259\t  /* Animated shimmer variant — rotates gradient angle via @property token */\n260\t  background: linear-gradient(var(--gradient-angle, 135deg), #b45309, #ea580c, #b45309);\n261\t  -webkit-background-clip: text;\n262\t  -webkit-text-fill-color: transparent;\n263\t  background-clip: text;\n264\t  color: transparent;\n265\t  animation: gradient-shimmer 4s ease-in-out infinite;\n266\t}\n267\t\n268\t@utility image-zoom {\n269\t  /* Smooth image zoom on hover and focus (WCAG 2.1 SC 1.4.13 parity) */\n270\t  @apply transition-transform duration-700 ease-out;\n271\t\n272\t  .group:hover &,\n273\t  .group:focus-within & {\n274\t    @apply scale-105;\n275\t  }\n276\t}\n277\t\n278\t@utility delay-100 {\n279\t  /* Fade in animation delays */\n280\t  animation-delay: 100ms;\n281\t}\n282\t\n283\t@utility delay-200 {\n284\t  animation-delay: 200ms;\n285\t}\n286\t\n287\t@utility delay-300 {\n288\t  animation-delay: 300ms;\n289\t}\n290\t\n291\t@utility delay-400 {\n292\t  animation-delay: 400ms;\n293\t}\n294\t\n295\t@utility scrollbar-hide {\n296\t  /* Hide scrollbar for horizontal scroll sections */\n297\t  -ms-overflow-style: none;\n298\t  scrollbar-width: none;\n299\t\n300\t  &::-webkit-scrollbar {\n301\t    display: none;\n302\t  }\n303\t}\n304\t\n305\t/* CSS Container Query utilities — US-219\n306\t   @supports guard ensures older browsers without CQ support silently ignore\n307\t   container-type and fall back to Tailwind viewport breakpoints (sm:, md:, lg:).\n308\t   Container query units (cqi, cqw) are used here for adaptive label sizing. */\n309\t@supports (container-type: inline-size) {\n310\t  .card-label-cq {\n311\t    /* cqi = 1% of container inline (width) — scales label relative to card width */\n312\t    font-size: clamp(0.75rem, 4.5cqi, 0.875rem);\n313\t    line-height: 1.4;\n314\t  }\n315\t}\n316\t\n317\t@layer base {\n318\t  html {\n319\t    scroll-behavior: smooth;\n320\t    overflow-x: hidden; /* WCAG 2.2 SC 1.4.4 — prevent horizontal scrollbar at 200% zoom */\n321\t  }\n322\t\n323\t  /* Offset sticky header (64px) when scrolling to heading anchors */\n324\t  h2,\n325\t  h3,\n326\t  section[id] {\n327\t    scroll-margin-top: 5rem; /* 80px = 64px header + 16px breathing room */\n328\t  }\n329\t\n330\t  /* US-204: text-wrap: balance prevents awkward single-word orphans on headings.\n331\t     Progressive enhancement — unsupported browsers silently fall back to default wrap.\n332\t     Chrome 114+, Edge 114+, Firefox 121+, Safari 17.4+ */\n333\t  h1,\n334\t  h2,\n335\t  h3 {\n336\t    text-wrap: balance;\n337\t  }\n338\t\n339\t  /* US-204: text-wrap: pretty reduces orphan words in body paragraphs.\n340\t     Uses a lookahead algorithm to avoid lonely single words on the final line.\n341\t     Progressive enhancement — no visual change in unsupported browsers.\n342\t     Chrome 117+, Edge 117+ */\n343\t  p {\n344\t    text-wrap: pretty;\n345\t  }\n346\t\n347\t  /* WCAG 2.2 SC 2.4.11 — prevent MobileBookingBar from obscuring focused elements */\n348\t  @media (max-width: 767px) {\n349\t    html {\n350\t      scroll-padding-bottom: 4rem; /* matches ~64px MobileBookingBar height */\n351\t    }\n352\t  }\n353\t\n354\t  /* WCAG 2.2 SC 2.5.8 — Target Size Minimum: 24×24 CSS px for all interactive elements */\n355\t  /* Inline text links inside .prose are exempt per the inline-text exception */\n356\t  button,\n357\t  [role=\"button\"] {\n358\t    min-height: 1.5rem; /* 24px */\n359\t    min-width: 1.5rem; /* 24px */\n360\t  }\n361\t\n362\t  /* WCAG 2.2 SC 2.4.13 — Focus Appearance: 2px outline, ≥ 3:1 contrast */\n363\t  /* Uses CSS outline (not box-shadow) for Windows High Contrast Mode visibility */\n364\t  :focus-visible {\n365\t    outline: 2px solid var(--color-amber-700, #b45309);\n366\t    outline-offset: 2px;\n367\t  }\n368\t\n369\t  @media (prefers-color-scheme: dark) {\n370\t    :focus-visible {\n371\t      outline-color: var(--color-amber-400, #fbbf24);\n372\t    }\n373\t  }\n374\t\n375\t  body {\n376\t    @apply antialiased bg-stone-50 text-stone-800 dark:bg-stone-950 dark:text-stone-200;\n377\t    font-feature-settings: \"kern\" 1, \"liga\" 1;\n378\t  }\n379\t\n380\t  /* Elegant selection color */\n381\t  ::selection {\n382\t    background-color: #e8ddd0;\n383\t    color: #4a3f33;\n384\t  }\n385\t\n386\t  @media (prefers-color-scheme: dark) {\n387\t    ::selection {\n388\t      background-color: #5c4c3c;\n389\t      color: #f5f0e8;\n390\t    }\n391\t  }\n392\t}\n393\t\n394\t/* WCAG 2.1 SC 1.4.10 — Reflow: prose tables scroll horizontally instead of breaking page layout */\n395\t.prose table {\n396\t  display: block;\n397\t  overflow-x: auto;\n398\t  -webkit-overflow-scrolling: touch;\n399\t}\n400\t\n401\t/* WCAG 2.3.3 / WCAG 2.2.2 — Respect prefers-reduced-motion OS preference */\n402\t/* Technique C39: https://www.w3.org/WAI/WCAG22/Techniques/css/C39 */\n403\t@media (prefers-reduced-motion: reduce) {\n404\t  *, *::before, *::after {\n405\t    animation-duration: 0.01ms !important;\n406\t    animation-iteration-count: 1 !important;\n407\t    transition-duration: 0.01ms !important;\n408\t    scroll-behavior: auto !important;\n409\t  }\n410\t}\n411\t\n412\t/* ============================================================\n413\t   WCAG 2.1 SC 2.2.2 — In-page pause control\n414\t   Pauses all continuous animations when the user activates the\n415\t   PauseAnimationsButton. This is separate from prefers-reduced-motion\n416\t   which only responds to the OS-level preference.\n417\t   ============================================================ */\n418\thtml.animations-paused *,\n419\thtml.animations-paused *::before,\n420\thtml.animations-paused *::after {\n421\t  animation-play-state: paused !important;\n422\t}\n423\t\n424\t/* ============================================================\n425\t   Forced Colors (Windows High Contrast Mode)\n426\t   Ensures all custom-styled interactive elements remain visible\n427\t   when the OS overrides author colors.\n428\t   ============================================================ */\n429\t@media (forced-colors: active) {\n430\t  /* Primary buttons: add explicit border so they remain distinguishable */\n431\t  .btn-primary {\n432\t    border: 2px solid ButtonText;\n433\t    background: ButtonFace;\n434\t    color: ButtonText;\n435\t    forced-color-adjust: none;\n436\t  }\n437\t\n438\t  .btn-primary:hover {\n439\t    background: Highlight;\n440\t    color: HighlightText;\n441\t    border-color: Highlight;\n442\t  }\n443\t\n444\t  /* Secondary buttons: ensure border stays visible */\n445\t  .btn-secondary {\n446\t    border: 2px solid ButtonText;\n447\t    color: ButtonText;\n448\t  }\n449\t\n450\t  .btn-secondary:hover {\n451\t    background: Highlight;\n452\t    color: HighlightText;\n453\t    border-color: Highlight;\n454\t  }\n455\t\n456\t  /* Cards: ensure visible boundary */\n457\t  .card {\n458\t    border: 1px solid CanvasText;\n459\t  }\n460\t\n461\t  /* Icon boxes: add border for visibility without background */\n462\t  .icon-box {\n463\t    border: 1px solid CanvasText;\n464\t  }\n465\t\n466\t  /* Badges (category pills, status indicators): add border so they don't disappear */\n467\t  [class*=\"rounded-full\"][class*=\"bg-amber\"] {\n468\t    border: 1px solid CanvasText;\n469\t    forced-color-adjust: none;\n470\t  }\n471\t\n472\t  /* Focus indicators: ensure outline uses system highlight color */\n473\t  :focus-visible {\n474\t    outline-color: Highlight;\n475\t  }\n476\t\n477\t  /* Icon-only buttons (close, nav arrows): add border for visibility */\n478\t  button:has(> svg:only-child),\n479\t  [role=\"button\"]:has(> svg:only-child) {\n480\t    border: 1px solid ButtonText;\n481\t  }\n482\t\n483\t  /* Dividers: ensure visible in forced-colors */\n484\t  .divider {\n485\t    background: CanvasText;\n486\t  }\n487\t\n488\t  /* Form inputs and textareas: explicit border */\n489\t  input,\n490\t  textarea,\n491\t  select {\n492\t    border: 1px solid ButtonText;\n493\t  }\n494\t\n495\t  /* Links: use system link color */\n496\t  a {\n497\t    color: LinkText;\n498\t  }\n499\t}\n500\t\n501\t/* ============================================================\n502\t   Increased Contrast (macOS \"Increase contrast\" / Windows)\n503\t   Strengthens borders and text contrast for users who opted in.\n504\t   ============================================================ */\n505\t@media (prefers-contrast: more) {\n506\t  /* Form inputs: thicker, darker borders */\n507\t  input,\n508\t  textarea,\n509\t  select {\n510\t    border-width: 2px;\n511\t    border-color: var(--color-stone-700, #44403c);\n512\t  }\n513\t\n514\t  /* Cards: stronger border for visual separation */\n515\t  .card {\n516\t    border-width: 2px;\n517\t    border-color: var(--color-stone-400, #a8a29e);\n518\t  }\n519\t\n520\t  @media (prefers-color-scheme: dark) {\n521\t    .card {\n522\t      border-color: var(--color-stone-500, #78716c);\n523\t    }\n524\t  }\n525\t\n526\t  /* Dividers: more visible */\n527\t  .divider {\n528\t    height: 2px;\n529\t    opacity: 1;\n530\t  }\n531\t\n532\t  /* Badges: stronger borders */\n533\t  [class*=\"rounded-full\"][class*=\"bg-amber\"] {\n534\t    border: 1px solid var(--color-amber-700, #b45309);\n535\t  }\n536\t\n537\t  /* Icon boxes: add border */\n538\t  .icon-box {\n539\t    border: 1px solid var(--color-amber-600, #d97706);\n540\t  }\n541\t\n542\t  /* Section labels and small text: slightly bolder */\n543\t  .section-label {\n544\t    font-weight: 600;\n545\t  }\n546\t\n547\t  /* Body text: increase contrast */\n548\t  .body-text {\n549\t    color: var(--color-stone-700, #44403c);\n550\t  }\n551\t\n552\t  @media (prefers-color-scheme: dark) {\n553\t    .body-text {\n554\t      color: var(--color-stone-300, #d6d3d1);\n555\t    }\n556\t  }\n557\t}\n558\t\n559\t/* ============================================================\n560\t   @property-powered keyframe animations (US-233)\n561\t   These animations target @property-registered custom properties,\n562\t   enabling smooth interpolation that would otherwise be impossible\n563\t   with untyped CSS variables.\n564\t   ============================================================ */\n565\t\n566\t/* Rotates gradient angle 135° → 225° → 135° for a subtle shimmer */\n567\t@keyframes gradient-shimmer {\n568\t  0%   { --gradient-angle: 135deg; }\n569\t  50%  { --gradient-angle: 225deg; }\n570\t  100% { --gradient-angle: 135deg; }\n571\t}\n572\t\n573\t/* Sweeps divider gradient midpoint from left to center to right */\n574\t@keyframes divider-sweep {\n575\t  0%   { --divider-progress: 20%; }\n576\t  50%  { --divider-progress: 80%; }\n577\t  100% { --divider-progress: 50%; }\n578\t}\n579\t\n580\t/* Utility class to apply the sweep animation to a divider */\n581\t.divider-animated {\n582\t  animation: divider-sweep 2s ease-in-out forwards;\n583\t}\n584\t\n585\t/* Respect reduced motion */\n586\t@media (prefers-reduced-motion: reduce) {\n587\t  .text-gradient-shimmer {\n588\t    animation: none;\n589\t  }\n590\t  .divider-animated {\n591\t    animation: none;\n592\t  }\n593\t}\n594\t\n595\t/* ============================================================\n596\t   CSS @starting-style entry animations (US-143)\n597\t   Declarative fade/slide-in for elements entering the DOM.\n598\t   Baseline August 2024: Chrome 117+, Firefox 129+, Safari 17.4+.\n599\t   Uses only opacity + transform (GPU compositor thread, no layout).\n600\t   ============================================================ */\n601\t.entry-fade {\n602\t  opacity: 1;\n603\t  transition: opacity 0.3s ease-out;\n604\t  @starting-style { opacity: 0; }\n605\t}\n606\t\n607\t.entry-zoom-in {\n608\t  opacity: 1;\n609\t  transform: scale(1);\n610\t  transition: opacity 0.25s ease-out, transform 0.25s ease-out;\n611\t  @starting-style { opacity: 0; transform: scale(0.95); }\n612\t}\n613\t\n614\t.entry-fade-up {\n615\t  opacity: 1;\n616\t  transform: translateY(0);\n617\t  transition: opacity 0.3s ease-out, transform 0.3s ease-out;\n618\t  @starting-style { opacity: 0; transform: translateY(1rem); }\n619\t}\n620\t\n621\t@media (prefers-reduced-motion: reduce) {\n622\t  .entry-fade, .entry-zoom-in, .entry-fade-up { transition: none; }\n623\t}\n624\t\n625\t/* ============================================================\n626\t   Scroll-driven section reveal animations (US-217)\n627\t   Uses animation-timeline: view() for compositor-thread reveals.\n628\t   Only opacity + transform — no layout shifts, no main-thread paint.\n629\t   Gated behind @supports so unsupporting browsers show content normally.\n630\t   ============================================================ */\n631\t@supports (animation-timeline: view()) {\n632\t  @media (prefers-reduced-motion: no-preference) {\n633\t    @keyframes scroll-fade-in-up {\n634\t      from {\n635\t        opacity: 0;\n636\t        transform: translateY(1.5rem);\n637\t      }\n638\t      to {\n639\t        opacity: 1;\n640\t        transform: translateY(0);\n641\t      }\n642\t    }\n643\t\n644\t    .scroll-reveal {\n645\t      animation: scroll-fade-in-up linear both;\n646\t      animation-timeline: view();\n647\t      animation-range: entry 0% entry 30%;\n648\t    }\n649\t  }\n650\t}\n651\t\n652\t/* ============================================================\n653\t   Cross-document View Transitions (US-197)\n654\t   Opts same-origin hard navigations into a smooth cross-fade\n655\t   via CSS View Transitions Level 2 (@view-transition at-rule).\n656\t   Chrome 126+, Edge 126+, Firefox 144+.\n657\t   Safari degrades gracefully — no transition, no error.\n658\t   Soft navigations (Next.js <Link>) use the JS API separately;\n659\t   this covers direct URL entry, back/forward, and external links.\n660\t   ============================================================ */\n661\t@view-transition {\n662\t  navigation: auto;\n663\t}\n664\t\n665\t::view-transition-old(root) {\n666\t  animation: 200ms ease-out both vt-fade-out;\n667\t}\n668\t\n669\t::view-transition-new(root) {\n670\t  animation: 200ms ease-out both vt-fade-in;\n671\t}\n672\t\n673\t@keyframes vt-fade-out {\n674\t  from { opacity: 1; }\n675\t  to { opacity: 0; }\n676\t}\n677\t\n678\t@keyframes vt-fade-in {\n679\t  from { opacity: 0; }\n680\t  to { opacity: 1; }\n681\t}\n682\t\n683\t/* Disable view transitions when user prefers reduced motion */\n684\t@media (prefers-reduced-motion: reduce) {\n685\t  @view-transition {\n686\t    navigation: none;\n687\t  }\n688\t}\n689\t\n690\t/* ============================================================\n691\t   Native Popover + CSS Anchor Positioning (US-144)\n692\t   Uses HTML popover attribute for keyboard/focus management\n693\t   and CSS anchor-name / position-anchor for tethering.\n694\t   @supports fallback for browsers without anchor positioning.\n695\t   Chrome 125+, Edge 125+. Safari/Firefox: absolute fallback.\n696\t   ============================================================ */\n697\t.info-popover-anchor {\n698\t  position: relative;\n699\t  display: inline-flex;\n700\t}\n701\t\n702\t.info-popover-trigger {\n703\t  all: unset;\n704\t  display: inline-flex;\n705\t  cursor: pointer;\n706\t}\n707\t\n708\t.info-popover {\n709\t  margin: 0;\n710\t  border: 1px solid var(--color-stone-200, #e7e5e4);\n711\t  border-radius: 0.75rem;\n712\t  padding: 0.5rem 0.75rem;\n713\t  background: white;\n714\t  color: var(--color-stone-700, #44403c);\n715\t  font-size: 0.8125rem;\n716\t  line-height: 1.4;\n717\t  max-width: 15rem;\n718\t  box-shadow: 0 4px 12px rgb(0 0 0 / 0.08);\n719\t  /* Entry animation */\n720\t  opacity: 1;\n721\t  transition: opacity 0.15s ease-out, transform 0.15s ease-out;\n722\t}\n723\t\n724\t.info-popover:not(:popover-open) {\n725\t  display: none;\n726\t}\n727\t\n728\t/* Anchor positioning (Chrome 125+) */\n729\t@supports (position-anchor: --x) {\n730\t  .info-popover {\n731\t    position: fixed;\n732\t    position-area: block-end span-inline-end;\n733\t    margin-top: 0.375rem;\n734\t  }\n735\t}\n736\t\n737\t/* Fallback for browsers without anchor positioning */\n738\t@supports not (position-anchor: --x) {\n739\t  .info-popover {\n740\t    position: absolute;\n741\t    top: calc(100% + 0.375rem);\n742\t    left: 50%;\n743\t    transform: translateX(-50%);\n744\t  }\n745\t}\n746\t\n747\t@media (prefers-color-scheme: dark) {\n748\t  .info-popover {\n749\t    background: var(--color-stone-800, #292524);\n750\t    color: var(--color-stone-200, #e7e5e4);\n751\t    border-color: var(--color-stone-700, #44403c);\n752\t    box-shadow: 0 4px 12px rgb(0 0 0 / 0.3);\n753\t  }\n754\t}\n755\t\n756\t/* Forced colors: ensure popover border is visible */\n757\t@media (forced-colors: active) {\n758\t  .info-popover {\n759\t    border: 2px solid CanvasText;\n760\t  }\n761\t}\n762\t\n763\t/* ============================================================\n764\t   Styled Native Select with appearance: base-select (US-188)\n765\t   Chrome 130+, Safari 18.3+, Firefox future.\n766\t   @supports fallback for browsers without appearance: base-select.\n767\t   Retains built-in accessibility (keyboard, screen reader).\n768\t   Reference: https://developer.chrome.com/blog/a-customizable-select\n769\t   ============================================================ */\n770\t@supports (appearance: base-select) {\n771\t  select.select-base {\n772\t    appearance: base-select;\n773\t    border: 1px solid var(--color-stone-500, #78716c);\n774\t    border-radius: 0.75rem;\n775\t    background-color: var(--color-stone-50, #fafaf9);\n776\t    color: var(--color-stone-900, #1c1917);\n777\t    padding: 0.75rem 1rem;\n778\t    font-size: 0.875rem;\n779\t    line-height: 1.5;\n780\t    font-family: inherit;\n781\t    cursor: pointer;\n782\t    transition: border-color 0.2s ease-out, background-color 0.2s ease-out;\n783\t  }\n784\t\n785\t  select.select-base:hover {\n786\t    border-color: var(--color-stone-600, #57534e);\n787\t  }\n788\t\n789\t  select.select-base:focus-visible {\n790\t    outline: 2px solid var(--color-amber-700, #b45309);\n791\t    outline-offset: 2px;\n792\t  }\n793\t\n794\t  @media (prefers-color-scheme: dark) {\n795\t    select.select-base {\n796\t      background-color: var(--color-stone-800, #292524);\n797\t      color: var(--color-stone-100, #f5f5f4);\n798\t      border-color: var(--color-stone-600, #57534e);\n799\t    }\n800\t\n801\t    select.select-base:hover {\n802\t      border-color: var(--color-stone-500, #78716c);\n803\t    }\n804\t\n805\t    select.select-base:focus-visible {\n806\t      outline-color: var(--color-amber-400, #fbbf24);\n807\t    }\n808\t  }\n809\t\n810\t  @media (prefers-contrast: more) {\n811\t    select.select-base {\n812\t      border-width: 2px;\n813\t      border-color: var(--color-stone-700, #44403c);\n814\t    }\n815\t\n816\t    @media (prefers-color-scheme: dark) {\n817\t      select.select-base {\n818\t        border-color: var(--color-stone-500, #78716c);\n819\t      }\n820\t    }\n821\t  }\n822\t\n823\t  @media (forced-colors: active) {\n824\t    select.select-base {\n825\t      border: 1px solid ButtonText;\n826\t      background-color: ButtonFace;\n827\t      color: ButtonText;\n828\t      forced-color-adjust: none;\n829\t    }\n830\t\n831\t    select.select-base:hover {\n832\t      background-color: Highlight;\n833\t      color: HighlightText;\n834\t    }\n835\t  }\n836\t}\n837\t\n838\t/* Custom scrollbar */\n839\t::-webkit-scrollbar {\n840\t  width: 8px;\n841\t}\n842\t\n843\t::-webkit-scrollbar-track {\n844\t  @apply bg-stone-100;\n845\t}\n846\t\n847\t::-webkit-scrollbar-thumb {\n848\t  @apply bg-stone-300 rounded-full;\n849\t}\n850\t\n851\t::-webkit-scrollbar-thumb:hover {\n852\t  @apply bg-stone-400;\n853\t}\n854\t\n855\t@media (prefers-color-scheme: dark) {\n856\t  ::-webkit-scrollbar-track {\n857\t    background-color: #1c1917;\n858\t  }\n859\t  ::-webkit-scrollbar-thumb {\n860\t    background-color: #57534e;\n861\t  }\n862\t  ::-webkit-scrollbar-thumb:hover {\n863\t    background-color: #78716c;\n864\t  }\n865\t}\n866\t\n867\t/* Print styles — booking confirmation and receipt pages */\n868\t@media print {\n869\t  nav,\n870\t  footer,\n871\t  .cookie-banner,\n872\t  .chat-widget,\n873\t  [data-chat-widget],\n874\t  .sticky-booking-bar,\n875\t  [data-cookie-banner] {\n876\t    display: none !important;\n877\t  }\n878\t\n879\t  * {\n880\t    color: #000 !important;\n881\t    background: transparent !important;\n882\t    box-shadow: none !important;\n883\t  }\n884\t\n885\t  body {\n886\t    font-size: 12pt;\n887\t  }\n888\t\n889\t  .booking-summary,\n890\t  [class*=\"booking-summary\"],\n891\t  [class*=\"confirmation\"] {\n892\t    page-break-inside: avoid;\n893\t  }\n894\t}\n895\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"cfc99e28-38cf-433d-90b6-b0ca5e1b4eef","uuid":"4e07eb1c-4d31-4d9a-93e9-0c6160604823","timestamp":"2026-04-14T05:44:41.892Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\app\\globals.css","content":"@import 'tailwindcss';\n\n@plugin \"@tailwindcss/typography\";\n\n/* ============================================================\n   CSS @property — Type-safe, animatable design tokens (US-233)\n   Registered custom properties can be interpolated by the browser\n   because their syntax is known (angle, percentage, etc.).\n   Browsers without @property support treat these as untyped\n   custom properties — static fallback values still render correctly,\n   only the animation is lost (progressive enhancement).\n   Chrome 85+, Firefox 128+, Safari 17.2+.\n   ============================================================ */\n@property --gradient-angle {\n  syntax: \"<angle>\";\n  inherits: false;\n  initial-value: 135deg;\n}\n\n@property --divider-progress {\n  syntax: \"<percentage>\";\n  inherits: false;\n  initial-value: 50%;\n}\n\n@theme {\n  --color-primary-50: #faf8f5;\n  --color-primary-100: #f5f0e8;\n  --color-primary-200: #e8ddd0;\n  --color-primary-300: #d4c4ad;\n  --color-primary-400: #bda685;\n  --color-primary-500: #a68b64;\n  --color-primary-600: #8b7355;\n  --color-primary-700: #715d47;\n  --color-primary-800: #5c4c3c;\n  --color-primary-900: #4a3f33;\n\n  --color-accent-50: #fdf8f6;\n  --color-accent-100: #f9ede8;\n  --color-accent-200: #f4dcd3;\n  --color-accent-300: #ecc4b5;\n  --color-accent-400: #e0a48d;\n  --color-accent-500: #d4846a;\n  --color-accent-600: #c26a4f;\n  --color-accent-700: #a25540;\n  --color-accent-800: #864738;\n  --color-accent-900: #6e3d31;\n\n  --color-sand-50: #fafaf9;\n  --color-sand-100: #f5f5f4;\n  --color-sand-200: #e7e5e4;\n  --color-sand-300: #d6d3d1;\n  --color-sand-400: #a8a29e;\n  --color-sand-500: #78716c;\n  --color-sand-600: #57534e;\n  --color-sand-700: #44403c;\n  --color-sand-800: #292524;\n  --color-sand-900: #1c1917;\n\n  --font-sans: var(--font-inter), system-ui, sans-serif;\n  --font-display: var(--font-playfair), Georgia, serif;\n\n  --text-2xs: 0.65rem;\n  --text-2xs--line-height: 1rem;\n\n  --tracking-widest: 0.2em;\n\n  --animate-fade-in: fadeIn 0.6s ease-out forwards;\n  --animate-slide-up: slideUp 0.6s ease-out forwards;\n  --animate-scale-in: scaleIn 0.4s ease-out forwards;\n\n  --background-image-gradient-radial: radial-gradient(var(--tw-gradient-stops));\n  --background-image-noise: url('/images/noise.png');\n\n  @keyframes fadeIn {\n    0% {\n      opacity: 0;\n    }\n    100% {\n      opacity: 1;\n    }\n  }\n  @keyframes slideUp {\n    0% {\n      opacity: 0;\n      transform: translateY(20px);\n    }\n    100% {\n      opacity: 1;\n      transform: translateY(0);\n    }\n  }\n  @keyframes scaleIn {\n    0% {\n      opacity: 0;\n      transform: scale(0.95);\n    }\n    100% {\n      opacity: 1;\n      transform: scale(1);\n    }\n  }\n}\n\n/*\n  The default border color has changed to `currentcolor` in Tailwind CSS v4,\n  so we've added these compatibility styles to make sure everything still\n  looks the same as it did with Tailwind CSS v3.\n\n  If we ever want to remove these styles, we need to add an explicit border\n  color utility to any element that depends on these defaults.\n*/\n@layer base {\n  *,\n  ::after,\n  ::before,\n  ::backdrop,\n  ::file-selector-button {\n    border-color: var(--color-gray-200, currentcolor);\n  }\n}\n\n@utility btn-primary {\n  /* Primary Button - Warm, sophisticated */\n  @apply bg-stone-700 hover:bg-stone-800 text-white font-medium\n           py-3.5 px-8 rounded-full transition-all duration-300\n           shadow-xs hover:shadow-md cursor-pointer\n           tracking-wide text-sm uppercase\n           focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700\n           dark:bg-stone-200 dark:text-stone-900 dark:hover:bg-stone-100\n           dark:focus-visible:outline-amber-400;\n}\n\n@utility btn-secondary {\n  /* Secondary Button - Minimal outline */\n  @apply bg-transparent hover:bg-stone-100 text-stone-700\n           font-medium py-3.5 px-8 rounded-full\n           border border-stone-500 hover:border-stone-600\n           transition-all duration-300 cursor-pointer\n           tracking-wide text-sm uppercase\n           focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700\n           dark:text-stone-300 dark:border-stone-600 dark:hover:bg-stone-800 dark:hover:border-stone-500\n           dark:focus-visible:outline-amber-400;\n}\n\n@utility section-padding {\n  /* Section spacing - More breathing room */\n  @apply py-20 md:py-28 lg:py-32 px-6 md:px-8;\n}\n\n/* ============================================================\n   CSS Native Scroll-Driven Carousel (US-187)\n   Implements scroll-snap carousel with graceful degradation.\n   Future: Chrome 135+ may support ::scroll-button() and\n   ::scroll-marker pseudo-elements for automatic controls.\n   Currently uses scroll-snap CSS for fallback browsers.\n   Ensures CLS=0 via fixed aspect-ratio on carousel items.\n   Reference: https://developer.chrome.com/blog/carousels-with-css\n   Spec: https://drafts.csswg.org/css-overflow-5/#scroll-marker-group\n   ============================================================ */\n\n/* Scroll-snap carousel with hidden scrollbar (all browsers) */\n.carousel-scroll-container {\n  scroll-snap-type: x mandatory;\n  overflow-x: auto;\n  scrollbar-width: none;\n  -ms-overflow-style: none;\n  scroll-behavior: smooth;\n}\n\n.carousel-scroll-container::-webkit-scrollbar {\n  display: none;\n}\n\n.carousel-scroll-container > * {\n  scroll-snap-align: start;\n  scroll-snap-stop: always;\n  flex-shrink: 0;\n}\n\n@utility container-custom {\n  /* Container */\n  @apply max-w-6xl mx-auto;\n}\n\n@utility section-label {\n  /* Section label - Elegant uppercase */\n  @apply text-xs font-medium tracking-widest uppercase text-amber-700 mb-4 dark:text-amber-400;\n}\n\n@utility section-heading {\n  /* Section heading - Serif display font (uses theme --font-display for next/font metric-adjusted fallback) */\n  @apply text-3xl md:text-4xl lg:text-5xl font-medium text-stone-900\n           leading-tight tracking-tight dark:text-stone-100;\n  font-family: var(--font-display);\n}\n\n@utility body-text {\n  /* Body text */\n  @apply text-stone-600 leading-relaxed dark:text-stone-400;\n}\n\n@utility card {\n  /* Card with subtle hover */\n  @apply bg-white rounded-2xl p-6 md:p-8\n           shadow-xs hover:shadow-md transition-shadow duration-300\n           border border-stone-100\n           dark:bg-stone-800 dark:border-stone-700;\n}\n\n@utility image-frame {\n  /* Image container with elegant corners */\n  @apply rounded-2xl overflow-hidden shadow-lg;\n}\n\n@utility divider {\n  /* Divider — uses @property --divider-progress for animatable gradient midpoint */\n  height: 1px;\n  background: linear-gradient(\n    to right,\n    transparent,\n    var(--color-stone-200, #e7e5e4) var(--divider-progress, 50%),\n    transparent\n  );\n}\n\n@media (prefers-color-scheme: dark) {\n  .divider {\n    background: linear-gradient(\n      to right,\n      transparent,\n      var(--color-stone-700, #44403c) var(--divider-progress, 50%),\n      transparent\n    );\n  }\n}\n\n@utility icon-box {\n  /* Feature icon container */\n  @apply w-12 h-12 rounded-xl bg-amber-50 flex items-center justify-center\n           text-amber-700 dark:bg-amber-900/30 dark:text-amber-400;\n}\n\n@utility font-display {\n  /* Display font utility — uses theme variable for next/font metric-adjusted fallback */\n  font-family: var(--font-display);\n}\n\n@utility text-gradient {\n  /* Text gradient — uses @property --gradient-angle for animatable direction */\n  background: linear-gradient(var(--gradient-angle, 135deg), #b45309, #ea580c);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n  color: transparent;\n}\n\n@utility text-gradient-shimmer {\n  /* Animated shimmer variant — rotates gradient angle via @property token */\n  background: linear-gradient(var(--gradient-angle, 135deg), #b45309, #ea580c, #b45309);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n  color: transparent;\n  animation: gradient-shimmer 4s ease-in-out infinite;\n}\n\n@utility image-zoom {\n  /* Smooth image zoom on hover and focus (WCAG 2.1 SC 1.4.13 parity) */\n  @apply transition-transform duration-700 ease-out;\n\n  .group:hover &,\n  .group:focus-within & {\n    @apply scale-105;\n  }\n}\n\n@utility delay-100 {\n  /* Fade in animation delays */\n  animation-delay: 100ms;\n}\n\n@utility delay-200 {\n  animation-delay: 200ms;\n}\n\n@utility delay-300 {\n  animation-delay: 300ms;\n}\n\n@utility delay-400 {\n  animation-delay: 400ms;\n}\n\n@utility scrollbar-hide {\n  /* Hide scrollbar for horizontal scroll sections */\n  -ms-overflow-style: none;\n  scrollbar-width: none;\n\n  &::-webkit-scrollbar {\n    display: none;\n  }\n}\n\n/* CSS Container Query utilities — US-219\n   @supports guard ensures older browsers without CQ support silently ignore\n   container-type and fall back to Tailwind viewport breakpoints (sm:, md:, lg:).\n   Container query units (cqi, cqw) are used here for adaptive label sizing. */\n@supports (container-type: inline-size) {\n  .card-label-cq {\n    /* cqi = 1% of container inline (width) — scales label relative to card width */\n    font-size: clamp(0.75rem, 4.5cqi, 0.875rem);\n    line-height: 1.4;\n  }\n}\n\n@layer base {\n  html {\n    scroll-behavior: smooth;\n    overflow-x: hidden; /* WCAG 2.2 SC 1.4.4 — prevent horizontal scrollbar at 200% zoom */\n  }\n\n  /* Offset sticky header (64px) when scrolling to heading anchors */\n  h2,\n  h3,\n  section[id] {\n    scroll-margin-top: 5rem; /* 80px = 64px header + 16px breathing room */\n  }\n\n  /* US-204: text-wrap: balance prevents awkward single-word orphans on headings.\n     Progressive enhancement — unsupported browsers silently fall back to default wrap.\n     Chrome 114+, Edge 114+, Firefox 121+, Safari 17.4+ */\n  h1,\n  h2,\n  h3 {\n    text-wrap: balance;\n  }\n\n  /* US-204: text-wrap: pretty reduces orphan words in body paragraphs.\n     Uses a lookahead algorithm to avoid lonely single words on the final line.\n     Progressive enhancement — no visual change in unsupported browsers.\n     Chrome 117+, Edge 117+ */\n  p {\n    text-wrap: pretty;\n  }\n\n  /* WCAG 2.2 SC 2.4.11 — prevent MobileBookingBar from obscuring focused elements */\n  @media (max-width: 767px) {\n    html {\n      scroll-padding-bottom: 4rem; /* matches ~64px MobileBookingBar height */\n    }\n  }\n\n  /* WCAG 2.2 SC 2.5.8 — Target Size Minimum: 24×24 CSS px for all interactive elements */\n  /* Inline text links inside .prose are exempt per the inline-text exception */\n  button,\n  [role=\"button\"] {\n    min-height: 1.5rem; /* 24px */\n    min-width: 1.5rem; /* 24px */\n  }\n\n  /* WCAG 2.2 SC 2.4.13 — Focus Appearance: 2px outline, ≥ 3:1 contrast */\n  /* Uses CSS outline (not box-shadow) for Windows High Contrast Mode visibility */\n  :focus-visible {\n    outline: 2px solid var(--color-amber-700, #b45309);\n    outline-offset: 2px;\n  }\n\n  @media (prefers-color-scheme: dark) {\n    :focus-visible {\n      outline-color: var(--color-amber-400, #fbbf24);\n    }\n  }\n\n  body {\n    @apply antialiased bg-stone-50 text-stone-800 dark:bg-stone-950 dark:text-stone-200;\n    font-feature-settings: \"kern\" 1, \"liga\" 1;\n  }\n\n  /* Elegant selection color */\n  ::selection {\n    background-color: #e8ddd0;\n    color: #4a3f33;\n  }\n\n  @media (prefers-color-scheme: dark) {\n    ::selection {\n      background-color: #5c4c3c;\n      color: #f5f0e8;\n    }\n  }\n}\n\n/* WCAG 2.1 SC 1.4.10 — Reflow: prose tables scroll horizontally instead of breaking page layout */\n.prose table {\n  display: block;\n  overflow-x: auto;\n  -webkit-overflow-scrolling: touch;\n}\n\n/* WCAG 2.3.3 / WCAG 2.2.2 — Respect prefers-reduced-motion OS preference */\n/* Technique C39: https://www.w3.org/WAI/WCAG22/Techniques/css/C39 */\n@media (prefers-reduced-motion: reduce) {\n  *, *::before, *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n    scroll-behavior: auto !important;\n  }\n}\n\n/* ============================================================\n   WCAG 2.1 SC 2.2.2 — In-page pause control\n   Pauses all continuous animations when the user activates the\n   PauseAnimationsButton. This is separate from prefers-reduced-motion\n   which only responds to the OS-level preference.\n   ============================================================ */\nhtml.animations-paused *,\nhtml.animations-paused *::before,\nhtml.animations-paused *::after {\n  animation-play-state: paused !important;\n}\n\n/* ============================================================\n   Forced Colors (Windows High Contrast Mode)\n   Ensures all custom-styled interactive elements remain visible\n   when the OS overrides author colors.\n   ============================================================ */\n@media (forced-colors: active) {\n  /* Primary buttons: add explicit border so they remain distinguishable */\n  .btn-primary {\n    border: 2px solid ButtonText;\n    background: ButtonFace;\n    color: ButtonText;\n    forced-color-adjust: none;\n  }\n\n  .btn-primary:hover {\n    background: Highlight;\n    color: HighlightText;\n    border-color: Highlight;\n  }\n\n  /* Secondary buttons: ensure border stays visible */\n  .btn-secondary {\n    border: 2px solid ButtonText;\n    color: ButtonText;\n  }\n\n  .btn-secondary:hover {\n    background: Highlight;\n    color: HighlightText;\n    border-color: Highlight;\n  }\n\n  /* Cards: ensure visible boundary */\n  .card {\n    border: 1px solid CanvasText;\n  }\n\n  /* Icon boxes: add border for visibility without background */\n  .icon-box {\n    border: 1px solid CanvasText;\n  }\n\n  /* Badges (category pills, status indicators): add border so they don't disappear */\n  [class*=\"rounded-full\"][class*=\"bg-amber\"] {\n    border: 1px solid CanvasText;\n    forced-color-adjust: none;\n  }\n\n  /* Focus indicators: ensure outline uses system highlight color */\n  :focus-visible {\n    outline-color: Highlight;\n  }\n\n  /* Icon-only buttons (close, nav arrows): add border for visibility */\n  button:has(> svg:only-child),\n  [role=\"button\"]:has(> svg:only-child) {\n    border: 1px solid ButtonText;\n  }\n\n  /* Dividers: ensure visible in forced-colors */\n  .divider {\n    background: CanvasText;\n  }\n\n  /* Form inputs and textareas: explicit border */\n  input,\n  textarea,\n  select {\n    border: 1px solid ButtonText;\n  }\n\n  /* Links: use system link color */\n  a {\n    color: LinkText;\n  }\n}\n\n/* ============================================================\n   Increased Contrast (macOS \"Increase contrast\" / Windows)\n   Strengthens borders and text contrast for users who opted in.\n   ============================================================ */\n@media (prefers-contrast: more) {\n  /* Form inputs: thicker, darker borders */\n  input,\n  textarea,\n  select {\n    border-width: 2px;\n    border-color: var(--color-stone-700, #44403c);\n  }\n\n  /* Cards: stronger border for visual separation */\n  .card {\n    border-width: 2px;\n    border-color: var(--color-stone-400, #a8a29e);\n  }\n\n  @media (prefers-color-scheme: dark) {\n    .card {\n      border-color: var(--color-stone-500, #78716c);\n    }\n  }\n\n  /* Dividers: more visible */\n  .divider {\n    height: 2px;\n    opacity: 1;\n  }\n\n  /* Badges: stronger borders */\n  [class*=\"rounded-full\"][class*=\"bg-amber\"] {\n    border: 1px solid var(--color-amber-700, #b45309);\n  }\n\n  /* Icon boxes: add border */\n  .icon-box {\n    border: 1px solid var(--color-amber-600, #d97706);\n  }\n\n  /* Section labels and small text: slightly bolder */\n  .section-label {\n    font-weight: 600;\n  }\n\n  /* Body text: increase contrast */\n  .body-text {\n    color: var(--color-stone-700, #44403c);\n  }\n\n  @media (prefers-color-scheme: dark) {\n    .body-text {\n      color: var(--color-stone-300, #d6d3d1);\n    }\n  }\n}\n\n/* ============================================================\n   @property-powered keyframe animations (US-233)\n   These animations target @property-registered custom properties,\n   enabling smooth interpolation that would otherwise be impossible\n   with untyped CSS variables.\n   ============================================================ */\n\n/* Rotates gradient angle 135° → 225° → 135° for a subtle shimmer */\n@keyframes gradient-shimmer {\n  0%   { --gradient-angle: 135deg; }\n  50%  { --gradient-angle: 225deg; }\n  100% { --gradient-angle: 135deg; }\n}\n\n/* Sweeps divider gradient midpoint from left to center to right */\n@keyframes divider-sweep {\n  0%   { --divider-progress: 20%; }\n  50%  { --divider-progress: 80%; }\n  100% { --divider-progress: 50%; }\n}\n\n/* Utility class to apply the sweep animation to a divider */\n.divider-animated {\n  animation: divider-sweep 2s ease-in-out forwards;\n}\n\n/* Respect reduced motion */\n@media (prefers-reduced-motion: reduce) {\n  .text-gradient-shimmer {\n    animation: none;\n  }\n  .divider-animated {\n    animation: none;\n  }\n}\n\n/* ============================================================\n   CSS @starting-style entry animations (US-143)\n   Declarative fade/slide-in for elements entering the DOM.\n   Baseline August 2024: Chrome 117+, Firefox 129+, Safari 17.4+.\n   Uses only opacity + transform (GPU compositor thread, no layout).\n   ============================================================ */\n.entry-fade {\n  opacity: 1;\n  transition: opacity 0.3s ease-out;\n  @starting-style { opacity: 0; }\n}\n\n.entry-zoom-in {\n  opacity: 1;\n  transform: scale(1);\n  transition: opacity 0.25s ease-out, transform 0.25s ease-out;\n  @starting-style { opacity: 0; transform: scale(0.95); }\n}\n\n.entry-fade-up {\n  opacity: 1;\n  transform: translateY(0);\n  transition: opacity 0.3s ease-out, transform 0.3s ease-out;\n  @starting-style { opacity: 0; transform: translateY(1rem); }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .entry-fade, .entry-zoom-in, .entry-fade-up { transition: none; }\n}\n\n/* ============================================================\n   Scroll-driven section reveal animations (US-217)\n   Uses animation-timeline: view() for compositor-thread reveals.\n   Only opacity + transform — no layout shifts, no main-thread paint.\n   Gated behind @supports so unsupporting browsers show content normally.\n   ============================================================ */\n@supports (animation-timeline: view()) {\n  @media (prefers-reduced-motion: no-preference) {\n    @keyframes scroll-fade-in-up {\n      from {\n        opacity: 0;\n        transform: translateY(1.5rem);\n      }\n      to {\n        opacity: 1;\n        transform: translateY(0);\n      }\n    }\n\n    .scroll-reveal {\n      animation: scroll-fade-in-up linear both;\n      animation-timeline: view();\n      animation-range: entry 0% entry 30%;\n    }\n  }\n}\n\n/* ============================================================\n   Cross-document View Transitions (US-197)\n   Opts same-origin hard navigations into a smooth cross-fade\n   via CSS View Transitions Level 2 (@view-transition at-rule).\n   Chrome 126+, Edge 126+, Firefox 144+.\n   Safari degrades gracefully — no transition, no error.\n   Soft navigations (Next.js <Link>) use the JS API separately;\n   this covers direct URL entry, back/forward, and external links.\n   ============================================================ */\n@view-transition {\n  navigation: auto;\n}\n\n::view-transition-old(root) {\n  animation: 200ms ease-out both vt-fade-out;\n}\n\n::view-transition-new(root) {\n  animation: 200ms ease-out both vt-fade-in;\n}\n\n@keyframes vt-fade-out {\n  from { opacity: 1; }\n  to { opacity: 0; }\n}\n\n@keyframes vt-fade-in {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n/* Disable view transitions when user prefers reduced motion */\n@media (prefers-reduced-motion: reduce) {\n  @view-transition {\n    navigation: none;\n  }\n}\n\n/* ============================================================\n   Native Popover + CSS Anchor Positioning (US-144)\n   Uses HTML popover attribute for keyboard/focus management\n   and CSS anchor-name / position-anchor for tethering.\n   @supports fallback for browsers without anchor positioning.\n   Chrome 125+, Edge 125+. Safari/Firefox: absolute fallback.\n   ============================================================ */\n.info-popover-anchor {\n  position: relative;\n  display: inline-flex;\n}\n\n.info-popover-trigger {\n  all: unset;\n  display: inline-flex;\n  cursor: pointer;\n}\n\n.info-popover {\n  margin: 0;\n  border: 1px solid var(--color-stone-200, #e7e5e4);\n  border-radius: 0.75rem;\n  padding: 0.5rem 0.75rem;\n  background: white;\n  color: var(--color-stone-700, #44403c);\n  font-size: 0.8125rem;\n  line-height: 1.4;\n  max-width: 15rem;\n  box-shadow: 0 4px 12px rgb(0 0 0 / 0.08);\n  /* Entry animation */\n  opacity: 1;\n  transition: opacity 0.15s ease-out, transform 0.15s ease-out;\n}\n\n.info-popover:not(:popover-open) {\n  display: none;\n}\n\n/* Anchor positioning (Chrome 125+) */\n@supports (position-anchor: --x) {\n  .info-popover {\n    position: fixed;\n    position-area: block-end span-inline-end;\n    margin-top: 0.375rem;\n  }\n}\n\n/* Fallback for browsers without anchor positioning */\n@supports not (position-anchor: --x) {\n  .info-popover {\n    position: absolute;\n    top: calc(100% + 0.375rem);\n    left: 50%;\n    transform: translateX(-50%);\n  }\n}\n\n@media (prefers-color-scheme: dark) {\n  .info-popover {\n    background: var(--color-stone-800, #292524);\n    color: var(--color-stone-200, #e7e5e4);\n    border-color: var(--color-stone-700, #44403c);\n    box-shadow: 0 4px 12px rgb(0 0 0 / 0.3);\n  }\n}\n\n/* Forced colors: ensure popover border is visible */\n@media (forced-colors: active) {\n  .info-popover {\n    border: 2px solid CanvasText;\n  }\n}\n\n/* ============================================================\n   Styled Native Select with appearance: base-select (US-188)\n   Chrome 130+, Safari 18.3+, Firefox future.\n   @supports fallback for browsers without appearance: base-select.\n   Retains built-in accessibility (keyboard, screen reader).\n   Reference: https://developer.chrome.com/blog/a-customizable-select\n   ============================================================ */\n@supports (appearance: base-select) {\n  select.select-base {\n    appearance: base-select;\n    border: 1px solid var(--color-stone-500, #78716c);\n    border-radius: 0.75rem;\n    background-color: var(--color-stone-50, #fafaf9);\n    color: var(--color-stone-900, #1c1917);\n    padding: 0.75rem 1rem;\n    font-size: 0.875rem;\n    line-height: 1.5;\n    font-family: inherit;\n    cursor: pointer;\n    transition: border-color 0.2s ease-out, background-color 0.2s ease-out;\n  }\n\n  select.select-base:hover {\n    border-color: var(--color-stone-600, #57534e);\n  }\n\n  select.select-base:focus-visible {\n    outline: 2px solid var(--color-amber-700, #b45309);\n    outline-offset: 2px;\n  }\n\n  @media (prefers-color-scheme: dark) {\n    select.select-base {\n      background-color: var(--color-stone-800, #292524);\n      color: var(--color-stone-100, #f5f5f4);\n      border-color: var(--color-stone-600, #57534e);\n    }\n\n    select.select-base:hover {\n      border-color: var(--color-stone-500, #78716c);\n    }\n\n    select.select-base:focus-visible {\n      outline-color: var(--color-amber-400, #fbbf24);\n    }\n  }\n\n  @media (prefers-contrast: more) {\n    select.select-base {\n      border-width: 2px;\n      border-color: var(--color-stone-700, #44403c);\n    }\n\n    @media (prefers-color-scheme: dark) {\n      select.select-base {\n        border-color: var(--color-stone-500, #78716c);\n      }\n    }\n  }\n\n  @media (forced-colors: active) {\n    select.select-base {\n      border: 1px solid ButtonText;\n      background-color: ButtonFace;\n      color: ButtonText;\n      forced-color-adjust: none;\n    }\n\n    select.select-base:hover {\n      background-color: Highlight;\n      color: HighlightText;\n    }\n  }\n}\n\n/* Custom scrollbar */\n::-webkit-scrollbar {\n  width: 8px;\n}\n\n::-webkit-scrollbar-track {\n  @apply bg-stone-100;\n}\n\n::-webkit-scrollbar-thumb {\n  @apply bg-stone-300 rounded-full;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  @apply bg-stone-400;\n}\n\n@media (prefers-color-scheme: dark) {\n  ::-webkit-scrollbar-track {\n    background-color: #1c1917;\n  }\n  ::-webkit-scrollbar-thumb {\n    background-color: #57534e;\n  }\n  ::-webkit-scrollbar-thumb:hover {\n    background-color: #78716c;\n  }\n}\n\n/* Print styles — booking confirmation and receipt pages */\n@media print {\n  nav,\n  footer,\n  .cookie-banner,\n  .chat-widget,\n  [data-chat-widget],\n  .sticky-booking-bar,\n  [data-cookie-banner] {\n    display: none !important;\n  }\n\n  * {\n    color: #000 !important;\n    background: transparent !important;\n    box-shadow: none !important;\n  }\n\n  body {\n    font-size: 12pt;\n  }\n\n  .booking-summary,\n  [class*=\"booking-summary\"],\n  [class*=\"confirmation\"] {\n    page-break-inside: avoid;\n  }\n}\n","numLines":895,"startLine":1,"totalLines":895}}}
{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01HgZUdHyzCGcCUEhbCzgSAF","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"Perfect! I can see that the CSS styles for the native select with appearance: base-select have already been added to the globals.css file (lines 763-836). The styles include:\n- appearance: base-select with @supports guard\n- border, border-radius, padding styling to match the brand design system\n- Light and dark mode support\n- Forced colors and high contrast support\n- Focus visible styling\n\nHowever, I need to check if the LanguageSwitcher component has been updated to actually use the <select> element. Looking at the component code I read earlier, it still uses buttons, not a select element.\n\nSo the current state is:\n1. CSS styles for the styled select are already in place (lines 764-836)\n2. But the LanguageSwitcher component hasn't been refactored to use the <select> element yet\n\nLet me create a plan for what needs to be done:\n\n1. Update LanguageSwitcher.tsx to use a native <select> element with the appearance: base-select class\n2. Verify there are no TypeScript errors\n3. Ensure WCAG compliance (keyboard navigation, screen reader support)\n4. Test that the implementation works\n\nLet me create a diagnosis block and plan.","signature":""}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":10226,"cache_read_input_tokens":81816,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10226},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"cfc99e28-38cf-433d-90b6-b0ca5e1b4eef","uuid":"05304298-508f-4953-b238-000f5c47b898"}
{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01HgZUdHyzCGcCUEhbCzgSAF","type":"message","role":"assistant","content":[{"type":"text","text":"## Current State\n\nThe project already has CSS styles for `appearance: base-select` in `globals.css` (lines 764-836) with @supports guard for progressive enhancement and full accessibility styling (dark mode, high contrast, forced colors). However, the **LanguageSwitcher** component (site/src/components/LanguageSwitcher.tsx) currently uses button-based UI instead of a native `<select>` element. No other select-based filters found in the codebase.\n\n## Problem Identified\n\nUS-188 requires adopting the native `<select>` element with `appearance: base-select` to replace custom UI dropdowns, reducing bundle size while keeping accessibility. The LanguageSwitcher is the primary candidate for this change.\n\n## Planned Changes\n\n- **LanguageSwitcher.tsx**: Convert button-based language switcher to use native `<select>` element with the `select-base` CSS class\n- Test TypeScript compilation and ensure WCAG 4.1.2 compliance\n\n<plan>\n{\n  \"files_to_create\": [],\n  \"files_to_modify\": [\"site/src/components/LanguageSwitcher.tsx\"],\n  \"functions_to_add\": [],\n  \"estimated_loc\": 30\n}\n</plan>\n\nNow let me implement the changes:"}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":10226,"cache_read_input_tokens":81816,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10226},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"cfc99e28-38cf-433d-90b6-b0ca5e1b4eef","uuid":"28efef7f-0a1f-4d13-89dd-1e591c46699b"}
{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01HgZUdHyzCGcCUEhbCzgSAF","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Qykoa9XkNjpfcME7xHXNZB","name":"Edit","input":{"replace_all":false,"file_path":"C:\\Users\\Jyue\\Documents\\1-projects\\Software Projects\\pelangi-website\\site\\src\\components\\LanguageSwitcher.tsx","old_string":"\"use client\";\n\nimport type { Route } from \"next\";\nimport { useState } from \"react\";\nimport { useRouter } from \"next/navigation\";\nimport { setLanguagePreference } from \"@/app/actions/language\";\n\nconst LANGUAGES = [\n  { code: \"en\", label: \"EN\" },\n  { code: \"ms\", label: \"BM\", href: \"/ms/terma\" },\n  { code: \"zh\", label: \"中文\", href: \"/zh\" },\n];\n\nexport default function LanguageSwitcher() {\n  const [currentLanguage, setCurrentLanguage] = useState(\"en\");\n  const router = useRouter();\n\n  const handleLanguageChange = async (langCode: string) => {\n    setCurrentLanguage(langCode);\n\n    // Set the cookie\n    await setLanguagePreference(langCode);\n\n    // Navigate to BM content page\n    const lang = LANGUAGES.find((l) => l.code === langCode);\n    if (lang && \"href\" in lang && lang.href) {\n      router.push(lang.href as Route);\n      return;\n    }\n\n  };\n\n  return (\n    <div className=\"flex items-center gap-1 ml-4\">\n      <nav\n        className=\"flex gap-1 bg-stone-100 dark:bg-stone-800 rounded-full p-1\"\n        aria-label=\"Language selector\"\n      >\n        {LANGUAGES.map((lang) => (\n          <button\n            key={lang.code}\n            onClick={() => handleLanguageChange(lang.code)}\n            className={`min-h-6 min-w-6 px-3 py-1.5 text-sm font-medium rounded-full transition-all duration-200 ${\n              currentLanguage === lang.code\n                ? \"bg-white dark:bg-stone-700 text-stone-900 dark:text-stone-100 shadow-xs\"\n                : \"text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-200\"\n            }`}\n            aria-pressed={currentLanguage === lang.code}\n            aria-label={`Switch to ${lang.label}`}\n          >\n            {lang.label}\n          </button>\n        ))}\n      </nav>\n\n    </div>\n  );\n}","new_string":"\"use client\";\n\nimport type { Route } from \"next\";\nimport { useRouter } from \"next/navigation\";\nimport { setLanguagePreference } from \"@/app/actions/language\";\n\nconst LANGUAGES = [\n  { code: \"en\", label: \"EN\" },\n  { code: \"ms\", label: \"BM\", href: \"/ms/terma\" },\n  { code: \"zh\", label: \"中文\", href: \"/zh\" },\n];\n\nexport default function LanguageSwitcher() {\n  const router = useRouter();\n\n  const handleLanguageChange = async (e: React.ChangeEvent<HTMLSelectElement>) => {\n    const langCode = e.currentTarget.value;\n\n    // Set the cookie\n    await setLanguagePreference(langCode);\n\n    // Navigate to language-specific content page if href is defined\n    const lang = LANGUAGES.find((l) => l.code === langCode);\n    if (lang && \"href\" in lang && lang.href) {\n      router.push(lang.href as Route);\n      return;\n    }\n  };\n\n  return (\n    <div className=\"ml-4\">\n      <label htmlFor=\"language-select\" className=\"sr-only\">\n        Select language\n      </label>\n      <select\n        id=\"language-select\"\n        className=\"select-base\"\n        defaultValue=\"en\"\n        onChange={handleLanguageChange}\n        aria-label=\"Language selector\"\n      >\n        {LANGUAGES.map((lang) => (\n          <option key={lang.code} value={lang.code}>\n            {lang.label}\n          </option>\n        ))}\n      </select>\n    </div>\n  );\n}"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":10226,"cache_read_input_tokens":81816,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10226},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"cfc99e28-38cf-433d-90b6-b0ca5e1b4eef","uuid":"ee5e3082-9f9c-4df8-9d92-5fdae41da928"}
