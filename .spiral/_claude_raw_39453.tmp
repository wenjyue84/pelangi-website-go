en)}\n119\t            aria-label={isMenuOpen ? \"Close menu\" : \"Open menu\"}\n120\t            aria-expanded={isMenuOpen}\n121\t          >\n122\t            <svg className=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n123\t              {isMenuOpen ? (\n124\t                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={1.5} d=\"M6 18L18 6M6 6l12 12\" />\n125\t              ) : (\n126\t                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={1.5} d=\"M4 6h16M4 12h16M4 18h16\" />\n127\t              )}\n128\t            </svg>\n129\t          </button>\n130\t        </div>\n131\t\n132\t        {/* Mobile Navigation */}\n133\t        <div\n134\t          className={`absolute top-full left-4 right-4 mt-2 bg-white rounded-2xl shadow-xl md:hidden dark:bg-stone-800 dark:shadow-stone-950/50\n135\t                     overflow-hidden transition-all duration-300 ${isMenuOpen ? \"opacity-100 translate-y-0\" : \"opacity-0 -translate-y-4 pointer-events-none\"\n136\t            }`}\n137\t        >\n138\t          <div className=\"py-4\">\n139\t            {navLinks.map((link) => (\n140\t              <Link\n141\t                key={link.href}\n142\t                href={link.href as Route}\n143\t                className=\"block px-6 py-3 text-stone-700 hover:bg-stone-50 hover:text-stone-900 transition-colors dark:text-stone-300 dark:hover:bg-stone-700 dark:hover:text-stone-100\"\n144\t                onClick={() => setIsMenuOpen(false)}\n145\t                onNavigate={() => pushNavEvent(link.href)}\n146\t              >\n147\t                {link.label}\n148\t              </Link>\n149\t            ))}\n150\t            <div className=\"px-6 py-3 border-t border-stone-100 mt-2 dark:border-stone-700\">\n151\t              <div className=\"flex items-center justify-center mb-4\">\n152\t                <LanguageSwitcher />\n153\t              </div>\n154\t              <BookNowCTA\n155\t                className=\"block w-full text-center bg-amber-700 text-white py-3 rounded-xl font-medium hover:bg-amber-800 transition-colors\"\n156\t                onClick={() => setIsMenuOpen(false)}\n157\t              />\n158\t            </div>\n159\t          </div>\n160\t        </div>\n161\t      </nav>\n162\t      <SearchDialog open={isSearchOpen} onClose={closeSearch} />\n163\t    </header>\n164\t  );\n165\t}\n166\t"}]},"parent_tool_use_id":null,"session_id":"01df7ad1-8a9a-45d7-80b2-f9b95ad91d60","uuid":"6c9beb71-7891-474f-a203-12ea1a9f08b2","timestamp":"2026-04-14T00:08:12.401Z","tool_use_result":{"type":"text","file":{"filePath":"/c/Users/Jyue/Documents/1-projects/Software Projects/pelangi-website/site/src/components/Header.tsx","content":"\"use client\";\n\nimport type { Route } from \"next\";\nimport { useState, useEffect, useCallback } from \"react\";\nimport Link from \"next/link\";\nimport Image from \"next/image\";\nimport dynamic from \"next/dynamic\";\nimport LanguageSwitcher from \"./LanguageSwitcher\";\nimport BookNowCTA from \"./BookNowCTA\";\nimport {\n  SEARCH_ARIA,\n  SEARCH_ARIA_DESKTOP,\n} from \"@/lib/ui-labels\";\n\nfunction pushNavEvent(href: string) {\n  if (typeof window === \"undefined\") return;\n  const w = window as unknown as { dataLayer: Record<string, unknown>[] };\n  w.dataLayer = w.dataLayer || [];\n  w.dataLayer.push({ event: \"nav_click\", nav_href: href });\n}\n\nconst SearchDialog = dynamic(() => import(\"./SearchDialog\"), { ssr: false });\n\nexport default function Header() {\n  const [isMenuOpen, setIsMenuOpen] = useState(false);\n  const [isSearchOpen, setIsSearchOpen] = useState(false);\n\n  const closeSearch = useCallback(() => setIsSearchOpen(false), []);\n\n  // Cmd/Ctrl+K keyboard shortcut + Escape to close mobile nav\n  useEffect(() => {\n    function handleKeyDown(e: KeyboardEvent) {\n      if ((e.metaKey || e.ctrlKey) && e.key === \"k\") {\n        e.preventDefault();\n        setIsSearchOpen((prev) => !prev);\n      }\n      if (e.key === \"Escape\" && isMenuOpen) {\n        setIsMenuOpen(false);\n      }\n    }\n    document.addEventListener(\"keydown\", handleKeyDown);\n    return () => document.removeEventListener(\"keydown\", handleKeyDown);\n  }, [isMenuOpen]);\n\n  const navLinks = [\n    { href: \"/about\", label: \"About\" },\n    { href: \"/rooms\", label: \"Rooms\" },\n    { href: \"/#destinations\", label: \"Destinations\" },\n    { href: \"/gallery\", label: \"Gallery\" },\n    { href: \"/#community\", label: \"Community\" },\n    { href: \"/contact\", label: \"Location\" },\n    { href: \"/check-in\", label: \"Check-in Guide\" },\n  ];\n\n  return (\n    <header className=\"fixed top-0 left-0 right-0 z-50 transition-all duration-500 bg-white/95 backdrop-blur-md shadow-xs py-3 dark:bg-stone-900/95 dark:shadow-stone-950/50\">\n      <nav className=\"container-custom flex items-center justify-between px-6 md:px-8\">\n        {/* Logo */}\n        <Link href=\"/\" className=\"flex items-center gap-3 group\">\n          <div className=\"relative w-10 h-10\">\n            <Image\n              src=\"/images/logo.png\"\n              alt=\"Pelangi Capsule Hostel Logo - Budget accommodation in Johor Bahru\"\n              fill\n              sizes=\"40px\"\n              className=\"object-contain\"\n            />\n          </div>\n          <div className=\"flex flex-col\">\n            <span className=\"font-display text-xl font-medium tracking-tight transition-colors duration-300 text-stone-900 dark:text-stone-100\">\n              Pelangi\n            </span>\n            <span className=\"text-[10px] font-medium tracking-widest uppercase transition-colors duration-300 text-stone-500 dark:text-stone-400\">\n              Capsule Hostel\n            </span>\n          </div>\n        </Link>\n\n        {/* Desktop Navigation */}\n        <div className=\"hidden md:flex items-center gap-1\">\n          {navLinks.map((link) => (\n            <Link\n              key={link.href}\n              href={link.href as Route}\n              className=\"px-4 py-2 text-sm font-medium transition-all duration-300 rounded-full text-stone-600 hover:text-stone-900 hover:bg-stone-100 dark:text-stone-400 dark:hover:text-stone-100 dark:hover:bg-stone-800\"\n              onNavigate={() => pushNavEvent(link.href)}\n            >\n              {link.label}\n            </Link>\n          ))}\n          <button\n            onClick={() => setIsSearchOpen(true)}\n            className=\"p-2 text-stone-500 hover:text-stone-900 hover:bg-stone-100 rounded-full transition-colors dark:text-stone-400 dark:hover:text-stone-100 dark:hover:bg-stone-800\"\n            aria-label={SEARCH_ARIA_DESKTOP}\n            title=\"Search (Ctrl+K)\"\n          >\n            <svg className=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={1.5} d=\"M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z\" />\n            </svg>\n          </button>\n          <LanguageSwitcher />\n          <BookNowCTA className=\"ml-4 px-6 py-2.5 text-sm font-medium rounded-full transition-all duration-300 bg-amber-700 text-white hover:bg-amber-800\" />\n        </div>\n\n        {/* Mobile Search + Menu Buttons */}\n        <div className=\"flex items-center gap-1 md:hidden\">\n          <button\n            className=\"p-2 rounded-full transition-colors duration-300 text-stone-700 hover:bg-stone-100 dark:text-stone-300 dark:hover:bg-stone-800\"\n            onClick={() => setIsSearchOpen(true)}\n            aria-label={SEARCH_ARIA}\n>\n            <svg className=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={1.5} d=\"M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z\" />\n            </svg>\n          </button>\n          <button\n            className=\"p-2 rounded-full transition-colors duration-300 text-stone-700 hover:bg-stone-100 dark:text-stone-300 dark:hover:bg-stone-800\"\n            onClick={() => setIsMenuOpen(!isMenuOpen)}\n            aria-label={isMenuOpen ? \"Close menu\" : \"Open menu\"}\n            aria-expanded={isMenuOpen}\n          >\n            <svg className=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              {isMenuOpen ? (\n                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={1.5} d=\"M6 18L18 6M6 6l12 12\" />\n              ) : (\n                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={1.5} d=\"M4 6h16M4 12h16M4 18h16\" />\n              )}\n            </svg>\n          </button>\n        </div>\n\n        {/* Mobile Navigation */}\n        <div\n          className={`absolute top-full left-4 right-4 mt-2 bg-white rounded-2xl shadow-xl md:hidden dark:bg-stone-800 dark:shadow-stone-950/50\n                     overflow-hidden transition-all duration-300 ${isMenuOpen ? \"opacity-100 translate-y-0\" : \"opacity-0 -translate-y-4 pointer-events-none\"\n            }`}\n        >\n          <div className=\"py-4\">\n            {navLinks.map((link) => (\n              <Link\n                key={link.href}\n                href={link.href as Route}\n                className=\"block px-6 py-3 text-stone-700 hover:bg-stone-50 hover:text-stone-900 transition-colors dark:text-stone-300 dark:hover:bg-stone-700 dark:hover:text-stone-100\"\n                onClick={() => setIsMenuOpen(false)}\n                onNavigate={() => pushNavEvent(link.href)}\n              >\n                {link.label}\n              </Link>\n            ))}\n            <div className=\"px-6 py-3 border-t border-stone-100 mt-2 dark:border-stone-700\">\n              <div className=\"flex items-center justify-center mb-4\">\n                <LanguageSwitcher />\n              </div>\n              <BookNowCTA\n                className=\"block w-full text-center bg-amber-700 text-white py-3 rounded-xl font-medium hover:bg-amber-800 transition-colors\"\n                onClick={() => setIsMenuOpen(false)}\n              />\n            </div>\n          </div>\n        </div>\n      </nav>\n      <SearchDialog open={isSearchOpen} onClose={closeSearch} />\n    </header>\n  );\n}\n","numLines":166,"startLine":1,"totalLines":166}}}
