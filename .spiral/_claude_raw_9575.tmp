w.dateISO\n49\t    }));\n50\t\n51\t    return (\n52\t        <section className=\"py-20 bg-white dark:bg-stone-900\">\n53\t            {reviewSchemas.map((schema, index) => (\n54\t                <script\n55\t                    key={`review-schema-${index}`}\n56\t                    type=\"application/ld+json\"\n57\t                    dangerouslySetInnerHTML={{ __html: JSON.stringify(schema) }}\n58\t                />\n59\t            ))}\n60\t            <div className=\"container-custom\">\n61\t                <div className=\"text-center max-w-2xl mx-auto mb-16\">\n62\t                    <h2 className=\"font-display text-4xl font-medium mb-4 text-stone-900 dark:text-stone-100\">Guest Reviews</h2>\n63\t                    <div className=\"flex items-center justify-center gap-2 mb-4\">\n64\t                        <div className=\"flex text-amber-400\">\n65\t                            {[...Array(5)].map((_, i) => (\n66\t                                <svg key={i} className=\"w-6 h-6\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n67\t                                    <path d=\"M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z\" />\n68\t                                </svg>\n69\t                            ))}\n70\t                        </div>\n71\t                        <span className=\"text-xl font-bold text-stone-900 dark:text-stone-100\">4.9/5</span>\n72\t                        <span className=\"text-stone-500 dark:text-stone-400\">(500+ Reviews)</span>\n73\t                    </div>\n74\t                </div>\n75\t\n76\t                <div className=\"grid md:grid-cols-3 gap-8\">\n77\t                    {reviews.map((review, index) => (\n78\t             