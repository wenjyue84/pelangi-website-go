# -------------------------------------------------------
# Sentry Error Monitoring
# -------------------------------------------------------
# Get your DSN from: https://sentry.io → Settings → Projects → <project> → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Sentry auth token — used during `next build` to upload source maps.
# Generate at: https://sentry.io → Settings → Auth Tokens
# Add this to your CI secrets and Vercel/host environment variables (NOT committed).
SENTRY_AUTH_TOKEN=

# Optional: Override org/project slugs if different from sentry.properties
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug

# -------------------------------------------------------
# Local development overrides
# -------------------------------------------------------
# Uncomment to proxy Rainbow AI API to local server during dev
# RAINBOW_API_URL=http://localhost:3002
